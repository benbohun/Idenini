Prompt

# TenableCore_NessusAdmin_SudoWithLogon_Prompts.ini
# ASCII-only prompts (no unicode characters)

[Conditions]
TRUE=(expression)true

UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Linked logon account presence (extrapass1)
HasLogonAccount=(expression)! [string equal "<extrapass1\username>" ""]
NoLogonAccount=(expression)[string equal "<extrapass1\username>" ""]

# Login
Login=login as:|login:|Username:
Password=Password:
InvalidLogin=Login invalid|Authentication failed|Access denied|Login incorrect|You entered an invalid login name or passwd
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# Shell prompts
StandardPrompt=.*\$ ?$|.*\# ?$|.*\> ?$|.*\% ?$|.*\] ?$|.*->\s*$|.*\$\u001b\[.*m ?$|.*\> ?\u001b\[.*m ?$

# Action gates
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]

# Protocol/Port checks
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# sudo handling
SudoPasswordPrompt=(?i)\[sudo\]\s*password\s+for\s+\S+\s*:\s*$|(?i)sudo\s+password\s*:\s*$
SudoAuthFailed=(?i)sorry,\s*try\s*again\.|sudo:\s+\d+\s+incorrect\s+password\s+attempt
SudoNotAllowed=(?i)is\s+not\s+in\s+the\s+sudoers\s+file|not\s+allowed\s+to\s+execute|may\s+not\s+run\s+sudo

# passwd interaction
PasswdPreLine=(?i)Changing\s+password\s+for\s+\S+
PasswdOldOrCurrentPrompt=(?i)(Old\s+password\s*:|Current\s+password\s*:)
PasswdCurrentUnixPrompt=(?i)\(current\)\s+UNIX\s+password\s*:

PasswdNewPrompt=(?i)(Enter\s+new\s+UNIX\s+password\s*:\s*$|Enter\s+new\s+password\s*:\s*$|New\s+password\s*:\s*$)

# IMPORTANT: include "Retype new password:" (this was your timeout root cause)
PasswdRetypePrompt=(?i)(Retype\s+new\s+(UNIX\s+)?password\s*:\s*$|Re[-\s]?enter\s+new\s+password\s*:\s*$|Confirm\s+new\s+password\s*:\s*$|Verify\s+new\s+password\s*:\s*$|New\s+password\s*\(again\)\s*:\s*$|Enter\s+again\s*:\s*$)

PasswdSuccess=(?i)password\s+updated\s+successfully|password\s+changed|authentication\s+tokens?\s+updated\s+successfully
PasswdMismatch=(?i)sorry,\s*passwords?\s*do\s*not\s*match
PasswdUnchanged=(?i)password\s+unchanged
PasswdAuthError=(?i)authentication\s+token\s+manipulation\s+error|passwd:\s*failure

# Minimum password age
PasswdMinAge=(?i)you\s+must\s+wait\s+longer\s+to\s+change\s+your\s+password

# Broader rejection patterns
PasswdRejected=(?i)bad\s+password|BAD\s+PASSWORD|does\s+not\s+meet|too\s+short|not\s+enough\s+different\s+characters|based\s+on\s+dictionary\s+word|too\s+similar|palindrome|must\s+contain|one\s+capital|one\s+lowercase|one\s+numeric|one\s+special




::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

Process

# TenableCore_NessusAdmin_SudoWithLogon_Process.ini
# ASCII-only process (no unicode characters)

[states]
Init=(script)set verifyLogon 1; set target_user "<username>"; set target_pass "<pmpass>"; set logon_user "<extrapass1\username>"; set logon_pass "<pmextrapass1>"
ChooseCreds=
UseLogonCreds=(script)set username "$logon_user"; set curr_pass "$logon_pass"; set sudo_pass "$logon_pass"
UseTargetCreds=(script)set username "$target_user"; set curr_pass "$target_pass"; set sudo_pass "$target_pass"

# Protocol routing
CheckProtocol=
StartSSH_WithPort=(spawn)plink.exe <address> -ssh -P <port>
StartSSH_NoPort=(spawn)plink.exe <address> -ssh
StartTelnet=(spawn)telnet <address> <port>
StoreKeyInCache=y

# Login
LoginUser=$username
SendPassword=$curr_pass
CheckAction=

# Change (sudo -> passwd targetUser)
ChangeStep1=sudo -k passwd <username>
SendSudoPassword=$sudo_pass

# passwd prompts
ChangeStepCur=<pmpass>
ChangeStep2=<pmnewpass>
ChangeStep3=<pmnewpass>

FinalStep=
END=

# Fail states
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILInvalidNewPassword=FAIL(Invalid new password rejected by device policy, 8004)
FAILPassMismatch=FAIL(New password entries did not match, 8005)
FAILPasswdAuthError=FAIL(Device error while updating password (auth token error), 8007)

FAILSudoAuthFailed=FAIL(Sudo authentication failed for logon user, 8015)
FAILSudoNotAllowed=FAIL(Logon user is not permitted to run sudo passwd, 8016)
FAILPassMinAgeWait=FAIL(Target enforces minimum password age (must wait longer). Align CPM change interval with policy, 8017)

[transitions]
Init,TRUE,ChooseCreds
ChooseCreds,HasLogonAccount,UseLogonCreds
ChooseCreds,NoLogonAccount,UseTargetCreds

UseLogonCreds,TRUE,CheckProtocol
UseTargetCreds,TRUE,CheckProtocol

CheckProtocol,ProtocolIsSSH,StartSSH_WithPort
CheckProtocol,ProtocolIsTelnet,StartTelnet
CheckProtocol,ProtocolIsEmpty,StartSSH_WithPort
StartSSH_WithPort,PortNotSet,StartSSH_NoPort

# Start session + login
StartSSH_WithPort,UnableToConnect,FAILUnableToConnect
StartSSH_WithPort,PlinkStoreKey,StoreKeyInCache
StartSSH_WithPort,Login,LoginUser

StartSSH_NoPort,UnableToConnect,FAILUnableToConnect
StartSSH_NoPort,PlinkStoreKey,StoreKeyInCache
StartSSH_NoPort,Login,LoginUser

StartTelnet,UnableToConnect,FAILUnableToConnect
StartTelnet,Login,LoginUser

StoreKeyInCache,Login,LoginUser

LoginUser,Password,SendPassword
SendPassword,InvalidLogin,FAILTARGETInvalidUsernameOrPassword
SendPassword,AccountDisabled,FAILAccountDisabled1
SendPassword,NotAllowedLogin,FAILNotAllowedLogin1
SendPassword,StandardPrompt,CheckAction

# Action routing
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckAction,ActionIsChange,ChangeStep1

# sudo passwd flow
ChangeStep1,SudoPasswordPrompt,SendSudoPassword
ChangeStep1,PasswdMinAge,FAILPassMinAgeWait
ChangeStep1,PasswdAuthError,FAILPasswdAuthError
ChangeStep1,PasswdOldOrCurrentPrompt,ChangeStepCur
ChangeStep1,PasswdCurrentUnixPrompt,ChangeStepCur
ChangeStep1,PasswdNewPrompt,ChangeStep2
ChangeStep1,PasswdPreLine,ChangeStep1

SendSudoPassword,SudoAuthFailed,FAILSudoAuthFailed
SendSudoPassword,SudoNotAllowed,FAILSudoNotAllowed
SendSudoPassword,PasswdMinAge,FAILPassMinAgeWait
SendSudoPassword,PasswdAuthError,FAILPasswdAuthError
SendSudoPassword,PasswdNewPrompt,ChangeStep2
SendSudoPassword,PasswdOldOrCurrentPrompt,ChangeStepCur

ChangeStepCur,PasswdMinAge,FAILPassMinAgeWait
ChangeStepCur,PasswdNewPrompt,ChangeStep2
ChangeStepCur,PasswdAuthError,FAILPasswdAuthError

# Step2: after entering new password
ChangeStep2,PasswdRetypePrompt,ChangeStep3
ChangeStep2,PasswdRejected,FAILInvalidNewPassword
ChangeStep2,PasswdMinAge,FAILPassMinAgeWait

# If it re-prompts New password again, treat as rejection (prevents timeout)
ChangeStep2,PasswdNewPrompt,FAILInvalidNewPassword

# Step3: retype new password
ChangeStep3,PasswdMismatch,FAILPassMismatch
ChangeStep3,PasswdAuthError,FAILPasswdAuthError
ChangeStep3,PasswdUnchanged,FAILInvalidNewPassword
ChangeStep3,PasswdMinAge,FAILPassMinAgeWait
ChangeStep3,PasswdRejected,FAILInvalidNewPassword
ChangeStep3,PasswdSuccess,FinalStep
ChangeStep3,StandardPrompt,FinalStep

# If it re-prompts New password here too, treat as rejection
ChangeStep3,PasswdNewPrompt,FAILInvalidNewPassword

FinalStep,TRUE,END

[CPM Parameters Validation]
username, source=FILE, Mandatory=yes
address,  source=FILE, Mandatory=yes

[Parameters]
PromptTimeout=120
SendHuman=.1 .3 1 .05 2

[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no
