<# =====================================================================
DisabledAccountMoveScript.ps1

Goal:
- Login via CCP -> Identity Header -> psPAS (same pattern you provided)
- Find FIRST account whose Account Activity contains:
    "Reason: This user can't sign in because this account is currently disabled. (winRc=1331)."
  (plus a broader regex fallback to catch minor variations)
- Update platformId to Disabled_Domain_Account (or Disabled_Domain_Accounts)
- Stop after 1 match (per request)

Notes:
- Fixes PowerShell $PID collision by NOT using $pid as a variable name.
- Uses inventory-style paging against /API/Accounts if saved filters return 0.
- Uses Get-PASAccountActivity (Gen2) with fallback to Gen1.

Run test:
  .\DisabledAccountMoveScript.ps1 -WhatIf

===================================================================== #>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # Candidates (script will resolve whichever exists)
    [string[]]$TargetPlatformCandidates = @("Disabled_Domain_Account", "Disabled_Domain_Accounts"),

    # Your exact message (string match)
    [string]$ExactNeedle = "Reason: This user can't sign in because this account is currently disabled. (winRc=1331).",

    # Broader match to catch message variations in activity payloads
    [string]$NeedleRegex = "(?i)winRc\s*=\s*1331|account\s+is\s+currently\s+disabled",

    # Stop after this many matches (keep 1 for now)
    [ValidateRange(1,100)]
    [int]$MaxMatches = 1,

    # Candidate selection knobs
    [ValidateRange(1,1000)]
    [int]$PageSize = 200,

    # Safety guardrails
    [ValidateRange(1,1000000)]
    [int]$MaxAccountsToInspect = 20000,

    [ValidateRange(1,500)]
    [int]$MaxActivitiesToInspect = 80
)

# =========================
# Baseline
# =========================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force

# =========================
# Logger
# =========================
$LogFile = "E:\Installation Media\Script\OnboardScript\data\DisabledAccountRemediation.log"
$logDir = Split-Path -Path $LogFile -Parent
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }
New-Item -ItemType File -Force -Path $LogFile | Out-Null

function Write-Log {
    param([string]$Message, [ConsoleColor]$Color = 'White')
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# =========================
# CCP / Identity config (your existing values)
# =========================
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# =========================
# Login helper: CCP (Object) -> psPAS header
# =========================
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,
        [Parameter(Mandatory)] [string]$UPUser
    )

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log "Retrieving CCP credential for '$UPUser' via Object..." 'Cyan'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }
    Write-Log "CCP returned username for service principal." 'Green'

    $secPass = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upCred  = [PSCredential]::new($UPUser, $secPass)

    Write-Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." 'Cyan'
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upCred

    Use-PASSession $hdr
    if (-not (Get-PASSession)) { throw "psPAS session not established." }

    # minimize plaintext exposure
    $resp.Content = $null
    Write-Log "PAS session established (no prompts)." 'Green'
}

# =========================
# Helpers
# =========================
function Get-PASContext {
    $sess = Get-PASSession
    if (-not $sess -or -not $sess.BaseURI -or -not $sess.WebSession) {
        throw "PAS session missing BaseURI/WebSession. Ensure login succeeded."
    }
    return $sess
}

function Resolve-TargetPlatformId {
    param([string[]]$Candidates)

    foreach ($PlatformIdCandidate in $Candidates) {
        try {
            $plat = Get-PASPlatform -PlatformID $PlatformIdCandidate -ErrorAction Stop
            # Return the candidate itself (most reliable), but log a hint if properties exist
            $hint = $null
            try {
                if ($plat.General.PlatformID) { $hint = $plat.General.PlatformID }
                elseif ($plat.General.ID)     { $hint = $plat.General.ID }
            } catch { }
            if ($hint) {
                Write-Log "✅ Platform exists: $PlatformIdCandidate (hint: $hint)" 'Green'
            } else {
                Write-Log "✅ Platform exists: $PlatformIdCandidate" 'Green'
            }
            return $PlatformIdCandidate
        } catch {
            # continue
        }
    }

    throw "None of the target platform IDs exist or are accessible: $($Candidates -join ', ')"
}

function Get-AccountsBySavedFilterPaged {
    param(
        [Parameter(Mandatory)] [string]$SavedFilter,
        [Parameter(Mandatory)] [int]$Limit
    )

    $sess = Get-PASContext
    $offset = 0
    $all = New-Object System.Collections.Generic.List[object]

    while ($true) {
        $uri = "{0}/API/Accounts?savedFilter={1}&offset={2}&limit={3}" -f `
            $sess.BaseURI, ([uri]::EscapeDataString($SavedFilter)), $offset, $Limit

        $resp = Invoke-RestMethod -Method GET -Uri $uri -WebSession $sess.WebSession
        $page = @()
        if ($resp -and $resp.value) { $page = @($resp.value) }

        if ($page.Count -eq 0) { break }

        foreach ($a in $page) { $all.Add($a) }

        $offset += $Limit

        # Stop if fewer than limit returned (common paging end)
        if ($page.Count -lt $Limit) { break }

        # Safety guard
        if ($all.Count -ge $MaxAccountsToInspect) { break }
    }

    return $all
}

function Get-AllAccountsInventoryPaged {
    param([int]$Limit)

    $sess = Get-PASContext
    $offset = 0
    $all = New-Object System.Collections.Generic.List[object]

    while ($true) {
        $uri = "{0}/API/Accounts?offset={1}&limit={2}" -f $sess.BaseURI, $offset, $Limit
        $resp = Invoke-RestMethod -Method GET -Uri $uri -WebSession $sess.WebSession

        $page = @()
        if ($resp -and $resp.value) { $page = @($resp.value) }

        if ($page.Count -eq 0) { break }

        foreach ($a in $page) { $all.Add($a) }

        $offset += $Limit

        if ($page.Count -lt $Limit) { break }
        if ($all.Count -ge $MaxAccountsToInspect) { break }
    }

    return $all
}

function LooksLikeFailureCandidate {
    param([object]$Account)

    # Try multiple “likely” fields; if none exist, return $true to avoid missing candidates.
    try {
        if ($Account.secretManagement -and $Account.secretManagement.status) {
            return ($Account.secretManagement.status.ToString() -match '(?i)fail')
        }
        if ($Account.secretManagement -and $Account.secretManagement.lastTask -and $Account.secretManagement.lastTask.status) {
            return ($Account.secretManagement.lastTask.status.ToString() -match '(?i)fail')
        }
        if ($Account.status) {
            return ($Account.status.ToString() -match '(?i)fail')
        }
    } catch { }

    return $true
}

function Get-AccountActivitiesSafe {
    param([string]$AccountID)

    try {
        return Get-PASAccountActivity -AccountID $AccountID -ErrorAction Stop
    } catch {
        # fallback
        return Get-PASAccountActivity -AccountID $AccountID -useGen1API -ErrorAction Stop
    }
}

function ActivityMatchesNeedle {
    param([object]$ActivityItem)

    $text = $null
    try { $text = $ActivityItem | ConvertTo-Json -Depth 12 -Compress } catch { $text = [string]$ActivityItem }

    if ($text -like "*$ExactNeedle*") { return $true }
    if ($text -match $NeedleRegex)    { return $true }

    return $false
}

function Update-AccountPlatformSafe {
    param(
        [Parameter(Mandatory)][string]$AccountID,
        [Parameter(Mandatory)][string]$PlatformID
    )

    # prefer /platformId then fallback to /platformID
    try {
        Set-PASAccount -AccountID $AccountID -op replace -path "/platformId" -value $PlatformID -ErrorAction Stop | Out-Null
        return
    } catch {
        Write-Log "⚠️ Update via /platformId failed, retrying /platformID. Error: $($_.Exception.Message)" 'Yellow'
    }

    Set-PASAccount -AccountID $AccountID -op replace -path "/platformID" -value $PlatformID -ErrorAction Stop | Out-Null
}

# =========================
# MAIN
# =========================
try {
    Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC"

    Write-Log "Resolving target platform ID..." 'Yellow'
    $TargetPlatformId = Resolve-TargetPlatformId -Candidates $TargetPlatformCandidates
    Write-Log "Target platform selected: $TargetPlatformId" 'Green'

    $SavedFiltersToCheck = @("FailedVerify", "FailedChange", "FailedReconcile")

    # -------- Stage 1: SavedFilter candidates --------
    $candidates = New-Object System.Collections.Generic.List[object]
    foreach ($sf in $SavedFiltersToCheck) {
        Write-Log "Fetching candidates via savedFilter=$sf ..." 'Cyan'
        $list = Get-AccountsBySavedFilterPaged -SavedFilter $sf -Limit $PageSize
        if ($list -and $list.Count -gt 0) {
            Write-Log "✅ savedFilter=$sf returned $($list.Count) account(s)" 'Green'
            foreach ($a in $list) { $candidates.Add($a) }
        } else {
            Write-Log "No accounts returned for savedFilter=$sf" 'DarkYellow'
        }
    }

    # De-dup by id
    $candidates = @($candidates | Group-Object id | ForEach-Object { $_.Group | Select-Object -First 1 })

    # -------- Stage 2: Inventory fallback --------
    if (-not $candidates -or $candidates.Count -eq 0) {
        Write-Log "Saved filters returned 0 accounts. Falling back to inventory sweep..." 'Yellow'
        $inventory = Get-AllAccountsInventoryPaged -Limit $PageSize
        Write-Log "✅ Inventory pulled $($inventory.Count) account(s) (capped by MaxAccountsToInspect=$MaxAccountsToInspect)" 'Green'

        # Filter to likely failures
        $candidates = @($inventory | Where-Object { LooksLikeFailureCandidate $_ })
        Write-Log "✅ Failure-like candidates after narrowing: $($candidates.Count)" 'Green'
    }

    if (-not $candidates -or $candidates.Count -eq 0) {
        Write-Log "❌ No candidates found to inspect." 'Red'
        exit 2
    }

    Write-Log "Looking for activity match (exact needle OR regex):" 'Yellow'
    Write-Log "  Exact: $ExactNeedle" 'Yellow'
    Write-Log "  Regex: $NeedleRegex" 'Yellow'

    # -------- Stage 3: Inspect activity and act on FIRST match --------
    $matchCount = 0
    $inspected  = 0

    foreach ($acct in $candidates) {
        $inspected++
        if ($inspected -gt $MaxAccountsToInspect) {
            Write-Log "⚠️ Safety stop: inspected capped at $MaxAccountsToInspect accounts." 'Yellow'
            break
        }

        # Skip if already on target platform
        if ($acct.platformId -eq $TargetPlatformId) { continue }

        $acctId = $acct.id
        $safe   = $acct.safeName
        $user   = $acct.userName
        $addr   = $acct.address
        $plat   = $acct.platformId

        Write-Log ("Inspecting AccountID={0} Safe={1} User={2} Address={3} Platform={4}" -f $acctId,$safe,$user,$addr,$plat) 'Cyan'

        $acts = $null
        try {
            $acts = Get-AccountActivitiesSafe -AccountID $acctId
        } catch {
            Write-Log ("⚠️ Cannot read activity for AccountID={0}: {1}" -f $acctId, $_.Exception.Message) 'DarkYellow'
            continue
        }

        if (-not $acts) { continue }

        $toCheck = @($acts | Select-Object -First $MaxActivitiesToInspect)
        $isMatch = $false

        foreach ($act in $toCheck) {
            if (ActivityMatchesNeedle -ActivityItem $act) {
                $isMatch = $true
                break
            }
        }

        if (-not $isMatch) { continue }

        Write-Log ("✅ MATCH FOUND: AccountID={0} Safe={1} User={2} Address={3} Platform={4}" -f $acctId,$safe,$user,$addr,$plat) 'Green'

        if ($PSCmdlet.ShouldProcess("AccountID=$acctId", "Update platformId -> $TargetPlatformId")) {
            try {
                Update-AccountPlatformSafe -AccountID $acctId -PlatformID $TargetPlatformId
                Write-Log ("✅ UPDATED: AccountID={0} platformId '{1}' -> '{2}'" -f $acctId, $plat, $TargetPlatformId) 'Green'
            } catch {
                Write-Log ("❌ UPDATE FAILED: AccountID={0} Error: {1}" -f $acctId, $_.Exception.Message) 'Red'
                throw
            }
        } else {
            Write-Log ("WHATIF: Would update AccountID={0} '{1}' -> '{2}'" -f $acctId, $plat, $TargetPlatformId) 'Cyan'
        }

        $matchCount++
        if ($matchCount -ge $MaxMatches) {
            Write-Log "Stopping after $matchCount match(es) as requested." 'Yellow'
            break
        }
    }

    if ($matchCount -eq 0) {
        Write-Log "❌ No matching accounts found (activity did not contain needle/regex)." 'Red'
        exit 3
    }

} finally {
    try { Close-PASSession | Out-Null } catch { }
    Write-Log "Done." 'Green'
}
