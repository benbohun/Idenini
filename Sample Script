<# =====================================================================
CCP -> Identity Header -> psPAS
Find FIRST failed account whose activity contains:
  "Reason: This user can't sign in because this account is currently disabled. (winRc=1331)."
Then update platformId to: Disabled_Domain_Account

Safe approach:
- Uses Saved Filters (FailedVerify/FailedChange/FailedReconcile) to reduce scope
- Stops after 1 match (per your request)
- Uses PATCH-style update via Set-PASAccount (does NOT wipe other fields)

Run test mode:
  .\Fix-DisabledAccounts_FirstMatch.ps1 -WhatIf
===================================================================== #>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [string]$TargetPlatformId = "Disabled_Domain_Account",

    # Exact substring you provided (note: single-quote escaping handled below)
    [string]$ErrorNeedle = "Reason: This user can't sign in because this account is currently disabled. (winRc=1331).",

    # Stop after finding/updating 1 account
    [int]$MaxMatches = 1,

    # Paging for Get Accounts API (max 1000 per CyberArk docs)
    [ValidateRange(1,1000)]
    [int]$PageSize = 200,

    # Safety guard to avoid runaway loops
    [int]$MaxAccountsToInspect = 10000
)

# =========================
# Baseline / Logging
# =========================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force

$LogFile = "E:\Installation Media\Script\OnboardScript\data\DisabledAccountPlatformUpdate.log"
New-Item -ItemType File -Force -Path $LogFile | Out-Null

function Write-Log {
    param([string]$Message, [ConsoleColor]$Color = 'White')
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# =========================
# CCP / Identity config (your existing values)
# =========================
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# =========================
# Login helper (UNCHANGED from your working pattern)
# =========================
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,  # e.g., cna.com-CA_PAMDiscovery_SVC
        [Parameter(Mandatory)] [string]$UPUser       # e.g., CA_PAMDiscovery_SVC
    )

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log "Retrieving CCP credential for '$UPUser' via Object..." 'Cyan'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }
    Write-Log "CCP returned username for service principal." 'Green'

    $secPass = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upCred  = [PSCredential]::new($UPUser, $secPass)

    Write-Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." 'Cyan'
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upCred

    Use-PASSession $hdr
    if (-not (Get-PASSession)) { throw "psPAS session not established." }

    $resp.Content = $null
    Write-Log "PAS session established (no prompts)." 'Green'
}

# =========================
# Helper: robust “contains text” check across objects
# =========================
function Test-ObjectContainsText {
    param(
        [Parameter(Mandatory)] [object]$Object,
        [Parameter(Mandatory)] [string]$Needle
    )
    try {
        $json = $Object | ConvertTo-Json -Depth 30 -Compress
        return ($json -like ("*" + $Needle + "*"))
    } catch {
        # Fallback: string cast
        return ([string]$Object -like ("*" + $Needle + "*"))
    }
}

# =========================
# Helper: Get accounts by Saved Filter (manual paging; STOP EARLY)
# =========================
function Get-AccountsPageBySavedFilter {
    param(
        [Parameter(Mandatory)] [string]$SavedFilter,
        [Parameter(Mandatory)] [int]$Offset,
        [Parameter(Mandatory)] [int]$Limit
    )

    $sess = Get-PASSession
    if (-not $sess -or -not $sess.BaseURI -or -not $sess.WebSession) {
        throw "PAS session missing BaseURI/WebSession. Ensure Start-PASSessionFromCCP succeeded."
    }

    $uri = "{0}/API/Accounts?savedFilter={1}&offset={2}&limit={3}" -f `
        $sess.BaseURI, ([uri]::EscapeDataString($SavedFilter)), $Offset, $Limit

    return (Invoke-RestMethod -Method GET -Uri $uri -WebSession $sess.WebSession)
}

# =========================
# Authenticate
# =========================
Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC"

# =========================
# Pre-check: confirm target platform exists (fail fast)
# =========================
Write-Log "Validating target platform exists: $TargetPlatformId" 'Yellow'
try {
    $plat = Get-PASPlatform -PlatformID $TargetPlatformId -ErrorAction Stop
    Write-Log "✅ Platform found: $($plat.General.PlatformID)" 'Green'
} catch {
    Write-Log "❌ Target platform '$TargetPlatformId' not found/accessible. Aborting. Error: $($_.Exception.Message)" 'Red'
    throw
}

# =========================
# Find FIRST matching failed account
# =========================
$SavedFiltersToCheck = @("FailedVerify", "FailedChange", "FailedReconcile")
Write-Log "Searching failed accounts via Saved Filters: $($SavedFiltersToCheck -join ', ')" 'Yellow'
Write-Log "Looking for activity substring: $ErrorNeedle" 'Yellow'

$matches = 0
$inspected = 0
$foundAccount = $null

foreach ($sf in $SavedFiltersToCheck) {
    $offset = 0

    while ($true) {
        if ($inspected -ge $MaxAccountsToInspect) {
            Write-Log "⚠️ Safety stop reached: inspected $inspected accounts (MaxAccountsToInspect=$MaxAccountsToInspect)." 'Yellow'
            break
        }

        Write-Log "Fetching accounts page: savedFilter=$sf offset=$offset limit=$PageSize" 'Cyan'
        try {
            $resp = Get-AccountsPageBySavedFilter -SavedFilter $sf -Offset $offset -Limit $PageSize
        } catch {
            Write-Log "❌ Failed fetching accounts for savedFilter=$sf offset=$offset. Error: $($_.Exception.Message)" 'Red'
            break
        }

        $page = @()
        if ($resp -and $resp.value) { $page = @($resp.value) }

        if ($page.Count -eq 0) {
            Write-Log "No more accounts returned for savedFilter=$sf (offset=$offset)." 'Gray'
            break
        }

        foreach ($acct in $page) {
            $inspected++

            # Skip if already on target platform
            if ($acct.platformId -eq $TargetPlatformId) { continue }

            # Optional quick gate: only look at explicit failures (if present)
            if ($acct.secretManagement -and $acct.secretManagement.status -and ($acct.secretManagement.status.ToString().ToLower() -ne "failure")) {
                continue
            }

            # Pull account activity and search for the needle
            try {
                $activity = Get-PASAccountActivity -AccountID $acct.id -ErrorAction Stop
            } catch {
                Write-Log "⚠️ Unable to read activity for AccountID=$($acct.id). Error: $($_.Exception.Message)" 'Yellow'
                continue
            }

            if ($null -ne $activity -and (Test-ObjectContainsText -Object $activity -Needle $ErrorNeedle)) {
                $foundAccount = $acct
                Write-Log "✅ MATCH FOUND (FIRST): AccountID=$($acct.id) Safe=$($acct.safeName) User=$($acct.userName) Address=$($acct.address) Platform=$($acct.platformId)" 'Green'
                break
            }

            if ($inspected % 250 -eq 0) {
                Write-Log "Progress: inspected=$inspected, current savedFilter=$sf" 'Gray'
            }
        }

        if ($foundAccount) { break }

        # Next page
        $offset += $PageSize
    }

    if ($foundAccount) { break }
}

if (-not $foundAccount) {
    Write-Log "❌ No matching account found (needle not seen in activities) after inspecting $inspected accounts." 'Red'
    try { Close-PASSession | Out-Null } catch {}
    return
}

# =========================
# Update platform for FIRST match only
# =========================
$acctId = $foundAccount.id
$oldPlat = $foundAccount.platformId

if ($PSCmdlet.ShouldProcess("AccountID=$acctId", "Update platformId from '$oldPlat' to '$TargetPlatformId'")) {

    Write-Log "Updating platform for AccountID=$acctId -> $TargetPlatformId" 'Yellow'

    # Prefer canonical path: /platformId
    $updated = $false
    try {
        Set-PASAccount -AccountID $acctId -op replace -path "/platformId" -value $TargetPlatformId -ErrorAction Stop | Out-Null
        $updated = $true
    } catch {
        Write-Log "⚠️ Update failed using path '/platformId'. Will retry with '/platformID'. Error: $($_.Exception.Message)" 'Yellow'
    }

    if (-not $updated) {
        try {
            Set-PASAccount -AccountID $acctId -op replace -path "/platformID" -value $TargetPlatformId -ErrorAction Stop | Out-Null
            $updated = $true
        } catch {
            Write-Log "❌ Update failed using both '/platformId' and '/platformID'. Error: $($_.Exception.Message)" 'Red'
            throw
        }
    }

    Write-Log "✅ Platform updated: AccountID=$acctId '$oldPlat' -> '$TargetPlatformId'" 'Green'
} else {
    Write-Log "WHATIF: Would update AccountID=$acctId '$oldPlat' -> '$TargetPlatformId'" 'Cyan'
}

# =========================
# Close session
# =========================
try { Close-PASSession | Out-Null } catch {}
Write-Log "Done." 'Green'
