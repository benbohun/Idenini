# ============================================
# CCP -> Identity -> psPAS
# Find 1 account failing with winRc=1331, disable CPM auto-management,
# then output instructions to move it to Safe: Domain_Account_Disabled
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force

# ---------- Minimal logger (no secrets) ----------
$LogFile = "E:\Installation Media\Script\OnboardScript\data\DisabledAccountMoveScript.log"
New-Item -ItemType File -Force -Path $LogFile | Out-Null
function Write-Log {
    param([string]$Message, [ConsoleColor]$Color = 'White')
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# ---------- CCP / Identity config ----------
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# ---------- Target safe to move into (manual PVWA move step) ----------
$TargetSafeName = "Domain_Account_Disabled"

# ---------- Needle patterns (DON'T include the literal "Reason:" prefix) ----------
$NeedlePatterns = @(
    "winrc=1331",
    "account is currently disabled",
    "error_account_disabled"
)

# ---------- Login helper: CCP (Object) -> psPAS header ----------
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,  # e.g., cna.com-CA_PAMDiscovery_SVC
        [Parameter(Mandatory)] [string]$UPUser       # e.g., CA_PAMDiscovery_SVC
    )

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log "Retrieving CCP credential for '$UPUser' via Object..." 'Cyan'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }
    Write-Log "CCP returned username for service principal." 'Green'

    # Build PSCredential (do not print secrets)
    $secPass = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upCred  = [PSCredential]::new($UPUser, $secPass)

    Write-Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." 'Cyan'
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upCred
    Use-PASSession $hdr
    if (-not (Get-PASSession)) { throw "psPAS session not established." }

    # Minimize plaintext exposure
    $resp.Content = $null
    Write-Log "PAS session established (no prompts)." 'Green'
}

function Get-BaseURI {
    $sess = Get-PASSession
    if (-not $sess) { throw "No PAS session. Call Start-PASSessionFromCCP first." }

    $base = $sess.BaseURI
    if (-not $base) { throw "psPAS session missing BaseURI." }

    return $base.TrimEnd('/')
}

function Normalize-ToArray {
    param($Value)
    if ($null -eq $Value) { return @() }
    if ($Value -is [string]) { return @($Value) }
    if ($Value -is [System.Collections.IEnumerable]) { return @($Value) }
    return @($Value)
}

function Get-AccountsPage {
    param(
        [Parameter(Mandatory)] [string]$SavedFilter,
        [int]$Offset = 0,
        [int]$Limit  = 200
    )

    $base = Get-BaseURI

    # Using documented endpoint shape; case is generally not sensitive
    $uri = "$base/api/Accounts?savedFilter=$([uri]::EscapeDataString($SavedFilter))&offset=$Offset&limit=$Limit"

    Write-Log "Fetching accounts page: savedFilter=$SavedFilter offset=$Offset limit=$Limit" 'DarkCyan'
    $resp = Invoke-PASRestMethod -Uri $uri -Method GET

    # Handle both shapes:
    # - Some environments return { value: [ ... ], count: N }
    # - Others may return array directly
    if ($null -ne $resp.value) { return (Normalize-ToArray $resp.value) }
    return (Normalize-ToArray $resp)
}

function Get-AccountActivities {
    param([Parameter(Mandatory)] [string]$AccountId)

    $base = Get-BaseURI
    $uri  = "$base/api/Accounts/$([uri]::EscapeDataString($AccountId))/Activities/"

    $resp = Invoke-PASRestMethod -Uri $uri -Method GET
    if ($null -ne $resp.Activities) { return (Normalize-ToArray $resp.Activities) }
    if ($null -ne $resp.activities) { return (Normalize-ToArray $resp.activities) }

    return @()
}

function Activity-MatchesNeedle {
    param(
        [Parameter(Mandatory)] $Activity,
        [Parameter(Mandatory)] [string[]]$Patterns
    )

    $hay = @(
        [string]$Activity.Reason
        [string]$Activity.MoreInfo
        [string]$Activity.Action
        [string]$Activity.User
        [string]$Activity.ClientID
    ) -join " | "

    foreach ($p in $Patterns) {
        if ($hay -match [regex]::Escape($p)) { return $true }
    }
    return $false
}

function Test-TargetSafeExists {
    param([Parameter(Mandatory)] [string]$SafeName)

    Write-Log "Validating target safe exists: $SafeName" 'Yellow'

    try {
        # Some psPAS versions support -SafeName; fallback included
        $safeObj = $null
        try { $safeObj = Get-PASSafe -SafeName $SafeName -ErrorAction Stop } catch { $safeObj = $null }

        if (-not $safeObj) {
            $safeObj = Get-PASSafe -ErrorAction Stop | Where-Object { $_.SafeName -eq $SafeName }
        }

        if (-not $safeObj) { throw "Safe not found: $SafeName" }

        Write-Log "✅ Safe found: $SafeName" 'Green'
        return $true
    }
    catch {
        Write-Log "❌ Target safe validation failed: $($_.Exception.Message)" 'Red'
        return $false
    }
}

function Find-FirstDisabledWinRc1331Account {
    param(
        [string[]]$SavedFiltersToTry,
        [int]$PageLimit = 200,
        [int]$MaxAccountsToInspect = 1000
    )

    $inspected = 0

    foreach ($sf in $SavedFiltersToTry) {
        $offset = 0

        while ($true) {
            $accounts = Get-AccountsPage -SavedFilter $sf -Offset $offset -Limit $PageLimit
            if (-not $accounts -or $accounts.Count -eq 0) {
                Write-Log "No more accounts returned for savedFilter=$sf (offset=$offset)." 'DarkGray'
                break
            }

            foreach ($acct in $accounts) {
                $inspected++
                if ($inspected -gt $MaxAccountsToInspect) {
                    Write-Log "Reached MaxAccountsToInspect=$MaxAccountsToInspect; stopping search." 'Yellow'
                    return $null
                }

                # Pull activities and search for winRc=1331 indicators
                $acts = Get-AccountActivities -AccountId $acct.id
                foreach ($a in $acts) {
                    if (Activity-MatchesNeedle -Activity $a -Patterns $NeedlePatterns) {
                        Write-Log "✅ Match found in activities: AccountId=$($acct.id) Safe=$($acct.safeName) Name=$($acct.name)" 'Green'
                        return $acct
                    }
                }
            }

            $offset += $PageLimit
        }
    }

    Write-Log "❌ No matching account found after inspecting $inspected accounts." 'Red'
    return $null
}

# -------------------- MAIN --------------------

# 1) Authenticate (service: CA_PAMDiscovery_SVC)
Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC"

# 2) Validate target safe exists
if (-not (Test-TargetSafeExists -SafeName $TargetSafeName)) {
    throw "Target safe '$TargetSafeName' does not exist (or cannot be read)."
}

# 3) Search for 1 matching failed account (start narrow, then broaden)
Write-Log "Searching candidate accounts via Saved Filters..." 'Yellow'
$Filters = @(
    "FailedVerify",
    "FailedChange",
    "FailedReconcile",
    "PolicyFailures",
    "Recently"
)

Write-Log "Looking for activity patterns: $($NeedlePatterns -join ', ')" 'Cyan'
$match = Find-FirstDisabledWinRc1331Account -SavedFiltersToTry $Filters -PageLimit 200 -MaxAccountsToInspect 1200

if (-not $match) {
    Write-Log "Nothing to quarantine right now." 'Yellow'
    try { Close-PASSession | Out-Null } catch {}
    exit 0
}

# 4) Quarantine immediately: disable CPM auto-management (stops repeated failures/noise)
try {
    $reason = "Quarantine: AD account disabled (winRc=1331). Move to safe '$TargetSafeName'."
    Write-Log "Disabling CPM auto-management on AccountId=$($match.id) ..." 'Yellow'
    Disable-PASCPMAutoManagement -AccountID $match.id -Reason $reason | Out-Null
    Write-Log "✅ CPM auto-management disabled for AccountId=$($match.id)." 'Green'
}
catch {
    Write-Log "❌ Failed to disable CPM auto-management: $($_.Exception.Message)" 'Red'
}

# 5) Move to different SAFE (supported via PVWA Classic UI; not exposed as public REST)
Write-Log "NEXT STEP (manual PVWA Classic): Move the account to safe '$TargetSafeName'." 'Magenta'
Write-Log "Account details: Id=$($match.id) | Safe=$($match.safeName) | Name=$($match.name) | Address=$($match.address) | User=$($match.userName) | Platform=$($match.platformId)" 'Magenta'

# Optional: close session
try { Close-PASSession | Out-Null } catch {}
