# IND_SafeCreation.ps1
# Creates/ensures IND_<Samaccountname>_<employeeID> safes (7-day retention),
# adds standard members & Owner (email) with LIMITED perms you specified,
# and re-attempts membership if a target member is not present.

[CmdletBinding(SupportsShouldProcess=$true)]
param(
  [ValidateScript({ Test-Path $_ })]
  [string]$CsvPath   = "I:\Script\REPORTS\owners.csv",
  [string]$BaseURI   = "https://alliantcredit.privilegecloud.cyberark.com",
  [ValidateSet('CyberArk','LDAP','RADIUS','Windows','SAML','Shared')]
  [string]$AuthType  = 'CyberArk',
  [string]$ManagingCPM = 'HQVECYBARK101',
  [string]$Location  = "\",
  # Directory integration (exact MemberLocation/SearchIn as configured in PVWA)
  [string]$DirLocation = 'HQVACUDC101.alliantcreditunion.com'
)

Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

function Write-Info($m){ Write-Host "[*] $m" -ForegroundColor Cyan }
function Write-Ok($m){ Write-Host "[OK] $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[!] $m" -ForegroundColor Yellow }
function Write-Err($m){ Write-Host "[X] $m" -ForegroundColor Red }

# --- clear any conflicting helpers from the session ---
foreach($f in 'Add-INDMemberSmart','Ensure-Member','Ensure-SafeMember','Add-CAKSafeMember','Ensure-CAKMemberPresent','Test-CAKMemberPresent'){
  if (Get-Command $f -ErrorAction SilentlyContinue) { Remove-Item "function:$f" -ErrorAction SilentlyContinue }
}

# Only the flags Add/Set-PASSafeMember support
$AllowedPermKeys = @(
  'UseAccounts','RetrieveAccounts','ListAccounts','AddAccounts',
  'UpdateAccountContent','UpdateAccountProperties',
  'InitiateCPMAccountManagementOperations','SpecifyNextAccountContent',
  'ViewAuditLog','ViewSafeMembers','AccessWithoutConfirmation',
  'ManageSafe','ManageSafeMembers'
)

function Get-AllPermFlags {
  @{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
  }
}

# OWNER (email) gets ONLY the permissions you listed
function Get-OwnerPermFlags {
  @{
    ListAccounts                           = $true
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    InitiateCPMAccountManagementOperations = $true
    ViewSafeMembers                        = $true
    ViewAuditLog                           = $true
    AccessWithoutConfirmation              = $true

    # Not granted:
    AddAccounts                            = $false
    UpdateAccountContent                   = $false
    UpdateAccountProperties                = $false
    SpecifyNextAccountContent              = $false
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
  }
}

function Select-PermParams([hashtable]$h) {
  $out = @{}
  foreach ($k in $AllowedPermKeys) { if ($h.ContainsKey($k)) { $out[$k] = [bool]$h[$k] } }
  $out
}

# Build name variants for directory lookups (sAM left-of-@ first, then UPN; handle computer $)
function Get-NameVariants([string]$MemberName, [string]$DirLocation) {
  $list = [System.Collections.Generic.List[string]]::new()
  $t = $MemberName.Trim(); if (-not $t) { return $list }

  if ($t -like '*@*') {
    $left = $t.Split('@')[0]
    if ($left) { $list.Add($left) }        # sAM first
    if (-not $list.Contains($t)) { $list.Add($t) }  # then given UPN
  } else {
    $list.Add($t)
    $upn = "$t@$DirLocation"
    if (-not $list.Contains($upn)) { $list.Add($upn) }
  }

  if ($t.EndsWith('$')) {
    $machUpn = "$t@$DirLocation"
    if (-not $list.Contains($machUpn)) { $list.Add($machUpn) }
  }
  return $list
}

# Add/Update a member with SearchIn and optional DirectoryPrincipal variant tries
function Add-CAKSafeMember {
  [CmdletBinding()]
  param(
    [Parameter(Mandatory)][string]$SafeName,
    [Parameter(Mandatory)][string]$MemberName,
    [Parameter(Mandatory)][ValidateSet('User','Group','Role')][string]$Type,  # log only
    [Parameter(Mandatory)][hashtable]$PermFlags,
    [Parameter(Mandatory)][string]$SearchIn,
    [switch]$DirectoryPrincipal
  )

  $perm = Select-PermParams $PermFlags
  $namesToTry = if ($DirectoryPrincipal) { Get-NameVariants -MemberName $MemberName -DirLocation $SearchIn } else { [System.Collections.Generic.List[string]]@($MemberName.Trim()) }

  foreach ($n in $namesToTry) {
    try {
      $params = @{ SafeName = $SafeName; MemberName = $n; SearchIn = $SearchIn }
      $params += $perm
      Add-PASSafeMember @params -ErrorAction Stop | Out-Null
      Write-Ok "Added $Type '$n' (SearchIn='$SearchIn') to '$SafeName'."
      return $true
    } catch {
      $msg = $_.Exception.Message

      $retryableNotFound = ($DirectoryPrincipal -and (
          $msg -match '\[404\]' -or
          $msg -match '\[400\].*Failed to find user' -or
          $msg -match 'has not been defined' -or
          $msg -match 'was not found' -or
          $msg -match 'in ldap mapping'
        ))

      if ($msg -match 'already exists' -or $msg -match '409') {
        $params = @{ SafeName = $SafeName; MemberName = $n; SearchIn = $SearchIn }
        $params += $perm
        Set-PASSafeMember @params -ErrorAction Stop | Out-Null
        Write-Ok "Updated $Type '$n' on '$SafeName'."
        return $true
      } elseif ($retryableNotFound) {
        Write-Warn "Directory principal '$n' not found in '$SearchIn'. Trying next variant..."
        continue
      } else {
        Write-Err "Member '$n' failed on '$SafeName' : $msg"
        return $false
      }
    }
  }
  Write-Err "Exhausted variants; could not add '$MemberName' (Type=$Type, SearchIn='$SearchIn') to '$SafeName'."
  return $false
}

# --- MEMBERSHIP VERIFICATION & RE-ATTEMPT ---

# Returns $true if any of the candidate names is present in the safe's members (case-insensitive)
function Test-CAKMemberPresent {
  param(
    [Parameter(Mandatory)][string]$SafeName,
    [Parameter(Mandatory)][string[]]$CandidateNames
  )
  try {
    $members = Get-PASSafeMembers -SafeName $SafeName -ErrorAction Stop
  } catch {
    Write-Warn "Could not read members of '$SafeName' for verification: $($_.Exception.Message)"
    return $false
  }

  $set = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
  foreach ($m in $members) {
    $n = $null
    if ($m.MemberName) { $n = $m.MemberName.ToString().Trim() }
    elseif ($m.name)   { $n = $m.name.ToString().Trim() }
    if ($n -and -not $set.Contains($n)) { $set.Add($n) | Out-Null }
  }

  foreach ($c in $CandidateNames) {
    if ($set.Contains($c)) { return $true }
  }
  return $false
}

# Ensures a member exists; add -> verify; if not found, retry up to 3 times (with short delays)
function Ensure-CAKMemberPresent {
  [CmdletBinding()]
  param(
    [Parameter(Mandatory)][string]$SafeName,
    [Parameter(Mandatory)][string]$MemberName,
    [Parameter(Mandatory)][ValidateSet('User','Group','Role')][string]$Type,
    [Parameter(Mandatory)][hashtable]$PermFlags,
    [Parameter(Mandatory)][string]$SearchIn,
    [switch]$DirectoryPrincipal
  )

  $candidates = @($MemberName.Trim())
  if ($DirectoryPrincipal) { $candidates = Get-NameVariants -MemberName $MemberName -DirLocation $SearchIn }

  for($i=1; $i -le 3; $i++){
    Write-Info "Attempt $i to add/verify $Type '$MemberName' on '$SafeName'…"
    $ok = Add-CAKSafeMember -SafeName $SafeName -MemberName $MemberName -Type $Type -PermFlags $PermFlags -SearchIn $SearchIn -DirectoryPrincipal:$DirectoryPrincipal
    Start-Sleep -Seconds 2
    $present = Test-CAKMemberPresent -SafeName $SafeName -CandidateNames $candidates
    if ($present) {
      Write-Ok "$Type '$MemberName' is present on '$SafeName'."
      return
    }
    if (-not $ok) { Write-Warn "Add/Update may have failed; will retry." }
  }
  Write-Warn "After retries, $Type '$MemberName' still not confirmed on '$SafeName'."
}

# ---------- Logon ----------
$cred = Get-Credential -Message "Enter your CyberArk ($AuthType) credential"
try {
  New-PASSession -Credential $cred -BaseURI $BaseURI -Type $AuthType | Out-Null
  Write-Ok "Authenticated to $BaseURI."
} catch {
  Write-Err "Authentication failed: $($_.Exception.Message)"; return
}

try {
  $rows = Import-Csv -Path $CsvPath
  if (-not $rows) { Write-Err "No rows in CSV ($CsvPath)."; return }

  $permAll   = Get-AllPermFlags
  $permOwner = Get-OwnerPermFlags

  foreach ($row in $rows) {
    $sam  = ($row.Samaccountname).ToString().Trim()
    $eid  = ($row.employeeID).ToString().Trim()
    $mail = ($row.email).ToString().Trim()

    if ([string]::IsNullOrWhiteSpace($sam) -or [string]::IsNullOrWhiteSpace($eid) -or [string]::IsNullOrWhiteSpace($mail)) {
      Write-Warn "Skipping row with missing fields: $($row | ConvertTo-Json -Compress)"; continue
    }

    # IND_<sam>_<eid>
    $safeName = "IND_{0}_{1}" -f $sam, $eid
    Write-Info "Processing Safe: $safeName (Owner=$mail)"

    # Create Safe if missing; ensure 7-day retention
    $exists = $null; try { $exists = Get-PASSafe -SafeName $safeName -ErrorAction SilentlyContinue } catch {}
    if (-not $exists) {
      $splat = @{
        SafeName              = $safeName
        Description           = "Individual safe for $sam ($eid)"
        ManagingCPM           = $ManagingCPM
        NumberOfDaysRetention = 7
        location              = $Location
      }
      if ($PSCmdlet.ShouldProcess($safeName, "Add-PASSafe")) {
        try { Add-PASSafe @splat -ErrorAction Stop | Out-Null; Write-Ok "Created Safe '$safeName'." }
        catch { Write-Err "Failed to create Safe '$safeName' : $($_.Exception.Message)"; continue }
      }
    } else {
      Write-Warn "Safe '$safeName' already exists; ensuring retention & members."
      try { Set-PASSafe -SafeName $safeName -NumberOfDaysRetention 7 -ErrorAction SilentlyContinue | Out-Null; Write-Ok "Ensured 7-day retention on '$safeName'." }
      catch { Write-Warn "Could not set retention on existing '$safeName': $($_.Exception.Message)" }
    }

    # --- Members (with re-verify + re-attempt) ---
    # Vault users (full permissions)
    Ensure-CAKMemberPresent -SafeName $safeName -MemberName 'ACURestAPI_Local'                     -Type User  -PermFlags $permAll   -SearchIn 'Vault'
    Ensure-CAKMemberPresent -SafeName $safeName -MemberName 'identity-privilege-integration-user$' -Type User  -PermFlags $permAll   -SearchIn 'Vault'

    # Directory group with full perms
    Ensure-CAKMemberPresent -SafeName $safeName -MemberName 'IAM_ACU_CA_Admins@alliantcreditunion.com' -Type Group -PermFlags $permAll   -SearchIn $DirLocation -DirectoryPrincipal
    # Owner (email) with LIMITED perms you specified
    Ensure-CAKMemberPresent -SafeName $safeName -MemberName $mail                                      -Type User  -PermFlags $permOwner -SearchIn $DirLocation -DirectoryPrincipal
  }

  Write-Ok "All rows processed."
}
finally {
  try { Close-PASSession | Out-Null; Write-Ok "Logged off." } catch { Write-Warn "Logoff warning: $($_.Exception.Message)" }
}
