<#
.SYNOPSIS
    Validates whether account AppCodes have matching CyberArk Safes ending in AMNG or OMNG.

.DESCRIPTION
    Reads a CSV with AccountID, UserName, Address, and AppCode.
    For each unique AppCode, searches CyberArk Safes using AP-<AppCode>.
    Reports whether matching Safes exist and whether any matching Safe ends with AMNG or OMNG.

.NOTES
    Read-only validation script.
    Windows PowerShell 5.1 compatible.
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    [string]$CsvFile = (Join-Path $PSScriptRoot 'samples\account-appcode-template.csv'),

    [ValidateSet('dev','prod')]
    [string]$Environment = 'dev',

    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    [switch]$ProxyUseDefaultCredentials,

    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    [string]$LogId = ''
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$proxyUri = "Placehold"
if ($proxyUri -and $proxyUri.Trim() -notmatch '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') {
    $proxy = New-Object System.Net.WebProxy($proxyUri, $true)
    [System.Net.WebRequest]::DefaultWebProxy = $proxy
    [System.Net.WebRequest]::DefaultWebProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
    [System.Net.WebRequest]::DefaultWebProxy.Address | Out-Null
}

$script:LogFile = $null
$script:ReportFile = $null
$script:SummaryFile = $null
$script:Config = $null
$script:SafeCache = @{}

function Test-BlankValue {
    param([object]$Value)
    if ($null -eq $Value) { return $true }
    $text = $Value.ToString().Trim()
    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }
    return $false
}

function New-RunLog {
    if (-not (Test-Path $LogFolder)) { New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null }
    if (-not (Test-Path $ReportFolder)) { New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null }
    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }
    $script:LogFile = Join-Path $LogFolder "AppCodeSafeValidation_$stamp$suffix.log"
    $script:ReportFile = Join-Path $ReportFolder "AppCodeSafeValidation_Report_$stamp$suffix.csv"
    $script:SummaryFile = Join-Path $ReportFolder "AppCodeSafeValidation_AppCodeSummary_$stamp$suffix.csv"
    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) source=New-RunLog [INFO] Starting run"
}

function Write-RunLog {
    param([string]$Source,[string]$Message,[ValidateSet('DEBUG','INFO','WARN','ERROR')][string]$Level = 'INFO')
    $line = "$(Get-Date -Format s) source=$Source [$Level] $Message"
    Add-Content -Path $script:LogFile -Value $line
    if ($Level -eq 'ERROR') { Write-Host $line -ForegroundColor Red }
    elseif ($Level -eq 'WARN') { Write-Host $line -ForegroundColor Yellow }
    else { Write-Host $line }
}

function Read-DotEnvFile {
    param([string]$Path)
    $result = @{}
    if (-not (Test-Path $Path)) { return $result }
    foreach ($line in (Get-Content -Path $Path -ErrorAction Stop)) {
        $trimmed = $line.Trim()
        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }
        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()
        if ($value.Length -ge 2) {
            if (($value.StartsWith('"') -and $value.EndsWith('"')) -or ($value.StartsWith("'") -and $value.EndsWith("'"))) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }
        if (-not (Test-BlankValue $key)) { $result[$key] = $value }
    }
    return $result
}

function Join-EnvValues {
    param([hashtable[]]$Maps)
    $merged = @{}
    foreach ($map in $Maps) { foreach ($key in $map.Keys) { $merged[$key] = $map[$key] } }
    return $merged
}

function Normalize-PvwaApiBase {
    param([string]$PvwaValue)
    $base = $PvwaValue.Trim().TrimEnd('/')
    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Safes/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/.+$', '/PasswordVault/API'
    if ($base -match '/PasswordVault/API$') { return $base }
    if ($base -match '/PasswordVault$') { return "$base/API" }
    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    param([hashtable]$Settings)
    $tenant = $Settings['TENANT_ID']
    if (Test-BlankValue $tenant) { throw 'TENANT_ID is missing in .env.' }
    $tenant = $tenant.Trim().TrimEnd('/')
    if ($tenant -match '^https?://') { return $tenant }
    if ($tenant -match '\.id\.cyberark\.cloud$') { return "https://$tenant" }
    if ($tenant -match '\.') { return "https://$tenant" }
    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    param([hashtable]$Settings)
    $proxy = $Settings['PROXY']
    if (-not (Test-BlankValue $proxy)) { return $proxy.Trim() }
    $proxyAddress = $Settings['PROXY_ADDRESS']
    if (Test-BlankValue $proxyAddress) { $proxyAddress = $Settings['ROXY_ADDRESS'] }
    $proxyPort = $Settings['PROXY_PORT']
    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) { return $null }
    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')
    if ($proxyAddress -notmatch '^https?://') { $proxyAddress = "http://$proxyAddress" }
    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"
    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}
    if (Test-Path $envFile1) { $envSpecific = Read-DotEnvFile -Path $envFile1 }
    elseif (Test-Path $envFile2) { $envSpecific = Read-DotEnvFile -Path $envFile2 }
    else { throw "Could not find environment file for '$Environment'. Expected $envFile1 or $envFile2" }
    $settings = Join-EnvValues -Maps @($base, $envSpecific)
    if (Test-BlankValue $settings['PVWA']) {
        if (Test-BlankValue $settings['SUB_DOMAIN']) { throw 'PVWA is missing and SUB_DOMAIN is not set.' }
        $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud"
    }
    $identityBase = Resolve-IdentityBase -Settings $settings
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings
    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)
        if ($ProxyUseDefaultCredentials) { $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials }
        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }
    $script:Config = [pscustomobject]@{ Environment=$Environment; IdentityBase=$identityBase; TokenUrl="$identityBase/oauth2/platformtoken"; ApiBase=$apiBase; Proxy=$proxyFromEnv }
    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    param([hashtable]$Body)
    $pairs = @()
    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }
    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    param([string]$Text)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)
        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally { $sha.Dispose() }
}

function Get-WebErrorText {
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)
    $msg = $ErrorRecord.Exception.Message
    $response = $ErrorRecord.Exception.Response
    if ($null -ne $response) {
        try {
            $stream = $response.GetResponseStream()
            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)
                $body = $reader.ReadToEnd()
                if (-not (Test-BlankValue $body)) { $msg = "$msg | Response: $body" }
            }
        } catch {}
    }
    return $msg
}

function Get-IdentityBearerToken {
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'
    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'
    $body = ConvertTo-FormBody -Body @{ grant_type='client_credentials'; client_id=$credential.UserName; client_secret=$credential.GetNetworkCredential().Password }
    $params = @{ Method='Post'; Uri=$script:Config.TokenUrl; Body=$body; ContentType='application/x-www-form-urlencoded'; Headers=@{ Accept='application/json' }; ErrorAction='Stop' }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { $response = Invoke-RestMethod @params } catch { throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)" }
    if ($null -eq $response.access_token) { throw 'Identity token response did not include access_token.' }
    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token
    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'INFO'
    return $token
}

function Invoke-CyberArkRest {
    param([ValidateSet('GET','POST','PATCH','DELETE')][string]$Method,[string]$Path,[string]$Token,[object]$Body=$null,[string]$ContentType='application/json')
    if ($Path -match '^https?://') { $uri = $Path } else { $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))" }
    $params = @{ Method=$Method; Uri=$uri; Headers=@{ Authorization="Bearer $Token" }; ErrorAction='Stop' }
    if ($Method -ne 'GET' -and $Method -ne 'DELETE') { $params['ContentType'] = $ContentType }
    if ($null -ne $Body) { if ($Body -is [string]) { $params['Body'] = $Body } else { $params['Body'] = ($Body | ConvertTo-Json -Depth 30 -Compress) } }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { return Invoke-RestMethod @params } catch { throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)" }
}

function Get-RowValue {
    param([pscustomobject]$Row,[string[]]$Names)
    foreach ($name in $Names) {
        $p = $Row.PSObject.Properties[$name]
        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) { return $p.Value.ToString().Trim() }
    }
    return $null
}

function Get-CsvRows {
    if (-not (Test-Path $CsvFile)) { throw "CSV file not found: $CsvFile" }
    if ((Get-Item $CsvFile).Length -eq 0) { throw "CSV file is empty: $CsvFile" }
    $rows = Import-Csv -Path $CsvFile | Where-Object { ($_.PSObject.Properties.Value | Where-Object { $null -ne $_ -and $_.ToString().Trim().Length -gt 0 }).Count -gt 0 }
    if ($null -eq $rows -or @($rows).Count -eq 0) { throw "CSV contains no data rows: $CsvFile" }
    $first = @($rows)[0]
    foreach ($required in @('AccountID','UserName','Address','AppCode')) {
        $aliases = switch ($required) {
            'AccountID' { @('AccountID','Account ID','id','ID') }
            'UserName' { @('UserName','Username','User Name','TargetUserName') }
            'Address' { @('Address','TargetAddress','Target Address') }
            'AppCode' { @('AppCode','App Code','APPCode','AppID','App ID') }
        }
        $found = $false
        foreach ($alias in $aliases) { if ($first.PSObject.Properties[$alias]) { $found = $true; break } }
        if (-not $found) { throw "CSV is missing required column '$required'. Accepted aliases: $($aliases -join ', ')" }
    }
    Write-RunLog 'Get-CsvRows' "Imported $(@($rows).Count) row(s) from $CsvFile" 'INFO'
    return @($rows)
}

function Get-SafeNameFromObject {
    param([object]$SafeObject)
    foreach ($name in @('safeName','SafeName','name','Name')) {
        $p = $SafeObject.PSObject.Properties[$name]
        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) { return $p.Value.ToString() }
    }
    return ''
}

function ConvertTo-SafeList {
    param([object]$Response)
    if ($null -eq $Response) { return @() }
    if ($Response -is [System.Array]) { return @($Response) }
    foreach ($name in @('value','safes','Safes')) {
        $p = $Response.PSObject.Properties[$name]
        if ($null -ne $p) { return @($p.Value) }
    }
    return @($Response)
}

function Get-SafesByAppCode {
    param([string]$AppCode,[string]$Token)
    $normalized = $AppCode.ToUpper()
    $searchPrefix = "AP-$normalized"
    if ($script:SafeCache.ContainsKey($normalized)) { return $script:SafeCache[$normalized] }
    $all = @()
    $limit = 1000
    $offset = 0
    do {
        $search = [System.Uri]::EscapeDataString($searchPrefix)
        $path = "Safes?search=$search&limit=$limit&offset=$offset"
        Write-RunLog 'Get-SafesByAppCode' "Searching Safes for AppCode=$normalized SearchPrefix=$searchPrefix Offset=$offset" 'INFO'
        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-SafeList -Response $response)
        foreach ($item in $items) {
            $safeName = Get-SafeNameFromObject -SafeObject $item
            if (-not (Test-BlankValue $safeName)) { $all += $safeName }
        }
        $offset += $limit
    } while ($items.Count -eq $limit)
    $unique = @($all | Sort-Object -Unique)
    $script:SafeCache[$normalized] = $unique
    return $unique
}

function Test-AppCode {
    param([string]$AppCode)
    if (Test-BlankValue $AppCode) { return $false }
    return ($AppCode.Trim() -match '^[A-Za-z0-9]{3}$')
}

function New-AppCodeSafeResult {
    param([pscustomobject]$Row,[int]$RowNumber,[string]$Token)
    $accountId = Get-RowValue -Row $Row -Names @('AccountID','Account ID','id','ID')
    $userName = Get-RowValue -Row $Row -Names @('UserName','Username','User Name','TargetUserName')
    $address = Get-RowValue -Row $Row -Names @('Address','TargetAddress','Target Address')
    $appCodeRaw = Get-RowValue -Row $Row -Names @('AppCode','App Code','APPCode','AppID','App ID')
    $appCode = if (Test-BlankValue $appCodeRaw) { '' } else { $appCodeRaw.ToUpper() }
    $searchPrefix = if (Test-BlankValue $appCode) { '' } else { "AP-$appCode" }
    $result = [ordered]@{ Row=$RowNumber; AccountID=$accountId; UserName=$userName; Address=$address; AppCode=$appCode; MatchingAppID=$appCode; SearchPrefix=$searchPrefix; HasMatchingAPSafe=$false; HasAMNGSafe=$false; HasOMNGSafe=$false; MatchStatus=''; AMNGSafes=''; OMNGSafes=''; OtherMatchingSafes=''; AllMatchingSafes=''; Result=''; Message='' }
    try {
        if (-not (Test-AppCode -AppCode $appCode)) {
            $result.Result = 'FAILED'; $result.MatchStatus = 'InvalidAppCode'; $result.Message = "AppCode must be exactly 3 letters or numbers. Value='$appCodeRaw'"; return [pscustomobject]$result
        }
        $safeNames = @(Get-SafesByAppCode -AppCode $appCode -Token $Token)
        $escapedPrefix = [regex]::Escape($searchPrefix)
        $matching = @($safeNames | Where-Object { $_ -match "^$escapedPrefix" } | Sort-Object -Unique)
        $amng = @($matching | Where-Object { $_ -match 'AMNG$' } | Sort-Object -Unique)
        $omng = @($matching | Where-Object { $_ -match 'OMNG$' } | Sort-Object -Unique)
        $other = @($matching | Where-Object { ($_ -notmatch 'AMNG$') -and ($_ -notmatch 'OMNG$') } | Sort-Object -Unique)
        $result.HasMatchingAPSafe = ($matching.Count -gt 0)
        $result.HasAMNGSafe = ($amng.Count -gt 0)
        $result.HasOMNGSafe = ($omng.Count -gt 0)
        $result.AMNGSafes = ($amng -join '; ')
        $result.OMNGSafes = ($omng -join '; ')
        $result.OtherMatchingSafes = ($other -join '; ')
        $result.AllMatchingSafes = ($matching -join '; ')
        if ($result.HasAMNGSafe -and $result.HasOMNGSafe) { $result.MatchStatus = 'AMNG_AND_OMNG_FOUND' }
        elseif ($result.HasAMNGSafe) { $result.MatchStatus = 'AMNG_FOUND_ONLY' }
        elseif ($result.HasOMNGSafe) { $result.MatchStatus = 'OMNG_FOUND_ONLY' }
        elseif ($result.HasMatchingAPSafe) { $result.MatchStatus = 'APPCODE_SAFE_FOUND_NO_AMNG_OR_OMNG' }
        else { $result.MatchStatus = 'NO_APPCODE_SAFE_FOUND' }
        $result.Result = 'SUCCESS'
        $result.Message = "Found $($matching.Count) matching Safe(s) for AppCode=$appCode."
        return [pscustomobject]$result
    } catch { $result.Result = 'FAILED'; $result.Message = $_.Exception.Message; return [pscustomobject]$result }
}

function Add-CsvRow {
    param([string]$Path,[pscustomobject]$Row)
    if (-not (Test-Path $Path)) { $Row | Export-Csv -Path $Path -NoTypeInformation }
    else { $Row | Export-Csv -Path $Path -NoTypeInformation -Append }
}

function Write-AppCodeSummary {
    param([array]$Results)
    $groups = $Results | Group-Object AppCode
    foreach ($group in $groups) {
        if (Test-BlankValue $group.Name) { continue }
        $items = @($group.Group)
        $first = $items[0]
        Add-CsvRow -Path $script:SummaryFile -Row ([pscustomobject]@{ AppCode=$group.Name; MatchingAppID=$group.Name; SearchPrefix="AP-$($group.Name)"; AccountCount=$items.Count; HasMatchingAPSafe=$first.HasMatchingAPSafe; HasAMNGSafe=$first.HasAMNGSafe; HasOMNGSafe=$first.HasOMNGSafe; MatchStatus=$first.MatchStatus; AMNGSafes=$first.AMNGSafes; OMNGSafes=$first.OMNGSafes; OtherMatchingSafes=$first.OtherMatchingSafes; AllMatchingSafes=$first.AllMatchingSafes })
    }
}

function Start-AppCodeSafeValidation {
    New-RunLog
    Import-RunConfig
    Write-RunLog 'Start-AppCodeSafeValidation' "Using CSV file: $CsvFile" 'INFO'
    $rows = Get-CsvRows
    $token = Get-IdentityBearerToken
    $results = @()
    $rowNumber = 1
    foreach ($row in $rows) {
        Write-RunLog 'Start-AppCodeSafeValidation' "Processing CSV row $rowNumber" 'INFO'
        $outcome = New-AppCodeSafeResult -Row $row -RowNumber $rowNumber -Token $token
        $results += $outcome
        Add-CsvRow -Path $script:ReportFile -Row $outcome
        if ($outcome.Result -eq 'FAILED') { Write-RunLog 'Start-AppCodeSafeValidation' "Row $rowNumber failed. AccountID=$($outcome.AccountID) AppCode=$($outcome.AppCode) Message=$($outcome.Message)" 'ERROR' }
        else { Write-RunLog 'Start-AppCodeSafeValidation' "Row $rowNumber success. AccountID=$($outcome.AccountID) AppCode=$($outcome.AppCode) Status=$($outcome.MatchStatus)" 'INFO' }
        $rowNumber++
    }
    Write-AppCodeSummary -Results $results
    Write-RunLog 'Start-AppCodeSafeValidation' "Run completed. Report=$script:ReportFile" 'INFO'
    Write-RunLog 'Start-AppCodeSafeValidation' "Summary=$script:SummaryFile" 'INFO'
    Write-RunLog 'Start-AppCodeSafeValidation' "Log=$script:LogFile" 'INFO'
}

Start-AppCodeSafeValidation
