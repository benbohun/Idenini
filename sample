Prompt

#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache
Login=login as:|login:

# Reconcile action routing
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
# FIXED: use NOT (A OR B), not NOT (A AND B)
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"])

# Logon vs password prompts
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]
InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
Password=Password:
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# Palo Alto prompts
StandardPrompt=.*\$ ?$|.*\# ?$|.*\> ?$|.*\% ?$|.*\] ?$|.*\$\u001b\[.*m ?$|.*\> ?\u001b\[.*m ?$
ConfigPrompt=.*\#\s*$
OpPrompt=.*\>\s*$

# Action types
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]

# Change/reconcile password prompts (PAN-OS)
Changeprompt2=(?i)enter\s*password
Changeprompt3=(?i)confirm\s*password
Reconcileprompt2=(?i)enter\s*password
Reconcileprompt3=(?i)confirm\s*password

# Commit results (expanded)
# success or return to config prompt
ConfigPromptOrCommitDone=(?i)(commit succeeded|configuration committed successfully|no changes to commit)|.*\#\s*$

# NEW: async progress / queue / dots and failure patterns
CommitInProgress=(?i)^Commit job \d+ is in progress\..*
CommitQueued=(?i)^Commit job \d+ queued.*
CommitDots=^\.+\s*$
CommitFailed=(?i)(commit failed|configuration failed|validation failed|error: .+|errors during commit)

# Reconcile secret presence
PRPassNotExists=(expression)[string equal -nocase "<pmextrapass3>" ""]
PRPassExists=(expression)![string equal -nocase "<pmextrapass3>" ""]
RecExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass3\pmextrapass1>" ""]
RecExtraPassExists=(expression)![string equal -nocase "<pmextrapass3\pmextrapass1>" ""]
ActionIsPreRec=(expression)[string equal -nocase "<action>" prereconcilepass]
ActionIsReconcile=(expression)[string equal -nocase "<action>" reconcilepass]
