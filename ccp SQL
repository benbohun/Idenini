# ==============================
# CCP (cert auth) -> $Cred (no output of secrets)
# ==============================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ---- Inputs ----
$responseViaObject = $null
$CCPAddress = "https://ccpcert-test.cna.com"
$location   = "AIMWebService"
$application= "SQL"
$safe       = "CA_SQL_Users_Test"
$object     = "cna.com-SQL_US_PREPROD"

$windowsAuth    = $false
$certThumbprint = "1dfdd5ca2a370ebe4313e97491f82020ea498a05"
$cert = Get-ChildItem "Cert:\CurrentUser\My\$certThumbprint" -ErrorAction Stop

$headers = New-Object "System.Collections.Generic.Dictionary[[String],[String]]"
$headers.Add("Content-Type","application/json")

# ---- Retrieve via Object only ----
if ([string]::IsNullOrWhiteSpace($object)) {
    throw "Object value is required for CCP retrieval."
}

$ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object"
$responseViaObject = Invoke-RestMethod -Uri $ccpUrl -Method GET `
    -Headers $headers -Certificate $cert -UseDefaultCredentials:$windowsAuth

if (-not $responseViaObject -or -not $responseViaObject.Username -or -not $responseViaObject.Content) {
    throw "CCP response missing required fields (Username/Content)."
}

# ---- Build secure PSCredential (no printing of secrets) ----
$SecurePassword = ConvertTo-SecureString -String $responseViaObject.Content -AsPlainText -Force
$Cred           = New-Object System.Management.Automation.PSCredential ($responseViaObject.Username, $SecurePassword)

# Clear plaintext from memory as soon as possible
$responseViaObject.Content = $null
Remove-Variable SecurePassword -ErrorAction SilentlyContinue

# ---- Note (no sensitive data) ----
Write-Host "[OK] Credential retrieved from CCP (Object) and stored securely in `$Cred." -ForegroundColor Green

# ---- Use $Cred below (examples) ----
# Invoke-Command -ComputerName someHost -Credential $Cred -ScriptBlock { whoami }
# Connect-DbaInstance -SqlInstance 'server\instance' -SqlCredential $Cred


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

$responseViaObject = $responseViaAddressAndUsername =  $null
$CCPAddress = "https://ccpcert-test.cna.com"
$location = "AIMWebService"
$application = "SQL"
$safe = "CA_SQL_Users_Test"
$object = "cna.com-SQL_US_PREPROD"
$address = "cna.com"
$username = "SQL_US_PREPROD"

$windowsAuth = $false
$certThumbprint = "1dfdd5ca2a370ebe4313e97491f82020ea498a05"
$cert = Get-ChildItem Cert:\CurrentUser\My\$certThumbprint

$headers = New-Object "System.Collections.Generic.Dictionary[[String],[String]]"
$headers.Add("Content-Type", "application/json")

if (![string]::IsNullOrEmpty($object)) {
    "Connecting to url: `"$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object`""
    $responseViaObject = Invoke-RestMethod "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object" -Method 'GET' -Headers $headers -Certificate $cert -UseDefaultCredentials:$windowsAuth

    Write-Host "Pulled using Object Name"
    write-host "Username: " $($responseViaObject.Username)
    Write-Host "Password: " $($responseViaObject.content)
    ""
    $responseViaObject | ConvertTo-Json
}

if (![string]::IsNullOrEmpty($address) -and ![string]::IsNullOrEmpty($username)) {
    "Connecting to url: `"$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&address=$address&username=$username`""
    $responseViaAddressAndUsername = Invoke-RestMethod "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&address=$address&username=$username" -Method 'GET' -Headers $headers -Certificate $cert -UseDefaultCredentials:$windowsAuth

    Write-Host "Pulled using Address and Username"
    write-host "Username: " $($responseViaAddressAndUsername.Username)
    Write-Host "Password: " $($responseViaAddressAndUsername.content)
    ""
    $responseViaAddressAndUsername | ConvertTo-Json
}
