<?xml version="1.0" encoding="utf-8"?>
<!--
Symitar / SymXchange UserManagement - CyberArk REST API Application CPM Plugin Framework configuration
- SymXchange is SOAP over HTTP/S.
- CyberArk REST API plugin framework supports XML bodies and XPath parsing, so SOAP calls are supported.
-->
<RestPlugin>

  <!-- ========================== -->
  <!-- Parameters -->
  <!-- ========================== -->
  <Parameters>

    <!-- Address is typically the target account Address property (hostname/IP). -->
    <Parameter name="AddressWithValidation" validationPattern="{{AddressValidationPattern}}">{{Address}}</Parameter>

    <!-- Protocol and Port are platform parameters -->
    <Parameter name="ProtocolWithValidation" validationPattern="(?i)^(http|https)$">{{Protocol}}</Parameter>
    <Parameter name="PortWithValidation" validationPattern="^\d{1,5}$">{{Port}}</Parameter>

    <Parameter name="BaseURL">{{ProtocolWithValidation}}://{{AddressWithValidation}}:{{PortWithValidation}}</Parameter>
    <Parameter name="UserMgmtPath">/SymXchange/usermanagement</Parameter>

    <!-- MessageId can be static (e.g., msg) -->
    <Parameter name="MessageId">{{MessageId}}</Parameter>

    <!-- Device info required by SymXchange -->
    <Parameter name="SymXDeviceTypeWithValidation" validationPattern="^[A-Za-z0-9_-]+$">{{SymXDeviceType}}</Parameter>
    <Parameter name="SymXDeviceNumberWithValidation" validationPattern="^\d+$">{{SymXDeviceNumber}}</Parameter>

    <!-- Optional SOAPAction headers -->
    <Parameter name="SOAPActionVerify">{{SOAPActionVerify}}</Parameter>
    <Parameter name="SOAPActionSetUserPassword">{{SOAPActionSetUserPassword}}</Parameter>

    <!-- Common XPath paths -->
    <Parameter name="XPathStatusCode">//*[local-name()='StatusCode']</Parameter>
    <Parameter name="XPathStatusMessage">//*[local-name()='Status']/*[local-name()='Message']</Parameter>

    <!-- SOAP Fault XPath paths -->
    <Parameter name="XPathFaultString">//*[local-name()='Fault']/*[local-name()='faultstring']</Parameter>
    <Parameter name="XPathFaultCode">//*[local-name()='Fault']/*[local-name()='faultcode']</Parameter>
    <Parameter name="XPathFaultErrorCode">//*[local-name()='Fault']//*[local-name()='ErrorCode']</Parameter>
    <Parameter name="XPathFaultProposedSolution">//*[local-name()='Fault']//*[local-name()='ProposedSolution']</Parameter>

  </Parameters>

  <!-- ========================== -->
  <!-- Error Messages -->
  <!-- ========================== -->
  <ErrorMessages>

    <ErrorMessage name="Http400" returnCode="9400" description="HTTP 400 Bad Request from SymXchange. Check URL/headers/body."/>
    <ErrorMessage name="Http401" returnCode="9401" description="HTTP 401 Unauthorized from SymXchange. Authentication required or invalid."/>
    <ErrorMessage name="Http403" returnCode="9403" description="HTTP 403 Forbidden from SymXchange. Operation/credential type/device info may not be enabled."/>
    <ErrorMessage name="Http404" returnCode="9404" description="HTTP 404 Not Found. Check SymXchange instance port and /SymXchange endpoint."/>
    <ErrorMessage name="Http500" returnCode="9500" description="HTTP 500 from SymXchange. Often a SOAP Fault; check faultstring/detail in logs."/>

    <ErrorMessage name="VerifyInvalidPassword" returnCode="2001" description="Verify failed: invalid user password. StatusCode={{VerifyStatusCode}} Message={{VerifyStatusMessage}}"/>
    <ErrorMessage name="VerifyGenericError" returnCode="2009" description="Verify failed. StatusCode={{VerifyStatusCode}} Message={{VerifyStatusMessage}}"/>

    <ErrorMessage name="ChangeGenericError" returnCode="3009" description="Change failed. StatusCode={{ChangeStatusCode}} Message={{ChangeStatusMessage}}"/>
    <ErrorMessage name="ChangeVerifyGenericError" returnCode="3019" description="Post-change verify failed. StatusCode={{ChangeVerifyStatusCode}} Message={{ChangeVerifyStatusMessage}}"/>

    <ErrorMessage name="SoapFaultError" returnCode="9901" description="SOAP Fault from SymXchange. faultcode={{FaultCode}} faultstring={{FaultString}} ErrorCode={{FaultErrorCode}} ProposedSolution={{FaultProposedSolution}}"/>

  </ErrorMessages>

  <!-- ========================== -->
  <!-- API Calls -->
  <!-- ========================== -->
  <APICalls>

    <!-- VERIFY: verifyUser (uses logonaccount as ProcessorUser/admin password) -->
    <APICall>
      <Request name="VerifyUser" method="POST">
        <URL>{{BaseURL}}{{UserMgmtPath}}</URL>
        <Headers>
          <Header key="Content-Type">text/xml; charset=utf-8</Header>          <Header key="SOAPAction">{{SOAPActionVerify}}</Header>
        </Headers>
        <Body>
&lt;soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:user="http://www.symxchange.generated.symitar.com/noncrud/usermanagement" xmlns:cmn="http://www.symxchange.generated.symitar.com/symxcommon"&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;user:verifyUser&gt;
      &lt;Request cmn:MessageId="{{MessageId}}"&gt;
        &lt;Credentials cmn:ProcessorUser="{{logonaccount\Username}}"&gt;
          &lt;AdministrativeCredentials&gt;
            &lt;Password&gt;&lt;![CDATA[{{logonaccount\Password}}]]&gt;&lt;/Password&gt;
            &lt;Version_1/&gt;
          &lt;/AdministrativeCredentials&gt;
        &lt;/Credentials&gt;
        &lt;DeviceInformation DeviceType="{{SymXDeviceTypeWithValidation}}" DeviceNumber="{{SymXDeviceNumberWithValidation}}"/&gt;
        &lt;UserToVerify&gt;
          &lt;UserNumber&gt;{{targetaccount\Username}}&lt;/UserNumber&gt;
          &lt;Password&gt;&lt;![CDATA[{{password}}]]&gt;&lt;/Password&gt;
          &lt;Version_1/&gt;
        &lt;/UserToVerify&gt;
        &lt;Version_1/&gt;
      &lt;/Request&gt;
    &lt;/user:verifyUser&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;
        </Body>
      </Request>

      <Responses>

        <Response name="VerifySuccess" type="valid" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^0$"></Object>
            </Body>
          </Validate>
        </Response>

        <!-- Known: invalid user password (example StatusCode=14030) -->
        <Response name="VerifyInvalidUserPassword" type="error" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^14030$"></Object>
            </Body>
          </Validate>
          <Parse>
            <ParseBody>
              <Parameter name="VerifyStatusCode" path="//*[local-name()='StatusCode']"/>
              <Parameter name="VerifyStatusMessage" path="//*[local-name()='Status']/*[local-name()='Message']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="VerifyInvalidPassword"/>
        </Response>

        <!-- Any other non-zero StatusCode -->
        <Response name="VerifyOtherError" type="error" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^(?!0$)\d+$"></Object>
            </Body>
          </Validate>
          <Parse>
            <ParseBody>
              <Parameter name="VerifyStatusCode" path="//*[local-name()='StatusCode']"/>
              <Parameter name="VerifyStatusMessage" path="//*[local-name()='Status']/*[local-name()='Message']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="VerifyGenericError"/>
        </Response>

        <!-- SOAP Fault (commonly 500) -->
        <Response name="VerifySoapFault500" type="error" statusCode="500" format="xml">
          <Parse>
            <ParseBody>
              <Parameter name="FaultCode" path="//*[local-name()='Fault']/*[local-name()='faultcode']"/>
              <Parameter name="FaultString" path="//*[local-name()='Fault']/*[local-name()='faultstring']"/>
              <Parameter name="FaultErrorCode" path="//*[local-name()='Fault']//*[local-name()='ErrorCode']"/>
              <Parameter name="FaultProposedSolution" path="//*[local-name()='Fault']//*[local-name()='ProposedSolution']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="SoapFaultError"/>
        </Response>

        <Response name="VerifyHttp400" type="error" statusCode="400" format="text"><ErrorMessage name="Http400"/></Response>
        <Response name="VerifyHttp401" type="error" statusCode="401" format="text"><ErrorMessage name="Http401"/></Response>
        <Response name="VerifyHttp403" type="error" statusCode="403" format="text"><ErrorMessage name="Http403"/></Response>
        <Response name="VerifyHttp404" type="error" statusCode="404" format="text"><ErrorMessage name="Http404"/></Response>
        <Response name="VerifyHttp500" type="error" statusCode="500" format="text"><ErrorMessage name="Http500"/></Response>

      </Responses>
    </APICall>

    <!-- CHANGE: setUserPassword (uses logonaccount) -->
    <APICall>
      <Request name="SetUserPassword" method="POST">
        <URL>{{BaseURL}}{{UserMgmtPath}}</URL>
        <Headers>
          <Header key="Content-Type">text/xml; charset=utf-8</Header>          <Header key="SOAPAction">{{SOAPActionSetUserPassword}}</Header>
        </Headers>
        <Body>
&lt;soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:user="http://www.symxchange.generated.symitar.com/noncrud/usermanagement" xmlns:cmn="http://www.symxchange.generated.symitar.com/symxcommon"&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;user:setUserPassword&gt;
      &lt;Request cmn:MessageId="{{MessageId}}"&gt;
        &lt;Credentials cmn:ProcessorUser="{{logonaccount\Username}}"&gt;
          &lt;AdministrativeCredentials&gt;
            &lt;Password&gt;&lt;![CDATA[{{logonaccount\Password}}]]&gt;&lt;/Password&gt;
            &lt;Version_1/&gt;
          &lt;/AdministrativeCredentials&gt;
        &lt;/Credentials&gt;
        &lt;DeviceInformation DeviceType="{{SymXDeviceTypeWithValidation}}" DeviceNumber="{{SymXDeviceNumberWithValidation}}"/&gt;
        &lt;UserNumber&gt;{{targetaccount\Username}}&lt;/UserNumber&gt;
        &lt;Password&gt;&lt;![CDATA[{{newpassword}}]]&gt;&lt;/Password&gt;
        &lt;Version_1/&gt;
      &lt;/Request&gt;
    &lt;/user:setUserPassword&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;
        </Body>
      </Request>

      <Responses>

        <Response name="ChangeSuccess" type="valid" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^0$"></Object>
            </Body>
          </Validate>
        </Response>

        <Response name="ChangeOtherError" type="error" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^(?!0$)\d+$"></Object>
            </Body>
          </Validate>
          <Parse>
            <ParseBody>
              <Parameter name="ChangeStatusCode" path="//*[local-name()='StatusCode']"/>
              <Parameter name="ChangeStatusMessage" path="//*[local-name()='Status']/*[local-name()='Message']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="ChangeGenericError"/>
        </Response>

        <Response name="ChangeSoapFault500" type="error" statusCode="500" format="xml">
          <Parse>
            <ParseBody>
              <Parameter name="FaultCode" path="//*[local-name()='Fault']/*[local-name()='faultcode']"/>
              <Parameter name="FaultString" path="//*[local-name()='Fault']/*[local-name()='faultstring']"/>
              <Parameter name="FaultErrorCode" path="//*[local-name()='Fault']//*[local-name()='ErrorCode']"/>
              <Parameter name="FaultProposedSolution" path="//*[local-name()='Fault']//*[local-name()='ProposedSolution']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="SoapFaultError"/>
        </Response>

        <Response name="ChangeHttp400" type="error" statusCode="400" format="text"><ErrorMessage name="Http400"/></Response>
        <Response name="ChangeHttp401" type="error" statusCode="401" format="text"><ErrorMessage name="Http401"/></Response>
        <Response name="ChangeHttp403" type="error" statusCode="403" format="text"><ErrorMessage name="Http403"/></Response>
        <Response name="ChangeHttp404" type="error" statusCode="404" format="text"><ErrorMessage name="Http404"/></Response>
        <Response name="ChangeHttp500" type="error" statusCode="500" format="text"><ErrorMessage name="Http500"/></Response>

      </Responses>
    </APICall>

    <!-- POST-CHANGE VERIFY: verifyUser with newpassword -->
    <APICall>
      <Request name="VerifyAfterChange" method="POST">
        <URL>{{BaseURL}}{{UserMgmtPath}}</URL>
        <Headers>
          <Header key="Content-Type">text/xml; charset=utf-8</Header>          <Header key="SOAPAction">{{SOAPActionVerify}}</Header>
        </Headers>
        <Body>
&lt;soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:user="http://www.symxchange.generated.symitar.com/noncrud/usermanagement" xmlns:cmn="http://www.symxchange.generated.symitar.com/symxcommon"&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;user:verifyUser&gt;
      &lt;Request cmn:MessageId="{{MessageId}}"&gt;
        &lt;Credentials cmn:ProcessorUser="{{logonaccount\Username}}"&gt;
          &lt;AdministrativeCredentials&gt;
            &lt;Password&gt;&lt;![CDATA[{{logonaccount\Password}}]]&gt;&lt;/Password&gt;
            &lt;Version_1/&gt;
          &lt;/AdministrativeCredentials&gt;
        &lt;/Credentials&gt;
        &lt;DeviceInformation DeviceType="{{SymXDeviceTypeWithValidation}}" DeviceNumber="{{SymXDeviceNumberWithValidation}}"/&gt;
        &lt;UserToVerify&gt;
          &lt;UserNumber&gt;{{targetaccount\Username}}&lt;/UserNumber&gt;
          &lt;Password&gt;&lt;![CDATA[{{newpassword}}]]&gt;&lt;/Password&gt;
          &lt;Version_1/&gt;
        &lt;/UserToVerify&gt;
        &lt;Version_1/&gt;
      &lt;/Request&gt;
    &lt;/user:verifyUser&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;
        </Body>
      </Request>

      <Responses>

        <Response name="ChangeVerifySuccess" type="valid" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^0$"></Object>
            </Body>
          </Validate>
        </Response>

        <Response name="ChangeVerifyOtherError" type="error" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^(?!0$)\d+$"></Object>
            </Body>
          </Validate>
          <Parse>
            <ParseBody>
              <Parameter name="ChangeVerifyStatusCode" path="//*[local-name()='StatusCode']"/>
              <Parameter name="ChangeVerifyStatusMessage" path="//*[local-name()='Status']/*[local-name()='Message']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="ChangeVerifyGenericError"/>
        </Response>

        <Response name="ChangeVerifySoapFault500" type="error" statusCode="500" format="xml">
          <Parse>
            <ParseBody>
              <Parameter name="FaultCode" path="//*[local-name()='Fault']/*[local-name()='faultcode']"/>
              <Parameter name="FaultString" path="//*[local-name()='Fault']/*[local-name()='faultstring']"/>
              <Parameter name="FaultErrorCode" path="//*[local-name()='Fault']//*[local-name()='ErrorCode']"/>
              <Parameter name="FaultProposedSolution" path="//*[local-name()='Fault']//*[local-name()='ProposedSolution']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="SoapFaultError"/>
        </Response>

        <Response name="ChangeVerifyHttp400" type="error" statusCode="400" format="text"><ErrorMessage name="Http400"/></Response>
        <Response name="ChangeVerifyHttp401" type="error" statusCode="401" format="text"><ErrorMessage name="Http401"/></Response>
        <Response name="ChangeVerifyHttp403" type="error" statusCode="403" format="text"><ErrorMessage name="Http403"/></Response>
        <Response name="ChangeVerifyHttp404" type="error" statusCode="404" format="text"><ErrorMessage name="Http404"/></Response>
        <Response name="ChangeVerifyHttp500" type="error" statusCode="500" format="text"><ErrorMessage name="Http500"/></Response>

      </Responses>
    </APICall>

    <!-- RECONCILE: setUserPassword using reconcileaccount -->
    <APICall>
      <Request name="ReconcileSetUserPassword" method="POST">
        <URL>{{BaseURL}}{{UserMgmtPath}}</URL>
        <Headers>
          <Header key="Content-Type">text/xml; charset=utf-8</Header>          <Header key="SOAPAction">{{SOAPActionSetUserPassword}}</Header>
        </Headers>
        <Body>
&lt;soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:user="http://www.symxchange.generated.symitar.com/noncrud/usermanagement" xmlns:cmn="http://www.symxchange.generated.symitar.com/symxcommon"&gt;
  &lt;soapenv:Header/&gt;
  &lt;soapenv:Body&gt;
    &lt;user:setUserPassword&gt;
      &lt;Request cmn:MessageId="{{MessageId}}"&gt;
        &lt;Credentials cmn:ProcessorUser="{{reconcileaccount\Username}}"&gt;
          &lt;AdministrativeCredentials&gt;
            &lt;Password&gt;&lt;![CDATA[{{reconcileaccount\Password}}]]&gt;&lt;/Password&gt;
            &lt;Version_1/&gt;
          &lt;/AdministrativeCredentials&gt;
        &lt;/Credentials&gt;
        &lt;DeviceInformation DeviceType="{{SymXDeviceTypeWithValidation}}" DeviceNumber="{{SymXDeviceNumberWithValidation}}"/&gt;
        &lt;UserNumber&gt;{{targetaccount\Username}}&lt;/UserNumber&gt;
        &lt;Password&gt;&lt;![CDATA[{{newpassword}}]]&gt;&lt;/Password&gt;
        &lt;Version_1/&gt;
      &lt;/Request&gt;
    &lt;/user:setUserPassword&gt;
  &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;
        </Body>
      </Request>

      <Responses>

        <Response name="ReconSuccess" type="valid" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^0$"></Object>
            </Body>
          </Validate>
        </Response>

        <Response name="ReconOtherError" type="error" statusCode="200" format="xml">
          <Validate>
            <Body>
              <Object path="//*[local-name()='StatusCode']" searchMethod="regex" searchMethodArgument="^(?!0$)\d+$"></Object>
            </Body>
          </Validate>
          <Parse>
            <ParseBody>
              <Parameter name="ChangeStatusCode" path="//*[local-name()='StatusCode']"/>
              <Parameter name="ChangeStatusMessage" path="//*[local-name()='Status']/*[local-name()='Message']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="ChangeGenericError"/>
        </Response>

        <Response name="ReconSoapFault500" type="error" statusCode="500" format="xml">
          <Parse>
            <ParseBody>
              <Parameter name="FaultCode" path="//*[local-name()='Fault']/*[local-name()='faultcode']"/>
              <Parameter name="FaultString" path="//*[local-name()='Fault']/*[local-name()='faultstring']"/>
              <Parameter name="FaultErrorCode" path="//*[local-name()='Fault']//*[local-name()='ErrorCode']"/>
              <Parameter name="FaultProposedSolution" path="//*[local-name()='Fault']//*[local-name()='ProposedSolution']"/>
            </ParseBody>
          </Parse>
          <ErrorMessage name="SoapFaultError"/>
        </Response>

        <Response name="ReconHttp400" type="error" statusCode="400" format="text"><ErrorMessage name="Http400"/></Response>
        <Response name="ReconHttp401" type="error" statusCode="401" format="text"><ErrorMessage name="Http401"/></Response>
        <Response name="ReconHttp403" type="error" statusCode="403" format="text"><ErrorMessage name="Http403"/></Response>
        <Response name="ReconHttp404" type="error" statusCode="404" format="text"><ErrorMessage name="Http404"/></Response>
        <Response name="ReconHttp500" type="error" statusCode="500" format="text"><ErrorMessage name="Http500"/></Response>

      </Responses>
    </APICall>

  </APICalls>

  <!-- ========================== -->
  <!-- Chains -->
  <!-- ========================== -->
  <Chains>
    <Chain name="verifypass">
      <Request name="VerifyUser"/>
    </Chain>

    <Chain name="changepass">
      <Request name="VerifyUser"/>
      <Request name="SetUserPassword"/>
      <Request name="VerifyAfterChange"/>
    </Chain>

    <Chain name="reconcilepass">
      <Request name="ReconcileSetUserPassword"/>
      <Request name="VerifyAfterChange"/>
    </Chain>
  </Chains>

</RestPlugin>
