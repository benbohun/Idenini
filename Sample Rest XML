			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeVerifyNotAuthenticatedMsg" returnCode="2001" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ChangeVerifyForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeVerifyForbiddenMsg" returnCode="2002" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>


  <!-- RECONCILE SECTION -->
  <!-- Reconcile - Verify Recon credentials -->
  <APICall>
	<Request name="ReconVerifyLogon" method="GET">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/verifyuser/{{Username|urlEncode}}</URL>
	  <Headers>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{reconcileaccount\Username}}:{{reconcileaccount\Password}}</Header>
	  </Headers>
	  <Body></Body>
	</Request>
	<Responses>
	  <!-- Success -->
	  <Response name="ReconVerifySuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<Parameter name="UserSysID" path="result"/>
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Bad Request -->
	  <Response name="ReconVerifyBadRequest" type="error" statusCode="400">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconVerifyBadRequestMsg" returnCode="2001" description="HTTP 400 BadRequest:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="ReconVerifyNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
	    </Parse>
		<ErrorMessage name="ReconVerifyNotAuthenticatedMsg" returnCode="2002" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ReconVerifyForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconVerifyForbiddenMsg" returnCode="2003" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>


  <!-- Reconcile user password -->
  <APICall>
	<Request name="ReconRequest" method="POST">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/changeuserpw</URL>
	  <Headers>
		<Header key="Content-Type">application/json</Header>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{reconcileaccount\Username}}:{{reconcileaccount\Password}}</Header>
	  </Headers>
	  <Body>
		{
		"user_id":"{{Username}}",
		"password":"{{NewPassword|JsonEscape}}"
		}
	  </Body>
	</Request>
	<Responses>
	  <!-- Success Response -->
	  <Response name="ReconSuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<!-- JSON returned by your API -->
			<Parameter name="ReconApiSuccess" path="result.success"/>
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Bad Request -->
	  <Response name="ReconBadRequest" type="error" statusCode="400">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconBadRequestMsg" returnCode="3001" description="HTTP 400 BadRequest:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="ReconNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconNotAuthenticatedMsg" returnCode="3002" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ReconForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconForbiddenMsg" returnCode="3003" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- TooManyRequests -->
	  <Response name="ReconTooManyRequests" type="error" statusCode="429">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconTooManyRequests" returnCode="3004" description="HTTP 429 Rate limit exceeded: {{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>

  <!-- Reconcile - Recon Verify User credentials -->
  <APICall>
	<Request name="ReconVerifyRequest" method="GET">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/verifyuser/{{Username|urlEncode}}</URL>
	  <Headers>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{Username}}:{{NewPassword}}</Header> 
	  </Headers>
	  <Body></Body>
	</Request>
	<Responses>
	  <!-- Success -->
	  <Response name="ReconVerifyUserSuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<Parameter name="UserSysID" path="result" secure="true"/>
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Bad Request -->
	  <Response name="ReconVerifyUserBadRequest" type="error" statusCode="400">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconVerifyUserBadRequestMsg" returnCode="2001" description="HTTP 400 BadRequest:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="ReconVerifyUserNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconVerifyUserNotAuthenticatedMsg" returnCode="2002" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ReconVerifyUserForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ReconVerifyUserForbiddenMsg" returnCode="2003" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>
  </APICalls>

  <!-- ========================== -->
  <!-- Chains -->
  <!-- ========================== -->
  <Chains>
	<Chain name="verifypass">
	  <Request name="VerifyLogon"/>
	</Chain>
	<Chain name="changepass">
	  <Request name="VerifyLogon"/>
	  <Request name="ChangeRequest"/>
	  <Request name="ChangeVerifyRequest"/>
	</Chain>
	<Chain name="reconcilepass">
	  <Request name="ReconVerifyLogon"/>
	  <Request name="ReconRequest"/>
	  <Request name="ReconVerifyRequest"/>
	</Chain>
  </Chains>

</RestPlugin>
