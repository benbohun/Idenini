<RestPlugin>
  <!-- ========================== -->
  <!-- Parameters -->
  <!-- ========================== -->
  <Parameters>
  <!-- Base address validation -->
  <Parameter name="AddressWithValidation" validationPattern="{{AddressValidationPattern}}">{{Address}}</Parameter>
  </Parameters>

  <!-- ========================== -->
  <!-- Error Messages -->
  <!-- ========================== -->
  <ErrorMessages>
  </ErrorMessages>

  <!-- ========================== -->
  <!-- API Calls -->
  <!-- ========================== -->
  <APICalls>
  <!-- VERIFY SECTION -->
  <!-- Verify user credentials -->
  <APICall>
	<Request name="VerifyLogon" method="GET">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/verifyuser/{{Username|urlEncode}}</URL>
	  <Headers>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{Username}}:{{Password}}</Header> 
	  </Headers>
	  <Body></Body>
	</Request>
	<Responses>
	  <!-- Success -->
	  <Response name="VerifySuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<Parameter name="UserSysID" path="result" secure="true"/>
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="VerifyNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="VerifyNotAuthenticatedMsg" returnCode="2001" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="VerifyForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="VerifyForbiddenMsg" returnCode="2002" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>


  <!-- CHANGE SECTION -->
  <!-- Change user password -->
  <APICall>
	<Request name="ChangeRequest" method="POST">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/changeuserpw</URL>
	  <Headers>
		<Header key="Content-Type">application/json</Header>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{Username}}:{{Password}}</Header> 
	  </Headers>
	  <Body>
		{
		"user_id":"{{Username}}",
		"password":"{{NewPassword|JsonEscape}}"
		}
	  </Body>
	</Request>
	<Responses>
	  <!-- Success Response -->
	  <Response name="ChangeSuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<!-- JSON returned -->
			<Parameter name="ChangeApiSuccess" path="result.success"/>
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Bad Request -->
	  <Response name="ChangeBadRequest" type="error" statusCode="400">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeBadRequestMsg" returnCode="3001" description="HTTP 400 BadRequest:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="ChangeNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeNotAuthenticatedMsg" returnCode="3002" description="HTTP 401 Unauthorized:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ChangeForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeForbiddenMsg" returnCode="3003" description="HTTP 403 Forbidden:{{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	  <!-- TooManyRequests -->
	  <Response name="ChangeTooManyRequests" type="error" statusCode="429">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
			<Parameter name="ErrorDetail" path="error.detail"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeTooManyRequests" returnCode="3004" description="HTTP 429 Rate limit exceeded: {{ErrorMessage}}, {{ErrorDetail}}"/>
	  </Response>
	</Responses>
  </APICall>

  <!-- Change - Verify user credentials -->
  <APICall>
	<Request name="ChangeVerifyRequest" method="GET">
	  <URL>https://{{AddressWithValidation}}/api/mahe2/credentialapi/verifyuser/{{Username|urlEncode}}</URL>
	  <Headers>
		<Header key="Accept">application/json</Header>
		<Header key="Authorization">Basic {{Username}}:{{NewPassword}}</Header> 
