<RestPlugin>
  <!-- ========================== -->
  <!-- Parameters -->
  <!-- ========================== -->
  <Parameters>
  <!-- Base address validation -->
  <Parameter name="AddressWithValidation" validationPattern="{{AddressValidationPattern}}">{{Address}}</Parameter>
  </Parameters>

  <!-- ========================== -->
  <!-- Error Messages -->
  <!-- ========================== -->
  <ErrorMessages>
  </ErrorMessages>

  <!-- ========================== -->
  <!-- API Calls -->
  <!-- ========================== -->
  <APICalls>
  <!-- VERIFY SECTION -->
  <!-- Verify user credentials -->
  <APICall>
    <Request name="VerifyLogon" method="POST">
      <URL>https://{{AddressWithValidation}}:{{Port}}/services/auth/login?output_mode=json</URL>
      <Headers>
      </Headers>
      <Body>username={{Username|urlEncode}}&amp;password={{Password|urlEncode}}</Body>
    </Request>
    <Responses>
      <!-- Success -->
      <Response name="VerifySuccess" type="valid" statusCode="200">
        <Parse>
          <ParseBody>
            <Parameter name="sessionKey" path="sessionKey" secure="true"/>
          </ParseBody>
        </Parse>
      </Response>

      <!-- Bad Request -->
      <Response name="VerifyBadRequest" type="error" statusCode="400">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
       <ErrorMessage name="VerifyBadRequestMsg"
                      returnCode="2000"
                      description="HTTP 400 Bad Request: {{ErrorText}}"/>
      </Response>

      <!-- Not Authenticated -->
      <Response name="VerifyNotAuthenticated" type="error" statusCode="401">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="VerifyNotAuthenticatedMsg"
                      returnCode="2001"
                      description="HTTP 401 Unauthorized: {{ErrorText}}"/>
      </Response>

      <!-- Forbidden -->
      <Response name="VerifyForbidden" type="error" statusCode="403">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="VerifyForbiddenMsg"
                      returnCode="2002"
                      description="HTTP 403 Forbidden: {{ErrorText}}"/>
      </Response>
    </Responses>
  </APICall>

  <!-- CHANGE SECTION -->
  <!-- Change user password -->
  <APICall>
    <Request name="ChangeRequest" method="POST">
      <URL>https://{{AddressWithValidation}}:{{Port}}/services/authentication/users/{{Username|urlEncode}}?output_mode=json</URL>
      <Headers><Header key="Authorization">Basic {{Username}}:{{Password}}</Header></Headers>
      <Body>oldpassword={{Password|urlEncode}}&amp;password={{NewPassword|urlEncode}}</Body>
    </Request>
    <Responses>
      <!-- Success -->
      <Response name="ChangeSuccess" type="valid" statusCode="200">
        <Parse>
          <ParseBody>
            <Parameter name="EntryName" path="entry[0].name"/>
          </ParseBody>
        </Parse>
      </Response>

      <!-- Bad Request -->
      <Response name="ChangeBadRequest" type="error" statusCode="400">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
       <ErrorMessage name="ChangeBadRequestMsg"
                      returnCode="3000"
                      description="HTTP 400 Bad Request: {{ErrorText}}"/>
      </Response>

      <!-- Not Authenticated -->
      <Response name="ChangeNotAuthenticated" type="error" statusCode="401">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="ChangeNotAuthenticatedMsg"
                      returnCode="3001"
                      description="HTTP 401 Unauthorized: {{ErrorText}}"/>
      </Response>

      <!-- Forbidden -->
      <Response name="ChangeForbidden" type="error" statusCode="403">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="ChangeForbiddenMsg"
                      returnCode="3002"
                      description="HTTP 403 Forbidden: {ErrorText}}"/>
      </Response>
    </Responses>
  </APICall>
  
  <!-- ChangeVerify user credentials -->
  <APICall>
    <Request name="ChangeVerifyRequest" method="POST">
      <URL>https://{{AddressWithValidation}}:{{Port}}/services/auth/login?output_mode=json</URL>
      <Headers>
      </Headers>
      <Body>username={{Username|urlEncode}}&amp;password={{NewPassword|urlEncode}}</Body>
    </Request>
    <Responses>
      <!-- Success -->
      <Response name="ChangeVerifySuccess" type="valid" statusCode="200">
        <Parse>
          <ParseBody>
            <Parameter name="sessionKey" path="sessionKey" secure="true"/>
          </ParseBody>
        </Parse>
      </Response>

      <!-- Bad Request -->
      <Response name="ChangeVerifyBadRequest" type="error" statusCode="400">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
       <ErrorMessage name="ChangeVerifyBadRequestMsg"
                      returnCode="2000"
                      description="HTTP 400 Bad Request: {{ErrorText}}"/>
      </Response>

      <!-- Not Authenticated -->
      <Response name="ChangeVerifyNotAuthenticated" type="error" statusCode="401">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="ChangeVerifyNotAuthenticatedMsg"
                      returnCode="2001"
                      description="HTTP 401 Unauthorized: {{ErrorText}}"/>
      </Response>

      <!-- Forbidden -->
      <Response name="ChangeVerifyForbidden" type="error" statusCode="403">
        <Parse>
          <ParseBody>
            <Parameter name="ErrorText" path="messages[0].text"/>
          </ParseBody>
        </Parse>
        <ErrorMessage name="ChangeVerifyForbiddenMsg"
                      returnCode="2002"
                      description="HTTP 403 Forbidden: {{ErrorText}}"/>
      </Response>
    </Responses>
  </APICall>

  
  </APICalls>

  <!-- ========================== -->
  <!-- Chains -->
  <!-- ========================== -->
  <Chains>
	<Chain name="verifypass">
	  <Request name="VerifyLogon"/>
	</Chain>
	<Chain name="changepass">
	  <Request name="VerifyLogon"/>
          <Request name="ChangeRequest"/>
          <Request name="ChangeVerifyRequest"/>
	</Chain>
  </Chains>

</RestPlugin>
