# Cisco_M300V_AsyncOS_Prompts.ini
# Updated: 20/02/2026

[Conditions]
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login prompts
Login=login as:|login:|Username:
PasswordPrompt=Password:|Passphrase:
InvalidLogin=Permission denied \(password\)|Permission denied|Authentication failed|Access denied|Login incorrect|Invalid passphrase|Login invalid
NotAllowedLogin=not allowed to login|not allowed to log in|Wrong time period
AccountDisabled=account is disabled|account has been locked|locked|disabled

# IMPORTANT:
# AsyncOS menus often show prompts like "[1]>" or "[]>" (during userconfig/passphrase flows).
# Do NOT treat those as device "success" prompts.
MenuPrompt=(?m)^\[\d*\]>\s*$

# Device prompt should be hostname/normal prompt, but NOT menu prompts
DevicePrompt=(?m)^(?!\[\d*\]>).*[>#]\s*$

# Action checks
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]

# Protocol checks
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# passphrase/passwd interactive prompts
OldPassPrompt=(?i)Old\s+passphrase\s*:\s*$|Old\s+password\s*:\s*$|Current\s+passphrase\s*:\s*$|Current\s+password\s*:\s*$

# System-generated prompt (exact string you saw)
SystemGenPrompt=Would you like to get a system generated passphrase\?\s*\[N\]>\s*$

NewPassPrompt=(?i)New\s+passphrase\s*:\s*$|New\s+password\s*:\s*$
RetypePrompt=(?i)Please enter the new passphrase again:\s*$|Retype\s+new\s+passphrase\s*:\s*$|Retype\s+new\s+password\s*:\s*$|Confirm\s+new\s+passphrase\s*:\s*$|Confirm\s+new\s+password\s*:\s*$

PassChangeSuccess=(?i)Your passphrase has been changed\.|passphrase\s+changed|password\s+changed|updated\s+successfully

PassMismatch=(?i)do\s+not\s+match|mismatch
UnknownCommand=(?i)unknown\s+command|invalid\s+command|not\s+found

# This is the exact rejection format you pasted
CriteriaNotMet=(?is)Following\s+criteria\s+for\s+passphrase\s+are\s+not\s+met:.*(previous|recent)\s+passphrases?

# General policy failures (keep broad)
PolicyFail=(?i)too short|too long|must contain|must include|invalid|not allowed|cannot reuse|previous passphrases?|recent passphrases?|repetitive|sequential|forbidden|unchanged
