# Cisco_M300V_AsyncOS_Prompts.ini
# Updated: 12/03/2026
# Fixes:
# - Adds linked logon account routing conditions
# - Adds userconfig/menu prompts for target-user password change
# - Matches commit comment and rollback prompts
# - Handles multi-line criteria/policy blocks
# - Avoids treating []>, [N]>, and [Y]> as device prompts

[Conditions]
TRUE=(expression)true

# Connectivity / plink
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login prompts
Login=login as:|login:|Username:
PasswordPrompt=Password:|Passphrase:

InvalidLogin=Permission denied \(password\)|Permission denied|Authentication failed|Access denied|Login incorrect|Invalid passphrase|Login invalid
NotAllowedLogin=not allowed to login|not allowed to log in|Wrong time period|permission denied to perform this operation|insufficient privileges
AccountDisabled=account is disabled|account has been locked|locked|disabled

# Menu prompt inside userconfig/passphrase flows
MenuPrompt=(?m)^\[\d*\]>\s*$

# Device prompt (hostname> or #, but not bracketed prompts like []>, [N]>, [Y]>)
DevicePrompt=(?m)^(?!\[[^\r\n]*\]>\s*$).*[>#]\s*$

# Action checks
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]

# Linked logon account checks
HasLogonAccount=(expression)![string equal -nocase "<pmextrapass1>" ""]
NoLogonAccount=(expression)[string equal -nocase "<pmextrapass1>" ""]

# Protocol checks
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# Direct passphrase/passwd interactive prompts
OldPassPrompt=(?im)^Old\s+passphrase\s*:\s*$|^Old\s+password\s*:\s*$|^Current\s+passphrase\s*:\s*$|^Current\s+password\s*:\s*$
SystemGenPrompt=(?im)^Would\s+you\s+like\s+to\s+get\s+a\s+system\s+generated\s+passphrase\?\s*\[N\]>\s*$

# userconfig-based target password change
UserConfigMainMenu=(?is)Choose\s+the\s+operation\s+you\s+want\s+to\s+perform:.*-\s*(PASSWORD|PASSPHRASE)\s*-
UserConfigPassMenu=(?is)Choose\s+the\s+operation\s+you\s+want\s+to\s+perform:.*-\s*ASSIGN\s*-
ConfigAuthPrompt=(?im)^Enter\s+your\s+Passphrase\s+to\s+make\s+changes:\s*$|^Enter\s+your\s+Password\s+to\s+make\s+changes:\s*$
InvalidMenuChoice=(?i)That value is not valid\.?|Invalid choice|Please enter a valid choice|Unknown option|not a valid selection
SelectUserPrompt=(?im)^Enter\s+the\s+(?:name|number|name\s+or\s+number)\s+of\s+the\s+user(?:\s+account)?(?:\s+you\s+wish\s+to\s+(?:edit|change|modify))?\s*:\s*$|^Choose\s+the\s+user(?:\s+account)?(?:\s+.*)?\s*:\s*$|^Enter\s+the\s+username\s*:\s*$|^Which\s+user.*:\s*$
TargetUserNotFound=(?i)no such user|unknown user|user .* does not exist|That value is not valid

# New password / confirm prompts
NewPassPrompt=(?im)^New\s+Passphrase\s*:\s*$|^New\s+password\s*:\s*$|^Enter\s+the\s+new\s+passphrase\.?\s*$|^Enter\s+the\s+new\s+password\.?\s*$
RetypePrompt=(?im)^Please\s+enter\s+the\s+new\s+passphrase\s+again:\s*$|^Please\s+enter\s+the\s+new\s+password\s+again:\s*$|^Retype\s+new\s+passphrase\s*:\s*$|^Retype\s+new\s+password\s*:\s*$|^Confirm\s+new\s+passphrase\s*:\s*$|^Confirm\s+new\s+password\s*:\s*$

PassChangeSuccess=(?i)Your passphrase has been changed\.|passphrase\s+changed|password\s+changed|updated\s+successfully
PassMismatch=(?i)do\s+not\s*match|mismatch
UnknownCommand=(?i)unknown\s+command|invalid\s+command|not\s+found

# Commit prompts after userconfig change
CommitCommentPrompt=(?is)Please\s+enter\s+some\s+comments\s+describing\s+your\s+changes:\s*(?:\r?\n\s*)?(?:\[\]>\s*)?$
RollbackPrompt=(?is)Do\s+you\s+want\s+to\s+save\s+the\s+current\s+configuration\s+for\s+rollback\?\s*(?:\r?\n\s*)?\[Y\]>\s*$
CommitSuccess=(?i)Changes committed:

# Multi-line criteria block (covers history + complexity + dictionary)
CriteriaNotMet=(?is)Following\s+criteria\s+for\s+passphrase\s+are\s+not\s+met:.*$

# General policy failures
PolicyFail=(?i)criteria\s+for\s+passphrase\s+are\s+not\s+met|at\s+least\s+\d+\s+characters|upper\s+\(A-Z\)|lower\s+\(a-z\)|number\s+\(0-9\)|special\s+character|not\s+a\s+commonly\s+used\s+one|previous\s+passphrases?|recent\s+passphrases?|too\s+short|too\s+long|must\s+contain|must\s+include|invalid|not\s+allowed|cannot\s+reuse|repetitive|sequential|forbidden|unchanged
