# Cisco_M300V_AsyncOS_Prompts.ini
# Updated: 20/02/2026

[Conditions]
TRUE=(expression)true

# Connectivity / plink
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Action checks
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]

# Protocol checks
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# Use logon for change only when explicitly enabled
UseLogonForChange=(expression)[string equal -nocase "<UseLogonAccountForChange>" "Yes"] && ![string equal -nocase "<pmextrapass1>" ""]

# Built-in SSH challenge prompt
PasswordPrompt=Password:|Passphrase:

# Invalid login / access conditions (include adapter error text)
InvalidLogin=Permission denied \(password\)|Permission denied|Authentication failed|Access denied|Login incorrect|Invalid passphrase|Login invalid
NotAllowedLogin=not allowed to login|not allowed to log in|Wrong time period
AccountDisabled=account is disabled|account has been locked|locked|disabled

# Device prompt (top-level)
StandardPrompt=.*[>#] ?$

# passphrase/passwd/password prompts
OldPassPrompt=(?i)Old\s+passphrase\s*:\s*$|Old\s+password\s*:\s*$|Current\s+passphrase\s*:\s*$|Current\s+password\s*:\s*$
NewPassPrompt=(?i)New\s+passphrase\s*:\s*$|New\s+password\s*:\s*$
RetypePrompt=(?i)Retype\s+new\s+passphrase\s*:\s*$|Retype\s+new\s+password\s*:\s*$|Enter\s+again\s*:\s*$|Confirm\s+new\s+passphrase\s*:\s*$|Confirm\s+new\s+password\s*:\s*$

PassChangeSuccess=(?i)passphrase\s+changed|password\s+changed|updated\s+successfully|changes\s+take\s+effect\s+immediately
PassMismatch=(?i)do\s+not\s+match|mismatch
UnknownCommand=(?i)unknown\s+command|invalid\s+command|not\s+found

# userconfig prompts (tune after first successful CLI capture)
UserconfigPrompt=\[\]\>\s*$|(?i)Choose the operation you want to perform:
UserconfigUserPrompt=(?i)enter.*user|enter.*username|user\s+name
UserconfigNewPrompt=(?i)new\s+passphrase|new\s+password|enter\s+the\s+passphrase
UserconfigRetypePrompt=(?i)retype|enter\s+again|confirm

# Commit prompts (optional)
CommitCommentPrompt=Please enter some comments describing your changes:
CommitRollbackPrompt=Do you want to save the current configuration for rollback\?\s*\[Y\]\>\s*$
CommitDone=(?i)Changes committed:
NoChangesToCommit=(?i)No changes to commit|No changes have been made

# Policy failures (expand as you capture exact device strings)
PolicyFail=(?i)too short|too long|must contain|must include|invalid|not allowed|cannot reuse|previous|repetitive|sequential|forbidden|unchanged
