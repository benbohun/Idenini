# Cisco_M300V_AsyncOS_Process.ini
# Updated: 20/02/2026
# Goal: Avoid changepass failing when ExtraPass1 is stale; default to target login.
# Optional: Use logon account for change only if platform property UseLogonAccountForChange=Yes

[states]
Init=(script)set verifyLogon 1; set tgtUser "<username>"; set tgtPass "<pmpass>"; set newPass "<pmnewpass>"; set logonUser "<extrapass1\username>"; set logonPass "<pmextrapass1>"; set useLogonFlag "<UseLogonAccountForChange>"

# Protocol routing (SSH default)
CheckProtocol=
StartSSH_WithPort=(spawn)plink.exe <address> -ssh -P <port>
StartSSH_NoPort=(spawn)plink.exe <address> -ssh
StartTelnet=(spawn)telnet <address> <port>
StoreKeyInCache=y

# Login selection
PickLogin=
LoginAsTarget=$tgtUser
SendTargetPass=$tgtPass
LoginAsLogon=$logonUser
SendLogonPass=$logonPass

CheckAction=
RouteChange=

# ===== Self change flow (preferred/default) =====
SelfCmd1=passphrase
SelfCmd2=passwd
SelfCmd3=password

SelfOld=$tgtPass
SelfNew1=<pmnewpass>
SelfNew2=<pmnewpass>

# ===== Logon-account change flow (optional) =====
# Uses userconfig style prompts (varies by build; tune prompts based on UAT output)
UC_Cmd=userconfig
UC_MenuPassword=PASSWORD
UC_MenuAssign=ASSIGN
UC_TargetUser=$tgtUser
UC_New1=<pmnewpass>
UC_New2=<pmnewpass>
UC_Exit=\r

# Commit (optional; some commands don’t require it)
CommitCmd=commit
CommitComment=CPM password rotation
CommitRollback=Y

FinalStep=
END=

# Fail states
FAILUnableToConnect=FAIL(Unable to connect to target, 8000)
FAILInvalidLogin=FAIL(Invalid username or bad password, 2114)
FAILNotAllowedLogin=FAIL(User not allowed to log in, 8012)
FAILAccountDisabled=FAIL(User account is disabled/locked, 8010)
FAILInvalidNewPassword=FAIL(New password rejected by device policy, 8004)
FAILPassMismatch=FAIL(New password entries did not match, 8005)
FAILNotSupportedRec=FAIL(Reconcile action not supported, 8003)

[transitions]
Init,TRUE,CheckProtocol
CheckProtocol,ProtocolIsTelnet,StartTelnet
CheckProtocol,ProtocolIsSSH,StartSSH_WithPort
CheckProtocol,ProtocolIsEmpty,StartSSH_WithPort
StartSSH_WithPort,PortNotSet,StartSSH_NoPort

# Spawn -> login phase
StartSSH_WithPort,UnableToConnect,FAILUnableToConnect
StartSSH_WithPort,PlinkStoreKey,StoreKeyInCache
StartSSH_WithPort,TRUE,PickLogin

StartSSH_NoPort,UnableToConnect,FAILUnableToConnect
StartSSH_NoPort,PlinkStoreKey,StoreKeyInCache
StartSSH_NoPort,TRUE,PickLogin

StartTelnet,UnableToConnect,FAILUnableToConnect
StartTelnet,TRUE,PickLogin

StoreKeyInCache,TRUE,PickLogin

# PickLogin:
# - Verify + Logon: always validate target credentials
# - Change: use logon account ONLY if UseLogonAccountForChange=Yes AND pmextrapass1 exists
PickLogin,ActionIsVerify,LoginAsTarget
PickLogin,ActionIsLogon,LoginAsTarget
PickLogin,UseLogonForChange,LoginAsLogon
PickLogin,TRUE,LoginAsTarget

LoginAsTarget,PasswordPrompt,SendTargetPass
LoginAsLogon,PasswordPrompt,SendLogonPass

SendTargetPass,InvalidLogin,FAILInvalidLogin
SendTargetPass,AccountDisabled,FAILAccountDisabled
SendTargetPass,NotAllowedLogin,FAILNotAllowedLogin
SendTargetPass,StandardPrompt,CheckAction

SendLogonPass,InvalidLogin,FAILInvalidLogin
SendLogonPass,AccountDisabled,FAILAccountDisabled
SendLogonPass,NotAllowedLogin,FAILNotAllowedLogin
SendLogonPass,StandardPrompt,CheckAction

# Action routing
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsRecOrPreRec,FAILNotSupportedRec
CheckAction,ActionIsChange,RouteChange

# Change routing:
# - If logged in as logon account AND flag enabled -> userconfig path
# - Else -> self change (passphrase/passwd/password)
RouteChange,UseLogonForChange,UC_Cmd
RouteChange,TRUE,SelfCmd1

# ===== Self change with passphrase/passwd/password =====
SelfCmd1,UnknownCommand,SelfCmd2
SelfCmd1,OldPassPrompt,SelfOld
SelfCmd1,NewPassPrompt,SelfNew1

SelfCmd2,UnknownCommand,SelfCmd3
SelfCmd2,OldPassPrompt,SelfOld
SelfCmd2,NewPassPrompt,SelfNew1

SelfCmd3,OldPassPrompt,SelfOld
SelfCmd3,NewPassPrompt,SelfNew1

SelfOld,NewPassPrompt,SelfNew1

SelfNew1,RetypePrompt,SelfNew2
SelfNew1,PolicyFail,FAILInvalidNewPassword

SelfNew2,PassMismatch,FAILPassMismatch
SelfNew2,PolicyFail,FAILInvalidNewPassword
SelfNew2,PassChangeSuccess,FinalStep
SelfNew2,StandardPrompt,FinalStep

# ===== userconfig change flow (optional) =====
UC_Cmd,UserconfigPrompt,UC_MenuPassword
UC_MenuPassword,UserconfigPrompt,UC_MenuAssign
UC_MenuAssign,UserconfigUserPrompt,UC_TargetUser
UC_TargetUser,UserconfigNewPrompt,UC_New1
UC_New1,UserconfigRetypePrompt,UC_New2
UC_New2,PolicyFail,FAILInvalidNewPassword
UC_New2,UserconfigPrompt,UC_Exit
UC_Exit,StandardPrompt,CommitCmd

# Commit flow (optional)
CommitCmd,CommitCommentPrompt,CommitComment
CommitComment,CommitRollbackPrompt,CommitRollback
CommitRollback,CommitDone,FinalStep
CommitRollback,NoChangesToCommit,FinalStep
FinalStep,TRUE,END

[CPM Parameters Validation]
username, source=FILE, Mandatory=yes
address,  source=FILE, Mandatory=yes
protocol, source=FILE, Mandatory=no
port, source=FILE, Mandatory=no
extrapass1\username, source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]
UseLogonAccountForChange, source=FILE, Mandatory=no

[Parameters]
PromptTimeout=90
SendHuman=.1 .3 1 .05 2

[Debug Information]
ExpectLog=yes
ConsoleOutput=no
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
