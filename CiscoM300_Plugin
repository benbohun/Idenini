# Cisco_M300V_AsyncOS_Prompts.ini
[Conditions]
TRUE=(expression)true

# Connectivity / plink
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login prompts
Login=login as:|login:|Username:
PasswordPrompt=Password:|Passphrase:
InvalidLogin=Login invalid|Authentication failed|Access denied|Login incorrect|Invalid passphrase
NotAllowedLogin=not allowed to login|not allowed to log in|Wrong time period
AccountDisabled=account is disabled|account has been locked|disabled/locked

# Standard prompt (AsyncOS top-level often ends with ">"; keep generic)
StandardPrompt=.*[>#] ?$

# Action checks
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]

# Protocol checks
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# Linked logon account presence + usage rules
HasLogon=(expression)![string equal -nocase "<pmextrapass1>" ""]
UseLogonCreds=(expression)([string equal -nocase "<action>" "logon"]||[string equal -nocase "<action>" "changepass"]) && ![string equal -nocase "<pmextrapass1>" ""]
UseLogonForChange=(expression)[string equal -nocase "<action>" "changepass"] && ![string equal -nocase "<pmextrapass1>" ""]

# passphrase/password flows
OldPassphrasePrompt=(?i)Old\s+passphrase\s*:\s*$|Old\s+password\s*:\s*$|Current\s+password\s*:\s*$
SystemGenPrompt=Would you like to get a system generated passphrase\?\s*\[N\]\>\s*$
NewPassphrasePrompt=(?i)New\s+passphrase\s*:\s*$|New\s+password\s*:\s*$
RetypePassphrasePrompt=(?i)Retype\s+new\s+passphrase\s*:\s*$|Retype\s+new\s+password\s*:\s*$|Please enter the new passphrase again:\s*$
PassphraseSuccess=(?i)passphrase\s+changed|password\s+changed|updated\s+successfully
PassMismatch=(?i)do\s+not\s+match|mismatch
UnknownCommand=(?i)unknown\s+command|invalid\s+command|not\s+found

# userconfig flow
UserconfigMenu=Choose the operation you want to perform:|\[\]\>\s*$
UserconfigAuthPrompt=Enter your Passphrase to make changes:\s*$
UserconfigTargetPrompt=(?i)Enter.*user.*passphrase|Enter.*username|name or number of the user
UserconfigNewPrompt=(?i)Enter the passphrase for|New passphrase|New password
UserconfigRetypePrompt=(?i)Please enter the new passphrase again:|Retype

# commit flow
CommitCommentPrompt=Please enter some comments describing your changes:
CommitRollbackPrompt=Do you want to save the current configuration for rollback\?\s*\[Y\]\>\s*$
CommitDone=(?i)Changes committed:
NoChangesToCommit=(?i)No changes to commit|No changes have been made

# Policy failures (tune with real UAT output)
PolicyFail=(?i)passphrase must|must contain|must include|too short|too long|cannot reuse|previous passphrase|contains username|forbidden|not allowed|repetitive|sequential|unchanged|invalid
