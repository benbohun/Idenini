# Cisco_M300V_AsyncOS_Process.ini
# Updated: 12/03/2026
# Supports: verifypass, logon, changepass
# Enhancements:
# - Adds linked logon account support using extrapass1 for logon/changepass
# - Keeps verifypass on the target account so verify still validates the target secret
# - Uses userconfig-based target password change when logged in with a linked logon account
# - Retains direct self-change flow when no linked logon account is attached
# - Handles system-generated passphrase prompt
# - Handles multi-line policy rejection blocks with []> menus
# - Cleanly fails with 8004 on policy rejection so CPM retries later

[states]
Init=(script)set verifyLogon 1; set tgtUser "<username>"; set tgtPass "<pmpass>"; set logonUser "<extrapass1\username>"; set logonPass "<pmextrapass1>"

# Action routing before login selection
CheckAction=
RouteLogonLogin=
RouteChangeLogin=
SetTargetLogin=(script)set loginUser $tgtUser; set loginPass $tgtPass
SetLogonAccountLogin=(script)set loginUser $logonUser; set loginPass $logonPass

# Protocol routing (SSH default)
CheckProtocol=
StartSSH_WithPort=(spawn)plink.exe <address> -ssh -P <port>
StartSSH_NoPort=(spawn)plink.exe <address> -ssh
StartTelnet=(spawn)telnet <address> <port>
StoreKeyInCache=y

# Login
LoginUser=$loginUser
SendPassword=$loginPass
PostLoginRoute=

# Change routing
RouteChangeMethod=

# ---- Change (self) ----
# Some builds use passphrase, others accept passwd/password - try all
ChangeCmd1=passphrase
ChangeCmd2=passwd
ChangeCmd3=password
SendOld=$tgtPass
SendSysGenDefault=\r

# ---- Change (with linked logon account) ----
# Login with extrapass1, then change the target user via userconfig
UserConfigCmd=userconfig
UserConfigPassMenu1=PASSWORD
UserConfigPassMenu2=PASSPHRASE
SendConfigAuth1=$loginPass
SendConfigAuth2=$loginPass
SendConfigAuth3=$loginPass
UserConfigAssign=ASSIGN
SendTargetUser=$tgtUser

# ---- Shared new password entry ----
SendNew1=<pmnewpass>
SendNew2=<pmnewpass>
WaitAfterNew1=

# ---- Commit after linked-logon change ----
RoutePostChange=
ExitUserConfig=\r
CommitCmd=commit
CommitComment=CPM password update
CommitRollback=Y

FinalStep=
END=

# Fail states
FAILNotSupportedRec=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(Unable to connect to target, 8000)
FAILInvalidLogin=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled=FAIL(User account is disabled/locked, 8010)
FAILNotAllowedLogin=FAIL(User is not allowed to log in or lacks sufficient privilege, 8012)
FAILInvalidNewPassword=FAIL(Invalid new password rejected by device policy, 8004)
FAILPassMismatch=FAIL(New password entries did not match, 8005)
FAILTargetUserNotFound=FAIL(Target user was not found on the device, 2114)

[transitions]
Init,TRUE,CheckAction

# Action selection
CheckAction,ActionIsVerify,SetTargetLogin
CheckAction,ActionIsLogon,RouteLogonLogin
CheckAction,ActionIsChange,RouteChangeLogin
CheckAction,ActionIsRecOrPreRec,FAILNotSupportedRec

RouteLogonLogin,HasLogonAccount,SetLogonAccountLogin
RouteLogonLogin,NoLogonAccount,SetTargetLogin

RouteChangeLogin,HasLogonAccount,SetLogonAccountLogin
RouteChangeLogin,NoLogonAccount,SetTargetLogin

SetTargetLogin,TRUE,CheckProtocol
SetLogonAccountLogin,TRUE,CheckProtocol

# Connect + login
CheckProtocol,ProtocolIsTelnet,StartTelnet
CheckProtocol,ProtocolIsSSH,StartSSH_WithPort
CheckProtocol,ProtocolIsEmpty,StartSSH_WithPort
StartSSH_WithPort,PortNotSet,StartSSH_NoPort

StartSSH_WithPort,UnableToConnect,FAILUnableToConnect
StartSSH_WithPort,PlinkStoreKey,StoreKeyInCache
StartSSH_WithPort,Login,LoginUser

StartSSH_NoPort,UnableToConnect,FAILUnableToConnect
StartSSH_NoPort,PlinkStoreKey,StoreKeyInCache
StartSSH_NoPort,Login,LoginUser

StartTelnet,UnableToConnect,FAILUnableToConnect
StartTelnet,Login,LoginUser

StoreKeyInCache,Login,LoginUser

LoginUser,PasswordPrompt,SendPassword
SendPassword,InvalidLogin,FAILInvalidLogin
SendPassword,AccountDisabled,FAILAccountDisabled
SendPassword,NotAllowedLogin,FAILNotAllowedLogin
SendPassword,DevicePrompt,PostLoginRoute

# Action routing after successful login
PostLoginRoute,ActionIsVerify,END
PostLoginRoute,ActionIsLogon,END
PostLoginRoute,ActionIsChange,RouteChangeMethod

# Change method selection
RouteChangeMethod,HasLogonAccount,UserConfigCmd
RouteChangeMethod,NoLogonAccount,ChangeCmd1

# ---- Direct self-change flow ----
ChangeCmd1,UnknownCommand,ChangeCmd2
ChangeCmd1,OldPassPrompt,SendOld

ChangeCmd2,UnknownCommand,ChangeCmd3
ChangeCmd2,OldPassPrompt,SendOld

ChangeCmd3,OldPassPrompt,SendOld

SendOld,SystemGenPrompt,SendSysGenDefault
SendOld,NewPassPrompt,SendNew1
SendOld,CriteriaNotMet,FAILInvalidNewPassword
SendOld,PolicyFail,FAILInvalidNewPassword

SendSysGenDefault,NewPassPrompt,SendNew1
SendSysGenDefault,CriteriaNotMet,FAILInvalidNewPassword
SendSysGenDefault,PolicyFail,FAILInvalidNewPassword
SendSysGenDefault,MenuPrompt,SendSysGenDefault

# ---- Linked-logon change flow ----
UserConfigCmd,UserConfigMainMenu,UserConfigPassMenu1
UserConfigCmd,ConfigAuthPrompt,SendConfigAuth1
UserConfigCmd,NotAllowedLogin,FAILNotAllowedLogin

SendConfigAuth1,UserConfigMainMenu,UserConfigPassMenu1
SendConfigAuth1,UserConfigPassMenu,UserConfigAssign
SendConfigAuth1,SelectUserPrompt,SendTargetUser
SendConfigAuth1,InvalidLogin,FAILInvalidLogin

UserConfigPassMenu1,ConfigAuthPrompt,SendConfigAuth2
UserConfigPassMenu1,UserConfigPassMenu,UserConfigAssign
UserConfigPassMenu1,SelectUserPrompt,SendTargetUser
UserConfigPassMenu1,InvalidMenuChoice,UserConfigPassMenu2
UserConfigPassMenu1,UnknownCommand,UserConfigPassMenu2

SendConfigAuth2,UserConfigPassMenu,UserConfigAssign
SendConfigAuth2,SelectUserPrompt,SendTargetUser
SendConfigAuth2,InvalidLogin,FAILInvalidLogin

UserConfigPassMenu2,ConfigAuthPrompt,SendConfigAuth2
UserConfigPassMenu2,UserConfigPassMenu,UserConfigAssign
UserConfigPassMenu2,SelectUserPrompt,SendTargetUser
UserConfigPassMenu2,InvalidMenuChoice,FAILNotAllowedLogin
UserConfigPassMenu2,UnknownCommand,FAILNotAllowedLogin

UserConfigAssign,ConfigAuthPrompt,SendConfigAuth3
UserConfigAssign,SelectUserPrompt,SendTargetUser
UserConfigAssign,InvalidMenuChoice,FAILNotAllowedLogin
UserConfigAssign,UnknownCommand,FAILNotAllowedLogin

SendConfigAuth3,SelectUserPrompt,SendTargetUser
SendConfigAuth3,InvalidLogin,FAILInvalidLogin

SendTargetUser,TargetUserNotFound,FAILTargetUserNotFound
SendTargetUser,NewPassPrompt,SendNew1
SendTargetUser,RetypePrompt,SendNew2
SendTargetUser,CriteriaNotMet,FAILInvalidNewPassword
SendTargetUser,PolicyFail,FAILInvalidNewPassword

# ---- Shared new password handling ----
SendNew1,RetypePrompt,SendNew2
SendNew1,CriteriaNotMet,FAILInvalidNewPassword
SendNew1,PolicyFail,FAILInvalidNewPassword
SendNew1,MenuPrompt,WaitAfterNew1
SendNew1,NewPassPrompt,FAILInvalidNewPassword

WaitAfterNew1,CriteriaNotMet,FAILInvalidNewPassword
WaitAfterNew1,PolicyFail,FAILInvalidNewPassword
WaitAfterNew1,NewPassPrompt,FAILInvalidNewPassword
WaitAfterNew1,RetypePrompt,SendNew2
WaitAfterNew1,MenuPrompt,WaitAfterNew1
WaitAfterNew1,DevicePrompt,WaitAfterNew1

SendNew2,PassMismatch,FAILPassMismatch
SendNew2,CriteriaNotMet,FAILInvalidNewPassword
SendNew2,PolicyFail,FAILInvalidNewPassword
SendNew2,PassChangeSuccess,RoutePostChange
SendNew2,DevicePrompt,RoutePostChange
SendNew2,MenuPrompt,RoutePostChange

RoutePostChange,HasLogonAccount,ExitUserConfig
RoutePostChange,NoLogonAccount,FinalStep

ExitUserConfig,MenuPrompt,ExitUserConfig
ExitUserConfig,DevicePrompt,CommitCmd

CommitCmd,CommitCommentPrompt,CommitComment
CommitCmd,RollbackPrompt,CommitRollback
CommitCmd,CommitSuccess,END

CommitComment,RollbackPrompt,CommitRollback
CommitComment,CommitSuccess,END

CommitRollback,CommitSuccess,END
CommitRollback,DevicePrompt,END

FinalStep,TRUE,END

[CPM Parameters Validation]
username, source=FILE, Mandatory=yes
address,  source=FILE, Mandatory=yes
protocol, source=FILE, Mandatory=no
port, source=FILE, Mandatory=no
extrapass1\username, source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]

[Parameters]
PromptTimeout=90
SendHuman=.1 .3 1 .05 2

[Debug Information]
ExpectLog=yes
ConsoleOutput=no
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no


