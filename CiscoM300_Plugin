# Cisco_M300V_AsyncOS_Process.ini
# Updated: 20/02/2026
# Fixes:
# - Handles: "Would you like to get a system generated passphrase? [N]>"
# - Detects passphrase-history rejection and fails cleanly (RC 8004)
# - Avoids commit (passphrase change does not require commit)

[states]
Init=(script)set verifyLogon 1; set tgtUser "<username>"; set tgtPass "<pmpass>"

# Protocol routing (SSH default)
CheckProtocol=
StartSSH_WithPort=(spawn)plink.exe <address> -ssh -P <port>
StartSSH_NoPort=(spawn)plink.exe <address> -ssh
StartTelnet=(spawn)telnet <address> <port>
StoreKeyInCache=y

# Login
LoginUser=$tgtUser
SendPassword=$tgtPass

CheckAction=

# ---- Change (self) ----
ChangeCmd1=passphrase
ChangeCmd2=passwd
ChangeCmd3=password

SendOld=$tgtPass

# Answer system-generated question with ENTER to accept default [N]
SendSysGenDefault=\r

SendNew1=<pmnewpass>
SendNew2=<pmnewpass>

# Wait/gate states
WaitAfterNew1=
FinalStep=
END=

# Fail states
FAILNotSupportedRec=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(Unable to connect to target, 8000)
FAILInvalidLogin=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled=FAIL(User account is disabled/locked, 8010)
FAILNotAllowedLogin=FAIL(User is not allowed to log in, 8012)
FAILInvalidNewPassword=FAIL(Invalid new password rejected by device policy, 8004)
FAILPassMismatch=FAIL(New password entries did not match, 8005)

[transitions]
Init,TRUE,CheckProtocol
CheckProtocol,ProtocolIsTelnet,StartTelnet
CheckProtocol,ProtocolIsSSH,StartSSH_WithPort
CheckProtocol,ProtocolIsEmpty,StartSSH_WithPort
StartSSH_WithPort,PortNotSet,StartSSH_NoPort

# Connect + login
StartSSH_WithPort,UnableToConnect,FAILUnableToConnect
StartSSH_WithPort,PlinkStoreKey,StoreKeyInCache
StartSSH_WithPort,Login,LoginUser

StartSSH_NoPort,UnableToConnect,FAILUnableToConnect
StartSSH_NoPort,PlinkStoreKey,StoreKeyInCache
StartSSH_NoPort,Login,LoginUser

StartTelnet,UnableToConnect,FAILUnableToConnect
StartTelnet,Login,LoginUser

StoreKeyInCache,Login,LoginUser

LoginUser,PasswordPrompt,SendPassword
SendPassword,InvalidLogin,FAILInvalidLogin
SendPassword,AccountDisabled,FAILAccountDisabled
SendPassword,NotAllowedLogin,FAILNotAllowedLogin
SendPassword,DevicePrompt,CheckAction

# Action routing
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsRecOrPreRec,FAILNotSupportedRec
CheckAction,ActionIsChange,ChangeCmd1

# Command selection (some builds use passphrase OR passwd)
ChangeCmd1,UnknownCommand,ChangeCmd2
ChangeCmd1,OldPassPrompt,SendOld

ChangeCmd2,UnknownCommand,ChangeCmd3
ChangeCmd2,OldPassPrompt,SendOld

ChangeCmd3,OldPassPrompt,SendOld

# After sending old passphrase:
SendOld,SystemGenPrompt,SendSysGenDefault
SendOld,NewPassPrompt,SendNew1
SendOld,CriteriaNotMet,FAILInvalidNewPassword
SendOld,PolicyFail,FAILInvalidNewPassword

# After answering system-generated prompt ([N] default):
SendSysGenDefault,NewPassPrompt,SendNew1
SendSysGenDefault,CriteriaNotMet,FAILInvalidNewPassword
SendSysGenDefault,PolicyFail,FAILInvalidNewPassword

# After sending first New Passphrase:
# - Some builds temporarily show menu prompt like []> and THEN print rejection details.
SendNew1,RetypePrompt,SendNew2
SendNew1,CriteriaNotMet,FAILInvalidNewPassword
SendNew1,PolicyFail,FAILInvalidNewPassword
SendNew1,MenuPrompt,WaitAfterNew1
# If it immediately re-prompts "New Passphrase:" again, treat as rejection (no way to supply a different value in same run)
SendNew1,NewPassPrompt,FAILInvalidNewPassword

# Wait state after seeing []> while the device prints criteria/re-prompts
WaitAfterNew1,CriteriaNotMet,FAILInvalidNewPassword
WaitAfterNew1,PolicyFail,FAILInvalidNewPassword
WaitAfterNew1,NewPassPrompt,FAILInvalidNewPassword
WaitAfterNew1,RetypePrompt,SendNew2
WaitAfterNew1,MenuPrompt,WaitAfterNew1

# Retype:
SendNew2,PassMismatch,FAILPassMismatch
SendNew2,CriteriaNotMet,FAILInvalidNewPassword
SendNew2,PolicyFail,FAILInvalidNewPassword
SendNew2,PassChangeSuccess,FinalStep
SendNew2,DevicePrompt,FinalStep

FinalStep,TRUE,END

[CPM Parameters Validation]
username, source=FILE, Mandatory=yes
address,  source=FILE, Mandatory=yes

[Parameters]
PromptTimeout=90
SendHuman=.1 .3 1 .05 2

[Debug Information]
ExpectLog=yes
ConsoleOutput=no
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no

