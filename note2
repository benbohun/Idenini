<#
DisabledAD_Create_IND_Safe_And_Onboard_WIN_Removed.ps1

PURPOSE
- Log in to Alliant Privilege Cloud using CCP -> Identity Shared Services -> ServiceUser.
- Read disabled AD account rows from CSV.
- Validate whether the target IND_ safe exists.
- If the safe does not exist, create it from CSV values.
- Add/ensure standard safe members:
    - IAM_ACU_CA_Admins with full classic permissions.
    - Owner email from CSV with limited permissions.
- Vault/onboard the disabled account into the respective safe.
- Platform is always WIN_Removed.
- No ACU/GDE/EXT prompt.
- No reconcile, no verify, no CPM action, no password change.

CSV SUPPORTED COLUMNS
Required for IND safe naming:
- Samaccountname
- employeeID
- email

Required/recommended for account onboarding:
- UserName   -> actual disabled account to vault, e.g. A_jdoe, jdoe
- Address    -> alliantcreditunion.com, gdeacu.com, extacu.local

Optional:
- SafeName   -> if provided, this overrides IND_<Samaccountname>_<employeeID>
- Password / Secret / InitialPassword -> optional.

Example:
Samaccountname,employeeID,email,Address,UserName
jdoe,12345,jdoe@alliantcreditunion.com,alliantcreditunion.com,A_jdoe
asmith,45678,asmith@gdeacu.com,gdeacu.com,asmith
bwhite,98765,bwhite@extacu.local,extacu.local,bwhite
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== CSV / Report Paths =====
    [string]$CsvPath      = "I:\Script\IDENTITY Script New\csv\Disabled_AD_WIN_Removed.csv",
    [string]$ReportFolder = "I:\Script\IDENTITY Script New\logs\Disabled_AD_WIN_Removed",

    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== Safe Settings =====
    [string]$ManagingCPM        = "HQVECYBARK101",
    [string]$Location           = "\",
    [int]   $RetentionDays      = 7,

    # ===== Disabled Account Onboarding Settings =====
    [string]$PlatformID         = "WIN_Removed",
    [string]$DefaultAddress     = "alliantcreditunion.com",
    [string]$DefaultInitialPassword = "",

    # ===== Standard Safe Members =====
    [string]$AdminGroupUPN      = "IAM_ACU_CA_Admins@alliantcreditunion.com",
    [string]$AdminGroupSAM      = "IAM_ACU_CA_Admins",
    [switch]$SkipSafeMemberUpdate,

    # ===== CCP Settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false
)

# ============================================================
# Module / TLS / Runtime Setup
# ============================================================

Import-Module psPAS -ErrorAction Stop

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Continue"

if (-not (Test-Path $ReportFolder)) {
    New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
}

$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$script:LogPath    = Join-Path $ReportFolder "DisabledAD_WIN_Removed_Log_$timestamp.log"
$script:ReportPath = Join-Path $ReportFolder "DisabledAD_WIN_Removed_Report_$timestamp.csv"

# ============================================================
# Logging Helpers
# ============================================================

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [Parameter()][string]$Level = "INFO",
        [Parameter()][ConsoleColor]$Color = [ConsoleColor]::White
    )

    $line = "{0} | {1} | {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message

    try {
        Add-Content -Path $script:LogPath -Value $line -Encoding UTF8
    } catch {}

    Write-Host $line -ForegroundColor $Color
}

function Write-Info($m) { Write-Log -Message $m -Level "INFO" -Color Cyan }
function Write-Ok($m)   { Write-Log -Message $m -Level "OK"   -Color Green }
function Write-Warn($m) { Write-Log -Message $m -Level "WARN" -Color Yellow }
function Write-Err($m)  { Write-Log -Message $m -Level "ERR"  -Color Red }

# ============================================================
# Utility Helpers
