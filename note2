[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL     = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL     = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (Service User stored in Vault) =====
    [string]$CCPAddress            = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation           = "AIMWebService",
    [string]$CCPAppID              = "ACURestAPI",
    [string]$CCPSafe               = "ACU-VAULT-API",
    [string]$CCPObject             = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth        = $false,

    # ===== AD lookup =====
    [string]$SearchBase            = "OU=End Users,DC=alliantcreditunion,DC=com",
    [string]$SamAccountPattern     = "A_*",

    # ===== Target CyberArk state =====
    [string]$TargetSafeName        = "Accounts to be deleted",
    [string]$TargetPlatformID      = "WIN_Removed",
    [bool]  $DisableAutoManagement = $true,
    [string]$ManualManagementReason = "Disabled in Active Directory and moved by CyberArk cleanup automation.",

    # ===== Search tuning =====
    [ValidateRange(1,5000)]
    [int]$AccountSearchLimit       = 1000,

    # ===== Export / Logging =====
    [string]$ExportRoot            = "I:\Script\Disabled User"
)

# ==============================
# Environment / module setup
# ==============================
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Import-Module ActiveDirectory -ErrorAction Stop
Import-Module psPAS -ErrorAction Stop

# ==============================
# Paths
# ==============================
$TimeStamp        = Get-Date -Format "yyyyMMdd_HHmmss"
$DisabledUsersCsv = Join-Path $ExportRoot "DisabledAdminAccount.csv"
$StatusCsvPath    = Join-Path $ExportRoot ("DisabledAdminAccount_MoveStatus_{0}.csv" -f $TimeStamp)
$LogFilePath      = Join-Path $ExportRoot ("DisabledAdminAccount_Move_{0}.log" -f $TimeStamp)

# ==============================
# Console helpers
# ==============================
function Write-Err {
    param([string]$Message)
    Write-Host "❌ $Message" -ForegroundColor Red
}

function Write-WarnLine {
    param([string]$Message)
    Write-Host "⚠️  $Message" -ForegroundColor Yellow
}

function Write-Info {
    param([string]$Message)
    Write-Host "ℹ️  $Message" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Message)
    Write-Host "✅ $Message" -ForegroundColor Green
}

# ==============================
# Utility helpers
# ==============================
function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not [string]::IsNullOrWhiteSpace($Path) -and -not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Write-LogLine {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Add-Content -Path $LogFilePath -Value $line
}

function Get-HostFromUrl {
    param([Parameter(Mandatory)][string]$Url)
    try {
        return ([uri]$Url).Host
    }
    catch {
        return ($Url -replace '^https?://','' -replace '/.*$','').Trim()
    }
}

function Get-PCloudSubdomainFromUrl {
    param([Parameter(Mandatory)][string]$PrivilegeCloudURL)
    $pcloudHost = Get-HostFromUrl $PrivilegeCloudURL
    return ($pcloudHost.Split('.')[0]).Trim()
}

function Get-PropValueCI {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$PropName
    )
    if ($null -eq $Object) { return $null }

    $prop = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $PropName } | Select-Object -First 1
    if ($prop) { return $prop.Value }
    return $null
}

function Convert-ToObjectArray {
    param($InputObject)

    if ($null -eq $InputObject) { return @() }

    if ($InputObject -is [System.Array]) {
        return $InputObject
    }

    $valueProp = $InputObject.PSObject.Properties | Where-Object { $_.Name -eq 'value' } | Select-Object -First 1
    if ($valueProp -and $null -ne $valueProp.Value) {
        return @($valueProp.Value)
    }

    return @($InputObject)
}

function Test-UsernameMatch {
    param(
        [string]$UserName,
        [string]$SamAccountName
    )

    if ([string]::IsNullOrWhiteSpace($UserName) -or [string]::IsNullOrWhiteSpace($SamAccountName)) {
        return $false
    }

    $escaped = [regex]::Escape($SamAccountName)

    if ($UserName -ieq $SamAccountName) { return $true }
    if ($UserName -imatch ("^(?:[^\\/@]+[\\/@])?{0}$" -f $escaped)) { return $true }
    if ($UserName -imatch ("^{0}@[^@]+$" -f $escaped)) { return $true }

    return $false
}

function Test-AccountNameMatch {
    param(
        [string]$AccountName,
        [string]$SamAccountName
    )

    if ([string]::IsNullOrWhiteSpace($AccountName) -or [string]::IsNullOrWhiteSpace($SamAccountName)) {
        return $false
    }

    $escaped = [regex]::Escape($SamAccountName)

    if ($AccountName -ieq $SamAccountName) { return $true }
    if ($AccountName -imatch ("(^|[-_]){0}$" -f $escaped)) { return $true }

    return $false
}

# ==============================
# CCP / PAS authentication
# ==============================
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-LogLine "Retrieving service credential from CCP: $url" "INFO"
    Write-Info "Retrieving service credential from CCP..."

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName and/or Content."
    }

    Write-LogLine "CCP returned service user: $($resp.UserName)" "SUCCESS"
    Write-Ok "CCP credential retrieved successfully for: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

function Connect-PCloudWithServiceUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL,
        [Parameter(Mandatory)][pscredential]$ServiceCred
    )

    $tenantHost = Get-HostFromUrl $IdentityTenantURL
    $subdomain  = Get-PCloudSubdomainFromUrl $PrivilegeCloudURL

    Write-LogLine "Attempting login (Primary): New-PASSession -ServiceUser" "INFO"
    Write-Info "Attempting Privilege Cloud login using primary method..."

    try {
        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential        $ServiceCred `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        $sess = Get-PASSession
        if (-not $sess) { throw "Get-PASSession returned null after primary login." }

        Write-LogLine "Authenticated (Primary) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Primary) as: $($ServiceCred.UserName)"
        return
    }
    catch {
        Write-LogLine "Primary login failed: $($_.Exception.Message)" "WARN"
        Write-WarnLine "Primary login failed. Attempting fallback..."

        $cmd = Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue
        if (-not $cmd) {
            throw "Fallback login not available because Get-IdentityHeader was not found."
        }

        $header = Get-IdentityHeader `
            -IdentityTenantURL $tenantHost `
            -psPASFormat `
            -PCloudSubdomain $subdomain `
            -UPCreds $ServiceCred

        Use-PASSession $header

        $sess2 = Get-PASSession
        if (-not $sess2) { throw "Get-PASSession returned null after fallback login." }

        Write-LogLine "Authenticated (Fallback) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Fallback) as: $($ServiceCred.UserName)"
    }
}

# ==============================
# Validation helpers
# ==============================
function Assert-TargetSafeAccessible {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName
    )

    Write-Info "Validating target safe access after authentication..."
    Write-LogLine "Validating target safe access for '$SafeName'" "INFO"

    try {
        $safe = Get-PASSafe -SafeName $SafeName -ErrorAction Stop
        if (-not $safe) {
            throw "Get-PASSafe returned no object for '$SafeName'."
        }

        Write-Ok "Validated target safe access: $SafeName"
        Write-LogLine "Validated target safe access: $SafeName" "SUCCESS"
    }
    catch {
        $msg = "Target safe '$SafeName' was not found or is not accessible by the authenticated service user after login. Verify exact safe name and safe membership/permissions."
        Write-LogLine $msg "ERROR"
        throw $msg
    }
}

function Assert-TargetPlatformVisible {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $getPlatformCmd = Get-Command Get-PASPlatform -ErrorAction SilentlyContinue
    if (-not $getPlatformCmd) {
        Write-WarnLine "Get-PASPlatform is not available in this psPAS version. Skipping platform validation."
        Write-LogLine "Get-PASPlatform not available. Platform validation skipped." "WARN"
        return
    }

    try {
        $null = Get-PASPlatform -PlatformID $PlatformID -ErrorAction Stop
        Write-Ok "Validated target platform: $PlatformID"
        Write-LogLine "Validated target platform: $PlatformID" "SUCCESS"
    }
    catch {
        Write-WarnLine "Could not validate target platform '$PlatformID'. Continuing, but confirm the platform ID is correct."
        Write-LogLine "Platform validation warning for '$PlatformID': $($_.Exception.Message)" "WARN"
    }
}

# ==============================
# AD discovery
# ==============================
function Get-DisabledADAdminUsers {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SearchBase,
        [Parameter(Mandatory)][string]$SamAccountPattern,
        [Parameter(Mandatory)][string]$ExportFile
    )

    Write-Info "Querying AD for disabled admin accounts..."
    Write-LogLine "Querying AD. SearchBase='$SearchBase'; SamAccountPattern='$SamAccountPattern'" "INFO"

    $users = Get-ADUser `
        -SearchBase $SearchBase `
        -Filter { Enabled -eq $false -and SamAccountName -like $SamAccountPattern } `
        -Properties SamAccountName, Name, DistinguishedName, Enabled |
    Select-Object SamAccountName, Name, DistinguishedName

    $users = @($users)

    $users | Export-Csv -Path $ExportFile -NoTypeInformation
    Write-LogLine "Exported disabled AD users to $ExportFile. Count=$($users.Count)" "SUCCESS"
    Write-Ok "Disabled AD admin accounts exported to: $ExportFile"

    return $users
}

# ==============================
# CyberArk account lookup
# ==============================
function Find-PASAccountsForDisabledUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][int]$Limit
    )

    Write-LogLine "Searching CyberArk accounts for disabled AD user '$SamAccountName'" "INFO"

    $raw = Get-PASAccount -search $SamAccountName -limit $Limit
    $accounts = Convert-ToObjectArray $raw

    $matches = New-Object System.Collections.Generic.List[object]
    $seen    = @{}

    foreach ($acct in $accounts) {
        if ($null -eq $acct) { continue }

        $id       = Get-PropValueCI -Object $acct -PropName 'id'
        $userName = Get-PropValueCI -Object $acct -PropName 'userName'
        $name     = Get-PropValueCI -Object $acct -PropName 'name'

        if ([string]::IsNullOrWhiteSpace($id)) { continue }
        if ($seen.ContainsKey($id)) { continue }

        $userMatch = Test-UsernameMatch -UserName $userName -SamAccountName $SamAccountName
        $nameMatch = Test-AccountNameMatch -AccountName $name -SamAccountName $SamAccountName

        if ($userMatch -or $nameMatch) {
            $seen[$id] = $true
            [void]$matches.Add($acct)
        }
    }

    Write-LogLine "Found $($matches.Count) matching CyberArk account(s) for '$SamAccountName'" "INFO"
    return @($matches)
}

# ==============================
# CyberArk account update
# ==============================
function Update-DisabledPASAccount {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)]$Account,
        [Parameter(Mandatory)][string]$TargetSafeName,
        [Parameter(Mandatory)][string]$TargetPlatformID,
        [Parameter(Mandatory)][bool]$DisableAutoManagement,
        [Parameter(Mandatory)][string]$ManualManagementReason
    )

    $id              = Get-PropValueCI -Object $Account -PropName 'id'
    $name            = Get-PropValueCI -Object $Account -PropName 'name'
    $userName        = Get-PropValueCI -Object $Account -PropName 'userName'
    $address         = Get-PropValueCI -Object $Account -PropName 'address'
    $currentSafe     = Get-PropValueCI -Object $Account -PropName 'safeName'
    $currentPlatform = Get-PropValueCI -Object $Account -PropName 'platformId'

    $currentAutoMgmt = $null
    $currentReason   = $null
    if ($null -ne $Account.secretManagement) {
        $currentAutoMgmt = $Account.secretManagement.automaticManagementEnabled
        $currentReason   = $Account.secretManagement.manualManagementReason
    }

    $display = "{0} | {1} | {2} | {3}" -f $id, $name, $userName, $address

    $plannedOps = New-Object System.Collections.Generic.List[string]

    if ($currentSafe -ne $TargetSafeName) {
        [void]$plannedOps.Add("safeName: '$currentSafe' -> '$TargetSafeName'")
    }
    if ($currentPlatform -ne $TargetPlatformID) {
        [void]$plannedOps.Add("platformId: '$currentPlatform' -> '$TargetPlatformID'")
    }
    if ($DisableAutoManagement -and $currentAutoMgmt -ne $false) {
        [void]$plannedOps.Add("automaticManagementEnabled: '$currentAutoMgmt' -> 'False'")
    }
    if ($DisableAutoManagement -and $currentReason -ne $ManualManagementReason) {
        [void]$plannedOps.Add("manualManagementReason updated")
    }

    if ($plannedOps.Count -eq 0) {
        return [pscustomobject]@{
            Status  = "AlreadyCompliant"
            Message = "No changes required."
        }
    }

    $actionText = $plannedOps -join "; "

    if ($PSCmdlet.ShouldProcess($display, $actionText)) {
        if ($currentSafe -ne $TargetSafeName) {
            Set-PASAccount -AccountID $id -op replace -path "/safeName" -value $TargetSafeName
        }

        if ($currentPlatform -ne $TargetPlatformID) {
            Set-PASAccount -AccountID $id -op replace -path "/platformId" -value $TargetPlatformID
        }

        if ($DisableAutoManagement -and $currentAutoMgmt -ne $false) {
            Set-PASAccount -AccountID $id -op replace -path "/secretManagement/automaticManagementEnabled" -value $false
        }

        if ($DisableAutoManagement -and $currentReason -ne $ManualManagementReason) {
            Set-PASAccount -AccountID $id -op replace -path "/secretManagement/manualManagementReason" -value $ManualManagementReason
        }

        return [pscustomobject]@{
            Status  = "Updated"
            Message = $actionText
        }
    }
    else {
        return [pscustomobject]@{
            Status  = "WhatIf"
            Message = $actionText
        }
    }
}

# ==============================
# Main
# ==============================
Ensure-Directory -Path $ExportRoot
"" | Set-Content -Path $LogFilePath

Write-Info "Disabled AD -> CyberArk move script starting..."
Write-LogLine "Script started." "INFO"
Write-LogLine "TargetSafeName='$TargetSafeName'; TargetPlatformID='$TargetPlatformID'; DisableAutoManagement='$DisableAutoManagement'" "INFO"

$results = New-Object System.Collections.Generic.List[object]

try {
    # AD export
    $disabledUsers = Get-DisabledADAdminUsers `
        -SearchBase $SearchBase `
        -SamAccountPattern $SamAccountPattern `
        -ExportFile $DisabledUsersCsv

    if (-not $disabledUsers -or $disabledUsers.Count -eq 0) {
        Write-WarnLine "No disabled AD admin accounts found."
        Write-LogLine "No disabled AD accounts found. Exiting." "WARN"
        @() | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        Write-Ok "Empty status report exported to: $StatusCsvPath"
        return
    }

    Write-Info ("Found {0} disabled AD account(s)." -f $disabledUsers.Count)

    # Authenticate to CyberArk FIRST
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Connect-PCloudWithServiceUser `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -ServiceCred       $serviceCred

    # Validate safe/platform AFTER login
    Assert-TargetSafeAccessible -SafeName $TargetSafeName
    Assert-TargetPlatformVisible -PlatformID $TargetPlatformID

    $i = 0
    foreach ($user in $disabledUsers) {
        $i++
        $sam  = $user.SamAccountName
        $name = $user.Name
        $dn   = $user.DistinguishedName

        Write-Info ("[{0}/{1}] Processing disabled AD user: {2}" -f $i, $disabledUsers.Count, $sam)
        Write-LogLine "Processing disabled AD user '$sam'" "INFO"

        try {
            $matches = Find-PASAccountsForDisabledUser -SamAccountName $sam -Limit $AccountSearchLimit

            if (-not $matches -or $matches.Count -eq 0) {
                $msg = "No matching CyberArk accounts found."
                Write-WarnLine "$sam -> $msg"
                Write-LogLine "$sam -> $msg" "WARN"

                [void]$results.Add([pscustomobject]@{
                    ADSamAccountName     = $sam
                    ADName               = $name
                    ADDistinguishedName  = $dn
                    AccountID            = $null
                    AccountName          = $null
                    AccountUserName      = $null
                    Address              = $null
                    SourceSafe           = $null
                    SourcePlatformID     = $null
                    TargetSafe           = $TargetSafeName
                    TargetPlatformID     = $TargetPlatformID
                    Status               = "NoMatch"
                    Message              = $msg
                })
                continue
            }

            foreach ($acct in $matches) {
                $acctId       = Get-PropValueCI -Object $acct -PropName 'id'
                $acctName     = Get-PropValueCI -Object $acct -PropName 'name'
                $acctUserName = Get-PropValueCI -Object $acct -PropName 'userName'
                $acctAddress  = Get-PropValueCI -Object $acct -PropName 'address'
                $acctSafe     = Get-PropValueCI -Object $acct -PropName 'safeName'
                $acctPlatform = Get-PropValueCI -Object $acct -PropName 'platformId'

                $reason = "{0} Disabled AD account detected: {1}." -f $ManualManagementReason.TrimEnd('.'), $sam

                $update = Update-DisabledPASAccount `
                    -Account $acct `
                    -TargetSafeName $TargetSafeName `
                    -TargetPlatformID $TargetPlatformID `
                    -DisableAutoManagement $DisableAutoManagement `
                    -ManualManagementReason $reason `
                    -WhatIf:$WhatIfPreference

                if ($update.Status -eq 'Updated') {
                    Write-Ok ("{0} -> moved to safe '{1}' and platform '{2}'." -f $acctId, $TargetSafeName, $TargetPlatformID)
                    Write-LogLine "$acctId updated successfully. $($update.Message)" "SUCCESS"
                }
                elseif ($update.Status -eq 'WhatIf') {
                    Write-Info ("{0} -> WhatIf only. {1}" -f $acctId, $update.Message)
                    Write-LogLine "$acctId WhatIf: $($update.Message)" "INFO"
                }
                else {
                    Write-Info ("{0} -> {1}" -f $acctId, $update.Message)
                    Write-LogLine "$acctId no change required." "INFO"
                }

                [void]$results.Add([pscustomobject]@{
                    ADSamAccountName     = $sam
                    ADName               = $name
                    ADDistinguishedName  = $dn
                    AccountID            = $acctId
                    AccountName          = $acctName
                    AccountUserName      = $acctUserName
                    Address              = $acctAddress
                    SourceSafe           = $acctSafe
                    SourcePlatformID     = $acctPlatform
                    TargetSafe           = $TargetSafeName
                    TargetPlatformID     = $TargetPlatformID
                    Status               = $update.Status
                    Message              = $update.Message
                })
            }
        }
        catch {
            $err = $_.Exception.Message
            Write-Err ("{0} -> Failed: {1}" -f $sam, $err)
            Write-LogLine "$sam failed: $err" "ERROR"

            [void]$results.Add([pscustomobject]@{
                ADSamAccountName     = $sam
                ADName               = $name
                ADDistinguishedName  = $dn
                AccountID            = $null
                AccountName          = $null
                AccountUserName      = $null
                Address              = $null
                SourceSafe           = $null
                SourcePlatformID     = $null
                TargetSafe           = $TargetSafeName
                TargetPlatformID     = $TargetPlatformID
                Status               = "Failed"
                Message              = $err
            })
        }
    }
}
catch {
    $fatal = $_.Exception.Message
    Write-Err "Fatal error: $fatal"
    Write-LogLine "Fatal error: $fatal" "ERROR"
    throw
}
finally {
    try {
        if ($results.Count -gt 0) {
            $results | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        }
        else {
            @() | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        }

        Write-Ok "Status report exported to: $StatusCsvPath"
        Write-LogLine "Status report exported to: $StatusCsvPath" "SUCCESS"
    }
    catch {
        Write-Err "Failed to export status CSV: $($_.Exception.Message)"
        Write-LogLine "Failed to export status CSV: $($_.Exception.Message)" "ERROR"
    }

    try {
        Close-PASSession | Out-Null
        Write-LogLine "PAS session closed." "INFO"
    }
    catch {
        Write-LogLine "Close-PASSession skipped or failed: $($_.Exception.Message)" "WARN"
    }

    Write-Info "Completed."
    Write-LogLine "Script completed." "INFO"
}
