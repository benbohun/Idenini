[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL      = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL      = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (Service User stored in Vault) =====
    [string]$CCPAddress             = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation            = "AIMWebService",
    [string]$CCPAppID               = "ACURestAPI",
    [string]$CCPSafe                = "ACU-VAULT-API",
    [string]$CCPObject              = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth         = $false,

    # ===== AD lookup =====
    [string]$SearchBase             = "OU=End Users,DC=alliantcreditunion,DC=com",
    [string]$SamAccountPattern      = "A_*",

    # ===== Target CyberArk state =====
    [string]$TargetSafeName         = "Accounts to be deleted",
    [string]$TargetPlatformID       = "WIN_Removed",
    [string]$ManualManagementReason = "Disabled in Active Directory and moved by CyberArk cleanup automation.",
    [switch]$SkipDeleteSource,

    # ===== Password retrieval (optional if your environment requires justification) =====
    [string]$PasswordReason         = "",
    [string]$TicketingSystem        = "",
    [string]$TicketId               = "",

    # ===== Search tuning =====
    [ValidateRange(1,1000)]
    [int]$PageSize                  = 100,
    [ValidateRange(1,5000)]
    [int]$AccountSearchLimit        = 1000,

    # ===== Export / Logging =====
    [string]$ExportRoot             = "I:\Script\Disabled User"
)

# ==============================
# Environment / module setup
# ==============================
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Import-Module ActiveDirectory -ErrorAction Stop
Import-Module psPAS -ErrorAction Stop

# ==============================
# Paths
# ==============================
$TimeStamp        = Get-Date -Format "yyyyMMdd_HHmmss"
$DisabledUsersCsv = Join-Path $ExportRoot "DisabledAdminAccount.csv"
$StatusCsvPath    = Join-Path $ExportRoot ("DisabledAdminAccount_MoveStatus_{0}.csv" -f $TimeStamp)
$LogFilePath      = Join-Path $ExportRoot ("DisabledAdminAccount_Move_{0}.log" -f $TimeStamp)

# ==============================
# Console helpers
# ==============================
function Write-Err {
    param([string]$Message)
    Write-Host "❌ $Message" -ForegroundColor Red
}

function Write-WarnLine {
    param([string]$Message)
    Write-Host "⚠️  $Message" -ForegroundColor Yellow
}

function Write-Info {
    param([string]$Message)
    Write-Host "ℹ️  $Message" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Message)
    Write-Host "✅ $Message" -ForegroundColor Green
}

# ==============================
# Utility helpers
# ==============================
function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not [string]::IsNullOrWhiteSpace($Path) -and -not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Write-LogLine {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Add-Content -Path $LogFilePath -Value $line
}

function Get-HostFromUrl {
    param([Parameter(Mandatory)][string]$Url)
    try {
        return ([uri]$Url).Host
    }
    catch {
        return ($Url -replace '^https?://','' -replace '/.*$','').Trim()
    }
}

function Get-PCloudSubdomainFromUrl {
    param([Parameter(Mandatory)][string]$PrivilegeCloudURL)
    $pcloudHost = Get-HostFromUrl $PrivilegeCloudURL
    return ($pcloudHost.Split('.')[0]).Trim()
}

function Get-PropValueCI {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$PropName
    )

    if ($null -eq $Object) { return $null }

    $prop = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $PropName } | Select-Object -First 1
    if ($prop) { return $prop.Value }
    return $null
}

function Convert-ToArray {
    param($InputObject)

    if ($null -eq $InputObject) { return @() }
    if ($InputObject -is [System.Array]) { return $InputObject }

    $valueProp = $InputObject.PSObject.Properties | Where-Object { $_.Name -eq 'value' } | Select-Object -First 1
    if ($valueProp -and $null -ne $valueProp.Value) { return @($valueProp.Value) }

    $itemsProp = $InputObject.PSObject.Properties | Where-Object { $_.Name -eq 'items' } | Select-Object -First 1
    if ($itemsProp -and $null -ne $itemsProp.Value) { return @($itemsProp.Value) }

    if (Get-PropValueCI -Object $InputObject -PropName 'id') { return @($InputObject) }

    return @()
}

function Test-UsernameMatch {
    param(
        [string]$UserName,
        [string]$SamAccountName
    )

    if ([string]::IsNullOrWhiteSpace($UserName) -or [string]::IsNullOrWhiteSpace($SamAccountName)) {
        return $false
    }

    $escaped = [regex]::Escape($SamAccountName)

    if ($UserName -ieq $SamAccountName) { return $true }
    if ($UserName -imatch ("^(?:[^\\/@]+[\\/@])?{0}$" -f $escaped)) { return $true }
    if ($UserName -imatch ("^{0}@[^@]+$" -f $escaped)) { return $true }

    return $false
}

function Test-AccountNameMatch {
    param(
        [string]$AccountName,
        [string]$SamAccountName
    )

    if ([string]::IsNullOrWhiteSpace($AccountName) -or [string]::IsNullOrWhiteSpace($SamAccountName)) {
        return $false
    }

    $escaped = [regex]::Escape($SamAccountName)

    if ($AccountName -ieq $SamAccountName) { return $true }
    if ($AccountName -imatch ("(^|[-_]){0}$" -f $escaped)) { return $true }

    return $false
}

# ==============================
# CCP / PAS authentication
# ==============================
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-LogLine "Retrieving service credential from CCP: $url" "INFO"
    Write-Info "Retrieving service credential from CCP..."

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName and/or Content."
    }

    Write-LogLine "CCP returned service user: $($resp.UserName)" "SUCCESS"
    Write-Ok "CCP credential retrieved successfully for: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

function Connect-PCloudWithServiceUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL,
        [Parameter(Mandatory)][pscredential]$ServiceCred
    )

    $tenantHost = Get-HostFromUrl $IdentityTenantURL
    $subdomain  = Get-PCloudSubdomainFromUrl $PrivilegeCloudURL

    Write-LogLine "Attempting login (Primary): New-PASSession -ServiceUser" "INFO"
    Write-Info "Attempting Privilege Cloud login using primary method..."

    try {
        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential        $ServiceCred `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        $sess = Get-PASSession
        if (-not $sess) { throw "Get-PASSession returned null after primary login." }

        Write-LogLine "Authenticated (Primary) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Primary) as: $($ServiceCred.UserName)"
        return
    }
    catch {
        Write-LogLine "Primary login failed: $($_.Exception.Message)" "WARN"
        Write-WarnLine "Primary login failed. Attempting fallback..."

        $cmd = Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue
        if (-not $cmd) {
            throw "Fallback login not available because Get-IdentityHeader was not found."
        }

        $header = Get-IdentityHeader `
            -IdentityTenantURL $tenantHost `
            -psPASFormat `
            -PCloudSubdomain $subdomain `
            -UPCreds $ServiceCred

        Use-PASSession $header

        $sess2 = Get-PASSession
        if (-not $sess2) { throw "Get-PASSession returned null after fallback login." }

        Write-LogLine "Authenticated (Fallback) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Fallback) as: $($ServiceCred.UserName)"
    }
}

# ==============================
# Session-backed REST helpers
# ==============================
function Get-PASSessionStrict {
    $session = Get-PASSession
    if (-not $session) {
        throw "No active PAS session found."
    }
    if (-not $session.BaseURI) {
        throw "PAS session BaseURI is empty."
    }
    if (-not $session.WebSession) {
        throw "PAS session WebSession is empty."
    }
    return $session
}

function Get-WebExceptionResponseText {
    param([System.Exception]$Exception)

    try {
        if ($Exception.Response -and $Exception.Response.GetResponseStream()) {
            $reader = New-Object System.IO.StreamReader($Exception.Response.GetResponseStream())
            $text = $reader.ReadToEnd()
            $reader.Close()
            return $text
        }
    }
    catch {
        return $null
    }

    return $null
}

function Invoke-PCRequest {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][ValidateSet('GET','POST','PATCH','DELETE')][string]$Method,
        [Parameter(Mandatory)][string]$RelativePath,
        $Body
    )

    $session = Get-PASSessionStrict

    # IMPORTANT:
    # For Privilege Cloud Shared Services service-user sessions, BaseURI is typically:
    # https://<subdomain>.privilegecloud.cyberark.cloud/PasswordVault
    # Account APIs are Gen2 endpoints under:
    # https://<subdomain>.privilegecloud.cyberark.cloud/PasswordVault/API/...
    $uri = "{0}/API/{1}" -f $session.BaseURI.TrimEnd('/'), $RelativePath.TrimStart('/')

    Write-LogLine "REST $Method $uri" "INFO"

    try {
        if ($PSBoundParameters.ContainsKey('Body') -and $null -ne $Body) {
            $json = $Body | ConvertTo-Json -Depth 20 -Compress
            return Invoke-RestMethod -Method $Method -Uri $uri -WebSession $session.WebSession -ContentType 'application/json' -Body $json -ErrorAction Stop
        }
        else {
            return Invoke-RestMethod -Method $Method -Uri $uri -WebSession $session.WebSession -ContentType 'application/json' -ErrorAction Stop
        }
    }
    catch {
        $respText = Get-WebExceptionResponseText -Exception $_.Exception
        if (-not [string]::IsNullOrWhiteSpace($respText)) {
            Write-LogLine "REST error body for $Method $uri : $respText" "ERROR"
            throw "REST call failed: $Method $uri :: $($_.Exception.Message) :: ResponseBody=$respText"
        }

        throw "REST call failed: $Method $uri :: $($_.Exception.Message)"
    }
}

function Assert-TargetSafeAccessible {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$SafeName)

    Write-Info "Validating target safe access after authentication..."
    Write-LogLine "Validating target safe access for '$SafeName'" "INFO"

    try {
        $safe = Get-PASSafe -SafeName $SafeName -ErrorAction Stop
        if (-not $safe) {
            throw "Get-PASSafe returned no object for '$SafeName'."
        }

        Write-Ok "Validated target safe access: $SafeName"
        Write-LogLine "Validated target safe access: $SafeName" "SUCCESS"
    }
    catch {
        $msg = "Target safe '$SafeName' was not found or is not accessible by the authenticated service user after login."
        Write-LogLine $msg "ERROR"
        throw $msg
    }
}

function Assert-TargetPlatformVisible {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$PlatformID)

    $getPlatformCmd = Get-Command Get-PASPlatform -ErrorAction SilentlyContinue
    if (-not $getPlatformCmd) {
        Write-WarnLine "Get-PASPlatform is not available in this psPAS version. Skipping platform validation."
        Write-LogLine "Get-PASPlatform not available. Platform validation skipped." "WARN"
        return
    }

    try {
        $null = Get-PASPlatform -PlatformID $PlatformID -ErrorAction Stop
        Write-Ok "Validated target platform: $PlatformID"
        Write-LogLine "Validated target platform: $PlatformID" "SUCCESS"
    }
    catch {
        Write-WarnLine "Could not validate target platform '$PlatformID'. Continuing, but confirm the platform ID is correct."
        Write-LogLine "Platform validation warning for '$PlatformID': $($_.Exception.Message)" "WARN"
    }
}

