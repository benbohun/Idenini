# ============================================
# CCP -> psPAS (no prompts) -> Export Safes Report
# ============================================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# --- psPAS ---
Import-Module psPAS -Force

# --- Minimal logger (no secrets) ---
function Log([string]$m,[ConsoleColor]$c='White'){
  $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
  Write-Host "$ts - $m" -ForegroundColor $c
}

# --- CCP / Identity config (adjust if needed) ---
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# --- Export path ---
#$exportPath = "E:\Installation Media\Script\OnboardScript\PSSafes.csv"
$exportPath = "E:\Installation Media\Script\OnboardScript\data\SafeMembershipReport.csv"

# --- Login helper: start PAS session using CCP creds (Object method only) ---
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,  # e.g., cna.com-CA_PAMDiscovery_SVC
        [Parameter(Mandatory)] [string]$UPUser       # e.g., CA_PAMDiscovery_SVC
    )
    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Log "Retrieving CCP credential for '$UPUser' via Object..." Cyan
    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }
    Log "CCP returned username for service principal." Green

    # Build PSCredential (do not print secrets)
    $sec = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upc = [PSCredential]::new($UPUser, $sec)

    Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." Cyan
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upc
    Use-PASSession $hdr
    if (-not (Get-PASSession)) { throw "psPAS session not established." }
    Log "PAS session established (no prompts)." Green

    # Minimize plaintext exposure
    $resp.Content = $null
    return $true
}

# --- Authenticate (service: CA_PAMDiscovery_SVC) ---
Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC" | Out-Null

# --- Retrieve safes & export selected fields ---
Log "Retrieving safes..." Yellow
$PSSafes = Get-PASSafe -ErrorAction Stop

# Ensure export directory exists
$dir = Split-Path -Path $exportPath -Parent
if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }

Log "Exporting report to: $exportPath" Yellow
$PSSafes | Select-Object `
    safeUrlId, safeName, safeNumber, description, location, `
    @{Name="creator_id";   Expression = { $_.creator.id }}, `
    @{Name="creator_name"; Expression = { $_.creator.name }}, `
    olacEnabled, managingCPM, numberOfVersionsRetention, numberOfDaysRetention, `
    autoPurgeEnabled, creationTime, lastModificationTime, isExpiredMember |
Export-Csv -Path $exportPath -NoTypeInformation -Encoding UTF8

Log "Done. Safes report exported." Green

# Optional: close session
try { Close-PASSession | Out-Null } catch {}
