<#
========================================================================
SafeOwner_Update_SpecifyNextAccountContent_False.ps1

What this script does
- Logs in using CCP -> Identity Shared Services -> ServiceUser
  (same Alliant login pattern you already use)
- Reads SafeName + MemberName from CSV, or prompts for one record in Single mode
- Finds the existing safe member on the specified safe
- Preserves current permissions
- Updates ONLY:
    SpecifyNextAccountContent = $false

Input CSV
- Default: I:\Script\IDENTITY Script New\csv\safeowners.csv
- Expected columns:
    SafeName, MemberName

Outputs
- I:\Script\IDENTITY Script New\csv\SafeOwner_SpecifyNextAccountContent_Update.log
- I:\Script\IDENTITY Script New\csv\SafeOwner_SpecifyNextAccountContent_Update_Result.csv
========================================================================
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [ValidateSet('CSV','Single')]
    [string]$Mode = 'CSV',

    [string]$CsvPath = "I:\Script\IDENTITY Script New\csv\safeowners.csv",

    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress      = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation     = "AIMWebService",
    [string]$CCPAppID        = "ACURestAPI",
    [string]$CCPSafe         = "ACU-VAULT-API",
    [string]$CCPObject       = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth  = $false
)

# =========================
# Baseline
# =========================
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'

# =========================
# Paths / Logging
# =========================
$OutDir = Split-Path -Path $CsvPath -Parent
if ([string]::IsNullOrWhiteSpace($OutDir)) {
    $OutDir = "I:\Script\IDENTITY Script New\csv"
}
if (-not (Test-Path $OutDir)) {
    New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
}

$LogFile    = Join-Path $OutDir "SafeOwner_SpecifyNextAccountContent_Update.log"
$ResultFile = Join-Path $OutDir "SafeOwner_SpecifyNextAccountContent_Update_Result.csv"

New-Item -ItemType File -Path $LogFile -Force | Out-Null

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

function Write-Info([string]$m) { Write-Log -Message $m -Color Cyan }
function Write-Ok([string]$m)   { Write-Log -Message $m -Color Green }
function Write-Warn([string]$m) { Write-Log -Message $m -Color Yellow }
function Write-Err([string]$m)  { Write-Log -Message $m -Color Red }

# =========================
# GUI prompt helper
# =========================
Add-Type -AssemblyName System.Windows.Forms | Out-Null
Add-Type -AssemblyName System.Drawing       | Out-Null

function Show-InputDialog {
    param(
        [Parameter(Mandatory)][string]$Title,
        [Parameter(Mandatory)][string]$Prompt,
        [string]$Default = '',
        [scriptblock]$ValidateScript = { $true },
        [string]$ValidationHint = ''
    )

    try {
        $form                 = New-Object System.Windows.Forms.Form
        $form.Text            = $Title
        $form.StartPosition   = 'CenterScreen'
        $form.TopMost         = $true
        $form.Size            = New-Object System.Drawing.Size(520,190)
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox     = $false

        $lbl                  = New-Object System.Windows.Forms.Label
        $lbl.Text             = $Prompt
        $lbl.AutoSize         = $true
        $lbl.Location         = '12,15'
        $lbl.Font             = New-Object System.Drawing.Font('Segoe UI',10)
        $form.Controls.Add($lbl)

        $tb                   = New-Object System.Windows.Forms.TextBox
        $tb.Location          = '16,48'
        $tb.Width             = 470
        $tb.Text              = $Default
        $tb.Font              = New-Object System.Drawing.Font('Consolas',11)
        $form.Controls.Add($tb)

        $hint                 = New-Object System.Windows.Forms.Label
        $hint.AutoSize        = $true
        $hint.ForeColor       = [System.Drawing.Color]::DarkGray
        $hint.Text            = $ValidationHint
        $hint.Location        = '16,80'
        $form.Controls.Add($hint)

        $ok                   = New-Object System.Windows.Forms.Button
        $ok.Text              = 'Continue'
        $ok.Location          = '312,110'
        $ok.Width             = 80
        $ok.DialogResult      = [System.Windows.Forms.DialogResult]::OK
        $form.AcceptButton    = $ok
        $form.Controls.Add($ok)

        $cancel               = New-Object System.Windows.Forms.Button
        $cancel.Text          = 'Cancel'
        $cancel.Location      = '406,110'
        $cancel.Width         = 80
        $cancel.DialogResult  = [System.Windows.Forms.DialogResult]::Cancel
        $form.CancelButton    = $cancel
        $form.Controls.Add($cancel)

        $tb.add_TextChanged({
            try {
                if (& $ValidateScript $tb.Text) {
                    $tb.BackColor = [System.Drawing.Color]::White
                } else {
                    $tb.BackColor = [System.Drawing.Color]::MistyRose
                }
            } catch {
                $tb.BackColor = [System.Drawing.Color]::MistyRose
            }
        })

        $dialog = $form.ShowDialog()
        if ($dialog -ne [System.Windows.Forms.DialogResult]::OK) {
            return $null
        }

        $val = $tb.Text.Trim()
        if (-not (& $ValidateScript $val)) {
            [System.Windows.Forms.MessageBox]::Show(
                "Value is invalid. Please try again.",
                "Validation",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null

            return Show-InputDialog @PSBoundParameters
        }

        return $val
    }
    catch {
        $val = Read-Host "$Title - $Prompt"
        if (-not (& $ValidateScript $val)) {
            throw "Input failed validation."
        }
        return $val
    }
}

# =========================
# Login helper: CCP -> ServiceUser -> New-PASSession
# =========================
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving Service User credential from CCP..."
    Write-Info "CCP URL: $url"

    $headers = @{ 'Content-Type' = 'application/json' }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

function Start-PASSessionFromCCP {
    [CmdletBinding()]
    param()

    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud using Alliant Shared Services pattern..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Ok "PAS session established successfully."
}

# =========================
# Command / object helpers
# =========================
function Test-CommandHasParameter {
    param(
        [Parameter(Mandatory)][string]$CommandName,
        [Parameter(Mandatory)][string]$ParameterName
    )

    try {
        $cmd = Get-Command $CommandName -ErrorAction Stop
        return ($cmd.Parameters.Keys | Where-Object { $_ -ieq $ParameterName } | Measure-Object).Count -gt 0
    }
    catch {
        return $false
    }
}

function Get-FirstNonBlank {
    param([object[]]$Values)

    foreach ($v in $Values) {
        if ($null -ne $v) {
            $s = [string]$v
            if (-not [string]::IsNullOrWhiteSpace($s)) {
                return $s.Trim()
            }
        }
    }

    return $null
}

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string]$Name
    )

    $prop = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $Name } | Select-Object -First 1
    if ($prop) {
        return $prop.Value
    }

    return $null
}

function Convert-ToNullableBool {
    param([object]$Value)

    if ($null -eq $Value) {
        return $null
    }

    if ($Value -is [bool]) {
        return [bool]$Value
    }

    $text = ([string]$Value).Trim()

    switch -Regex ($text) {
        '^(?i:true|yes|y|1)$'  { return $true }
        '^(?i:false|no|n|0)$'  { return $false }
        default                { return $null }
    }
}

function Get-MemberPermissionValue {
    param(
        [Parameter(Mandatory)][object]$MemberObject,
        [Parameter(Mandatory)][string]$PermissionName
    )

    $raw = Get-ObjectPropertyValue -Object $MemberObject -Name $PermissionName
    return (Convert-ToNullableBool -Value $raw)
}

function Get-ExistingSafeMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    try {
        if (Test-CommandHasParameter -CommandName 'Get-PASSafeMember' -ParameterName 'MemberName') {
            try {
                $m = Get-PASSafeMember -SafeName $SafeName -MemberName $MemberName -ErrorAction Stop
                if ($m) { return $m }
            } catch { }
        }

        $all = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)

        $found = $all | Where-Object {
            ($_.MemberName -ieq $MemberName) -or
            ($_.memberName -ieq $MemberName) -or
            ($_.UserName   -ieq $MemberName)
        } | Select-Object -First 1

        return $found
    }
    catch {
        throw "Failed to retrieve members for safe '$SafeName': $($_.Exception.Message)"
    }
}

# =========================
# Permission update helper
# =========================
function Set-SafeMemberSpecifyNextAccountContentFalse {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    $permissionNames = @(
        'UseAccounts',
        'RetrieveAccounts',
        'ListAccounts',
        'AddAccounts',
        'UpdateAccountContent',
        'UpdateAccountProperties',
        'InitiateCPMAccountManagementOperations',
        'SpecifyNextAccountContent',
        'RenameAccounts',
        'DeleteAccounts',
        'UnlockAccounts',
        'ManageSafe',
        'ManageSafeMembers',
        'BackupSafe',
        'ViewAuditLog',
        'ViewSafeMembers',
        'AccessWithoutConfirmation',
        'CreateFolders',
        'DeleteFolders',
        'MoveAccountsAndFolders',
        'RequestsAuthorizationLevel1',
        'RequestsAuthorizationLevel2'
    )

    Write-Info "Processing Safe='$SafeName' Member='$MemberName'..."

    $existing = Get-ExistingSafeMember -SafeName $SafeName -MemberName $MemberName
    if (-not $existing) {
        throw "Member '$MemberName' was not found on safe '$SafeName'."
    }

    $setCmd = Get-Command Set-PASSafeMember -ErrorAction Stop
    $supportedParams = $setCmd.Parameters.Keys

    $updateSplat = @{
        SafeName   = $SafeName
        MemberName = $MemberName
    }

    foreach ($perm in $permissionNames) {
        $isSupported = ($supportedParams | Where-Object { $_ -ieq $perm } | Measure-Object).Count -gt 0
        if (-not $isSupported) {
            continue
        }

        $value = Get-MemberPermissionValue -MemberObject $existing -PermissionName $perm

        if ($perm -ieq 'SpecifyNextAccountContent') {
            $value = $false
        }

        if ($null -ne $value) {
            $updateSplat[$perm] = $value
        }
    }

    if (-not ($updateSplat.ContainsKey('SpecifyNextAccountContent'))) {
        throw "Local psPAS Set-PASSafeMember command does not expose SpecifyNextAccountContent parameter."
    }

    if ($PSCmdlet.ShouldProcess("$SafeName / $MemberName", "Set-PASSafeMember (SpecifyNextAccountContent = false)")) {
        Set-PASSafeMember @updateSplat -ErrorAction Stop | Out-Null
        Write-Ok "Updated '$MemberName' on '$SafeName' -> SpecifyNextAccountContent = false"
    }
}

# =========================
# Row processor
# =========================
function Process-Row {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    $safe = $SafeName.Trim()
    $member = $MemberName.Trim()

    if ([string]::IsNullOrWhiteSpace($safe) -or [string]::IsNullOrWhiteSpace($member)) {
        throw "SafeName or MemberName is blank."
    }

    Set-SafeMemberSpecifyNextAccountContentFalse -SafeName $safe -MemberName $member
}

# =========================
# MAIN
# =========================
$sessionCreated = $false
$runSummary = New-Object System.Collections.Generic.List[object]

try {
    Start-PASSessionFromCCP
    $sessionCreated = $true

    if ($Mode -eq 'CSV') {
        Write-Info "Mode = CSV"
        Write-Info "Loading CSV: $CsvPath"

        if (-not (Test-Path $CsvPath)) {
            throw "CSV not found: $CsvPath"
        }

        $rows = @(Import-Csv -Path $CsvPath)
        if ($rows.Count -eq 0) {
            throw "CSV '$CsvPath' contains no rows."
        }

        foreach ($row in $rows) {
            $safeName = Get-FirstNonBlank @(
                $row.SafeName,
                $row.Safename,
                $row.Safe
            )

            $memberName = Get-FirstNonBlank @(
                $row.MemberName,
                $row.Member,
                $row.SafeMember,
                $row.SafeOwner,
                $row.Owner,
                $row.UserName,
                $row.Email
            )

            try {
                Process-Row -SafeName $safeName -MemberName $memberName

                $runSummary.Add([pscustomobject]@{
                    SafeName    = $safeName
                    MemberName  = $memberName
                    Status      = 'OK'
                    Error       = ''
                }) | Out-Null
            }
            catch {
                $err = $_.Exception.Message
                Write-Err "Failed for Safe='$safeName' Member='$memberName' : $err"

                $runSummary.Add([pscustomobject]@{
                    SafeName    = $safeName
                    MemberName  = $memberName
                    Status      = 'FAILED'
                    Error       = $err
                }) | Out-Null

                continue
            }
        }
    }
    else {
        Write-Info "Mode = Single"

        $safeName = Show-InputDialog `
            -Title "Safe Name" `
            -Prompt "Enter Safe Name" `
            -Default "" `
            -ValidationHint "Example: IND_jdoe_12345" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $safeName) {
            Write-Warn "Cancelled (Safe Name)."
            return
        }

        $memberName = Show-InputDialog `
            -Title "Member Name" `
            -Prompt "Enter Safe Member Name" `
            -Default "" `
            -ValidationHint "Example: user@alliantcreditunion.com" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $memberName) {
            Write-Warn "Cancelled (Member Name)."
            return
        }

        Process-Row -SafeName $safeName -MemberName $memberName

        $runSummary.Add([pscustomobject]@{
            SafeName    = $safeName
            MemberName  = $memberName
            Status      = 'OK'
            Error       = ''
        }) | Out-Null
    }

    if ($runSummary.Count -gt 0) {
        $runSummary | Export-Csv -Path $ResultFile -NoTypeInformation -Encoding UTF8
        $okCount  = @($runSummary | Where-Object { $_.Status -eq 'OK' }).Count
        $badCount = @($runSummary | Where-Object { $_.Status -eq 'FAILED' }).Count
        Write-Ok "Completed. OK=$okCount FAILED=$badCount"
        Write-Ok "Result CSV: $ResultFile"
    }
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        }
        catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
