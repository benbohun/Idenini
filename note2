# AD discovery
# ==============================
function Get-DisabledADAdminUsers {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SearchBase,
        [Parameter(Mandatory)][string]$SamAccountPattern,
        [Parameter(Mandatory)][string]$ExportFile
    )

    Write-Info "Querying AD for disabled admin accounts..."
    Write-LogLine "Querying AD. SearchBase='$SearchBase'; SamAccountPattern='$SamAccountPattern'" "INFO"

    $users = Get-ADUser `
        -SearchBase $SearchBase `
        -Filter { Enabled -eq $false -and SamAccountName -like $SamAccountPattern } `
        -Properties SamAccountName, Name, DistinguishedName, Enabled |
    Select-Object SamAccountName, Name, DistinguishedName

    $users = @($users)

    $users | Export-Csv -Path $ExportFile -NoTypeInformation
    Write-LogLine "Exported disabled AD users to $ExportFile. Count=$($users.Count)" "SUCCESS"
    Write-Ok "Disabled AD admin accounts exported to: $ExportFile"

    return $users
}

# ==============================
# Account search / match logic
# ==============================
function Get-PCAccountsBySearch {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Search,
        [ValidateRange(1,5000)][int]$Limit = 1000,
        [ValidateRange(1,1000)][int]$PageSize = 100
    )

    $results = New-Object System.Collections.Generic.List[object]
    $offset  = 0
    $remaining = $Limit

    while ($remaining -gt 0) {
        $take = [Math]::Min($PageSize, $remaining)
        $encodedSearch = [System.Uri]::EscapeDataString($Search)
        $relativePath = "Accounts?search=$encodedSearch&searchType=contains&limit=$take&offset=$offset"

        $resp = Invoke-PCRequest -Method GET -RelativePath $relativePath
        $items = Convert-ToArray $resp

        foreach ($item in $items) {
            [void]$results.Add($item)
        }

        if ($items.Count -lt $take) {
            break
        }

        $offset += $take
        $remaining -= $take
    }

    return @($results)
}

function Find-MatchingPCAccountsForDisabledUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][int]$Limit,
        [Parameter(Mandatory)][int]$PageSize
    )

    Write-LogLine "Searching CyberArk accounts via REST for disabled AD user '$SamAccountName'" "INFO"

    $accounts = Get-PCAccountsBySearch -Search $SamAccountName -Limit $Limit -PageSize $PageSize

    $matches = New-Object System.Collections.Generic.List[object]
    $seen    = @{}

    foreach ($acct in $accounts) {
        if ($null -eq $acct) { continue }

        $id       = Get-PropValueCI -Object $acct -PropName 'id'
        $userName = Get-PropValueCI -Object $acct -PropName 'userName'
        $name     = Get-PropValueCI -Object $acct -PropName 'name'

        if ([string]::IsNullOrWhiteSpace($id)) { continue }
        if ($seen.ContainsKey($id)) { continue }

        $userMatch = Test-UsernameMatch -UserName $userName -SamAccountName $SamAccountName
        $nameMatch = Test-AccountNameMatch -AccountName $name -SamAccountName $SamAccountName

        if ($userMatch -or $nameMatch) {
            $seen[$id] = $true
            [void]$matches.Add($acct)
        }
    }

    Write-LogLine "Found $($matches.Count) matching CyberArk account(s) for '$SamAccountName'" "INFO"
    return @($matches)
}

function Find-TargetDuplicateAccount {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][string]$TargetSafeName,
        [Parameter(Mandatory)][int]$Limit,
        [Parameter(Mandatory)][int]$PageSize
    )

    $accounts = Get-PCAccountsBySearch -Search $SamAccountName -Limit $Limit -PageSize $PageSize

    foreach ($acct in $accounts) {
        $safeName = Get-PropValueCI -Object $acct -PropName 'safeName'
        $userName = Get-PropValueCI -Object $acct -PropName 'userName'
        $name     = Get-PropValueCI -Object $acct -PropName 'name'

        if ($safeName -ieq $TargetSafeName) {
            if ((Test-UsernameMatch -UserName $userName -SamAccountName $SamAccountName) -or
                (Test-AccountNameMatch -AccountName $name -SamAccountName $SamAccountName)) {
                return $acct
            }
        }
    }

    return $null
}

# ==============================
# Secret retrieval / recreate / delete
# ==============================
function Get-AccountSecretValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$AccountID,
        [string]$Reason = "",
        [string]$TicketingSystem = "",
        [string]$TicketId = ""
    )

    $params = @{
        AccountID = $AccountID
    }

    if (-not [string]::IsNullOrWhiteSpace($Reason)) {
        $params['Reason'] = $Reason
    }
    if (-not [string]::IsNullOrWhiteSpace($TicketingSystem)) {
        $params['TicketingSystem'] = $TicketingSystem
    }
    if (-not [string]::IsNullOrWhiteSpace($TicketId)) {
        $params['TicketId'] = $TicketId
    }

    $secretResp = Get-PASAccountPassword @params

    if ($secretResp -is [string]) {
        return $secretResp
    }

    foreach ($propName in @('Content','Password','Secret','password','secret')) {
        $val = Get-PropValueCI -Object $secretResp -PropName $propName
        if (-not [string]::IsNullOrWhiteSpace($val)) {
            return [string]$val
        }
    }

    $stringified = [string]$secretResp
    if (-not [string]::IsNullOrWhiteSpace($stringified)) {
        return $stringified
    }

    throw "Unable to normalize password retrieval response for account '$AccountID'."
}

function New-TargetAccountBody {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]$SourceAccount,
        [Parameter(Mandatory)][string]$Secret,
        [Parameter(Mandatory)][string]$TargetSafeName,
        [Parameter(Mandatory)][string]$TargetPlatformID,
        [Parameter(Mandatory)][string]$ManualReason
    )

    $body = @{
        name       = Get-PropValueCI -Object $SourceAccount -PropName 'name'
        address    = Get-PropValueCI -Object $SourceAccount -PropName 'address'
        userName   = Get-PropValueCI -Object $SourceAccount -PropName 'userName'
        platformId = $TargetPlatformID
        safeName   = $TargetSafeName
        secretType = (Get-PropValueCI -Object $SourceAccount -PropName 'secretType')
        secret     = $Secret
        secretManagement = @{
            automaticManagementEnabled = $false
            manualManagementReason     = $ManualReason
        }
    }

    if ([string]::IsNullOrWhiteSpace($body.secretType)) {
        $body.secretType = 'password'
    }

    $rma = Get-PropValueCI -Object $SourceAccount -PropName 'remoteMachinesAccess'
    if ($null -ne $rma) {
        $remoteMachines = Get-PropValueCI -Object $rma -PropName 'remoteMachines'
        $restricted     = Get-PropValueCI -Object $rma -PropName 'accessRestrictedToRemoteMachines'

        if (-not [string]::IsNullOrWhiteSpace($remoteMachines) -or $null -ne $restricted) {
            $body['remoteMachinesAccess'] = @{
                remoteMachines                   = $remoteMachines
                accessRestrictedToRemoteMachines = [bool]$restricted
            }
        }
    }

    return $body
}

function New-DisabledAccountCopyInTargetSafe {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)]$SourceAccount,
        [Parameter(Mandatory)][string]$Secret,
        [Parameter(Mandatory)][string]$TargetSafeName,
        [Parameter(Mandatory)][string]$TargetPlatformID,
        [Parameter(Mandatory)][string]$ManualReason
    )

    $sourceId   = Get-PropValueCI -Object $SourceAccount -PropName 'id'
    $sourceName = Get-PropValueCI -Object $SourceAccount -PropName 'name'
    $sourceUser = Get-PropValueCI -Object $SourceAccount -PropName 'userName'
    $display    = "{0} | {1} | {2}" -f $sourceId, $sourceName, $sourceUser

    $body = New-TargetAccountBody `
        -SourceAccount $SourceAccount `
        -Secret $Secret `
        -TargetSafeName $TargetSafeName `
        -TargetPlatformID $TargetPlatformID `
        -ManualReason $ManualReason

    if ($PSCmdlet.ShouldProcess($display, "Create replacement account in safe '$TargetSafeName' on platform '$TargetPlatformID'")) {
        return Invoke-PCRequest -Method POST -RelativePath "Accounts/" -Body $body
    }

    return $null
}

function Remove-SourceAccountAfterCopy {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$AccountID,
        [Parameter(Mandatory)][string]$DisplayName
    )

    if ($PSCmdlet.ShouldProcess($DisplayName, "Delete source account")) {
        $null = Invoke-PCRequest -Method DELETE -RelativePath ("Accounts/{0}/" -f $AccountID)
    }
}

# ==============================
# Main
# ==============================
Ensure-Directory -Path $ExportRoot
"" | Set-Content -Path $LogFilePath

Write-Info "Disabled AD -> CyberArk move script starting..."
Write-LogLine "Script started." "INFO"
Write-LogLine "TargetSafeName='$TargetSafeName'; TargetPlatformID='$TargetPlatformID'; SkipDeleteSource='$($SkipDeleteSource.IsPresent)'" "INFO"

$results = New-Object System.Collections.Generic.List[object]

try {
    # AD export
    $disabledUsers = Get-DisabledADAdminUsers `
        -SearchBase $SearchBase `
        -SamAccountPattern $SamAccountPattern `
        -ExportFile $DisabledUsersCsv

    if (-not $disabledUsers -or $disabledUsers.Count -eq 0) {
        Write-WarnLine "No disabled AD admin accounts found."
        Write-LogLine "No disabled AD accounts found. Exiting." "WARN"
        @() | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        Write-Ok "Empty status report exported to: $StatusCsvPath"
        return
    }

    Write-Info ("Found {0} disabled AD account(s)." -f $disabledUsers.Count)

    # Authenticate to CyberArk
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Connect-PCloudWithServiceUser `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -ServiceCred       $serviceCred

    # Validate target safe/platform after auth
    Assert-TargetSafeAccessible -SafeName $TargetSafeName
    Assert-TargetPlatformVisible -PlatformID $TargetPlatformID

    $i = 0
    foreach ($user in $disabledUsers) {
        $i++
        $sam  = $user.SamAccountName
        $name = $user.Name
        $dn   = $user.DistinguishedName

        Write-Info ("[{0}/{1}] Processing disabled AD user: {2}" -f $i, $disabledUsers.Count, $sam)
        Write-LogLine "Processing disabled AD user '$sam'" "INFO"

        try {
            $matches = Find-MatchingPCAccountsForDisabledUser `
                -SamAccountName $sam `
                -Limit $AccountSearchLimit `
                -PageSize $PageSize

            if (-not $matches -or $matches.Count -eq 0) {
                $msg = "No matching CyberArk accounts found."
                Write-WarnLine "$sam -> $msg"
                Write-LogLine "$sam -> $msg" "WARN"

                [void]$results.Add([pscustomobject]@{
                    ADSamAccountName     = $sam
                    ADName               = $name
                    ADDistinguishedName  = $dn
                    SourceAccountID      = $null
                    SourceSafe           = $null
                    SourcePlatformID     = $null
                    TargetAccountID      = $null
                    TargetSafe           = $TargetSafeName
                    TargetPlatformID     = $TargetPlatformID
                    Status               = "NoMatch"
                    Message              = $msg
                })
                continue
            }

            foreach ($acct in $matches) {
                $sourceId       = Get-PropValueCI -Object $acct -PropName 'id'
                $sourceName     = Get-PropValueCI -Object $acct -PropName 'name'
                $sourceUserName = Get-PropValueCI -Object $acct -PropName 'userName'
                $sourceAddress  = Get-PropValueCI -Object $acct -PropName 'address'
                $sourceSafe     = Get-PropValueCI -Object $acct -PropName 'safeName'
                $sourcePlatform = Get-PropValueCI -Object $acct -PropName 'platformId'
                $sourceDisplay  = "{0} | {1} | {2} | {3}" -f $sourceId, $sourceName, $sourceUserName, $sourceAddress

                if (($sourceSafe -ieq $TargetSafeName) -and ($sourcePlatform -ieq $TargetPlatformID)) {
                    $msg = "Already in target safe/platform."
                    Write-Info ("{0} -> {1}" -f $sourceId, $msg)
                    Write-LogLine "$sourceId already in target safe/platform." "INFO"

                    [void]$results.Add([pscustomobject]@{
                        ADSamAccountName     = $sam
                        ADName               = $name
                        ADDistinguishedName  = $dn
                        SourceAccountID      = $sourceId
                        SourceSafe           = $sourceSafe
                        SourcePlatformID     = $sourcePlatform
                        TargetAccountID      = $sourceId
                        TargetSafe           = $TargetSafeName
                        TargetPlatformID     = $TargetPlatformID
                        Status               = "AlreadyCompliant"
                        Message              = $msg
                    })
                    continue
                }

                $existingTarget = Find-TargetDuplicateAccount `
                    -SamAccountName $sam `
                    -TargetSafeName $TargetSafeName `
                    -Limit 250 `
                    -PageSize $PageSize

                if ($null -ne $existingTarget) {
                    $targetExistingId = Get-PropValueCI -Object $existingTarget -PropName 'id'
                    $msg = "A matching target account already exists in '$TargetSafeName'. Source account not deleted."
                    Write-WarnLine ("{0} -> {1}" -f $sourceId, $msg)
                    Write-LogLine "$sourceId target duplicate exists as $targetExistingId. Skipping create/delete." "WARN"

                    [void]$results.Add([pscustomobject]@{
                        ADSamAccountName     = $sam
                        ADName               = $name
                        ADDistinguishedName  = $dn
                        SourceAccountID      = $sourceId
                        SourceSafe           = $sourceSafe
                        SourcePlatformID     = $sourcePlatform
                        TargetAccountID      = $targetExistingId
                        TargetSafe           = $TargetSafeName
                        TargetPlatformID     = $TargetPlatformID
                        Status               = "TargetAlreadyExists"
                        Message              = $msg
                    })
                    continue
                }

                Write-LogLine "Retrieving password for source account '$sourceId'" "INFO"
                $secret = Get-AccountSecretValue `
                    -AccountID $sourceId `
                    -Reason $PasswordReason `
                    -TicketingSystem $TicketingSystem `
                    -TicketId $TicketId

                if ([string]::IsNullOrWhiteSpace($secret)) {
                    throw "Password retrieval returned an empty secret for source account '$sourceId'."
                }

                $manualReason = "{0} Disabled AD account detected: {1}." -f $ManualManagementReason.TrimEnd('.'), $sam

                $newAccount = New-DisabledAccountCopyInTargetSafe `
                    -SourceAccount $acct `
                    -Secret $secret `
                    -TargetSafeName $TargetSafeName `
                    -TargetPlatformID $TargetPlatformID `
                    -ManualReason $manualReason `
                    -WhatIf:$WhatIfPreference

                $newAccountId = $null
                if ($null -ne $newAccount) {
                    $newAccountId = Get-PropValueCI -Object $newAccount -PropName 'id'
                }

                if ($WhatIfPreference) {
                    $msg = "WhatIf only. Replacement account would be created in '$TargetSafeName' with platform '$TargetPlatformID'."
                    Write-Info ("{0} -> {1}" -f $sourceId, $msg)
                    Write-LogLine "$sourceId WhatIf create target." "INFO"

                    [void]$results.Add([pscustomobject]@{
                        ADSamAccountName     = $sam
                        ADName               = $name
                        ADDistinguishedName  = $dn
                        SourceAccountID      = $sourceId
                        SourceSafe           = $sourceSafe
                        SourcePlatformID     = $sourcePlatform
                        TargetAccountID      = $newAccountId
                        TargetSafe           = $TargetSafeName
                        TargetPlatformID     = $TargetPlatformID
                        Status               = "WhatIf"
                        Message              = $msg
                    })
                    continue
                }

                Write-Ok ("{0} -> created replacement account in safe '{1}' on platform '{2}'." -f $sourceId, $TargetSafeName, $TargetPlatformID)
                Write-LogLine "$sourceId target account created successfully. NewAccountID='$newAccountId'" "SUCCESS"

                if (-not $SkipDeleteSource.IsPresent) {
                    Remove-SourceAccountAfterCopy `
                        -AccountID $sourceId `
                        -DisplayName $sourceDisplay `
                        -WhatIf:$WhatIfPreference

                    Write-Ok ("{0} -> source account deleted after successful target creation." -f $sourceId)
                    Write-LogLine "$sourceId source account deleted after target create." "SUCCESS"

                    [void]$results.Add([pscustomobject]@{
                        ADSamAccountName     = $sam
                        ADName               = $name
                        ADDistinguishedName  = $dn
                        SourceAccountID      = $sourceId
                        SourceSafe           = $sourceSafe
                        SourcePlatformID     = $sourcePlatform
                        TargetAccountID      = $newAccountId
                        TargetSafe           = $TargetSafeName
                        TargetPlatformID     = $TargetPlatformID
                        Status               = "Moved"
                        Message              = "Replacement account created in target safe/platform and source account deleted."
                    })
                }
                else {
                    $msg = "Replacement account created in target safe/platform. Source account retained because SkipDeleteSource was specified."
                    Write-WarnLine ("{0} -> {1}" -f $sourceId, $msg)
                    Write-LogLine "$sourceId target created; source retained by request." "WARN"

                    [void]$results.Add([pscustomobject]@{
                        ADSamAccountName     = $sam
                        ADName               = $name
                        ADDistinguishedName  = $dn
                        SourceAccountID      = $sourceId
                        SourceSafe           = $sourceSafe
                        SourcePlatformID     = $sourcePlatform
                        TargetAccountID      = $newAccountId
                        TargetSafe           = $TargetSafeName
                        TargetPlatformID     = $TargetPlatformID
                        Status               = "CreatedTargetOnly"
                        Message              = $msg
                    })
                }
            }
        }
        catch {
            $err = $_.Exception.Message
            Write-Err ("{0} -> Failed: {1}" -f $sam, $err)
            Write-LogLine "$sam failed: $err" "ERROR"

            [void]$results.Add([pscustomobject]@{
                ADSamAccountName     = $sam
                ADName               = $name
                ADDistinguishedName  = $dn
                SourceAccountID      = $null
                SourceSafe           = $null
                SourcePlatformID     = $null
                TargetAccountID      = $null
                TargetSafe           = $TargetSafeName
                TargetPlatformID     = $TargetPlatformID
                Status               = "Failed"
                Message              = $err
            })
        }
    }
}
catch {
    $fatal = $_.Exception.Message
    Write-Err "Fatal error: $fatal"
    Write-LogLine "Fatal error: $fatal" "ERROR"
    throw
}
finally {
    try {
        if ($results.Count -gt 0) {
            $results | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        }
        else {
            @() | Export-Csv -Path $StatusCsvPath -NoTypeInformation
        }

        Write-Ok "Status report exported to: $StatusCsvPath"
        Write-LogLine "Status report exported to: $StatusCsvPath" "SUCCESS"
    }
    catch {
        Write-Err "Failed to export status CSV: $($_.Exception.Message)"
        Write-LogLine "Failed to export status CSV: $($_.Exception.Message)" "ERROR"
    }

    try {
        Close-PASSession | Out-Null
        Write-LogLine "PAS session closed." "INFO"
    }
    catch {
        Write-LogLine "Close-PASSession skipped or failed: $($_.Exception.Message)" "WARN"
    }

    Write-Info "Completed."
    Write-LogLine "Script completed." "INFO"
}
