# ============================================================

function Update-ExistingAccountPlatformIfPossible {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][object]$Account,
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address
    )

    $currentPlatform = Get-PASAccountPlatformValue -AccountObject $Account

    if ($currentPlatform -eq $PlatformID) {
        Write-Ok "Existing account '$UserName' in safe '$SafeName' is already on platform '$PlatformID'."
        return "EXISTS_PLATFORM_OK"
    }

    $accountId = Get-PASAccountIdValue -AccountObject $Account

    if ([string]::IsNullOrWhiteSpace($accountId)) {
        Write-Warn "Existing account '$UserName' found, but AccountID could not be resolved. Platform validation only. CurrentPlatform='$currentPlatform'."
        return "EXISTS_PLATFORM_UNKNOWN"
    }

    if ([string]::IsNullOrWhiteSpace($currentPlatform)) {
        Write-Warn "Existing account '$UserName' found, but current platform was not returned by API. AccountID=$accountId."
    } else {
        Write-Warn "Existing account '$UserName' found on platform '$currentPlatform'. Target platform is '$PlatformID'."
    }

    $canSetPlatform = (Test-CommandHasParameter -CommandName "Set-PASAccount" -ParameterName "AccountID") -and
                      (Test-CommandHasParameter -CommandName "Set-PASAccount" -ParameterName "PlatformID")

    if (-not $canSetPlatform) {
        Write-Warn "Set-PASAccount in this psPAS version does not expose AccountID + PlatformID parameters. Platform was not changed."
        return "EXISTS_PLATFORM_NOT_CHANGED"
    }

    $setSplat = @{
        AccountID  = $accountId
        PlatformID = $PlatformID
    }

    if ($PSCmdlet.ShouldProcess("$SafeName/$UserName [$accountId]", "Set-PASAccount PlatformID=$PlatformID")) {
        try {
            Set-PASAccount @setSplat -ErrorAction Stop | Out-Null
            Write-Ok "Updated existing account '$UserName' platform to '$PlatformID'."
            return "EXISTS_PLATFORM_UPDATED"
        } catch {
            Write-Warn "Failed to update existing account '$UserName' platform to '$PlatformID': $($_.Exception.Message)"
            return "EXISTS_PLATFORM_UPDATE_FAILED"
        }
    }

    return "WHATIF_PLATFORM_UPDATE"
}

function Add-WINRemovedAccount {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address,
        [Parameter()][string]$Secret = ""
    )

    $result = [ordered]@{
        UserName = $UserName
        Address  = $Address
        Platform = $PlatformID
        Status   = ""
        Error    = ""
    }

    if ([string]::IsNullOrWhiteSpace($SafeName) -or
        [string]::IsNullOrWhiteSpace($UserName) -or
        [string]::IsNullOrWhiteSpace($Address)) {

        $result.Status = "SKIPPED_MISSING_FIELD"
        $result.Error  = "SafeName, UserName, or Address is blank."

        Write-Warn "Account onboarding skipped because SafeName, UserName, or Address is blank."
        return [pscustomobject]$result
    }

    Write-Info "Checking whether account '$UserName' already exists in safe '$SafeName' with address '$Address'..."

    $existingAcct = $null

    try {
        $existingAcct = Get-PASAccount -SafeName $SafeName -Search $UserName -ErrorAction SilentlyContinue |
            Where-Object {
                ($_.UserName -eq $UserName -or $_.username -eq $UserName) -and
                ($_.Address -eq $Address -or $_.address -eq $Address)
            } |
            Select-Object -First 1
    } catch {
        Write-Warn "Account lookup warning for '$UserName' in safe '$SafeName': $($_.Exception.Message)"
    }

    if ($existingAcct) {
        $platformStatus = Update-ExistingAccountPlatformIfPossible `
            -Account  $existingAcct `
            -SafeName $SafeName `
            -UserName $UserName `
            -Address  $Address

        $result.Status = $platformStatus
        return [pscustomobject]$result
    }

    $acctSplat = @{
        SafeName   = $SafeName
        PlatformID = $PlatformID
        Address    = $Address
        UserName   = $UserName
    }

    $effectiveSecret = $Secret
    if ([string]::IsNullOrWhiteSpace($effectiveSecret) -and -not [string]::IsNullOrWhiteSpace($DefaultInitialPassword)) {
        $effectiveSecret = $DefaultInitialPassword
    }

    if (-not [string]::IsNullOrWhiteSpace($effectiveSecret)) {
        if (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "SecretType") {
            $acctSplat["SecretType"] = "Password"
        }

        if (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Secret") {
            $acctSplat["Secret"] = $effectiveSecret
        } elseif (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Password") {
            $acctSplat["Password"] = $effectiveSecret
        } elseif (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Content") {
            $acctSplat["Content"] = $effectiveSecret
        } else {
            Write-Warn "A password/secret was supplied, but this psPAS Add-PASAccount version does not expose Secret, Password, or Content parameter."
        }
    }

    Write-Info "Onboarding disabled account '$UserName' to safe '$SafeName' using platform '$PlatformID'..."

    if ($PSCmdlet.ShouldProcess("$SafeName/$UserName", "Add-PASAccount PlatformID=$PlatformID")) {
        try {
            Add-PASAccount @acctSplat -ErrorAction Stop | Out-Null

            $result.Status = "ONBOARDED"
            Write-Ok "Onboarded disabled account '$UserName' into safe '$SafeName' with platform '$PlatformID'."

            return [pscustomobject]$result
        } catch {
            $result.Status = "FAILED_ONBOARD"
            $result.Error  = $_.Exception.Message

            Write-Err "Failed to onboard account '$UserName' into safe '$SafeName': $($_.Exception.Message)"
            return [pscustomobject]$result
        }
    }

    $result.Status = "WHATIF_ONBOARD"
    return [pscustomobject]$result
}

# ============================================================
# Row Processor
# ============================================================

function Process-DisabledADRow {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][int]$RowNumber
    )

    $sam   = Get-RowValue -Row $Row -Names @("Samaccountname", "SamAccountName", "SAM", "OwnerSam", "OwnerSamAccountName")
    $eid   = Get-RowValue -Row $Row -Names @("employeeID", "EmployeeID", "EmployeeId", "EmpID")
    $email = Get-RowValue -Row $Row -Names @("email", "Email", "OwnerEmail", "UPN", "OwnerUPN")

    $rawAddress = Get-RowValue -Row $Row -Names @("Address", "Domain", "AdminAddressDomain", "AccountAddress", "AccountDomain")
    $address    = Normalize-Address -RawAddress $rawAddress

    $safeName   = Resolve-SafeName -Row $Row
    $userName   = Resolve-AccountUserName -Row $Row -Address $address

    $secret     = Get-RowValue -Row $Row -Names @("Password", "Secret", "InitialPassword", "Content")

    Write-Info "============================================================"
    Write-Info "Row $RowNumber | Safe='$safeName' | Account='$userName' | Address='$address'"

    $summary = [ordered]@{
        RowNumber       = $RowNumber
        Samaccountname  = $sam
        EmployeeID      = $eid
        OwnerEmail      = $email
        SafeName        = $safeName
        Address         = $address
        UserName        = $userName
        PlatformID      = $PlatformID
        SafeStatus      = ""
        MemberStatus    = ""
        AccountStatus   = ""
        OverallStatus   = ""
        Error           = ""
    }

    try {
        $safeResult = Ensure-TargetSafe `
            -SafeName       $safeName `
            -SamAccountName $sam `
            -EmployeeID     $eid `
            -OwnerEmail     $email

        $summary.SafeStatus = $safeResult.Status

        if (-not $safeResult.Ready) {
            $summary.OverallStatus = "FAILED_SAFE_NOT_READY"
            $summary.Error = $safeResult.Error
            return [pscustomobject]$summary
        }

        if (-not $SkipSafeMemberUpdate) {
            $memberErrors = New-Object System.Collections.Generic.List[string]

            $adminPerms = Get-AdminPerms
            $ownerPerms = Get-OwnerPerms

            Write-Info "Ensuring admin group membership on safe '$safeName'..."

            $okAdmin = Ensure-SafeMember `
                -SafeName   $safeName `
                -MemberName $AdminGroupUPN `
                -MemberType Group `
                -PermFlags  $adminPerms

            if (-not $okAdmin) {
                Write-Warn "Retrying admin group using SAM '$AdminGroupSAM'..."
                $okAdmin = Ensure-SafeMember `
                    -SafeName   $safeName `
                    -MemberName $AdminGroupSAM `
                    -MemberType Group `
                    -PermFlags  $adminPerms
            }

            if (-not $okAdmin) {
                $memberErrors.Add("Admin group membership failed") | Out-Null
            }

            if (-not [string]::IsNullOrWhiteSpace($email)) {
                Write-Info "Ensuring owner membership '$email' on safe '$safeName'..."

                $okOwner = Ensure-SafeMember `
                    -SafeName   $safeName `
                    -MemberName $email `
                    -MemberType User `
                    -PermFlags  $ownerPerms

                if (-not $okOwner -and $email -like "*@*") {
                    $ownerSam = $email.Split("@")[0]
                    Write-Warn "Retrying owner membership using SAM '$ownerSam'..."

                    $okOwner = Ensure-SafeMember `
                        -SafeName   $safeName `
                        -MemberName $ownerSam `
                        -MemberType User `
                        -PermFlags  $ownerPerms
                }

                if (-not $okOwner) {
                    $memberErrors.Add("Owner membership failed") | Out-Null
                }
            } else {
                Write-Warn "Owner email is blank. Owner membership skipped."
            }

            if ($memberErrors.Count -eq 0) {
                $summary.MemberStatus = "OK"
            } else {
                $summary.MemberStatus = ($memberErrors -join "; ")
            }
        } else {
            $summary.MemberStatus = "SKIPPED"
        }

        $acctResult = Add-WINRemovedAccount `
            -SafeName $safeName `
            -UserName $userName `
            -Address  $address `
            -Secret   $secret

        $summary.AccountStatus = $acctResult.Status

        if ($acctResult.Error) {
            $summary.Error = $acctResult.Error
        }

        if ($acctResult.Status -like "FAILED*") {
            $summary.OverallStatus = "FAILED"
        } elseif ($summary.MemberStatus -like "*failed*") {
            $summary.OverallStatus = "COMPLETED_WITH_MEMBER_WARNING"
        } else {
            $summary.OverallStatus = "OK"
        }

        Write-Ok "Completed row $RowNumber | Safe='$safeName' | Account='$userName' | Status='$($summary.OverallStatus)'"

        return [pscustomobject]$summary
    } catch {
        $summary.OverallStatus = "FAILED_EXCEPTION"
        $summary.Error = $_.Exception.Message

        Write-Err "Row $RowNumber failed: $($_.Exception.Message)"
        return [pscustomobject]$summary
    }
}

# ============================================================
# MAIN
# ============================================================

$sessionCreated = $false
$runSummary = New-Object System.Collections.Generic.List[object]

try {
    Write-Info "Disabled AD -> WIN_Removed onboarding script starting..."
    Write-Info "CSV Path       : $CsvPath"
    Write-Info "Report Folder  : $ReportFolder"
    Write-Info "Target Platform: $PlatformID"

    if (-not (Test-Path $CsvPath)) {
        throw "CSV not found: $CsvPath"
    }

    $rows = @(Import-Csv -Path $CsvPath)

    Validate-CsvInput -Rows $rows

    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via Identity ServiceUser..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) {
        throw "psPAS session was not established."
    }

    $sessionCreated = $true

    Write-Ok "Authenticated to Privilege Cloud as service user: $($serviceCred.UserName)"

    $rowNumber = 0

    foreach ($row in $rows) {
        $rowNumber++

        $rowResult = Process-DisabledADRow -Row $row -RowNumber $rowNumber
        $runSummary.Add($rowResult) | Out-Null
    }

    $runSummary | Export-Csv -Path $script:ReportPath -NoTypeInformation -Encoding UTF8

    $okCount     = @($runSummary | Where-Object { $_.OverallStatus -eq "OK" }).Count
    $warnCount   = @($runSummary | Where-Object { $_.OverallStatus -like "*WARNING*" }).Count
    $failedCount = @($runSummary | Where-Object { $_.OverallStatus -like "FAILED*" }).Count
    $totalCount  = $runSummary.Count

    Write-Info "============================================================"
    Write-Ok "Processing completed."
    Write-Ok "Total rows : $totalCount"
    Write-Ok "OK         : $okCount"
    Write-Warn "Warnings   : $warnCount"
    Write-Err "Failed     : $failedCount"
    Write-Ok "Report     : $script:ReportPath"
    Write-Ok "Log        : $script:LogPath"
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off from Privilege Cloud."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
