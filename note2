public String createAdminAccountSafe(SailPointContext context, String identityName,
			String cyberArkappName, String targetName) {
		ProvisioningPlan plan = new ProvisioningPlan();
		ProvisioningResult result = null;
		String status= null;
 
		Identity identity = context.getObjectByName(Identity.class, identityName);

 
		
 
		String owner = "ownername";
		String safeName = "PPA_" + owner;
 
		logger.debug("Safe: " + safeName);
 
		logger.debug(" ENTER buildCreateSafePlan ");
 
		ProvisioningPlan p = new ProvisioningPlan();
 
		ProvisioningPlan.ObjectRequest req = new ProvisioningPlan.ObjectRequest();
		req.setApplication(cyberArkappName);
		p.setTargetIntegration(targetName);
		req.setTargetIntegration(cyberArkappName);
		req.setNativeIdentity(safeName);
		req.setOp(ProvisioningPlan.ObjectOperation.Create);
		req.setType("Container");
 
		req.add(new AttributeRequest("name", ProvisioningPlan.Operation.Set, safeName));
		req.add(new AttributeRequest("displayName", ProvisioningPlan.Operation.Set, safeName));
 
		req.add(new AttributeRequest("description", ProvisioningPlan.Operation.Set,
				"Personal safe for " + owner + " admin account"));
		req.add(new AttributeRequest("owner.value", ProvisioningPlan.Operation.Set, owner));
		req.add(new AttributeRequest("NumberOfDaysRetention", ProvisioningPlan.Operation.Set, 14));
		req.add(new AttributeRequest("resourceType", ProvisioningPlan.Operation.Set, "Container")); // CPC required
		req.add(new AttributeRequest("ManagingCPM", ProvisioningPlan.Operation.Set,"CPM_VALUE")); // CPC
 
		p.add(req);
 
		logger.debug("buildCreateSafePlan: Done");
		logger.debug("Create Safe Plan: " + p.toXml());
 
		// return req;
 
		try {
			// Execute plan for provisioning
			Attributes attrs = new Attributes();
			attrs.put("noApplicationTemplates", true);
			attrs.put("noCreateTemplates", true);
 
			Provisioner pr = new Provisioner(context, attrs);
			pr.setArgument(PlanCompiler.ARG_NO_FILTERING, true);
 
			//pr.setOptimisticProvisioning(true);
			ProvisioningProject pp = pr.compile(p);
			//System.out.println("Plan: " + p.toXml());
			pr.execute(pp);
			//System.out.println("Project: " + pp.toXml());
 
			if(pp.getPlans("CyberArk Privilege Cloud")!=null){
				for(ProvisioningPlan np : pp.getPlans("CyberArk Privilege Cloud")){
					//System.out.println("np: " + np.toXml());
					if(np.getObjectRequests()!=null){
						for(ObjectRequest objectRequest : np.getObjectRequests()){
							if(objectRequest!= null && objectRequest.getResult()!=null)
							{
								result = objectRequest.getResult();
								log.debug("createSafe  return : "+result);
							}
						}
					}
				}
			}				
			if(result != null){
				status = result.getStatus();
			}
		} catch (Exception e) {			
			logger.error("Exception thrown: " + e.toString());
			return "Failed";
		}
		return status;
	}
	public String addAdminPrivilegeData(SailPointContext context, String identityName, String cyberArkappName,
			String containerName, String targetName, String privilegedDataName, String password, String domainName) {
			ProvisioningResult result = null;
			String status= null;
			String plaformId="";
 
		try {
			Map map = new HashMap();
			String customObjectName = "CyberArk Default User and Group Mapping";
			Custom customObject = context.getObjectByName(Custom.class, customObjectName);
			if (customObject != null){
				Map map = (Map)customObject.get("platformDetails");	
				plaformId = (String)map.get(domainName);
			}
 
			String nativeIdentity = domainName+"-" + privilegedDataName;
 
			ProvisioningPlan plan = new ProvisioningPlan();
			// plan.setTargetIntegration(cyberArkappName);
 
			ObjectRequest objReq = new ObjectRequest();
 
			objReq.setApplication(cyberArkappName);
			objReq.setNativeIdentity(nativeIdentity);
			objReq.setOp(ProvisioningPlan.ObjectOperation.Create);
			objReq.setType("PrivilegedData");
 
			logger.debug("name: " + domainName + "-" + privilegedDataName);
			objReq.add(new AttributeRequest("name", ProvisioningPlan.Operation.Set,
					domainName+"-" + privilegedDataName));
 
			
			objReq.add(new AttributeRequest("type", ProvisioningPlan.Operation.Set, "password"));
 
			logger.debug("containerName: " + containerName);
			// objReq.add(new AttributeRequest("safe", ProvisioningPlan.Operation.Set,
			// safeName));
			objReq.add(new AttributeRequest("safe", ProvisioningPlan.Operation.Set, containerName));
 
			
			// setup Privileged Item properties, maybe to use custom mappings
			List<Map> listProps = new ArrayList();
			map = new HashMap();
			map.put("key", "username");
			map.put("value", privilegedDataName);
			listProps.add(map);
 
			map = new HashMap();
			map.put("key", "platformId");
			map.put("value", plaformId);
			listProps.add(map);
 
			map = new HashMap();
			map.put("key", "address");
			map.put("value", domainName);
			listProps.add(map);
 
			map = new HashMap();
			map.put("key", "secret");
			map.put("value", password);
			listProps.add(map);
 
			
			objReq.add(new AttributeRequest("properties", ProvisioningPlan.Operation.Set, listProps));
 
			plan.add(objReq);
 
			// NO FILTERING otherwise type and description get filtered out
			plan.put("noFiltering", Boolean.TRUE);
 
			logger.debug("plan: " + plan.toXml());
			logger.debug("End Add PrivilegedDat to Safe Rule");
 
			String app = objReq.getApplicationName();
 
			logger.debug("app : " + app);
 
			// return plan;
 
			// Execute plan for provisioning
			Attributes attrs = new Attributes();
			attrs.put("noApplicationTemplates", true);
			attrs.put("noCreateTemplates", true);
 
			Provisioner pr = new Provisioner(context, attrs);
			pr.setArgument(PlanCompiler.ARG_NO_FILTERING, true);
 
			//pr.setOptimisticProvisioning(true);
			ProvisioningProject pp = pr.compile(plan);
			//System.out.println("Plan: " + plan.toXml());
			pr.execute(pp);
			//System.out.println("Project: " + pp.toXml());
 
			if(pp.getPlans(cyberArkappName)!=null){
				for(ProvisioningPlan np : pp.getPlans(cyberArkappName)){
					//System.out.println("np: " + np.toXml());
					if(np.getObjectRequests()!=null){						
						for(ObjectRequest objectRequest : np.getObjectRequests()){
							if(objectRequest!= null && objectRequest.getResult()!=null)
							{
								result = objectRequest.getResult();
								//System.out.println("result: " + result.toXml());
								log.debug("addAdminPrivilegeData  return : "+result);
							}
						}
					}
				}
			}
				if(result != null){
					status = result.getStatus();
				}
 
			
 
		} catch (Exception e) {
			logger.error("Exception thrown: " + e.toString());
			return "Failed";
		}
		return status;
	}		
