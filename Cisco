[states]
# Initialization
Init=(script)set bTarget 0; set verifyLogon 0; set curr_pass "<pmpass>";

# Default Type resolver (base 'Type' optional; default to ciscouser)
InitSetTypeVar=(script)if {[string equal -nocase "<Type>" ""]} { set TypeVar "ciscouser" } else { set TypeVar "<Type>" }

InitCiscoEnable=(script)set enable_pass "<pmpass>";
InitCiscoUser=(script)set enable_pass "<pmextrapass1>";
InitCiscoTerminal=(script)set enable_pass "<pmextrapass1>";

CheckLoginVars
# Use Logon Account (Ext2) creds but base device address/port
InitLoginFromLoginObj=(script)set bTarget 0; set login_pass "<pmextrapass2>"; set login_user "<extrapass2\\username>"; set login_address "<address>"; set login_port "<port>";
InitLoginFromOrigObj=(script)set bTarget 1; set login_pass "<pmpass>"; set login_user "<username>"; set login_address "<address>"; set login_port "<port>";

# Ensure default port if blank
SetDefaultPortIfEmpty=(script)if {[string equal -nocase "$login_port" ""]} { set login_port 22 }

# Login sequence
CheckProtocol
StartSessionSSH=(spawn)bin\\plink.exe $login_address -ssh -P $login_port
StartSessionTelnet=(spawn)telnet $login_address $login_port
StoreKeyInCache=y

LoginUser=$login_user
LoginPass=$login_pass

# Post-login improvement: disable paging
DisablePaging=terminal length 0

# Check logon or changepass action
CheckAction1

# Switch to enable mode
SwitchToEnableMode=enable
SendEnablePassword=$enable_pass

# Change workflow
ConfigureTerminal=configure terminal
CheckUserType

# Modern secret (scrypt) with fallback
ChangeUserPassScrypt=username <username> algorithm-type scrypt secret <pmnewpass>
ChangeUserPass=username <username> secret <pmnewpass>

# VTY line path (legacy)
ChangeTerminalPass1=line vty <vty>
ChangeTerminalPass2=password <pmnewpass>

# Enable secret
ChangeEnablePassScrypt=enable algorithm-type scrypt secret <pmnewpass>
ChangeEnablePass=enable secret <pmnewpass>

# Logout
logout=(script)close

# Save / NVRAM
ExitConfigMode=exit
WriteMem=write memory

CheckIfCommitSpecified
StartCommit=(startsync)tmp/tpcengine-cisco-$login_address
commit=copy running-config startup-config
EndCommit=(endsync)tmp/tpcengine-cisco-$login_address
CheckCommit=startup-config

# Verify logon
InitVerifyLogon
