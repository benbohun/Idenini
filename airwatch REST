<RestPlugin>
  <!-- ========================== -->
  <!-- Parameters -->
  <!-- ========================== -->
  <Parameters>
  <!-- Base address validation -->
  <Parameter name="AddressWithValidation" validationPattern="{{AddressValidationPattern}}">{{Address}}</Parameter>
  </Parameters>

  <!-- ========================== -->
  <!-- Error Messages -->
  <!-- ========================== -->
  <ErrorMessages>
  </ErrorMessages>

  <!-- ========================== -->
  <!-- API Calls -->
  <!-- ========================== -->
  <APICalls>
  <!-- VERIFY SECTION -->
  <!-- Verify user credentials -->
  <APICall>
	<Request name="VerifyLogon" method="GET">
	  <URL>https://{{AddressWithValidation}}/api/system/admins/search</URL>
	  <Headers>
		<Header key="Accept">application/json;version=2</Header>
		<Header key="Authorization">Basic {{Username}}:{{Password}}</Header>
		<Header key="aw-tenant-code">{{client}}</Header>
	  </Headers>
	  <Body></Body>
	</Request>
	<Responses>
	  <!-- Success -->
	  <Response name="VerifySuccess" type="valid" statusCode="200">
		<Parse>
		  <ParseBody>
			<Parameter name="VerifyUserUUID" path="admins[?(@.username=='{{Username}}')].uuid" secure="true" />
		  </ParseBody>
		</Parse>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="VerifyNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="VerifyNotAuthenticatedMsg" returnCode="2001" description="HTTP 401 Unauthorized:{{ErrorMessage}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="VerifyForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="VerifyForbiddenMsg" returnCode="2002" description="HTTP 403 Forbidden:{{ErrorMessage}}"/>
	  </Response>
	</Responses>
  </APICall>


  <!-- CHANGE SECTION -->
  <!-- Change user password -->
  <APICall>
	<Request name="ChangeRequest" method="PUT">
	  <URL>https://{{AddressWithValidation}}/api/system/admins/{{VerifyUserUUID}}/password</URL>
	  <Headers>
		<Header key="Content-Type">application/json</Header>
		<Header key="Accept">application/json;version=2</Header>
		<Header key="Authorization">Basic {{Username}}:{{Password}}</Header>
		<Header key="aw-tenant-code">{{client}}</Header>
	  </Headers>
	  <Body>
		{
		"Password":"{{NewPassword|JsonEscape}}"
		}
	  </Body>
	</Request>
	<Responses>
	  <!-- Success Response -->
	  <Response name="ChangeSuccess" type="valid" statusCode="200">
	  </Response>
	  <!-- Bad Request -->
	  <Response name="ChangeBadRequest" type="error" statusCode="400">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeBadRequestMsg" returnCode="3001" description="HTTP 400 BadRequest:{{ErrorMessage}}"/>
	  </Response>
	  <!-- Not Authenticated -->
	  <Response name="ChangeNotAuthenticated" type="error" statusCode="401">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeNotAuthenticatedMsg" returnCode="3002" description="HTTP 401 Unauthorized:{{ErrorMessage}}"/>
	  </Response>
	  <!-- Forbidden -->
	  <Response name="ChangeForbidden" type="error" statusCode="403">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeForbiddenMsg" returnCode="3003" description="HTTP 403 Forbidden:{{ErrorMessage}}"/>
	  </Response>
	  <!-- NotFound -->
	  <Response name="ChangeNotFound" type="error" statusCode="404">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeNotFoundMsg" returnCode="3004" description="HTTP 404 Not Found:{{ErrorMessage}}"/>
	  </Response>
	  <!-- TooManyRequests -->
	  <Response name="ChangeTooManyRequests" type="error" statusCode="429">
		<Parse>
		  <ParseBody>
			<Parameter name="ErrorMessage" path="error.message"/>
		  </ParseBody>
		</Parse>
		<ErrorMessage name="ChangeTooManyRequests" returnCode="3005" description="HTTP 429 Rate limit exceeded: {{ErrorMessage}}"/>
	  </Response>
	</Responses>
  </APICall>

  <!-- ChangeStep2 - ChangeVerifyRequest - Verify user credentials ommitted because it takes 30 seconds to apply new password before you can login to verify with newpassword -->

  </APICalls>

  <!-- ========================== -->
  <!-- Chains -->
  <!-- ========================== -->
  <Chains>
	<Chain name="verifypass">
	  <Request name="VerifyLogon"/>
	</Chain>
	<Chain name="changepass">
	  <Request name="VerifyLogon"/>
	  <Request name="ChangeRequest"/>
	</Chain>

  </Chains>

</RestPlugin>
