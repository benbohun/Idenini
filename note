<#
.SYNOPSIS
    Directly scans a Palo Alto Safe/Platform in CyberArk Privilege Cloud for
    accounts with SSH fingerprint mismatch / RC 9007 failures.

.DESCRIPTION
    This version does NOT depend on CyberArk saved filters such as FailedVerify.
    Instead it:

      1. Authenticates using CCP -> CyberArk Identity -> Privilege Cloud.
      2. Queries ALL accounts in the configured Safe.
      3. Filters those accounts to the configured PlatformID.
      4. Retrieves each account's full details and account activity.
      5. Searches all returned error/status fields for:
           Fingerprint mismatch
           FingerPrintMismatchException
           RC: 9007
           Error code: 9007
           server key
           host key
      6. Exports positive matches.
      7. Optionally exports accounts in a failed CPM state even if the detailed
         plugin text is not exposed by REST.

    Default scope:
      Safe:     APP_NetSecEngOps_BreakGlass
      Platform: NET_PaloAlto

.REQUIREMENTS
    Windows PowerShell 5.1
    psPAS

.OUTPUT
    C:\Temp\CyberArk-SSHFingerprintMismatch.csv
#>

[CmdletBinding()]
param(
    # ===== TARGET SCOPE =====
    [string]$SafeName   = "APP_NetSecEngOps_BreakGlass",
    [string]$PlatformID = "NET_PaloAlto",

    # ===== EDIT THIS PATH AS NEEDED =====
    [string]$OutputPath = "C:\Temp\CyberArk-SSHFingerprintMismatch.csv",

    # Export CPM failures even if REST does not expose exact fingerprint text.
    [bool]$IncludeFailedCandidates = $true,

    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP =====
    [string]$CCPAddress     = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation    = "AIMWebService",
    [string]$CCPAppID       = "ACURestAPI",
    [string]$CCPSafe        = "ACU-VAULT-API",
    [string]$CCPObject      = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth = $false
)

Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'

function Write-Info { param([string]$m) Write-Host "[INFO] $m" -ForegroundColor Cyan }
function Write-Ok   { param([string]$m) Write-Host "[ OK ] $m" -ForegroundColor Green }
function Write-Warn { param([string]$m) Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Write-Err  { param([string]$m) Write-Host "[FAIL] $m" -ForegroundColor Red }

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $Location.Trim('/'),
        [uri]::EscapeDataString($AppID),
        [uri]::EscapeDataString($Safe),
        [uri]::EscapeDataString($Object)

    Write-Info "Retrieving API service-user credential from CCP..."

    $resp = Invoke-RestMethod `
        -Uri $url `
        -Method GET `
        -Headers @{ "Content-Type" = "application/json" } `
        -UseDefaultCredentials:$WindowsAuth `
        -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new([string]$resp.UserName, $sec)
}

function Get-PropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        $p = $Object.PSObject.Properties[$name]
        if ($p -and $null -ne $p.Value) {
            return $p.Value
        }
    }

    return $null
}

function Get-AccountIdValue {
    param([Parameter(Mandatory)][object]$Account)

    return [string](Get-PropertyValue `
        -Object $Account `
        -Names @('id','ID','AccountID','AccountId'))
}

function ConvertTo-SearchableText {
    param([object]$Object)

    if ($null -eq $Object) {
        return ''
    }

    try {
        return ($Object | ConvertTo-Json -Depth 15 -Compress)
    }
    catch {
        return [string]$Object
    }
}

function Test-FingerprintFailure {
    param([string]$Text)

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return $false
    }

    return (
        $Text -match '(?i)fingerprint\s+mismatch' -or
        $Text -match '(?i)FingerPrintMismatchException' -or
        $Text -match '(?i)RC\s*:\s*9007' -or
        $Text -match '(?i)error\s*code\s*:\s*9007'
    )
}

function Test-SSHHostKeyFailure {
    param([string]$Text)

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return $false
    }

    return (
        $Text -match '(?i)server\s+key' -or
        $Text -match '(?i)host\s+key' -or
        $Text -match '(?i)ssh.*fingerprint' -or
        $Text -match '(?i)key.*fingerprint'
    )
}

function Get-Evidence {
    param(
        [string]$Text,
        [int]$MaxLength = 1200
    )

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return ''
    }

    $patterns = @(
        '(?i).{0,220}fingerprint\s+mismatch.{0,550}',
        '(?i).{0,220}FingerPrintMismatchException.{0,550}',
        '(?i).{0,220}RC\s*:\s*9007.{0,450}',
        '(?i).{0,220}error\s*code\s*:\s*9007.{0,450}',
        '(?i).{0,220}server\s+key.{0,500}',
        '(?i).{0,220}host\s+key.{0,500}'
    )

    foreach ($pattern in $patterns) {
        $m = [regex]::Match($Text, $pattern)

        if ($m.Success) {
            $value = ($m.Value -replace '\s+', ' ').Trim()

            if ($value.Length -gt $MaxLength) {
                return $value.Substring(0, $MaxLength)
            }

            return $value
        }
    }

    return ''
}

function Test-IsFailedManagementState {
    param([object]$Account)

    $secretMgmt = Get-PropertyValue `
        -Object $Account `
        -Names @('secretManagement','SecretManagement')

    if (-not $secretMgmt) {
        return $false
    }

    $status = [string](Get-PropertyValue `
        -Object $secretMgmt `
        -Names @('status','Status'))

    $manual = [string](Get-PropertyValue `
        -Object $secretMgmt `
        -Names @('manualManagementReason','ManualManagementReason'))

    $lastTask = [string](Get-PropertyValue `
        -Object $secretMgmt `
        -Names @('lastTask','LastTask'))

    $combined = "$status $manual $lastTask"

    return (
        $combined -match '(?i)fail|error|unsuccess|problem|suspend|disable'
    )
}

function Get-AccountActivitySafe {
    param([Parameter(Mandatory)][string]$AccountID)

    try {
        return @(Get-PASAccountActivity `
            -AccountID $AccountID `
            -ErrorAction Stop)
    }
    catch {
        Write-Warn "Could not retrieve activity for AccountID=$AccountID : $($_.Exception.Message)"
        return @()
    }
}

$sessionCreated = $false
$results = New-Object System.Collections.Generic.List[object]

try {
    foreach ($cmd in @(
        'New-PASSession',
        'Get-PASAccount',
        'Get-PASAccountActivity',
        'Close-PASSession'
    )) {
        if (-not (Get-Command $cmd -ErrorAction SilentlyContinue)) {
            throw "Required psPAS command '$cmd' is unavailable."
        }
    }

    $cred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $cred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $sessionCreated = $true
    Write-Ok "Authenticated."

    Write-Info "Querying ALL accounts from Safe '$SafeName'..."

    # Direct Safe query -- no FailedVerify/FailedChange/FailedReconcile dependency.
    $safeAccounts = @(Get-PASAccount `
        -SafeName $SafeName `
        -limit 1000 `
        -ErrorAction Stop)

    Write-Info "Accounts returned from Safe: $($safeAccounts.Count)"

    $platformAccounts = @(
        $safeAccounts |
        Where-Object {
            $p = [string](Get-PropertyValue `
                -Object $_ `
                -Names @('platformId','PlatformID','platformID'))

            $p -ieq $PlatformID
        }
    )

    Write-Info "Accounts using Platform '$PlatformID': $($platformAccounts.Count)"

    if ($platformAccounts.Count -eq 0) {
        Write-Warn "No accounts were found in Safe '$SafeName' using Platform '$PlatformID'."
    }

    $current = 0

    foreach ($summaryAccount in $platformAccounts) {
        $current++

        $id = Get-AccountIdValue -Account $summaryAccount

        if ([string]::IsNullOrWhiteSpace($id)) {
            Write-Warn "Skipping account with empty AccountID."
            continue
        }

        $user = [string](Get-PropertyValue `
            -Object $summaryAccount `
            -Names @('userName','UserName'))

        $address = [string](Get-PropertyValue `
            -Object $summaryAccount `
            -Names @('address','Address'))

        Write-Info "[$current/$($platformAccounts.Count)] Checking $user@$address ..."

        # Get full account object because summary results may omit secretManagement fields.
        $account = $summaryAccount

        try {
            $full = Get-PASAccount -id $id -ErrorAction Stop

            if ($full) {
                $account = $full
            }
        }
        catch {
            Write-Warn "Could not retrieve full account details for AccountID=$id."
        }

        $activity = Get-AccountActivitySafe -AccountID $id

        $accountText = ConvertTo-SearchableText -Object $account
        $activityText = ConvertTo-SearchableText -Object $activity
        $combinedText = "$accountText $activityText"

        $positiveMatch = Test-FingerprintFailure -Text $combinedText
        $sshKeyHint    = Test-SSHHostKeyFailure -Text $combinedText
        $failedState   = Test-IsFailedManagementState -Account $account

        if (-not $positiveMatch -and
            -not ($IncludeFailedCandidates -and ($failedState -or $sshKeyHint))) {
            continue
        }

        $detectionState = if ($positiveMatch) {
            'MATCHED'
        }
        elseif ($sshKeyHint) {
            'SSH_KEY_CANDIDATE'
        }
        else {
            'FAILED_CPM_CANDIDATE'
        }

        $matchSource = ''

        if (Test-FingerprintFailure -Text $accountText) {
            $matchSource = 'AccountDetails'
        }
        elseif (Test-FingerprintFailure -Text $activityText) {
            $matchSource = 'AccountActivity'
        }
        elseif (Test-SSHHostKeyFailure -Text $accountText) {
            $matchSource = 'AccountDetails-SSHKeyHint'
        }
        elseif (Test-SSHHostKeyFailure -Text $activityText) {
            $matchSource = 'AccountActivity-SSHKeyHint'
        }
        else {
            $matchSource = 'SecretManagementFailure'
        }

        $evidence = Get-Evidence -Text $combinedText

        $secretMgmt = Get-PropertyValue `
            -Object $account `
            -Names @('secretManagement','SecretManagement')

        $cpmStatus = ''
        $lastTask = ''
        $manualReason = ''

        if ($secretMgmt) {
            $cpmStatus = [string](Get-PropertyValue `
                -Object $secretMgmt `
                -Names @('status','Status'))

            $lastTask = [string](Get-PropertyValue `
                -Object $secretMgmt `
                -Names @('lastTask','LastTask'))

            $manualReason = [string](Get-PropertyValue `
                -Object $secretMgmt `
                -Names @('manualManagementReason','ManualManagementReason'))
        }

        $safe = [string](Get-PropertyValue `
            -Object $account `
            -Names @('safeName','SafeName','safe','Safe'))

        $platform = [string](Get-PropertyValue `
            -Object $account `
            -Names @('platformId','PlatformID','platformID'))

        $user = [string](Get-PropertyValue `
            -Object $account `
            -Names @('userName','UserName'))

        $address = [string](Get-PropertyValue `
            -Object $account `
            -Names @('address','Address'))

        $results.Add([pscustomobject]@{
            DetectionState        = $detectionState
            AccountID             = $id
            SafeName              = $safe
            UserName              = $user
            Address               = $address
            PlatformID            = $platform
            CPMStatus             = $cpmStatus
            LastTask              = $lastTask
            ManualManagementReason= $manualReason
            MatchSource           = $matchSource
            ErrorEvidence         = $evidence
        }) | Out-Null
    }

    $directory = Split-Path -Parent $OutputPath

    if ($directory -and -not (Test-Path -LiteralPath $directory)) {
        New-Item `
            -ItemType Directory `
            -Path $directory `
            -Force | Out-Null
    }

    $results |
        Sort-Object DetectionState, Address, UserName |
        Export-Csv `
            -LiteralPath $OutputPath `
            -NoTypeInformation `
            -Encoding UTF8

    $matched = @(
        $results |
        Where-Object DetectionState -eq 'MATCHED'
    ).Count

    $sshCandidates = @(
        $results |
        Where-Object DetectionState -eq 'SSH_KEY_CANDIDATE'
    ).Count

    $failedCandidates = @(
        $results |
        Where-Object DetectionState -eq 'FAILED_CPM_CANDIDATE'
    ).Count

    Write-Host ""
    Write-Ok "Export complete: $OutputPath"
    Write-Host "MATCHED=$matched" -ForegroundColor Green
    Write-Host "SSH_KEY_CANDIDATE=$sshCandidates" -ForegroundColor Yellow
    Write-Host "FAILED_CPM_CANDIDATE=$failedCandidates" -ForegroundColor Yellow
    Write-Host "TOTAL=$($results.Count)" -ForegroundColor White

    if ($results.Count -eq 0) {
        Write-Warn "No matching/failing accounts were returned. If PVWA shows the fingerprint error but this file is empty, the detailed TPC error is likely only present in CPM plugin logs."
    }
}
catch {
    Write-Err $_.Exception.Message
    throw
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "CyberArk session closed."
        }
        catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
