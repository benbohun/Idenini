<#
Test_SWS_TokenGeneration_Only_V8_PS51_Fixed.ps1

Purpose
- Token-generation ONLY diagnostic for CyberArk Secure Web Sessions (SWS) public API auth helper.
- Does not create/update Identity apps.
- Does not call SWS policy copy/update logic.
- PS 5.1 compatible.

What it tests
1. Finds Java.
2. Finds CyberArk public-api-auth-helper*.jar.
3. Finds SWS service-account JSON.
4. Tries tenant candidates:
   - aat4012
   - eef31a0b-0e67-4024-a644-be08614190db
   - eef31a0b0e674024a644be08614190db
5. Runs: java -jar helper.jar -t <tenant> -p <json>
6. Confirms whether access_token was returned.
7. Optionally displays or saves the token.
8. Optionally validates token against GET /v2-edge/sws/policies.

Security
- Token is masked by default.
- Use -ShowToken only when you need to copy it manually.
#>

[CmdletBinding()]
param(
    [string]$SwsTenantAlias = 'aat4012',
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',
    [string]$SwsTenantIdNoDash = 'eef31a0b0e674024a644be08614190db',

    [string]$SwsServiceAccountJsonPath = '',
    [string]$SwsAuthHelperJarPath = '',
    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',

    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',
    [string]$ProxyAddress = '',
    [switch]$ProxyUseDefaultCredentials,

    [int]$TimeoutSeconds = 60,
    [switch]$ShowToken,
    [switch]$SaveTokenToFile,
    [switch]$ValidateAgainstSwsApi,
    [switch]$NoPause
)

$script:ScriptRoot = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Path }
$script:LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only_V8.log'

function Write-Log {
    param(
        [Parameter(Mandatory=$true)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $line = ('{0} - {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message)
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $script:LogPath -Value $line -ErrorAction SilentlyContinue } catch {}
}

function ConvertTo-MaskedToken {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 24) { return ('{0}...' -f $Token.Substring(0, [Math]::Min(8, $Token.Length))) }
    return ('{0}...{1}' -f $Token.Substring(0, 12), $Token.Substring($Token.Length - 8))
}

function Get-FileTextSafe {
    param([string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) { return '' }
    try { return [string](Get-Content -LiteralPath $Path -Raw -ErrorAction Stop) } catch { return '' }
}

function Get-JsonObjectSafe {
    param([string]$Path)
    try {
        $raw = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop
        return ($raw | ConvertFrom-Json -ErrorAction Stop)
    } catch {
        return $null
    }
}

function Get-PropertyValueAny {
    param(
        [object]$Object,
        [string[]]$Names
    )
    if ($null -eq $Object) { return $null }
    foreach ($n in $Names) {
        if ($Object.PSObject.Properties.Name -contains $n) {
            $v = $Object.$n
            if ($null -ne $v -and -not [string]::IsNullOrWhiteSpace([string]$v)) { return [string]$v }
        }
    }
    return $null
}

function Get-JavaPath {
    if (-not [string]::IsNullOrWhiteSpace($SwsJavaPath) -and (Test-Path -LiteralPath $SwsJavaPath)) {
        return (Resolve-Path -LiteralPath $SwsJavaPath).Path
    }

    $candidates = @(
        (Join-Path $script:ScriptRoot 'java.exe'),
        (Join-Path $script:ScriptRoot 'java\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jre\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jdk\bin\java.exe')
    )

    foreach ($c in $candidates) {
        if (Test-Path -LiteralPath $c) { return (Resolve-Path -LiteralPath $c).Path }
    }

    try {
        $cmd = Get-Command java.exe -ErrorAction Stop
        if ($cmd -and $cmd.Source) { return $cmd.Source }
    } catch {}

    throw 'java.exe was not found. Pass -SwsJavaPath with the full java.exe path.'
}

function Test-JavaExecutable {
    param([Parameter(Mandatory=$true)][string]$JavaPath)

    Write-Log ('Testing Java executable: {0}' -f $JavaPath) 'Cyan'

    $stdout = Join-Path $script:ScriptRoot ('JavaVersion_stdout_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    $stderr = Join-Path $script:ScriptRoot ('JavaVersion_stderr_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))

    $p = Start-Process -FilePath $JavaPath -ArgumentList @('-version') -NoNewWindow -PassThru -Wait -RedirectStandardOutput $stdout -RedirectStandardError $stderr
    $out = (Get-FileTextSafe -Path $stdout) + (Get-FileTextSafe -Path $stderr)
    $out = $out.Trim()

    if ($p.ExitCode -ne 0) {
        throw ('java.exe -version failed. ExitCode={0}; Output={1}' -f $p.ExitCode, $out)
    }

    Write-Log ('Java version output: {0}' -f $out) 'Gray'
}

function Get-HelperJarPath {
    if (-not [string]::IsNullOrWhiteSpace($SwsAuthHelperJarPath)) {
        if (-not (Test-Path -LiteralPath $SwsAuthHelperJarPath)) { throw ('Helper JAR path not found: {0}' -f $SwsAuthHelperJarPath) }
        return (Resolve-Path -LiteralPath $SwsAuthHelperJarPath).Path
    }

    $jars = @(Get-ChildItem -LiteralPath $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) { throw ('No public-api-auth-helper*.jar found in {0}' -f $script:ScriptRoot) }
    return $jars[0].FullName
}

function Get-SwsJsonPath {
    if (-not [string]::IsNullOrWhiteSpace($SwsServiceAccountJsonPath)) {
        if (-not (Test-Path -LiteralPath $SwsServiceAccountJsonPath)) { throw ('SWS JSON path not found: {0}' -f $SwsServiceAccountJsonPath) }
        return (Resolve-Path -LiteralPath $SwsServiceAccountJsonPath).Path
    }

    $valid = @()
    $jsonFiles = @(Get-ChildItem -LiteralPath $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    foreach ($f in $jsonFiles) {
        $j = Get-JsonObjectSafe -Path $f.FullName
        if ($null -eq $j) { continue }
        $sid = Get-PropertyValueAny -Object $j -Names @('serviceAccountId','service_account_id','clientId','client_id','id')
        $pk  = Get-PropertyValueAny -Object $j -Names @('privateKey','private_key','key')
        $du  = Get-PropertyValueAny -Object $j -Names @('discoveryURI','discoveryUri','discovery_url','discoveryUrl')
        if (-not [string]::IsNullOrWhiteSpace($sid) -and -not [string]::IsNullOrWhiteSpace($pk) -and -not [string]::IsNullOrWhiteSpace($du)) {
            $valid += [pscustomobject]@{
                FullName = $f.FullName
                Name = $f.Name
                LastWriteTime = $f.LastWriteTime
                ServiceAccountId = $sid
                DiscoveryURI = $du
            }
        }
    }

    Write-Log ('Valid SWS JSON file count={0}' -f $valid.Count) 'Gray'
    foreach ($v in $valid) {
        Write-Log ('JSON candidate: File={0}; ServiceAccountId={1}; LastWriteTime={2}' -f $v.Name, $v.ServiceAccountId, $v.LastWriteTime) 'Gray'
    }

    if ($valid.Count -eq 0) { throw ('No valid SWS service-account JSON found in {0}' -f $script:ScriptRoot) }
    return $valid[0].FullName
}

function Get-TenantCandidates {
    $list = New-Object System.Collections.Generic.List[string]

    foreach ($value in @($SwsTenantAlias, $SwsTenantId, $SwsTenantIdNoDash)) {
        if ([string]::IsNullOrWhiteSpace($value)) { continue }
        $trimmed = $value.Trim()
        if (-not $list.Contains($trimmed)) { [void]$list.Add($trimmed) }
    }

    # Also include dashless variant of GUID value.
    if (-not [string]::IsNullOrWhiteSpace($SwsTenantId)) {
        $dashless = ($SwsTenantId -replace '-', '').Trim()
        if (-not [string]::IsNullOrWhiteSpace($dashless) -and -not $list.Contains($dashless)) { [void]$list.Add($dashless) }
    }

    if ($list.Count -eq 0) { throw 'No tenant candidates were built.' }
    return @($list.ToArray())
}

function Extract-AccessToken {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $null }

    # JSON-ish: "access_token":"..."
    $m = [regex]::Match($Text, '"access_token"\s*:\s*"([^"\r\n]+)"')
    if ($m.Success) { return $m.Groups[1].Value }

    # Key/value: access_token = ... or access_token: ...
    $m = [regex]::Match($Text, '(?im)^\s*access_token\s*[:=]\s*(.+?)\s*$')
    if ($m.Success) { return $m.Groups[1].Value.Trim().Trim('"') }

    # Bearer-style output
    $m = [regex]::Match($Text, '(eyJ[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+)')
    if ($m.Success) { return $m.Groups[1].Value }

    return $null
}

function Invoke-HelperAttempt {
    param(
        [Parameter(Mandatory=$true)][string]$JavaPath,
        [Parameter(Mandatory=$true)][string]$JarPath,
        [Parameter(Mandatory=$true)][string]$JsonPath,
        [Parameter(Mandatory=$true)][string]$TenantId,
        [Parameter(Mandatory=$true)][int]$AttemptNumber
    )

    Write-Log ('Helper token attempt #{0}: TenantId={1}' -f $AttemptNumber, $TenantId) 'Cyan'

    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $stdout = Join-Path $script:ScriptRoot ('SWS_Helper_Attempt_{0}_{1}_stdout.txt' -f $AttemptNumber, $stamp)
    $stderr = Join-Path $script:ScriptRoot ('SWS_Helper_Attempt_{0}_{1}_stderr.txt' -f $AttemptNumber, $stamp)

    Write-Log ('Helper stdout file: {0}' -f $stdout) 'Gray'
    Write-Log ('Helper stderr file: {0}' -f $stderr) 'Gray'

    $args = @('-jar', $JarPath, '-t', $TenantId, '-p', $JsonPath)

    $process = Start-Process -FilePath $JavaPath -ArgumentList $args -NoNewWindow -PassThru -RedirectStandardOutput $stdout -RedirectStandardError $stderr

    $completed = $process.WaitForExit($TimeoutSeconds * 1000)
    if (-not $completed) {
        try { $process.Kill() } catch {}
        Write-Log ('FAILED: Helper attempt #{0} timed out after {1} seconds.' -f $AttemptNumber, $TimeoutSeconds) 'Red'
        return [pscustomobject]@{
            Success = $false
            TimedOut = $true
            ExitCode = $null
            Token = $null
            Output = ''
            StdOutPath = $stdout
            StdErrPath = $stderr
        }
    }

    Start-Sleep -Milliseconds 200
    $outText = Get-FileTextSafe -Path $stdout
    $errText = Get-FileTextSafe -Path $stderr
    $combined = ($outText + [Environment]::NewLine + $errText).Trim()

    $token = Extract-AccessToken -Text $combined
    $exitCode = $process.ExitCode

    Write-Log ('Helper attempt #{0} completed. ExitCode={1}; OutputLength={2}' -f $AttemptNumber, $exitCode, $combined.Length) 'Gray'

    if (-not [string]::IsNullOrWhiteSpace($token)) {
        Write-Log ('SUCCESS: Helper returned access_token. Masked={0}; Length={1}' -f (ConvertTo-MaskedToken -Token $token), $token.Length) 'Green'
        return [pscustomobject]@{
            Success = $true
            TimedOut = $false
            ExitCode = $exitCode
            Token = $token
            Output = $combined
            StdOutPath = $stdout
            StdErrPath = $stderr
        }
    }

    $preview = $combined
    if ($preview.Length -gt 1600) { $preview = $preview.Substring(0, 1600) }
    Write-Log ('FAILED: Helper did not return access_token. ExitCode={0}. OutputPreview={1}' -f $exitCode, $preview) 'Red'

    return [pscustomobject]@{
        Success = $false
        TimedOut = $false
        ExitCode = $exitCode
        Token = $null
        Output = $combined
        StdOutPath = $stdout
        StdErrPath = $stderr
    }
}

function Decode-JwtSegment {
    param([string]$Segment)
    if ([string]::IsNullOrWhiteSpace($Segment)) { return $null }
    $s = $Segment.Replace('-', '+').Replace('_', '/')
    switch ($s.Length % 4) {
        2 { $s += '==' }
        3 { $s += '=' }
        1 { return $null }
    }
    try {
        $bytes = [Convert]::FromBase64String($s)
        return [Text.Encoding]::UTF8.GetString($bytes)
    } catch { return $null }
}

function Show-JwtSummary {
    param([string]$Token)
    $parts = $Token -split '\.'
    if ($parts.Count -lt 2) {
        Write-Log 'Token is not JWT-like or could not be decoded.' 'Yellow'
        return
    }
    $header = Decode-JwtSegment -Segment $parts[0]
    $payload = Decode-JwtSegment -Segment $parts[1]
    if ($header) { Write-Log ('JWT header: {0}' -f $header) 'Gray' }
    if ($payload) { Write-Log ('JWT payload: {0}' -f $payload) 'Gray' }
}

function Invoke-SwsTokenValidation {
    param([string]$Token)
    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    Write-Log ('Validating token with GET {0}' -f $uri) 'Cyan'

    $headers = @{ Authorization = ('Bearer {0}' -f $Token); Accept = 'application/json' }
    $params = @{ Method='GET'; Uri=$uri; Headers=$headers; ErrorAction='Stop' }
    if (-not [string]::IsNullOrWhiteSpace($ProxyAddress)) {
        $params['Proxy'] = $ProxyAddress
        if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    }

    try {
        $null = Invoke-RestMethod @params
        Write-Log 'SUCCESS: SWS API validation GET succeeded.' 'Green'
        return $true
    } catch {
        $status = $null
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log ('FAILED: SWS API validation GET failed. Status={0}; Error={1}' -f $status, $_.Exception.Message) 'Red'
        return $false
    }
}

$finalToken = $null
$overallSuccess = $false

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V8 Started =====' 'Cyan'
    Write-Log ('ScriptRoot={0}' -f $script:ScriptRoot) 'Gray'
    Write-Log ('LogPath={0}' -f $script:LogPath) 'Gray'

    $javaPath = Get-JavaPath
    Test-JavaExecutable -JavaPath $javaPath

    $jarPath = Get-HelperJarPath
    Write-Log ('Using helper JAR: {0}' -f $jarPath) 'Cyan'

    $jsonPath = Get-SwsJsonPath
    Write-Log ('Using SWS service-account JSON: {0}' -f $jsonPath) 'Cyan'

    $json = Get-JsonObjectSafe -Path $jsonPath
    $serviceAccountId = Get-PropertyValueAny -Object $json -Names @('serviceAccountId','service_account_id','clientId','client_id','id')
    $discovery = Get-PropertyValueAny -Object $json -Names @('discoveryURI','discoveryUri','discovery_url','discoveryUrl')
    Write-Log ('JSON summary: ServiceAccountId={0}; DiscoveryURI={1}' -f $serviceAccountId, $discovery) 'Gray'

    $tenantCandidates = Get-TenantCandidates
    Write-Log ('Tenant candidate count={0}; Candidates={1}' -f $tenantCandidates.Count, ($tenantCandidates -join ', ')) 'Gray'

    $attempt = 0
    foreach ($tenant in $tenantCandidates) {
        $attempt++
        $result = Invoke-HelperAttempt -JavaPath $javaPath -JarPath $jarPath -JsonPath $jsonPath -TenantId $tenant -AttemptNumber $attempt
        if ($result.Success) {
            $finalToken = $result.Token
            Write-Log ('TOKEN GENERATION SUCCESS. SuccessfulTenant={0}' -f $tenant) 'Green'
            Show-JwtSummary -Token $finalToken
            $overallSuccess = $true
            break
        }
    }

    if (-not $overallSuccess) {
        throw 'TOKEN GENERATION FAILED. No access_token was returned by the CyberArk helper for any tenant candidate. Review SWS_Helper_Attempt_*_stdout/stderr files created beside this script.'
    }

    if ($ShowToken) {
        Write-Host ''
        Write-Host '===== RAW ACCESS TOKEN START =====' -ForegroundColor Yellow
        Write-Host $finalToken
        Write-Host '===== RAW ACCESS TOKEN END =====' -ForegroundColor Yellow
        Write-Host ''
    }

    if ($SaveTokenToFile) {
        $tokenFile = Join-Path $script:ScriptRoot ('SWS_AccessToken_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
        Set-Content -LiteralPath $tokenFile -Value $finalToken -Encoding ASCII -Force
        Write-Log ('Access token saved to: {0}' -f $tokenFile) 'Yellow'
    }

    if ($ValidateAgainstSwsApi) {
        $valid = Invoke-SwsTokenValidation -Token $finalToken
        if (-not $valid) { throw 'Token was generated but SWS API validation failed.' }
    }

    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V8 Finished: SUCCESS =====' 'Green'
}
catch {
    Write-Log ('FATAL ERROR: {0}' -f $_.Exception.Message) 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V8 Finished: FAILED =====' 'Red'
}
finally {
    if (-not $NoPause) {
        try { Read-Host 'Press ENTER to close this token diagnostic window' | Out-Null } catch {}
    }
}
