<#
Test_SWS_TokenGeneration_Only_V9_QuotedPaths_PS51.ps1

Purpose
- Token-generation-only diagnostic for CyberArk Secure Web Sessions (SWS) public API service-account token.
- Does NOT create/update Identity apps.
- Does NOT call SWS policy update APIs.
- Fixes path-with-spaces issue by launching java.exe through System.Diagnostics.ProcessStartInfo.
- PowerShell 5.1 compatible: does NOT use ProcessStartInfo.ArgumentList.

Expected files in same folder as this script:
- public-api-auth-helper-*.jar
- SWS service-account JSON containing serviceAccountId, privateKey, discoveryURI
- Optional portable Java folder, or use embedded Java path below.
#>

[CmdletBinding()]
param(
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',
    [string[]]$ExtraTenantCandidates = @('aat4012'),

    [string]$SwsServiceAccountJsonPath = '',
    [string]$SwsAuthHelperJarPath = '',
    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',

    [int]$TimeoutSeconds = 60,
    [switch]$ShowToken,
    [switch]$SaveTokenToFile,
    [switch]$ValidateAgainstSwsApi,
    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',

    # Optional proxy support for Java helper and PowerShell validation.
    # Example: -ProxyAddress 'http://proxy.company.com:8080'
    [string]$ProxyAddress = '',
    [switch]$ProxyUseDefaultCredentials,

    [switch]$NoPause
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$script:ScriptRoot = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Path }
$script:LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only_V9.log'

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $line = '{0} - {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $script:LogPath -Value $line -Encoding UTF8 } catch {}
}

function Stop-WithPause {
    param([string]$Message)
    Write-Log "FATAL ERROR: $Message" 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V9 Finished: FAILED =====' 'Red'
    if (-not $NoPause) { try { Read-Host 'Press ENTER to close this token diagnostic window' | Out-Null } catch {} }
    exit 1
}

function Quote-Arg {
    param([Parameter(Mandatory)][string]$Value)
    # For ProcessStartInfo.Arguments; FileName is set separately.
    return '"' + ($Value -replace '"','\"') + '"'
}

function Mask-Token {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '' }
    if ($Token.Length -le 24) { return ('*' * $Token.Length) }
    return ('{0}...{1}' -f $Token.Substring(0,12), $Token.Substring($Token.Length-8))
}

function ConvertFrom-Base64UrlJson {
    param([Parameter(Mandatory)][string]$Segment)
    $s = $Segment.Replace('-','+').Replace('_','/')
    switch ($s.Length % 4) {
        2 { $s += '==' }
        3 { $s += '=' }
        1 { return $null }
    }
    try {
        $json = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s))
        return ($json | ConvertFrom-Json)
    } catch { return $null }
}

function Get-JwtSummary {
    param([Parameter(Mandatory)][string]$Token)
    $parts = $Token.Split('.')
    if ($parts.Count -lt 2) { return 'Token is not JWT-shaped.' }
    $header = ConvertFrom-Base64UrlJson -Segment $parts[0]
    $payload = ConvertFrom-Base64UrlJson -Segment $parts[1]
    $items = @()
    if ($header) {
        $items += ('alg={0}' -f $header.alg)
        if ($header.kid) { $items += ('kid={0}' -f $header.kid) }
    }
    if ($payload) {
        if ($payload.iss) { $items += ('iss={0}' -f $payload.iss) }
        if ($payload.aud) { $items += ('aud={0}' -f (($payload.aud | Out-String).Trim())) }
        if ($payload.exp) {
            try {
                $epoch = [DateTime]'1970-01-01T00:00:00Z'
                $expUtc = $epoch.AddSeconds([double]$payload.exp).ToUniversalTime()
                $items += ('expUtc={0}' -f $expUtc.ToString('yyyy-MM-dd HH:mm:ss'))
            } catch {}
        }
    }
    if ($items.Count -eq 0) { return 'JWT summary unavailable.' }
    return ($items -join '; ')
}

function Find-JavaExe {
    if (-not [string]::IsNullOrWhiteSpace($SwsJavaPath) -and (Test-Path -LiteralPath $SwsJavaPath)) {
        return (Resolve-Path -LiteralPath $SwsJavaPath).Path
    }

    $candidates = @(
        (Join-Path $script:ScriptRoot 'java.exe'),
        (Join-Path $script:ScriptRoot 'java\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jre\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jdk\bin\java.exe')
    )

    foreach ($p in $candidates) {
        if (Test-Path -LiteralPath $p) { return (Resolve-Path -LiteralPath $p).Path }
    }

    $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
    if ($cmd -and $cmd.Source) { return $cmd.Source }

    return $null
}

function Find-HelperJar {
    if (-not [string]::IsNullOrWhiteSpace($SwsAuthHelperJarPath) -and (Test-Path -LiteralPath $SwsAuthHelperJarPath)) {
        return (Resolve-Path -LiteralPath $SwsAuthHelperJarPath).Path
    }
    $jars = @(Get-ChildItem -LiteralPath $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -lt 1) { return $null }
    return $jars[0].FullName
}

function Get-JsonField {
    param($Object, [string]$Name)
    if ($null -eq $Object) { return $null }
    if ($Object.PSObject.Properties.Name -contains $Name) { return $Object.$Name }
    return $null
}

function Get-ValidSwsJsonFiles {
    $files = @()
    if (-not [string]::IsNullOrWhiteSpace($SwsServiceAccountJsonPath)) {
        if (-not (Test-Path -LiteralPath $SwsServiceAccountJsonPath)) { throw "SWS JSON path not found: $SwsServiceAccountJsonPath" }
        $files = @(Get-Item -LiteralPath $SwsServiceAccountJsonPath)
    } else {
        $files = @(Get-ChildItem -LiteralPath $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    }

    $valid = @()
    foreach ($f in $files) {
        try {
            $raw = Get-Content -LiteralPath $f.FullName -Raw -ErrorAction Stop
            $j = $raw | ConvertFrom-Json -ErrorAction Stop
            $sid = [string](Get-JsonField -Object $j -Name 'serviceAccountId')
            $pk  = [string](Get-JsonField -Object $j -Name 'privateKey')
            $du  = [string](Get-JsonField -Object $j -Name 'discoveryURI')
            if (-not [string]::IsNullOrWhiteSpace($sid) -and -not [string]::IsNullOrWhiteSpace($pk) -and -not [string]::IsNullOrWhiteSpace($du)) {
                $valid += [pscustomobject]@{
                    File = $f
                    Json = $j
                    ServiceAccountId = $sid
                    DiscoveryURI = $du
                }
            }
        } catch {}
    }
    return @($valid)
}

function Run-ProcessCapture {
    param(
        [Parameter(Mandatory)][string]$FileName,
        [Parameter(Mandatory)][string]$Arguments,
        [Parameter(Mandatory)][string]$StdOutFile,
        [Parameter(Mandatory)][string]$StdErrFile,
        [int]$TimeoutSeconds = 60
    )

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $FileName
    $psi.Arguments = $Arguments
    $psi.WorkingDirectory = $script:ScriptRoot
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true

    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi

    $null = $p.Start()
    $completed = $p.WaitForExit($TimeoutSeconds * 1000)

    if (-not $completed) {
        try { $p.Kill() } catch {}
        try { $p.WaitForExit() } catch {}
        Set-Content -LiteralPath $StdOutFile -Value '' -Encoding UTF8
        Set-Content -LiteralPath $StdErrFile -Value "PROCESS TIMEOUT after $TimeoutSeconds second(s). Command=$FileName $Arguments" -Encoding UTF8
        return [pscustomobject]@{
            ExitCode = -999
            TimedOut = $true
            StdOut = ''
            StdErr = "PROCESS TIMEOUT after $TimeoutSeconds second(s)."
        }
    }

    $stdout = $p.StandardOutput.ReadToEnd()
    $stderr = $p.StandardError.ReadToEnd()

    Set-Content -LiteralPath $StdOutFile -Value $stdout -Encoding UTF8
    Set-Content -LiteralPath $StdErrFile -Value $stderr -Encoding UTF8

    return [pscustomobject]@{
        ExitCode = $p.ExitCode
        TimedOut = $false
        StdOut = $stdout
        StdErr = $stderr
    }
}

function Extract-AccessToken {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $null }

    # JSON style: {"access_token":"..."}
    $m = [regex]::Match($Text, '"access_token"\s*:\s*"([^"\r\n]+)"')
    if ($m.Success) { return $m.Groups[1].Value.Trim() }

    # Text style: access_token: xxx or access_token=xxx
    $m = [regex]::Match($Text, '(?im)^\s*access_token\s*[:=]\s*([A-Za-z0-9_\-\.]+)\s*$')
    if ($m.Success) { return $m.Groups[1].Value.Trim() }

    # Some helpers only print the JWT/token alone.
    $m = [regex]::Match($Text, '(eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-\.]+)')
    if ($m.Success) { return $m.Groups[1].Value.Trim() }

    return $null
}

function Get-TenantCandidates {
    $list = New-Object System.Collections.Generic.List[string]
    foreach ($v in @($ExtraTenantCandidates + $SwsTenantId)) {
        if (-not [string]::IsNullOrWhiteSpace($v)) {
            $trim = $v.Trim()
            if (-not $list.Contains($trim)) { [void]$list.Add($trim) }
            $dashless = ($trim -replace '[{}-]','')
            if (-not [string]::IsNullOrWhiteSpace($dashless) -and -not $list.Contains($dashless)) { [void]$list.Add($dashless) }
        }
    }
    return @($list.ToArray())
}

function Build-JavaArguments {
    param(
        [Parameter(Mandatory)][string]$JarPath,
        [Parameter(Mandatory)][string]$TenantId,
        [Parameter(Mandatory)][string]$JsonPath
    )

    $parts = New-Object System.Collections.Generic.List[string]

    if (-not [string]::IsNullOrWhiteSpace($ProxyAddress)) {
        try {
            $u = [Uri]$ProxyAddress
            if ($u.Host) {
                [void]$parts.Add('-Dhttp.proxyHost=' + $u.Host)
                [void]$parts.Add('-Dhttps.proxyHost=' + $u.Host)
            }
            if ($u.Port -gt 0) {
                [void]$parts.Add('-Dhttp.proxyPort=' + $u.Port)
                [void]$parts.Add('-Dhttps.proxyPort=' + $u.Port)
            }
        } catch {
            Write-Log "ProxyAddress could not be parsed for Java proxy options: $ProxyAddress" 'Yellow'
        }
    }

    [void]$parts.Add('-jar')
    [void]$parts.Add((Quote-Arg $JarPath))
    [void]$parts.Add('-t')
    [void]$parts.Add((Quote-Arg $TenantId))
    [void]$parts.Add('-p')
    [void]$parts.Add((Quote-Arg $JsonPath))

    return ($parts.ToArray() -join ' ')
}

function Validate-TokenAgainstSwsApi {
    param([Parameter(Mandatory)][string]$Token)
    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    $headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }
    $params = @{ Method='GET'; Uri=$uri; Headers=$headers; ErrorAction='Stop' }
    if (-not [string]::IsNullOrWhiteSpace($ProxyAddress)) {
        $params['Proxy'] = $ProxyAddress
        if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    }
    $null = Invoke-RestMethod @params
    Write-Log "SUCCESS: Token validated against SWS API GET $uri" 'Green'
}

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V9 Started =====' 'Cyan'
    Write-Log "ScriptRoot=$script:ScriptRoot" 'Gray'
    Write-Log "LogPath=$script:LogPath" 'Gray'

    $java = Find-JavaExe
    if ([string]::IsNullOrWhiteSpace($java)) { Stop-WithPause 'java.exe was not found. Provide -SwsJavaPath or place portable JDK beside the script.' }
    Write-Log "Testing Java executable: $java" 'Cyan'

    $javaVersionStdout = Join-Path $script:ScriptRoot ('SWS_JavaVersion_{0}_stdout.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    $javaVersionStderr = Join-Path $script:ScriptRoot ('SWS_JavaVersion_{0}_stderr.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    $jv = Run-ProcessCapture -FileName $java -Arguments '-version' -StdOutFile $javaVersionStdout -StdErrFile $javaVersionStderr -TimeoutSeconds 15
    $javaVersionText = (($jv.StdOut + "`n" + $jv.StdErr).Trim())
    Write-Log "Java version output: $javaVersionText" 'Gray'

    $jar = Find-HelperJar
    if ([string]::IsNullOrWhiteSpace($jar)) { Stop-WithPause 'public-api-auth-helper*.jar was not found beside the script. Provide -SwsAuthHelperJarPath.' }
    Write-Log "Using helper JAR: $jar" 'Cyan'

    $validJsons = @(Get-ValidSwsJsonFiles)
    Write-Log "Valid SWS JSON file count=$($validJsons.Count)" 'Cyan'
    if ($validJsons.Count -lt 1) { Stop-WithPause 'No valid SWS service-account JSON found. It must contain serviceAccountId, privateKey, and discoveryURI.' }
    foreach ($v in $validJsons) {
        Write-Log ('JSON candidate: File={0}; ServiceAccountId={1}; LastWriteTime={2}' -f $v.File.Name, $v.ServiceAccountId, $v.File.LastWriteTime) 'Gray'
    }

    $selected = $validJsons[0]
    Write-Log "Using SWS service-account JSON: $($selected.File.FullName)" 'Cyan'
    Write-Log "JSON summary: ServiceAccountId=$($selected.ServiceAccountId); DiscoveryURI=$($selected.DiscoveryURI)" 'Cyan'

    $tenantCandidates = @(Get-TenantCandidates)
    Write-Log ('Tenant candidate count={0}; Candidates={1}' -f $tenantCandidates.Count, ($tenantCandidates -join ', ')) 'Cyan'

    $attempt = 0
    foreach ($tenant in $tenantCandidates) {
        $attempt++
        $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
        $stdoutFile = Join-Path $script:ScriptRoot ("SWS_Helper_Attempt_${attempt}_${stamp}_stdout.txt")
        $stderrFile = Join-Path $script:ScriptRoot ("SWS_Helper_Attempt_${attempt}_${stamp}_stderr.txt")

        Write-Log "Helper token attempt #$($attempt): TenantId=$tenant" 'Cyan'
        Write-Log "Helper stdout file: $stdoutFile" 'Gray'
        Write-Log "Helper stderr file: $stderrFile" 'Gray'

        $args = Build-JavaArguments -JarPath $jar -TenantId $tenant -JsonPath $selected.File.FullName
        Write-Log "Java command: `"$java`" $args" 'Gray'

        $result = Run-ProcessCapture -FileName $java -Arguments $args -StdOutFile $stdoutFile -StdErrFile $stderrFile -TimeoutSeconds $TimeoutSeconds
        $combined = (($result.StdOut + "`n" + $result.StdErr).Trim())
        Write-Log ('Helper attempt #{0} completed. ExitCode={1}; TimedOut={2}; OutputLength={3}' -f $attempt, $result.ExitCode, $result.TimedOut, $combined.Length) 'Gray'

        if ($result.TimedOut) {
            Write-Log "FAILED: Helper attempt timed out after $TimeoutSeconds second(s)." 'Red'
            continue
        }

        $token = Extract-AccessToken -Text $combined
        if (-not [string]::IsNullOrWhiteSpace($token)) {
            Write-Log "SUCCESS: Helper returned access_token for TenantId=$tenant" 'Green'
            Write-Log ('Token length={0}; Masked={1}' -f $token.Length, (Mask-Token $token)) 'Green'
            Write-Log ('JWT summary: {0}' -f (Get-JwtSummary -Token $token)) 'Green'

            if ($SaveTokenToFile) {
                $tokenFile = Join-Path $script:ScriptRoot 'SWS_AccessToken.txt'
                Set-Content -LiteralPath $tokenFile -Value $token -Encoding ASCII
                Write-Log "Saved raw token to: $tokenFile" 'Yellow'
            }
            if ($ShowToken) {
                Write-Host ''
                Write-Host '================ RAW SWS ACCESS TOKEN ================' -ForegroundColor Yellow
                Write-Host $token
                Write-Host '======================================================' -ForegroundColor Yellow
                Write-Host ''
            }
            if ($ValidateAgainstSwsApi) {
                Validate-TokenAgainstSwsApi -Token $token
            }
            Write-Log 'TOKEN GENERATION SUCCESS.' 'Green'
            Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V9 Finished: SUCCESS =====' 'Green'
            if (-not $NoPause) { try { Read-Host 'Press ENTER to close this token diagnostic window' | Out-Null } catch {} }
            exit 0
        }

        $preview = if ($combined.Length -gt 2500) { $combined.Substring(0,2500) } else { $combined }
        Write-Log "FAILED: Helper did not return access_token. ExitCode=$($result.ExitCode). OutputPreview=$preview" 'Red'
    }

    Stop-WithPause 'TOKEN GENERATION FAILED. No access_token was returned by the CyberArk helper for any tenant candidate. Review SWS_Helper_Attempt_*_stdout/stderr files created beside this script.'
}
catch {
    Stop-WithPause $_.Exception.Message
}
