#Requires -Version 5.1
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# --- Allow unsigned modules & unblock psPAS (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}
$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }
foreach ($d in $psPASDirs) { try { Get-ChildItem $d -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {} }

# --- Minimal logging (no secrets/identifiers) ---
$LogPath = "G:\Script\logon.txt"
Function Write-Log {
    param([string]$Message,[string]$Color="White")
    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogPath -Value $line } catch {}
}

# --- Load psPAS (and optionally AD) ---
try { Import-Module psPAS -Force -ErrorAction Stop; Write-Log "psPAS loaded." "Green" }
catch { Write-Log "psPAS not found/loaded." "Red"; exit 1 }
$ADModuleLoaded = $false
try { Import-Module ActiveDirectory -ErrorAction Stop; $ADModuleLoaded = $true }
catch { Write-Log "AD module not available (non-fatal)." "Yellow" }

# --- Enforce TLS1.2 ---
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}

# --- CCP / Identity parameters (edit as needed; never printed) ---
$CCPAddress     = "https://HQVUCYBARK101.alliantcreditunion.com"
$Location       = "AIMWebService"
$AppID          = "PAMTEST"
$SafeForCCP     = "PAMTEST"
$WindowsAuth    = $false
$Headers        = @{ "Content-Type" = "application/json" }
$IdentityTenantUrl = "http://aap4748.id.cyberark.cloud/"
$PCloudSubdomain   = "alliant-test"

# --- Fetch secret from CCP and return PSCredential as $Cred ---
Function Get-CCPCredentialByObject {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )
    try {
        $url  = "$CCPAddress/$Location/api/Accounts?AppID=$AppID&Safe=$SafeForCCP&Object=$ObjectName"
        $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $Headers -UseDefaultCredentials:$WindowsAuth
        if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
        $sec  = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $Cred = [PSCredential]::new($UPUser, $sec)
        $resp.Content = $null; Remove-Variable sec -ErrorAction SilentlyContinue
        Write-Log "Credential retrieved securely." "Green"
        return $Cred
    } catch {
        Write-Log "Credential retrieval failed." "Red"; throw
    }
}

# --- Identity reachability & skew (generic) ---
Function Test-IdentityPreflight {
    param([Parameter(Mandatory)][string]$IdentityTenantUrl)
    try {
        $u = $IdentityTenantUrl.TrimEnd('/') + '/.well-known/openid-configuration'
        $r = Invoke-WebRequest -Uri $u -Method Head -TimeoutSec 12 -ErrorAction Stop
        Write-Log "Identity endpoint reachable." "Green"
        if ($r.Headers.Date) {
            $srv = [DateTime]::Parse($r.Headers.Date).ToUniversalTime()
            $loc = (Get-Date).ToUniversalTime()
            $skew = [math]::Round(($loc - $srv).TotalSeconds,0)
            if ([math]::Abs($skew) -gt 300) { Write-Log "Clock skew > 5 min; sync time." "Yellow" }
        }
    } catch { Write-Log "Identity endpoint not reachable." "Red"; throw }
}

# --- Establish psPAS Identity session using $Cred (safe logs only) ---
Function Start-PASIdentitySession {
    param(
        [Parameter(Mandatory)][pscredential]$Cred,
        [Parameter(Mandatory)][string]$IdentityTenantUrl,
        [Parameter(Mandatory)][string]$PCloudSubdomain
    )
    try { Test-IdentityPreflight -IdentityTenantUrl $IdentityTenantUrl } catch { throw }
    try {
        $Header = Get-IdentityHeader -IdentityTenantURL $IdentityTenantUrl -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $Cred
        Use-PASSession $Header
        if (-not (Get-PASSession)) { throw "Session not established" }
        Write-Log "PAS session established." "Green"
    } catch {
        $m = $_.Exception.Message
        switch -Regex ($m) {
            '401|unauthori'                               { Write-Log "Identity auth rejected." "Red"; break }
            'tenant|not\s*found|404'                      { Write-Log "Tenant URL / Subdomain mismatch." "Red"; break }
            'TLS|certificate|SSL'                         { Write-Log "TLS/Certificate issue." "Red"; break }
            'name.*could not be resolved|No such host|NameResolutionFailure' { Write-Log "DNS/Network issue." "Red"; break }
            'timed out|timeout'                           { Write-Log "Timeout contacting Identity." "Red"; break }
            default                                       { Write-Log "PAS session establishment failed." "Red" }
        }
        throw
    }
}

# ===================== MAIN FLOW =====================
try {
    # 1) Retrieve and store securely as $Cred
    $ObjectName = "alliant-test.cyberark.cloud-botpamtest"   # edit value; not printed
    $UPUser     = "botpamtest@cyberark.cloud.4176"           # edit value; not printed
    $Cred = Get-CCPCredentialByObject -ObjectName $ObjectName -UPUser $UPUser

    # 2) Use $Cred to authenticate to CyberArk via psPAS Identity
    Start-PASIdentitySession -Cred $Cred -IdentityTenantUrl $IdentityTenantUrl -PCloudSubdomain $PCloudSubdomain

    # 3) Execute secured operations here (no account properties printed)
    # Example:
    # Get-PASLoggedOnUser | Out-Null
    Write-Log "Ready to execute secured operations." "Green"
}
catch { Write-Log "Operation failed." "Red" }
finally {
    Remove-Variable Cred -ErrorAction SilentlyContinue
    Write-Log "Completed." "Green"
}
