Get-InstalledModule IdentityCommand -AllVersions
Get-InstalledModule psPAS -AllVersions

Uninstall-Module IdentityCommand -AllVersions -Force
Uninstall-Module psPAS -AllVersions -Force

Install-Module IdentityCommand -RequiredVersion 0.3.61 -Force -AllowClobber
Install-Module psPAS -RequiredVersion 7.0.242 -Force -AllowClobber

Import-Module IdentityCommand -RequiredVersion 0.3.61 -Force
Import-Module psPAS -RequiredVersion 7.0.242 -Force

Get-Module IdentityCommand, psPAS



::::::::::::::
Import-Module IdentityCommand -RequiredVersion 0.3.61 -Force
Import-Module psPAS -RequiredVersion 7.0.242 -Force

$cred = Get-Credential

# Identity validation
New-IDSession -tenant_url "https://aak4521.id.cyberark.cloud" -Credential $cred
Get-IDSession

# Privilege Cloud login
New-PASSession `
  -IdentityTenantURL "https://aak4521.id.cyberark.cloud" `
  -PrivilegeCloudURL "https://alliantcredit.privilegecloud.cyberark.cloud" `
  -Credential $cred `
  -IdentityUser `
  -SkipVersionCheck

Get-PASSession
Get-PASSafe -Search "IND_"

Close-PASSession
Close-IDSession
