# ============================================
# Helper: Get account last modified date
# ============================================

function Get-AccountLastModifiedDate {
    param(
        [AllowNull()]
        [object]$Account
    )

    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime'
        )

    if ($null -eq $value) {
        $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime',
            'categoryModificationTime',
            'CategoryModificationTime',
            'createdTime',
            'CreatedTime'
        )
    }

    return Convert-CyberArkDate -Value $value
}

# ============================================
# Helper: Get explicit account expiration date if present
# Not always exposed by CyberArk account listing/detail APIs.
# ============================================

function Get-AccountExplicitExpirationDate {
    param(
        [AllowNull()]
        [object]$Account
    )

    $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
        'expirationDate',
        'ExpirationDate',
        'expiryDate',
        'ExpiryDate',
        'accountExpirationDate',
        'AccountExpirationDate',
        'passwordExpirationDate',
        'PasswordExpirationDate',
        'passwordExpiryDate',
        'PasswordExpiryDate'
    )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @(
            'platformAccountProperties',
            'PlatformAccountProperties',
            'properties',
            'Properties'
        ) `
        -ChildPropertyNames @(
            'expirationDate',
            'ExpirationDate',
            'expiryDate',
            'ExpiryDate',
            'accountExpirationDate',
            'AccountExpirationDate',
            'passwordExpirationDate',
            'PasswordExpirationDate',
            'passwordExpiryDate',
            'PasswordExpiryDate'
        )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    return $null
}

# ============================================
# Helper: Get account compliance status
# ============================================

function Get-AccountComplianceStatus {
    param(
        [AllowNull()]
        [object]$Account
    )

    $status = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('status', 'Status')

    $automaticManagementEnabled = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('automaticManagementEnabled', 'AutomaticManagementEnabled')

    $manualReason = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('manualManagementReason', 'ManualManagementReason')

    if ($null -ne $automaticManagementEnabled) {
        $autoString = ([string]$automaticManagementEnabled).Trim()

        if ($autoString -ieq 'False') {
            if (-not [string]::IsNullOrWhiteSpace([string]$manualReason)) {
                return "Automatic Management Disabled - $manualReason"
            }

            return 'Automatic Management Disabled'
        }
    }

    if (-not [string]::IsNullOrWhiteSpace([string]$status)) {
        return [string]$status
    }

    return ''
}

# ============================================
# Helper: Calculate expiration due days
# ============================================

function Get-ExpirationDueDays {
    param(
        [AllowNull()]
        [object]$ExplicitExpirationDate,

        [AllowNull()]
        [object]$LastModifiedDate,

        [AllowNull()]
        [object]$RotationPeriodDays
    )

    $expirationDate = Convert-CyberArkDate -Value $ExplicitExpirationDate
    $modifiedDate   = Convert-CyberArkDate -Value $LastModifiedDate

    $rotationDays = $null

    if ($null -ne $RotationPeriodDays -and -not [string]::IsNullOrWhiteSpace([string]$RotationPeriodDays)) {
        try {
            $rotationDays = [int]$RotationPeriodDays
        } catch {
            $rotationDays = $null
        }
    }

    $effectiveExpirationDate = $null

    if ($null -ne $expirationDate) {
        $effectiveExpirationDate = $expirationDate
    } elseif ($null -ne $modifiedDate -and $null -ne $rotationDays -and $rotationDays -gt 0) {
        $effectiveExpirationDate = $modifiedDate.AddDays($rotationDays)
    }

    if ($null -eq $effectiveExpirationDate) {
        return ''
    }

    return [math]::Floor(($effectiveExpirationDate - (Get-Date)).TotalDays)
}

# ============================================
# Helper: Normalize Safe Member output
# Handles psPAS direct arrays and wrapped 2nd-gen response.
# ============================================

function ConvertTo-SafeMemberArray {
    param(
        [AllowNull()]
        [object]$RawMembers
    )

    if ($null -eq $RawMembers) {
        return @()
    }

    $membersProperty = Get-ObjectPropertyValue -InputObject $RawMembers -PropertyNames @(
        'members',
        'Members',
        'value',
        'Value'
    )

    if ($null -ne $membersProperty) {
        return ConvertTo-CleanArray -InputObject $membersProperty
    }

    return ConvertTo-CleanArray -InputObject $RawMembers
}

# ============================================
# Import Modules
# ============================================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $psPASModule = Get-Module psPAS

    if ($psPASModule) {
        Write-Log ("psPAS module loaded. Version: {0}" -f $psPASModule.Version) 'Green'
    } else {
        Write-Log "psPAS module loaded." 'Green'
    }
} catch {
    Write-Log ("ERROR: Failed to import psPAS module. {0}" -f $_.Exception.Message) 'Red'
    throw
}

if (-not (Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Get-IdentityHeader cmdlet was not found. Confirm IdentityCommand module is installed and available." 'Red'
    throw "Get-IdentityHeader cmdlet not found."
}

# ============================================
# Login Method: CCP + psPAS Identity Header
# ============================================

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)]
        [string]$ObjectName
    )

    $headers = @{
        'Content-Type' = 'application/json'
    }

    $ccpUrl = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod `
            -Uri $ccpUrl `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response or missing Content field.'
        }
    } catch {
        Write-Log ("ERROR: CCP credential fetch failed. {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null

    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("Successfully retrieved CCP credential for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication using psPAS Identity header as {0}..." -f $resolvedUser) 'Cyan'
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'
        Write-Log ("Privilege Cloud Subdomain: {0}" -f $PCloudSubdomain) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established.'
        }

        Write-Log ("Authentication successful. PAS session established as {0}." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("ERROR: Failed to authenticate via psPAS Identity header. {0}" -f $_.Exception.Message) 'Red'
        throw
    } finally {
        try {
            if ($resp.PSObject.Properties.Name -contains 'Content') {
                $resp.Content = $null
            }
        } catch {}

        try {
            if ($securePass) {
                $securePass.Dispose()
            }
        } catch {}
    }

    return $resolvedUser
}

# ============================================
# Get All Visible Accounts
# ============================================

function Get-AllVisiblePASAccounts {
    Write-Log "Retrieving all visible accounts using Get-PASAccount..." 'Yellow'

    $cmd = Get-Command Get-PASAccount -ErrorAction Stop
    $params = @{}

    if ($cmd.Parameters.ContainsKey('Limit')) {
        $params['Limit'] = 1000
    }

    $accounts = Get-PASAccount @params -ErrorAction Stop

    $accountArray = ConvertTo-CleanArray -InputObject $accounts

    return $accountArray
}

# ============================================
# Build Platform Rotation Map
# ============================================

function Get-PlatformRotationMap {
    param(
        [Parameter(Mandatory)]
        [array]$Accounts
    )

    $map = @{}

    $platformIds = @(
        $Accounts |
            ForEach-Object { Get-AccountPlatformId -Account $_ } |
            Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
            Sort-Object -Unique
    )

    Write-Log ("Unique platform IDs discovered from account inventory: {0}" -f $platformIds.Count) 'Gray'

    if ($platformIds.Count -eq 0) {
        return $map
    }

    $platformCmd = Get-Command Get-PASPlatform -ErrorAction SilentlyContinue

    if (-not $platformCmd) {
        Write-Log "WARNING: Get-PASPlatform command is unavailable. Expiration calculation will use DefaultExpirationDays only." 'Yellow'
        return $map
    }

    # Fast preload of all platforms.
    $allPlatformLookup = @{}

    try {
        Write-Log "Preloading platform list using Get-PASPlatform..." 'Yellow'

        $platformParams = @{}

        if ($platformCmd.Parameters.ContainsKey('Active')) {
            $platformParams['Active'] = $true
        }

        if ($platformCmd.Parameters.ContainsKey('PlatformType')) {
            $platformParams['PlatformType'] = 'Regular'
        }

        $platformResponse = Get-PASPlatform @platformParams -ErrorAction Stop

        $platformItems = @()

        $wrappedPlatforms = Get-ObjectPropertyValue -InputObject $platformResponse -PropertyNames @(
            'Platforms',
            'platforms',
            'Value',
            'value'
        )

        if ($null -ne $wrappedPlatforms) {
            $platformItems = ConvertTo-CleanArray -InputObject $wrappedPlatforms
        } else {
            $platformItems = ConvertTo-CleanArray -InputObject $platformResponse
        }

        foreach ($platform in $platformItems) {
            $pid = Get-NestedPropertyValue `
                -InputObject $platform `
                -ParentPropertyNames @('general', 'General') `
                -ChildPropertyNames @('id', 'ID', 'platformId', 'PlatformId', 'PlatformID')

            if ([string]::IsNullOrWhiteSpace([string]$pid)) {
                $pid = Get-ObjectPropertyValue -InputObject $platform -PropertyNames @(
                    'id',
                    'ID',
                    'platformId',
                    'PlatformId',
                    'PlatformID',
                    'PlatformName'
                )
            }

            if (-not [string]::IsNullOrWhiteSpace([string]$pid)) {
                $allPlatformLookup[[string]$pid] = $platform
            }
        }

        Write-Log ("Preloaded {0} platform object(s)." -f $allPlatformLookup.Count) 'Green'
    } catch {
        Write-Log ("WARNING: Could not preload platforms. {0}" -f $_.Exception.Message) 'Yellow'
    }

    $platformIndex = 0

    foreach ($platformId in $platformIds) {
        $platformIndex++

        $platformObject = $null

        if ($FetchPlatformDetails -and $platformCmd.Parameters.ContainsKey('PlatformID')) {
            try {
                Write-Log ("[{0}/{1}] Fetching platform details: {2}" -f $platformIndex, $platformIds.Count, $platformId) 'Gray'
                $platformObject = Get-PASPlatform -PlatformID $platformId -ErrorAction Stop
            } catch {
                Write-Log ("WARNING: Could not fetch platform details for '{0}'. Falling back to preloaded platform object. {1}" -f $platformId, $_.Exception.Message) 'Yellow'
            }
        }

        if ($null -eq $platformObject -and $allPlatformLookup.ContainsKey($platformId)) {
            $platformObject = $allPlatformLookup[$platformId]
        }

        if ($null -eq $platformObject) {
            $map[$platformId] = [PSCustomObject]@{
                PlatformId            = $platformId
                RotationDays          = $DefaultExpirationDays
                PerformPeriodicChange = $null
                Source                = 'DefaultFallback'
            }

            continue
        }

        if ($DebugObjectDump -and -not (Test-Path $DebugPlatformPath)) {
            try {
                $platformObject | ConvertTo-Json -Depth 20 | Out-File -FilePath $DebugPlatformPath -Encoding UTF8
                Write-Log ("Debug platform object exported to: {0}" -f $DebugPlatformPath) 'Gray'
            } catch {}
        }

        $rotationDays = Get-NestedPropertyValue `
            -InputObject $platformObject `
            -ParentPropertyNames @('credentialsManagement', 'CredentialsManagement') `
            -ChildPropertyNames @(
                'requirePasswordChangeEveryXDays',
                'RequirePasswordChangeEveryXDays'
            )

        if ($null -eq $rotationDays) {
            $rotationDays = Find-PropertyDeep `
                -InputObject $platformObject `
                -PropertyNames @(
                    'requirePasswordChangeEveryXDays',
                    'RequirePasswordChangeEveryXDays'
                )
        }

        $performPeriodicChange = Get-NestedPropertyValue `
            -InputObject $platformObject `
            -ParentPropertyNames @('credentialsManagement', 'CredentialsManagement') `
            -ChildPropertyNames @(
                'performPeriodicChange',
                'PerformPeriodicChange'
            )

        if ($null -eq $performPeriodicChange) {
            $performPeriodicChange = Find-PropertyDeep `
                -InputObject $platformObject `
                -PropertyNames @(
                    'performPeriodicChange',
                    'PerformPeriodicChange'
                )
        }

        if ($null -eq $rotationDays -or [string]::IsNullOrWhiteSpace([string]$rotationDays)) {
            if ($DefaultExpirationDays -gt 0) {
                $rotationDays = $DefaultExpirationDays
            }
        }

        $map[$platformId] = [PSCustomObject]@{
            PlatformId            = $platformId
            RotationDays          = $rotationDays
            PerformPeriodicChange = $performPeriodicChange
            Source                = if ($FetchPlatformDetails) { 'PlatformDetailsOrPreload' } else { 'PlatformPreload' }
        }
    }

    Write-Log ("Platform rotation map built for {0} platform(s)." -f $map.Count) 'Green'

    return $map
}

# ============================================
# Start Script
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "CNA Safe Member + Account Compliance Report started." 'Cyan'
Write-Log ("Identity Tenant URL                 : {0}" -f $IdentityTenantURL) 'Gray'
Write-Log ("Privilege Cloud URL                 : {0}" -f $PrivilegeCloudURL) 'Gray'
Write-Log ("PCloud Subdomain                    : {0}" -f $PCloudSubdomain) 'Gray'
Write-Log ("CCP Address                         : {0}" -f $CCPAddress) 'Gray'
Write-Log ("CCP AppID                           : {0}" -f $CCPAppID) 'Gray'
Write-Log ("CCP Safe                            : {0}" -f $CCPSafe) 'Gray'
Write-Log ("CCP Object                          : {0}" -f $CCPObject) 'Gray'
Write-Log ("SafeNameFilter                      : {0}" -f $SafeNameFilter) 'Gray'
Write-Log ("IncludeSafesWithNoAccounts          : {0}" -f $IncludeSafesWithNoAccounts) 'Gray'
Write-Log ("DefaultExpirationDays               : {0}" -f $DefaultExpirationDays) 'Gray'
Write-Log ("CalculateWhenPeriodicChangeDisabled : {0}" -f $CalculateWhenPeriodicChangeDisabled) 'Gray'
Write-Log ("FetchPlatformDetails                : {0}" -f $FetchPlatformDetails) 'Gray'
Write-Log ("CSV Report                          : {0}" -f $CsvFilePath) 'Gray'
Write-Log "============================================================" 'Gray'

# ============================================
# Authenticate
# ============================================

try {
    $AuthenticatedUser = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    Write-Log ("FATAL: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve Account Inventory
# ============================================

try {
    $Accounts = Get-AllVisiblePASAccounts

    if ($DebugObjectDump -and $Accounts.Count -gt 0) {
        try {
            $Accounts[0] | ConvertTo-Json -Depth 20 | Out-File -FilePath $DebugAccountPath -Encoding UTF8
            Write-Log ("Debug first account object exported to: {0}" -f $DebugAccountPath) 'Gray'
        } catch {}
    }

    if (-not [string]::IsNullOrWhiteSpace($SafeNameFilter)) {
        $Accounts = @(
            $Accounts | Where-Object {
                $safeName = Get-AccountSafeName -Account $_
                $safeName -like $SafeNameFilter
            }
        )
    }

    Write-Log ("Retrieved {0} visible account(s)." -f $Accounts.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to retrieve accounts. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Normalize Account Inventory
# ============================================

$AccountRows = @(
    foreach ($acct in $Accounts) {
        $safeName = Get-AccountSafeName -Account $acct

        if ([string]::IsNullOrWhiteSpace($safeName)) {
            continue
        }

        [PSCustomObject]@{
            SafeNameKey = $safeName
            Account     = $acct
        }
    }
)

$AccountGroups = @($AccountRows | Group-Object -Property SafeNameKey | Sort-Object Name)

Write-Log ("Accounts grouped across {0} safe(s)." -f $AccountGroups.Count) 'Green'

# ============================================
# Optional: Include safes with no accounts
# Usually not needed for this account-driven report.
# ============================================

if ($IncludeSafesWithNoAccounts) {
    try {
        Write-Log "IncludeSafesWithNoAccounts=True. Retrieving full safe list..." 'Yellow'

        $allSafes = Get-PASSafe -ErrorAction Stop
        $allSafes = ConvertTo-CleanArray -InputObject $allSafes

        $knownSafeNames = @($AccountGroups | ForEach-Object { $_.Name })

        foreach ($safe in $allSafes) {
            $safeName = Get-ObjectPropertyValue -InputObject $safe -PropertyNames @(
                'safeName',
                'SafeName',
                'Safe',
                'Name',
                'name'
            )

            if ([string]::IsNullOrWhiteSpace([string]$safeName)) {
                continue
            }

            $safeName = ([string]$safeName).Trim()

            if (-not [string]::IsNullOrWhiteSpace($SafeNameFilter) -and $safeName -notlike $SafeNameFilter) {
                continue
            }

            if ($knownSafeNames -notcontains $safeName) {
                $AccountGroups += [PSCustomObject]@{
                    Name  = $safeName
                    Count = 0
                    Group = @()
                }
            }
        }

        $AccountGroups = @($AccountGroups | Sort-Object Name)
        Write-Log ("Final safe group count including no-account safes: {0}" -f $AccountGroups.Count) 'Green'
    } catch {
        Write-Log ("WARNING: Could not retrieve full safe list. Continuing with account safes only. {0}" -f $_.Exception.Message) 'Yellow'
    }
}

# ============================================
# Build Platform Rotation Map
# ============================================

try {
    $PlatformRotationMap = Get-PlatformRotationMap -Accounts $Accounts
} catch {
    Write-Log ("WARNING: Failed to build platform rotation map. Expiration calculation will use fallback only. {0}" -f $_.Exception.Message) 'Yellow'
    $PlatformRotationMap = @{}
}

# ============================================
# Build Final Report
# ============================================

$ReportRows = New-Object System.Collections.ArrayList

$totalSafes      = $AccountGroups.Count
$currentSafe     = 0
$successfulSafes = 0
$failedSafes     = 0
$totalRows       = 0

foreach ($group in $AccountGroups) {
    $currentSafe++

    $SafeName = ([string]$group.Name).Trim()

    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        Write-Log ("[{0}/{1}] WARNING: Blank safe group name. Skipping." -f $currentSafe, $totalSafes) 'Yellow'
        continue
    }

    Write-Log ("[{0}/{1}] Processing safe: {2}" -f $currentSafe, $totalSafes, $SafeName) 'Cyan'

    try {
        # -----------------------------
        # Accounts for this safe
        # -----------------------------
        $SafeAccounts = @(
            $group.Group |
                ForEach-Object {
                    if ($_.PSObject.Properties.Name -contains 'Account') {
                        $_.Account
                    }
                }
        )

        if ($null -eq $SafeAccounts) {
            $SafeAccounts = @()
        }

        Write-Log ("Safe '{0}' account count: {1}" -f $SafeName, $SafeAccounts.Count) 'Gray'

        if ($SafeAccounts.Count -eq 0 -and -not $IncludeSafesWithNoAccounts) {
            Write-Log ("Safe '{0}' has no accounts. Skipping." -f $SafeName) 'Yellow'
            $successfulSafes++
            continue
        }

        if ($SafeAccounts.Count -eq 0 -and $IncludeSafesWithNoAccounts) {
            $SafeAccounts = @(
                [PSCustomObject]@{
                    safeName = $SafeName
                    userName = ''
                    address = ''
                    platformId = ''
                    secretManagement = $null
                }
            )
        }

        # -----------------------------
        # Retrieve Safe Members
        # -----------------------------
        try {
            $rawMembers = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
            $SafeMembers = ConvertTo-SafeMemberArray -RawMembers $rawMembers

            if ($DebugObjectDump -and $SafeMembers.Count -gt 0 -and -not (Test-Path $DebugMemberPath)) {
                try {
                    $SafeMembers[0] | ConvertTo-Json -Depth 20 | Out-File -FilePath $DebugMemberPath -Encoding UTF8
                    Write-Log ("Debug first safe member object exported to: {0}" -f $DebugMemberPath) 'Gray'
                } catch {}
            }

            Write-Log ("Safe '{0}' member count: {1}" -f $SafeName, $SafeMembers.Count) 'Gray'
        } catch {
            Write-Log ("WARNING: Could not retrieve members for safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Yellow'
            $SafeMembers = @()
        }

        if ($SafeMembers.Count -eq 0) {
            $SafeMembers = @(
                [PSCustomObject]@{
                    memberName = ''
                    memberType = ''
                }
            )
        }

        # -----------------------------
        # Join members to accounts
        # -----------------------------
        foreach ($Member in $SafeMembers) {
            $memberName = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'memberName',
                'MemberName',
                'UserName',
                'username',
                'Name',
                'name'
            )

            $memberType = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'memberType',
                'MemberType',
                'Type',
                'type'
            )

            foreach ($Account in $SafeAccounts) {
                try {
                    $targetUsername = Get-AccountTargetUsername -Account $Account
                    $address        = Get-AccountAddress -Account $Account
                    $accountSafe    = Get-AccountSafeName -Account $Account
                    $platformId     = Get-AccountPlatformId -Account $Account

                    if ([string]::IsNullOrWhiteSpace($accountSafe)) {
                        $accountSafe = $SafeName
                    }

                    $complianceStatus = Get-AccountComplianceStatus -Account $Account
                    $lastModifiedDate = Get-AccountLastModifiedDate -Account $Account
                    $explicitExpirationDate = Get-AccountExplicitExpirationDate -Account $Account

                    $rotationDays = $null
                    $performPeriodicChange = $null

                    if (-not [string]::IsNullOrWhiteSpace($platformId) -and $PlatformRotationMap.ContainsKey($platformId)) {
                        $rotationDays = $PlatformRotationMap[$platformId].RotationDays
                        $performPeriodicChange = $PlatformRotationMap[$platformId].PerformPeriodicChange
                    }

                    if (($null -eq $rotationDays -or [string]::IsNullOrWhiteSpace([string]$rotationDays)) -and $DefaultExpirationDays -gt 0) {
                        $rotationDays = $DefaultExpirationDays
                    }

                    $shouldCalculateExpiration = $true

                    if ($null -ne $performPeriodicChange) {
                        $periodicString = ([string]$performPeriodicChange).Trim()

                        if (($periodicString -ieq 'False' -or $periodicString -ieq 'No') -and -not $CalculateWhenPeriodicChangeDisabled) {
                            $shouldCalculateExpiration = $false
                        }
                    }

                    if ($shouldCalculateExpiration) {
                        $expirationDueDays = Get-ExpirationDueDays `
                            -ExplicitExpirationDate $explicitExpirationDate `
                            -LastModifiedDate $lastModifiedDate `
                            -RotationPeriodDays $rotationDays
                    } else {
                        $expirationDueDays = ''
                    }

                    $lastModifiedOutput = ''

                    if ($null -ne $lastModifiedDate) {
                        $lastModifiedOutput = $lastModifiedDate.ToString('yyyy-MM-dd HH:mm:ss')
                    }

                    [void]$ReportRows.Add([PSCustomObject]@{
                        'Safe'                  = $SafeName
                        'Member'                = if ($null -eq $memberName) { '' } else { [string]$memberName }
                        'MemberType'            = if ($null -eq $memberType) { '' } else { [string]$memberType }
                        'Target Username'       = $targetUsername
                        'Address'               = $address
                        'Account Safe'          = $accountSafe
                        'Platform Identity'     = $platformId
                        'Compliance Status'     = $complianceStatus
                        'Expiration Due (Days)' = $expirationDueDays
                        'Last Modified Date'    = $lastModifiedOutput
                    })

                    $totalRows++
                } catch {
                    Write-Log ("WARNING: Failed to build row for safe '{0}', member '{1}'. {2}" -f $SafeName, $memberName, $_.Exception.Message) 'Yellow'
                }
            }
        }

        $successfulSafes++
        Write-Log ("Completed safe '{0}'. Rows so far: {1}" -f $SafeName, $totalRows) 'Green'
    } catch {
        $failedSafes++
        Write-Log ("ERROR: Failed while processing safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Red'
    }
}

# ============================================
# Export Report
# ============================================

try {
    Write-Log "Exporting report to CSV..." 'Yellow'

    $ReportRows |
        Sort-Object 'Safe', 'Member', 'Target Username', 'Address' |
        Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

    Write-Log ("Report exported successfully: {0}" -f $CsvFilePath) 'Green'
} catch {
    Write-Log ("ERROR: Failed to export CSV. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Close Session
# ============================================

try {
    Close-PASSession | Out-Null
    Write-Log "PAS session closed." 'Gray'
} catch {
    Write-Log ("WARNING: Could not close PAS session cleanly. {0}" -f $_.Exception.Message) 'Yellow'
}

# ============================================
# Completion
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "Safe Member + Account Compliance Report completed." 'Green'
Write-Log ("Authenticated User : {0}" -f $AuthenticatedUser) 'Gray'
Write-Log ("Accounts Retrieved : {0}" -f $Accounts.Count) 'Gray'
Write-Log ("Safe Groups        : {0}" -f $totalSafes) 'Gray'
Write-Log ("Successful Safes   : {0}" -f $successfulSafes) 'Green'
Write-Log ("Failed Safes       : {0}" -f $failedSafes) 'Red'
Write-Log ("Rows Exported      : {0}" -f $totalRows) 'Gray'
Write-Log ("Report Path        : {0}" -f $CsvFilePath) 'Gray'
Write-Log ("Log Path           : {0}" -f $LogFile) 'Gray'
Write-Log "============================================================" 'Gray'
