[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$TenantUrl    = "https://aak4521.my.idaptive.app"
$ClientId     = "acurestapi_local@alliantcreditunion.admin"
$ClientSecret = Read-Host "Enter CyberArk Identity service user password" -AsSecureString

$ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($ClientSecret)
try {
    $PlainSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)

    $TokenUrl = "$TenantUrl/oauth2/token/identityapi"

    $BasicPair  = "{0}:{1}" -f $ClientId, $PlainSecret
    $BasicBytes = [System.Text.Encoding]::ASCII.GetBytes($BasicPair)
    $BasicToken = [Convert]::ToBase64String($BasicBytes)

    $Headers = @{
        Authorization = "Basic $BasicToken"
    }

    $Body = @{
        grant_type = "client_credentials"
        scope      = "reporting"
    }

    $TokenResponse = Invoke-RestMethod `
        -Uri $TokenUrl `
        -Method POST `
        -Headers $Headers `
        -ContentType "application/x-www-form-urlencoded" `
        -Body $Body `
        -ErrorAction Stop

    $TokenResponse | Format-List *
}
finally {
    if ($ptr -ne [IntPtr]::Zero) {
        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
    }

    $PlainSecret = $null
}
