SELECT User.Email, User.ID, User.LastLogin, User.LoginName, User.Status, User.Username,     User.SourceDs
FROM User
WHERE User.LastLogin <= DateFunc('now','-365') AND User.SourceDs = "AdProxy_cnaroot.com"
ORDER BY User.LastLogin
