Import-Module ActiveDirectory -Verbose -ErrorAction Stop
Install-WindowsFeature RSAT-AD-PowerShell -IncludeAllSubFeature
Import-Module ActiveDirectory

Get-WindowsCapability -Online |
    Where-Object Name -like "Rsat.ActiveDirectory*"



$Domain    = "contoso.com"
$GroupName = "CyberArk-PSM-Users"

$DomainDN = ($Domain -split '\.' | ForEach-Object { "DC=$_" }) -join ","
$Searcher = New-Object System.DirectoryServices.DirectorySearcher
$Searcher.SearchRoot = New-Object System.DirectoryServices.DirectoryEntry(
    "LDAP://$DomainDN"
)

$Searcher.Filter = "(&(objectCategory=group)(|(cn=$GroupName)(sAMAccountName=$GroupName)))"
$Searcher.PropertiesToLoad.Add("distinguishedName") | Out-Null

$Result = $Searcher.FindOne()

if ($null -ne $Result) {
    $Result.Properties["distinguishedname"][0]
}
else {
    Write-Warning "Group '$GroupName' was not found in domain '$Domain'."
}
