Get-WinEvent -FilterHashtable @{
    LogName='System'
    ProviderName='Schannel'
    StartTime=(Get-Date).AddMinutes(-10)
} |
Select TimeCreated,Id,LevelDisplayName,Message |
Format-List

openssl s_client -connect <mainframe-host>:2489 -servername <mainframe-host>

openssl s_client -connect <mainframe-host>:2489 -tls1_3


```powershell
#requires -version 5.1

<#
.SYNOPSIS
    Tests TLS connectivity from a CyberArk CPM server to a target host/port.

.DESCRIPTION
    - Tests TCP connectivity.
    - Attempts TLS 1.0, TLS 1.1, and TLS 1.2.
    - Displays negotiated TLS protocol.
    - Displays negotiated cipher information where available.
    - Displays server certificate Subject, Issuer, Thumbprint, and validity.
    - Useful for comparing a working and failing Mainframe LDAP/TLS endpoint.

.NOTES
    Compatible with Windows PowerShell 5.1.
#>

param(
    [string]$TargetHost = "CHANGE-ME-HOSTNAME",
    [int]$Port = 2489
)

Write-Host ""
Write-Host "============================================================"
Write-Host " CyberArk CPM TLS Connectivity Test"
Write-Host "============================================================"
Write-Host "Target : $TargetHost"
Write-Host "Port   : $Port"
Write-Host "Time   : $(Get-Date)"
Write-Host "============================================================"
Write-Host ""

# ------------------------------------------------------------
# TCP Connectivity
# ------------------------------------------------------------

Write-Host "[1] Testing TCP connectivity..." -ForegroundColor Cyan

try {
    $tnc = Test-NetConnection -ComputerName $TargetHost -Port $Port -WarningAction SilentlyContinue

    if ($tnc.TcpTestSucceeded) {
        Write-Host "TCP connection: SUCCESS" -ForegroundColor Green
    }
    else {
        Write-Host "TCP connection: FAILED" -ForegroundColor Red
        Write-Host "Cannot continue TLS testing."
        exit 1
    }
}
catch {
    Write-Host "TCP test failed: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}

Write-Host ""

# ------------------------------------------------------------
# TLS Test Function
# ------------------------------------------------------------

function Test-TlsProtocol {

    param(
        [string]$HostName,
        [int]$PortNumber,
        [System.Security.Authentication.SslProtocols]$Protocol,
        [string]$ProtocolName
    )

    Write-Host "------------------------------------------------------------"
    Write-Host "Testing $ProtocolName" -ForegroundColor Yellow
    Write-Host "------------------------------------------------------------"

    $tcp = $null
    $ssl = $null

    try {

        $tcp = New-Object System.Net.Sockets.TcpClient

        # 10-second connection timeout
        $async = $tcp.BeginConnect($HostName, $PortNumber, $null, $null)

        if (-not $async.AsyncWaitHandle.WaitOne(10000)) {
            throw "TCP connection timed out."
        }

        $tcp.EndConnect($async)

        $ssl = New-Object System.Net.Security.SslStream(
            $tcp.GetStream(),
            $false,
            {
                param($sender,$certificate,$chain,$sslPolicyErrors)

                # Allow handshake so we can inspect the certificate.
                return $true
            }
        )

        $ssl.AuthenticateAsClient(
            $HostName,
            $null,
            $Protocol,
            $false
        )

        Write-Host "Result              : SUCCESS" -ForegroundColor Green
        Write-Host "Requested Protocol  : $ProtocolName"
        Write-Host "Negotiated Protocol : $($ssl.SslProtocol)"
        Write-Host "Cipher Algorithm    : $($ssl.CipherAlgorithm)"
        Write-Host "Cipher Strength     : $($ssl.CipherStrength)"
        Write-Host "Hash Algorithm      : $($ssl.HashAlgorithm)"
        Write-Host "Hash Strength       : $($ssl.HashStrength)"
        Write-Host "Key Exchange        : $($ssl.KeyExchangeAlgorithm)"
        Write-Host "Key Exchange Strength: $($ssl.KeyExchangeStrength)"

        if ($ssl.RemoteCertificate) {

            $cert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2($ssl.RemoteCertificate)

            Write-Host ""
            Write-Host "Server Certificate:"
            Write-Host "  Subject     : $($cert.Subject)"
            Write-Host "  Issuer      : $($cert.Issuer)"
            Write-Host "  Thumbprint  : $($cert.Thumbprint)"
            Write-Host "  Serial      : $($cert.SerialNumber)"
            Write-Host "  Not Before  : $($cert.NotBefore)"
            Write-Host "  Not After   : $($cert.NotAfter)"

            if ($cert.NotAfter -lt (Get-Date)) {
                Write-Host "  Status      : EXPIRED" -ForegroundColor Red
            }
            elseif ($cert.NotBefore -gt (Get-Date)) {
                Write-Host "  Status      : NOT YET VALID" -ForegroundColor Red
            }
            else {
                Write-Host "  Status      : VALID" -ForegroundColor Green
            }
        }
    }
    catch {

        Write-Host "Result              : FAILED" -ForegroundColor Red
        Write-Host "Requested Protocol  : $ProtocolName"
        Write-Host "Error               : $($_.Exception.Message)"

        if ($_.Exception.InnerException) {
            Write-Host "Inner Error         : $($_.Exception.InnerException.Message)"
        }
    }
    finally {

        if ($ssl) {
            try { $ssl.Dispose() } catch {}
        }

        if ($tcp) {
            try { $tcp.Close() } catch {}
        }
    }

    Write-Host ""
}

# ------------------------------------------------------------
# TLS Protocol Tests
# ------------------------------------------------------------

Write-Host "[2] Testing TLS protocol versions..." -ForegroundColor Cyan
Write-Host ""

Test-TlsProtocol `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls) `
    -ProtocolName "TLS 1.0"

Test-TlsProtocol `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls11) `
    -ProtocolName "TLS 1.1"

Test-TlsProtocol `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls12) `
    -ProtocolName "TLS 1.2"

# ------------------------------------------------------------
# Schannel Configuration
# ------------------------------------------------------------

Write-Host "============================================================"
Write-Host "[3] Local Windows Schannel protocol configuration"
Write-Host "============================================================"

$schannelPath = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols"

if (Test-Path $schannelPath) {

    Get-ChildItem $schannelPath -Recurse -ErrorAction SilentlyContinue |
    ForEach-Object {

        $props = Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue

        if ($null -ne $props.Enabled -or $null -ne $props.DisabledByDefault) {

            [PSCustomObject]@{
                Path              = $_.PSPath -replace "Microsoft.PowerShell.Core\\Registry::",""
                Enabled           = $props.Enabled
                DisabledByDefault = $props.DisabledByDefault
            }
        }
    } | Format-Table -AutoSize
}
else {
    Write-Host "No explicit Schannel protocol registry configuration found."
    Write-Host "Windows defaults may be in use."
}

# ------------------------------------------------------------
# Recent Schannel Events
# ------------------------------------------------------------

Write-Host ""
Write-Host "============================================================"
Write-Host "[4] Recent Schannel events - Last 15 minutes"
Write-Host "============================================================"

try {

    $events = Get-WinEvent -FilterHashtable @{
        LogName      = 'System'
        ProviderName = 'Schannel'
        StartTime    = (Get-Date).AddMinutes(-15)
    } -ErrorAction Stop

    if ($events) {

        $events |
        Select-Object TimeCreated,Id,LevelDisplayName,Message |
        Format-List
    }
    else {
        Write-Host "No recent Schannel events found."
    }
}
catch {
    Write-Host "No recent Schannel events found or Schannel query failed."
}

Write-Host ""
Write-Host "============================================================"
Write-Host " TLS test completed"
Write-Host "============================================================"
```
