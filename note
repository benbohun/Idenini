[CmdletBinding()]
param(
    [string]$CsvPath                = "E:\Installation Media\Script\OnboardScript\csv\OverrideComponentPlatform.csv",
    [string]$OutputRoot             = "E:\Installation Media\Script\OnboardScript\logs\Platform_HTML5_Override",
    [switch]$WhatIf,
    [switch]$UseSingleBlockFallback = $true
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$OverrideParam = [ordered]@{
    Name                        = "AllowSelectHTML5"
    DisplayName                 = "Connect Via Browser"
    Visible                     = "Yes"
    Type                        = "CyberArk.TransparentConnection.BooleanUserParameter, CyberArk.PasswordVault.TransparentConnection"
    Required                    = "Yes"
    Value                       = "No"
    EnforceInDualControlRequest = "No"
}

try {
    Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
}
catch {}

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet("Gray","Green","Yellow","Red","Cyan","White","Magenta")]
        [string]$Color = "White"
    )

    $stamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Host ("{0} | {1}" -f $stamp, $Message) -ForegroundColor $Color
}

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
}
catch {
    Write-Log ("ERROR: psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

$CCPAddress      = "https://vskau1p1231.cna.com"
$CCPLocation     = "AIMWebService"
$CCPAppID        = "PAMDiscovery"
$CCPSafe         = "CA_PCloud_Admins"
$CCPObject       = "cna.com-CA_PAMDiscovery_SVC"
$ServiceUPUser   = "CA_PAMDiscovery_SVC"
$CCPWindowsAuth  = $false

$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

$BackupRoot  = Join-Path $OutputRoot "Backups"
$WorkRoot    = Join-Path $OutputRoot "Work"
$ReportRoot  = Join-Path $OutputRoot "Reports"

foreach ($folder in @($OutputRoot, $BackupRoot, $WorkRoot, $ReportRoot)) {
    if (-not (Test-Path -LiteralPath $folder)) {
        $null = New-Item -Path $folder -ItemType Directory -Force
    }
}

function Get-SafeFileName {
    param([Parameter(Mandatory)][string]$Name)
    return ($Name -replace '[\\/:*?"<>|]', '_')
}

function Get-OptionalCsvValue {
    param(
        [Parameter(Mandatory)]$Row,
        [Parameter(Mandatory)][string]$ColumnName
    )

    $prop = $Row.PSObject.Properties[$ColumnName]
    if ($null -eq $prop) { return $null }

    $value = [string]$prop.Value
    if ([string]::IsNullOrWhiteSpace($value)) { return $null }

    return $value.Trim()
}

function Normalize-Token {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) { return "" }
    return (($Value.ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function Set-XmlAttribute {
    param(
        [Parameter(Mandatory)][System.Xml.XmlElement]$Element,
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Value
    )

    $existing = $Element.GetAttributeNode($Name)
    if ($null -eq $existing) {
        $attr = $Element.OwnerDocument.CreateAttribute($Name)
        $attr.Value = $Value
        [void]$Element.Attributes.Append($attr)
    }
    else {
        $existing.Value = $Value
    }
}

function Get-NodeContextStrings {
    param(
        [Parameter(Mandatory)][System.Xml.XmlNode]$Node
    )

    $list = New-Object System.Collections.Generic.List[string]
    $current = $Node

    while ($null -ne $current) {
        if ($null -ne $current.Attributes) {
            foreach ($attrName in @("Name","ID","Id","ComponentName","ConnectionComponent","PSMConnectorID","ConnectorID","DisplayName")) {
                $attr = $current.Attributes[$attrName]
                if ($null -ne $attr -and -not [string]::IsNullOrWhiteSpace($attr.Value)) {
                    $value = $attr.Value.Trim()
                    if (-not $list.Contains($value)) {
                        $list.Add($value)
                    }
                }
            }
        }
        $current = $current.ParentNode
    }

    return @($list)
}

function Test-XmlContextMatch {
    param(
        [Parameter(Mandatory)][System.Xml.XmlNode]$Node,
        [string]$ConnectionComponentName
    )

    if ([string]::IsNullOrWhiteSpace($ConnectionComponentName)) {
        return $true
    }

    $needle = Normalize-Token $ConnectionComponentName
    if ([string]::IsNullOrWhiteSpace($needle)) {
        return $true
    }

    $contexts = @(Get-NodeContextStrings -Node $Node)
    foreach ($ctx in $contexts) {
        $nctx = Normalize-Token $ctx
        if ([string]::IsNullOrWhiteSpace($nctx)) { continue }

        if ($nctx -eq $needle) { return $true }
        if ($nctx.Contains($needle)) { return $true }
        if ($needle.Contains($nctx)) { return $true }
    }

    return $false
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $headers = @{ "Content-Type" = "application/json" }
    $ccpUrl  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"
    Write-Log ("CCP URL: {0}" -f $ccpUrl) "Gray"

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    Write-Log ("CCP secret retrieved successfully for: {0}" -f $UPUser) "Green"

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred `
        -ErrorAction Stop

    Use-PASSession $headerSession | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

function Invoke-PlatformRest {
    param(
        [Parameter(Mandatory)]
        [ValidateSet("GET","POST","PATCH","DELETE")]
        [string]$Method,

        [Parameter(Mandatory)]
        [string]$RelativePath,

        [object]$Body,

        [switch]$UseLowercaseApi
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $rel = $RelativePath.TrimStart('/')
    if ($UseLowercaseApi) {
        $rel = $rel -replace '^API/', 'api/'
    }

    $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}" -f $PCloudSubdomain, $rel

    $params = @{
        Uri         = $uri
        Method      = $Method
        WebSession  = $s.WebSession
        ErrorAction = "Stop"
    }

    if ($null -ne $Body) {
        $params["ContentType"] = "application/json"
        $params["Body"]        = ($Body | ConvertTo-Json -Depth 50 -Compress)
    }

    try {
        return Invoke-RestMethod @params
    }
    catch {
        if (-not $UseLowercaseApi -and $rel -match '^API/') {
            Write-Log ("Primary API path failed, retrying lowercase path. Reason: {0}" -f $_.Exception.Message) "Yellow"
            return Invoke-PlatformRest -Method $Method -RelativePath $RelativePath -Body $Body -UseLowercaseApi
        }
        throw
    }
}

function Invoke-PlatformDownload {
    param(
        [Parameter(Mandatory)]
        [ValidateSet("GET","POST")]
        [string]$Method,

        [Parameter(Mandatory)]
        [string]$RelativePath,

        [Parameter(Mandatory)]
        [string]$OutFile,

        [switch]$UseLowercaseApi
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $rel = $RelativePath.TrimStart('/')
    if ($UseLowercaseApi) {
        $rel = $rel -replace '^API/', 'api/'
    }

    $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}" -f $PCloudSubdomain, $rel

    $params = @{
        Uri         = $uri
        Method      = $Method
        WebSession  = $s.WebSession
        OutFile     = $OutFile
        ErrorAction = "Stop"
    }

    try {
        Invoke-WebRequest @params | Out-Null
        return $OutFile
    }
    catch {
        if (-not $UseLowercaseApi -and $rel -match '^API/') {
            Write-Log ("Primary download path failed, retrying lowercase path. Reason: {0}" -f $_.Exception.Message) "Yellow"
            return Invoke-PlatformDownload -Method $Method -RelativePath $RelativePath -OutFile $OutFile -UseLowercaseApi
        }
        throw
    }
}

function Get-PlatformDetails {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)
    return Invoke-PlatformRest -Method GET -RelativePath ("API/Platforms/{0}/" -f $encodedPlatformID)
}

function Export-PlatformZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$DestinationFolder
    )

    $safeName = Get-SafeFileName -Name $PlatformID
    $stamp    = Get-Date -Format "yyyyMMdd_HHmmss"
    $zipPath  = Join-Path $DestinationFolder ("{0}_{1}.zip" -f $safeName, $stamp)

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)
    Write-Log ("Exporting platform package for [{0}]..." -f $PlatformID) "Cyan"

    Invoke-PlatformDownload -Method POST -RelativePath ("API/Platforms/{0}/Export/" -f $encodedPlatformID) -OutFile $zipPath | Out-Null

    if (-not (Test-Path -LiteralPath $zipPath)) {
        throw "Platform export did not create ZIP file for [$PlatformID]."
    }

    Write-Log ("Platform package exported: {0}" -f $zipPath) "Green"
    return $zipPath
}

function Import-PlatformZipToStorage {
    param(
        [Parameter(Mandatory)][string]$ZipPath
    )

    if (-not (Test-Path -LiteralPath $ZipPath)) {
        throw "ZIP path not found: $ZipPath"
    }

    $bytes  = [System.IO.File]::ReadAllBytes($ZipPath)
    $base64 = [System.Convert]::ToBase64String($bytes)

    Write-Log ("Importing modified platform ZIP to stored-platform memory: {0}" -f $ZipPath) "Cyan"

    return Invoke-PlatformRest -Method POST -RelativePath "API/Platforms/Import/" -Body @{ ImportFile = $base64 }
}

function Get-StoredPlatformDetails {
    return Invoke-PlatformRest -Method GET -RelativePath "API/Platforms/Storage"
}

function Update-PlatformWithStored {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)
    Write-Log ("Overwriting existing platform [{0}] with stored platform..." -f $PlatformID) "Cyan"

    return Invoke-PlatformRest -Method POST -RelativePath ("API/Platforms/{0}/Update" -f $encodedPlatformID)
}

function Clear-StoredPlatform {
    try {
        Invoke-PlatformRest -Method DELETE -RelativePath "API/Platforms/Storage" | Out-Null
        Write-Log "Cleared stored platform memory." "Gray"
    }
    catch {
        $msg = $_.Exception.Message
        if ($msg -match '\(400\)') {
            Write-Log "Stored platform clear returned 400. Continuing." "Gray"
        }
        else {
            Write-Log ("Stored platform clear skipped: {0}" -f $msg) "Gray"
        }
    }
}

function Update-AllowSelectHTML5InXmlFile {
    param(
        [Parameter(Mandatory)][string]$XmlPath,
        [string]$ConnectionComponentName,
        [switch]$UseSingleBlockFallback
    )

    [xml]$xml = Get-Content -LiteralPath $XmlPath -Raw

    $changed       = $false
    $updatedNodes  = 0
    $addedNodes    = 0
    $blocksTouched = 0

    $userParamBlocks = @($xml.SelectNodes("//*[local-name()='UserParameters']"))
    if (-not $userParamBlocks -or $userParamBlocks.Count -eq 0) {
        return [pscustomobject]@{
            Changed            = $false
            UpdatedNodes       = 0
            AddedNodes         = 0
            BlocksTouched      = 0
            ContextsDiscovered = @()
        }
    }

    $contextsDiscovered = New-Object System.Collections.Generic.List[string]
    $matchedBlocks = New-Object System.Collections.Generic.List[System.Xml.XmlNode]

    foreach ($block in $userParamBlocks) {
        $contexts = @(Get-NodeContextStrings -Node $block)
        if ($contexts.Count -gt 0) {
            $joined = ($contexts -join " | ")
            if (-not $contextsDiscovered.Contains($joined)) {
                $contextsDiscovered.Add($joined)
            }
        }

        if (Test-XmlContextMatch -Node $block -ConnectionComponentName $ConnectionComponentName) {
            $matchedBlocks.Add($block)
        }
    }

    if ($matchedBlocks.Count -eq 0 -and $UseSingleBlockFallback -and $userParamBlocks.Count -eq 1) {
        Write-Log ("No component match found in [{0}], but only one UserParameters block exists. Using single-block fallback." -f $XmlPath) "Yellow"
        $matchedBlocks.Add($userParamBlocks[0])
    }

    foreach ($block in $matchedBlocks) {
        $existingInBlock = @($block.SelectNodes("./*[local-name()='Parameter' and @Name='AllowSelectHTML5']"))

        if ($existingInBlock.Count -gt 0) {
            foreach ($node in $existingInBlock) {
                $element = [System.Xml.XmlElement]$node
                Set-XmlAttribute -Element $element -Name "Name" -Value $OverrideParam.Name
                Set-XmlAttribute -Element $element -Name "DisplayName" -Value $OverrideParam.DisplayName
                Set-XmlAttribute -Element $element -Name "Visible" -Value $OverrideParam.Visible
                Set-XmlAttribute -Element $element -Name "Type" -Value $OverrideParam.Type
                Set-XmlAttribute -Element $element -Name "Required" -Value $OverrideParam.Required
                Set-XmlAttribute -Element $element -Name "Value" -Value $OverrideParam.Value
                Set-XmlAttribute -Element $element -Name "EnforceInDualControlRequest" -Value $OverrideParam.EnforceInDualControlRequest
                $changed = $true
                $updatedNodes++
            }
            $blocksTouched++
            continue
        }

        $templateNode = $block.SelectSingleNode("./*[local-name()='Parameter' and @Name='AllowMappingLocalDrives']")
        $newNode = $null

        if ($null -ne $templateNode) {
            $newNode = $templateNode.CloneNode($true)
        }
        else {
            if ([string]::IsNullOrWhiteSpace($block.NamespaceURI)) {
                $newNode = $xml.CreateElement("Parameter")
            }
            else {
                $newNode = $xml.CreateElement("Parameter", $block.NamespaceURI)
            }
        }

        $newElement = [System.Xml.XmlElement]$newNode
        Set-XmlAttribute -Element $newElement -Name "Name" -Value $OverrideParam.Name
        Set-XmlAttribute -Element $newElement -Name "DisplayName" -Value $OverrideParam.DisplayName
        Set-XmlAttribute -Element $newElement -Name "Visible" -Value $OverrideParam.Visible
        Set-XmlAttribute -Element $newElement -Name "Type" -Value $OverrideParam.Type
        Set-XmlAttribute -Element $newElement -Name "Required" -Value $OverrideParam.Required
        Set-XmlAttribute -Element $newElement -Name "Value" -Value $OverrideParam.Value
        Set-XmlAttribute -Element $newElement -Name "EnforceInDualControlRequest" -Value $OverrideParam.EnforceInDualControlRequest

        [void]$block.AppendChild($newElement)
        $changed = $true
        $addedNodes++
        $blocksTouched++
    }

    if ($changed) {
        $xml.Save($XmlPath)
    }

    return [pscustomobject]@{
        Changed            = $changed
        UpdatedNodes       = $updatedNodes
        AddedNodes         = $addedNodes
        BlocksTouched      = $blocksTouched
        ContextsDiscovered = @($contextsDiscovered)
    }
}

function Update-PlatformPackage {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$InputZip,
        [Parameter(Mandatory)][string]$WorkingRoot,
        [string]$ConnectionComponentName,
        [switch]$UseSingleBlockFallback
    )

    if (-not (Test-Path -LiteralPath $InputZip)) {
        throw "Input ZIP not found: $InputZip"
    }

    $safeName    = Get-SafeFileName -Name $PlatformID
    $extractDir  = Join-Path $WorkingRoot ("Extract_{0}_{1}" -f $safeName, ([guid]::NewGuid().ToString("N")))
    $modifiedZip = Join-Path $WorkingRoot ("{0}_modified_{1}.zip" -f $safeName, (Get-Date -Format "yyyyMMdd_HHmmss"))

    if (Test-Path -LiteralPath $extractDir) {
        Remove-Item -LiteralPath $extractDir -Recurse -Force
    }

    $null = New-Item -Path $extractDir -ItemType Directory -Force

    try {
        [System.IO.Compression.ZipFile]::ExtractToDirectory($InputZip, $extractDir)

        $xmlFiles = @(Get-ChildItem -LiteralPath $extractDir -Recurse -File -Filter "*.xml")
        if (-not $xmlFiles -or $xmlFiles.Count -eq 0) {
            throw "No XML files found in exported package."
        }

        $xmlFilesChanged = 0
        $updatedNodes    = 0
        $addedNodes      = 0
        $blocksTouched   = 0
        $allContexts     = New-Object System.Collections.Generic.List[string]

        foreach ($xmlFile in $xmlFiles) {
            $result = Update-AllowSelectHTML5InXmlFile `
                -XmlPath $xmlFile.FullName `
                -ConnectionComponentName $ConnectionComponentName `
                -UseSingleBlockFallback:$UseSingleBlockFallback

            foreach ($ctx in @($result.ContextsDiscovered)) {
                if (-not [string]::IsNullOrWhiteSpace($ctx) -and -not $allContexts.Contains($ctx)) {
                    $allContexts.Add($ctx)
                }
            }

            if ($result.Changed) {
                $xmlFilesChanged++
                $updatedNodes  += $result.UpdatedNodes
                $addedNodes    += $result.AddedNodes
                $blocksTouched += $result.BlocksTouched
                Write-Log ("Updated XML: {0}" -f $xmlFile.FullName) "Gray"
            }
        }

        if (($updatedNodes + $addedNodes) -lt 1) {
            $msg = "No eligible UserParameters block was updated in exported package for [$PlatformID]."
            if ($ConnectionComponentName) {
                $msg += " Component filter used: [$ConnectionComponentName]."
            }

            if ($allContexts.Count -gt 0) {
                $msg += " Discovered component contexts: " + (($allContexts | Select-Object -First 10) -join " || ")
            }
            else {
                $msg += " No UserParameters component contexts were discovered."
            }

            throw $msg
        }

        if (Test-Path -LiteralPath $modifiedZip) {
            Remove-Item -LiteralPath $modifiedZip -Force
        }

        [System.IO.Compression.ZipFile]::CreateFromDirectory($extractDir, $modifiedZip)

        return [pscustomobject]@{
            ModifiedZip      = $modifiedZip
            XmlFilesChanged  = $xmlFilesChanged
            UpdatedNodes     = $updatedNodes
            AddedNodes       = $addedNodes
            BlocksTouched    = $blocksTouched
            ContextsFound    = @($allContexts)
        }
    }
    finally {
        if (Test-Path -LiteralPath $extractDir) {
            Remove-Item -LiteralPath $extractDir -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

Write-Log ("Using embedded CSV path: {0}" -f $CsvPath) "Cyan"

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "CSV not found: $CsvPath"
}

$rows = @(Import-Csv -LiteralPath $CsvPath)

if (-not $rows -or @($rows).Count -eq 0) {
    throw "CSV is empty: $CsvPath"
}

if (-not ($rows[0].PSObject.Properties.Name -contains "PlatformID")) {
    throw "CSV must contain a column named 'PlatformID'. Optional column: 'ConnectionComponentName'."
}

$rows = @($rows | Where-Object { -not [string]::IsNullOrWhiteSpace($_.PlatformID) })

if (-not $rows -or @($rows).Count -eq 0) {
    throw "CSV contains no usable PlatformID values."
}

$reportItems = New-Object System.Collections.Generic.List[object]

Write-Log ("CSV loaded successfully. Platforms to process: {0}" -f @($rows).Count) "Green"
Write-Log ("Output root: {0}" -f $OutputRoot) "Gray"

try {
    Start-PASSessionFromCCP -ObjectName $CCPObject -UPUser $ServiceUPUser

    $counter = 0
    foreach ($row in $rows) {
        $counter++
        $platformID    = ([string]$row.PlatformID).Trim()
        $componentName = Get-OptionalCsvValue -Row $row -ColumnName "ConnectionComponentName"

        $report = [ordered]@{
            Timestamp               = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            PlatformID              = $platformID
            ConnectionComponentName = $componentName
            BackupZip               = ""
            ModifiedZip             = ""
            XmlFilesChanged         = 0
            UserParamBlocksTouched  = 0
            UpdatedNodes            = 0
            AddedNodes              = 0
            ContextsFound           = ""
            Result                  = ""
            Error                   = ""
        }

        Write-Log ("[{0}/{1}] Processing platform [{2}]..." -f $counter, @($rows).Count, $platformID) "Magenta"
        if ($componentName) {
            Write-Log ("Connection component filter: {0}" -f $componentName) "Gray"
        }
        else {
            Write-Log "No ConnectionComponentName provided. All eligible UserParameters sections in the package will be updated." "Gray"
        }

        try {
            Clear-StoredPlatform

            $null = Get-PlatformDetails -PlatformID $platformID

            $exportZip = Export-PlatformZip -PlatformID $platformID -DestinationFolder $BackupRoot
            $report.BackupZip = $exportZip

            $packageUpdate = Update-PlatformPackage `
                -PlatformID $platformID `
                -InputZip $exportZip `
                -WorkingRoot $WorkRoot `
                -ConnectionComponentName $componentName `
                -UseSingleBlockFallback:$UseSingleBlockFallback

            $report.ModifiedZip            = $packageUpdate.ModifiedZip
            $report.XmlFilesChanged        = $packageUpdate.XmlFilesChanged
            $report.UserParamBlocksTouched = $packageUpdate.BlocksTouched
            $report.UpdatedNodes           = $packageUpdate.UpdatedNodes
            $report.AddedNodes             = $packageUpdate.AddedNodes
            $report.ContextsFound          = (@($packageUpdate.ContextsFound) -join " || ")

            Write-Log ("Package modified successfully. XML files changed: {0}; Updated nodes: {1}; Added nodes: {2}" -f `
                $packageUpdate.XmlFilesChanged, $packageUpdate.UpdatedNodes, $packageUpdate.AddedNodes) "Green"

            if ($report.ContextsFound) {
                Write-Log ("Discovered component contexts: {0}" -f $report.ContextsFound) "Gray"
            }

            if ($WhatIf) {
                Write-Log "WHATIF enabled. Skipping import and platform overwrite." "Yellow"
                $report.Result = "WHATIF_ONLY"
            }
            else {
                $null = Import-PlatformZipToStorage -ZipPath $packageUpdate.ModifiedZip

                $storage = Get-StoredPlatformDetails
                if ($null -eq $storage -or $null -eq $storage.StoredPlatformDetails) {
                    throw "Stored platform details were not returned after import."
                }

                Write-Log ("Stored platform in memory: Id=[{0}] Name=[{1}] Version=[{2}]" -f `
                    $storage.StoredPlatformDetails.Id,
                    $storage.StoredPlatformDetails.Name,
                    $storage.StoredPlatformDetails.Version) "Gray"

                $null = Update-PlatformWithStored -PlatformID $platformID

                Write-Log ("Platform [{0}] updated successfully." -f $platformID) "Green"
                $report.Result = "UPDATED"
            }
        }
        catch {
            $report.Result = "FAILED"
            $report.Error  = $_.Exception.Message
            Write-Log ("FAILED for [{0}]: {1}" -f $platformID, $_.Exception.Message) "Red"
        }
        finally {
            try { Clear-StoredPlatform } catch {}
            $reportItems.Add([pscustomobject]$report)
        }
    }
}
finally {
    try {
        if (Get-Command Close-PASSession -ErrorAction SilentlyContinue) {
            Close-PASSession | Out-Null
            Write-Log "PAS session closed." "Gray"
        }
    }
    catch {
        Write-Log ("Session close warning: {0}" -f $_.Exception.Message) "Yellow"
    }
}

$reportPath = Join-Path $ReportRoot ("Platform_HTML5_Override_Report_{0}.csv" -f (Get-Date -Format "yyyyMMdd_HHmmss"))
$reportItems | Export-Csv -LiteralPath $reportPath -NoTypeInformation -Encoding UTF8

Write-Log ("Report exported: {0}" -f $reportPath) "Green"

$success = @($reportItems | Where-Object { $_.Result -eq "UPDATED" -or $_.Result -eq "WHATIF_ONLY" }).Count
$failed  = @($reportItems | Where-Object { $_.Result -eq "FAILED" }).Count

Write-Log ("Completed. Success/WhatIf: {0} | Failed: {1}" -f $success, $failed) "Cyan"
