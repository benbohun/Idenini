<#
Set-OraclePath-CPM.ps1

Purpose:
- Set Oracle Instant Client 21_18 first in Machine PATH
- Remove duplicate/old Oracle instantclient PATH entries
- Set TNS_ADMIN
- Validate Oracle client visibility

Run as Administrator.
#>

[CmdletBinding()]
param(
    [string]$OracleInstantClientPath = "E:\oracle\instantclient_21_18",
    [string]$TnsAdminPath = "E:\oracle\instantclient_21_18\network\admin",
    [switch]$ClearOracleHome
)

$ErrorActionPreference = "Stop"

function Write-Info {
    param([string]$Message)
    Write-Host "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') | INFO | $Message" -ForegroundColor Cyan
}

function Write-OK {
    param([string]$Message)
    Write-Host "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') | OK   | $Message" -ForegroundColor Green
}

function Write-WarnMsg {
    param([string]$Message)
    Write-Host "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') | WARN | $Message" -ForegroundColor Yellow
}

# Confirm elevated PowerShell
$Identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw "Run PowerShell as Administrator."
}

$OracleInstantClientPath = $OracleInstantClientPath.TrimEnd("\")
$TnsAdminPath = $TnsAdminPath.TrimEnd("\")

Write-Info "Oracle Instant Client Path: $OracleInstantClientPath"
Write-Info "TNS_ADMIN Path             : $TnsAdminPath"

if (-not (Test-Path -LiteralPath $OracleInstantClientPath -PathType Container)) {
    throw "Oracle Instant Client folder not found: $OracleInstantClientPath"
}

# Validate core Oracle files
$FilesToCheck = @(
    "oci.dll",
    "oraociei.dll",
    "odbc_install.exe",
    "sqora32.dll",
    "sqoras32.dll"
)

foreach ($File in $FilesToCheck) {
    $FullPath = Join-Path $OracleInstantClientPath $File

    if (Test-Path -LiteralPath $FullPath -PathType Leaf) {
        Write-OK "Found: $FullPath"
    } else {
        Write-WarnMsg "Missing: $FullPath"
    }
}

# Create TNS_ADMIN folder
if (-not (Test-Path -LiteralPath $TnsAdminPath -PathType Container)) {
    New-Item -ItemType Directory -Path $TnsAdminPath -Force | Out-Null
    Write-OK "Created TNS_ADMIN folder: $TnsAdminPath"
}

# Backup existing Machine PATH
New-Item -ItemType Directory -Path "C:\Temp" -Force | Out-Null

$CurrentMachinePath = [Environment]::GetEnvironmentVariable("PATH", "Machine")
$BackupFile = "C:\Temp\MachinePath_Backup_$(Get-Date -Format 'yyyyMMdd_HHmmss').txt"

$CurrentMachinePath | Out-File -FilePath $BackupFile -Encoding UTF8

Write-OK "Backed up current Machine PATH to: $BackupFile"

# Remove old Oracle instantclient entries
$PathItems = $CurrentMachinePath -split ";" |
    ForEach-Object { $_.Trim() } |
    Where-Object { $_ -ne "" }

$CleanedPathItems = $PathItems | Where-Object {
    $_ -notmatch "(?i)\\oracle\\instantclient"
}

# Put preferred Oracle path first
$NewPathItems = @($OracleInstantClientPath) + $CleanedPathItems

# Remove duplicates
$FinalPathItems = New-Object System.Collections.Generic.List[string]

foreach ($Item in $NewPathItems) {
    $CleanItem = $Item.TrimEnd("\")

    if ([string]::IsNullOrWhiteSpace($CleanItem)) {
        continue
    }

    $Exists = $false

    foreach ($Existing in $FinalPathItems) {
        if ($Existing.TrimEnd("\") -ieq $CleanItem) {
            $Exists = $true
            break
        }
    }

    if (-not $Exists) {
        $FinalPathItems.Add($CleanItem)
    }
}

$NewMachinePath = $FinalPathItems -join ";"

[Environment]::SetEnvironmentVariable("PATH", $NewMachinePath, "Machine")
$env:PATH = "$OracleInstantClientPath;$env:PATH"

Write-OK "Updated Machine PATH. Oracle Instant Client is now first: $OracleInstantClientPath"

# Set TNS_ADMIN
[Environment]::SetEnvironmentVariable("TNS_ADMIN", $TnsAdminPath, "Machine")
$env:TNS_ADMIN = $TnsAdminPath

Write-OK "Set Machine TNS_ADMIN to: $TnsAdminPath"

# Optional ORACLE_HOME cleanup
if ($ClearOracleHome) {
    [Environment]::SetEnvironmentVariable("ORACLE_HOME", $null, "Machine")
    Remove-Item Env:\ORACLE_HOME -ErrorAction SilentlyContinue
    Write-OK "Cleared Machine ORACLE_HOME."
} else {
    $OracleHome = [Environment]::GetEnvironmentVariable("ORACLE_HOME", "Machine")

    if (-not [string]::IsNullOrWhiteSpace($OracleHome)) {
        Write-WarnMsg "ORACLE_HOME is currently set to: $OracleHome"
        Write-WarnMsg "Instant Client usually does not require ORACLE_HOME."
    }
}

Write-Host ""
Write-Host "===== VALIDATION =====" -ForegroundColor Cyan

Write-Host ""
Write-Host "Oracle entries in Machine PATH:" -ForegroundColor Cyan
([Environment]::GetEnvironmentVariable("PATH", "Machine") -split ";") |
    Where-Object { $_ -match "(?i)oracle|instantclient" } |
    ForEach-Object { Write-Host $_ }

Write-Host ""
Write-Host "TNS_ADMIN:" -ForegroundColor Cyan
Write-Host ([Environment]::GetEnvironmentVariable("TNS_ADMIN", "Machine"))

Write-Host ""
Write-Host "where.exe oci.dll:" -ForegroundColor Cyan
where.exe oci.dll 2>$null

Write-Host ""
Write-Host "where.exe odbc_install.exe:" -ForegroundColor Cyan
where.exe odbc_install.exe 2>$null

Write-Host ""
Write-Host "Oracle ODBC drivers:" -ForegroundColor Cyan
try {
    Get-OdbcDriver | Where-Object {
        $_.Name -match "Oracle"
    } | Select-Object Name, Platform | Format-Table -AutoSize
} catch {
    Write-WarnMsg "Could not query ODBC drivers using Get-OdbcDriver."
}

Write-Host ""
Write-OK "Oracle PATH configuration completed."
Write-WarnMsg "Restart CyberArk CPM services or reboot the server before Oracle Verify/Change testing."
