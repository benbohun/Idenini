<# 
Delete APP_NetSecEngOps_BreakGlass_Remote when a NET_CiscoIOS exists
for the SAME Safe + Username + Address.

Safe example: APP_NetSecEngOps_BreakGlass
Usernames: bg_CAADMIN, lcl_nseo_ops
Address example: 10.74.8.40
Object name examples:
  Application-APP_NetSecEngOps_BreakGlass_Remote-10.74.8.40-bg_CAADMIN
  Network Device-NET_CiscoIOS-10.74.8.40-bg_CAADMIN
#>

[CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact='High')]
param(
  [string]$BaseURI = "https://alliantcredit.privilegecloud.cyberark.com",
  [ValidateSet('CyberArk','LDAP','RADIUS','Windows','SAML','Shared')]
  [string]$AuthType = 'CyberArk',

  # focus usernames
  [string[]]$TargetUsernames = @('bg_CAADMIN','lcl_nseo_ops'),

  # target safe (both examples live here)
  [string]$TargetSafe = 'APP_NetSecEngOps_BreakGlass',

  # platform identifiers (display names)
  [string]$PlatformApp = 'APP_NetSecEngOps_BreakGlass_Remote',
  [string]$PlatformNet = 'NET_CiscoIOS'
)

Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

function Write-Info($m){ Write-Host "[*] $m" -ForegroundColor Cyan }
function Write-Ok($m){ Write-Host "[OK] $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[!] $m" -ForegroundColor Yellow }
function Write-Err($m){ Write-Host "[X] $m" -ForegroundColor Red }

# Matchers that tolerate platformId/platformName/name inconsistencies
function Is-AppPlatform($acc, [string]$PlatformApp){
  ($acc.platformId   -eq $PlatformApp) -or
  ($acc.platformName -eq $PlatformApp) -or
  ($acc.name -like "*-$PlatformApp-*")
}
function Is-NetPlatform($acc, [string]$PlatformNet){
  ($acc.platformId   -eq $PlatformNet) -or
  ($acc.platformName -eq $PlatformNet) -or
  ($acc.name -like "*-$PlatformNet-*")
}

# Normalize address (trim/case)
function NormAddr([string]$a){
  if ([string]::IsNullOrWhiteSpace($a)) { return $null }
  return $a.Trim().ToLower()
}

# ---- Login
$cred = Get-Credential -Message "Enter your CyberArk ($AuthType) credential"
try {
  New-PASSession -Credential $cred -BaseURI $BaseURI -Type $AuthType | Out-Null
  Write-Ok "Authenticated to $BaseURI ($AuthType)."
} catch { Write-Err "Authentication failed: $($_.Exception.Message)"; return }

try {
  Write-Info "Searching in Safe '$TargetSafe' for usernames: $($TargetUsernames -join ', ')"

  $all = @()
  foreach ($u in $TargetUsernames) {
    # pull by username and safe
    $page = Get-PASAccount -Search $u -searchType contains -SafeName $TargetSafe -ErrorAction SilentlyContinue
    if (-not $page) { Write-Warn "No accounts in safe '$TargetSafe' for '$u'"; continue }

    # Enrich with tolerant platform flags & normalized address
    $enriched = $page | Where-Object { $_.userName -eq $u -and $_.address } | ForEach-Object {
      [pscustomobject]@{
        id           = $_.id
        name         = $_.name
        userName     = $_.userName
        safeName     = $_.safeName
        platformId   = $_.platformId
        platformName = $_.platformName
        address      = $_.address
        addrNorm     = NormAddr $_.address
        isAPP        = Is-AppPlatform $_ $PlatformApp
        isNET        = Is-NetPlatform $_ $PlatformNet
      }
    }

    if ($enriched){ 
      Write-Info ("Found {0} accounts (post-filter) for '{1}'" -f $enriched.Count, $u)
      $all += $enriched
    } else {
      Write-Warn "No platform-relevant accounts for '$u' in safe '$TargetSafe'"
    }
  }

  if (-not $all){ Write-Ok "No matches found. Nothing to do."; return }

  # Quick diagnostics: distinct platforms we actually see
  $platDiag = $all | Select-Object -ExpandProperty platformId -Unique
  Write-Info ("Distinct platformId values seen: {0}" -f (($platDiag -join ', ') ?: '<none>'))
  $platDiag2 = $all | Select-Object -ExpandProperty platformName -Unique
  if ($platDiag2){ Write-Info ("Distinct platformName values seen: {0}" -f ($platDiag2 -join ', ')) }

  # Group by Safe + Username + Address (normalized)
  $groups = $all | Group-Object { "{0}|{1}|{2}" -f $_.safeName, $_.userName, $_.addrNorm }

  # Build deletion candidates: require ≥1 NET and ≥1 APP for the same group
  $pairs = foreach ($g in $groups){
    $items = $g.Group
    $apps  = $items | Where-Object { $_.isAPP }
    $nets  = $items | Where-Object { $_.isNET }
    if ($apps.Count -ge 1 -and $nets.Count -ge 1){
      foreach ($a in $apps){
        [pscustomobject]@{
          App = $a
          Net = $nets[0] # any net in the group suffices
        }
      }
    }
  }

  if (-not $pairs){ Write-Ok "Rule not met: no APP entries with a matching NET on same Safe/Username/Address."; return }

  Write-Info ("Found {0} APP entries with matching NET counterparts. Review & confirm..." -f $pairs.Count)

  foreach ($pair in $pairs) {
    $app = $pair.App; $net = $pair.Net

    $details = @"
Safe:        $($app.safeName)
User:        $($app.userName)
Address:     $($app.address)

APP (to delete):
  Id:        $($app.id)
  Name:      $($app.name)
  Platform:  id='$($app.platformId)' name='$($app.platformName)'

NET (to keep):
  Id:        $($net.id)
  Name:      $($net.name)
  Platform:  id='$($net.platformId)' name='$($net.platformName)'

Proceed to DELETE the APP entry above?
"@

    $caption = "Confirm deletion for [$($app.userName) @ $($app.address)]"
    $ok = $PSCmdlet.ShouldContinue($details, $caption)
    if (-not $ok) { Write-Warn "Skipped APP Id=$($app.id) ($($app.address))"; continue }

    $display = "[APP DELETE] User=$($app.userName) Address=$($app.address) Safe=$($app.safeName) Id=$($app.id)"
    if ($PSCmdlet.ShouldProcess($display, "Remove-PASAccount")) {
      try {
        Remove-PASAccount -AccountID $app.id -Confirm:$false
        Write-Ok "Deleted $display"
      } catch {
        Write-Err "Failed to delete $display : $($_.Exception.Message)"
      }
    }
  }

} finally {
  try { Close-PASSession | Out-Null; Write-Ok "Logged off." } catch { Write-Warn "Logoff warning: $($_.Exception.Message)" }
}
