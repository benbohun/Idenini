#Requires -RunAsAdministrator
<#
.SYNOPSIS
  Backs up and optionally removes only the local CyberArk DPA Connector service and install folder.
.EXAMPLE
  .\Remove-CyberArkDPAConnector.ps1
.EXAMPLE
  .\Remove-CyberArkDPAConnector.ps1 -Remove
.NOTES
  Does not alter other CyberArk services, certificates, shared registry keys, or SIA cloud registration.
  Does not uninstall an MSI product; if present, uninstall through Apps & Features first.
#>
[CmdletBinding()]
param([switch]$Remove)
$ErrorActionPreference = 'Stop'
$ServiceName = 'CyberArkDPAConnector'
$InstallDir = 'C:\Program Files\CyberArk\DPAConnector'
$BackupRoot = 'C:\CyberArkDPA-RemovalBackup'
$Stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$BackupDir = Join-Path $BackupRoot $Stamp

function Get-DPAService {
    Get-CimInstance Win32_Service -Filter "Name='$ServiceName'" -ErrorAction Stop
}

Write-Host "DPA service: $ServiceName" -ForegroundColor Cyan
Write-Host "DPA directory: $InstallDir" -ForegroundColor Cyan
$svc = Get-DPAService
if ($svc) {
    Write-Host "Service state: $($svc.State)"
    Write-Host "Executable path: $($svc.PathName)"
    # Safety: do not remove a service with this name if its executable points outside the dedicated folder.
    $exePath = [Environment]::ExpandEnvironmentVariables($svc.PathName).Trim()
    if ($exePath -notmatch '(?i)^[\s\"]*C:\\Program Files\\CyberArk\\DPAConnector\\') {
        throw "Service executable is not under $InstallDir. Aborting to avoid deleting an unexpected service."
    }
} else { Write-Host 'DPA service is not registered.' }
$hasDir = Test-Path -LiteralPath $InstallDir -PathType Container
Write-Host "Installation folder found: $hasDir"
if (-not $svc -and -not $hasDir) { Write-Host 'No local DPA connector service or installation folder found.'; return }
if (-not $Remove) {
    Write-Host 'Discovery mode only. No changes made. Run with -Remove to back up and remove.' -ForegroundColor Yellow
    return
}
$confirmation = Read-Host "Enter REMOVE-DPA to back up and remove only the DPA connector"
if ($confirmation -cne 'REMOVE-DPA') { Write-Host 'Cancelled; no changes made.'; return }
New-Item -Path $BackupDir -ItemType Directory -Force | Out-Null
if ($svc) {
    $svc | Select-Object Name, DisplayName, State, StartMode, PathName, StartName |
        Format-List | Out-File -LiteralPath (Join-Path $BackupDir 'service-details.txt') -Encoding utf8
}
if ($hasDir) {
    Write-Host 'Backing up DPA installation folder ...'
    Copy-Item -LiteralPath $InstallDir -Destination (Join-Path $BackupDir 'DPAConnector') -Recurse -Force
    # A copy error must stop the operation before deletion.
}
Write-Host "Backup saved to $BackupDir" -ForegroundColor Green
if ($svc) {
    Write-Host 'Stopping DPA service ...'
    if ($svc.State -ne 'Stopped') {
        & sc.exe stop $ServiceName | Out-Host
        Start-Sleep -Seconds 4
    }
    $svc = Get-DPAService
    if ($svc -and $svc.ProcessId -gt 0) {
        $proc = Get-CimInstance Win32_Process -Filter "ProcessId=$($svc.ProcessId)" -ErrorAction SilentlyContinue
        if ($proc -and $proc.ExecutablePath -and $proc.ExecutablePath.StartsWith($InstallDir + '\', [StringComparison]::OrdinalIgnoreCase)) {
            Write-Host "Stopping lingering DPA process PID $($svc.ProcessId) ..."
            Stop-Process -Id $svc.ProcessId -Force -ErrorAction Stop
        } else { throw 'The remaining service process could not be verified as a DPA executable. Aborting.' }
    }
    Write-Host 'Deleting DPA Windows service ...'
    & sc.exe delete $ServiceName | Out-Host
    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 1060) { throw "sc.exe delete failed: $LASTEXITCODE. Folder retained." }
}
if (Test-Path -LiteralPath $InstallDir -PathType Container) {
    Write-Host 'Removing dedicated DPA installation folder ...'
    Remove-Item -LiteralPath $InstallDir -Recurse -Force -ErrorAction Stop
}
Write-Host 'Local DPA cleanup completed.' -ForegroundColor Green
Write-Host "Backup: $BackupDir"
Write-Host 'Verify: Get-Service CyberArkDPAConnector -ErrorAction SilentlyContinue'
Write-Host "Verify: Test-Path '$InstallDir'"
Write-Warning 'If Windows says the service is marked for deletion, close Services.msc or reboot before reinstalling.'
Write-Warning 'MSI/Programs registration and SIA cloud connector registration are intentionally not removed.'
