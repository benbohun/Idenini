    UnlockAccounts                         = $false
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
}

# =========================
# Logging
# =========================

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet("INFO", "WARN", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "$timestamp | $Level | $Message"

    Add-Content -Path $LogFile -Value $entry

    switch ($Level) {
        "SUCCESS" { Write-Host $entry -ForegroundColor Green }
        "WARN"    { Write-Host $entry -ForegroundColor Yellow }
        "ERROR"   { Write-Host $entry -ForegroundColor Red }
        default   { Write-Host $entry -ForegroundColor White }
    }
}

function Add-RunResult {
    param(
        [string]$SamAccountName,
        [string]$UserPrincipalName,
        [string]$SafeName,
        [string]$MemberName,
        [string]$Action,
        [string]$Status,
        [string]$Detail,
        [string]$IdentitySourceTable,
        [string]$IdentityStatus,
        [string]$IdentityDisplayName,
        [string]$IdentitySource
    )

    $script:RunResults.Add([PSCustomObject]@{
        RunTime             = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        SamAccountName      = $SamAccountName
        UserPrincipalName   = $UserPrincipalName
        SafeName            = $SafeName
        MemberName          = $MemberName
        Action              = $Action
        Status              = $Status
        Detail              = $Detail
        IdentitySourceTable = $IdentitySourceTable
        IdentityStatus      = $IdentityStatus
        IdentityDisplayName = $IdentityDisplayName
        IdentitySource      = $IdentitySource
    }) | Out-Null
}

# =========================
# Private module loading
# =========================

function Find-PrivateModuleFile {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ModuleRoot,

        [Parameter(Mandatory)]
        [string]$ModuleName,

        [version]$MinimumVersion = "0.0.0"
    )

    if (-not (Test-Path $ModuleRoot)) {
        throw "Private module root does not exist: $ModuleRoot"
    }

    $moduleFolder = Join-Path $ModuleRoot $ModuleName

    if (-not (Test-Path $moduleFolder)) {
        throw "Private module folder does not exist: $moduleFolder"
    }

    $moduleFiles = @(
        Get-ChildItem -Path $moduleFolder -Recurse -File -ErrorAction Stop |
            Where-Object {
                $_.Name -ieq "$ModuleName.psd1" -or
                $_.Name -ieq "$ModuleName.psm1"
            } |
            ForEach-Object {
                $version = [version]"0.0.0"

                if ($_.FullName -match "\\$([regex]::Escape($ModuleName))\\([^\\]+)\\$([regex]::Escape($ModuleName))\.ps[dm]1$") {
                    try {
                        $version = [version]$matches[1]
                    }
                    catch {
                        $version = [version]"0.0.0"
                    }
                }

                [PSCustomObject]@{
                    ModuleName = $ModuleName
                    Version    = $version
                    Path       = $_.FullName
                    Extension  = $_.Extension
                }
            } |
            Where-Object { $_.Version -ge $MinimumVersion } |
            Sort-Object -Property `
                @{ Expression = { $_.Version }; Descending = $true },
                @{ Expression = { if ($_.Extension -ieq ".psd1") { 0 } else { 1 } }; Descending = $false }
    )

    $selected = @($moduleFiles | Select-Object -First 1)

    if (-not $selected) {
        throw @"
No valid private module file found.

ModuleName     : $ModuleName
ModuleRoot     : $ModuleRoot
MinimumVersion : $MinimumVersion

Expected examples:
$ModuleRoot\$ModuleName\6.x.x\$ModuleName.psd1
$ModuleRoot\$ModuleName\6.x.x\$ModuleName.psm1
"@
    }

    return $selected
}

function Initialize-RequiredModules {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ScriptModuleRoot,

        [Parameter(Mandatory)]
        [version]$MinimumPsPASVersion
    )

    Write-Log ("PowerShell Version      : {0}" -f $PSVersionTable.PSVersion)
    Write-Log ("PowerShell Path         : {0}" -f $PSHOME)
    Write-Log ("64-bit Process          : {0}" -f [Environment]::Is64BitProcess)
    Write-Log ("Run As User             : {0}" -f [System.Security.Principal.WindowsIdentity]::GetCurrent().Name)
    Write-Log ("Original PSModulePath   : {0}" -f $env:PSModulePath)
    Write-Log ("Private ModuleRoot      : {0}" -f $ScriptModuleRoot)

    if (-not (Test-Path $ScriptModuleRoot)) {
        throw @"
Private module folder does not exist:
$ScriptModuleRoot

Create it and save modules into it:
Save-Module psPAS -Path "$ScriptModuleRoot" -Force
Save-Module IdentityCommand -Path "$ScriptModuleRoot" -Force
"@
    }

    # This updates PSModulePath only for this PowerShell process.
    # It does not change the server/global/user module path.
    $script:OriginalPSModulePath = $env:PSModulePath

    if ($env:PSModulePath -notlike "*$ScriptModuleRoot*") {
        $env:PSModulePath = "$ScriptModuleRoot;$env:PSModulePath"
    }

    Write-Log ("Runtime PSModulePath    : {0}" -f $env:PSModulePath)

    Remove-Module psPAS -Force -ErrorAction SilentlyContinue
    Remove-Module IdentityCommand -Force -ErrorAction SilentlyContinue

    $privateIdentityCommand = Find-PrivateModuleFile `
        -ModuleRoot $ScriptModuleRoot `
        -ModuleName "IdentityCommand" `
        -MinimumVersion ([version]"0.0.0")

    $privatePsPAS = Find-PrivateModuleFile `
        -ModuleRoot $ScriptModuleRoot `
        -ModuleName "psPAS" `
        -MinimumVersion $MinimumPsPASVersion

    Write-Log ("Importing private IdentityCommand: Version={0}; Path={1}" -f $privateIdentityCommand.Version, $privateIdentityCommand.Path)
    Import-Module $privateIdentityCommand.Path -Force -ErrorAction Stop

    Write-Log ("Importing private psPAS          : Version={0}; Path={1}" -f $privatePsPAS.Version, $privatePsPAS.Path)
    Import-Module $privatePsPAS.Path -Force -ErrorAction Stop

    $pspasModule = Get-Module psPAS
    $idcModule   = Get-Module IdentityCommand
    $newSession  = Get-Command New-PASSession -ErrorAction Stop

    Write-Log ("Loaded psPAS Version       : {0}" -f $pspasModule.Version)
    Write-Log ("Loaded psPAS Path          : {0}" -f $pspasModule.Path)
    Write-Log ("Loaded IdentityCommand Ver : {0}" -f $idcModule.Version)
    Write-Log ("Loaded IdentityCommand Path: {0}" -f $idcModule.Path)

    $importantParams = @(
        "IdentityTenantURL",
        "PrivilegeCloudURL",
        "TenantSubdomain",
        "Credential",
        "ServiceUser",
        "BaseURI"
    )

    $availableImportantParams = @(
        $importantParams | Where-Object { $newSession.Parameters.ContainsKey($_) }
    ) -join ", "

    Write-Log ("New-PASSession detected parameters: {0}" -f $availableImportantParams)

    if (-not $newSession.Parameters.ContainsKey("ServiceUser")) {
        $availableParams = ($newSession.Parameters.Keys | Sort-Object) -join ", "

        throw @"
The private psPAS module loaded, but New-PASSession does not support -ServiceUser.

Loaded psPAS:
Version: $($pspasModule.Version)
Path   : $($pspasModule.Path)

Required:
psPAS 6.x or newer with Privilege Cloud Shared Services support.

Available New-PASSession parameters:
$availableParams
"@
    }

    if (-not $newSession.Parameters.ContainsKey("IdentityTenantURL") -and -not $newSession.Parameters.ContainsKey("TenantSubdomain")) {
        $availableParams = ($newSession.Parameters.Keys | Sort-Object) -join ", "

        throw @"
The private New-PASSession command does not support -IdentityTenantURL or -TenantSubdomain.

Loaded psPAS:
Version: $($pspasModule.Version)
Path   : $($pspasModule.Path)

Available New-PASSession parameters:
$availableParams
"@
    }
}

# =========================
# Utility functions
# =========================

function Convert-ToCleanString {
    param([object]$Value)

    if ($null -eq $Value) {
        return ""
    }

    return ([string]$Value).Trim()
}

function ConvertTo-UrlEncodedValue {
    param(
        [Parameter(Mandatory)]
        [string]$Value
    )

    return [System.Uri]::EscapeDataString($Value)
}

function Read-HttpResponseBody {
    param(
        [Parameter(Mandatory)]
        [System.Net.WebResponse]$Response
    )

    $stream = $null
    $reader = $null

    try {
        $stream = $Response.GetResponseStream()

        if (-not $stream) {
            return ""
        }

        $reader = New-Object System.IO.StreamReader($stream)
        return $reader.ReadToEnd()
    }
    finally {
        if ($reader) {
            $reader.Close()
        }

        if ($stream) {
            $stream.Close()
        }
    }
}

function Invoke-HttpPost {
    param(
        [Parameter(Mandatory)]
        [string]$Uri,

        [Parameter(Mandatory)]
        [string]$Body,

        [Parameter(Mandatory)]
        [string]$ContentType,

        [hashtable]$Headers = @{}
    )

    $request = [System.Net.WebRequest]::Create($Uri)
    $request.Method = "POST"
    $request.ContentType = $ContentType
    $request.Accept = "application/json"

    foreach ($key in $Headers.Keys) {
        $request.Headers.Add($key, [string]$Headers[$key])
    }

    $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes($Body)
    $request.ContentLength = $bodyBytes.Length

    $requestStream = $null

    try {
        $requestStream = $request.GetRequestStream()
        $requestStream.Write($bodyBytes, 0, $bodyBytes.Length)
    }
    finally {
        if ($requestStream) {
            $requestStream.Close()
        }
    }

    try {
        $response = $request.GetResponse()
        $responseBody = Read-HttpResponseBody -Response $response

        return [PSCustomObject]@{
            Success           = $true
            StatusCode        = [int]$response.StatusCode
            StatusDescription = [string]$response.StatusDescription
            Body              = $responseBody
        }
    }
    catch [System.Net.WebException] {
        $webResponse = $_.Exception.Response

        if ($webResponse) {
            $errorBody = Read-HttpResponseBody -Response $webResponse

            return [PSCustomObject]@{
                Success           = $false
                StatusCode        = [int]$webResponse.StatusCode
                StatusDescription = [string]$webResponse.StatusDescription
                Body              = $errorBody
            }
        }

        return [PSCustomObject]@{
            Success           = $false
            StatusCode        = ""
            StatusDescription = ""
            Body              = $_.Exception.Message
        }
    }
}

function Convert-FromIdentityDate {
    param([object]$Value)

    if (-not $Value) {
        return $null
    }

    $text = [string]$Value

    if ($text -match "/Date\((\d+)\)/") {
        $epochMs = [Int64]$matches[1]
        return ([DateTimeOffset]::FromUnixTimeMilliseconds($epochMs)).LocalDateTime
    }

    try {
        return [datetime]$text
    }
    catch {
        return $text
    }
}

function Get-TenantSubdomainFromIdentityUrl {
    param(
        [Parameter(Mandatory)]
        [string]$IdentityTenantURL
    )

    $clean = $IdentityTenantURL.Trim().TrimEnd("/")
    $uri = [Uri]$clean
    return ($uri.Host -split "\.")[0]
}

function Resolve-SamFromIdentityFields {
    param(
        [string]$UserName,
        [string]$SystemName,
        [string]$Email,
        [string]$DefaultUserDomain
    )

    $values = @(
        (Convert-ToCleanString $UserName),
        (Convert-ToCleanString $SystemName),
        (Convert-ToCleanString $Email)
    ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }

    foreach ($value in $values) {
        # Domain\sam format.
        if ($value -match "^[^\\]+\\([^\\]+)$") {
            $candidate = $matches[1].Trim()
            if (-not [string]::IsNullOrWhiteSpace($candidate)) {
                return $candidate
            }
        }

        # UPN/email format.
        if ($value -match "^([^@]+)@([^@]+)$") {
            $candidate = $matches[1].Trim()
            if (-not [string]::IsNullOrWhiteSpace($candidate)) {
                return $candidate
            }
        }
    }

    foreach ($value in $values) {
        # Avoid trying to turn LDAP DNs into samAccountName.
        if ($value -match "^\s*CN=") {
            continue
        }

        if ($value -notmatch "[@\\,=]") {
            return $value.Trim()
        }
    }

    return ""
}

# =========================
# CCP and OAuth
# =========================

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd("/")
    $loc  = $Location.Trim("/")

    $encodedAppID  = ConvertTo-UrlEncodedValue -Value $AppID
    $encodedSafe   = ConvertTo-UrlEncodedValue -Value $Safe
    $encodedObject = ConvertTo-UrlEncodedValue -Value $Object

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $base, `
        $loc, `
        $encodedAppID, `
        $encodedSafe, `
        $encodedObject

    Write-Log "Retrieving service user credential from CCP."
    Write-Log ("CCP URL: {0}" -f $url)

    try {
        $headers = @{
            "Content-Type" = "application/json"
        }

        $resp = Invoke-RestMethod `
            -Uri $url `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$WindowsAuth `
            -ErrorAction Stop

        if (-not $resp.UserName -or -not $resp.Content) {
            throw "CCP response is missing UserName or Content."
        }

        Write-Log ("CCP returned service user username: {0}" -f $resp.UserName) "SUCCESS"

        return [PSCustomObject]@{
            UserName = [string]$resp.UserName
            Secret   = [string]$resp.Content
        }
    }
    catch {
        throw "CCP credential retrieval failed. $($_.Exception.Message)"
    }
}

function New-BasicAuthHeaderValue {
    param(
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret
    )

    # Confirmed working format:
    # raw client_id:client_secret encoded with ASCII.
    $pair = "{0}:{1}" -f $ClientId, $ClientSecret
    $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
    $basicToken = [Convert]::ToBase64String($bytes)

    return "Basic $basicToken"
}

function Get-IdentityReportingToken {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$IdentityOAuthAppId,
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret,
        [Parameter(Mandatory)][string]$Scope
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $appId  = $IdentityOAuthAppId.Trim("/")
    $tokenUri = "$tenant/oauth2/token/$appId"

    Write-Log ("Requesting Identity OAuth token from: {0}" -f $tokenUri)
    Write-Log ("OAuth Client ID from CCP: {0}" -f $ClientId)
    Write-Log ("OAuth Scope: {0}" -f $Scope)

    $body = "grant_type=client_credentials&scope=$([System.Uri]::EscapeDataString($Scope))"

    $headers = @{
        Authorization = New-BasicAuthHeaderValue `
            -ClientId $ClientId `
            -ClientSecret $ClientSecret
    }

    $response = Invoke-HttpPost `
        -Uri $tokenUri `
        -Body $body `
        -ContentType "application/x-www-form-urlencoded" `
        -Headers $headers

    if (-not $response.Success) {
        $msg = @"
Unable to retrieve Identity OAuth token.

Token URL:
$tokenUri

HTTP Response:
$($response.StatusCode) $($response.StatusDescription)

Response Body:
$($response.Body)
"@

        throw $msg
    }

    try {
        $json = $response.Body | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw ("Identity token response was not valid JSON. Body: {0}" -f $response.Body)
    }

    if (-not $json.access_token) {
        throw ("Identity token response did not include access_token. Body: {0}" -f $response.Body)
    }

    Write-Log ("Identity OAuth token retrieved. TokenType={0}; ExpiresIn={1}" -f $json.token_type, $json.expires_in) "SUCCESS"

    return [string]$json.access_token
}

# =========================
# Privilege Cloud connection
# =========================

function Connect-PrivilegeCloudServiceUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL,
        [Parameter(Mandatory)][PSCredential]$Credential
    )

    $cmd = Get-Command New-PASSession -ErrorAction Stop
    $params = $cmd.Parameters

    if ($params.ContainsKey("IdentityTenantURL") -and $params.ContainsKey("PrivilegeCloudURL") -and $params.ContainsKey("ServiceUser")) {
        Write-Log "Using New-PASSession with -IdentityTenantURL, -PrivilegeCloudURL, and -ServiceUser."

        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential $Credential `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        return
    }

    if ($params.ContainsKey("TenantSubdomain") -and $params.ContainsKey("ServiceUser")) {
        $tenantSubdomain = Get-TenantSubdomainFromIdentityUrl -IdentityTenantURL $IdentityTenantURL

        Write-Log ("Using New-PASSession fallback with -TenantSubdomain {0} and -ServiceUser." -f $tenantSubdomain) "WARN"

        New-PASSession `
            -TenantSubdomain $tenantSubdomain `
            -Credential $Credential `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        return
    }

    $availableParams = ($params.Keys | Sort-Object) -join ", "

    throw @"
Unable to authenticate to Privilege Cloud.

The loaded New-PASSession command does not support a valid ServiceUser login method.

Required:
- Either IdentityTenantURL + PrivilegeCloudURL + ServiceUser
- Or TenantSubdomain + ServiceUser

Available parameters:
$availableParams
"@
}

# =========================
# Redrock
# =========================

function Invoke-RedrockSingleCall {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken,
        [Parameter(Mandatory)][string]$Query,
        [int]$PageNumber = 1,
        [int]$PageSize = 1000,
        [switch]$WithoutArgs
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $queryUri = "$tenant/Redrock/query"

    $headers = @{
        Authorization = "Bearer $AccessToken"
    }

    if ($WithoutArgs) {
        $payloadObject = @{
            Script = $Query
        }
    }
    else {
        $payloadObject = @{
            Script = $Query
            Args   = @{
                PageNumber = $PageNumber
                PageSize   = $PageSize
                Limit      = $PageSize
                Caching    = -1
                direction  = $false
                SortBy     = ""
            }
        }
    }

    $payload = $payloadObject | ConvertTo-Json -Depth 10

    $response = Invoke-HttpPost `
        -Uri $queryUri `
        -Body $payload `
        -ContentType "application/json" `
        -Headers $headers

    if (-not $response.Success) {
        throw ("Redrock query HTTP failed. HTTP {0} {1}. Body: {2}. Query: {3}" -f `
            $response.StatusCode, `
            $response.StatusDescription, `
            $response.Body, `
            $Query)
    }

    try {
        $json = $response.Body | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        $sample = $response.Body

        if ($sample.Length -gt 1000) {
            $sample = $sample.Substring(0, 1000)
        }

        throw ("Redrock query response was not valid JSON or PowerShell could not parse it. Error: {0}. BodySample: {1}" -f `
            $_.Exception.Message, `
            $sample)
    }

    if ($json.success -eq $false) {
        $message = ""

        if ($json.Message) {
            $message = [string]$json.Message
        }
        elseif ($json.message) {
            $message = [string]$json.message
        }
        else {
            $message = "No explicit Redrock message returned."
        }

        throw ("Redrock returned success=false. Message: {0}. Query: {1}" -f $message, $Query)
    }

    return $json
}

function Invoke-RedrockQuery {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken,
        [Parameter(Mandatory)][string]$Query,
        [int]$PageSize = 1000
    )

    $allRows = New-Object System.Collections.Generic.List[object]
    $pageNumber = 1
    $useArgs = $true

    while ($true) {
        try {
            $json = Invoke-RedrockSingleCall `
                -IdentityTenantURL $IdentityTenantURL `
                -AccessToken $AccessToken `
                -Query $Query `
                -PageNumber $pageNumber `
                -PageSize $PageSize `
                -WithoutArgs:(!$useArgs)
        }
        catch {
            $err = $_.Exception.Message

            # Some tenants/modules return "Argument types do not match" when Args are present.
            # Retry the first page without Args before failing.
            if ($useArgs -and $pageNumber -eq 1 -and $err -match "Argument types do not match") {
                Write-Log "Redrock query with Args failed with 'Argument types do not match'. Retrying once without Args." "WARN"
                $useArgs = $false

                $json = Invoke-RedrockSingleCall `
                    -IdentityTenantURL $IdentityTenantURL `
                    -AccessToken $AccessToken `
                    -Query $Query `
                    -PageNumber 1 `
                    -PageSize $PageSize `
                    -WithoutArgs
            }
            else {
                throw
            }
        }

        $pageRows = @()

        if ($json.Result -and $json.Result.Results) {
            $pageRows = @($json.Result.Results | ForEach-Object { $_.Row })
        }

        if (-not $pageRows -or $pageRows.Count -eq 0) {
            break
        }

        foreach ($row in $pageRows) {
            $allRows.Add($row) | Out-Null
        }

        if (-not $useArgs) {
            # Without Args, we cannot safely page.
            break
        }

        if ($pageRows.Count -lt $PageSize) {
            break
        }

        $pageNumber++
    }

    return @($allRows)
}

function Get-IdentityUserCandidates {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken,
        [int]$PageSize = 1000,
        [string]$DefaultUserDomain = "alliantcreditunion.com"
    )

    $candidateRows = @()
    $sourceTable = ""

    # Prefer DSUsers because it normally contains users from all directory services,
    # even if they have not logged into the cloud service.
    $dsUsersQueries = @(
@"
Select InternalName, SystemName, DisplayName, Email, StatusEnum, Enabled, ServiceInstance, ServiceType, Forest, DirectoryServiceUuid
from DSUsers
ORDER BY SystemName COLLATE NOCASE
"@,
@"
Select InternalName, SystemName, DisplayName, Email, StatusEnum, Enabled
from DSUsers
ORDER BY SystemName COLLATE NOCASE
"@,
@"
Select InternalName, SystemName, DisplayName
from DSUsers
ORDER BY SystemName COLLATE NOCASE
"@
    )

    foreach ($query in $dsUsersQueries) {
        try {
            Write-Log "Querying CyberArk Identity DSUsers table."
            $candidateRows = @(Invoke-RedrockQuery `
                -IdentityTenantURL $IdentityTenantURL `
                -AccessToken $AccessToken `
                -Query $query `
                -PageSize $PageSize)

            $sourceTable = "DSUsers"
            Write-Log ("DSUsers query succeeded. Retrieved {0} row(s)." -f $candidateRows.Count) "SUCCESS"
            break
        }
        catch {
            Write-Log ("DSUsers query attempt failed: {0}" -f $_.Exception.Message) "WARN"
        }
    }

    if (-not $candidateRows -or $candidateRows.Count -eq 0) {
        $userQueries = @(
@"
Select ID, Username, DisplayName, Email, StatusEnum, SourceDs, SourceDsType, DirectoryServiceUuid, Forest
from User
ORDER BY Username COLLATE NOCASE
"@,
@"
Select ID, Username, DisplayName, Email, StatusEnum
from User
ORDER BY Username COLLATE NOCASE
"@,
@"
Select ID, Username, DisplayName
from User
ORDER BY Username COLLATE NOCASE
"@
        )

        foreach ($query in $userQueries) {
            try {
                Write-Log "Querying CyberArk Identity User table."
                $candidateRows = @(Invoke-RedrockQuery `
                    -IdentityTenantURL $IdentityTenantURL `
                    -AccessToken $AccessToken `
                    -Query $query `
                    -PageSize $PageSize)

                $sourceTable = "User"
                Write-Log ("User query succeeded. Retrieved {0} row(s)." -f $candidateRows.Count) "SUCCESS"
                break
            }
            catch {
                Write-Log ("User query attempt failed: {0}" -f $_.Exception.Message) "WARN"
            }
        }
    }

    if (-not $candidateRows -or $candidateRows.Count -eq 0) {
        throw "Unable to retrieve Identity users from DSUsers or User table."
    }

    $candidates = New-Object System.Collections.Generic.List[object]

    foreach ($row in $candidateRows) {
        $userName = Convert-ToCleanString $row.Username
        $systemName = Convert-ToCleanString $row.SystemName
        $email = Convert-ToCleanString $row.Email

        $sam = Resolve-SamFromIdentityFields `
            -UserName $userName `
            -SystemName $systemName `
            -Email $email `
            -DefaultUserDomain $DefaultUserDomain

        $sam = Convert-ToCleanString $sam

        if ([string]::IsNullOrWhiteSpace($sam)) {
            continue
        }

        if ($sam -match "\$$") {
            continue
        }

        $upn = ""

        if ($userName -match "@") {
            $upn = $userName
        }
        elseif ($systemName -match "@") {
            $upn = $systemName
        }
        elseif ($email -match "@") {
            $upn = $email
        }
        else {
            $upn = "{0}@{1}" -f $sam, $DefaultUserDomain
        }

        $identitySource = ""

        if ($sourceTable -eq "DSUsers") {
            $identitySource = Convert-ToCleanString $row.ServiceInstance
            if ([string]::IsNullOrWhiteSpace($identitySource)) {
                $identitySource = Convert-ToCleanString $row.ServiceType
            }
        }
        else {
            $identitySource = Convert-ToCleanString $row.SourceDs
            if ([string]::IsNullOrWhiteSpace($identitySource)) {
                $identitySource = Convert-ToCleanString $row.SourceDsType
            }
        }

        $candidates.Add([PSCustomObject]@{
            SamAccountName      = $sam
            UserPrincipalName   = $upn
            DisplayName         = Convert-ToCleanString $row.DisplayName
            IdentityStatus      = Convert-ToCleanString $row.StatusEnum
            IdentitySourceTable = $sourceTable
            IdentitySource      = $identitySource
            RawUserName         = $userName
            RawSystemName       = $systemName
            RawEmail            = $email
        }) | Out-Null
    }

    $deduped = $candidates |
        Sort-Object `
            @{ Expression = { $_.SamAccountName }; Descending = $false },
            @{ Expression = { $_.UserPrincipalName }; Descending = $false } |
        Group-Object SamAccountName |
        ForEach-Object { $_.Group | Select-Object -First 1 }

    return @($deduped)
}

# =========================
# Safe membership functions
# =========================

function Get-INDMatchingSafe {
    param(
        [Parameter(Mandatory)]$Safes,
        [Parameter(Mandatory)][string]$SamAccountName,
        [string]$IndSafePrefix = "IND_"
    )

    $escapedSam = [regex]::Escape($SamAccountName)
    $escapedPrefix = [regex]::Escape($IndSafePrefix)

    $pattern = "^{0}{1}($|_)" -f $escapedPrefix, $escapedSam

    $matches = @(
        $Safes |
            Where-Object { $_.SafeName -match $pattern } |
            Sort-Object SafeName
    )

    return $matches
}

function Get-SafeMember {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [string]$SamAccountName
    )

    try {
        $members = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
        $targetMember = $MemberName.ToLower()
        $targetSam = ""

        if (-not [string]::IsNullOrWhiteSpace($SamAccountName)) {
            $targetSam = $SamAccountName.ToLower()
        }

        return @(
            $members |
                Where-Object {
                    $existing = ""

                    if ($_.MemberName) {
                        $existing = $_.MemberName.ToLower()
                    }

                    ($existing -eq $targetMember) -or
                    (-not [string]::IsNullOrWhiteSpace($targetSam) -and $existing -eq $targetSam)
                } |
                Select-Object -First 1
        )
    }
    catch {
        Write-Log ("Could not retrieve members for Safe {0}. Error: {1}" -f $SafeName, $_.Exception.Message) "WARN"
        return $null
    }
}

function Invoke-PSPASCommandFiltered {
    param(
        [Parameter(Mandatory)][string]$CommandName,
        [Parameter(Mandatory)][hashtable]$Parameters
    )

    $command = Get-Command -Name $CommandName -ErrorAction Stop
    $validParameterNames = @($command.Parameters.Keys)
    $filtered = @{}

    foreach ($key in $Parameters.Keys) {
        if ($validParameterNames -contains $key) {
            $filtered[$key] = $Parameters[$key]
        }
        else {
            Write-Log ("Skipping unsupported parameter for {0}: {1}" -f $CommandName, $key) "WARN"
        }
    }

    & $CommandName @filtered
}

function Add-IndividualUserToSafe {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][hashtable]$Permissions,
        [string]$PreferredSearchIn,
        [switch]$DryRun
    )

    $splat = @{
        SafeName    = $SafeName
        MemberName  = $MemberName
        ErrorAction = "Stop"
    }

    if (-not [string]::IsNullOrWhiteSpace($PreferredSearchIn)) {
        $splat["SearchIn"] = $PreferredSearchIn
    }

    foreach ($key in $Permissions.Keys) {
        $splat[$key] = $Permissions[$key]
    }

    if ($DryRun) {
        Write-Log ("DRY RUN: Would add {0} to {1}." -f $MemberName, $SafeName)
        return
    }

    try {
        Invoke-PSPASCommandFiltered -CommandName "Add-PASSafeMember" -Parameters $splat | Out-Null
        Write-Log ("Added {0} to {1}." -f $MemberName, $SafeName) "SUCCESS"
    }
    catch {
        if ($splat.ContainsKey("SearchIn")) {
            Write-Log ("Add with SearchIn failed for {0}. Retrying without SearchIn. Error: {1}" -f $MemberName, $_.Exception.Message) "WARN"

            $splat.Remove("SearchIn")

            Invoke-PSPASCommandFiltered -CommandName "Add-PASSafeMember" -Parameters $splat | Out-Null
            Write-Log ("Added {0} to {1} without SearchIn." -f $MemberName, $SafeName) "SUCCESS"
        }
        else {
            throw
        }
    }
}

function Set-IndividualUserSafePermission {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][hashtable]$Permissions,
        [switch]$DryRun
    )

    $splat = @{
        SafeName    = $SafeName
        MemberName  = $MemberName
        ErrorAction = "Stop"
    }

    foreach ($key in $Permissions.Keys) {
        $splat[$key] = $Permissions[$key]
    }

    if ($DryRun) {
        Write-Log ("DRY RUN: Would update permissions for {0} on {1}." -f $MemberName, $SafeName)
        return
    }

    Invoke-PSPASCommandFiltered -CommandName "Set-PASSafeMember" -Parameters $splat | Out-Null
    Write-Log ("Updated permissions for {0} on {1}." -f $MemberName, $SafeName) "SUCCESS"
}

# =========================
# Main
# =========================

$sessionCreated = $false

try {
    Write-Log "IND Safe Identity user membership sync starting."
    Write-Log ("DryRun mode: {0}" -f [bool]$DryRun)
    Write-Log ("LiveRun mode: {0}" -f [bool]$LiveRun)
    Write-Log ("LookbackDays parameter retained for compatibility: {0}" -f $LookbackDays)
    Write-Log "Discovery mode: Safe-driven Identity user scan. Event table query is bypassed."
    Write-Log ("Identity OAuth Application ID: {0}" -f $IdentityOAuthAppId)

    Initialize-RequiredModules `
        -ScriptModuleRoot $ScriptModuleRoot `
        -MinimumPsPASVersion $MinimumPsPASVersion

    if ($DryRun) {
        Write-Log "Safe mode enabled. No Safe membership changes will be made."
    }
    else {
        Write-Log "Live mode enabled. Safe membership changes can be made." "WARN"
    }

    $ccpCredential = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    $identityToken = Get-IdentityReportingToken `
        -IdentityTenantURL $IdentityTenantURL `
        -IdentityOAuthAppId $IdentityOAuthAppId `
        -ClientId $ccpCredential.UserName `
        -ClientSecret $ccpCredential.Secret `
        -Scope $OAuthScope

    if ($TokenOnly) {
        Write-Log "TokenOnly switch was used. CCP + OAuth token test completed successfully." "SUCCESS"
        return
    }

    $identityUsers = @(Get-IdentityUserCandidates `
        -IdentityTenantURL $IdentityTenantURL `
        -AccessToken $identityToken `
        -PageSize $PageSize `
        -DefaultUserDomain $DefaultUserDomain)

    Write-Log ("Resolved {0} unique Identity user candidate(s)." -f $identityUsers.Count) "SUCCESS"

    if ($IdentityQueryOnly) {
        Write-Log "IdentityQueryOnly switch was used. Identity user query completed successfully." "SUCCESS"

        $identityUsers |
            Select-Object SamAccountName, UserPrincipalName, DisplayName, IdentityStatus, IdentitySourceTable, IdentitySource, RawUserName, RawSystemName, RawEmail |
            Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

        Write-Log ("Identity query CSV exported to: {0}" -f $CsvFilePath) "SUCCESS"
        return
    }

    Write-Log "Authenticating to Privilege Cloud using Identity Service User."

    $securePassword = ConvertTo-SecureString $ccpCredential.Secret -AsPlainText -Force
    $serviceCred = [PSCredential]::new($ccpCredential.UserName, $securePassword)

    Connect-PrivilegeCloudServiceUser `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $serviceCred

    if (-not (Get-PASSession)) {
        throw "psPAS session was not established."
    }

    $sessionCreated = $true
    Write-Log ("Authenticated to Privilege Cloud as {0}." -f $ccpCredential.UserName) "SUCCESS"

    Write-Log "Retrieving Safes from Privilege Cloud."

    $allSafes = @(Get-PASSafe -ErrorAction Stop)

    if (-not $allSafes -or $allSafes.Count -eq 0) {
        throw "No Safes were returned by Get-PASSafe."
    }

    $indSafes = @(
        $allSafes |
            Where-Object { $_.SafeName -like "$IndSafePrefix*" }
    )

    Write-Log ("Retrieved {0} total Safe(s); {1} IND Safe(s)." -f $allSafes.Count, $indSafes.Count)

    if (-not $indSafes -or $indSafes.Count -eq 0) {
        throw "No IND Safes were returned using prefix $IndSafePrefix."
    }

    $matchedUserCount = 0
    $processedChangeCount = 0
    $skippedExistingCount = 0
    $noMatchingSafeCount = 0

    foreach ($user in $identityUsers) {
        $sam = Convert-ToCleanString $user.SamAccountName
        $upn = Convert-ToCleanString $user.UserPrincipalName

        if ([string]::IsNullOrWhiteSpace($sam)) {
            continue
        }

        $memberName = "{0}@{1}" -f $sam, $DefaultUserDomain

        $matchingSafes = @(Get-INDMatchingSafe `
            -Safes $indSafes `
            -SamAccountName $sam `
            -IndSafePrefix $IndSafePrefix)

        if (-not $matchingSafes -or $matchingSafes.Count -eq 0) {
            $noMatchingSafeCount++

            if ($ReportUsersWithoutMatchingSafe) {
                Add-RunResult `
                    -SamAccountName $sam `
                    -UserPrincipalName $upn `
                    -SafeName "" `
                    -MemberName $memberName `
                    -Action "SafeLookup" `
                    -Status "NoMatchingSafe" `
                    -Detail "No Safe matched IND_<samAccountName> or IND_<samAccountName>_*." `
                    -IdentitySourceTable $user.IdentitySourceTable `
                    -IdentityStatus $user.IdentityStatus `
                    -IdentityDisplayName $user.DisplayName `
                    -IdentitySource $user.IdentitySource
            }

            continue
        }

        $matchedUserCount++

        if ($matchingSafes.Count -gt 1) {
            Write-Log ("Multiple IND Safes matched {0}. Using first result: {1}" -f $sam, $matchingSafes[0].SafeName) "WARN"
        }

        $targetSafe = $matchingSafes[0].SafeName

        Write-Log ("Processing Identity user {0}; target Safe {1}; target member {2}." -f $sam, $targetSafe, $memberName)

        try {
            $existingMember = Get-SafeMember `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -SamAccountName $sam

            if ($existingMember) {
                if ($UpdateExistingMember) {
                    Set-IndividualUserSafePermission `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Permissions $IndividualSafePermissions `
                        -DryRun:$DryRun

                    $processedChangeCount++

                    Add-RunResult `
                        -SamAccountName $sam `
                        -UserPrincipalName $upn `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Action "UpdateExistingMember" `
                        -Status "Success" `
                        -Detail "Member already existed; permissions were updated or would be updated in dry-run." `
                        -IdentitySourceTable $user.IdentitySourceTable `
                        -IdentityStatus $user.IdentityStatus `
                        -IdentityDisplayName $user.DisplayName `
                        -IdentitySource $user.IdentitySource
                }
                else {
                    $skippedExistingCount++
                    Write-Log ("Member {0} already exists in Safe {1}. Skipping." -f $memberName, $targetSafe) "WARN"

                    Add-RunResult `
                        -SamAccountName $sam `
                        -UserPrincipalName $upn `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Action "SkipExistingMember" `
                        -Status "Skipped" `
                        -Detail "Member already exists. Use -UpdateExistingMember to refresh permissions." `
                        -IdentitySourceTable $user.IdentitySourceTable `
                        -IdentityStatus $user.IdentityStatus `
                        -IdentityDisplayName $user.DisplayName `
                        -IdentitySource $user.IdentitySource
                }

                continue
            }

            Add-IndividualUserToSafe `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Permissions $IndividualSafePermissions `
                -PreferredSearchIn $PreferredSearchIn `
                -DryRun:$DryRun

            $processedChangeCount++

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Action "AddMember" `
                -Status "Success" `
                -Detail "Member added or would be added with default individual Safe permissions." `
                -IdentitySourceTable $user.IdentitySourceTable `
                -IdentityStatus $user.IdentityStatus `
                -IdentityDisplayName $user.DisplayName `
                -IdentitySource $user.IdentitySource
        }
        catch {
            Write-Log ("Failed processing {0} for Safe {1}. Error: {2}" -f $memberName, $targetSafe, $_.Exception.Message) "ERROR"

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Action "AddOrUpdateMember" `
                -Status "Failed" `
                -Detail $_.Exception.Message `
                -IdentitySourceTable $user.IdentitySourceTable `
                -IdentityStatus $user.IdentityStatus `
                -IdentityDisplayName $user.DisplayName `
                -IdentitySource $user.IdentitySource
        }
    }

    Write-Log ("Users with matching IND Safes: {0}" -f $matchedUserCount) "SUCCESS"
    Write-Log ("Users skipped because member already exists: {0}" -f $skippedExistingCount)
    Write-Log ("Users without matching IND Safe: {0}" -f $noMatchingSafeCount)
    Write-Log ("Add/update actions processed or simulated: {0}" -f $processedChangeCount) "SUCCESS"
    Write-Log "IND Safe Identity user membership sync completed." "SUCCESS"
}
catch {
    Write-Log ("Fatal error: {0}" -f $_.Exception.Message) "ERROR"
}
finally {
    try {
        if ($script:RunResults.Count -gt 0) {
            $script:RunResults |
                Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

            Write-Log ("Audit CSV exported to: {0}" -f $CsvFilePath) "SUCCESS"
        }
        else {
            Write-Log "No audit rows were generated."
        }
    }
    catch {
        Write-Log ("Failed to export audit CSV: {0}" -f $_.Exception.Message) "ERROR"
    }

    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Log "Closed Privilege Cloud session." "SUCCESS"
        }
        catch {
            Write-Log ("Session close warning: {0}" -f $_.Exception.Message) "WARN"
        }
    }

    if ($script:OriginalPSModulePath) {
        $env:PSModulePath = $script:OriginalPSModulePath
    }
}
