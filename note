<#
Run-ReconcileFromCsv_CNA.ps1

PURPOSE
- Log in to CNA Privilege Cloud using the same CCP + Identity header pattern
- Read accounts from CSV
- Find each account in CyberArk by Username + Address
- Optionally narrow by Safe / PlatformID if those columns exist in the CSV
- Submit immediate reconcile via psPAS
- Export a detailed results CSV

SUPPORTED CSV HEADERS (flexible)
Required:
- Username
- Address

Also accepted:
- UserName
- userName
- Target system user name

- Target system address
- Hostname
- Machine
- AccountAddress

Optional:
- Safe
- SafeName
- PlatformID
- platformId

DEFAULT CSV PATH
E:\Installation Media\Script\OnboardScript\csv\Accounts_To_Reconcile.csv
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings (CNA) =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Input / output =====
    [string]$CsvPath           = 'E:\Installation Media\Script\OnboardScript\csv\Accounts_To_Reconcile.csv',
    [string]$LogPath           = 'E:\Installation Media\Script\OnboardScript\logs\Run-ReconcileFromCsv_CNA.log',
    [string]$ReportPath        = '',

    # ===== Matching options =====
    [int]$SearchLimit          = 500,
    [switch]$AllowShortHostMatch
)

# -----------------------------
# Initial setup
# -----------------------------
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

if ([string]::IsNullOrWhiteSpace($ReportPath)) {
    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $ReportPath = "E:\Installation Media\Script\OnboardScript\logs\Run-ReconcileFromCsv_CNA_$stamp.csv"
}

# Ensure folders exist
foreach ($path in @($LogPath, $ReportPath)) {
    try {
        $parent = Split-Path -Path $path -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
    } catch {}
}

# -----------------------------
# Logging
# -----------------------------
function Write-Log {
    param(
        [string]$Message,
        [string]$Color = 'White'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $entry = "$timestamp - $Message"

    try { Write-Host $entry -ForegroundColor $Color } catch { Write-Host $entry }
    try { Add-Content -Path $LogPath -Value $entry } catch {}
}

# -----------------------------
# Helpers
# -----------------------------
function Get-NormalizedIdentityTenant {
    param([Parameter(Mandatory)][string]$TenantUrl)

    $value = $TenantUrl.Trim()
    $value = $value -replace '^https?://', ''
    $value = $value.TrimEnd('/')

    return $value
}

function Normalize-Text {
    param([AllowNull()][string]$Value)

    if ($null -eq $Value) { return '' }
    return $Value.Trim().ToLowerInvariant()
}

function Normalize-Address {
    param([AllowNull()][string]$Value)

    if ($null -eq $Value) { return '' }

    $v = $Value.Trim().ToLowerInvariant()
    $v = $v.TrimEnd('\')
    $v = $v.TrimEnd('/')

    return $v
}

function Get-ShortHost {
    param([AllowNull()][string]$Value)

    $v = Normalize-Address $Value
    if ([string]::IsNullOrWhiteSpace($v)) { return '' }

    if ($v.Contains('.')) {
        return $v.Split('.')[0]
    }

    return $v
}

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        $prop = $Object.PSObject.Properties[$name]
        if ($prop -and $null -ne $prop.Value -and "$($prop.Value)".Trim() -ne '') {
            return [string]$prop.Value
        }
    }

    return $null
}

function Get-HashtableLikeValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string[]]$Names
    )

    if ($null -eq $Object) { return $null }

    # IDictionary
    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($name in $Names) {
            if ($Object.Contains($name) -and $null -ne $Object[$name] -and "$($Object[$name])".Trim() -ne '') {
                return [string]$Object[$name]
            }
        }
    }

    # PSCustomObject / object with properties
    foreach ($name in $Names) {
        $prop = $Object.PSObject.Properties[$name]
        if ($prop -and $null -ne $prop.Value -and "$($prop.Value)".Trim() -ne '') {
            return [string]$prop.Value
        }
    }

    return $null
}

function Get-AccountID {
    param([Parameter(Mandatory)][object]$Account)
    return (Get-ObjectPropertyValue -Object $Account -Names @('id','ID','AccountID','accountID'))
}

function Get-AccountUserName {
    param([Parameter(Mandatory)][object]$Account)

    $direct = Get-ObjectPropertyValue -Object $Account -Names @('userName','UserName','username','Username')
    if (-not [string]::IsNullOrWhiteSpace($direct)) { return $direct }

    $platformProps = Get-ObjectPropertyValue -Object $Account -Names @('platformAccountProperties')
    if ($platformProps) {
        $pp = $Account.platformAccountProperties
        $indirect = Get-HashtableLikeValue -Object $pp -Names @('UserName','Username','userName','username')
        if (-not [string]::IsNullOrWhiteSpace($indirect)) { return $indirect }
    }

    return $null
}

function Get-AccountAddress {
    param([Parameter(Mandatory)][object]$Account)

    $direct = Get-ObjectPropertyValue -Object $Account -Names @('address','Address')
    if (-not [string]::IsNullOrWhiteSpace($direct)) { return $direct }

    $pp = $Account.PSObject.Properties['platformAccountProperties']
    if ($pp -and $null -ne $pp.Value) {
        $indirect = Get-HashtableLikeValue -Object $pp.Value -Names @('Address','address','Machine','HostName','Hostname')
        if (-not [string]::IsNullOrWhiteSpace($indirect)) { return $indirect }
    }

    return $null
}

function Get-AccountSafeName {
    param([Parameter(Mandatory)][object]$Account)
    return (Get-ObjectPropertyValue -Object $Account -Names @('safeName','SafeName','safe','Safe'))
}

function Get-AccountPlatformID {
    param([Parameter(Mandatory)][object]$Account)
    return (Get-ObjectPropertyValue -Object $Account -Names @('platformId','platformID','PlatformID'))
}

function Get-RowValue {
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string[]]$Aliases
    )

    foreach ($alias in $Aliases) {
        $prop = $Row.PSObject.Properties[$alias]
        if ($prop -and $null -ne $prop.Value -and "$($prop.Value)".Trim() -ne '') {
            return [string]$prop.Value
        }
    }

    return $null
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName
    )

    $headers = @{ 'Content-Type' = 'application/json' }
    $ccpUrl  = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName)
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response'
        }
    } catch {
        Write-Log ("❌ ERROR: CCP credential fetch failed - {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null
    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("✅ Successfully retrieved credentials for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL
        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication (psPAS Identity header) as {0}..." -f $resolvedUser)
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established'
        }

        Write-Log ("✅ Authentication successful, PAS session established ({0})." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("❌ Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    return $resp
}

function Resolve-CyberArkAccount {
    param(
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address,
        [string]$SafeName,
        [string]$PlatformID
    )

    $normUser     = Normalize-Text $UserName
    $normAddr     = Normalize-Address $Address
    $normSafe     = Normalize-Text $SafeName
    $normPlatform = Normalize-Text $PlatformID

    $searchResults = @()

    try {
        if (-not [string]::IsNullOrWhiteSpace($SafeName)) {
            $searchResults = @(Get-PASAccount -safeName $SafeName -search $UserName -limit $SearchLimit -ErrorAction Stop)
        } else {
            $searchResults = @(Get-PASAccount -search $UserName -limit $SearchLimit -ErrorAction Stop)
        }
    } catch {
        return [pscustomobject]@{
            Status     = 'LookupError'
            MatchType  = ''
            Detail     = $_.Exception.Message
            Candidates = @()
            Account    = $null
        }
    }

    # Fallback search using both username and address keywords if username-only search came back empty
    if (($null -eq $searchResults -or $searchResults.Count -eq 0) -and -not [string]::IsNullOrWhiteSpace($Address)) {
        try {
            $compositeSearch = "$UserName $Address"
            if (-not [string]::IsNullOrWhiteSpace($SafeName)) {
                $searchResults = @(Get-PASAccount -safeName $SafeName -search $compositeSearch -limit $SearchLimit -ErrorAction Stop)
            } else {
                $searchResults = @(Get-PASAccount -search $compositeSearch -limit $SearchLimit -ErrorAction Stop)
            }
        } catch {
            # keep prior outcome
        }
    }

    $exact = @(
        $searchResults | Where-Object {
            $candUser     = Normalize-Text (Get-AccountUserName $_)
            $candAddr     = Normalize-Address (Get-AccountAddress $_)
            $candSafe     = Normalize-Text (Get-AccountSafeName $_)
            $candPlatform = Normalize-Text (Get-AccountPlatformID $_)

            $userOk     = ($candUser -eq $normUser)
            $addrOk     = ($candAddr -eq $normAddr)
            $safeOk     = ([string]::IsNullOrWhiteSpace($SafeName)  -or ($candSafe -eq $normSafe))
            $platformOk = ([string]::IsNullOrWhiteSpace($PlatformID) -or ($candPlatform -eq $normPlatform))

            $userOk -and $addrOk -and $safeOk -and $platformOk
        }
    )

    if ($exact.Count -eq 1) {
        return [pscustomobject]@{
            Status     = 'Matched'
            MatchType  = 'Exact'
            Detail     = 'Single exact Username + Address match found.'
            Candidates = $exact
            Account    = $exact[0]
        }
    }

    if ($exact.Count -gt 1) {
        return [pscustomobject]@{
            Status     = 'MultipleMatches'
            MatchType  = 'Exact'
            Detail     = "Multiple exact matches found ($($exact.Count))."
            Candidates = $exact
            Account    = $null
        }
    }

    if ($AllowShortHostMatch -and -not [string]::IsNullOrWhiteSpace($Address)) {
        $targetShort = Get-ShortHost $Address

        $shortMatches = @(
            $searchResults | Where-Object {
                $candUser      = Normalize-Text (Get-AccountUserName $_)
                $candShortAddr = Get-ShortHost (Get-AccountAddress $_)
                $candSafe      = Normalize-Text (Get-AccountSafeName $_)
                $candPlatform  = Normalize-Text (Get-AccountPlatformID $_)

                $userOk     = ($candUser -eq $normUser)
                $addrOk     = ($candShortAddr -eq $targetShort)
                $safeOk     = ([string]::IsNullOrWhiteSpace($SafeName)  -or ($candSafe -eq $normSafe))
                $platformOk = ([string]::IsNullOrWhiteSpace($PlatformID) -or ($candPlatform -eq $normPlatform))

                $userOk -and $addrOk -and $safeOk -and $platformOk
            }
        )

        if ($shortMatches.Count -eq 1) {
            return [pscustomobject]@{
                Status     = 'Matched'
                MatchType  = 'ShortHost'
                Detail     = 'Single Username + short-host match found.'
                Candidates = $shortMatches
                Account    = $shortMatches[0]
            }
        }

        if ($shortMatches.Count -gt 1) {
            return [pscustomobject]@{
                Status     = 'MultipleMatches'
                MatchType  = 'ShortHost'
                Detail     = "Multiple short-host matches found ($($shortMatches.Count))."
                Candidates = $shortMatches
                Account    = $null
            }
        }
    }

    return [pscustomobject]@{
        Status     = 'NotFound'
        MatchType  = ''
        Detail     = "No exact CyberArk account match found for Username='$UserName' Address='$Address'."
        Candidates = $searchResults
        Account    = $null
    }
}

# -----------------------------
# Load psPAS
# -----------------------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) 'Green'
} catch {
    Write-Log ("❌ psPAS module not found/loaded: {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# -----------------------------
# Validate CSV
# -----------------------------
if (-not (Test-Path $CsvPath)) {
    Write-Log ("❌ CSV file not found: {0}" -f $CsvPath) 'Red'
    exit 1
}

try {
    $rows = Import-Csv -Path $CsvPath -ErrorAction Stop
} catch {
    Write-Log ("❌ Failed to read CSV '{0}': {1}" -f $CsvPath, $_.Exception.Message) 'Red'
    exit 1
}

if (-not $rows -or $rows.Count -eq 0) {
    Write-Log ("❌ CSV is empty: {0}" -f $CsvPath) 'Red'
    exit 1
}

Write-Log ("Loaded {0} row(s) from CSV: {1}" -f $rows.Count, $CsvPath) 'Green'

# -----------------------------
# Login
# -----------------------------
try {
    [void](Start-PASSessionFromCCP -ObjectName $CCPObject)
} catch {
    exit 1
}

# -----------------------------
# Process rows
# -----------------------------
$results = New-Object System.Collections.Generic.List[object]
$processedAccountIds = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)

$rowNumber = 0

try {
    foreach ($row in $rows) {
        $rowNumber++

        $csvUser = Get-RowValue -Row $row -Aliases @('Username','UserName','userName','Target system user name')
        $csvAddr = Get-RowValue -Row $row -Aliases @('Address','address','Target system address','Hostname','Machine','AccountAddress')
        $csvSafe = Get-RowValue -Row $row -Aliases @('Safe','safe','SafeName','safeName')
        $csvPlat = Get-RowValue -Row $row -Aliases @('PlatformID','platformId','platformID')

        if ([string]::IsNullOrWhiteSpace($csvUser) -or [string]::IsNullOrWhiteSpace($csvAddr)) {
            $msg = 'Missing required Username and/or Address column value.'
            Write-Log ("Row {0}: ❌ {1}" -f $rowNumber, $msg) 'Red'

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = ''
                AccountID        = ''
                VaultUserName    = ''
                VaultAddress     = ''
                VaultSafe        = ''
                VaultPlatformID  = ''
                ActionStatus     = 'InvalidRow'
                Detail           = $msg
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null

            continue
        }

        Write-Log ("Row {0}: Looking up account Username='{1}' Address='{2}'..." -f $rowNumber, $csvUser, $csvAddr) 'Cyan'

        $resolved = Resolve-CyberArkAccount -UserName $csvUser -Address $csvAddr -SafeName $csvSafe -PlatformID $csvPlat

        if ($resolved.Status -ne 'Matched') {
            $msgColor = if ($resolved.Status -eq 'MultipleMatches') { 'Yellow' } else { 'Red' }
            Write-Log ("Row {0}: {1} - {2}" -f $rowNumber, $resolved.Status, $resolved.Detail) $msgColor

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = $resolved.MatchType
                AccountID        = ''
                VaultUserName    = ''
                VaultAddress     = ''
                VaultSafe        = ''
                VaultPlatformID  = ''
                ActionStatus     = $resolved.Status
                Detail           = $resolved.Detail
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null

            continue
        }

        $account         = $resolved.Account
        $accountId       = Get-AccountID $account
        $vaultUser       = Get-AccountUserName $account
        $vaultAddr       = Get-AccountAddress $account
        $vaultSafe       = Get-AccountSafeName $account
        $vaultPlatformId = Get-AccountPlatformID $account

        if ([string]::IsNullOrWhiteSpace($accountId)) {
            $msg = 'Matched account, but AccountID was empty.'
            Write-Log ("Row {0}: ❌ {1}" -f $rowNumber, $msg) 'Red'

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = $resolved.MatchType
                AccountID        = ''
                VaultUserName    = $vaultUser
                VaultAddress     = $vaultAddr
                VaultSafe        = $vaultSafe
                VaultPlatformID  = $vaultPlatformId
                ActionStatus     = 'MatchWithoutID'
                Detail           = $msg
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null

            continue
        }

        if ($processedAccountIds.Contains($accountId)) {
            $msg = "AccountID '$accountId' already processed earlier in this run."
            Write-Log ("Row {0}: ⚠️ {1}" -f $rowNumber, $msg) 'Yellow'

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = $resolved.MatchType
                AccountID        = $accountId
                VaultUserName    = $vaultUser
                VaultAddress     = $vaultAddr
                VaultSafe        = $vaultSafe
                VaultPlatformID  = $vaultPlatformId
                ActionStatus     = 'SkippedDuplicateInRun'
                Detail           = $msg
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null

            continue
        }

        try {
            Write-Log ("Row {0}: Submitting reconcile for AccountID='{1}' UserName='{2}' Address='{3}'..." -f $rowNumber, $accountId, $vaultUser, $vaultAddr) 'Cyan'

            Invoke-PASCPMOperation -AccountID $accountId -ReconcileTask -Confirm:$false -ErrorAction Stop | Out-Null
            [void]$processedAccountIds.Add($accountId)

            $msg = 'Reconcile submitted successfully.'
            Write-Log ("Row {0}: ✅ {1}" -f $rowNumber, $msg) 'Green'

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = $resolved.MatchType
                AccountID        = $accountId
                VaultUserName    = $vaultUser
                VaultAddress     = $vaultAddr
                VaultSafe        = $vaultSafe
                VaultPlatformID  = $vaultPlatformId
                ActionStatus     = 'ReconcileSubmitted'
                Detail           = $msg
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null
        } catch {
            $msg = $_.Exception.Message
            Write-Log ("Row {0}: ❌ Reconcile failed for AccountID='{1}' - {2}" -f $rowNumber, $accountId, $msg) 'Red'

            $results.Add([pscustomobject]@{
                RowNumber        = $rowNumber
                CsvUserName      = $csvUser
                CsvAddress       = $csvAddr
                CsvSafe          = $csvSafe
                CsvPlatformID    = $csvPlat
                MatchType        = $resolved.MatchType
                AccountID        = $accountId
                VaultUserName    = $vaultUser
                VaultAddress     = $vaultAddr
                VaultSafe        = $vaultSafe
                VaultPlatformID  = $vaultPlatformId
                ActionStatus     = 'ReconcileFailed'
                Detail           = $msg
                ProcessedAt      = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            }) | Out-Null
        }
    }
}
finally {
    try {
        Close-PASSession | Out-Null
        Write-Log '✅ PAS session closed.' 'Green'
    } catch {}
}

# -----------------------------
# Export report
# -----------------------------
try {
    $results | Export-Csv -Path $ReportPath -NoTypeInformation -Encoding UTF8
    Write-Log ("✅ Results exported to: {0}" -f $ReportPath) 'Green'
} catch {
    Write-Log ("❌ Failed to export report: {0}" -f $_.Exception.Message) 'Red'
}

# -----------------------------
# Summary
# -----------------------------
$submitted = @($results | Where-Object { $_.ActionStatus -eq 'ReconcileSubmitted' }).Count
$failed    = @($results | Where-Object { $_.ActionStatus -eq 'ReconcileFailed' }).Count
$notFound  = @($results | Where-Object { $_.ActionStatus -eq 'NotFound' }).Count
$multi     = @($results | Where-Object { $_.ActionStatus -eq 'MultipleMatches' }).Count
$invalid   = @($results | Where-Object { $_.ActionStatus -eq 'InvalidRow' }).Count
$skipped   = @($results | Where-Object { $_.ActionStatus -eq 'SkippedDuplicateInRun' }).Count

Write-Log ("Summary => Submitted: {0} | Failed: {1} | NotFound: {2} | MultipleMatches: {3} | InvalidRow: {4} | SkippedDuplicateInRun: {5}" -f $submitted, $failed, $notFound, $multi, $invalid, $skipped) 'Cyan'



Username,Address,Safe,PlatformID
svc_app01,server01.cna.com,APP_MySafe,WinDomain
svc_app02,server02.cna.com,APP_OtherSafe,UnixSSH
