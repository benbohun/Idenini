<#
ExportSafes_RetentionReport_CCP.ps1

AUTH (Automation)
- CCP -> Service User credential
- Auth to Privilege Cloud via Identity Shared Services
  1) Primary: New-PASSession -IdentityTenantURL -PrivilegeCloudURL -Credential -ServiceUser
  2) Fallback: Get-IdentityHeader -psPASFormat -PCloudSubdomain + Use-PASSession

EXPORT
- CSV:  I:\Script\IDENTITY Script New\csv\SafeRetention_Report_yyyyMMdd_HHmm.csv
- LOG:  I:\Script\IDENTITY Script New\logs\SafeRetention_Report.txt
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Output =====
    [string]$ExportDirectory    = "I:\Script\IDENTITY Script New\csv\",
    [string]$LogFilePath        = "I:\Script\IDENTITY Script New\logs\SafeRetention_Report.txt",

    # ===== Paging (API fallback) =====
    [ValidateRange(50,2000)]
    [int]$PageSize = 500
)

# ---- Execution policy (silent) ----
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

# ---- Modules & TLS ----
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ---- Pretty log helpers ----
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

function Write-LogLine {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Write-Output $line
    Add-Content -Path $LogFilePath -Value $line
}

function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-Path $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Get-HostFromUrl {
    param([Parameter(Mandatory)][string]$Url)
    try { return ([uri]$Url).Host } catch {
        return ($Url -replace '^https?://','' -replace '/.*$','').Trim()
    }
}

function Get-PCloudSubdomainFromUrl {
    param([Parameter(Mandatory)][string]$PrivilegeCloudURL)

    # ✅ FIX: Do NOT use $host (conflicts with built-in $Host)
    $pcloudHost = Get-HostFromUrl $PrivilegeCloudURL

    # host like: alliantcredit.privilegecloud.cyberark.cloud -> subdomain alliantcredit
    return ($pcloudHost.Split('.')[0]).Trim()
}

function Convert-ToIntSafe {
    param($Value)
    if ($null -eq $Value) { return 0 }
    $s = [string]$Value
    if ([string]::IsNullOrWhiteSpace($s)) { return 0 }
    $out = 0
    if ([int]::TryParse($s.Trim(), [ref]$out)) { return $out }
    return 0
}

function Get-PropValueCI {
    <#
      Case-insensitive property getter:
      - Returns $null if not found
    #>
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$PropName
    )
    if ($null -eq $Object) { return $null }
    $p = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $PropName } | Select-Object -First 1
    if ($p) { return $p.Value }
    return $null
}

# --- CCP -> PSCredential ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving Service User credential from CCP..."
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"
    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- Auth helper: Primary (New-PASSession), Fallback (Get-IdentityHeader/Use-PASSession) ---
function Connect-PCloudWithServiceUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL,
        [Parameter(Mandatory)][pscredential]$ServiceCred
    )

    # Normalize Identity tenant host for fallback Get-IdentityHeader
    $tenantHost = Get-HostFromUrl $IdentityTenantURL
    $subdomain  = Get-PCloudSubdomainFromUrl $PrivilegeCloudURL

    Write-Info "Attempting login (Primary): New-PASSession (ServiceUser)..."
    try {
        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential        $ServiceCred `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        $sess = Get-PASSession
        if (-not $sess) { throw "Get-PASSession returned null after New-PASSession." }

        Write-Ok "Authenticated (Primary) to $PrivilegeCloudURL as $($ServiceCred.UserName)"
        return
    }
    catch {
        Write-Warn "Primary login failed: $($_.Exception.Message)"
        Write-Info "Attempting login (Fallback): Get-IdentityHeader + Use-PASSession..."

        $cmd = Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue
        if (-not $cmd) {
            throw "Fallback login not available (Get-IdentityHeader not found). Primary login failed."
        }

        $header = Get-IdentityHeader `
            -IdentityTenantURL $tenantHost `
            -psPASFormat `
            -PCloudSubdomain $subdomain `
            -UPCreds $ServiceCred

        Use-PASSession $header

        $sess2 = Get-PASSession
        if (-not $sess2) { throw "Get-PASSession returned null after Use-PASSession." }

        Write-Ok "Authenticated (Fallback) to $PrivilegeCloudURL as $($ServiceCred.UserName)"
        return
    }
}

# --- API fallback: list safes (Gen2) + get safe details ---
function Get-AllSafesViaAPI {
    [CmdletBinding()]
    param([int]$Limit = 500)

    $offset = 0
    $all = New-Object System.Collections.Generic.List[object]

    while ($true) {
        $uri = "api/Safes?limit=$Limit&offset=$offset"
        $resp = Invoke-PASRestMethod -Method GET -URI $uri -ErrorAction Stop

        $items = $null
        $count = $null

        # handle common shapes: { value:[], count:n } or direct array
        $items = Get-PropValueCI -Object $resp -PropName "value"
        $count = Get-PropValueCI -Object $resp -PropName "count"

        if ($null -eq $items) {
            if ($resp -is [System.Collections.IEnumerable]) { $items = $resp } else { $items = @() }
        }

        foreach ($i in $items) { $all.Add($i) | Out-Null }

        if ($null -ne $count) {
            $offset += $Limit
            if ($offset -ge [int]$count) { break }
        }
        else {
            # if no count is provided, stop when we receive less than limit
            if (($items | Measure-Object).Count -lt $Limit) { break }
            $offset += $Limit
        }
    }

    return ,$all.ToArray()
}

function Get-SafeDetailsViaAPI {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$SafeName)

    $enc = [uri]::EscapeDataString($SafeName)
    return (Invoke-PASRestMethod -Method GET -URI ("api/Safes/{0}" -f $enc) -ErrorAction Stop)
}

# ============================
# MAIN
# ============================
$sessionCreated = $false

try {
    Ensure-Directory -Path (Split-Path $LogFilePath -Parent)
    Ensure-Directory -Path $ExportDirectory

    New-Item -ItemType File -Path $LogFilePath -Force | Out-Null
    Write-LogLine "Starting safe retention export run." "INFO"

    $timestamp = Get-Date -Format "yyyyMMdd_HHmm"
    $exportCsv = Join-Path $ExportDirectory ("SafeRetention_Report_{0}.csv" -f $timestamp)

    # 1) Get service user from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 2) Login using service user automation
    Connect-PCloudWithServiceUser -IdentityTenantURL $IdentityTenantURL -PrivilegeCloudURL $PrivilegeCloudURL -ServiceCred $serviceCred
    $sessionCreated = $true
    Write-LogLine "Authenticated successfully." "SUCCESS"

    # 3) Get all safes (prefer Get-PASSafe; fallback to API paging)
    Write-Info "Retrieving safes..."
    $safes = @()

    try {
        # Get-PASSafe (default) should return all safes with details on modern PAS/Privilege Cloud :contentReference[oaicite:1]{index=1}
        $safes = @(Get-PASSafe -ErrorAction Stop)
    }
    catch {
        Write-Warn "Get-PASSafe failed: $($_.Exception.Message)"
        Write-Info "Falling back to API paging (api/Safes)..."
        $safes = @(Get-AllSafesViaAPI -Limit $PageSize)
    }

    if (-not $safes -or $safes.Count -eq 0) {
        throw "No safes returned. Check permissions/service user membership."
    }

    Write-Ok ("Safes retrieved: {0}" -f $safes.Count)
    Write-LogLine ("Safes retrieved: {0}" -f $safes.Count) "INFO"

    # Determine if we already have retention fields in the safe objects; if not, pull per-safe details
    $hasRetentionFields = $false
    foreach ($s in ($safes | Select-Object -First 25)) {
        $d = Get-PropValueCI -Object $s -PropName "numberOfDaysRetention"
        $v = Get-PropValueCI -Object $s -PropName "numberOfVersionsRetention"
        if ($null -ne $d -or $null -ne $v) { $hasRetentionFields = $true; break }
    }

    if (-not $hasRetentionFields) {
        Write-Warn "Safe objects do not include retention fields; retrieving per-safe details via API..."
        Write-LogLine "Retention fields missing in list results; using per-safe detail calls." "WARN"
    }

    # 4) Build report
    $report = New-Object System.Collections.Generic.List[object]
    $i = 0

    foreach ($s in $safes) {
        $i++
        try {
            $safeName = (Get-PropValueCI -Object $s -PropName "safeName")
            if ([string]::IsNullOrWhiteSpace($safeName)) {
                $safeName = (Get-PropValueCI -Object $s -PropName "SafeName")
            }
            if ([string]::IsNullOrWhiteSpace($safeName)) {
                throw "Unable to determine safeName from object."
            }
            $safeName = $safeName.Trim()

            $detail = $s
            if (-not $hasRetentionFields) {
                $detail = Get-SafeDetailsViaAPI -SafeName $safeName
            }

            $daysVal = Convert-ToIntSafe (Get-PropValueCI -Object $detail -PropName "numberOfDaysRetention")
            if ($daysVal -eq 0) { $daysVal = Convert-ToIntSafe (Get-PropValueCI -Object $detail -PropName "NumberOfDaysRetention") }

            $versVal = Convert-ToIntSafe (Get-PropValueCI -Object $detail -PropName "numberOfVersionsRetention")
            if ($versVal -eq 0) { $versVal = Convert-ToIntSafe (Get-PropValueCI -Object $detail -PropName "NumberOfVersionsRetention") }

            $daysEnabled = ($daysVal -gt 0)
            $versEnabled = ($versVal -gt 0)

            $effectiveType  = if ($daysEnabled) { "Days" } elseif ($versEnabled) { "Versions" } else { "None" }
            $effectiveValue = if ($daysEnabled) { $daysVal } elseif ($versEnabled) { $versVal } else { 0 }

            $report.Add([PSCustomObject]@{
                SafeName                         = $safeName

                NumberOfDaysRetention_Enabled    = [bool]$daysEnabled
                NumberOfDaysRetention_Value      = [int]$daysVal

                NumberOfVersionsRetention_Enabled= [bool]$versEnabled
                NumberOfVersionsRetention_Value  = [int]$versVal

                EffectiveRetentionType           = $effectiveType
                EffectiveRetentionValue          = [int]$effectiveValue
            }) | Out-Null

            if (($i % 200) -eq 0) {
                Write-Info ("Processed {0}/{1} safes..." -f $i, $safes.Count)
            }
        }
        catch {
            Write-LogLine ("Safe processing failed. SafeRef='{0}' Error: {1}" -f ($s | Out-String).Trim(), $_.Exception.Message) "ERROR"
            continue
        }
    }

    # 5) Export CSV
    $report | Sort-Object SafeName | Export-Csv -Path $exportCsv -NoTypeInformation -Encoding UTF8
    Write-Ok "Export complete: $exportCsv"
    Write-LogLine "Export complete: $exportCsv" "SUCCESS"
}
catch {
    Write-LogLine "Fatal error: $($_.Exception.Message)" "ERROR"
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-LogLine "Logged off." "INFO"
        } catch {
            Write-LogLine "Logoff warning: $($_.Exception.Message)" "WARN"
        }
    }
}
