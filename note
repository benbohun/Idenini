[CmdletBinding()]
param(
    [string]$CsvPath          = "E:\Installation Media\Script\OnboardScript\csv\OverrideComponentPlatform.csv",
    [string]$OutputRoot       = "E:\Installation Media\Script\OnboardScript\logs\Platform_HTML5_Override",
    [string]$DonorPlatformID  = "Prd_WinDom_Adm_HTML5_DONOR",
    [string]$TargetConnectorID = "PSM-HTML_OVERIDE",
    [switch]$WhatIf
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet("Gray","Green","Yellow","Red","Cyan","White","Magenta")]
        [string]$Color = "White"
    )
    $stamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Host ("{0} | {1}" -f $stamp, $Message) -ForegroundColor $Color
}

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
}
catch {
    Write-Log ("ERROR: psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

$CCPAddress      = "https://vskau1p1231.cna.com"
$CCPLocation     = "AIMWebService"
$CCPAppID        = "PAMDiscovery"
$CCPSafe         = "CA_PCloud_Admins"
$CCPObject       = "cna.com-CA_PAMDiscovery_SVC"
$ServiceUPUser   = "CA_PAMDiscovery_SVC"
$CCPWindowsAuth  = $false

$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

$BackupRoot = Join-Path $OutputRoot "Backups"
$WorkRoot   = Join-Path $OutputRoot "Work"
$ReportRoot = Join-Path $OutputRoot "Reports"

foreach ($folder in @($OutputRoot, $BackupRoot, $WorkRoot, $ReportRoot)) {
    if (-not (Test-Path -LiteralPath $folder)) {
        $null = New-Item -Path $folder -ItemType Directory -Force
    }
}

function Normalize-Token {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return "" }
    return (($Value.ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function Get-SafeFileName {
    param([Parameter(Mandatory)][string]$Name)
    return ($Name -replace '[\\/:*?"<>|]', '_')
}

function Get-PASWebSession {
    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found."
    }
    return $s.WebSession
}

function Get-HttpStatusCodeFromError {
    param([Parameter(Mandatory)]$ErrorRecord)

    try {
        if ($ErrorRecord.Exception.Response -and $ErrorRecord.Exception.Response.StatusCode) {
            return [int]$ErrorRecord.Exception.Response.StatusCode
        }
    }
    catch {}

    try {
        if ($ErrorRecord.Exception.StatusCode) {
            return [int]$ErrorRecord.Exception.StatusCode
        }
    }
    catch {}

    return $null
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $ccpUrl = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"

    $resp = Invoke-RestMethod `
        -Uri $ccpUrl `
        -Method GET `
        -Headers @{ "Content-Type" = "application/json" } `
        -UseDefaultCredentials:$CCPWindowsAuth `
        -ErrorAction Stop

    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred `
        -ErrorAction Stop

    Use-PASSession $headerSession | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

function Invoke-EPVRest {
    param(
        [Parameter(Mandatory)]
        [ValidateSet("GET","POST","PUT","DELETE","PATCH")]
        [string]$Method,

        [Parameter(Mandatory)][string]$RelativePath,
        [object]$Body
    )

    $webSession = Get-PASWebSession
    $path = $RelativePath.TrimStart('/')
    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $candidatePath = $path -replace '^(API|api)', $apiPrefix
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}" -f $PCloudSubdomain, $candidatePath

        try {
            $params = @{
                Uri         = $uri
                Method      = $Method
                WebSession  = $webSession
                ErrorAction = "Stop"
            }

            if ($null -ne $Body) {
                $params["ContentType"] = "application/json"
                $params["Body"] = ($Body | ConvertTo-Json -Depth 50 -Compress)
            }

            return Invoke-RestMethod @params
        }
        catch {
            $lastError = $_
        }
    }

    throw $lastError
}

function Get-PlatformByStringId {
    param([Parameter(Mandatory)][string]$PlatformID)

    $search = [uri]::EscapeDataString($PlatformID)
    $result = Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets?search={0}" -f $search)

    $platforms = @($result.Platforms)
    $matches = @($platforms | Where-Object { $_.PlatformID -eq $PlatformID })

    if ($matches.Count -eq 0) {
        throw "Platform [$PlatformID] was not found."
    }

    if ($matches.Count -gt 1) {
        throw "Multiple exact matches returned for platform [$PlatformID]."
    }

    return $matches[0]
}

function Get-PlatformSessionManagementByNumericId {
    param([Parameter(Mandatory)][int]$PlatformNumericID)

    return Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets/{0}/PrivilegedSessionManagement/" -f $PlatformNumericID)
}

function Get-StoredPlatformDetails {
    return Invoke-EPVRest -Method GET -RelativePath "API/Platforms/Storage"
}

function Export-PlatformZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$DestinationFolder
    )

    $safeName = Get-SafeFileName -Name $PlatformID
    $stamp    = Get-Date -Format "yyyyMMdd_HHmmss"
    $zipPath  = Join-Path $DestinationFolder ("{0}_{1}.zip" -f $safeName, $stamp)

    $webSession = Get-PASWebSession
    $encoded = [uri]::EscapeDataString($PlatformID)
    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}/Platforms/{2}/Export/" -f `
            $PCloudSubdomain, $apiPrefix, $encoded

        try {
            Invoke-WebRequest -Uri $uri -Method POST -WebSession $webSession -OutFile $zipPath -ErrorAction Stop | Out-Null
            break
        }
        catch {
            $lastError = $_
        }
    }

    if (-not (Test-Path -LiteralPath $zipPath)) {
        throw $lastError
    }

    return $zipPath
}

function Clear-StoredPlatformSilently {
    try {
        Invoke-EPVRest -Method DELETE -RelativePath "API/Platforms/Storage" | Out-Null
    }
    catch {}
}

function Import-PlatformZipToStorageOrConflict {
    param([Parameter(Mandatory)][string]$ZipPath)

    $bytes  = [System.IO.File]::ReadAllBytes($ZipPath)
    $base64 = [System.Convert]::ToBase64String($bytes)

    try {
        $result = Invoke-EPVRest -Method POST -RelativePath "API/Platforms/Import/" -Body @{ ImportFile = $base64 }

        return [pscustomobject]@{
            ImportStatus = "CREATED"
            Result       = $result
        }
    }
    catch {
        $status = Get-HttpStatusCodeFromError -ErrorRecord $_
        if ($status -eq 409) {
            return [pscustomobject]@{
                ImportStatus = "CONFLICT_STORED"
                Result       = $null
            }
        }
        throw
    }
}

function Confirm-StoredPlatformConflict {
    param([Parameter(Mandatory)][string]$TargetPlatformID)

    $stored = Get-StoredPlatformDetails

    $storedPlatformId = ""
    try { $storedPlatformId = [string]$stored.StoredPlatformDetails.Id } catch {}

    $conflicted = @()
    try { $conflicted = @($stored.ConflictedPlatformsDetails) } catch {}

    $matchedConflict = @($conflicted | Where-Object { $_.Id -eq $TargetPlatformID })

    if ([string]::IsNullOrWhiteSpace($storedPlatformId)) {
        throw "Stored platform details are empty after import/conflict."
    }

    if ($matchedConflict.Count -eq 0 -and $storedPlatformId -ne $TargetPlatformID) {
        throw ("Stored platform exists, but target platform [{0}] is not listed as a conflicted platform." -f $TargetPlatformID)
    }

    return [pscustomobject]@{
        StoredPlatformId = $storedPlatformId
        StoredName       = [string]$stored.StoredPlatformDetails.Name
        ConflictedIds    = (($conflicted | ForEach-Object { $_.Id }) -join "; ")
    }
}

function Update-PlatformWithStored {
    param([Parameter(Mandatory)][string]$PlatformID)

    $encoded = [uri]::EscapeDataString($PlatformID)
    return Invoke-EPVRest -Method POST -RelativePath ("API/Platforms/{0}/Update" -f $encoded)
}

function Expand-ZipPackage {
    param(
        [Parameter(Mandatory)][string]$ZipPath,
        [Parameter(Mandatory)][string]$DestinationPath
    )

    if (Test-Path -LiteralPath $DestinationPath) {
        Remove-Item -LiteralPath $DestinationPath -Recurse -Force
    }

    $null = New-Item -Path $DestinationPath -ItemType Directory -Force
    Expand-Archive -LiteralPath $ZipPath -DestinationPath $DestinationPath -Force
}

function Compress-ZipPackage {
    param(
        [Parameter(Mandatory)][string]$SourceDirectory,
        [Parameter(Mandatory)][string]$ZipPath
    )

    if (Test-Path -LiteralPath $ZipPath) {
        Remove-Item -LiteralPath $ZipPath -Force
    }

    $items = @(Get-ChildItem -LiteralPath $SourceDirectory -Force)
    if ($items.Count -eq 0) {
        throw "Source directory is empty: $SourceDirectory"
    }

    $paths = @($items | ForEach-Object { $_.FullName })
    Compress-Archive -Path $paths -DestinationPath $ZipPath -Force
}

function Get-XmlFilesFromFolder {
    param([Parameter(Mandatory)][string]$Folder)

    return @(Get-ChildItem -LiteralPath $Folder -Recurse -File -Filter "*.xml")
}

function Get-NodeContextStrings {
    param([Parameter(Mandatory)]$Node)

    $items = @()
    $current = $Node

    while ($null -ne $current) {
        if ($null -ne $current.Attributes) {
            foreach ($attrName in @("Name","ID","Id","ComponentName","ConnectionComponent","PSMConnectorID","ConnectorID","DisplayName")) {
                $attr = $current.Attributes[$attrName]
                if ($null -ne $attr -and -not [string]::IsNullOrWhiteSpace($attr.Value)) {
                    $val = $attr.Value.Trim()
                    if ($items -notcontains $val) {
                        $items += $val
                    }
                }
            }
        }
        $current = $current.ParentNode
    }

    return @($items)
}

function Test-ComponentMatch {
    param(
        [Parameter(Mandatory)]$Node,
        [string]$ConnectionComponentName
    )

    $needle = Normalize-Token $ConnectionComponentName
    $contexts = @(Get-NodeContextStrings -Node $Node)

    foreach ($ctx in $contexts) {
        $norm = Normalize-Token $ctx
        if ([string]::IsNullOrWhiteSpace($norm)) { continue }
        if ($norm -eq $needle) { return $true }
        if ($norm.Contains($needle)) { return $true }
        if ($needle.Contains($norm)) { return $true }
    }

    return $false
}

function Get-ConnectorParameterSeedFromDonor {
    param(
        [Parameter(Mandatory)][string]$ExtractDir,
        [Parameter(Mandatory)][string]$ConnectorID
    )

    $xmlFiles = Get-XmlFilesFromFolder -Folder $ExtractDir

    foreach ($xmlFile in $xmlFiles) {
        [xml]$xml = Get-Content -LiteralPath $xmlFile.FullName -Raw

        $candidateNodes = @($xml.SelectNodes("//*[local-name()='Parameter' and (@Name='AllowSelectHTML5' or @Name='AllowMappingLocalDrives')]"))
        foreach ($node in $candidateNodes) {
            if (Test-ComponentMatch -Node $node -ConnectionComponentName $ConnectorID) {
                return [pscustomobject]@{
                    SourceXml = $xmlFile.FullName
                    SeedNode  = $node
                }
            }
        }
    }

    throw ("No donor seed node was found for connector [{0}]. On donor platform, make sure Override User Parameters exists under that connector and contains either AllowSelectHTML5 or AllowMappingLocalDrives." -f $ConnectorID)
}

function Inject-ConnectorParameterFromDonor {
    param(
        [Parameter(Mandatory)][string]$TargetExtractDir,
        [Parameter(Mandatory)]$DonorSeedNode,
        [Parameter(Mandatory)][string]$ConnectorID
    )

    $xmlFiles = Get-XmlFilesFromFolder -Folder $TargetExtractDir
    $updated = 0
    $targetXmlPath = ""

    foreach ($xmlFile in $xmlFiles) {
        [xml]$xml = Get-Content -LiteralPath $xmlFile.FullName -Raw

        $connectorHits = @($xml.SelectNodes("//*[local-name()='Parameter' and @Name='Id']"))
        foreach ($idNode in $connectorHits) {
            try {
                if ([string]$idNode.GetAttribute("Value") -eq $ConnectorID -or [string]$idNode.InnerText -eq $ConnectorID) {
                    $parent = $idNode.ParentNode
                    if ($null -eq $parent) { continue }

                    $already = @($parent.SelectNodes(".//*[local-name()='Parameter' and @Name='AllowSelectHTML5']")).Count -gt 0
                    if ($already) {
                        return [pscustomobject]@{
                            UpdatedCount = 0
                            TargetXml    = $xmlFile.FullName
                            AlreadyThere = $true
                        }
                    }

                    $importNode = $xml.ImportNode($DonorSeedNode, $true)

                    Set-XmlAttribute -Element $importNode -Name "Name" -Value "AllowSelectHTML5"
                    Set-XmlAttribute -Element $importNode -Name "DisplayName" -Value "Connect Via Browser"
                    Set-XmlAttribute -Element $importNode -Name "Visible" -Value "Yes"
                    Set-XmlAttribute -Element $importNode -Name "Type" -Value "CyberArk.TransparentConnection.BooleanUserParameter, CyberArk.PasswordVault.TransparentConnection"
                    Set-XmlAttribute -Element $importNode -Name "Required" -Value "Yes"
                    Set-XmlAttribute -Element $importNode -Name "Value" -Value "No"
                    Set-XmlAttribute -Element $importNode -Name "EnforceInDualControlRequest" -Value "No"

                    [void]$parent.AppendChild($importNode)
                    $xml.Save($xmlFile.FullName)

                    $updated++
                    $targetXmlPath = $xmlFile.FullName
                    return [pscustomobject]@{
                        UpdatedCount = $updated
                        TargetXml    = $targetXmlPath
                        AlreadyThere = $false
                    }
                }
            }
            catch {}
        }
    }

    throw ("Target connector [{0}] was validated through API, but no matching connector node was found in exported target XML for injection." -f $ConnectorID)
}

function Build-ModifiedPlatformZipFromDonor {
    param(
        [Parameter(Mandatory)][string]$DonorZip,
        [Parameter(Mandatory)][string]$TargetZip,
        [Parameter(Mandatory)][string]$ConnectorID,
        [Parameter(Mandatory)][string]$WorkingRoot,
        [Parameter(Mandatory)][string]$TargetPlatformID
    )

    $safeName       = Get-SafeFileName -Name $TargetPlatformID
    $donorExtract   = Join-Path $WorkingRoot ("Donor_{0}_{1}" -f $safeName, ([guid]::NewGuid().ToString("N")))
    $targetExtract  = Join-Path $WorkingRoot ("Target_{0}_{1}" -f $safeName, ([guid]::NewGuid().ToString("N")))
    $modifiedZip    = Join-Path $WorkingRoot ("{0}_modified_{1}.zip" -f $safeName, (Get-Date -Format "yyyyMMdd_HHmmss"))

    try {
        Expand-ZipPackage -ZipPath $DonorZip  -DestinationPath $donorExtract
        Expand-ZipPackage -ZipPath $TargetZip -DestinationPath $targetExtract

        $seedInfo = Get-ConnectorParameterSeedFromDonor -ExtractDir $donorExtract -ConnectorID $ConnectorID
        $injectResult = Inject-ConnectorParameterFromDonor -TargetExtractDir $targetExtract -DonorSeedNode $seedInfo.SeedNode -ConnectorID $ConnectorID

        Compress-ZipPackage -SourceDirectory $targetExtract -ZipPath $modifiedZip

        return [pscustomobject]@{
            ModifiedZip   = $modifiedZip
            DonorXml      = $seedInfo.SourceXml
            TargetXml     = $injectResult.TargetXml
            AlreadyThere  = $injectResult.AlreadyThere
        }
    }
    finally {
        foreach ($dir in @($donorExtract, $targetExtract)) {
            if (Test-Path -LiteralPath $dir) {
                Remove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue
            }
        }
    }
}

Write-Log ("Using CSV path: {0}" -f $CsvPath) "Cyan"

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "CSV not found: $CsvPath"
}

$rows = @(Import-Csv -LiteralPath $CsvPath)
if (@($rows).Count -eq 0) {
    throw "CSV is empty: $CsvPath"
}

if (-not ($rows[0].PSObject.Properties.Name -contains "PlatformID")) {
    throw "CSV must contain column 'PlatformID'."
}

$rows = @($rows | Where-Object { -not [string]::IsNullOrWhiteSpace($_.PlatformID) })
if (@($rows).Count -eq 0) {
    throw "CSV contains no usable PlatformID values."
}

$reportItems = @()
Write-Log ("Platforms to process: {0}" -f @($rows).Count) "Green"
Write-Log ("Donor platform: {0}" -f $DonorPlatformID) "Gray"
Write-Log ("Target connector: {0}" -f $TargetConnectorID) "Gray"

try {
    Start-PASSessionFromCCP -ObjectName $CCPObject -UPUser $ServiceUPUser

    $donorLookup = Get-PlatformByStringId -PlatformID $DonorPlatformID
    $donorNumericId = [int]$donorLookup.ID
    $donorPSM = Get-PlatformSessionManagementByNumericId -PlatformNumericID $donorNumericId
    $donorConnectors = @($donorPSM.PSMConnectors)

    $donorHasConnector = @($donorConnectors | Where-Object {
        -not [string]::IsNullOrWhiteSpace($_.PSMConnectorID) -and
        (Normalize-Token $_.PSMConnectorID) -eq (Normalize-Token $TargetConnectorID)
    }).Count -gt 0

    if (-not $donorHasConnector) {
        throw ("Donor platform [{0}] does not have connector [{1}] linked." -f $DonorPlatformID, $TargetConnectorID)
    }

    $donorZip = Export-PlatformZip -PlatformID $DonorPlatformID -DestinationFolder $BackupRoot
    Write-Log "Donor platform export validated." "Green"

    $index = 0
    foreach ($row in $rows) {
        $index++
        $platformID = ([string]$row.PlatformID).Trim()

        $report = [ordered]@{
            Timestamp               = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            DonorPlatformID         = $DonorPlatformID
            PlatformID              = $platformID
            PlatformNumericID       = ""
            ConnectionComponentName = $TargetConnectorID
            PSMServerId             = ""
            LinkedConnectorIDs      = ""
            DonorZip                = $donorZip
            BackupZip               = ""
            ModifiedZip             = ""
            DonorXml                = ""
            TargetXml               = ""
            ImportStatus            = ""
            StoredPlatformId        = ""
            StoredPlatformName      = ""
            ConflictedIds           = ""
            Result                  = ""
            Error                   = ""
        }

        Write-Log ("[{0}/{1}] {2}" -f $index, @($rows).Count, $platformID) "Magenta"

        try {
            $platformLookup = Get-PlatformByStringId -PlatformID $platformID
            $platformNumericID = [int]$platformLookup.ID
            $report.PlatformNumericID = $platformNumericID

            $psmPolicy = Get-PlatformSessionManagementByNumericId -PlatformNumericID $platformNumericID
            $connectorList = @($psmPolicy.PSMConnectors)
            $report.PSMServerId = [string]$psmPolicy.PSMServerId
            $report.LinkedConnectorIDs = (($connectorList | ForEach-Object { $_.PSMConnectorID }) -join "; ")

            $targetHasConnector = @($connectorList | Where-Object {
                -not [string]::IsNullOrWhiteSpace($_.PSMConnectorID) -and
                (Normalize-Token $_.PSMConnectorID) -eq (Normalize-Token $TargetConnectorID)
            }).Count -gt 0

            if (-not $targetHasConnector) {
                throw ("Connector [{0}] is not linked to platform. Linked connectors: {1}" -f `
                    $TargetConnectorID, $report.LinkedConnectorIDs)
            }

            Write-Log ("Validated connector [{0}] on platform." -f $TargetConnectorID) "Green"

            $targetZip = Export-PlatformZip -PlatformID $platformID -DestinationFolder $BackupRoot
            $report.BackupZip = $targetZip
            Write-Log "Platform export validated." "Green"

            $buildResult = Build-ModifiedPlatformZipFromDonor `
                -DonorZip $donorZip `
                -TargetZip $targetZip `
                -ConnectorID $TargetConnectorID `
                -WorkingRoot $WorkRoot `
                -TargetPlatformID $platformID

            $report.ModifiedZip = $buildResult.ModifiedZip
            $report.DonorXml    = $buildResult.DonorXml
            $report.TargetXml   = $buildResult.TargetXml

            if ($WhatIf) {
                Write-Log "Modified package prepared. WHATIF only." "Yellow"
                $report.Result = "WHATIF_ONLY"
            }
            else {
                Clear-StoredPlatformSilently

                $importResult = Import-PlatformZipToStorageOrConflict -ZipPath $buildResult.ModifiedZip
                $report.ImportStatus = $importResult.ImportStatus

                if ($importResult.ImportStatus -eq "CONFLICT_STORED") {
                    Write-Log "Import returned 409 conflict; proceeding with stored-platform overwrite flow." "Yellow"
                }

                $storedCheck = Confirm-StoredPlatformConflict -TargetPlatformID $platformID
                $report.StoredPlatformId   = $storedCheck.StoredPlatformId
                $report.StoredPlatformName = $storedCheck.StoredName
                $report.ConflictedIds      = $storedCheck.ConflictedIds

                $null = Update-PlatformWithStored -PlatformID $platformID

                Write-Log "Platform updated successfully." "Green"
                $report.Result = "UPDATED"
            }
        }
        catch {
            $report.Result = "FAILED"
            $report.Error  = $_.Exception.Message
            Write-Log ("FAILED: {0}" -f $_.Exception.Message) "Red"
        }
        finally {
            $reportItems += [pscustomobject]$report
        }
    }
}
finally {
    try {
        if (Get-Command Close-PASSession -ErrorAction SilentlyContinue) {
            Close-PASSession | Out-Null
        }
    }
    catch {}
}

$reportPath = Join-Path $ReportRoot ("Platform_HTML5_Override_Report_{0}.csv" -f (Get-Date -Format "yyyyMMdd_HHmmss"))
$reportItems | Export-Csv -LiteralPath $reportPath -NoTypeInformation -Encoding UTF8

$success = @($reportItems | Where-Object { $_.Result -eq "UPDATED" -or $_.Result -eq "WHATIF_ONLY" }).Count
$failed  = @($reportItems | Where-Object { $_.Result -eq "FAILED" }).Count

Write-Log ("Report exported: {0}" -f $reportPath) "Green"
Write-Log ("Completed. Success/WhatIf: {0} | Failed: {1}" -f $success, $failed) "Cyan"
