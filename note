# Resolve the target
Resolve-DnsName TARGETSERVER

# Test core connectivity
Test-NetConnection TARGETSERVER -Port 135
Test-NetConnection TARGETSERVER -Port 445

# Confirm remote task visibility
schtasks.exe /query `
    /s TARGETSERVER `
    /tn "\Application Tasks\Daily Processing" `
    /v `
    /fo LIST



Get-ScheduledTask `
    -TaskPath "\Application Tasks\" `
    -TaskName "Daily Processing" |
    Select-Object TaskPath, TaskName,
        @{Name="User";Expression={$_.Principal.UserId}},
        @{Name="LogonType";Expression={$_.Principal.LogonType}},
        @{Name="RunLevel";Expression={$_.Principal.RunLevel}}
