<#
.SYNOPSIS
  Simple test script to validate CyberArk Identity + psPAS session

.DESCRIPTION
  - Prompts for username and password
  - Uses Get-IdentityHeader to get an Identity header
  - Establishes psPAS session using Use-PASSession
  - Prints whether authentication was successful or not

.REQUIREMENTS
  - psPAS module installed and importable
  - Function Get-IdentityHeader available (psPAS or your custom helper)
#>

Clear-Host

Write-Host "==============================================" -ForegroundColor Cyan
Write-Host "   CyberArk Identity → Privilege Cloud Login Test" -ForegroundColor Cyan
Write-Host "==============================================" -ForegroundColor Cyan
Write-Host ""

# ==========================
# CONFIG – EDIT THESE
# ==========================
# Identity tenant (no trailing '/')
$IdentityTenantURL = "https://aap4748.id.cyberark.cloud"    # e.g. https://aap4748.id.cyberark.cloud
# Privilege Cloud subdomain (the part before .privilegecloud.cyberark.cloud)
$PCloudSubdomain   = "alliant-test"                         # e.g. 'alliant-test', 'cna-prod', etc.

# ==========================
# PROMPT FOR CREDENTIALS
# ==========================
Write-Host "Enter CyberArk Identity user (usually UPN, e.g. user@tenant.onmicrosoft.com)" -ForegroundColor Yellow
$UPUser = Read-Host "Username"

if ([string]::IsNullOrWhiteSpace($UPUser)) {
    Write-Host "No username entered. Exiting." -ForegroundColor Red
    exit 1
}

$UPPass = Read-Host "Password" -AsSecureString

if (-not $UPPass) {
    Write-Host "No password entered. Exiting." -ForegroundColor Red
    exit 1
}

$UPCred = [System.Management.Automation.PSCredential]::new($UPUser, $UPPass)

# ==========================
# IMPORT MODULE(S)
# ==========================
try {
    Write-Host "`n[+] Importing psPAS module..." -ForegroundColor Yellow
    Import-Module psPAS -ErrorAction Stop
    Write-Host "[OK] psPAS module imported." -ForegroundColor Green
}
catch {
    Write-Host "[ERROR] Failed to import psPAS module: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}

# If Get-IdentityHeader is in a different module, import it here as well, e.g.:
# Import-Module IdentityCommand -ErrorAction Stop

# ==========================
# AUTHENTICATE VIA IDENTITY
# ==========================
try {
    Write-Host "`n[+] Requesting Identity header from $IdentityTenantURL for subdomain '$PCloudSubdomain'..." -ForegroundColor Yellow

    $header = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred

    if (-not $header) {
        Write-Host "[ERROR] Get-IdentityHeader returned no header. Cannot continue." -ForegroundColor Red
        exit 1
    }

    Write-Host "[OK] Identity header obtained." -ForegroundColor Green

    Write-Host "`n[+] Establishing psPAS session using Identity header..." -ForegroundColor Yellow
    Use-PASSession $header

    $session = Get-PASSession

    if ($session) {
        Write-Host "`n==============================================" -ForegroundColor Green
        Write-Host " ✅ Authentication SUCCESSFUL" -ForegroundColor Green
        Write-Host "==============================================" -ForegroundColor Green

        # Dump a few useful session details if available
        try {
            $session | Format-List * | Out-String | Write-Host
        } catch {
            Write-Host "Session object retrieved, but could not format details: $($_.Exception.Message)" -ForegroundColor Yellow
        }
    }
    else {
        Write-Host "`n==============================================" -ForegroundColor Red
        Write-Host " ❌ Authentication FAILED – no session object returned." -ForegroundColor Red
        Write-Host "==============================================" -ForegroundColor Red
        exit 1
    }
}
catch {
    Write-Host "`n==============================================" -ForegroundColor Red
    Write-Host " ❌ Authentication FAILED with exception" -ForegroundColor Red
    Write-Host "----------------------------------------------" -ForegroundColor Red
    Write-Host ("Type   : {0}" -f $_.Exception.GetType().FullName) -ForegroundColor Red
    Write-Host ("Message: {0}" -f $_.Exception.Message)          -ForegroundColor Red
    Write-Host "==============================================" -ForegroundColor Red
    exit 1
}

Write-Host "`n[Done] You can now safely plug this Identity auth pattern into your SailPoint connector script." -ForegroundColor Cyan
