Function ConvertTo-Boolean {
    
    param($Variable)
    If ($Variable -eq 'y') {
        $True
    }
    If ($Variable -eq 'n') {
        $False
    }
}
 Function Custom {
 
#Test default value
#if (!($value = Read-Host "Value [$default]")) { $value = $default }

$UseAccounts = Read-Host -Prompt "Use Accounts? (y or n)"
$RetrieveAccounts = Read-Host -Prompt "Retrieve Accounts? (y or n)"
$ListAccounts = Read-Host -Prompt "List Accounts? (y or n)"
$AddAccounts = Read-Host -Prompt "Add Accounts? (y or n)"
$UpdateAccountContent = Read-Host -Prompt "Update Account Content? (y or n)"
$UpdateAccountProperties = Read-Host -Prompt "Update Account Properties? (y or n)"
$InitiateCPMAccountManagementOperations = Read-Host -Prompt "Initiate CPM Account Management Operations? (y or n)"
$SpecifyNextAccountContent = Read-Host -Prompt "Specify Next Account Content? (y or n)"
$RenameAccounts = Read-Host -Prompt "Rename Accounts? (y or n)"
$DeleteAccounts = Read-Host -Prompt "Delete Accounts? (y or n)"
$UnlockAccounts = Read-Host -Prompt "Unlock Accounts? (y or n)"
$ManageSafe = Read-Host -Prompt "Manage Safe? (y or n)"
$ManageSafeMembers = Read-Host -Prompt "Manage Safe Members? (y or n)"
$BackupSafe = Read-Host -Prompt "Backup Safe? (y or n)"
$ViewAuditLog = Read-Host -Prompt "View Audit Log? (y or n)"
$ViewSafeMembers = Read-Host -Prompt "View Safe Members? (y or n)"
$RequestsAuthorizationLevel1 = Read-Host -Prompt "Requests Authorization Level1? (y or n)"
$RequestsAuthorizationLevel2 = Read-Host -Prompt "Requests Authorization Level2? (y or n)"
$AccessWithoutConfirmation = Read-Host -Prompt "Access Without Confirmation? (y or n)"
$CreateFolders = Read-Host -Prompt "Create Folders? (y or n)"
$DeleteFolders = Read-Host -Prompt "Delete Folders? (y or n)"
$MoveAccountsAndFolders = Read-Host -Prompt "Move Accounts And Folders? (y or n)"


$UseAccounts = ConvertTo-Boolean -Variable $UseAccounts
$RetrieveAccounts = ConvertTo-Boolean -Variable $RetrieveAccounts
$ListAccounts = ConvertTo-Boolean -Variable $ListAccounts
$AddAccounts = ConvertTo-Boolean -Variable $AddAccounts
$UpdateAccountContent = ConvertTo-Boolean -Variable $UpdateAccountContent
$UpdateAccountProperties = ConvertTo-Boolean -Variable $UpdateAccountProperties
$InitiateCPMAccountManagementOperations = ConvertTo-Boolean -Variable $InitiateCPMAccountManagementOperations
$SpecifyNextAccountContent = ConvertTo-Boolean -Variable $SpecifyNextAccountContent
$RenameAccounts = ConvertTo-Boolean -Variable $RenameAccounts
$DeleteAccounts = ConvertTo-Boolean -Variable $DeleteAccounts
$UnlockAccounts = ConvertTo-Boolean -Variable $UnlockAccounts
$ManageSafe = ConvertTo-Boolean -Variable $ManageSafe
$ManageSafeMembers = ConvertTo-Boolean -Variable $ManageSafeMembers
$BackupSafe = ConvertTo-Boolean -Variable $BackupSafe
$ViewAuditLog = ConvertTo-Boolean -Variable $ViewAuditLog
$ViewSafeMembers = ConvertTo-Boolean -Variable $ViewSafeMembers
$RequestsAuthorizationLevel1 = ConvertTo-Boolean -Variable $RequestsAuthorizationLevel1
$RequestsAuthorizationLevel2 = ConvertTo-Boolean -Variable $RequestsAuthorizationLevel2
$AccessWithoutConfirmation = ConvertTo-Boolean -Variable $AccessWithoutConfirmation
$CreateFolders = ConvertTo-Boolean -Variable $CreateFolders
$DeleteFolders = ConvertTo-Boolean -Variable $DeleteFolders
$MoveAccountsAndFolders = ConvertTo-Boolean -Variable $MoveAccountsAndFolders


 
 
 $RoleVaultUser = [PSCustomObject]@{
                        UseAccounts                            = $UseAccounts
                        RetrieveAccounts                       = $RetrieveAccounts
                        ListAccounts                           = $ListAccounts
                        AddAccounts                            = $AddAccounts
                        UpdateAccountContent                   = $UpdateAccountContent
                        UpdateAccountProperties                = $UpdateAccountProperties
                        InitiateCPMAccountManagementOperations = $InitiateCPMAccountManagementOperations
                        SpecifyNextAccountContent              = $SpecifyNextAccountContent
                        RenameAccounts                         = $RenameAccounts
                        DeleteAccounts                         = $DeleteAccounts
                        UnlockAccounts                         = $UnlockAccounts
                        ManageSafe                             = $ManageSafe
                        ManageSafeMembers                      = $ManageSafeMembers
                        BackupSafe                             = $BackupSafe
                        ViewAuditLog                           = $ViewAuditLog
                        ViewSafeMembers                        = $ViewSafeMembers
                        RequestsAuthorizationLevel1            = $RequestsAuthorizationLevel1
                        RequestsAuthorizationLevel2            = $RequestsAuthorizationLevel2
                        AccessWithoutConfirmation              = $AccessWithoutConfirmation
                        CreateFolders                          = $CreateFolders
                        DeleteFolders                          = $DeleteFolders
                        MoveAccountsAndFolders                 = $MoveAccountsAndFolders
                        }
                    
                    
                    AddSafeMember  
}



     
Show-RoleMenu
     $input = Read-Host "Please make a selection"
     switch ($input)
     {
        '0' {cls; Admin}
        '1' {cls; Privileged-Owner}
        '2' {cls; Privileged-Shared-AccessNoConfirm}
        '3' {cls; Privileged-Shared-AccessConfirm}
        '4' {cls; Service-Owner}
        '5' {cls; Service-User}
        '6' {cls; Application-Owner}
        '7' {cls; ApproverLevel1 }
        '8' {cls; ApproverLevel2 }
        '9' {cls; Custom}
        #Add New Selection Here
        'q' {return}      
     }


pause

}

        }

    until ($n -eq 'q')

    }
        
        
    Else {
    Write-Host -BackgroundColor Black -ForegroundColor Red "$($Safe) safe does not exist in PAPM."
    Return
    }

    }
}

Else {Write-Host -ForegroundColor Red -BackgroundColor Black "Could not establish session: [Error]: $($Error.exception.message)"}
