<#
.SYNOPSIS
    CNA CyberArk Safe Member + Account Compliance Report - Stable Version

.DESCRIPTION
    - Authenticates to CNA Privilege Cloud using CCP + psPAS Identity Header
    - Pulls all visible accounts once
    - Groups accounts by Safe without using Generic List cache objects
    - Retrieves Safe members per Safe
    - Joins Safe members to accounts
    - Pulls platform password-change policy from Get-PASPlatform
    - Calculates Expiration Due Days from:
        1. Account explicit expiration property, if present
        2. Account secretManagement.lastModifiedTime + platform requirePasswordChangeEveryXDays
        3. Account secretManagement.lastModifiedTime + DefaultExpirationDays fallback

.OUTPUT COLUMNS
    Safe
    Member
    MemberType
    Target Username
    Address
    Account Safe
    Platform Identity
    Compliance Status
    Expiration Due (Days)
    Last Modified Date

.NOTES
    This script is report-only.
    It does not add, update, delete, reconcile, verify, or rotate accounts.
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings CNA =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Processing controls =====
    [string]$SafeNameFilter    = '',

    # Recommended default:
    # This report is account-driven, so only process safes that contain accounts.
    [bool]$IncludeSafesWithNoAccounts = $false,

    # If platform rotation days cannot be resolved, use this fallback.
    # Set to 0 if you prefer blank Expiration Due values when platform policy is unavailable.
    [int]$DefaultExpirationDays = 90,

    # If the platform has performPeriodicChange = false, leave expiration blank unless this is true.
    [bool]$CalculateWhenPeriodicChangeDisabled = $false,

    # Fetch detailed platform info for only the unique platforms found in account inventory.
    [bool]$FetchPlatformDetails = $true,

    # Optional debug dump of first account/member/platform objects to JSON.
    [bool]$DebugObjectDump = $false,

    # ===== Output paths =====
    [string]$OutputFolder = 'E:\Installation Media\Script\OnboardScript\data',
    [string]$CsvName      = 'SafeMember_Account_Compliance_Report.csv',
    [string]$LogFileName  = 'SafeMember_Account_Compliance_Report.log'
)

# ============================================
# Runtime Settings
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ============================================
# Paths
# ============================================

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
}

$CsvFilePath      = Join-Path $OutputFolder $CsvName
$LogFile          = Join-Path $OutputFolder $LogFileName
$DebugAccountPath = Join-Path $OutputFolder 'Debug_FirstAccount.json'
$DebugMemberPath  = Join-Path $OutputFolder 'Debug_FirstMember.json'
$DebugPlatformPath = Join-Path $OutputFolder 'Debug_FirstPlatform.json'

New-Item -ItemType File -Force -Path $LogFile | Out-Null

# ============================================
# Logger
# ============================================

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# ============================================
# Helper: Normalize Identity Tenant URL
# ============================================

function Get-NormalizedIdentityTenant {
    param(
        [Parameter(Mandatory)]
        [string]$TenantUrl
    )

    $normalized = $TenantUrl.Trim()

    if ($normalized -notmatch '^https?://') {
        $normalized = "https://$normalized"
    }

    return $normalized.TrimEnd('/')
}

# ============================================
# Helper: Convert anything to clean array
# ============================================

function ConvertTo-CleanArray {
    param(
        [AllowNull()]
        [object]$InputObject
    )

    if ($null -eq $InputObject) {
        return @()
    }

    if ($InputObject -is [System.Array]) {
        return @($InputObject)
    }

    if ($InputObject -is [System.Collections.IEnumerable] -and
        $InputObject -isnot [string] -and
        $InputObject -isnot [hashtable] -and
        $InputObject.GetType().FullName -notlike 'System.Management.Automation.PSCustomObject') {
        return @($InputObject)
    }

    return @($InputObject)
}

# ============================================
# Helper: Get object property safely
# ============================================

function Get-ObjectPropertyValue {
    param(
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propName in $PropertyNames) {
        if ($InputObject -is [hashtable] -and $InputObject.ContainsKey($propName)) {
            return $InputObject[$propName]
        }

        $match = $InputObject.PSObject.Properties |
            Where-Object { $_.Name -ieq $propName } |
            Select-Object -First 1

        if ($null -ne $match) {
            return $match.Value
        }
    }

    return $null
}

# ============================================
# Helper: Get nested object property safely
# ============================================

function Get-NestedPropertyValue {
    param(
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$ParentPropertyNames,

        [Parameter(Mandatory)]
        [string[]]$ChildPropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($parentName in $ParentPropertyNames) {
        $parent = Get-ObjectPropertyValue -InputObject $InputObject -PropertyNames @($parentName)

        if ($null -ne $parent) {
            foreach ($childName in $ChildPropertyNames) {
                $childValue = Get-ObjectPropertyValue -InputObject $parent -PropertyNames @($childName)

                if ($null -ne $childValue) {
                    return $childValue
                }
            }
        }
    }

    return $null
}

# ============================================
# Helper: Deep property search
# Used mainly for platform objects that may differ by psPAS/API version.
# ============================================

function Find-PropertyDeep {
    param(
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames,

        [int]$MaxDepth = 6
    )

    if ($null -eq $InputObject -or $MaxDepth -le 0) {
        return $null
    }

    if ($InputObject -is [string] -or
        $InputObject -is [int] -or
        $InputObject -is [long] -or
        $InputObject -is [bool] -or
        $InputObject -is [datetime]) {
        return $null
    }

    foreach ($propName in $PropertyNames) {
        $value = Get-ObjectPropertyValue -InputObject $InputObject -PropertyNames @($propName)

        if ($null -ne $value) {
            return $value
        }
    }

    foreach ($prop in $InputObject.PSObject.Properties) {
        $child = $prop.Value

        if ($null -eq $child) {
            continue
        }

        if ($child -is [string] -or
            $child -is [int] -or
            $child -is [long] -or
            $child -is [bool] -or
            $child -is [datetime]) {
            continue
        }

        if ($child -is [System.Collections.IEnumerable] -and $child -isnot [string]) {
            foreach ($item in $child) {
                $found = Find-PropertyDeep -InputObject $item -PropertyNames $PropertyNames -MaxDepth ($MaxDepth - 1)

                if ($null -ne $found) {
                    return $found
                }
            }
        } else {
            $found = Find-PropertyDeep -InputObject $child -PropertyNames $PropertyNames -MaxDepth ($MaxDepth - 1)

            if ($null -ne $found) {
                return $found
            }
        }
    }

    return $null
}

# ============================================
# Helper: Convert CyberArk date safely
# Supports:
#   - ISO strings
#   - DateTime values
#   - Unix epoch seconds
#   - Unix epoch milliseconds
#   - Blank/null values
# ============================================

function Convert-CyberArkDate {
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($null -eq $Value) {
        return $null
    }

    if ($Value -is [datetime]) {
        return $Value.ToLocalTime()
    }

    $stringValue = ([string]$Value).Trim()

    if ([string]::IsNullOrWhiteSpace($stringValue)) {
        return $null
    }

    if ($stringValue -match '^\d+$') {
        try {
            $number = [int64]$stringValue

            if ($number -le 0) {
                return $null
            }

            if ($number -gt 9999999999) {
                return [DateTimeOffset]::FromUnixTimeMilliseconds($number).LocalDateTime
            }

            return [DateTimeOffset]::FromUnixTimeSeconds($number).LocalDateTime
        } catch {
            return $null
        }
    }

    try {
        return ([datetime]::Parse($stringValue)).ToLocalTime()
    } catch {
        return $null
    }
}

# ============================================
# Helper: Resolve account safe name
# ============================================

function Get-AccountSafeName {
    param(
        [AllowNull()]
        [object]$Account
    )

    $safe = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
        'safeName',
        'SafeName',
        'Safe',
        'safe'
    )

    if ($null -eq $safe) {
        return ''
    }

    return ([string]$safe).Trim()
}

