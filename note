Function CreateMissingSafeNoVaultUser {

    
    $Safe = $SafeName


    If ($Safe -eq $null) {
        Write-Host -ForegroundColor Yellow -BackgroundColor Black "Safe name cannot be left blank."
        Return
    }

    Else {

        #Default variables
        $CPM = "CPM-1"
        $RetentionVersions = "7"
        
        $RoleVaultOwner = [PSCustomObject]@{
                UseAccounts                            = $true
                RetrieveAccounts                       = $true
                ListAccounts                           = $true
                UpdateAccountContent                   = $false
                InitiateCPMAccountManagementOperations = $true
                ViewAuditLog                           = $true
                ViewSafeMembers                        = $true
                AccessWithoutConfirmation              = $true
                UnlockAccounts                         = $false

            }

        $RoleVaultAdmin = [PSCustomObject]@{
                UseAccounts                            = $false
                RetrieveAccounts                       = $false
                ListAccounts                           = $true
                AddAccounts                            = $true
                UpdateAccountContent                   = $true
                UpdateAccountProperties                = $true
                InitiateCPMAccountManagementOperations = $true
                SpecifyNextAccountContent              = $true
                RenameAccounts                         = $true
                DeleteAccounts                         = $true
                UnlockAccounts                         = $true
                ManageSafe                             = $true
                ManageSafeMembers                      = $true
                BackupSafe                             = $true
                ViewAuditLog                           = $true
                ViewSafeMembers                        = $true
                RequestsAuthorizationLevel1            = $true
                RequestsAuthorizationLevel2            = $false
                AccessWithoutConfirmation              = $true
                CreateFolders                          = $true
                DeleteFolders                          = $true
                MoveAccountsAndFolders                 = $true
            }
        $RoleSafeManager = [PSCustomObject]@{
                UseAccounts                            = $true
                RetrieveAccounts                       = $true
                ListAccounts                           = $true
                AddAccounts                            = $true
                UpdateAccountContent                   = $true
                UpdateAccountProperties                = $true
                InitiateCPMAccountManagementOperations = $true
                SpecifyNextAccountContent              = $true
                RenameAccounts                         = $true
                DeleteAccounts                         = $true
                UnlockAccounts                         = $true
                ManageSafe                             = $true
                ManageSafeMembers                      = $true
                ViewAuditLog                           = $true
                ViewSafeMembers                        = $true
                RequestsAuthorizationLevel1            = $true
                RequestsAuthorizationLevel2            = $false
                AccessWithoutConfirmation              = $true
                CreateFolders                          = $true
                DeleteFolders                          = $true
                MoveAccountsAndFolders                 = $true
            }
        $RoleVaultAdminLocal = [PSCustomObject]@{
                UseAccounts                            = $true
                RetrieveAccounts                       = $true
                ListAccounts                           = $true
                AddAccounts                            = $true
                UpdateAccountContent                   = $true
                UpdateAccountProperties                = $true
                InitiateCPMAccountManagementOperations = $true
                SpecifyNextAccountContent              = $true
                RenameAccounts                         = $true
                DeleteAccounts                         = $true
                UnlockAccounts                         = $true
                ManageSafe                             = $true
                ManageSafeMembers                      = $true
                BackupSafe                             = $true
                ViewAuditLog                           = $true
                ViewSafeMembers                        = $true
                RequestsAuthorizationLevel1            = $true
                RequestsAuthorizationLevel2            = $false
                AccessWithoutConfirmation              = $true
                CreateFolders                          = $true
                DeleteFolders                          = $true
                MoveAccountsAndFolders                 = $true
            }

        #Add Safe
        
        $Error.clear()
        $result = $null
        $result = Get-PASSafe -SafeName $Safe -ErrorAction SilentlyContinue


        #Check if Safe Exists
        If ($result.SafeName -eq $Safe) {
            Write-Host -ForegroundColor Yellow -BackgroundColor Black "The provided safe name: '$($Safe)' already exists."
            Write-Host ""
            Write-Host "Checking Safe Members."
            
          
        #Check for existing members
        $CheckForExistingSafeMember = (Get-PASSafeMember -SafeName $SafeName -ErrorAction SilentlyContinue).Username

                #region PAPM Vault Admins Local

                ##Adding PAPM Vault Administrator Local
                If (!("magellanhealth_admin@cyberark.cloud.3761" -in $CheckForExistingSafeMember)) {

                    Try {
            
                        $Error.clear()
            
                        $RoleVaultAdminLocal | Add-PASSafeMember -SafeName $SafeName -memberType User -MemberName "magellanhealth_admin@cyberark.cloud.3761" -ErrorAction SilentlyContinue # -SearchIn "Vault" -ErrorAction SilentlyContinue
          
                        
                    }

                    Catch {
                        
                        
                        Write-Host "Trouble adding vault member: magellanhealth_admin@cyberark.cloud.3761 || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                }
                ##Setting PAPM Vault Administrator Local
                Else {
                
                    Write-Host "magellanhealth_admin@cyberark.cloud.3761 already exists, Setting permissions"
    
                    ##Updating PAPM Vault Administrator Local
                    Try {
            
                        $Error.clear()
            
                        $RoleVaultAdminLocal | Set-PASSafeMember -SafeName $SafeName -MemberName "magellanhealth_admin@cyberark.cloud.3761" -ErrorAction SilentlyContinue


                    }

                    Catch {

                        Write-Host "Trouble setting vault member: magellanhealth_admin@cyberark.cloud.3761 || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                    }
                
                #endregion PAPM Vault Admins Local
                
                #region PAPM Vault Admins
                ##Adding PAPM Vault Administrator
                If (!("PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -in $CheckForExistingSafeMember)) {

                    Try {
            
                        $Error.clear()
            
                        $RoleVaultAdmin | Add-PASSafeMember -SafeName $SafeName -memberType User -MemberName "PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue

                        

                    }

                    Catch {
                       
                        Write-Host  "Trouble adding vault member: PAPM-VaultAdmins@mbh.mhs.magellanhealth.com || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                    }

                ##Setting PAPM Vault Administrator
                Else {

                    Write-Host "PAPM-VaultAdmins@mbh.mhs.magellanhealth.com already exists, Setting permissions"

                    ##Updating PAPM Vault Administrator
                    Try {
            
                        $Error.clear()
            
                        $RoleVaultAdmin | Set-PASSafeMember -SafeName $SafeName -MemberName "PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue


                    }

                    Catch {

                        Write-Host "Trouble setting vault member: PAPM-VaultAdmins@mbh.mhs.magellanhealth.com || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                    }


                #endregion PAPM Vault Admins

                #region PAPM Safe Managers
                
                ##Adding PAPM Safe Managers

                $RoleName = "Privilege Cloud Safe Managers"

                If (!($RoleName -in $CheckForExistingSafeMember)) {

                    Try {
            
                        $Error.clear()
                        
                        $Result = $RoleSafeManager | Add-PASSafeMember -SafeName $Safe -memberType Role -MemberName $RoleName -ErrorAction SilentlyContinue # -SearchIn "Vault" -ErrorAction SilentlyContinue

 
                    }

                    Catch {

                        Write-Host "Trouble Adding vault member: $($RoleName) || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                    }
                
                ##Setting PAPM Safe Managers
                Else {
                       
                    Write-Host "$RoleName already exists, Setting permissions"


                    ##Updating PAPM Safe Managers
                    Try {
            
                        $Error.clear()
            
                        $RoleSafeManager | Set-PASSafeMember -SafeName $SafeName -MemberName "$RoleName" -ErrorAction SilentlyContinue


                    }

                    Catch {

                        Write-Host "Trouble setting vault member: $($RoleName) || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }
                    }

                #endregion PAPM Safe Managers
        
                #region PAPM Vault Owner

                #ESAG is the vault Owner for Service/Application Accounts
                
                ##Adding PAPM Vault Owner
                If (!("PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -in $CheckForExistingSafeMember)) {

                    Try {
            
                        $Error.clear()
            
                        $RoleVaultOwner | Add-PASSafeMember -SafeName $SafeName -memberType User -MemberName "PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue

 
                    }

                    Catch {

                        Write-Host "Trouble Adding vault member: PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }

                    }
                
                ##Setting PAPM Vault Owner
                Else {
                       
                    Write-Host "PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com already exists, Setting permissions"


                    ##Updating PAPM Vault Owner
                    Try {
            
                        $Error.clear()
            
                        $RoleVaultOwner | Set-PASSafeMember -SafeName $SafeName -MemberName "PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue


                    }

                    Catch {

                        Write-Host "Trouble setting vault member: PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

                        continue

                        }
                    }

                #endregion PAPM-VaultOwner  
                         
        #Verify all members added
        $AllMembers = @()
        $AllMembers = Get-PASSafeMember -SafeName $Safe
        $Members = $AllMembers.Username
        
            If (("PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -in $Members) -and ("PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -in $Members) -and ($RoleName -in $Members) -and ("magellanhealth_admin@cyberark.cloud.3761" -in $Members)){
            
                Write-Host -ForegroundColor Green "Successfully added or updated all DEFAULT members on the safe"
                Write-Host ""
            
            }

            Else {
                Write-Host -ForegroundColor Red -BackgroundColor Black "Failed to add or update all members on the safe"
                Write-Host ""
            }

        #Return
        
        
        }


        Else {
            $Error.clear()
            $result = $null
            $result = Add-PASSafe -SafeName $Safe -ManagingCPM $CPM -NumberOfVersionsRetention $RetentionVersions

            If (!($Error)){

                Write-Host -ForegroundColor Green "Successfully created safe"
                Write-Host -ForegroundColor Green "Adding safe members and permissions..."
        
                #Add Safe Members and permissions on a Safe

                $RoleName = "Privilege Cloud Safe Managers"

                $Result = $RoleVaultOwner | Add-PASSafeMember -SafeName $Safe -memberType User -MemberName "PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue
                
                $Result = $RoleVaultAdmin | Add-PASSafeMember -SafeName $Safe -memberType User -MemberName "PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue

                $Result = $RoleVaultAdminLocal | Add-PASSafeMember -SafeName $Safe -memberType User -MemberName "magellanhealth_admin@cyberark.cloud.3761" -ErrorAction SilentlyContinue # -SearchIn "Vault" -ErrorAction SilentlyContinue

                $Result = $RoleSafeManager | Add-PASSafeMember -SafeName $Safe -memberType Role -MemberName $RoleName -ErrorAction SilentlyContinue # -SearchIn "Vault" -ErrorAction SilentlyContinue
        
                #Verify all members added
                $AllMembers = @()
                $AllMembers = Get-PASSafeMember -SafeName $Safe
                $Members = $AllMembers.Username
            
                If (("PAPM-ENTERPRISE-SERVER-ADMINISTRATORS@mbh.mhs.magellanhealth.com" -in $Members) -and ("PAPM-VaultAdmins@mbh.mhs.magellanhealth.com" -in $Members) -and ($RoleName -in $Members) -and ("magellanhealth_admin@cyberark.cloud.3761" -in $Members)){
            
                    Write-Host -ForegroundColor Green "Successfully added all members to the safe"
                    Write-Host ""
            
                }

                Else {
                    Write-Host -ForegroundColor Red -BackgroundColor Black "Failed to add all members to the safe"
                    Write-Host ""
                }
            
            
            }

            Else {

                Write-Host -ForegroundColor Red "Error adding safe: $($Safe)"
                Write-Host -ForegroundColor Red "$($Error.exception)"
                Write-Host ""

            }

        }

    }

}
Function Onboard{


#Account type options

If ($Selection -eq "1"){
    
    $AccountType = "APP"   
    $Append = "M180"          
    $PlatformID = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)-$($Append)"
    $Script:SafeName = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)"
    $Script:PAPMSafeAccessGroup = "PAPM-MBH-$($AccountType)-$($Application)@mbh.mhs.magellanhealth.com"

    Write-Host ""
    Write-Host ""
    Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Validate the information below:      "
    Write-Host ""
    Write-Host "Platform ID:       $($PlatformID)    "
    Write-Host "SafeName:          $($SafeName)      "
    Write-Host "PAPM Safe Acccess: $($PAPMSafeAccessGroup)      "
    Write-Host ""
    Write-Host ""
    
    do {$ManualPrompt = Read-Host "Is the information above correct? (y or n)"}
    until(($ManualPrompt -eq 'y') -or ($ManualPrompt -eq 'n'))

    If ($ManualPrompt -eq "n"){

        $PlatformID = $null
        $Script:SafeName = $null
        $Script:PAPMSafeAccessGroup = $null

        Write-Host ""
        Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Please specify the following values:      "
        Write-Host ""
        $PlatformID = Read-Host "Platform ID (must include -M365 | -M180 | -180 | -365)"
        $Script:SafeName = Read-Host "SafeName"
        $Script:PAPMSafeAccessGroup = Read-Host "PAPM Safe Access Group (Must include @mbh.mhs.magellanhealth.com)"
    }
    else {

        $PlatformID = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)-$($Append)"
        $Script:SafeName = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)"
        $Script:PAPMSafeAccessGroup = "PAPM-MBH-$($AccountType)-$($Application)@mbh.mhs.magellanhealth.com"
    }

    
    $RandomPassword = New-Object -TypeName PSObject
    $RandomPassword | Add-Member -MemberType ScriptProperty -Name "Password" -Value { ("!<>[]@#$%^&*0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz".tochararray() | sort {Get-Random})[0..20] -join '' }
    $Password = "$($RandomPassword.Password)"
        
    $PlatformAccountProperties = @{ LogonDomain = $($Address).split(".")[0]}

    $Secure_String_Pwd = $null
    $Secure_String_Pwd = ConvertTo-SecureString $Password -AsPlainText -Force

                
    $Error.clear()
    $PreCheck = $null
    $PreCheck= Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

    if (!($PreCheck)) {Write-Host -BackgroundColor Black -ForegroundColor Yellow "$($SafeName) safe does not exist. Creating missing safe..." 
            
        CreateMissingSafeNoVaultUser
            
        $PreCheck = $null
        $PreCheck = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

        }


    if ($PreCheck) {
                    
        #Runs Function to check safe members
        CreateMissingSafeNoVaultUser

        $PreCheck = $null
        $PreCheck = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

    }
                        
    $Error.clear()
    $Check = $null
    $Check = Get-PASAccount -safeName $SafeName | Where-Object {(($_.address -eq $Address) -and ($_.userName -eq $UserName))} -ErrorAction SilentlyContinue
        
    If ($PreCheck -and $Check) {Write-Host -BackgroundColor Black -ForegroundColor Yellow "$($UserName)-$($Address) already exists. Skipping..." }

    If (!($Check)) {
        
        $Error.clear()
        $Result_AddPASAccount = $null
        $Result_AddPASAccount = Add-PASAccount -address $Address -Username $UserName -secretType "Password" -secret $Secure_String_Pwd -platformID $PlatformID -SafeName $SafeName -automaticManagementEnabled $true -platformAccountProperties $PlatformAccountProperties -ErrorAction SilentlyContinue
    
        If (!($Error)) {

            Write-Host -ForegroundColor Green "$($UserName)-$($Address) was added successfully" 

                    
            #Recon Account

            Try {
                
            $Error.clear()
            $GetFilter = $null
            $FilterAddress = $null

            $GetFilter = Get-PASAccount -safeName $SafeName
            $FilterAddress = $GetFilter | Where-Object {$_.address -eq $Address}     
            $FilterID = $FilterAddress | Where-Object {$_.username -eq $UserName}

    
            Invoke-PASCPMOperation -AccountID $FilterID.id -ReconcileTask -ErrorAction SilentlyContinue


            }      
    

            Catch {
                    
            Write-Host -ForegroundColor Red -BackgroundColor Black "Error: $($Error.exception.message)"

            continue

            }
                    
        }

        Else {
            
        Write-Host -BackgroundColor Black -ForegroundColor Red "Failed to add $($UserName)-$($Address)"
        Write-Host -ForegroundColor Red -BackgroundColor Black "Error: $($Error.exception.message)"
        }
            
    }

}

If ($Selection -eq "2"){
    
    $AccountType = "APP"   
    $Append = "M365"          
    $PlatformID = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)-$($Append)"
    $Script:SafeName = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)"
    $Script:PAPMSafeAccessGroup = "PAPM-MBH-$($AccountType)-$($Application)@mbh.mhs.magellanhealth.com"

    Write-Host ""
    Write-Host ""
    Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Validate the information below:      "
    Write-Host ""
    Write-Host "Platform ID:       $($PlatformID)    "
    Write-Host "SafeName:          $($SafeName)      "
    Write-Host "PAPM Safe Acccess: $($PAPMSafeAccessGroup)      "
    Write-Host ""
    Write-Host ""
    
    do {$ManualPrompt = Read-Host "Is the information above correct? (y or n)"}
    until(($ManualPrompt -eq 'y') -or ($ManualPrompt -eq 'n'))

    If ($ManualPrompt -eq "n"){

        $PlatformID = $null
        $Script:SafeName = $null
        $Script:PAPMSafeAccessGroup = $null

        Write-Host ""
        Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Please specify the following values:      "
        Write-Host ""
        $PlatformID = Read-Host "Platform ID (must include -M365 | -M180 | -180 | -365)"
        $Script:SafeName = Read-Host "SafeName"
        $Script:PAPMSafeAccessGroup = Read-Host "PAPM Safe Access Group (Must include @mbh.mhs.magellanhealth.com)"
    }
    else {

        $PlatformID = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)-$($Append)"
        $Script:SafeName = "$($Address.split(".")[0].ToUpper())-$($AccountType)-$($Application)"
        $Script:PAPMSafeAccessGroup = "PAPM-MBH-$($AccountType)-$($Application)@mbh.mhs.magellanhealth.com"
    }

    
    $RandomPassword = New-Object -TypeName PSObject
    $RandomPassword | Add-Member -MemberType ScriptProperty -Name "Password" -Value { ("!<>[]@#$%^&*0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz".tochararray() | sort {Get-Random})[0..20] -join '' }
    $Password = "$($RandomPassword.Password)"
        
    $PlatformAccountProperties = @{ LogonDomain = $($Address).split(".")[0]}

    $Secure_String_Pwd = $null
    $Secure_String_Pwd = ConvertTo-SecureString $Password -AsPlainText -Force

                
    $Error.clear()
    $PreCheck = $null
    $PreCheck= Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

    if (!($PreCheck)) {Write-Host -BackgroundColor Black -ForegroundColor Yellow "$($SafeName) safe does not exist. Creating missing safe..." 
            
        CreateMissingSafeNoVaultUser
            
        $PreCheck = $null
        $PreCheck = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

        }


    if ($PreCheck) {
                    
        #Runs Function to check safe members
        CreateMissingSafeNoVaultUser

        $PreCheck = $null
        $PreCheck = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue

    }
                        
    $Error.clear()
    $Check = $null
    $Check = Get-PASAccount -safeName $SafeName | Where-Object {(($_.address -eq $Address) -and ($_.userName -eq $UserName))} -ErrorAction SilentlyContinue
        
    If ($PreCheck -and $Check) {Write-Host -BackgroundColor Black -ForegroundColor Yellow "$($UserName)-$($Address) already exists. Skipping..." }

    If (!($Check)) {
        
        $Error.clear()
        $Result_AddPASAccount = $null
        $Result_AddPASAccount = Add-PASAccount -address $Address -Username $UserName -secretType "Password" -secret $Secure_String_Pwd -platformID $PlatformID -SafeName $SafeName -automaticManagementEnabled $true -platformAccountProperties $PlatformAccountProperties -ErrorAction SilentlyContinue
    
        If (!($Error)) {

            Write-Host -ForegroundColor Green "$($UserName)-$($Address) was added successfully" 

                    
            #Recon Account

            Try {
                
            $Error.clear()
            $GetFilter = $null
            $FilterAddress = $null

            $GetFilter = Get-PASAccount -SafeName $SafeName
            $FilterAddress = $GetFilter | Where-Object {$_.address -eq $Address}     
            $FilterID = $FilterAddress | Where-Object {$_.username -eq $UserName}

    
            Invoke-PASCPMOperation -AccountID $FilterID.id -ReconcileTask -ErrorAction SilentlyContinue


            }      
    

            Catch {
                    
            Write-Host -ForegroundColor Red -BackgroundColor Black "Error: $($Error.exception.message)"

            continue

            }
                    
        }

        Else {
            
        Write-Host -BackgroundColor Black -ForegroundColor Red "Failed to add $($UserName)-$($Address)"
        Write-Host -ForegroundColor Red -BackgroundColor Black "Error: $($Error.exception.message)"
        }
            
    }

}

If ($Selection -eq "3"){
    
    $AccountType = "APP"   
