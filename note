<#
Updates only the action of the existing scheduled task:

    \PAM\Move Disabled Accounts Daily

The existing task principal/run-as account, trigger, and security settings
are not changed.
#>

[CmdletBinding()]
param(
    [string]$TaskPath = "\PAM\",

    [string]$TaskName = "Move Disabled Accounts Daily",

    [string]$ScriptPath = "I:\Script\IDENTITY Script New\Onbarding Project\Move-DisabledAccount.ps1",

    [string]$PsPASModulePath = ""
)

$ErrorActionPreference = "Stop"

try {
    if (-not (Test-Path -LiteralPath $ScriptPath -PathType Leaf)) {
        throw "Migration script was not found: $ScriptPath"
    }

    if ([string]::IsNullOrWhiteSpace($PsPASModulePath)) {
        $PsPASModulePath = Get-ChildItem `
            -Path (Join-Path (Split-Path $ScriptPath -Parent) "Modules\psPAS\*\psPAS.psd1") `
            -File `
            -ErrorAction SilentlyContinue |
            ForEach-Object {
                try {
                    $manifest = Test-ModuleManifest `
                        -Path $_.FullName `
                        -ErrorAction Stop

                    [pscustomobject]@{
                        Path    = $_.FullName
                        Version = $manifest.Version
                    }
                }
                catch {
                }
            } |
            Sort-Object Version -Descending |
            Select-Object -First 1 -ExpandProperty Path
    }

    if (
        [string]::IsNullOrWhiteSpace($PsPASModulePath) -or
        -not (Test-Path -LiteralPath $PsPASModulePath -PathType Leaf)
    ) {
        throw "A staged psPAS manifest was not found. Run Stage-CompatiblePsPASForScheduledTask.ps1 first."
    }

    $existingTask = Get-ScheduledTask `
        -TaskPath $TaskPath `
        -TaskName $TaskName `
        -ErrorAction Stop

    $powerShellExe = Join-Path `
        $env:SystemRoot `
        "System32\WindowsPowerShell\v1.0\powershell.exe"

    $workingDirectory = Split-Path $ScriptPath -Parent

    $arguments = (
        '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass ' +
        '-File "{0}" -ScheduledTaskMode -PsPASModulePath "{1}"' -f
        $ScriptPath,
        $PsPASModulePath
    )

    $action = New-ScheduledTaskAction `
        -Execute $powerShellExe `
        -Argument $arguments `
        -WorkingDirectory $workingDirectory

    Set-ScheduledTask `
        -TaskPath $TaskPath `
        -TaskName $TaskName `
        -Action $action `
        -ErrorAction Stop | Out-Null

    Write-Host ""
    Write-Host "Scheduled-task action updated successfully." -ForegroundColor Green
    Write-Host "Task       : $TaskPath$TaskName"
    Write-Host "Script     : $ScriptPath"
    Write-Host "psPAS      : $PsPASModulePath"
    Write-Host "Principal  : $($existingTask.Principal.UserId) (unchanged)"
    Write-Host ""
    Write-Host "The task now passes -ScheduledTaskMode and imports the staged psPAS module."
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
