<#
IND_SafeCreation_Identity.ps1

- Logs in using CCP → Identity Shared Services → ServiceUser (same as APP script).
- Mode:
    - CSV   : reads owners from CSV (Samaccountname, employeeID, email).
    - Single: prompts for one owner and creates a single IND_ safe.
- Creates/ensures IND_<Samaccountname>_<employeeID> safes with 7-day retention.
- Adds:
    - IAM_ACU_CA_Admins with full classic permissions.
    - Owner (email) with limited "CARK-style" permissions (no RA1/RA2).
- Description:
    "Individual safe for <sam> (<employeeID>) – Managed By <OwnerNameNoDomain>".
- After Safe creation, onboards an Admin account:
    - UserName = A_<Samaccountname>
    - Address  = user-selected domain (alliantcreditunion.com | gdeacu.com | extacu.local)
    - Platform & LogonDomain/LogonAccount determined by owner email domain:
        * @alliantcreditunion.com → WIN_P_DM_ACU_ADM_OTP_CICO_30D / LogonDomain=ACU
        * @extacu.local           → WIN_P_DM_GDE_ADM_OTP_CICO_30D / LogonDomain=extacu.local
        * @gdeacu.com             → WIN_P_DM_GDE_ADM_OTP_CICO_30D / LogonDomain=gdeacu.com
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # --- Mode: CSV or Single row ---
    [ValidateSet('CSV','Single')]
    [string]$Mode       = 'CSV',

    [string]$CsvPath    = "I:\Script\IDENTITY Script New\csv\owners.csv",

    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CPM / Safe settings =====
    [string]$ManagingCPM        = "HQVECYBARK101",
    [string]$Location           = "\",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",  # CCP base URL (no trailing slash)
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false
)

# --- Modules & TLS ---
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Continue'

# --- Pretty log helpers ---
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

# --- GUI input helper (for Single mode & address prompt) ---
Add-Type -AssemblyName System.Windows.Forms | Out-Null
Add-Type -AssemblyName System.Drawing       | Out-Null

function Show-InputDialog {
    param(
        [Parameter(Mandatory)][string]$Title,
        [Parameter(Mandatory)][string]$Prompt,
        [Parameter()][string]$Default = '',
        [Parameter()][scriptblock]$ValidateScript = {$true},
        [Parameter()][string]$ValidationHint = ''
    )
    try {
        $form                 = New-Object System.Windows.Forms.Form
        $form.Text            = $Title
        $form.StartPosition   = 'CenterScreen'
        $form.TopMost         = $true
        $form.Size            = New-Object System.Drawing.Size(480,190)
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox     = $false

        $lbl                  = New-Object System.Windows.Forms.Label
        $lbl.Text             = $Prompt
        $lbl.AutoSize         = $true
        $lbl.Location         = '12,15'
        $lbl.Font             = New-Object System.Drawing.Font('Segoe UI',10)
        $form.Controls.Add($lbl)

        $tb                   = New-Object System.Windows.Forms.TextBox
        $tb.Location          = '16,48'
        $tb.Width             = 430
        $tb.Text              = $Default
        $tb.Font              = New-Object System.Drawing.Font('Consolas',11)
        $form.Controls.Add($tb)

        $hint                 = New-Object System.Windows.Forms.Label
        $hint.AutoSize        = $true
        $hint.ForeColor       = [System.Drawing.Color]::DarkGray
        $hint.Text            = $ValidationHint
        $hint.Location        = '16,80'
        $form.Controls.Add($hint)

        $ok                   = New-Object System.Windows.Forms.Button
        $ok.Text              = 'Continue'
        $ok.Location          = '272,110'
        $ok.Width             = 80
        $ok.DialogResult      = [System.Windows.Forms.DialogResult]::OK
        $form.AcceptButton    = $ok
        $form.Controls.Add($ok)

        $cancel               = New-Object System.Windows.Forms.Button
        $cancel.Text          = 'Cancel'
        $cancel.Location      = '366,110'
        $cancel.Width         = 80
        $cancel.DialogResult  = [System.Windows.Forms.DialogResult]::Cancel
        $form.CancelButton    = $cancel
        $form.Controls.Add($cancel)

        $tb.add_TextChanged({
            try {
                if (& $ValidateScript $tb.Text) { $tb.BackColor = [System.Drawing.Color]::White }
                else                            { $tb.BackColor = [System.Drawing.Color]::MistyRose }
            } catch {
                $tb.BackColor = [System.Drawing.Color]::MistyRose
            }
        })

        $dialog = $form.ShowDialog()
        if ($dialog -ne [System.Windows.Forms.DialogResult]::OK) { return $null }

        $val = $tb.Text.Trim()
        if (-not (& $ValidateScript $val)) {
            [System.Windows.Forms.MessageBox]::Show(
                "Value is invalid. Please try again.",
                "Validation",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null
            return Show-InputDialog @PSBoundParameters
        }
        return $val
    } catch {
        $val = Read-Host "$Title - $Prompt"
        if (-not (& $ValidateScript $val)) { throw "Input failed validation." }
        return $val
    }
}

# Prompt once per run for Admin Address domain
function Get-AdminAddressDomain {
    $valid = @('alliantcreditunion.com','gdeacu.com','extacu.local')
    $msg   = "Enter Address domain for Admin account (" + ($valid -join ' | ') + ")"
    $domain = Show-InputDialog -Title "Admin Account Address Domain" `
        -Prompt $msg `
        -Default "alliantcreditunion.com" `
        -ValidationHint "Must be one of: alliantcreditunion.com, gdeacu.com, extacu.local" `
        -ValidateScript {
            param($x)
            $t = $x.Trim().ToLower()
            return ($t -in @('alliantcreditunion.com','gdeacu.com','extacu.local'))
        }

    if (-not $domain) {
        throw "Admin Address domain selection cancelled."
    }
    return $domain.Trim().ToLower()
}

# --- Permissions helpers ---

# IAM_ACU_CA_Admins → full classic permissions (no RA1/RA2)
function Get-AdminPerms {
    @{
        UseAccounts                             = $true
        RetrieveAccounts                        = $true
        ListAccounts                            = $true
        AddAccounts                             = $true
        UpdateAccountContent                    = $true
        UpdateAccountProperties                 = $true
        InitiateCPMAccountManagementOperations  = $true
        SpecifyNextAccountContent               = $true
        RenameAccounts                          = $true
        DeleteAccounts                          = $true
        UnlockAccounts                          = $true
        ManageSafe                              = $true
        ManageSafeMembers                       = $true
        BackupSafe                              = $true
        ViewAuditLog                            = $true
        ViewSafeMembers                         = $true
        AccessWithoutConfirmation               = $true
        CreateFolders                           = $true
        DeleteFolders                           = $true
        MoveAccountsAndFolders                  = $true
    }
}

# Owner (email) → limited CARK-style permissions (no RA1/RA2)
function Get-OwnerPerms {
    @{
        UseAccounts                             = $true
        RetrieveAccounts                        = $true
        ListAccounts                            = $true
        AddAccounts                             = $false
        UpdateAccountContent                    = $true
        UpdateAccountProperties                 = $false
        InitiateCPMAccountManagementOperations  = $true
        SpecifyNextAccountContent               = $true
        RenameAccounts                          = $false
        DeleteAccounts                          = $false
        UnlockAccounts                          = $false
        ManageSafe                              = $false
        ManageSafeMembers                       = $false
        BackupSafe                              = $false
        ViewAuditLog                            = $true
        ViewSafeMembers                         = $true
        AccessWithoutConfirmation               = $true
        CreateFolders                           = $false
        DeleteFolders                           = $false
        MoveAccountsAndFolders                  = $false
    }
}

# --- CCP → PSCredential (API Service User) ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }

    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content. Raw: $($resp | ConvertTo-Json -Depth 5)"
    }

    Write-Ok ("CCP returned service user: {0}" -f $resp.UserName)

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- Safe member ensure helper (psPAS) ---
function Ensure-SafeMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,   # sAM or UPN
        [Parameter(Mandatory)][ValidateSet('User','Group','Role')][string]$MemberType,
        [Parameter(Mandatory)][hashtable]$PermFlags
    )

    Write-Info ("Processing member '{0}' on '{1}' (Type={2})..." -f $MemberName, $SafeName, $MemberType)

    # 1) Check if member exists
    $existing = $null
    try {
        $existing = Get-PASSafeMember -SafeName $SafeName -Search $MemberName -ErrorAction SilentlyContinue |
                    Where-Object { $_.MemberName -eq $MemberName }
    } catch {
        # treat as not found
    }

    # Build perm splat (psPAS permission switches)
    $permParams = @{}
    foreach ($k in $PermFlags.Keys) {
        $permParams[$k] = $PermFlags[$k]
    }

    $splat = @{
        SafeName   = $SafeName
        MemberName = $MemberName
        MemberType = $MemberType
    }
    $splat += $permParams

    if ($existing) {
        Write-Info "Member exists; updating permissions via Set-PASSafeMember..."
        Set-PASSafeMember @splat -ErrorAction Stop | Out-Null
        Write-Ok  ("Updated '{0}' on '{1}'." -f $MemberName, $SafeName)
    }
    else {
        Write-Info "Member not found; adding via Add-PASSafeMember..."
        Add-PASSafeMember @splat -ErrorAction Stop | Out-Null
        Write-Ok  ("Added '{0}' to '{1}'." -f $MemberName, $SafeName)
    }
}

# --- Admin account onboarding helper ---
function Onboard-AdminAccount {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][string]$OwnerEmail,
        [Parameter(Mandatory)][string]$AdminAddressDomain
    )

    $sam   = $SamAccountName.Trim()
    $email = $OwnerEmail.Trim()
    $addr  = $AdminAddressDomain.Trim()

    if (-not $sam -or -not $email -or -not $addr) {
        Write-Warn "Admin onboarding skipped: missing Sam, email, or address domain."
        return
    }

    # Determine PlatformID and LogonDomain based on email domain
    $platformId  = $null
    $logonDomain = $null

    $emailLower = $email.ToLower()

    if ($emailLower.EndsWith("@alliantcreditunion.com")) {
        $platformId  = "WIN_P_DM_ACU_ADM_OTP_CICO_30D"
        $logonDomain = "ACU"
    }
    elseif ($emailLower.EndsWith("@extacu.local")) {
        $platformId  = "WIN_P_DM_GDE_ADM_OTP_CICO_30D"
        $logonDomain = "extacu.local"
    }
    elseif ($emailLower.EndsWith("@gdeacu.com")) {
        $platformId  = "WIN_P_DM_GDE_ADM_OTP_CICO_30D"
        $logonDomain = "gdeacu.com"
    }
    else {
        Write-Warn ("Owner email '{0}' does not match any known domain mapping; admin account not onboarded." -f $email)
        return
    }

    $adminUser = "A_{0}" -f $sam

    Write-Info ("Preparing to onboard Admin account '{0}' to Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})..." -f $adminUser, $SafeName, $platformId, $addr, $logonDomain)

    # Check if account already exists in this Safe
    $existingAcct = $null
    try {
        $existingAcct = Get-PASAccount -SafeName $SafeName -Search $adminUser -ErrorAction SilentlyContinue |
                        Where-Object { $_.UserName -eq $adminUser -and $_.Address -eq $addr }
    } catch {}

    if ($existingAcct) {
        Write-Warn ("Admin account '{0}' already exists in Safe '{1}' with Address '{2}' – skipping onboard." -f $adminUser, $SafeName, $addr)
        return
    }

    # Platform account properties – LogonDomain + LogonAccount for safety
    $platformProps = @{
        LogonDomain  = $logonDomain
        LogonAccount = $logonDomain
    }

    $acctSplat = @{
        SafeName                  = $SafeName
        PlatformID                = $platformId
        Address                   = $addr
        UserName                  = $adminUser
        PlatformAccountProperties = $platformProps
    }

    if ($PSCmdlet.ShouldProcess(("{0}/{1}" -f $SafeName, $adminUser), "Add-PASAccount")) {
        try {
            $acct = Add-PASAccount @acctSplat -ErrorAction Stop
            Write-Ok ("Onboarded admin account '{0}' in Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})." -f $adminUser, $SafeName, $platformId, $addr, $logonDomain)
        }
        catch {
            Write-Err ("Failed to onboard admin account '{0}' in Safe '{1}': {2}" -f $adminUser, $SafeName, $_.Exception.Message)
        }
    }
}

# --- Core row processor: one IND_ safe + memberships + admin account ---
function Process-INDRow {
    param(
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][string]$EmployeeID,
        [Parameter(Mandatory)][string]$OwnerEmail,
        [Parameter(Mandatory)][string]$AdminAddressDomain
    )

    $sam  = $SamAccountName.Trim()
    $eid  = $EmployeeID.Trim()
    $mail = $OwnerEmail.Trim()

    if ([string]::IsNullOrWhiteSpace($sam) -or
        [string]::IsNullOrWhiteSpace($eid) -or
        [string]::IsNullOrWhiteSpace($mail)) {
        Write-Warn ("Skipping row with missing fields: Sam='{0}' EmployeeID='{1}' Email='{2}'" -f $sam, $eid, $mail)
        return
    }

    $safeName = "IND_{0}_{1}" -f $sam, $eid
    Write-Info ("Processing Safe: {0} (Owner={1})" -f $safeName, $mail)

    # Create Safe if missing; ensure 7-day retention
    $exists = $null
    try {
        $exists = Get-PASSafe -SafeName $safeName -ErrorAction SilentlyContinue
    } catch {}

    if (-not $exists) {
        $splat = @{
            SafeName              = $safeName
            Description           = "Individual safe for $sam ($eid)"
            ManagingCPM           = $ManagingCPM
            NumberOfDaysRetention = 7
            location              = $Location
        }
        if ($PSCmdlet.ShouldProcess($safeName, "Add-PASSafe")) {
            try {
                Add-PASSafe @splat -ErrorAction Stop | Out-Null
                Write-Ok ("Created Safe '{0}'." -f $safeName)
            } catch {
                Write-Err ("Failed to create Safe '{0}' : {1}" -f $safeName, $_.Exception.Message)
                return
            }
        }
    }
    else {
        Write-Warn ("Safe '{0}' already exists; ensuring retention & members." -f $safeName)
        try {
            Set-PASSafe -SafeName $safeName -NumberOfDaysRetention 7 -ErrorAction SilentlyContinue | Out-Null
            Write-Ok ("Ensured 7-day retention on '{0}'." -f $safeName)
        } catch {
            Write-Warn ("Could not set retention on existing '{0}': {1}" -f $safeName, $_.Exception.Message)
        }
    }

    # --- Permissions payloads ---
    $permAdmin = Get-AdminPerms
    $permOwner = Get-OwnerPerms

    # --- Add IAM_ACU_CA_Admins (full perms) – UPN then sAM on invalid parameters ---
    $iamUpn = 'IAM_ACU_CA_Admins@alliantcreditunion.com'
    $iamSam = 'IAM_ACU_CA_Admins'

    Write-Info ("Ensuring IAM_ACU_CA_Admins membership on '{0}'..." -f $safeName)
    $iamDone = $false
    try {
        Ensure-SafeMember -SafeName $safeName -MemberName $iamUpn -MemberType Group -PermFlags $permAdmin
        $iamDone = $true
    }
    catch {
        $msg = $_.Exception.Message
        Write-Warn ("UPN '{0}' failed on '{1}': {2}" -f $iamUpn, $safeName, $msg)
        if ($msg -match 'invalid parameters') {
            Write-Info ("Retrying with sAMAccountName '{0}'..." -f $iamSam)
            Ensure-SafeMember -SafeName $safeName -MemberName $iamSam -MemberType Group -PermFlags $permAdmin
            $iamDone = $true
        }
        else {
            throw
        }
    }
    if ($iamDone) {
        Write-Ok ("IAM_ACU_CA_Admins membership ensured on '{0}'." -f $safeName)
    }

    # --- Add Owner (email) with limited owner perms; same pattern as IAM group ---
    Write-Info ("Ensuring Owner '{0}' membership on '{1}'..." -f $mail, $safeName)
    $ownerDone = $false

    try {
        Ensure-SafeMember -SafeName $safeName -MemberName $mail -MemberType User -PermFlags $permOwner
        $ownerDone = $true
    }
    catch {
        $msg = $_.Exception.Message
        Write-Warn ("Owner UPN '{0}' failed on '{1}': {2}" -f $mail, $safeName, $msg)

        if ($msg -match 'invalid parameters' -and $mail -like '*@*') {
            $ownerSam = $mail.Split('@')[0]
            Write-Info ("Retrying Owner with sAM '{0}'..." -f $ownerSam)
            Ensure-SafeMember -SafeName $safeName -MemberName $ownerSam -MemberType User -PermFlags $permOwner
            $ownerDone = $true
        }
        else {
            throw
        }
    }

    if ($ownerDone) {
        # Description: strip domain from owner for description
        $ownerNoDomain = $mail.Split('@')[0]
        try {
            $desc = "Individual safe for $sam ($eid) – Managed By $ownerNoDomain"
            Set-PASSafe -SafeName $safeName -Description $desc -ErrorAction Stop | Out-Null
            Write-Ok ("Description set on '{0}': '{1}'" -f $safeName, $desc)
        } catch {
            Write-Warn ("Could not set description on '{0}': {1}" -f $safeName, $_.Exception.Message)
        }
    }

    # --- Onboard Admin Account in same Safe ---
    Onboard-AdminAccount -SafeName $safeName -SamAccountName $sam -OwnerEmail $mail -AdminAddressDomain $AdminAddressDomain

    Write-Ok ("Completed processing '{0}'." -f $safeName)
}

# --- MAIN ---
$sessionCreated     = $false
$adminAddressDomain = $null

try {
    # 1) Get Shared Services API Service User creds from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 2) Authenticate via Identity Shared Services using SERVICE USER
    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok ("Authenticated to {0} as service user: {1}" -f $PrivilegeCloudURL, $serviceCred.UserName)

    # 3) Prompt ONCE for Admin Address domain
    $adminAddressDomain = Get-AdminAddressDomain
    Write-Ok ("Admin Address domain set to: {0}" -f $adminAddressDomain)

    # 4) Process based on Mode
    if ($Mode -eq 'CSV') {
        Write-Info ("Mode = CSV. Loading: {0}" -f $CsvPath)
        if (-not (Test-Path $CsvPath)) {
            throw ("CSV not found: {0}" -f $CsvPath)
        }
        $rows = Import-Csv -Path $CsvPath
        if (-not $rows -or $rows.Count -eq 0) {
            throw ("CSV '{0}' has no rows." -f $CsvPath)
        }

        foreach ($row in $rows) {
            $sam  = ($row.Samaccountname).ToString()
            $eid  = ($row.employeeID).ToString()
            $mail = ($row.email).ToString()
            Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail -AdminAddressDomain $adminAddressDomain
        }

        Write-Ok ("CSV processing completed for {0} row(s)." -f $rows.Count)
    }
    else {
        Write-Info "Mode = Single. Prompting for one IND_ Safe owner..."

        $sam = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter SamAccountName (e.g. jdoe)" `
            -Default "" `
            -ValidationHint "SamAccountName only" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $sam) { Write-Warn "Cancelled (SamAccountName)."; return }

        $eid = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter employeeID" `
            -Default "" `
            -ValidationHint "HR/AD employeeID" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $eid) { Write-Warn "Cancelled (employeeID)."; return }

        $mail = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter owner email (UPN)" `
            -Default "" `
            -ValidationHint "Example: user@alliantcreditunion.com" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $mail) { Write-Warn "Cancelled (email)."; return }

        Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail -AdminAddressDomain $adminAddressDomain
    }
}
catch {
    Write-Err $_
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn ("Logoff warning: {0}" -f $_.Exception.Message)
        }
    }
}
