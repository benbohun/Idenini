# --- Allow this process to load unsigned modules & unblock psPAS files (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
  try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# --- Console "box" helper (for nice prompts) ---
Function Show-Box {
    param([string]$Title, [string]$BodyLine1 = "", [string]$BodyLine2 = "")
    $line = ('=' * 72)
    Write-Host $line -ForegroundColor DarkGray
    if ($Title)    { Write-Host ("[ " + $Title + " ]") -ForegroundColor Gray }
    if ($BodyLine1){ Write-Host $BodyLine1 -ForegroundColor Gray }
    if ($BodyLine2){ Write-Host $BodyLine2 -ForegroundColor Gray }
    Write-Host $line -ForegroundColor DarkGray
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log "psPAS loaded ($($mod.Version))." "Green"
} catch {
    Write-Log "❌ psPAS module not found/loaded: $($_.Exception.Message)" "Red"
    exit 1
}

# --- Try to import AD module for OU validation (non-fatal if missing) ---
$ADModuleLoaded = $false
try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $ADModuleLoaded = $true
} catch {
    Write-Log "⚠️ ActiveDirectory module not available; will still try to add group by UPN." "Yellow"
}

# --- CCP parameters (shared) ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safeCCP    = "CA_PCloud_Admins"
$headers    = @{ "Content-Type" = "application/json" }
$windowsAuth = $false

# =========================================
# 1) PAS session with CA_PAMDiscovery_SVC (from CCP) via psPAS
# =========================================
Write-Log "Retrieving CyberArk API credentials from CCP (CA_PAMDiscovery_SVC) via Object method..."
$object1 = "cna.com-CA_PAMDiscovery_SVC"
$ccpUrl1 = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$object1"

try {
    $response1 = Invoke-RestMethod $ccpUrl1 -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response1 -or -not $response1.Content) { throw "Empty CCP response" }
    Write-Log "✅ Successfully retrieved credentials for user: $($response1.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch failed - $_" "Red"
    exit 1
}

try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header) as CA_PAMDiscovery_SVC..."
    $UPUser = 'CA_PAMDiscovery_SVC'
    $UPPass = ConvertTo-SecureString $response1.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    $header1 = Get-IdentityHeader `
        -IdentityTenantURL "aat4012.id.cyberark.cloud" `
        -psPASFormat `
        -PCloudSubdomain "cna-prod" `
        -UPCreds $UPCred

    Use-PASSession $header1
    if (-not (Get-PASSession)) { throw "psPAS session not established" }
    Write-Log "✅ Authentication successful, PAS session established (CA_PAMDiscovery_SVC)." "Green"
} catch {
    Write-Log "❌ Failed to authenticate via psPAS Identity header: $($_.Exception.Message)" "Red"
    exit 1
}

# =========================================
# 2) Create Safe (always) + description dialog
# =========================================
$SafeName = Read-Host "Enter the Safe Name"

# Try a GUI input box for description; fallback to Read-Host if GUI not available
$DescriptionRaw = $null
try {
    Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop
    $DescriptionRaw = [Microsoft.VisualBasic.Interaction]::InputBox(
        "Paste a single-line description for the Safe (max 200 chars).",
        "Safe Description",
        ""
    )
} catch {
    Show-Box -Title "Safe Description" `
        -BodyLine1 "Paste a single-line description for the Safe (max 200 characters)." `
        -BodyLine2 "Example: 'Service accounts for AppX PROD'."
    $DescriptionRaw = Read-Host "Enter the Safe Description (single line, up to 200 chars)"
}

if ([string]::IsNullOrWhiteSpace($SafeName))      { Write-Log "❌ ERROR: Safe Name cannot be empty. Exiting..." "Red"; exit 1 }
if ([string]::IsNullOrWhiteSpace($DescriptionRaw)) { Write-Log "❌ ERROR: Safe Description cannot be empty. Exiting..." "Red"; exit 1 }

$Description = $DescriptionRaw.Trim()
if ($Description.Length -gt 200) {
    Write-Log "ℹ️ Safe Description >200 chars, auto-truncating."
    $Description = $Description.Substring(0,200)
}

$ManagingCPM = "CNA_PASS_MANG"
try {
    Write-Log "🔹 Creating Safe: ${SafeName}..."
    Add-PASSafe -SafeName $SafeName -ManagingCPM $ManagingCPM -Description $Description -NumberOfVersionsRetention 180 -ErrorAction Stop | Out-Null
    Write-Log "✅ Successfully created Safe: ${SafeName}." "Green"
} catch {
    Write-Log ("⚠️ Could not create Safe '{0}': {1}. Continuing to member add..." -f $SafeName, $_.Exception.Message) "Yellow"
}

# =========================================
# 3) Add members (AD group limited; admins unchanged; add cnarestbot Full)
# =========================================
$LimitedPermPAS = [PSCustomObject]@{
    UseAccounts                            = $false
    RetrieveAccounts                       = $false
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $false
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $false
    RenameAccounts                         = $false
    DeleteAccounts                         = $false
    UnlockAccounts                         = $true
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}
$FullPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $true
    DeleteAccounts                         = $true
    UnlockAccounts                         = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
    BackupSafe                             = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $true
    DeleteFolders                          = $true
    MoveAccountsAndFolders                 = $true
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}

# Optional AD validation inside the SearchBase OU
$SearchBaseOU = 'OU=Groups,OU=CyberArk,DC=cna,DC=com'
Function Read-ValidGroup {
    while ($true) {
        $g = Read-Host "Enter the AD Safe Group (sAMAccountName only, e.g., ca_xxx_xxx_prod)"
        if ([string]::IsNullOrWhiteSpace($g)) { Write-Log "❌ Group cannot be empty." "Red"; continue }
        if ($g -notmatch '^[A-Za-z0-9_\-\.]+$') { Write-Log "❌ Invalid characters in group name. Try again." "Red"; continue }

        if ($ADModuleLoaded) {
            try {
                $adGroup = Get-ADGroup -LDAPFilter "(|(sAMAccountName=$g)(userPrincipalName=$g@cna.com))" -SearchBase $SearchBaseOU -ErrorAction Stop
                if ($adGroup) {
                    Write-Log ("✅ Found AD Group in {0}: {1} (sAM={2})" -f $SearchBaseOU, $adGroup.Name, $adGroup.SamAccountName) "Green"
                    return $g
                } else {
                    Write-Log ("❌ Group not found under {0}. Re-enter." -f $SearchBaseOU) "Red"
                }
            } catch {
                Write-Log ("❌ Error searching AD for '{0}' in {1}: {2}" -f $g, $SearchBaseOU, $_.Exception.Message) "Red"
            }
        } else {
            Write-Log "⚠️ AD module not loaded, proceeding with provided group name (will add as UPN)." "Yellow"
            return $g
        }
    }
}
$GroupSam       = Read-ValidGroup
$TargetGroupUPN = "$GroupSam@cna.com"

$MembersToAdd = @(
    @{ Name = $TargetGroupUPN;                     Type = "Group"; Perm = $LimitedPermPAS }, # target AD group (Limited)
    @{ Name = "CA_PCloud_Admins@cna.com";          Type = "Group"; Perm = $FullPermPAS    }, # Full
    @{ Name = "cna_pas_admin@cyberark.cloud.6679"; Type = "User";  Perm = $FullPermPAS    }, # Full
    @{ Name = "cnarestbot@cyberark.cloud.6679";    Type = "User";  Perm = $FullPermPAS    }  # Full
)

Function Add-MemberToSafe {
    param(
        [string]$SafeName,
        [string]$MemberName,
        [ValidateSet("Group","User","Role")]
        [string]$MemberType,
        [pscustomobject]$Permissions
    )
    try {
        Write-Log "Adding ${MemberType} '${MemberName}' to ${SafeName}..."
        $Permissions | Add-PASSafeMember -SafeName $SafeName -MemberType $MemberType -MemberName $MemberName -ErrorAction Stop | Out-Null
        Write-Log "✅ Added ${MemberType}: ${MemberName}." "Green"
        return $true
    } catch {
        Write-Log ("❌ Failed to add '{0}' - {1}" -f $MemberName, $_.Exception.Message) "Red"
        return $false
    }
}

foreach ($m in $MembersToAdd) { [void](Add-MemberToSafe -SafeName $SafeName -MemberName $m.Name -MemberType $m.Type -Permissions $m.Perm) }
Write-Log "✅ Safe member addition process completed." "Green"

# =========================================
# 4) End FIRST psPAS session (discovery user)
# =========================================
try { Close-PASSession | Out-Null; Write-Log "✅ PAS session closed (CA_PAMDiscovery_SVC)." "Green" } catch {}

# =========================================
# 5) START a NEW psPAS session as cnarestbot (explicit)
# =========================================
Write-Log "Retrieving CyberArk API credentials from CCP (cnarestbot)..."
$object2 = "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"
$ccpUrl2 = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$object2"
try {
    $response2 = Invoke-RestMethod $ccpUrl2 -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response2 -or -not $response2.Content) { throw "Empty CCP response for cnarestbot" }
    Write-Log "✅ Successfully retrieved credentials for user: $($response2.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch (cnarestbot) failed - $_" "Red"
    exit 1
}

try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header) as cnarestbot..."
    $UPUser2 = 'cnarestbot@cyberark.cloud.6679'
    $UPPass2 = ConvertTo-SecureString $response2.Content -AsPlainText -Force
    $UPCred2 = [PSCredential]::new($UPUser2, $UPPass2)

    $header2 = Get-IdentityHeader `
        -IdentityTenantURL "aat4012.id.cyberark.cloud" `
        -psPASFormat `
        -PCloudSubdomain "cna-prod" `
        -UPCreds $UPCred2

    Use-PASSession $header2
    if (-not (Get-PASSession)) { throw "psPAS session not established (cnarestbot)" }
    Write-Log "✅ Authentication successful, PAS session established (cnarestbot)." "Green"
} catch {
    Write-Log "❌ Failed to authenticate (psPAS) as cnarestbot: $($_.Exception.Message)" "Red"
    exit 1
}

# =========================================
# 6) REST removal of Discovery user using documented endpoint
#     https://<subdomain>.privilegecloud.cyberark.cloud/PasswordVault/API/Safes/{SafeUrlId}/Members/{MemberName}/
# =========================================
# Obtain Identity token for REST (client credentials from CCP)
$IdentityTenantID = "aat4012"
$ClientID         = $response2.Username
$ClientSecret     = $response2.Content

Write-Log "Requesting Identity (client_credentials) token for REST deletes (cnarestbot)..."
$TokenURL     = "https://$IdentityTenantID.id.cyberark.cloud/oauth2/platformtoken"
$TokenBody    = @{ grant_type = "client_credentials"; client_id = $ClientID; client_secret = $ClientSecret }
$headersToken = @{ "Content-Type" = "application/x-www-form-urlencoded" }

$BearerToken = $null
try {
    $TokenResponse = Invoke-RestMethod -Uri $TokenURL -Method Post -Headers $headersToken -Body $TokenBody
    $BearerToken   = [string]$TokenResponse.access_token
    if ([string]::IsNullOrEmpty($BearerToken) -or $BearerToken.Length -lt 50) { throw "Invalid token length: $($BearerToken.Length)" }
    Write-Log "✅ REST token obtained (cnarestbot)." "Green"
} catch {
    Write-Log ("❌ Failed to get REST token (cnarestbot): {0}" -f $_.Exception.Message) "Red"
}

if ($BearerToken) {
    $PVWABase    = "https://cna-prod.privilegecloud.cyberark.cloud/PasswordVault"
    $headers_api = @{
      "Authorization" = "Bearer $BearerToken"
      "Content-Type"  = "application/json"
      "Accept"        = "application/json"
    }

    # Try common member-name variants directly with the documented DELETE endpoint
    $safeUrlId  = [uri]::EscapeDataString($SafeName)
    $candidates = @('CA_PAMDiscovery_SVC@cna.com','CA_PAMDiscovery_SVC','CNA\CA_PAMDiscovery_SVC')

    foreach ($name in $candidates) {
        $memberPath = [uri]::EscapeDataString($name)
        $url = "$PVWABase/API/Safes/$safeUrlId/Members/$memberPath/"
        Write-Log ("Attempting DELETE: {0}" -f $url)

        try {
            Invoke-RestMethod -Uri $url -Headers $headers_api -Method Delete -ErrorAction Stop | Out-Null
            Write-Log ("✅ Removed '{0}' from Safe '{1}' via documented REST endpoint." -f $name, $SafeName) "Green"
            break
        } catch {
            Write-Log ("ℹ️ DELETE failed for '{0}': {1}" -f $name, $_.Exception.Message) "Yellow"
        }
    }
}

# =========================================
# 7) Close the SECOND psPAS session (cnarestbot) & end
# =========================================
try { Close-PASSession | Out-Null; Write-Log "✅ PAS session closed (cnarestbot)." "Green" } catch {}

Write-Log "✅ Completed Safe creation, member additions, second session start, and discovery user cleanup via DELETE API." "Green"
