<#
Onboard_Domain_Service_Account.ps1

What this script does
- Logs in using CCP -> Identity Shared Services -> ServiceUser (same method as IND_SafeCreation_Identity.ps1)
- Prompts for the account domain type: GDE, ACU, or EXT
    GDE : Platform=WIN_P_DM_GDE_1T_SVC_30D    LogonDomain=GDEACU  Address=gdeacu.com
    ACU : Platform=WIN_P_DM_ACU_1T_SVC_30D    LogonDomain=ACU     Address=alliantcreditunion.com
    EXT : Platform=WIN_P_DM_EXTACU_1T_SVC_30D LogonDomain=extacu  Address=extacu.local
- Prompts ONLY for:
    1. Service account username
    2. Safe name
    3. Details (maps to the platform "Account Details" optional field)
- Onboards the service account into the given Safe
- Immediately initiates CPM Reconcile on the newly onboarded account
#>

[CmdletBinding(SupportsShouldProcess=$true)]
param(
    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Platform property name for the "Account Details" optional field =====
    [string]$DetailsPropertyName = "Details"
)

# --- Modules & TLS ---
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Continue'

# --- Pretty log helpers ---
function Write-Info($m){ Write-Host "ðŸ›   $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "âœ… $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "âš ï¸  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "âŒ $m" -ForegroundColor Red }

# --- GUI input helpers ---
Add-Type -AssemblyName System.Windows.Forms | Out-Null
Add-Type -AssemblyName System.Drawing       | Out-Null

function Show-InputDialog {
    param(
        [Parameter(Mandatory)][string]$Title,
        [Parameter(Mandatory)][string]$Prompt,
        [Parameter()][string]$Default = '',
        [Parameter()][scriptblock]$ValidateScript = {$true},
        [Parameter()][string]$ValidationHint = ''
    )
    try {
        $form                 = New-Object System.Windows.Forms.Form
        $form.Text            = $Title
        $form.StartPosition   = 'CenterScreen'
        $form.TopMost         = $true
        $form.Size            = New-Object System.Drawing.Size(480,190)
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox     = $false

        $lbl                  = New-Object System.Windows.Forms.Label
        $lbl.Text             = $Prompt
        $lbl.AutoSize         = $true
        $lbl.Location         = '12,15'
        $lbl.Font             = New-Object System.Drawing.Font('Segoe UI',10)
        $form.Controls.Add($lbl)

        $tb                   = New-Object System.Windows.Forms.TextBox
        $tb.Location          = '16,48'
        $tb.Width             = 430
        $tb.Text              = $Default
        $tb.Font              = New-Object System.Drawing.Font('Consolas',11)
        $form.Controls.Add($tb)

        $hint                 = New-Object System.Windows.Forms.Label
        $hint.AutoSize        = $true
        $hint.ForeColor       = [System.Drawing.Color]::DarkGray
        $hint.Text            = $ValidationHint
        $hint.Location        = '16,80'
        $form.Controls.Add($hint)

        $ok                   = New-Object System.Windows.Forms.Button
        $ok.Text              = 'Continue'
        $ok.Location          = '272,110'
        $ok.Width             = 80
        $ok.DialogResult      = [System.Windows.Forms.DialogResult]::OK
        $form.AcceptButton    = $ok
        $form.Controls.Add($ok)

        $cancel               = New-Object System.Windows.Forms.Button
        $cancel.Text          = 'Cancel'
        $cancel.Location      = '366,110'
        $cancel.Width         = 80
        $cancel.DialogResult  = [System.Windows.Forms.DialogResult]::Cancel
        $form.CancelButton    = $cancel
        $form.Controls.Add($cancel)

        $tb.add_TextChanged({
            try {
                if (& $ValidateScript $tb.Text) { $tb.BackColor = [System.Drawing.Color]::White }
                else                            { $tb.BackColor = [System.Drawing.Color]::MistyRose }
            } catch {
                $tb.BackColor = [System.Drawing.Color]::MistyRose
            }
        })

        $dialog = $form.ShowDialog()
        if ($dialog -ne [System.Windows.Forms.DialogResult]::OK) { return $null }

        $val = $tb.Text.Trim()
        if (-not (& $ValidateScript $val)) {
            [System.Windows.Forms.MessageBox]::Show(
                "Value is invalid. Please try again.",
                "Validation",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null
            return Show-InputDialog @PSBoundParameters
        }
        return $val
    } catch {
        $val = Read-Host "$Title - $Prompt"
        if (-not (& $ValidateScript $val)) { throw "Input failed validation." }
        return $val
    }
}

function Show-DomainTypeDialog {
    <#
        Radio-button picker for GDE / ACU / EXT.
        Returns 'GDE', 'ACU', or 'EXT' (or $null on cancel).
    #>
    try {
        $form                 = New-Object System.Windows.Forms.Form
        $form.Text            = "Service Account Domain Type"
        $form.StartPosition   = 'CenterScreen'
        $form.TopMost         = $true
        $form.Size            = New-Object System.Drawing.Size(480,260)
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox     = $false

        $lbl                  = New-Object System.Windows.Forms.Label
        $lbl.Text             = "Select the domain for this service account:"
        $lbl.AutoSize         = $true
        $lbl.Location         = '12,15'
        $lbl.Font             = New-Object System.Drawing.Font('Segoe UI',10)
        $form.Controls.Add($lbl)

        $rbACU                = New-Object System.Windows.Forms.RadioButton
        $rbACU.Text           = "ACU  -  alliantcreditunion.com  (WIN_P_DM_ACU_1T_SVC_30D)"
        $rbACU.Location       = '20,50'
        $rbACU.Width          = 430
        $rbACU.Checked        = $true
        $form.Controls.Add($rbACU)

        $rbGDE                = New-Object System.Windows.Forms.RadioButton
        $rbGDE.Text           = "GDE  -  gdeacu.com  (WIN_P_DM_GDE_1T_SVC_30D)"
        $rbGDE.Location       = '20,85'
        $rbGDE.Width          = 430
        $form.Controls.Add($rbGDE)

        $rbEXT                = New-Object System.Windows.Forms.RadioButton
        $rbEXT.Text           = "EXT  -  extacu.local  (WIN_P_DM_EXTACU_1T_SVC_30D)"
        $rbEXT.Location       = '20,120'
        $rbEXT.Width          = 430
        $form.Controls.Add($rbEXT)

        $ok                   = New-Object System.Windows.Forms.Button
        $ok.Text              = 'Continue'
        $ok.Location          = '272,170'
        $ok.Width             = 80
        $ok.DialogResult      = [System.Windows.Forms.DialogResult]::OK
        $form.AcceptButton    = $ok
        $form.Controls.Add($ok)

        $cancel               = New-Object System.Windows.Forms.Button
        $cancel.Text          = 'Cancel'
        $cancel.Location      = '366,170'
        $cancel.Width         = 80
        $cancel.DialogResult  = [System.Windows.Forms.DialogResult]::Cancel
        $form.CancelButton    = $cancel
        $form.Controls.Add($cancel)

        $dialog = $form.ShowDialog()
        if ($dialog -ne [System.Windows.Forms.DialogResult]::OK) { return $null }

        if ($rbGDE.Checked) { return 'GDE' }
        if ($rbEXT.Checked) { return 'EXT' }
        return 'ACU'
    } catch {
        # Console fallback
        $val = Read-Host "Enter domain type (GDE / ACU / EXT)"
        $val = $val.Trim().ToUpper()
        if ($val -in @('GDE','ACU','EXT')) { return $val }
        throw "Invalid domain type '$val'. Must be GDE, ACU, or EXT."
    }
}

# --- Domain type -> platform mapping ---
function Get-DomainMapping {
    param([Parameter(Mandatory)][ValidateSet('GDE','ACU','EXT')][string]$DomainType)

    switch ($DomainType) {
        'GDE' {
            return @{
                PlatformID  = 'WIN_P_DM_GDE_1T_SVC_30D'
                LogonDomain = 'GDEACU'
                Address     = 'gdeacu.com'
            }
        }
        'ACU' {
            return @{
                PlatformID  = 'WIN_P_DM_ACU_1T_SVC_30D'
                LogonDomain = 'ACU'
                Address     = 'alliantcreditunion.com'
            }
        }
        'EXT' {
            return @{
                PlatformID  = 'WIN_P_DM_EXTACU_1T_SVC_30D'
                LogonDomain = 'extacu'
                Address     = 'extacu.local'
            }
        }
    }
}

# --- CCP -> PSCredential (API Service User) ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- Resolve Account ID safely from object / lookup ---
function Get-PASAccountIdValue {
    [CmdletBinding()]
    param(
        [Parameter()][object]$AccountObject
    )

    if (-not $AccountObject) { return $null }

    foreach ($propName in @('id','ID','AccountID','AccountId')) {
        $p = $AccountObject.PSObject.Properties[$propName]
        if ($p -and -not [string]::IsNullOrWhiteSpace([string]$p.Value)) {
            return [string]$p.Value
        }
    }

    return $null
}

# --- Version-safe REST POST using current psPAS session ---
function Invoke-PASNativeRest {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$RelativePath,  # e.g. "API/Accounts/123/Reconcile"
        [Parameter()][string]$BodyJson = '{}'
    )

    $sess = Get-PASSession
    if (-not $sess) { throw "No PAS session found. Authenticate first." }

    $base = $null
    foreach ($p in @('BaseURI','BaseUrl','PVWAURL','Url','URI')) {
        if ($sess.PSObject.Properties[$p]) {
            $base = [string]$sess.$p
            if (-not [string]::IsNullOrWhiteSpace($base)) { break }
        }
    }

    if ([string]::IsNullOrWhiteSpace($base)) {
        $base = ($PrivilegeCloudURL.TrimEnd('/') + '/PasswordVault')
    }

    if ($base -notmatch '(?i)/PasswordVault(/|$)') {
        $base = $base.TrimEnd('/') + '/PasswordVault'
    }

    $fullUri = $base.TrimEnd('/') + '/' + $RelativePath.TrimStart('/')

    $headers = @{ 'Content-Type' = 'application/json' }

    if ($sess.PSObject.Properties['Headers'] -and $sess.Headers) {
        foreach ($k in $sess.Headers.Keys) { $headers[$k] = $sess.Headers[$k] }
    }

    $token = $null
    foreach ($p in @('Token','token','Authorization','AuthToken')) {
        if ($sess.PSObject.Properties[$p]) {
            $token = [string]$sess.$p
            if (-not [string]::IsNullOrWhiteSpace($token)) { break }
        }
    }
    if ($token -and -not $headers.ContainsKey('Authorization')) {
        $headers['Authorization'] = $token
    }

    $webSession = $null
    foreach ($p in @('WebSession','webSession')) {
        if ($sess.PSObject.Properties[$p]) {
            $webSession = $sess.$p
            if ($webSession) { break }
        }
    }

    if ($webSession) {
        return Invoke-RestMethod -Uri $fullUri -Method POST -Headers $headers -WebSession $webSession -Body $BodyJson -ErrorAction Stop
    }

    return Invoke-RestMethod -Uri $fullUri -Method POST -Headers $headers -Body $BodyJson -ErrorAction Stop
}

# --- Reconcile helper (version-safe) ---
function Invoke-AccountReconcile {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][string]$AccountId,
        [Parameter(Mandatory)][string]$AccountName,
        [Parameter(Mandatory)][string]$SafeName
    )

    if ([string]::IsNullOrWhiteSpace($AccountId)) {
        Write-Warn "Reconcile skipped for '$AccountName' in '$SafeName': Account ID is empty."
        return $false
    }

    $rel = "API/Accounts/$AccountId/Reconcile"

    if ($PSCmdlet.ShouldProcess("$SafeName/$AccountName [$AccountId]", "POST $rel")) {
        try {
            $cmd = Get-Command -Name 'Invoke-PASRestMethod' -ErrorAction SilentlyContinue
            if ($cmd) {
                Invoke-PASRestMethod -Uri $rel -Method POST -Body '{}' -ErrorAction Stop | Out-Null
            } else {
                Invoke-PASNativeRest -RelativePath $rel -BodyJson '{}' | Out-Null
            }

            Write-Ok "Reconcile initiated for account '$AccountName' in Safe '$SafeName' (AccountID=$AccountId)."
            return $true
        }
        catch {
            Write-Err "Failed to initiate reconcile for '$AccountName' in '$SafeName' (AccountID=$AccountId): $($_.Exception.Message)"
            return $false
        }
    }

    return $true
}

# --- Service account onboarding ---
function Onboard-ServiceAccount {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$ServiceAccountName,
        [Parameter(Mandatory)][ValidateSet('GDE','ACU','EXT')][string]$DomainType,
        [Parameter()][string]$Details = ''
    )

    $svc = $ServiceAccountName.Trim()
    $map = Get-DomainMapping -DomainType $DomainType

    $platformId  = $map.PlatformID
    $logonDomain = $map.LogonDomain
    $addr        = $map.Address

    Write-Info ("Preparing to onboard service account '{0}' to Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})..." -f $svc, $SafeName, $platformId, $addr, $logonDomain)

    # --- Verify the Safe exists before attempting onboard ---
    $safeExists = $null
    try { $safeExists = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue } catch {}
    if (-not $safeExists) {
        Write-Err "Safe '$SafeName' was not found. Verify the Safe name and try again."
        return
    }

    # --- Skip if the account already exists in this Safe ---
    $existingAcct = $null
    try {
        $existingAcct = Get-PASAccount -SafeName $SafeName -Search $svc -ErrorAction SilentlyContinue |
                        Where-Object { $_.UserName -eq $svc -and $_.Address -eq $addr } |
                        Select-Object -First 1
    } catch {}

    if ($existingAcct) {
        Write-Warn ("Service account '{0}' already exists in Safe '{1}' with Address '{2}' - skipping onboard and auto-reconcile." -f $svc, $SafeName, $addr)
        return
    }

    # --- Platform properties (LogonDomain + Account Details field) ---
    $platformProps = @{
        LogonDomain = $logonDomain
    }
    if (-not [string]::IsNullOrWhiteSpace($Details)) {
        $platformProps[$DetailsPropertyName] = $Details.Trim()
    }

    $acctSplat = @{
        SafeName                  = $SafeName
        PlatformID                = $platformId
        Address                   = $addr
        UserName                  = $svc
        PlatformAccountProperties = $platformProps
    }

    if ($PSCmdlet.ShouldProcess(("{0}/{1}" -f $SafeName, $svc), "Add-PASAccount")) {
        try {
            $newAccount = Add-PASAccount @acctSplat -ErrorAction Stop
            Write-Ok ("Onboarded service account '{0}' in Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})." -f $svc, $SafeName, $platformId, $addr, $logonDomain)
            if ($platformProps.ContainsKey($DetailsPropertyName)) {
                Write-Ok ("Account Details set: '{0}'" -f $platformProps[$DetailsPropertyName])
            }

            $accountId = Get-PASAccountIdValue -AccountObject $newAccount

            if (-not $accountId) {
                Write-Warn "Add-PASAccount did not return an Account ID directly. Performing lookup..."
                Start-Sleep -Seconds 2
                try {
                    $lookup = Get-PASAccount -SafeName $SafeName -Search $svc -ErrorAction Stop |
                              Where-Object { $_.UserName -eq $svc -and $_.Address -eq $addr } |
                              Select-Object -First 1
                    $accountId = Get-PASAccountIdValue -AccountObject $lookup
                } catch {
                    Write-Warn "Lookup after onboard failed for '$svc' in '$SafeName': $($_.Exception.Message)"
                }
            }

            if ($accountId) {
                Invoke-AccountReconcile -AccountId $accountId -AccountName $svc -SafeName $SafeName | Out-Null
            } else {
                Write-Warn "Account '$svc' was onboarded, but Account ID could not be resolved. Auto-reconcile was skipped."
            }
        }
        catch {
            Write-Err ("Failed to onboard service account '{0}' in Safe '{1}': {2}" -f $svc, $SafeName, $_.Exception.Message)
        }
    }
}

# --- MAIN ---
$sessionCreated = $false

try {
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    # --- 1. Domain type (GDE / ACU / EXT) ---
    $domainType = Show-DomainTypeDialog
    if (-not $domainType) { Write-Warn "Cancelled (domain type)."; return }

    $map = Get-DomainMapping -DomainType $domainType
    Write-Ok ("Domain type: {0} (Platform={1}, LogonDomain={2}, Address={3})" -f $domainType, $map.PlatformID, $map.LogonDomain, $map.Address)

    # --- 2. Service account username ---
    $svcUser = Show-InputDialog -Title "Service Account Onboarding" `
        -Prompt "Enter service account username (e.g. svc_app01)" `
        -Default "" `
        -ValidationHint "Service account username only - no domain prefix" `
        -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }
    if (-not $svcUser) { Write-Warn "Cancelled (service account username)."; return }

    # --- 3. Safe name ---
    $safeName = Show-InputDialog -Title "Service Account Onboarding" `
        -Prompt "Enter target Safe name" `
        -Default "" `
        -ValidationHint "Safe must already exist (e.g. APP_SVC_TeamName)" `
        -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }
    if (-not $safeName) { Write-Warn "Cancelled (Safe name)."; return }

    # --- 4. Details (Account Details platform field) ---
    $details = Show-InputDialog -Title "Service Account Onboarding" `
        -Prompt "Enter Details (Account Details field)" `
        -Default "" `
        -ValidationHint "Description of what this service account is used for" `
        -ValidateScript { param($x) $true }
    if ($null -eq $details) { Write-Warn "Cancelled (Details)."; return }

    # --- Onboard + reconcile ---
    Onboard-ServiceAccount -SafeName $safeName.Trim() -ServiceAccountName $svcUser -DomainType $domainType -Details $details
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
