$LogRoot = "C:\Program Files (x86)\CyberArk\PSM\Logs"

Get-ChildItem $LogRoot -Recurse -File -ErrorAction SilentlyContinue |
Select-String -Pattern `
    "ClearUserProfiles",
    "UserProfileThreshold",
    "CleanupInterval",
    "CleanupFolders",
    "Shadow",
    "profile cleanup",
    "remove profile",
    "delete profile" |
Select-Object Path,LineNumber,Line |
Format-Table -AutoSize
