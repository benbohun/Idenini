<#
IND_AddNewIdentityUsersToSafe.ps1

Purpose:
- Retrieve CyberArk Identity API service user credential from CCP.
- Authenticate to CyberArk Identity OAuth using the working RestAPI Application ID.
- Query CyberArk Identity Redrock/Event data for newly created users.
- Resolve each user's samAccountName.
- Match each user to an existing IND Safe:
    IND_<samAccountName>
    IND_<samAccountName>_*
- Add samAccountName@alliantcreditunion.com to the matching IND Safe.
- Apply default individual Safe permissions.
- Export audit results to CSV.
- Designed for scheduled daily execution.

Safety:
- Script defaults to dry-run.
- Use -LiveRun only when ready to make actual Safe membership changes.

Confirmed OAuth behavior:
- Application ID: RestAPI
- Token URL: https://aak4521.my.idaptive.app/oauth2/token/RestAPI
- Grant type: client_credentials
- Scope: reporting
- Client authentication: Basic auth header
- Basic auth pair format: raw client_id:client_secret
- Encoding: ASCII
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # Confirmed working OAuth Application ID.
    [string]$IdentityOAuthAppId = "RestAPI",

    # OAuth scope configured with REST Regex: Redrock/query
    [string]$OAuthScope         = "reporting",

    # ===== CCP settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== IND Safe matching =====
    [string]$IndSafePrefix      = "IND_",
    [string]$DefaultUserDomain  = "alliantcreditunion.com",
    [string]$PreferredSearchIn  = "alliantcreditunion.com",

    # ===== Newly created Identity user window =====
    # For daily task, 1 day is normally enough.
    # Increase to 2 if you want overlap protection.
    [int]$LookbackDays          = 1,

    # ===== Output =====
    [string]$OutputFolder       = "I:\Script\IDENTITY Script New\logs\INDSafeUserMembership",
    [string]$CsvFilePath        = "",
    [string]$LogFile            = "",

    # ===== Run behavior =====
    # No -LiveRun = dry-run.
    # -LiveRun = actual Safe membership changes.
    [switch]$LiveRun,

    # If user already exists in the Safe, this updates permissions.
    [switch]$UpdateExistingMember,

    # Test CCP + OAuth token + Redrock only. No Privilege Cloud login or Safe update.
    [switch]$TokenOnly,

    # ===== Redrock paging =====
    [int]$PageSize              = 1000
)

# Bare execution is always dry-run.
$DryRun = -not $LiveRun

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Stop"

Import-Module psPAS -ErrorAction Stop
Import-Module IdentityCommand -ErrorAction Stop

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
}

$RunStamp = Get-Date -Format "yyyyMMdd_HHmmss"

if ([string]::IsNullOrWhiteSpace($LogFile)) {
    $LogFile = Join-Path $OutputFolder "INDSafeUserMembership_$RunStamp.log"
}

if ([string]::IsNullOrWhiteSpace($CsvFilePath)) {
    $CsvFilePath = Join-Path $OutputFolder "INDSafeUserMembership_$RunStamp.csv"
}

$script:RunResults = New-Object System.Collections.Generic.List[object]

# Default individual Safe permissions.
$IndividualSafePermissions = @{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $false
    RenameAccounts                         = $false
    DeleteAccounts                         = $false
    UnlockAccounts                         = $false
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
}

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet("INFO", "WARN", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "$timestamp | $Level | $Message"

    Add-Content -Path $LogFile -Value $entry

    switch ($Level) {
        "SUCCESS" { Write-Host $entry -ForegroundColor Green }
        "WARN"    { Write-Host $entry -ForegroundColor Yellow }
        "ERROR"   { Write-Host $entry -ForegroundColor Red }
        default   { Write-Host $entry -ForegroundColor White }
    }
}

function Add-RunResult {
    param(
        [string]$SamAccountName,
        [string]$UserPrincipalName,
        [string]$SafeName,
        [string]$MemberName,
        [string]$Action,
        [string]$Status,
        [string]$Detail,
        [string]$IdentityEventTime,
        [string]$IdentityEventType,
        [string]$IdentityEventAction,
        [string]$IdentityEventClassification
    )

    $script:RunResults.Add([PSCustomObject]@{
        RunTime                     = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        SamAccountName              = $SamAccountName
        UserPrincipalName           = $UserPrincipalName
        SafeName                    = $SafeName
        MemberName                  = $MemberName
        Action                      = $Action
        Status                      = $Status
        Detail                      = $Detail
        IdentityEventTime           = $IdentityEventTime
        IdentityEventType           = $IdentityEventType
        IdentityEventAction         = $IdentityEventAction
        IdentityEventClassification = $IdentityEventClassification
    }) | Out-Null
}

function Convert-ToCleanString {
    param(
        [object]$Value
    )

    if ($null -eq $Value) {
        return ""
    }

    return ([string]$Value).Trim()
}

function ConvertTo-UrlEncodedValue {
    param(
        [Parameter(Mandatory)]
        [string]$Value
    )

    return [System.Uri]::EscapeDataString($Value)
}

function Read-HttpResponseBody {
    param(
        [Parameter(Mandatory)]
        [System.Net.WebResponse]$Response
    )

    $stream = $null
    $reader = $null

    try {
        $stream = $Response.GetResponseStream()

        if (-not $stream) {
            return ""
        }

        $reader = New-Object System.IO.StreamReader($stream)
        return $reader.ReadToEnd()
    }
    finally {
        if ($reader) {
            $reader.Close()
        }

        if ($stream) {
            $stream.Close()
        }
    }
}

function Invoke-HttpPost {
    param(
        [Parameter(Mandatory)]
        [string]$Uri,

        [Parameter(Mandatory)]
        [string]$Body,

        [Parameter(Mandatory)]
        [string]$ContentType,

        [hashtable]$Headers = @{}
    )

    $request = [System.Net.WebRequest]::Create($Uri)
    $request.Method = "POST"
    $request.ContentType = $ContentType
    $request.Accept = "application/json"

    foreach ($key in $Headers.Keys) {
        $request.Headers.Add($key, [string]$Headers[$key])
    }

    $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes($Body)
    $request.ContentLength = $bodyBytes.Length

    $requestStream = $null

    try {
        $requestStream = $request.GetRequestStream()
        $requestStream.Write($bodyBytes, 0, $bodyBytes.Length)
    }
    finally {
        if ($requestStream) {
            $requestStream.Close()
        }
    }

    try {
        $response = $request.GetResponse()
        $responseBody = Read-HttpResponseBody -Response $response

        return [PSCustomObject]@{
            Success           = $true
            StatusCode        = [int]$response.StatusCode
            StatusDescription = [string]$response.StatusDescription
            Body              = $responseBody
        }
    }
    catch [System.Net.WebException] {
        $webResponse = $_.Exception.Response

        if ($webResponse) {
            $errorBody = Read-HttpResponseBody -Response $webResponse

            return [PSCustomObject]@{
                Success           = $false
                StatusCode        = [int]$webResponse.StatusCode
                StatusDescription = [string]$webResponse.StatusDescription
                Body              = $errorBody
            }
        }

        return [PSCustomObject]@{
            Success           = $false
            StatusCode        = ""
            StatusDescription = ""
            Body              = $_.Exception.Message
        }
    }
}

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd("/")
    $loc  = $Location.Trim("/")

    $encodedAppID  = ConvertTo-UrlEncodedValue -Value $AppID
    $encodedSafe   = ConvertTo-UrlEncodedValue -Value $Safe
    $encodedObject = ConvertTo-UrlEncodedValue -Value $Object

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $base, `
        $loc, `
        $encodedAppID, `
        $encodedSafe, `
        $encodedObject

    Write-Log "Retrieving service user credential from CCP."
    Write-Log ("CCP URL: {0}" -f $url)

    try {
        $headers = @{
            "Content-Type" = "application/json"
        }

        $resp = Invoke-RestMethod `
            -Uri $url `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$WindowsAuth `
            -ErrorAction Stop

        if (-not $resp.UserName -or -not $resp.Content) {
            throw "CCP response is missing UserName or Content."
        }

        Write-Log ("CCP returned service user username: {0}" -f $resp.UserName) "SUCCESS"

        return [PSCustomObject]@{
            UserName = [string]$resp.UserName
            Secret   = [string]$resp.Content
        }
    }
    catch {
        throw "CCP credential retrieval failed. $($_.Exception.Message)"
    }
}

function New-BasicAuthHeaderValue {
    param(
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret
    )

    # Confirmed working format from your successful test:
    # raw client_id:client_secret encoded with ASCII.
    $pair = "{0}:{1}" -f $ClientId, $ClientSecret
    $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
    $basicToken = [Convert]::ToBase64String($bytes)

    return "Basic $basicToken"
}

function Get-IdentityReportingToken {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$IdentityOAuthAppId,
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret,
        [Parameter(Mandatory)][string]$Scope
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $appId  = $IdentityOAuthAppId.Trim("/")
    $tokenUri = "$tenant/oauth2/token/$appId"

    Write-Log ("Requesting Identity OAuth token from: {0}" -f $tokenUri)
    Write-Log ("OAuth Client ID from CCP: {0}" -f $ClientId)
    Write-Log ("OAuth Scope: {0}" -f $Scope)

    $body = "grant_type=client_credentials&scope=$([System.Uri]::EscapeDataString($Scope))"

    $headers = @{
        Authorization = New-BasicAuthHeaderValue `
            -ClientId $ClientId `
            -ClientSecret $ClientSecret
    }

    $response = Invoke-HttpPost `
        -Uri $tokenUri `
        -Body $body `
        -ContentType "application/x-www-form-urlencoded" `
        -Headers $headers

    if (-not $response.Success) {
        $msg = @"
Unable to retrieve Identity OAuth token.

Token URL:
$tokenUri

HTTP Response:
$($response.StatusCode) $($response.StatusDescription)

Response Body:
$($response.Body)

Validate:
1. OAuth Application ID is correct. Current value: $IdentityOAuthAppId
2. Scope is exactly: $Scope
3. REST Regex is exactly: Redrock/query
4. Auth method includes Client Creds
5. CCP returned user is added under OAuth app Permissions
6. CCP returned user has Report Management
7. CCP password is current
"@

        throw $msg
    }

    try {
        $json = $response.Body | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw ("Identity token response was not valid JSON. Body: {0}" -f $response.Body)
    }

    if (-not $json.access_token) {
        throw ("Identity token response did not include access_token. Body: {0}" -f $response.Body)
    }

    Write-Log ("Identity OAuth token retrieved. TokenType={0}; ExpiresIn={1}" -f $json.token_type, $json.expires_in) "SUCCESS"

    return [string]$json.access_token
}

function Invoke-RedrockQuery {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken,
        [Parameter(Mandatory)][string]$Query,
        [int]$PageSize = 1000
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $queryUri = "$tenant/Redrock/query"

    $headers = @{
        Authorization = "Bearer $AccessToken"
    }

    $allRows = New-Object System.Collections.Generic.List[object]
    $pageNumber = 1

    while ($true) {
        $payload = @{
            Script = $Query
            Args   = @{
                PageNumber = $pageNumber
                PageSize   = $PageSize
                Limit      = $PageSize
                Caching    = -1
            }
        } | ConvertTo-Json -Depth 10

        $response = Invoke-HttpPost `
            -Uri $queryUri `
            -Body $payload `
            -ContentType "application/json" `
            -Headers $headers

        if (-not $response.Success) {
            throw ("Redrock query failed. HTTP {0} {1}. Body: {2}" -f `
                $response.StatusCode, `
                $response.StatusDescription, `
                $response.Body)
        }

        try {
            $json = $response.Body | ConvertFrom-Json -ErrorAction Stop
        }
        catch {
            throw ("Redrock query response was not valid JSON. Body: {0}" -f $response.Body)
        }

        if ($json.success -eq $false) {
            throw ("Redrock returned success=false. Message: {0}. Body: {1}" -f $json.Message, $response.Body)
        }

        $pageRows = @()

        if ($json.Result -and $json.Result.Results) {
            $pageRows = @($json.Result.Results | ForEach-Object { $_.Row })
        }

        if (-not $pageRows -or $pageRows.Count -eq 0) {
            break
        }

        foreach ($row in $pageRows) {
            $allRows.Add($row) | Out-Null
        }

        if ($pageRows.Count -lt $PageSize) {
            break
        }

        $pageNumber++
    }

    return @($allRows)
}

function Convert-FromIdentityDate {
    param(
        [object]$Value
    )

    if (-not $Value) {
        return $null
    }

    $text = [string]$Value

    if ($text -match "/Date\((\d+)\)/") {
        $epochMs = [Int64]$matches[1]
        return ([DateTimeOffset]::FromUnixTimeMilliseconds($epochMs)).LocalDateTime
    }

    try {
        return [datetime]$text
    }
    catch {
        return $text
    }
}

function Convert-NewEntityJson {
    param(
        [string]$NewEntity
    )

    if ([string]::IsNullOrWhiteSpace($NewEntity)) {
        return $null
    }

    try {
        return ($NewEntity | ConvertFrom-Json -ErrorAction Stop)
    }
    catch {
        return $null
    }
}

function Get-NestedPropertyValue {
    param(
        [object]$InputObject,
        [string[]]$Names,
        [int]$Depth = 0
    )

    if ($null -eq $InputObject -or $Depth -gt 8) {
        return $null
    }

    if ($InputObject -is [string] -or $InputObject.GetType().IsPrimitive) {
        return $null
    }

    foreach ($name in $Names) {
        $prop = $InputObject.PSObject.Properties |
            Where-Object { $_.Name -ieq $name } |
            Select-Object -First 1

        if ($prop -and $null -ne $prop.Value -and -not [string]::IsNullOrWhiteSpace([string]$prop.Value)) {
            return [string]$prop.Value
        }
    }

    foreach ($prop in $InputObject.PSObject.Properties) {
        $value = $prop.Value

        if ($null -eq $value) {
            continue
        }

        if ($value -is [System.Array]) {
            foreach ($item in $value) {
                $found = Get-NestedPropertyValue `
                    -InputObject $item `
                    -Names $Names `
                    -Depth ($Depth + 1)

                if ($found) {
                    return $found
                }
            }
        }
        elseif (-not ($value -is [string]) -and -not $value.GetType().IsPrimitive) {
            $found = Get-NestedPropertyValue `
                -InputObject $value `
                -Names $Names `
                -Depth ($Depth + 1)

            if ($found) {
                return $found
            }
        }
    }

    return $null
}

function Get-NewIdentityUserCandidates {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken,
        [int]$LookbackDays = 1,
        [int]$PageSize = 1000,
        [string]$DefaultUserDomain = "alliantcreditunion.com"
    )

    Write-Log ("Querying CyberArk Identity for newly added users within the last {0} day(s)." -f $LookbackDays)

    $eventRows = New-Object System.Collections.Generic.List[object]

    # AD / directory synced user changes.
    $dseQuery = @"
Select WhenOccurred, EventType, EntityName, EntityUuid, NewEntity, Action, Classification, DSName, DSType
from Event
where WhenOccurred >= DateFunc('now','-$LookbackDays')
and EventType = 'Cloud.Core.DSEntityChange'
order by WhenOccurred desc
"@

    try {
        $dseRows = Invoke-RedrockQuery `
            -IdentityTenantURL $IdentityTenantURL `
            -AccessToken $AccessToken `
            -Query $dseQuery `
            -PageSize $PageSize

        foreach ($row in $dseRows) {
            $eventRows.Add($row) | Out-Null
        }

        Write-Log ("Retrieved {0} DSEntityChange event row(s)." -f @($dseRows).Count)
    }
    catch {
        Write-Log ("DSEntityChange query failed: {0}" -f $_.Exception.Message) "WARN"
    }

    # Cloud directory user creation.
    $cusQuery = @"
Select WhenOccurred, EventType, EntityName, EntityUuid, NewEntity, UserGuid
from Event
where WhenOccurred >= DateFunc('now','-$LookbackDays')
and EventType = 'Cloud.Core.Cus.CusEntity.CusCreateUser'
order by WhenOccurred desc
"@

    try {
        $cusRows = Invoke-RedrockQuery `
            -IdentityTenantURL $IdentityTenantURL `
            -AccessToken $AccessToken `
            -Query $cusQuery `
            -PageSize $PageSize

        foreach ($row in $cusRows) {
            $eventRows.Add($row) | Out-Null
        }

        Write-Log ("Retrieved {0} CusCreateUser event row(s)." -f @($cusRows).Count)
    }
    catch {
        Write-Log ("CusCreateUser query failed: {0}" -f $_.Exception.Message) "WARN"
    }

    $candidates = New-Object System.Collections.Generic.List[object]

    foreach ($event in $eventRows) {
        $eventType = Convert-ToCleanString $event.EventType
        $action = Convert-ToCleanString $event.Action
        $classification = Convert-ToCleanString $event.Classification

        $isNewUserEvent = $false

        if ($eventType -ieq "Cloud.Core.DSEntityChange") {
            if ($action -match "(?i)add|create|new" -and $classification -match "(?i)user|person") {
                $isNewUserEvent = $true
            }
        }

        if ($eventType -ieq "Cloud.Core.Cus.CusEntity.CusCreateUser") {
            $isNewUserEvent = $true
        }

        if (-not $isNewUserEvent) {
            continue
        }

        $entity = Convert-NewEntityJson -NewEntity ([string]$event.NewEntity)

        $sam = Get-NestedPropertyValue `
            -InputObject $entity `
            -Names @(
                "SamAccountName",
                "samAccountName",
                "sAMAccountName",
                "SAMAccountName",
                "samaccountname",
                "WindowsAccountName",
                "windowsAccountName"
            )

        $upn = Get-NestedPropertyValue `
            -InputObject $entity `
            -Names @(
                "UserPrincipalName",
                "userPrincipalName",
                "UPN",
                "upn",
                "Username",
                "UserName",
                "LoginName",
                "PrincipalName",
                "Name",
                "name"
            )

        $email = Get-NestedPropertyValue `
            -InputObject $entity `
            -Names @(
                "Mail",
                "mail",
                "Email",
                "email"
            )

        $displayName = Get-NestedPropertyValue `
            -InputObject $entity `
            -Names @(
                "DisplayName",
                "displayName",
                "FullName",
                "fullName",
                "Name",
                "name"
            )

        if ([string]::IsNullOrWhiteSpace($upn) -and $event.EntityName -and ([string]$event.EntityName) -match "@") {
            $upn = [string]$event.EntityName
        }

        if ([string]::IsNullOrWhiteSpace($upn) -and $email -and $email -match "@") {
            $upn = $email
        }

        if ([string]::IsNullOrWhiteSpace($sam) -and $upn -and $upn -match "@") {
            $sam = ($upn -split "@")[0]
        }

        if ([string]::IsNullOrWhiteSpace($sam) -and $event.EntityName -and ([string]$event.EntityName) -notmatch "@") {
            $sam = [string]$event.EntityName
        }

        if ([string]::IsNullOrWhiteSpace($upn) -and $sam) {
            $upn = "{0}@{1}" -f $sam, $DefaultUserDomain
        }

        $sam = Convert-ToCleanString $sam
        $upn = Convert-ToCleanString $upn

        if ([string]::IsNullOrWhiteSpace($sam)) {
            Write-Log ("Skipping event because samAccountName could not be resolved. EventType={0}, EntityName={1}" -f $eventType, $event.EntityName) "WARN"
            continue
        }

        if ($sam -match "\$$") {
            Write-Log ("Skipping computer/service-style identity: {0}" -f $sam) "WARN"
            continue
        }

        $candidates.Add([PSCustomObject]@{
            SamAccountName              = $sam
            UserPrincipalName           = $upn
            Email                       = Convert-ToCleanString $email
            DisplayName                 = Convert-ToCleanString $displayName
            IdentityEventTime           = [string](Convert-FromIdentityDate -Value $event.WhenOccurred)
            IdentityEventType           = $eventType
            IdentityEventAction         = $action
            IdentityEventClassification = $classification
            EntityName                  = Convert-ToCleanString $event.EntityName
            EntityUuid                  = Convert-ToCleanString $event.EntityUuid
        }) | Out-Null
    }

    $deduped = $candidates |
        Sort-Object SamAccountName, IdentityEventTime -Descending |
        Group-Object SamAccountName |
        ForEach-Object { $_.Group | Select-Object -First 1 }

    return @($deduped)
}

function Get-INDMatchingSafe {
    param(
        [Parameter(Mandatory)]$Safes,
        [Parameter(Mandatory)][string]$SamAccountName,
        [string]$IndSafePrefix = "IND_"
    )

    $escapedSam = [regex]::Escape($SamAccountName)
    $escapedPrefix = [regex]::Escape($IndSafePrefix)

    # Match IND_sam or IND_sam_*
    $pattern = "^{0}{1}($|_)" -f $escapedPrefix, $escapedSam

    $matches = @(
        $Safes |
            Where-Object { $_.SafeName -match $pattern } |
            Sort-Object SafeName
    )

    return $matches
}

function Get-SafeMember {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [string]$SamAccountName
    )

    try {
        $members = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
        $targetMember = $MemberName.ToLower()
        $targetSam = ""

        if (-not [string]::IsNullOrWhiteSpace($SamAccountName)) {
            $targetSam = $SamAccountName.ToLower()
        }

        return @(
            $members |
                Where-Object {
                    $existing = ""

                    if ($_.MemberName) {
                        $existing = $_.MemberName.ToLower()
                    }

                    ($existing -eq $targetMember) -or
                    (-not [string]::IsNullOrWhiteSpace($targetSam) -and $existing -eq $targetSam)
                } |
                Select-Object -First 1
        )
    }
    catch {
        Write-Log ("Could not retrieve members for Safe {0}. Error: {1}" -f $SafeName, $_.Exception.Message) "WARN"
        return $null
    }
}

function Invoke-PSPASCommandFiltered {
    param(
        [Parameter(Mandatory)][string]$CommandName,
        [Parameter(Mandatory)][hashtable]$Parameters
    )

    $command = Get-Command -Name $CommandName -ErrorAction Stop
    $validParameterNames = @($command.Parameters.Keys)
    $filtered = @{}

    foreach ($key in $Parameters.Keys) {
        if ($validParameterNames -contains $key) {
            $filtered[$key] = $Parameters[$key]
        }
        else {
            Write-Log ("Skipping unsupported parameter for {0}: {1}" -f $CommandName, $key) "WARN"
        }
    }

    & $CommandName @filtered
}

function Add-IndividualUserToSafe {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][hashtable]$Permissions,
        [string]$PreferredSearchIn,
        [switch]$DryRun
    )

    $splat = @{
        SafeName    = $SafeName
        MemberName  = $MemberName
        ErrorAction = "Stop"
    }

    if (-not [string]::IsNullOrWhiteSpace($PreferredSearchIn)) {
        $splat["SearchIn"] = $PreferredSearchIn
    }

    foreach ($key in $Permissions.Keys) {
        $splat[$key] = $Permissions[$key]
    }

    if ($DryRun) {
        Write-Log ("DRY RUN: Would add {0} to {1}." -f $MemberName, $SafeName)
        return
    }

    try {
        Invoke-PSPASCommandFiltered -CommandName "Add-PASSafeMember" -Parameters $splat | Out-Null
        Write-Log ("Added {0} to {1}." -f $MemberName, $SafeName) "SUCCESS"
    }
    catch {
        if ($splat.ContainsKey("SearchIn")) {
            Write-Log ("Add with SearchIn failed for {0}. Retrying without SearchIn. Error: {1}" -f $MemberName, $_.Exception.Message) "WARN"

            $splat.Remove("SearchIn")

            Invoke-PSPASCommandFiltered -CommandName "Add-PASSafeMember" -Parameters $splat | Out-Null
            Write-Log ("Added {0} to {1} without SearchIn." -f $MemberName, $SafeName) "SUCCESS"
        }
        else {
            throw
        }
    }
}

function Set-IndividualUserSafePermission {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][hashtable]$Permissions,
        [switch]$DryRun
    )

    $splat = @{
        SafeName    = $SafeName
        MemberName  = $MemberName
        ErrorAction = "Stop"
    }

    foreach ($key in $Permissions.Keys) {
        $splat[$key] = $Permissions[$key]
    }

    if ($DryRun) {
        Write-Log ("DRY RUN: Would update permissions for {0} on {1}." -f $MemberName, $SafeName)
        return
    }

    Invoke-PSPASCommandFiltered -CommandName "Set-PASSafeMember" -Parameters $splat | Out-Null
    Write-Log ("Updated permissions for {0} on {1}." -f $MemberName, $SafeName) "SUCCESS"
}

$sessionCreated = $false

try {
    Write-Log "IND Safe newly created Identity user membership sync starting."
    Write-Log ("DryRun mode: {0}" -f [bool]$DryRun)
    Write-Log ("LiveRun mode: {0}" -f [bool]$LiveRun)
    Write-Log ("LookbackDays: {0}" -f $LookbackDays)
    Write-Log ("Identity OAuth Application ID: {0}" -f $IdentityOAuthAppId)

    if ($DryRun) {
        Write-Log "Safe mode enabled. No Safe membership changes will be made."
    }
    else {
        Write-Log "Live mode enabled. Safe membership changes can be made." "WARN"
    }

    # Step 1: Retrieve API service user from CCP.
    $ccpCredential = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # Step 2: Get working Identity OAuth token using RestAPI app ID.
    $identityToken = Get-IdentityReportingToken `
        -IdentityTenantURL $IdentityTenantURL `
        -IdentityOAuthAppId $IdentityOAuthAppId `
        -ClientId $ccpCredential.UserName `
        -ClientSecret $ccpCredential.Secret `
        -Scope $OAuthScope

    if ($TokenOnly) {
        Write-Log "TokenOnly switch was used. CCP + OAuth token test completed successfully." "SUCCESS"
        return
    }

    # Step 3: Authenticate to Privilege Cloud using the same service user credential.
    Write-Log "Authenticating to Privilege Cloud using Identity Service User."

    $securePassword = ConvertTo-SecureString $ccpCredential.Secret -AsPlainText -Force
    $serviceCred = [PSCredential]::new($ccpCredential.UserName, $securePassword)

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session was not established."
    }

    $sessionCreated = $true
    Write-Log ("Authenticated to Privilege Cloud as {0}." -f $ccpCredential.UserName) "SUCCESS"

    # Step 4: Scan CyberArk Identity for newly created users.
    $newUsers = Get-NewIdentityUserCandidates `
        -IdentityTenantURL $IdentityTenantURL `
        -AccessToken $identityToken `
        -LookbackDays $LookbackDays `
        -PageSize $PageSize `
        -DefaultUserDomain $DefaultUserDomain

    if (-not $newUsers -or $newUsers.Count -eq 0) {
        Write-Log "No newly added Identity users were found in the lookback window." "WARN"
        return
    }

    Write-Log ("Validated {0} newly added Identity user candidate(s)." -f $newUsers.Count) "SUCCESS"

    # Step 5: Retrieve all Safes and filter to IND Safes.
    Write-Log "Retrieving Safes from Privilege Cloud."

    $allSafes = @(Get-PASSafe -ErrorAction Stop)

    if (-not $allSafes -or $allSafes.Count -eq 0) {
        throw "No Safes were returned by Get-PASSafe."
    }

    $indSafes = @(
        $allSafes |
            Where-Object { $_.SafeName -like "$IndSafePrefix*" }
    )

    Write-Log ("Retrieved {0} total Safe(s); {1} IND Safe(s)." -f $allSafes.Count, $indSafes.Count)

    # Step 6: Match each newly created Identity user to IND Safe and add/update membership.
    foreach ($user in $newUsers) {
        $sam = Convert-ToCleanString $user.SamAccountName
        $upn = Convert-ToCleanString $user.UserPrincipalName

        if ([string]::IsNullOrWhiteSpace($sam)) {
            Write-Log ("Skipping user because samAccountName is blank. UPN={0}" -f $upn) "WARN"

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName "" `
                -MemberName "" `
                -Action "Skip" `
                -Status "Failed" `
                -Detail "samAccountName could not be resolved." `
                -IdentityEventTime $user.IdentityEventTime `
                -IdentityEventType $user.IdentityEventType `
                -IdentityEventAction $user.IdentityEventAction `
                -IdentityEventClassification $user.IdentityEventClassification

            continue
        }

        $memberName = "{0}@{1}" -f $sam, $DefaultUserDomain

        Write-Log ("Processing newly created Identity user {0}; target Safe member {1}." -f $sam, $memberName)

        $matchingSafes = @(Get-INDMatchingSafe `
            -Safes $indSafes `
            -SamAccountName $sam `
            -IndSafePrefix $IndSafePrefix)

        if (-not $matchingSafes -or $matchingSafes.Count -eq 0) {
            Write-Log ("No matching IND Safe found for samAccountName {0}." -f $sam) "WARN"

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName "" `
                -MemberName $memberName `
                -Action "SafeLookup" `
                -Status "NoMatchingSafe" `
                -Detail "No Safe matched IND_<samAccountName> or IND_<samAccountName>_*." `
                -IdentityEventTime $user.IdentityEventTime `
                -IdentityEventType $user.IdentityEventType `
                -IdentityEventAction $user.IdentityEventAction `
                -IdentityEventClassification $user.IdentityEventClassification

            continue
        }

        if ($matchingSafes.Count -gt 1) {
            Write-Log ("Multiple IND Safes matched {0}. Using first result: {1}" -f $sam, $matchingSafes[0].SafeName) "WARN"
        }

        $targetSafe = $matchingSafes[0].SafeName

        try {
            $existingMember = Get-SafeMember `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -SamAccountName $sam

            if ($existingMember) {
                if ($UpdateExistingMember) {
                    Set-IndividualUserSafePermission `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Permissions $IndividualSafePermissions `
                        -DryRun:$DryRun

                    Add-RunResult `
                        -SamAccountName $sam `
                        -UserPrincipalName $upn `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Action "UpdateExistingMember" `
                        -Status "Success" `
                        -Detail "Member already existed; permissions were updated or would be updated in dry-run." `
                        -IdentityEventTime $user.IdentityEventTime `
                        -IdentityEventType $user.IdentityEventType `
                        -IdentityEventAction $user.IdentityEventAction `
                        -IdentityEventClassification $user.IdentityEventClassification
                }
                else {
                    Write-Log ("Member {0} already exists in Safe {1}. Skipping." -f $memberName, $targetSafe) "WARN"

                    Add-RunResult `
                        -SamAccountName $sam `
                        -UserPrincipalName $upn `
                        -SafeName $targetSafe `
                        -MemberName $memberName `
                        -Action "SkipExistingMember" `
                        -Status "Skipped" `
                        -Detail "Member already exists. Use -UpdateExistingMember to refresh permissions." `
                        -IdentityEventTime $user.IdentityEventTime `
                        -IdentityEventType $user.IdentityEventType `
                        -IdentityEventAction $user.IdentityEventAction `
                        -IdentityEventClassification $user.IdentityEventClassification
                }

                continue
            }

            Add-IndividualUserToSafe `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Permissions $IndividualSafePermissions `
                -PreferredSearchIn $PreferredSearchIn `
                -DryRun:$DryRun

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Action "AddMember" `
                -Status "Success" `
                -Detail "Member added or would be added with default individual Safe permissions." `
                -IdentityEventTime $user.IdentityEventTime `
                -IdentityEventType $user.IdentityEventType `
                -IdentityEventAction $user.IdentityEventAction `
                -IdentityEventClassification $user.IdentityEventClassification
        }
        catch {
            Write-Log ("Failed processing {0} for Safe {1}. Error: {2}" -f $memberName, $targetSafe, $_.Exception.Message) "ERROR"

            Add-RunResult `
                -SamAccountName $sam `
                -UserPrincipalName $upn `
                -SafeName $targetSafe `
                -MemberName $memberName `
                -Action "AddOrUpdateMember" `
                -Status "Failed" `
                -Detail $_.Exception.Message `
                -IdentityEventTime $user.IdentityEventTime `
                -IdentityEventType $user.IdentityEventType `
                -IdentityEventAction $user.IdentityEventAction `
                -IdentityEventClassification $user.IdentityEventClassification
        }
    }

    Write-Log "IND Safe newly created Identity user membership sync completed." "SUCCESS"
}
catch {
    Write-Log ("Fatal error: {0}" -f $_.Exception.Message) "ERROR"
}
finally {
    try {
        if ($script:RunResults.Count -gt 0) {
            $script:RunResults |
                Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

            Write-Log ("Audit CSV exported to: {0}" -f $CsvFilePath) "SUCCESS"
        }
        else {
            Write-Log "No audit rows were generated."
        }
    }
    catch {
        Write-Log ("Failed to export audit CSV: {0}" -f $_.Exception.Message) "ERROR"
    }

    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Log "Closed Privilege Cloud session." "SUCCESS"
        }
        catch {
            Write-Log ("Session close warning: {0}" -f $_.Exception.Message) "WARN"
        }
    }
}
