<#
.SYNOPSIS
    Enables CyberArk CPM Automatic Management and cancels a pending scheduled CPM task
    for AccountIDs supplied in a CSV.

.DESCRIPTION
    M&T Privilege Cloud bulk remediation helper.

    Processing order for each AccountID:
      1. Load the account by AccountID.
      2. Check secretManagement.automaticManagementEnabled.
      3. If Automatic Management is disabled, enable it and clear manualManagementReason.
      4. Re-read the account and verify Automatic Management is enabled.
      5. POST the CyberArk Cancel CPM Task request.
      6. Write a detailed result CSV.

    This script does NOT trigger Change, Verify, or Reconcile.

    Configuration pattern:
      .\.env
      .\env\dev.env
      .\env\prod.env

    The environment-specific file overrides shared .env values.

    Expected settings:
      .env:
        TENANT_ID=abq4291
        PROXY_ADDRESS=...
        PROXY_PORT=...
        SUB_DOMAIN=...

      env\dev.env / env\prod.env:
        PVWA=https://<tenant>.privilegecloud.cyberark.cloud
        PROXY=http://<proxy>:<port>

    CSV:
        AccountID
        123_456
        123_457

.NOTES
    Windows PowerShell 5.1
    No passwords or bearer tokens are written to logs or CSV reports.

.EXAMPLE
    .\Cancel-ScheduledCPMChange.ps1 -Environment dev

.EXAMPLE
    .\Cancel-ScheduledCPMChange.ps1 -Environment prod -ProxyUseDefaultCredentials

.EXAMPLE
    .\Cancel-ScheduledCPMChange.ps1 -Environment prod -CsvFile .\input\accounts.csv -ProxyUseDefaultCredentials
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    [ValidateSet('dev','prod')]
    [string]$Environment = 'dev',

    [string]$CsvFile,

    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    [switch]$ProxyUseDefaultCredentials,

    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    [string]$LogId = ''
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# Optional bootstrap proxy. Leave as Placehold when proxy is supplied in .env/dev.env/prod.env.
$proxyUri = "Placehold"

if ($proxyUri -and $proxyUri.Trim() -notmatch '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') {
    $proxy = New-Object System.Net.WebProxy($proxyUri, $true)
    [System.Net.WebRequest]::DefaultWebProxy = $proxy
    [System.Net.WebRequest]::DefaultWebProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
    [System.Net.WebRequest]::DefaultWebProxy.Address | Out-Null
}

$script:Config     = $null
$script:LogFile    = $null
$script:ReportFile = $null

function Test-BlankValue {
    param([object]$Value)

    if ($null -eq $Value) { return $true }

    $text = $Value.ToString().Trim()

    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }

    return $false
}

function Write-RunLog {
    param(
        [string]$Source,
        [string]$Message,

        [ValidateSet('DEBUG','INFO','WARN','ERROR','SUCCESS')]
        [string]$Level = 'INFO'
    )

    $line = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') | $Level | [$Source] $Message"

    if (-not [string]::IsNullOrWhiteSpace($script:LogFile)) {
        Add-Content -Path $script:LogFile -Value $line
    }

    switch ($Level) {
        'ERROR'   { Write-Host $line -ForegroundColor Red }
        'WARN'    { Write-Host $line -ForegroundColor Yellow }
        'SUCCESS' { Write-Host $line -ForegroundColor Green }
        default   { Write-Host $line }
    }
}

function Initialize-Output {
    if (-not (Test-Path $LogFolder)) {
        New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null
    }

    if (-not (Test-Path $ReportFolder)) {
        New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
    }

    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }

    $script:LogFile = Join-Path $LogFolder "Cancel-ScheduledCPMChange_$stamp$suffix.log"
    $script:ReportFile = Join-Path $ReportFolder "Cancel-ScheduledCPMChange_Report_$stamp$suffix.csv"

    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) | INFO | [Initialize] Starting run"
}

function Read-DotEnvFile {
    param([string]$Path)

    $result = @{}

    if (-not (Test-Path $Path)) {
        return $result
    }

    foreach ($line in (Get-Content -Path $Path -ErrorAction Stop)) {
        $trimmed = $line.Trim()

        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }

        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()

        if ($value.Length -ge 2) {
            if (
                ($value.StartsWith('"') -and $value.EndsWith('"')) -or
                ($value.StartsWith("'") -and $value.EndsWith("'"))
            ) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }

        if (-not (Test-BlankValue $key)) {
            $result[$key] = $value
        }
    }

    return $result
}

function Join-EnvValues {
    param([hashtable[]]$Maps)

    $merged = @{}

    foreach ($map in $Maps) {
        foreach ($key in $map.Keys) {
            $merged[$key] = $map[$key]
        }
    }

    return $merged
}

function Normalize-PvwaApiBase {
    param([string]$PvwaValue)

    if (Test-BlankValue $PvwaValue) {
        throw 'PVWA value is blank.'
    }

    $base = $PvwaValue.Trim().TrimEnd('/')

    # Normalize common values back to the PasswordVault/API root.
    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Accounts/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/Accounts/.+$', '/PasswordVault/API'

    if ($base -match '/PasswordVault/API$') {
        return $base
    }

    if ($base -match '/PasswordVault$') {
        return "$base/API"
    }

    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    param([hashtable]$Settings)

    $tenant = $Settings['TENANT_ID']

    if (Test-BlankValue $tenant) {
        throw 'TENANT_ID is missing in .env. Example: TENANT_ID=abq4291 or TENANT_ID=https://abq4291.id.cyberark.cloud'
    }

    $tenant = $tenant.Trim().TrimEnd('/')

    if ($tenant -match '^https?://') {
        return $tenant
    }

    if ($tenant -match '\.id\.cyberark\.cloud$') {
        return "https://$tenant"
    }

    if ($tenant -match '\.') {
        return "https://$tenant"
    }

    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    param([hashtable]$Settings)

    $proxy = $Settings['PROXY']

    if (-not (Test-BlankValue $proxy)) {
        return $proxy.Trim()
    }

    $proxyAddress = $Settings['PROXY_ADDRESS']

    # Retain compatibility with the typo tolerated by the existing M&T scripts.
    if (Test-BlankValue $proxyAddress) {
        $proxyAddress = $Settings['ROXY_ADDRESS']
    }

    $proxyPort = $Settings['PROXY_PORT']

    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) {
        return $null
    }

    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')

    if ($proxyAddress -notmatch '^https?://') {
        $proxyAddress = "http://$proxyAddress"
    }

    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"

    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}

    if (Test-Path $envFile1) {
        $envSpecific = Read-DotEnvFile -Path $envFile1
    }
    elseif (Test-Path $envFile2) {
        $envSpecific = Read-DotEnvFile -Path $envFile2
    }
    else {
        throw "Could not find environment file for '$Environment'. Expected $envFile1 or $envFile2"
    }

    $settings = Join-EnvValues -Maps @($base, $envSpecific)

    if (Test-BlankValue $settings['PVWA']) {
        if (Test-BlankValue $settings['SUB_DOMAIN']) {
            throw 'PVWA is missing and SUB_DOMAIN is not set. Set PVWA in dev.env/prod.env or SUB_DOMAIN in .env.'
        }

        $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud"
    }

    $identityBase = Resolve-IdentityBase -Settings $settings
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings

    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)

        if ($ProxyUseDefaultCredentials) {
            $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
        }

        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }

    $script:Config = [pscustomobject]@{
        Environment  = $Environment
        IdentityBase = $identityBase
        TokenUrl     = "$identityBase/oauth2/platformtoken"
        ApiBase      = $apiBase
        Proxy        = $proxyFromEnv
    }

    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    param([hashtable]$Body)

    $pairs = @()

    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }

    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    param([string]$Text)

    $sha = [System.Security.Cryptography.SHA256]::Create()

    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)
        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally {
        $sha.Dispose()
    }
}

function Get-WebErrorText {
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)

    $msg = $ErrorRecord.Exception.Message
    $response = $ErrorRecord.Exception.Response

    if ($null -ne $response) {
        try {
            $stream = $response.GetResponseStream()

            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)

                try {
                    $body = $reader.ReadToEnd()

                    if (-not (Test-BlankValue $body)) {
                        $msg = "$msg | Response: $body"
                    }
                }
                finally {
                    $reader.Dispose()
                }
            }
        }
        catch {
            # Preserve original message.
        }
    }

    return $msg
}

function Get-IdentityBearerToken {
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'

    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'

    if ($null -eq $credential) {
        throw 'Credential prompt was cancelled.'
    }

    $body = ConvertTo-FormBody -Body @{
        grant_type    = 'client_credentials'
        client_id     = $credential.UserName
        client_secret = $credential.GetNetworkCredential().Password
    }

    $params = @{
        Method      = 'Post'
        Uri         = $script:Config.TokenUrl
        Body        = $body
        ContentType = 'application/x-www-form-urlencoded'
        Headers     = @{ Accept = 'application/json' }
        ErrorAction = 'Stop'
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        $response = Invoke-RestMethod @params
    }
    catch {
        throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)"
    }

    if ($null -eq $response.access_token) {
        throw 'Identity token response did not include access_token.'
    }

    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token

    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'SUCCESS'

    return $token
}

function Invoke-CyberArkRest {
    param(
        [ValidateSet('GET','POST','PATCH','DELETE')]
        [string]$Method,

        [string]$Path,

        [string]$Token,

        [object]$Body = $null,

        [string]$ContentType = 'application/json'
    )

    if ($Path -match '^https?://') {
        $uri = $Path
    }
    else {
        $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))"
    }

    $params = @{
        Method      = $Method
        Uri         = $uri
        Headers     = @{
            Authorization = "Bearer $Token"
            Accept        = 'application/json'
        }
        ErrorAction = 'Stop'
    }

    if ($Method -ne 'GET' -and $Method -ne 'DELETE') {
        $params['ContentType'] = $ContentType
    }

    if ($null -ne $Body) {
        if ($Body -is [string]) {
            $params['Body'] = $Body
        }
        else {
            $params['Body'] = ConvertTo-Json -InputObject $Body -Depth 30 -Compress
        }
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        return Invoke-RestMethod @params
    }
    catch {
        throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)"
    }
}

function Select-AccountCsv {
    if (-not (Test-BlankValue $CsvFile)) {
        return $CsvFile
    }

    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop

        $dialog = New-Object System.Windows.Forms.OpenFileDialog
        $dialog.Title = 'Select CSV containing CyberArk AccountID values'
        $dialog.Filter = 'CSV files (*.csv)|*.csv|All files (*.*)|*.*'
        $dialog.Multiselect = $false

        if ($dialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) {
            throw 'CSV selection was cancelled.'
        }

        return $dialog.FileName
    }
    catch {
        throw "CsvFile was not supplied and the CSV picker could not be used. $($_.Exception.Message)"
    }
}

function Get-CsvRows {
    param([string]$Path)

    if (-not (Test-Path $Path)) {
        throw "CSV file not found: $Path"
    }

    if ((Get-Item $Path).Length -eq 0) {
        throw "CSV file is empty: $Path"
    }

    $rows = @(Import-Csv -Path $Path | Where-Object {
        ($_.PSObject.Properties.Value | Where-Object {
            $null -ne $_ -and $_.ToString().Trim().Length -gt 0
        }).Count -gt 0
    })

    if ($rows.Count -eq 0) {
        throw "CSV contains no data rows: $Path"
    }

    $first = $rows[0]
    $hasAccountId = $false

    foreach ($name in @('AccountID','Account ID','AccountId','accountId','id','ID')) {
        if ($first.PSObject.Properties[$name]) {
            $hasAccountId = $true
            break
        }
    }

    if (-not $hasAccountId) {
        throw 'CSV is missing the required AccountID column. Accepted aliases: AccountID, Account ID, AccountId, accountId, id, ID.'
    }

    return $rows
}

function Get-RowAccountId {
    param([pscustomobject]$Row)

    foreach ($name in @('AccountID','Account ID','AccountId','accountId','id','ID')) {
        $p = $Row.PSObject.Properties[$name]

        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) {
            return $p.Value.ToString().Trim()
        }
    }

    return $null
}

function Get-AccountById {
    param(
        [string]$AccountId,
        [string]$Token
    )

    $id = [System.Uri]::EscapeDataString($AccountId)
    return Invoke-CyberArkRest -Method GET -Path "Accounts/$id/" -Token $Token
}

function Enable-AutomaticManagement {
    param(
        [string]$AccountId,
        [string]$Token
    )

    $id = [System.Uri]::EscapeDataString($AccountId)

    # Same operations used by Enable-PASCPMAutoManagement.
    $operations = @(
        @{
            op    = 'replace'
            path  = '/secretManagement/automaticManagementEnabled'
            value = $true
        },
        @{
            op    = 'replace'
            path  = '/secretManagement/manualManagementReason'
            value = ''
        }
    )

    return Invoke-CyberArkRest `
        -Method PATCH `
        -Path "Accounts/$id" `
        -Token $Token `
        -Body $operations
}

function Cancel-PendingCpmTask {
    param(
        [string]$AccountId,
        [string]$Token
    )

    $id = [System.Uri]::EscapeDataString($AccountId)

    # CyberArk Cancel CPM Task route.
    return Invoke-CyberArkRest `
        -Method POST `
        -Path "Accounts/$id/Cancel/" `
        -Token $Token
}

function Get-AutomaticManagementState {
    param([object]$Account)

    if ($null -eq $Account) {
        return $null
    }

    if ($null -eq $Account.secretManagement) {
        return $null
    }

    if ($null -eq $Account.secretManagement.automaticManagementEnabled) {
        return $null
    }

    return [bool]$Account.secretManagement.automaticManagementEnabled
}

function Add-Result {
    param(
        [System.Collections.Generic.List[object]]$List,
        [string]$AccountId,
        [object]$Account,
        [string]$AutomaticManagementBefore,
        [string]$AutomaticManagementAfter,
        [string]$AutomaticManagementAction,
        [string]$CancelResult,
        [string]$OverallResult,
        [string]$ErrorMessage
    )

    $userName = ''
    $address = ''
    $safeName = ''
    $platformId = ''

    if ($null -ne $Account) {
        $userName = [string]$Account.userName
        $address = [string]$Account.address
        $safeName = [string]$Account.safeName
        $platformId = [string]$Account.platformId
    }

    $List.Add([pscustomobject]@{
        Timestamp                  = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
        Environment                = $Environment
        AccountID                  = $AccountId
        Username                   = $userName
        Address                    = $address
        SafeName                   = $safeName
        PlatformID                 = $platformId
        AutomaticManagementBefore = $AutomaticManagementBefore
        AutomaticManagementAfter  = $AutomaticManagementAfter
        AutomaticManagementAction = $AutomaticManagementAction
        CancelResult               = $CancelResult
        OverallResult              = $OverallResult
        Error                      = $ErrorMessage
    }) | Out-Null
}

# =========================
# Main
# =========================

Initialize-Output

$results = New-Object 'System.Collections.Generic.List[object]'
$token = $null
$resolvedCsv = $null

try {
    Write-RunLog 'Main' '============================================================' 'INFO'
    Write-RunLog 'Main' 'CyberArk scheduled CPM change cancellation starting.' 'INFO'
    Write-RunLog 'Main' "Environment: $Environment" 'INFO'

    Import-RunConfig

    $resolvedCsv = Select-AccountCsv
    $resolvedCsv = (Resolve-Path $resolvedCsv).Path

    Write-RunLog 'Main' "CSV path: $resolvedCsv" 'INFO'
    Write-RunLog 'Main' "Report path: $script:ReportFile" 'INFO'
    Write-RunLog 'Main' 'Action: Enable Automatic Management when required, then cancel pending CPM task.' 'INFO'
    Write-RunLog 'Main' 'The script will NOT trigger Change, Verify, or Reconcile.' 'INFO'

    $rows = Get-CsvRows -Path $resolvedCsv

    # De-duplicate AccountIDs while preserving first-seen order.
    $seen = @{}
    $accountIds = New-Object 'System.Collections.Generic.List[string]'

    foreach ($row in $rows) {
        $accountId = Get-RowAccountId -Row $row

        if (Test-BlankValue $accountId) {
            continue
        }

        $key = $accountId.ToLowerInvariant()

        if (-not $seen.ContainsKey($key)) {
            $seen[$key] = $true
            $accountIds.Add($accountId) | Out-Null
        }
    }

    if ($accountIds.Count -eq 0) {
        throw 'No usable AccountID values were found in the CSV.'
    }

    Write-RunLog 'Main' "Loaded $($accountIds.Count) unique AccountID(s)." 'INFO'

    $token = Get-IdentityBearerToken

    $index = 0

    foreach ($accountId in $accountIds) {
        $index++

        $account = $null
        $autoBefore = 'Unknown'
        $autoAfter = 'Unknown'
        $autoAction = 'NotStarted'
        $cancelResult = 'NotAttempted'
        $overall = 'Failed'
        $errorMessage = ''

        Write-RunLog 'Account' "[$index/$($accountIds.Count)] Processing AccountID=$accountId" 'INFO'

        try {
            # --------------------------------------------
            # Step 1: Retrieve account
            # --------------------------------------------
            try {
                $account = Get-AccountById -AccountId $accountId -Token $token
                Write-RunLog 'Account' "AccountID=$accountId found. UserName=$($account.userName) Safe=$($account.safeName) Platform=$($account.platformId)" 'INFO'
            }
            catch {
                throw "Account lookup failed. $($_.Exception.Message)"
            }

            # --------------------------------------------
            # Step 2: Determine CPM Automatic Management
            # --------------------------------------------
            $beforeState = Get-AutomaticManagementState -Account $account

            if ($null -eq $beforeState) {
                $autoBefore = 'Unknown'
            }
            else {
                $autoBefore = $beforeState.ToString()
            }

            # --------------------------------------------
            # Step 3: Enable Automatic Management if needed
            # --------------------------------------------
            if ($beforeState -eq $true) {
                $autoAction = 'AlreadyEnabled'
                $autoAfter = 'True'

                Write-RunLog 'CPM' "AccountID=$accountId Automatic Management already enabled." 'INFO'
            }
            else {
                Write-RunLog 'CPM' "AccountID=$accountId Automatic Management is not enabled. Enabling..." 'WARN'

                try {
                    Enable-AutomaticManagement -AccountId $accountId -Token $token | Out-Null
                    $autoAction = 'Enabled'
                    Write-RunLog 'CPM' "AccountID=$accountId Automatic Management PATCH completed." 'SUCCESS'
                }
                catch {
                    $autoAction = 'EnableFailed'
                    throw "Automatic Management enable failed. $($_.Exception.Message)"
                }

                # --------------------------------------------
                # Step 4: Verify Automatic Management
                # --------------------------------------------
                try {
                    $account = Get-AccountById -AccountId $accountId -Token $token
                    $afterState = Get-AutomaticManagementState -Account $account

                    if ($null -eq $afterState) {
                        $autoAfter = 'Unknown'
                        throw 'Automatic Management verification returned no automaticManagementEnabled state.'
                    }

                    $autoAfter = $afterState.ToString()

                    if ($afterState -ne $true) {
                        throw "Automatic Management verification failed. Current state=$autoAfter"
                    }

                    Write-RunLog 'CPM' "AccountID=$accountId Automatic Management verified enabled." 'SUCCESS'
                }
                catch {
                    throw "Automatic Management post-update verification failed. $($_.Exception.Message)"
                }
            }

            # --------------------------------------------
            # Step 5: Cancel pending CPM task
            # --------------------------------------------
            Write-RunLog 'Cancel' "AccountID=$accountId sending Cancel CPM Task request." 'INFO'

            try {
                Cancel-PendingCpmTask -AccountId $accountId -Token $token | Out-Null

                $cancelResult = 'Cancelled'
                $overall = 'Success'

                Write-RunLog 'Cancel' "AccountID=$accountId pending CPM task cancellation request succeeded." 'SUCCESS'
            }
            catch {
                $cancelResult = 'Failed'
                throw "Cancel CPM Task failed. $($_.Exception.Message)"
            }

            Add-Result `
                -List $results `
                -AccountId $accountId `
                -Account $account `
                -AutomaticManagementBefore $autoBefore `
                -AutomaticManagementAfter $autoAfter `
                -AutomaticManagementAction $autoAction `
                -CancelResult $cancelResult `
                -OverallResult $overall `
                -ErrorMessage ''
        }
        catch {
            $errorMessage = $_.Exception.Message
            Write-RunLog 'Account' "AccountID=$accountId FAILED: $errorMessage" 'ERROR'

            # Best effort final state read for reporting.
            try {
                if ($null -ne $account) {
                    $finalAccount = Get-AccountById -AccountId $accountId -Token $token
                    $account = $finalAccount

                    $finalState = Get-AutomaticManagementState -Account $account

                    if ($null -ne $finalState) {
                        $autoAfter = $finalState.ToString()
                    }
                }
            }
            catch {
                # Keep original failure.
            }

            Add-Result `
                -List $results `
                -AccountId $accountId `
                -Account $account `
                -AutomaticManagementBefore $autoBefore `
                -AutomaticManagementAfter $autoAfter `
                -AutomaticManagementAction $autoAction `
                -CancelResult $cancelResult `
                -OverallResult 'Failed' `
                -ErrorMessage $errorMessage
        }
    }
}
catch {
    Write-RunLog 'Main' "FATAL: $($_.Exception.Message)" 'ERROR'
    throw
}
finally {
    if ($results.Count -gt 0) {
        $results | Export-Csv -Path $script:ReportFile -NoTypeInformation -Encoding UTF8
    }

    $successCount = @($results | Where-Object { $_.OverallResult -eq 'Success' }).Count
    $failedCount = @($results | Where-Object { $_.OverallResult -eq 'Failed' }).Count
    $enabledCount = @($results | Where-Object { $_.AutomaticManagementAction -eq 'Enabled' }).Count
    $alreadyEnabledCount = @($results | Where-Object { $_.AutomaticManagementAction -eq 'AlreadyEnabled' }).Count

    Write-RunLog 'Summary' '============================================================' 'INFO'
    Write-RunLog 'Summary' "Processed             : $($results.Count)" 'INFO'
    Write-RunLog 'Summary' "Successful cancels    : $successCount" 'INFO'
    Write-RunLog 'Summary' "Failed                : $failedCount" 'INFO'
    Write-RunLog 'Summary' "CPM enabled by script : $enabledCount" 'INFO'
    Write-RunLog 'Summary' "CPM already enabled   : $alreadyEnabledCount" 'INFO'
    Write-RunLog 'Summary' "Report                : $script:ReportFile" 'INFO'
    Write-RunLog 'Summary' "Log                   : $script:LogFile" 'INFO'
    Write-RunLog 'Summary' 'Completed.' 'SUCCESS'

    # Do not retain the bearer token longer than necessary.
    $token = $null
}
