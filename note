#Requires -Version 5.1
<#
.SYNOPSIS
 Adds check 24 to the existing CyberArk PAM Daily Health Check ASP.NET Web Forms portal.
.DESCRIPTION
 Changes ONLY the Checks array inside Default.aspx. Does not touch existing
 evidence, records, web.config, app-pool, IIS authentication, or scheduled tasks.
 Re-running after successful patch is safe.
#>
[CmdletBinding()]
param(
    [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck'
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$aspx = Join-Path $WebRoot 'Default.aspx'
$description = 'Check Session Diagnostics and filter System Error (CyberArk Setup tile > Session Diagnostics); investigate the cause of any errors'

if (-not (Test-Path -LiteralPath $aspx -PathType Leaf)) {
    throw "Default.aspx not found at: $aspx"
}

# Encoding-preserving UTF-8 read/write: retain BOM when present. Source is ASPX/C#.
$rawBytes = [System.IO.File]::ReadAllBytes($aspx)
$hasBom = $rawBytes.Length -ge 3 -and $rawBytes[0] -eq 239 -and $rawBytes[1] -eq 187 -and $rawBytes[2] -eq 191
$utf8Strict = New-Object System.Text.UTF8Encoding($hasBom, $true)
$source = $utf8Strict.GetString($rawBytes)
$source = $source.TrimStart([char]0xFEFF)

# Locate just the static check array. Do not replace unrelated application code.
$pattern = '(?s)(private\s+static\s+readonly\s+string\[\]\s+Checks\s*=\s*new\s*\[\]\s*\{)(.*?)(\r?\n\s*\};)'
$match = [regex]::Match($source, $pattern)
if (-not $match.Success) {
    throw 'Could not uniquely locate the Checks array in Default.aspx. No files changed.'
}
if ([regex]::Matches($source, $pattern).Count -ne 1) {
    throw 'Multiple Checks arrays found. No files changed.'
}

$body = $match.Groups[2].Value
# Each item in this application is a C# string literal on its own line.
$entries = [regex]::Matches($body, '(?m)^\s*"(?:[^"\\]|\\.)*"\s*,?\s*$')
if ($body.Contains($description)) {
    Write-Host 'Session Diagnostics check already exists. No changes made.' -ForegroundColor Green
    Write-Host ("Current count: {0}" -f $entries.Count)
    exit 0
}
if ($entries.Count -ne 23) {
    throw ("Expected 23 existing checks; found {0}. Refusing to modify the portal to avoid overwriting customized items." -f $entries.Count)
}

# Add a comma to the previous last entry if absent, preserving its content.
$last = $entries[$entries.Count - 1]
$line = $last.Value
if ($line -notmatch ',\s*$') {
    $lineFixed = $line.TrimEnd() + ','
    $newBody = $body.Substring(0, $last.Index) + $lineFixed + $body.Substring($last.Index + $last.Length)
} else {
    $newBody = $body
}

$newline = if ($source.Contains("`r`n")) { "`r`n" } else { "`n" }
# Preserve indentation and line ending conventions.
$indent = ([regex]::Match($line, '^\s*')).Value
$newEntry = $newline + $indent + '"' + $description + '"'
$newBody = $newBody.TrimEnd("`r", "`n") + $newEntry

$replacement = $match.Groups[1].Value + $newBody + $match.Groups[3].Value
$updated = $source.Substring(0, $match.Index) + $replacement + $source.Substring($match.Index + $match.Length)

$updatedMatch = [regex]::Match($updated, $pattern)
$updatedEntries = [regex]::Matches($updatedMatch.Groups[2].Value, '(?m)^\s*"(?:[^"\\]|\\.)*"\s*,?\s*$')
if ($updatedEntries.Count -ne 24 -or -not $updated.Contains($description)) {
    throw 'Post-update checklist verification failed. No files changed.'
}

$backupDir = Join-Path $WebRoot 'ConfigBackups'
[void][System.IO.Directory]::CreateDirectory($backupDir)
$backup = Join-Path $backupDir ('Default.aspx.before-check24-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.bak')
Copy-Item -LiteralPath $aspx -Destination $backup -ErrorAction Stop

try {
    [System.IO.File]::WriteAllText($aspx, $updated, $utf8Strict)
    Write-Host 'SUCCESS: Check 24 added to the PAM Daily Health Check checklist.' -ForegroundColor Green
    Write-Host ('New total: {0}' -f $updatedEntries.Count)
    Write-Host ('Check 24: {0}' -f $description)
    Write-Host ('Backup: {0}' -f $backup)
    Write-Host 'Reload the page (Ctrl+F5). ASP.NET will automatically recompile Default.aspx.'
} catch {
    Copy-Item -LiteralPath $backup -Destination $aspx -Force
    throw
}
