<#
Ensure_IND_Safes_ServiceIdentity_Member.ps1

PURPOSE
- Prompt for a non-service CyberArk Identity user credential
- Log in to Alliant Privilege Cloud
- Find all safes whose names begin with IND_
- Ensure the identity user acurestapi_local@alliantcreditunion.admin
  exists on each IND_ safe with full permissions
- If already present, update permissions to the desired full permission set

OUTPUTS
- Status CSV:
  I:\Script\IDENTITY Script New\csv\IND_Safes_ServiceIdentity_Status.csv
- Log file:
  I:\Script\IDENTITY Script New\logs\Ensure_IND_Safes_ServiceIdentity.log

NOTES
- This script uses interactive Identity User authentication (not Service User / CCP)
- Requires psPAS
- Requires IdentityCommand for -IdentityUser login flow
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== Alliant Identity / Privilege Cloud =====
    [string]$IdentityTenantURL   = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL   = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== Safe selection =====
    [string]$SafePrefix          = "IND_",

    # ===== Member to enforce =====
    [string]$IdentityUserToAdd   = "acurestapi_local@alliantcreditunion.admin",
    [string]$SafeMemberSearchIn  = "Vault",
    [ValidateSet("User","Group","Role")]
    [string]$SafeMemberType      = "User",

    # ===== Output =====
    [string]$StatusCsvPath       = "I:\Script\IDENTITY Script New\csv\IND_Safes_ServiceIdentity_Status.csv",
    [string]$LogFilePath         = "I:\Script\IDENTITY Script New\logs\Ensure_IND_Safes_ServiceIdentity.log",

    # ===== API paging fallback =====
    [ValidateRange(50,2000)]
    [int]$PageSize               = 500
)

# ===== Desired full permissions =====
$FullPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $true
    DeleteAccounts                         = $true
    UnlockAccounts                         = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
    BackupSafe                             = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $true
    DeleteFolders                          = $true
    MoveAccountsAndFolders                 = $true
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}

# ===== Runtime =====
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

function Write-Err {
    param([string]$Message)
    Write-Host "❌ $Message" -ForegroundColor Red
}

function Write-Info {
    param([string]$Message)
    Write-Host "ℹ️  $Message" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Message)
    Write-Host "✅ $Message" -ForegroundColor Green
}

function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not [string]::IsNullOrWhiteSpace($Path) -and -not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Write-LogLine {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Add-Content -Path $LogFilePath -Value $line
}

function Get-PropValueCI {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$PropName
    )
    if ($null -eq $Object) { return $null }
    $p = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $PropName } | Select-Object -First 1
    if ($p) { return $p.Value }
    return $null
}

function Convert-ObjectToHashtable {
    param([Parameter(Mandatory)]$InputObject)

    $hash = @{}
    foreach ($prop in $InputObject.PSObject.Properties) {
        $hash[$prop.Name] = $prop.Value
    }
    return $hash
}

function Import-RequiredModules {
    [CmdletBinding()]
    param()

    try {
        Import-Module psPAS -ErrorAction Stop
        $pspas = Get-Module psPAS | Select-Object -First 1
        Write-LogLine "psPAS loaded successfully. Version=$($pspas.Version)" "SUCCESS"
    }
    catch {
        throw "psPAS module is required but could not be loaded. Error: $($_.Exception.Message)"
    }

    try {
        Import-Module IdentityCommand -ErrorAction Stop
        $idmod = Get-Module IdentityCommand | Select-Object -First 1
        Write-LogLine "IdentityCommand loaded successfully. Version=$($idmod.Version)" "SUCCESS"
    }
    catch {
        throw "IdentityCommand module is required for -IdentityUser authentication but could not be loaded. Error: $($_.Exception.Message)"
    }
}

function Connect-PCloudInteractive {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL
    )

    Write-Info "Prompting for interactive CyberArk Identity credential..."
    $cred = Get-Credential -Message "Enter your Alliant CyberArk Identity username and password"

    if ($null -eq $cred -or [string]::IsNullOrWhiteSpace($cred.UserName)) {
        throw "Credential prompt cancelled or no username provided."
    }

    Write-LogLine "Attempting interactive Privilege Cloud login for user '$($cred.UserName)'" "INFO"
    Write-Info "Attempting Privilege Cloud login as Identity User..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $cred `
        -IdentityUser `
        -ErrorAction Stop | Out-Null

    $sess = Get-PASSession
    if (-not $sess) {
        throw "Get-PASSession returned null after interactive login."
    }

    Write-LogLine "Interactive login successful for user '$($cred.UserName)'" "SUCCESS"
    Write-Ok "Privilege Cloud login successful as: $($cred.UserName)"

    return $cred.UserName
}

function Get-AllSafesViaAPI {
    [CmdletBinding()]
    param([int]$Limit = 500)

    $offset = 0
    $all = New-Object System.Collections.Generic.List[object]

    while ($true) {
        $uri  = "api/Safes?limit=$Limit&offset=$offset"
        $resp = Invoke-PASRestMethod -Method GET -URI $uri -ErrorAction Stop

        $items = Get-PropValueCI -Object $resp -PropName "value"
        $count = Get-PropValueCI -Object $resp -PropName "count"

        if ($null -eq $items) {
            if ($resp -is [System.Collections.IEnumerable]) { $items = $resp } else { $items = @() }
        }

        foreach ($i in $items) { $all.Add($i) | Out-Null }

        if ($null -ne $count) {
            $offset += $Limit
            if ($offset -ge [int]$count) { break }
        }
        else {
            if (($items | Measure-Object).Count -lt $Limit) { break }
            $offset += $Limit
        }
    }

    return $all.ToArray()
}

function Get-TargetINDSafes {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Prefix,
        [Parameter(Mandatory)][int]$PageSize
    )

    $safes = @()
    try {
        $safes = @(Get-PASSafe -ErrorAction Stop)
        Write-LogLine "Safes retrieved via Get-PASSafe: $($safes.Count)" "INFO"
    }
    catch {
        Write-LogLine "Get-PASSafe failed: $($_.Exception.Message)" "WARN"
        Write-LogLine "Falling back to API paging (api/Safes)..." "INFO"
        $safes = @(Get-AllSafesViaAPI -Limit $PageSize)
        Write-LogLine "Safes retrieved via API: $($safes.Count)" "INFO"
    }

    $targets = foreach ($s in $safes) {
        $safeName = Get-PropValueCI -Object $s -PropName "safeName"
        if ([string]::IsNullOrWhiteSpace($safeName)) {
            $safeName = Get-PropValueCI -Object $s -PropName "SafeName"
        }

        if (-not [string]::IsNullOrWhiteSpace($safeName) -and $safeName.StartsWith($Prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
            [PSCustomObject]@{
                SafeName = $safeName.Trim()
            }
        }
    }

    return @($targets | Sort-Object SafeName -Unique)
}

function Test-SafeMemberExists {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    try {
        $member = Get-PASSafeMember -SafeName $SafeName -MemberName $MemberName -ErrorAction Stop
        if ($null -ne $member) { return $true }
    }
    catch {
        # Fall back to listing all members if targeted lookup is not available or returns a non-fatal lookup issue
        try {
            $members = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)
            foreach ($m in $members) {
                $candidateNames = @(
                    (Get-PropValueCI -Object $m -PropName "memberName"),
                    (Get-PropValueCI -Object $m -PropName "MemberName"),
                    (Get-PropValueCI -Object $m -PropName "userName"),
                    (Get-PropValueCI -Object $m -PropName "UserName"),
                    (Get-PropValueCI -Object $m -PropName "username"),
                    (Get-PropValueCI -Object $m -PropName "Username")
                ) | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) }

                foreach ($candidate in $candidateNames) {
                    if (([string]$candidate).Trim() -ieq $MemberName) {
                        return $true
                    }
                }
            }
        }
        catch {
            throw "Unable to determine whether member '$MemberName' exists on safe '$SafeName'. Error: $($_.Exception.Message)"
        }
    }

    return $false
}

function Ensure-SafeMemberWithFullPermissions {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][string]$SearchIn,
        [Parameter(Mandatory)][string]$MemberType,
        [Parameter(Mandatory)]$PermissionObject
    )

    $permHash = Convert-ObjectToHashtable -InputObject $PermissionObject

    $exists = Test-SafeMemberExists -SafeName $SafeName -MemberName $MemberName

    if ($exists) {
        Set-PASSafeMember `
            -SafeName   $SafeName `
            -MemberName $MemberName `
            @permHash `
            -ErrorAction Stop | Out-Null

        Write-LogLine "Updated existing member '$MemberName' on safe '$SafeName' with full permissions." "SUCCESS"
        return "UPDATED"
    }
    else {
        Add-PASSafeMember `
            -SafeName   $SafeName `
            -MemberName $MemberName `
            -SearchIn   $SearchIn `
            -memberType $MemberType `
            @permHash `
            -ErrorAction Stop | Out-Null

        Write-LogLine "Added member '$MemberName' to safe '$SafeName' with full permissions." "SUCCESS"
        return "ADDED"
    }
}

# ============================
# MAIN
# ============================
$sessionCreated = $false
$statusRows = New-Object System.Collections.Generic.List[object]
$failedRows = New-Object System.Collections.Generic.List[object]

try {
    Ensure-Directory -Path (Split-Path $LogFilePath -Parent)
    Ensure-Directory -Path (Split-Path $StatusCsvPath -Parent)
    New-Item -ItemType File -Path $LogFilePath -Force | Out-Null

    Write-LogLine "Script started. SafePrefix='$SafePrefix', Member='$IdentityUserToAdd', SearchIn='$SafeMemberSearchIn', MemberType='$SafeMemberType'" "INFO"

    Import-RequiredModules
    Write-Ok "Required modules loaded successfully."

    $loggedInUser = Connect-PCloudInteractive `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL

    $sessionCreated = $true
    Write-Ok "Authentication stage completed successfully."

    $targetSafes = @(Get-TargetINDSafes -Prefix $SafePrefix -PageSize $PageSize)

    if (-not $targetSafes -or $targetSafes.Count -eq 0) {
        throw "No safes found with prefix '$SafePrefix'."
    }

    Write-Info "IND safes discovered: $($targetSafes.Count)"
    Write-LogLine "Target safes discovered with prefix '$SafePrefix': $($targetSafes.Count)" "SUCCESS"

    foreach ($safe in $targetSafes) {
        $safeName = [string]$safe.SafeName
        $memberAction = "PENDING"
        $overallStatus = "SUCCESS"
        $rowError = ""

        try {
            if ($PSCmdlet.ShouldProcess($safeName, "Ensure Safe member '$IdentityUserToAdd' with full permissions")) {
                $memberAction = Ensure-SafeMemberWithFullPermissions `
                    -SafeName         $safeName `
                    -MemberName       $IdentityUserToAdd `
                    -SearchIn         $SafeMemberSearchIn `
                    -MemberType       $SafeMemberType `
                    -PermissionObject $FullPermPAS
            }
            else {
                $memberAction = "SKIPPED"
            }
        }
        catch {
            $memberAction = "FAILED"
            $overallStatus = "FAILED"
            $rowError = $_.Exception.Message

            Write-LogLine "Failed on safe '$safeName'. Error: $rowError" "ERROR"
            Write-Err "Failed on safe '$safeName' -> $rowError"
        }

        $row = [PSCustomObject]@{
            SafeName           = $safeName
            MemberName         = $IdentityUserToAdd
            SearchIn           = $SafeMemberSearchIn
            MemberType         = $SafeMemberType
            Action             = $memberAction
            OverallStatus      = $overallStatus
            ExecutedBy         = $loggedInUser
            Timestamp          = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            Error              = $rowError
        }

        $statusRows.Add($row) | Out-Null

        if ($overallStatus -eq "FAILED") {
            $failedRows.Add($row) | Out-Null
        }
    }

    $statusRows |
        Sort-Object SafeName |
        Export-Csv -LiteralPath $StatusCsvPath -NoTypeInformation -Encoding UTF8

    Write-LogLine "Status CSV exported: $StatusCsvPath. Rows=$($statusRows.Count)" "SUCCESS"
    Write-Ok "Status CSV exported successfully: $StatusCsvPath"

    Write-Host ""
    Write-Host "Summary" -ForegroundColor Yellow
    Write-Host "-------" -ForegroundColor Yellow
    Write-Host ("IND safes reviewed : {0}" -f $targetSafes.Count) -ForegroundColor White
    Write-Host ("Rows exported      : {0}" -f $statusRows.Count) -ForegroundColor White
    Write-Host ("Failures           : {0}" -f $failedRows.Count) -ForegroundColor White

    if ($failedRows.Count -eq 0) {
        Write-Host ""
        Write-Host "All IND_ safes processed successfully." -ForegroundColor Green
    }
    else {
        Write-Host ""
        Write-Host "Failed rows:" -ForegroundColor Yellow
        $failedRows | Sort-Object SafeName | Format-Table -AutoSize
    }

    Write-LogLine "Script completed. Failures=$($failedRows.Count)" "SUCCESS"
}
catch {
    Write-LogLine "Fatal error: $($_.Exception.Message)" "ERROR"
    Write-Err $_.Exception.Message

    try {
        if ($statusRows.Count -gt 0) {
            $statusRows |
                Sort-Object SafeName |
                Export-Csv -LiteralPath $StatusCsvPath -NoTypeInformation -Encoding UTF8
            Write-LogLine "Partial status CSV exported after fatal error: $StatusCsvPath. Rows=$($statusRows.Count)" "WARN"
        }
    }
    catch {
        Write-LogLine "Failed to export partial status CSV after fatal error: $($_.Exception.Message)" "WARN"
    }
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-LogLine "Logged off PAS session." "INFO"
            Write-Info "Logged off PAS session."
        }
        catch {
            Write-LogLine "Logoff warning: $($_.Exception.Message)" "WARN"
        }
    }
}

# Pipeline-friendly failed rows
$failedRows
