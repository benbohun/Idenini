<#
Creates or replaces a daily scheduled task for the existing working
Move-DisabledAccount.ps1 script.

Run from Windows PowerShell 5.1 as Administrator.
#>

[CmdletBinding()]
param(
    [string]$TaskName = "CyberArk - Move Disabled Accounts Daily",

    [string]$ScriptPath = "I:\Script\IDENTITY Script New\Onbarding Project\Move-DisabledAccount.ps1",

    [string]$RunAsUser = "ACU\SVC_IAMCArkWinPrd",

    [ValidatePattern("^(?:[01]\d|2[0-3]):[0-5]\d$")]
    [string]$DailyAt = "02:00",

    [switch]$RunNow
)

$ErrorActionPreference = "Stop"

try {
    if (-not (Test-Path -LiteralPath $ScriptPath -PathType Leaf)) {
        throw "Working script not found: $ScriptPath"
    }

    $workingDirectory = Split-Path -Path $ScriptPath -Parent
    $powerShellExe = Join-Path $env:SystemRoot "System32\WindowsPowerShell\v1.0\powershell.exe"

    $credential = Get-Credential `
        -UserName $RunAsUser `
        -Message "Enter the password for $RunAsUser"

    if ($null -eq $credential) {
        throw "Credential entry was cancelled."
    }

    $password = $credential.GetNetworkCredential().Password

    if ([string]::IsNullOrWhiteSpace($password)) {
        throw "The supplied password is empty."
    }

    $action = New-ScheduledTaskAction `
        -Execute $powerShellExe `
        -Argument "-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File `"$ScriptPath`"" `
        -WorkingDirectory $workingDirectory

    $trigger = New-ScheduledTaskTrigger `
        -Daily `
        -At $DailyAt

    $settings = New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -MultipleInstances IgnoreNew `
        -ExecutionTimeLimit (New-TimeSpan -Hours 6)

    Register-ScheduledTask `
        -TaskName $TaskName `
        -Action $action `
        -Trigger $trigger `
        -Settings $settings `
        -Description "Runs Move-DisabledAccount.ps1 daily." `
        -User $RunAsUser `
        -Password $password `
        -RunLevel Highest `
        -Force | Out-Null

    Write-Host ""
    Write-Host "Scheduled task created successfully." -ForegroundColor Green
    Write-Host "Task Name : $TaskName"
    Write-Host "Schedule  : Daily at $DailyAt"
    Write-Host "Run As    : $RunAsUser"
    Write-Host "Script    : $ScriptPath"

    if ($RunNow) {
        Start-ScheduledTask -TaskName $TaskName
        Write-Host "Task started." -ForegroundColor Green
    }
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
finally {
    $password = $null
    $credential = $null
}
