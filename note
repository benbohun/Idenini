<#
Create_Update_IND_Safe_And_Reconcile_By_Address.ps1

PURPOSE
- Log in to Alliant Privilege Cloud using CCP -> Identity Shared Services -> ServiceUser.
- Read rows from CSV.
- Resolve IND safe name using:
    IND_<Samaccountname>_<employeeID>
- Check if Safe exists.
- If Safe does not exist:
    - Create Safe.
    - Add/validate standard Safe members.
    - Vault/onboard account.
    - Run password reconcile after onboarding.
- If Safe exists:
    - Validate Safe members first.
    - If member already exists, do not update permissions by default.
    - If member add/update fails, continue with account/platform/reconcile processing.
    - Validate whether account exists in the Safe.
    - If account does not exist, vault/onboard account and run reconcile.
    - If account exists and platform needs to change, update platform using Gen2 patch and run reconcile.

IMPORTANT PLATFORM UPDATE FIX
- Do NOT use:
    Set-PASAccount -AccountID $accountId -PlatformID $TargetPlatformID

  That binds to the Gen1 parameter set and prompts for Folder/AccountName.

- This script uses:
    Set-PASAccount -AccountID $accountId -op replace -path "/platformId" -value $TargetPlatformID

PLATFORM MAPPING
- extacu.local -> WIN_P_DM_EXT_ADM_OTP_CICO_30D
- gdeacu.com   -> WIN_P_DM_GDE_ADM_OTP_CICO_30D
- default      -> WIN_Removed

CSV TEMPLATE
Samaccountname,employeeID,email,Address,UserName,InitialPassword
gmanuel,900784,gmanuel@alliantcreditunion.com,gdeacu.com,gmanuel,
jdoe,903681,jdoe@alliantcreditunion.com,extacu.local,jdoe,
asmith,903682,asmith@alliantcreditunion.com,alliantcreditunion.com,A_asmith,

MINIMUM REQUIRED COLUMNS
Samaccountname,employeeID,Address
gmanuel,900784,gdeacu.com
jdoe,903681,extacu.local
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== CSV / Report Paths =====
    [string]$CsvPath      = "I:\Script\IDENTITY Script New\Onbarding Project\IND_Safe_Platform_Update.csv",
    [string]$ReportFolder = "I:\Script\IDENTITY Script New\logs\IND_Safe_Platform_Update",

    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== Safe Settings =====
    [string]$ManagingCPM        = "HQVECYBARK101",
    [string]$Location           = "\",
    [int]   $RetentionDays      = 7,

    # ===== Platform Settings =====
    [string]$DefaultPlatformID   = "WIN_Removed",
    [string]$ExtDomainPlatformID = "WIN_P_DM_EXT_ADM_OTP_CICO_30D",
    [string]$GdeDomainPlatformID = "WIN_P_DM_GDE_ADM_OTP_CICO_30D",

    # ===== Address Defaults =====
    [string]$DefaultAddress     = "alliantcreditunion.com",
    [string]$DefaultInitialPassword = "",

    # ===== Standard Safe Members =====
    [string]$AdminGroupUPN      = "IAM_ACU_CA_Admins@alliantcreditunion.com",
    [string]$AdminGroupSAM      = "IAM_ACU_CA_Admins",
    [switch]$SkipSafeMemberUpdate,

    # By default, existing members are only validated, not updated.
    # Use this switch only if the service account is allowed to update member permissions.
    [switch]$UpdateExistingMemberPermissions,

    # ===== Reconcile Settings =====
    [switch]$SkipReconcile,

    # ===== CCP Settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false
)

# ============================================================
# Module / TLS / Runtime Setup
# ============================================================

Import-Module psPAS -ErrorAction Stop

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Continue"

if (-not (Test-Path $ReportFolder)) {
    New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
}

$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$script:LogPath    = Join-Path $ReportFolder "IND_Safe_Platform_Update_Log_$timestamp.log"
$script:ReportPath = Join-Path $ReportFolder "IND_Safe_Platform_Update_Report_$timestamp.csv"

# ============================================================
# Logging Helpers
# ============================================================

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [Parameter()][string]$Level = "INFO",
        [Parameter()][ConsoleColor]$Color = [ConsoleColor]::White
    )

    $line = "{0} | {1} | {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message

    try {
        Add-Content -Path $script:LogPath -Value $line -Encoding UTF8
    } catch {}

    Write-Host $line -ForegroundColor $Color
}

function Write-Info($m) { Write-Log -Message $m -Level "INFO" -Color Cyan }
function Write-Ok($m)   { Write-Log -Message $m -Level "OK"   -Color Green }
function Write-Warn($m) { Write-Log -Message $m -Level "WARN" -Color Yellow }
function Write-Err($m)  { Write-Log -Message $m -Level "ERR"  -Color Red }

# ============================================================
# Utility Helpers
# ============================================================

function Test-CommandHasParameter {
    param(
        [Parameter(Mandatory)][string]$CommandName,
        [Parameter(Mandatory)][string]$ParameterName
    )

    try {
        $cmd = Get-Command $CommandName -ErrorAction Stop
        return ($cmd.Parameters.Keys | Where-Object { $_ -ieq $ParameterName } | Measure-Object).Count -gt 0
    } catch {
        return $false
    }
}

function Get-RowValue {
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        $prop = $Row.PSObject.Properties | Where-Object { $_.Name -ieq $name } | Select-Object -First 1
        if ($prop -and $null -ne $prop.Value) {
            $val = [string]$prop.Value
            if (-not [string]::IsNullOrWhiteSpace($val)) {
                return $val.Trim()
            }
        }
    }

    return ""
}

function Test-AnyHeader {
    param(
        [Parameter(Mandatory)][string[]]$Headers,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        if ($Headers | Where-Object { $_ -ieq $name }) {
            return $true
        }
    }

    return $false
}

function Normalize-Address {
    param(
        [Parameter()][string]$RawAddress
    )

    $addr = ""
    if ($RawAddress) {
        $addr = $RawAddress.Trim().ToLower()
    }

    if ([string]::IsNullOrWhiteSpace($addr)) {
        return $DefaultAddress.Trim().ToLower()
    }

    switch -Regex ($addr) {
        "^acu$"                         { return "alliantcreditunion.com" }
        "^alliant$"                     { return "alliantcreditunion.com" }
        "^alliantcreditunion$"          { return "alliantcreditunion.com" }
        "^alliantcreditunion\.com$"     { return "alliantcreditunion.com" }

        "^gde$"                         { return "gdeacu.com" }
        "^gdeacu$"                      { return "gdeacu.com" }
        "^gdeacu\.com$"                 { return "gdeacu.com" }

        "^ext$"                         { return "extacu.local" }
        "^extacu$"                      { return "extacu.local" }
        "^extacu\.local$"               { return "extacu.local" }

        default                         { return $addr }
    }
}

function Resolve-TargetPlatformID {
    param(
        [Parameter(Mandatory)][string]$Address
    )

    $normalized = Normalize-Address -RawAddress $Address

    switch ($normalized) {
        "extacu.local" { return $ExtDomainPlatformID }
        "gdeacu.com"   { return $GdeDomainPlatformID }
        default        { return $DefaultPlatformID }
    }
}

function Resolve-SafeName {
    param(
        [Parameter(Mandatory)][object]$Row
    )

    $explicitSafe = Get-RowValue -Row $Row -Names @("SafeName", "Safe", "TargetSafe")
    if (-not [string]::IsNullOrWhiteSpace($explicitSafe)) {
        return $explicitSafe
    }

    $sam = Get-RowValue -Row $Row -Names @("Samaccountname", "SamAccountName", "SAM", "OwnerSam", "OwnerSamAccountName")
    $eid = Get-RowValue -Row $Row -Names @("employeeID", "EmployeeID", "EmployeeId", "EmpID")

    if ([string]::IsNullOrWhiteSpace($sam) -or [string]::IsNullOrWhiteSpace($eid)) {
        throw "Unable to resolve SafeName. CSV must contain SafeName OR Samaccountname + employeeID."
    }

    return "IND_{0}_{1}" -f $sam.Trim(), $eid.Trim()
}

function Resolve-AccountUserName {
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string]$Address
    )

    $acctUser = Get-RowValue -Row $Row -Names @(
        "UserName",
        "Username",
        "AccountUserName",
        "AdminUserName",
        "DisabledAccount",
        "AccountName",
        "Account"
    )

    if (-not [string]::IsNullOrWhiteSpace($acctUser)) {
        return $acctUser
    }

    $sam = Get-RowValue -Row $Row -Names @("Samaccountname", "SamAccountName", "SAM", "OwnerSam", "OwnerSamAccountName")
    if ([string]::IsNullOrWhiteSpace($sam)) {
        throw "Unable to resolve account UserName. Add UserName or AccountUserName to the CSV."
    }

    if ($Address -eq "alliantcreditunion.com") {
        if ($sam -like "A_*") {
            return $sam
        }

        return "A_{0}" -f $sam
    }

    return $sam
}

function Get-PASAccountIdValue {
    param(
        [Parameter()][object]$AccountObject
    )

    if (-not $AccountObject) {
        return $null
    }

    foreach ($propName in @("id", "ID", "AccountID", "AccountId", "accountId")) {
        $p = $AccountObject.PSObject.Properties[$propName]
        if ($p -and -not [string]::IsNullOrWhiteSpace([string]$p.Value)) {
            return [string]$p.Value
        }
    }

    return $null
}

function Get-PASAccountPlatformValue {
    param(
        [Parameter()][object]$AccountObject
    )

    if (-not $AccountObject) {
        return ""
    }

    foreach ($propName in @("platformId", "PlatformID", "platformID", "PlatformId")) {
        $p = $AccountObject.PSObject.Properties[$propName]
        if ($p -and -not [string]::IsNullOrWhiteSpace([string]$p.Value)) {
            return [string]$p.Value
        }
    }

    return ""
}

