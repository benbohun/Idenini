<# 
Delete only APP_NetSecEngOps_BreakGlass_Remote accounts when a matching
NET_CiscoIOS account exists for the SAME Address and the username is one of:
bg_CAADMIN, lcl_nseo_ops. Leaves NET_CiscoIOS intact.

Requires: psPAS module (Install-Module psPAS), PowerShell 5.1+
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
  [Parameter(Mandatory=$false)]
  [string]$BaseURI = "https://alliantcredit.privilegecloud.cyberark.com",   # PVWA/PC URL (no trailing /PasswordVault)

  [Parameter(Mandatory=$false)]
  [ValidateSet('CyberArk','LDAP','RADIUS','Windows','SAML','Shared')]
  [string]$AuthType = 'CyberArk',

  [string[]]$TargetUsernames = @('bg_CAADMIN','lcl_nseo_ops'),

  [string]$PlatformApp = 'APP_NetSecEngOps_BreakGlass_Remote',
  [string]$PlatformNet = 'NET_CiscoIOS'
)

# ---------- Prep ----------
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

function Write-Info($m){ Write-Host "[*] $m" -ForegroundColor Cyan }
function Write-Ok($m){ Write-Host "[OK] $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[!] $m" -ForegroundColor Yellow }
function Write-Err($m){ Write-Host "[X] $m" -ForegroundColor Red }

# ---------- Logon ----------
$cred = Get-Credential -Message "Enter your CyberArk ($AuthType) credential"
try {
  New-PASSession -Credential $cred -BaseURI $BaseURI -Type $AuthType | Out-Null
  Write-Ok "Authenticated to $BaseURI ($AuthType)."
} catch {
  Write-Err "Authentication failed: $($_.Exception.Message)"
  return
}

try {
  # ---------- Pull candidates ----------
  Write-Info "Searching accounts for usernames: $($TargetUsernames -join ', ')"
  $all = @()
  foreach ($u in $TargetUsernames) {
    # Use Gen2 query; later filter exact username to avoid partials
    $found = Get-PASAccount -Search $u -searchType contains -ErrorAction Stop
    if ($found) {
      $exact = $found | Where-Object {
        $_.userName -eq $u -and $_.address -and $_.platformId -and
        ($_.platformId -in @($PlatformApp, $PlatformNet))
      }
      if ($exact) {
        Write-Info ("Found {0} matching accounts for '{1}'" -f $exact.Count, $u)
        $all += $exact
      } else {
        Write-Warn "No platform/address matches for '$u'"
      }
    } else {
      Write-Warn "No accounts returned for '$u'"
    }
  }

  if (-not $all -or $all.Count -eq 0) {
    Write-Warn "No matching accounts found. Nothing to do."
    return
  }

  # ---------- Group by Address + Username ----------
  $groups = $all | Group-Object -Property @{e={$_.address.ToString().ToLower()}}, @{e={$_.userName}}

  $deleteQueue = @()
  foreach ($g in $groups) {
    $items = $g.Group
    $hasNET = $items | Where-Object { $_.platformId -eq $PlatformNet }
    $hasAPP = $items | Where-Object { $_.platformId -eq $PlatformApp }

    if ($hasNET.Count -ge 1 -and $hasAPP.Count -ge 1) {
      # enqueue ONLY the APP accounts for deletion
      foreach ($a in $hasAPP) {
        $desc = "User='$($a.userName)' Address='$($a.address)' Platform='$($a.platformId)' Safe='$($a.safeName)' Id=$($a.id)"
        Write-Info "Will delete APP entry (matching NET exists): $desc"
        $deleteQueue += $a
      }
    }
  }

  if (-not $deleteQueue -or $deleteQueue.Count -eq 0) {
    Write-Ok "Rule not met anywhere (no APP entries with matching NET on same address)."
    return
  }

  # ---------- Delete APP accounts (respect -WhatIf/Confirm) ----------
  foreach ($acct in $deleteQueue) {
    $display = "[$($acct.userName)] $($acct.address) | $($acct.platformId) | Safe=$($acct.safeName) | Id=$($acct.id)"
    if ($PSCmdlet.ShouldProcess($display, "Remove-PASAccount")) {
      try {
        Remove-PASAccount -AccountID $acct.id -Confirm:$false
        Write-Ok "Deleted $display"
      } catch {
        Write-Err "Failed to delete $display : $($_.Exception.Message)"
      }
    }
  }

} finally {
  # ---------- Logoff ----------
  try { Close-PASSession | Out-Null; Write-Ok "Logged off." } catch { Write-Warn "Logoff warning: $($_.Exception.Message)" }
}
