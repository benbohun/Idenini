#requires -Version 5.1
<#
PAM Daily Health Check: descriptive filenames for NEW uploads.
Does not rename existing evidence or modify web.config/IIS/authentication.
Updates the upload filename and download filename validation together.
#>
[CmdletBinding()]
param([string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck')
$ErrorActionPreference = 'Stop'
$file = Join-Path $WebRoot 'Default.aspx'
if (-not (Test-Path -LiteralPath $file -PathType Leaf)) { throw "Missing application file: $file" }
$backupRoot = 'C:\ProgramData\PAMDailyHealthCheck\ConfigBackups'
New-Item -Path $backupRoot -ItemType Directory -Force | Out-Null
$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$backup = Join-Path $backupRoot ("Default-before-evidence-names-$stamp.aspx")
Copy-Item -LiteralPath $file -Destination $backup -ErrorAction Stop
$enc = New-Object System.Text.UTF8Encoding($false)
$source = [System.IO.File]::ReadAllText($file)
$oldSave = 'saved=id.ToString("00")+"_"+Guid.NewGuid().ToString("N")+ext;'
$newSave = @'
// Human-readable filename; retain a unique identifier to prevent collisions.
            string descriptiveName=System.Text.RegularExpressions.Regex.Replace(Checks[id-1], @"[^A-Za-z0-9]+", "-").Trim('-');
            if(descriptiveName.Length>75) descriptiveName=descriptiveName.Substring(0,75).TrimEnd('-');
            saved=id.ToString("00")+"_"+descriptiveName+"_"+Guid.NewGuid().ToString("N")+ext;
'@.TrimEnd()
$oldRegex = '@"^\d{2}_[0-9a-f]{32}\.docx?$"'
$newRegex = '@"^\d{2}_(?:[A-Za-z0-9-]{1,75}_)?[0-9a-f]{32}\.docx?$"'
if ($source.Contains($newRegex) -and $source.Contains('string descriptiveName=')) {
    Write-Host 'Descriptive evidence naming is already installed.' -ForegroundColor Green
    exit 0
}
if (-not $source.Contains($oldSave)) { throw "Expected upload filename logic was not found. No changes made. Backup: $backup" }
if (-not $source.Contains($oldRegex)) { throw "Expected download filename validation was not found. No changes made. Backup: $backup" }
$updated = $source.Replace($oldSave,$newSave).Replace($oldRegex,$newRegex)
if ($updated -eq $source -or -not $updated.Contains($newRegex) -or -not $updated.Contains('string descriptiveName=')) { throw 'Patch verification failed. No changes made.' }
$tmp = "$file.$stamp.tmp"
try {
    [System.IO.File]::WriteAllText($tmp,$updated,$enc)
    # Validate replacement without touching other application features.
    $verify = [System.IO.File]::ReadAllText($tmp)
    if (-not $verify.Contains($newRegex) -or -not $verify.Contains($newSave)) { throw 'Staged file verification failed.' }
    Copy-Item -LiteralPath $tmp -Destination $file -Force -ErrorAction Stop
    Write-Host "SUCCESS: New evidence filenames will include check description." -ForegroundColor Green
    Write-Host "Application page: $file"
    Write-Host "Backup: $backup"
    Write-Host 'Existing records and files were left unchanged. Existing evidence links remain valid.'
    Write-Host 'Example: 01_Verify-and-change-password-for-g-test-pam1-confirm-both-operations-succeed_<GUID>.docx'
} catch {
    Copy-Item -LiteralPath $backup -Destination $file -Force -ErrorAction SilentlyContinue
    throw
} finally { Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue }
