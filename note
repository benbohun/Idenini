<#
Test_SWS_TokenGeneration_Only_V4_PS51.ps1

Purpose
- Token-generation-only diagnostic for CyberArk Secure Web Sessions (SWS) public API service account.
- Does NOT create Identity apps.
- Does NOT update Identity apps.
- Does NOT call SWS policy-copy/update APIs unless -ValidateAgainstSwsApi is used.
- PowerShell 5.1 compatible: avoids ProcessStartInfo.ArgumentList.

What it tests
1. Finds java.exe.
2. Finds CyberArk public-api-auth-helper*.jar.
3. Finds SWS service-account JSON.
4. Runs the helper JAR with tenant ID and JSON.
5. Confirms whether an access_token was returned.
6. Optionally validates the token with GET /sws/policies.

Security
- Token is masked in logs.
- Raw token is printed only when -ShowToken is used.
- Raw token is saved only when -SaveTokenToFile is used.
#>

[CmdletBinding()]
param(
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',

    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',

    [string]$SwsAuthHelperJarPath = '',

    [string]$SwsServiceAccountJsonPath = '',

    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',

    [switch]$ValidateAgainstSwsApi,

    [switch]$ShowToken,

    [switch]$SaveTokenToFile,

    # Optional Java HTTPS proxy for the helper JAR, example: http://proxy.company.com:8080
    [string]$ProxyAddress = '',

    [int]$TimeoutSeconds = 90,

    [string]$LogPath = ''
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

function Get-ScriptRootSafe {
    if (-not [string]::IsNullOrWhiteSpace($PSScriptRoot)) { return $PSScriptRoot }
    if ($MyInvocation.MyCommand.Path) { return (Split-Path -Path $MyInvocation.MyCommand.Path -Parent) }
    return (Get-Location).Path
}

$script:ScriptRoot = Get-ScriptRootSafe
if ([string]::IsNullOrWhiteSpace($LogPath)) {
    $LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only.log'
}

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) { New-Item -Path $parent -ItemType Directory -Force | Out-Null }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Normalize-TenantId {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return '' }
    $v = $Value.Trim()
    if ($v -match '^https?://([^./]+)\.') { return $Matches[1] }
    return $v
}

function Add-UniqueString {
    param(
        [System.Collections.ArrayList]$List,
        [string]$Value
    )
    if ([string]::IsNullOrWhiteSpace($Value)) { return }
    $v = $Value.Trim()
    if (-not $List.Contains($v)) { [void]$List.Add($v) }
}

function Mask-Secret {
    param([string]$Secret)
    if ([string]::IsNullOrWhiteSpace($Secret)) { return '<empty>' }
    $s = $Secret.Trim()
    if ($s.Length -le 16) { return ('*' * $s.Length) }
    return ($s.Substring(0, 10) + '...' + $s.Substring($s.Length - 6))
}

function ConvertFrom-Base64UrlString {
    param([Parameter(Mandatory)][string]$InputString)
    $s = $InputString.Replace('-', '+').Replace('_', '/')
    switch ($s.Length % 4) {
        2 { $s += '==' }
        3 { $s += '=' }
        1 { throw 'Invalid base64url string length.' }
    }
    return [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($s))
}

function Show-JwtSummary {
    param([Parameter(Mandatory)][string]$Token)
    try {
        $parts = $Token.Split('.')
        if ($parts.Count -lt 2) {
            Write-Log 'Token is not in JWT format, so JWT header/payload summary was skipped.' 'Yellow'
            return
        }
        $headerJson = ConvertFrom-Base64UrlString -InputString $parts[0]
        $payloadJson = ConvertFrom-Base64UrlString -InputString $parts[1]
        $header = $headerJson | ConvertFrom-Json
        $payload = $payloadJson | ConvertFrom-Json

        $alg = ''
        $typ = ''
        $kid = ''
        try { $alg = [string]$header.alg } catch {}
        try { $typ = [string]$header.typ } catch {}
        try { $kid = [string]$header.kid } catch {}

        $iss = ''
        $sub = ''
        $aud = ''
        $exp = ''
        $iat = ''
        try { $iss = [string]$payload.iss } catch {}
        try { $sub = [string]$payload.sub } catch {}
        try { $aud = [string]$payload.aud } catch {}
        try { $exp = [string]$payload.exp } catch {}
        try { $iat = [string]$payload.iat } catch {}

        Write-Log ("JWT header summary: alg={0}; typ={1}; kid={2}" -f $alg, $typ, $kid) 'Gray'
        Write-Log ("JWT payload summary: iss={0}; sub={1}; aud={2}; iat={3}; exp={4}" -f $iss, $sub, $aud, $iat, $exp) 'Gray'
    } catch {
        Write-Log ("Could not decode JWT summary: {0}" -f $_.Exception.Message) 'Yellow'
    }
}

function Find-JavaExe {
    if (-not [string]::IsNullOrWhiteSpace($SwsJavaPath)) {
        $candidate = $SwsJavaPath
        if (-not [System.IO.Path]::IsPathRooted($candidate)) { $candidate = Join-Path $script:ScriptRoot $candidate }
        if (Test-Path $candidate) { return (Resolve-Path $candidate).Path }
        throw "Specified -SwsJavaPath was not found: $SwsJavaPath"
    }

    $candidates = @(
        (Join-Path $script:ScriptRoot 'java.exe'),
        (Join-Path $script:ScriptRoot 'java\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jre\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jdk\bin\java.exe')
    )

    foreach ($c in $candidates) {
        if (Test-Path $c) { return (Resolve-Path $c).Path }
    }

    $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
    if ($cmd -and $cmd.Source) { return $cmd.Source }

    throw 'java.exe was not found. Pass -SwsJavaPath with the full path to java.exe.'
}

function Resolve-ExistingPath {
    param(
        [string]$PathValue,
        [string]$Description
    )
    if ([string]::IsNullOrWhiteSpace($PathValue)) { return '' }
    $candidate = $PathValue.Trim()
    if (-not [System.IO.Path]::IsPathRooted($candidate)) { $candidate = Join-Path $script:ScriptRoot $candidate }
    if (-not (Test-Path $candidate)) { throw "$Description was not found: $PathValue" }
    return (Resolve-Path $candidate).Path
}

function Find-HelperJar {
    $explicit = Resolve-ExistingPath -PathValue $SwsAuthHelperJarPath -Description 'SWS auth helper JAR'
    if ($explicit) { return $explicit }

    $jars = @(Get-ChildItem -Path $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) { throw 'No public-api-auth-helper*.jar file was found beside the script.' }
    if ($jars.Count -gt 1) {
        Write-Log 'Multiple helper JAR files were found. The newest one will be used. Pass -SwsAuthHelperJarPath to force a specific file.' 'Yellow'
        foreach ($j in $jars) { Write-Log ("  JAR candidate: {0}; LastWriteTime={1}" -f $j.Name, $j.LastWriteTime) 'Gray' }
    }
    return $jars[0].FullName
}

function Test-IsLikelySwsServiceAccountJson {
    param([Parameter(Mandatory)][string]$Path)
    try {
        $raw = Get-Content -Path $Path -Raw -ErrorAction Stop
        $json = $raw | ConvertFrom-Json -ErrorAction Stop
        $hasServiceAccountId = $false
        $hasPrivateKey = $false
        $hasDiscovery = $false
        foreach ($p in $json.PSObject.Properties) {
            if ($p.Name -match '^(serviceAccountId|service_account_id|clientId|client_id)$') { $hasServiceAccountId = $true }
            if ($p.Name -match '^(privateKey|private_key)$') { $hasPrivateKey = $true }
            if ($p.Name -match '^(discoveryURI|discoveryUri|discovery_url|discoveryUrl)$') { $hasDiscovery = $true }
        }
        return ($hasServiceAccountId -and $hasPrivateKey -and $hasDiscovery)
    } catch { return $false }
}

function Get-JsonFieldValue {
    param(
        [Parameter(Mandatory)]$JsonObject,
        [Parameter(Mandatory)][string[]]$Names
    )
    foreach ($name in $Names) {
        if ($JsonObject.PSObject.Properties.Name -contains $name) {
            $v = [string]$JsonObject.$name
            if (-not [string]::IsNullOrWhiteSpace($v)) { return $v.Trim() }
        }
    }
    return ''
}

function Find-ServiceAccountJson {
    $explicit = Resolve-ExistingPath -PathValue $SwsServiceAccountJsonPath -Description 'SWS service-account JSON'
    if ($explicit) { return $explicit }

    $allJson = @(Get-ChildItem -Path $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($allJson.Count -eq 0) { throw 'No .json files were found beside the script.' }

    $valid = New-Object System.Collections.ArrayList
    foreach ($f in $allJson) {
        if (Test-IsLikelySwsServiceAccountJson -Path $f.FullName) { [void]$valid.Add($f) }
    }

    if ($valid.Count -eq 0) {
        Write-Log 'JSON files were found, but none looked like an SWS service-account JSON file.' 'Red'
        foreach ($j in $allJson) { Write-Log ("  JSON candidate: {0}; LastWriteTime={1}" -f $j.Name, $j.LastWriteTime) 'Gray' }
        throw 'No valid SWS service-account JSON file found.'
    }

    if ($valid.Count -gt 1) {
        Write-Log 'Multiple SWS service-account JSON files were found. The newest one will be used. Pass -SwsServiceAccountJsonPath to force a specific file.' 'Yellow'
        foreach ($j in $valid) { Write-Log ("  SWS JSON candidate: {0}; LastWriteTime={1}" -f $j.Name, $j.LastWriteTime) 'Gray' }
    }

    return $valid[0].FullName
}

function Invoke-ExternalProcess {
    param(
        [Parameter(Mandatory)][string]$FilePath,
        [Parameter(Mandatory)][string]$Arguments,
        [int]$TimeoutSeconds = 90,
        [string]$WorkingDirectory = ''
    )

    $stdoutFile = [System.IO.Path]::GetTempFileName()
    $stderrFile = [System.IO.Path]::GetTempFileName()

    try {
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = $FilePath
        $psi.Arguments = $Arguments
        $psi.UseShellExecute = $false
        $psi.RedirectStandardOutput = $true
        $psi.RedirectStandardError = $true
        $psi.CreateNoWindow = $true
        if (-not [string]::IsNullOrWhiteSpace($WorkingDirectory)) { $psi.WorkingDirectory = $WorkingDirectory }

        $p = New-Object System.Diagnostics.Process
        $p.StartInfo = $psi

        $stdOutBuilder = New-Object System.Text.StringBuilder
        $stdErrBuilder = New-Object System.Text.StringBuilder

        $outHandler = [System.Diagnostics.DataReceivedEventHandler]{
            param($sender, $eventArgs)
            if ($null -ne $eventArgs.Data) { [void]$stdOutBuilder.AppendLine($eventArgs.Data) }
        }
        $errHandler = [System.Diagnostics.DataReceivedEventHandler]{
            param($sender, $eventArgs)
            if ($null -ne $eventArgs.Data) { [void]$stdErrBuilder.AppendLine($eventArgs.Data) }
        }

        $p.add_OutputDataReceived($outHandler)
        $p.add_ErrorDataReceived($errHandler)

        [void]$p.Start()
        $p.BeginOutputReadLine()
        $p.BeginErrorReadLine()

        $finished = $p.WaitForExit($TimeoutSeconds * 1000)
        if (-not $finished) {
            try { $p.Kill() } catch {}
            return [pscustomobject]@{
                ExitCode = 9999
                StdOut   = $stdOutBuilder.ToString()
                StdErr   = $stdErrBuilder.ToString()
                TimedOut = $true
            }
        }

        # Give async readers a moment to flush.
        Start-Sleep -Milliseconds 100
        return [pscustomobject]@{
            ExitCode = $p.ExitCode
            StdOut   = $stdOutBuilder.ToString()
            StdErr   = $stdErrBuilder.ToString()
            TimedOut = $false
        }
    }
    finally {
        try { Remove-Item -Path $stdoutFile -Force -ErrorAction SilentlyContinue } catch {}
        try { Remove-Item -Path $stderrFile -Force -ErrorAction SilentlyContinue } catch {}
    }
}

function Escape-ForJavaArg {
    param([string]$Value)
    if ($null -eq $Value) { return '""' }
    return ('"' + ($Value -replace '"','\"') + '"')
}

function Get-JavaProxyArguments {
    if ([string]::IsNullOrWhiteSpace($ProxyAddress)) { return '' }
    try {
        $u = [Uri]$ProxyAddress
        if ([string]::IsNullOrWhiteSpace($u.Host) -or $u.Port -le 0) {
            throw 'ProxyAddress must include host and port.'
        }
        return ('-Dhttps.proxyHost={0} -Dhttps.proxyPort={1} -Dhttp.proxyHost={0} -Dhttp.proxyPort={1}' -f $u.Host, $u.Port)
    } catch {
        throw "Invalid -ProxyAddress '$ProxyAddress'. Use format like http://proxy.company.com:8080. Error: $($_.Exception.Message)"
    }
}

function Extract-AccessTokenFromText {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return '' }

    # JSON output style: {"access_token":"..."}
    try {
        $trimmed = $Text.Trim()
        if ($trimmed.StartsWith('{') -or $trimmed.StartsWith('[')) {
            $obj = $trimmed | ConvertFrom-Json -ErrorAction Stop
            if ($obj.access_token) { return ([string]$obj.access_token).Trim() }
            if ($obj.accessToken) { return ([string]$obj.accessToken).Trim() }
            if ($obj.Result -and $obj.Result.access_token) { return ([string]$obj.Result.access_token).Trim() }
        }
    } catch {}

    # Line output style: access_token: abc or access_token=abc or "access_token" : "abc"
    $patterns = @(
        '"access_token"\s*:\s*"(?<token>[^"]+)"',
        'access_token\s*[:=]\s*(?<token>\S+)',
        'AccessToken\s*[:=]\s*(?<token>\S+)',
        'accessToken\s*[:=]\s*(?<token>\S+)'
    )

    foreach ($pattern in $patterns) {
        $m = [regex]::Match($Text, $pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
        if ($m.Success) { return $m.Groups['token'].Value.Trim().Trim('"') }
    }

    return ''
}

function Invoke-HelperTokenGeneration {
    param(
        [Parameter(Mandatory)][string]$JavaPath,
        [Parameter(Mandatory)][string]$JarPath,
        [Parameter(Mandatory)][string]$JsonPath,
        [Parameter(Mandatory)][string[]]$TenantCandidates
    )

    $proxyArgs = Get-JavaProxyArguments
    $lastErrors = New-Object System.Collections.ArrayList

    $attempt = 0
    foreach ($tenant in $TenantCandidates) {
        $attempt++
        $tenantSafe = $tenant.Trim()
        Write-Log ("Helper token attempt #{0}: TenantId={1}" -f $attempt, $tenantSafe) 'Cyan'

        $args = ''
        if (-not [string]::IsNullOrWhiteSpace($proxyArgs)) { $args += $proxyArgs + ' ' }
        $args += ('-jar {0} -t {1} -p {2}' -f (Escape-ForJavaArg $JarPath), (Escape-ForJavaArg $tenantSafe), (Escape-ForJavaArg $JsonPath))

        $result = Invoke-ExternalProcess -FilePath $JavaPath -Arguments $args -TimeoutSeconds $TimeoutSeconds -WorkingDirectory $script:ScriptRoot
        $combined = (($result.StdOut + [Environment]::NewLine + $result.StdErr).Trim())
        $token = Extract-AccessTokenFromText -Text $combined

        $rawOutPath = Join-Path $script:ScriptRoot ("SWS_Helper_Attempt_{0}_Output.txt" -f $attempt)
        try { Set-Content -Path $rawOutPath -Value $combined -Force } catch {}

        if (-not [string]::IsNullOrWhiteSpace($token)) {
            Write-Log ("SUCCESS: Helper returned access_token on attempt #{0}. ExitCode={1}; MaskedToken={2}" -f $attempt, $result.ExitCode, (Mask-Secret $token)) 'Green'
            Write-Log ("Raw helper output saved to: {0}" -f $rawOutPath) 'Gray'
            return [pscustomobject]@{
                Success  = $true
                Token    = $token
                TenantId = $tenantSafe
                Output   = $combined
                ExitCode = $result.ExitCode
            }
        }

        $shortOutput = $combined
        if ($shortOutput.Length -gt 1500) { $shortOutput = $shortOutput.Substring(0, 1500) + ' ...<truncated>' }
        Write-Log ("Helper did not return access_token. Attempt={0}; ExitCode={1}; OutputFile={2}" -f $attempt, $result.ExitCode, $rawOutPath) 'Yellow'
        Write-Log ("Helper output preview: {0}" -f ($shortOutput -replace "[\r\n]+", ' | ')) 'Yellow'
        [void]$lastErrors.Add(("Attempt={0}; TenantId={1}; ExitCode={2}; OutputFile={3}" -f $attempt, $tenantSafe, $result.ExitCode, $rawOutPath))
    }

    return [pscustomobject]@{
        Success  = $false
        Token    = ''
        TenantId = ''
        Output   = ($lastErrors -join ' || ')
        ExitCode = 1
    }
}

function Test-SwsApiToken {
    param([Parameter(Mandatory)][string]$Token)

    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    Write-Log ("Validating token with GET {0}" -f $uri) 'Cyan'

    $headers = @{
        Authorization = "Bearer $Token"
        Accept        = 'application/json'
    }

    try {
        $resp = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        Write-Log 'SUCCESS: SWS API validation GET succeeded.' 'Green'
        return $true
    } catch {
        $status = ''
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log ("SWS API validation GET failed. Status={0}; Error={1}" -f $status, $_.Exception.Message) 'Red'
        return $false
    }
}

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V4 Started =====' 'Cyan'
    Write-Log ("ScriptRoot={0}" -f $script:ScriptRoot) 'Gray'
    Write-Log ("LogPath={0}" -f $LogPath) 'Gray'

    $java = Find-JavaExe
    Write-Log ("Testing Java executable: {0}" -f $java) 'Cyan'
    $javaVersion = Invoke-ExternalProcess -FilePath $java -Arguments '-version' -TimeoutSeconds 20 -WorkingDirectory $script:ScriptRoot
    $javaCombined = (($javaVersion.StdOut + [Environment]::NewLine + $javaVersion.StdErr).Trim())
    if ($javaVersion.ExitCode -ne 0) {
        throw ("java -version failed. ExitCode={0}; Output={1}" -f $javaVersion.ExitCode, ($javaCombined -replace "[\r\n]+", ' | '))
    }
    Write-Log ("Java version output: {0}" -f ($javaCombined -replace "[\r\n]+", ' | ')) 'Green'

    $jar = Find-HelperJar
    Write-Log ("Using helper JAR: {0}" -f $jar) 'Green'

    $jsonPath = Find-ServiceAccountJson
    Write-Log ("Using SWS service-account JSON: {0}" -f $jsonPath) 'Green'

    $jsonRaw = Get-Content -Path $jsonPath -Raw -ErrorAction Stop
    $jsonObj = $jsonRaw | ConvertFrom-Json -ErrorAction Stop
    $serviceAccountId = Get-JsonFieldValue -JsonObject $jsonObj -Names @('serviceAccountId','service_account_id','clientId','client_id')
    $discoveryUri = Get-JsonFieldValue -JsonObject $jsonObj -Names @('discoveryURI','discoveryUri','discovery_url','discoveryUrl')
    Write-Log ("JSON summary: ServiceAccountId={0}; DiscoveryURI={1}" -f $serviceAccountId, $discoveryUri) 'Gray'

    $tenantList = New-Object System.Collections.ArrayList
    $rawTenant = Normalize-TenantId -Value $SwsTenantId
    Add-UniqueString -List $tenantList -Value $rawTenant
    if ($rawTenant -match '-') { Add-UniqueString -List $tenantList -Value ($rawTenant -replace '-', '') }
    if ($rawTenant -notmatch '-' -and $rawTenant.Length -eq 32) {
        $withDashes = $rawTenant.Substring(0,8) + '-' + $rawTenant.Substring(8,4) + '-' + $rawTenant.Substring(12,4) + '-' + $rawTenant.Substring(16,4) + '-' + $rawTenant.Substring(20)
        Add-UniqueString -List $tenantList -Value $withDashes
    }

    Write-Log ("Tenant candidate count={0}; Candidates={1}" -f $tenantList.Count, ($tenantList -join ', ')) 'Gray'

    $result = Invoke-HelperTokenGeneration -JavaPath $java -JarPath $jar -JsonPath $jsonPath -TenantCandidates ([string[]]$tenantList.ToArray([string]))

    if (-not $result.Success -or [string]::IsNullOrWhiteSpace($result.Token)) {
        Write-Log 'TOKEN GENERATION FAILED: helper did not return access_token.' 'Red'
        Write-Log ("Failure detail: {0}" -f $result.Output) 'Red'
        throw 'CyberArk helper did not generate an access_token. Review SWS_Helper_Attempt_*_Output.txt files and verify JSON/service account/tenant pairing.'
    }

    Write-Log 'TOKEN GENERATION SUCCESS.' 'Green'
    Write-Log ("WinningTenantId={0}" -f $result.TenantId) 'Green'
    Write-Log ("AccessTokenLength={0}; MaskedToken={1}" -f $result.Token.Length, (Mask-Secret $result.Token)) 'Green'
    Show-JwtSummary -Token $result.Token

    if ($SaveTokenToFile) {
        $tokenFile = Join-Path $script:ScriptRoot 'SWS_access_token.txt'
        Set-Content -Path $tokenFile -Value $result.Token -Force
        Write-Log ("Raw token saved to: {0}" -f $tokenFile) 'Yellow'
    }

    if ($ShowToken) {
        Write-Host ''
        Write-Host '===== RAW ACCESS TOKEN START =====' -ForegroundColor Yellow
        Write-Host $result.Token
        Write-Host '===== RAW ACCESS TOKEN END =====' -ForegroundColor Yellow
        Write-Host ''
    }

    if ($ValidateAgainstSwsApi) {
        $ok = Test-SwsApiToken -Token $result.Token
        if (-not $ok) { throw 'Token was generated, but SWS API validation failed.' }
    }

    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V4 Finished: SUCCESS =====' 'Green'
    exit 0
}
catch {
    Write-Log ("FATAL ERROR: {0}" -f $_.Exception.Message) 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V4 Finished: FAILED =====' 'Red'
    exit 1
}
