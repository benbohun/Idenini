<#
.SYNOPSIS
    CNA Privilege Cloud Group-to-Safe and Safe-to-Account Report

.DESCRIPTION
    One-time, report-only script that:
      - Authenticates to CNA Privilege Cloud using CCP + psPAS Identity Header.
      - Reads a CSV containing CyberArk/Identity/AD group names.
      - Finds every Safe where each supplied group is a Safe member.
      - Determines whether each matched Safe contains vaulted accounts.
      - Exports a group-to-Safe summary, account-level details, and Safe read errors.

    The script does not add, update, move, or delete any Safe, member, or account.

.CSV FORMAT
    Recommended:

        GroupName
        CA_Example_Group@cna.com
        CA_Another_Group@cna.com

    Accepted group column names:
        GroupName, Group, ADGroup, ADGroupName, MemberName, Member, Name

    If the CSV has only one column, that column is used automatically.

.NOTES
    PowerShell 5.1 compatible.
    Requires:
      - psPAS
      - IdentityCommand (Get-IdentityHeader)
      - Safe permissions required to list Safe members
      - List Accounts permission on matched Safes to determine account presence
#>

[CmdletBinding()]
param(
    # ===== Input CSV =====
    [string]$GroupCsvPath = '',
    [string]$GroupColumnName = '',

    # Allows CSV value "CA_Group" to match Safe member "CA_Group@cna.com"
    # or "CNA\CA_Group". Exact full-name matching is always attempted first.
    [bool]$AllowShortNameMatch = $true,

    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings CNA =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Account query =====
    # psPAS uses this as the page size and follows paging links.
    [ValidateRange(1, 1000)]
    [int]$AccountPageSize      = 1000,

    # ===== Output paths =====
    [string]$OutputFolder      = 'E:\Installation Media\Script\OnboardScript\data',
    [string]$SummaryCsvName    = 'GroupSafeAccountSummary.csv',
    [string]$AccountCsvName    = 'GroupSafeAccountDetails.csv',
    [string]$ErrorCsvName      = 'GroupSafeAccountErrors.csv',
    [string]$LogFileName       = 'GroupSafeAccountReport.log'
)

# ============================================
# Runtime Settings
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ============================================
# Paths
# ============================================

if (-not (Test-Path -LiteralPath $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
}

$LogFile        = Join-Path $OutputFolder $LogFileName
$SummaryCsvPath = Join-Path $OutputFolder $SummaryCsvName
$AccountCsvPath = Join-Path $OutputFolder $AccountCsvName
$ErrorCsvPath   = Join-Path $OutputFolder $ErrorCsvName

New-Item -ItemType File -Force -Path $LogFile | Out-Null

# ============================================
# Logger
# ============================================

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$timestamp - $Message"

    Write-Host $line -ForegroundColor $Color
    Add-Content -LiteralPath $LogFile -Value $line
}

# ============================================
# Helper: Select input CSV
# ============================================

function Select-InputCsv {
    param(
        [string]$InitialPath
    )

    if (-not [string]::IsNullOrWhiteSpace($InitialPath)) {
        return $InitialPath.Trim().Trim('"')
    }

    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop

        $dialog = New-Object System.Windows.Forms.OpenFileDialog
        $dialog.Title = 'Select the CSV containing group names'
        $dialog.Filter = 'CSV files (*.csv)|*.csv|All files (*.*)|*.*'
        $dialog.Multiselect = $false
        $dialog.CheckFileExists = $true

        if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            return $dialog.FileName
        }
    } catch {
        Write-Log ("GUI file selection was unavailable. {0}" -f $_.Exception.Message) 'Yellow'
    }

    return (Read-Host 'Enter the full path to the group CSV').Trim().Trim('"')
}

# ============================================
# Helper: Normalize Identity Tenant URL
# ============================================

function Get-NormalizedIdentityTenant {
    param(
        [Parameter(Mandatory = $true)]
        [string]$TenantUrl
    )

    $normalized = $TenantUrl.Trim()

    if ($normalized -notmatch '^https?://') {
        $normalized = "https://$normalized"
    }

    return $normalized.TrimEnd('/')
}

# ============================================
# Helper: Safely get object property
# ============================================

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory = $true)]
        [object]$InputObject,

        [Parameter(Mandatory = $true)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propertyName in $PropertyNames) {
        $property = $InputObject.PSObject.Properties |
            Where-Object { $_.Name.Equals($propertyName, [System.StringComparison]::OrdinalIgnoreCase) } |
            Select-Object -First 1

        if ($null -ne $property) {
            return $property.Value
        }
    }

    return $null
}

# ============================================
# Helper: Normalize member/group name
# ============================================

function Get-NormalizedNameInfo {
    param(
        [AllowNull()]
        [string]$Name
    )

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return [PSCustomObject]@{
            Display  = ''
            FullKey  = ''
            ShortKey = ''
        }
    }

    $display = $Name.Trim().Trim('"').Trim("'")
    $fullKey = $display.ToLowerInvariant()
    $shortName = $display

    # DOMAIN\Group -> Group
    if ($shortName.Contains('\')) {
        $shortName = $shortName.Substring($shortName.LastIndexOf('\') + 1)
    }

    # Group@domain -> Group
    if ($shortName.Contains('@')) {
        $shortName = $shortName.Substring(0, $shortName.IndexOf('@'))
    }

    return [PSCustomObject]@{
        Display  = $display
        FullKey  = $fullKey
        ShortKey = $shortName.Trim().ToLowerInvariant()
    }
}

# ============================================
# Helper: Resolve CSV group column
# ============================================

function Resolve-GroupColumn {
    param(
        [Parameter(Mandatory = $true)]
        [object]$FirstRow,

        [string]$RequestedColumn
    )

    $headers = @($FirstRow.PSObject.Properties.Name)

    if (-not [string]::IsNullOrWhiteSpace($RequestedColumn)) {
        $matchedRequestedColumn = $headers |
            Where-Object { $_.Equals($RequestedColumn, [System.StringComparison]::OrdinalIgnoreCase) } |
            Select-Object -First 1

        if ($matchedRequestedColumn) {
            return $matchedRequestedColumn
        }

        throw "Requested group column '$RequestedColumn' was not found. CSV headers: $($headers -join ', ')"
    }

    $acceptedColumns = @(
        'GroupName',
        'Group',
        'ADGroup',
        'ADGroupName',
        'MemberName',
        'Member',
        'Name'
    )

    foreach ($acceptedColumn in $acceptedColumns) {
        $matchedColumn = $headers |
            Where-Object { $_.Equals($acceptedColumn, [System.StringComparison]::OrdinalIgnoreCase) } |
            Select-Object -First 1

        if ($matchedColumn) {
            return $matchedColumn
        }
    }

    if ($headers.Count -eq 1) {
        return $headers[0]
    }

    throw "Could not determine the group column. Use -GroupColumnName. CSV headers: $($headers -join ', ')"
}

# ============================================
# Helper: Add item to lookup table list
# ============================================

function Add-LookupItem {
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$Lookup,

        [Parameter(Mandatory = $true)]
        [string]$Key,

        [Parameter(Mandatory = $true)]
        [object]$Item
    )

    if ([string]::IsNullOrWhiteSpace($Key)) {
        return
    }

    if (-not $Lookup.ContainsKey($Key)) {
        $Lookup[$Key] = New-Object System.Collections.ArrayList
    }

    [void]$Lookup[$Key].Add($Item)
}

# ============================================
# Helper: Find matching input groups for a member
# ============================================

function Get-MatchingInputGroups {
    param(
        [Parameter(Mandatory = $true)]
        [string]$MemberName,

        [Parameter(Mandatory = $true)]
        [hashtable]$ExactLookup,

        [Parameter(Mandatory = $true)]
        [hashtable]$ShortLookup,

        [bool]$UseShortNameMatch
    )

    $memberInfo = Get-NormalizedNameInfo -Name $MemberName
    $matches = New-Object System.Collections.Generic.List[object]
    $seen = @{}

    if ($ExactLookup.ContainsKey($memberInfo.FullKey)) {
        foreach ($groupRecord in $ExactLookup[$memberInfo.FullKey]) {
            $dedupeKey = [string]$groupRecord.RecordID

            if (-not $seen.ContainsKey($dedupeKey)) {
                $matches.Add([PSCustomObject]@{
                    GroupRecord = $groupRecord
                    MatchType   = 'ExactFullName'
                })
                $seen[$dedupeKey] = $true
            }
        }
    }

    # Short-name matching is only used when no exact input match was found.
    if (($matches.Count -eq 0) -and $UseShortNameMatch -and -not [string]::IsNullOrWhiteSpace($memberInfo.ShortKey)) {
        if ($ShortLookup.ContainsKey($memberInfo.ShortKey)) {
            foreach ($groupRecord in $ShortLookup[$memberInfo.ShortKey]) {
                $dedupeKey = [string]$groupRecord.RecordID

                if (-not $seen.ContainsKey($dedupeKey)) {
                    $matches.Add([PSCustomObject]@{
                        GroupRecord = $groupRecord
                        MatchType   = 'ShortName'
                    })
                    $seen[$dedupeKey] = $true
                }
            }
        }
    }

    return @($matches)
}

# ============================================
# Import psPAS
# ============================================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $psPASModule = Get-Module psPAS

    if ($psPASModule) {
        Write-Log ("psPAS module loaded. Version: {0}" -f $psPASModule.Version) 'Green'
    } else {
        Write-Log 'psPAS module loaded.' 'Green'
    }
} catch {
    Write-Log ("ERROR: Failed to import psPAS module. {0}" -f $_.Exception.Message) 'Red'
    throw
}

if (-not (Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue)) {
    Write-Log 'ERROR: Get-IdentityHeader was not found. Confirm the IdentityCommand module is installed.' 'Red'
    throw 'Get-IdentityHeader cmdlet not found.'
}

if (-not (Get-Command Get-PASSafe -ErrorAction SilentlyContinue)) {
    throw 'Get-PASSafe cmdlet not found.'
}

if (-not (Get-Command Get-PASSafeMember -ErrorAction SilentlyContinue)) {
    throw 'Get-PASSafeMember cmdlet not found.'
}

if (-not (Get-Command Get-PASAccount -ErrorAction SilentlyContinue)) {
    throw 'Get-PASAccount cmdlet not found.'
}

# ============================================
# Login Method: CCP + psPAS Identity Header
# ============================================

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory = $true)]
        [string]$ObjectName
    )

    $headers = @{
        'Content-Type' = 'application/json'
    }

    $ccpUrl = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"
    $response = $null
    $securePassword = $null

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $response = Invoke-RestMethod `
            -Uri $ccpUrl `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        if (-not $response -or -not $response.Content) {
            throw 'Empty CCP response or missing Content field.'
        }

        $resolvedUser = Get-ObjectPropertyValue -InputObject $response -PropertyNames @('Username', 'UserName')

        if ([string]::IsNullOrWhiteSpace([string]$resolvedUser)) {
            throw 'CCP returned a password but no Username/UserName field.'
        }

        Write-Log ("Successfully retrieved CCP credential for user: {0}" -f $resolvedUser) 'Green'

        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL
        $securePassword = ConvertTo-SecureString ([string]$response.Content) -AsPlainText -Force
        $credential = New-Object System.Management.Automation.PSCredential ([string]$resolvedUser, $securePassword)

        Write-Log ("Requesting CyberArk PAS authentication using psPAS Identity header as {0}..." -f $resolvedUser) 'Cyan'
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'
        Write-Log ("Privilege Cloud Subdomain: {0}" -f $PCloudSubdomain) 'Gray'

        $identityHeader = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $identityHeader | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session was not established.'
        }

        Write-Log ("Authentication successful. PAS session established as {0}." -f $resolvedUser) 'Green'
        return [string]$resolvedUser
    } catch {
        Write-Log ("ERROR: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
        throw
    } finally {
        if ($null -ne $response -and $response.PSObject.Properties.Name -contains 'Content') {
            $response.Content = $null
        }

        if ($null -ne $securePassword) {
            $securePassword.Dispose()
        }
    }
}

# ============================================
# Helper: Retrieve accounts from a Safe
# ============================================

function Get-SafeAccountResult {
    param(
        [Parameter(Mandatory = $true)]
        [string]$SafeName
    )

    try {
        $getAccountCommand = Get-Command Get-PASAccount -ErrorAction Stop

        if ($getAccountCommand.Parameters.ContainsKey('limit')) {
            $accounts = @(Get-PASAccount -safeName $SafeName -limit $AccountPageSize -ErrorAction Stop)
        } else {
            $accounts = @(Get-PASAccount -safeName $SafeName -ErrorAction Stop)
        }

        return [PSCustomObject]@{
            Status       = 'Success'
            Accounts     = $accounts
            AccountCount = $accounts.Count
            HasAccounts  = ($accounts.Count -gt 0)
            ErrorMessage = ''
        }
    } catch {
        return [PSCustomObject]@{
            Status       = 'Failed'
            Accounts     = @()
            AccountCount = $null
            HasAccounts  = $null
            ErrorMessage = $_.Exception.Message
        }
    }
}

# ============================================
# Start Script
# ============================================

Write-Log '============================================================' 'Gray'
Write-Log 'CNA Group-to-Safe and Safe-to-Account report started.' 'Cyan'
Write-Log ("Identity Tenant URL : {0}" -f $IdentityTenantURL) 'Gray'
Write-Log ("Privilege Cloud URL : {0}" -f $PrivilegeCloudURL) 'Gray'
Write-Log ("PCloud Subdomain    : {0}" -f $PCloudSubdomain) 'Gray'
Write-Log ("CCP Address         : {0}" -f $CCPAddress) 'Gray'
Write-Log ("CCP AppID           : {0}" -f $CCPAppID) 'Gray'
Write-Log ("CCP Safe            : {0}" -f $CCPSafe) 'Gray'
Write-Log ("CCP Object          : {0}" -f $CCPObject) 'Gray'
Write-Log ("Output Folder       : {0}" -f $OutputFolder) 'Gray'
Write-Log '============================================================' 'Gray'

# ============================================
# Read Input CSV
# ============================================

try {
    $GroupCsvPath = Select-InputCsv -InitialPath $GroupCsvPath

    if ([string]::IsNullOrWhiteSpace($GroupCsvPath)) {
        throw 'No group CSV was selected.'
    }

    if (-not (Test-Path -LiteralPath $GroupCsvPath -PathType Leaf)) {
        throw "CSV file was not found: $GroupCsvPath"
    }

    Write-Log ("Importing group CSV: {0}" -f $GroupCsvPath) 'Yellow'

    $inputRows = @(Import-Csv -LiteralPath $GroupCsvPath -ErrorAction Stop)

    if ($inputRows.Count -eq 0) {
        throw 'The group CSV contains no data rows.'
    }

    $resolvedGroupColumn = Resolve-GroupColumn -FirstRow $inputRows[0] -RequestedColumn $GroupColumnName
    Write-Log ("Using CSV group column: {0}" -f $resolvedGroupColumn) 'Green'

    $groupByFullName = @{}
    $rowNumber = 1

    foreach ($row in $inputRows) {
        $rowNumber++
        $rawGroupName = [string](Get-ObjectPropertyValue -InputObject $row -PropertyNames @($resolvedGroupColumn))
        $nameInfo = Get-NormalizedNameInfo -Name $rawGroupName

        if ([string]::IsNullOrWhiteSpace($nameInfo.FullKey)) {
            Write-Log ("WARNING: CSV row {0} has an empty group value and was skipped." -f $rowNumber) 'Yellow'
            continue
        }

        if ($groupByFullName.ContainsKey($nameInfo.FullKey)) {
            $groupByFullName[$nameInfo.FullKey].DuplicateInputCount++
            $groupByFullName[$nameInfo.FullKey].SourceRows += ";$rowNumber"
            continue
        }

        $groupByFullName[$nameInfo.FullKey] = [PSCustomObject]@{
            RecordID            = [guid]::NewGuid().Guid
            InputGroup          = $nameInfo.Display
            FullKey             = $nameInfo.FullKey
            ShortKey            = $nameInfo.ShortKey
            FirstSourceRow      = $rowNumber
            SourceRows          = [string]$rowNumber
            DuplicateInputCount = 1
        }
    }

    $groupRecords = @($groupByFullName.Values | Sort-Object InputGroup)

    if ($groupRecords.Count -eq 0) {
        throw 'No valid group names were found in the CSV.'
    }

    Write-Log ("Loaded {0} unique group(s) from {1} CSV row(s)." -f $groupRecords.Count, $inputRows.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to load group CSV. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# Build exact and short-name lookup tables.
$exactGroupLookup = @{}
$shortGroupLookup = @{}

foreach ($groupRecord in $groupRecords) {
    Add-LookupItem -Lookup $exactGroupLookup -Key $groupRecord.FullKey -Item $groupRecord
    Add-LookupItem -Lookup $shortGroupLookup -Key $groupRecord.ShortKey -Item $groupRecord
}

# ============================================
# Authenticate
# ============================================

try {
    $AuthenticatedUser = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    Write-Log ("FATAL: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve All Safes
# ============================================

try {
    Write-Log 'Retrieving all visible Safes...' 'Yellow'
    $Safes = @(Get-PASSafe -ErrorAction Stop)
    Write-Log ("Retrieved {0} Safe(s)." -f $Safes.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to retrieve Safes. {0}" -f $_.Exception.Message) 'Red'

    try {
        Close-PASSession | Out-Null
    } catch {
    }

    exit 1
}

# ============================================
# Prepare Reports and Caches
# ============================================

$SummaryReport = New-Object System.Collections.Generic.List[object]
$AccountReport = New-Object System.Collections.Generic.List[object]
$ErrorReport   = New-Object System.Collections.Generic.List[object]

$matchedGroupRecordIDs = @{}
$membershipSeen        = @{}
$accountCache          = @{}

$totalSafes          = $Safes.Count
$currentSafeIndex    = 0
$safeMemberReadOK    = 0
$safeMemberReadFail  = 0
$matchedSafeCount    = 0

# ============================================
# Scan Safe Memberships
# ============================================

foreach ($Safe in $Safes) {
    $currentSafeIndex++

    $SafeName = [string](Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @(
        'safeName',
        'SafeName',
        'Safe',
        'Name'
    ))

    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        $errorMessage = 'Could not resolve the Safe name from the returned object.'
        Write-Log ("[{0}/{1}] WARNING: {2}" -f $currentSafeIndex, $totalSafes, $errorMessage) 'Yellow'

        $ErrorReport.Add([PSCustomObject]@{
            SafeName     = ''
            Operation    = 'ResolveSafeName'
            ErrorMessage = $errorMessage
        })

        continue
    }

    Write-Log ("[{0}/{1}] Reading members for Safe: {2}" -f $currentSafeIndex, $totalSafes, $SafeName) 'Cyan'

    try {
        $safeMembers = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)
        $safeMemberReadOK++
    } catch {
        $safeMemberReadFail++
        $errorMessage = $_.Exception.Message

        Write-Log ("ERROR: Could not retrieve members for Safe '{0}'. {1}" -f $SafeName, $errorMessage) 'Red'

        $ErrorReport.Add([PSCustomObject]@{
            SafeName     = $SafeName
            Operation    = 'GetSafeMembers'
            ErrorMessage = $errorMessage
        })

        continue
    }

    $safeMatches = New-Object System.Collections.Generic.List[object]
    $safeMatchSeen = @{}

    foreach ($member in $safeMembers) {
        $memberName = [string](Get-ObjectPropertyValue -InputObject $member -PropertyNames @(
            'MemberName',
            'memberName',
            'UserName',
            'username',
            'Name',
            'name'
        ))

        if ([string]::IsNullOrWhiteSpace($memberName)) {
            continue
        }

        $memberType = [string](Get-ObjectPropertyValue -InputObject $member -PropertyNames @(
            'MemberType',
            'memberType',
            'Type',
            'type'
        ))

        $inputMatches = @(Get-MatchingInputGroups `
            -MemberName $memberName `
            -ExactLookup $exactGroupLookup `
            -ShortLookup $shortGroupLookup `
            -UseShortNameMatch $AllowShortNameMatch)

        foreach ($inputMatch in $inputMatches) {
            $groupRecord = $inputMatch.GroupRecord
            $membershipKey = ('{0}|{1}' -f $groupRecord.RecordID, $SafeName.ToLowerInvariant())

            if ($safeMatchSeen.ContainsKey($membershipKey)) {
                continue
            }

            $safeMatches.Add([PSCustomObject]@{
                GroupRecord = $groupRecord
                MatchedMember = $memberName
                MemberType = $memberType
                MatchType = $inputMatch.MatchType
            })

            $safeMatchSeen[$membershipKey] = $true
        }
    }

    if ($safeMatches.Count -eq 0) {
        continue
    }

    $matchedSafeCount++
    Write-Log ("Safe '{0}' matched {1} input group(s). Checking accounts..." -f $SafeName, $safeMatches.Count) 'Yellow'

    $safeCacheKey = $SafeName.ToLowerInvariant()

    if (-not $accountCache.ContainsKey($safeCacheKey)) {
        $accountCache[$safeCacheKey] = Get-SafeAccountResult -SafeName $SafeName
    }

    $accountResult = $accountCache[$safeCacheKey]

    if ($accountResult.Status -eq 'Success') {
        Write-Log ("Safe '{0}' contains {1} account(s)." -f $SafeName, $accountResult.AccountCount) 'Green'
    } else {
        Write-Log ("WARNING: Account lookup failed for Safe '{0}'. {1}" -f $SafeName, $accountResult.ErrorMessage) 'Yellow'

        $ErrorReport.Add([PSCustomObject]@{
            SafeName     = $SafeName
            Operation    = 'GetSafeAccounts'
            ErrorMessage = $accountResult.ErrorMessage
        })
    }

    foreach ($safeMatch in $safeMatches) {
        $groupRecord = $safeMatch.GroupRecord
        $globalMembershipKey = ('{0}|{1}' -f $groupRecord.RecordID, $SafeName.ToLowerInvariant())

        if ($membershipSeen.ContainsKey($globalMembershipKey)) {
            continue
        }

        $membershipSeen[$globalMembershipKey] = $true
        $matchedGroupRecordIDs[[string]$groupRecord.RecordID] = $true

        $status = switch ($accountResult.Status) {
            'Failed' { 'MatchedSafeAccountLookupFailed' }
            default {
                if ($accountResult.HasAccounts) {
                    'MatchedSafeHasAccounts'
                } else {
                    'MatchedSafeNoAccounts'
                }
            }
        }

        $SummaryReport.Add([PSCustomObject]@{
            InputGroup          = $groupRecord.InputGroup
            InputSourceRows     = $groupRecord.SourceRows
            DuplicateInputCount = $groupRecord.DuplicateInputCount
            MatchedMember       = $safeMatch.MatchedMember
            MemberType          = $safeMatch.MemberType
            MatchType           = $safeMatch.MatchType
            SafeName            = $SafeName
            IsSafeMember        = $true
            HasAccounts         = $accountResult.HasAccounts
            AccountCount        = $accountResult.AccountCount
            AccountLookupStatus = $accountResult.Status
            Status              = $status
            ErrorMessage        = $accountResult.ErrorMessage
        })

        if ($accountResult.Status -eq 'Success' -and $accountResult.AccountCount -gt 0) {
            foreach ($account in $accountResult.Accounts) {
                $accountID = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('id', 'ID', 'AccountID')
                $accountName = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('name', 'Name', 'AccountName')
                $userName = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('userName', 'UserName', 'username')
                $address = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('address', 'Address')
                $platformID = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('platformId', 'PlatformID', 'platformID')
                $accountSafeName = Get-ObjectPropertyValue -InputObject $account -PropertyNames @('safeName', 'SafeName')

                if ([string]::IsNullOrWhiteSpace([string]$accountSafeName)) {
                    $accountSafeName = $SafeName
                }

                $AccountReport.Add([PSCustomObject]@{
                    InputGroup      = $groupRecord.InputGroup
                    MatchedMember   = $safeMatch.MatchedMember
                    MatchType       = $safeMatch.MatchType
                    SafeName        = $accountSafeName
                    AccountID       = $accountID
                    AccountName     = $accountName
                    UserName        = $userName
                    Address         = $address
                    PlatformID      = $platformID
                })
            }
        }
    }
}

# ============================================
# Add Unmatched Groups
# ============================================

foreach ($groupRecord in $groupRecords) {
    if ($matchedGroupRecordIDs.ContainsKey([string]$groupRecord.RecordID)) {
        continue
    }

    $SummaryReport.Add([PSCustomObject]@{
        InputGroup          = $groupRecord.InputGroup
        InputSourceRows     = $groupRecord.SourceRows
        DuplicateInputCount = $groupRecord.DuplicateInputCount
        MatchedMember       = ''
        MemberType          = ''
        MatchType           = ''
        SafeName            = ''
        IsSafeMember        = $false
        HasAccounts         = $null
        AccountCount        = $null
        AccountLookupStatus = 'NotApplicable'
        Status              = 'NoSafeMembershipFound'
        ErrorMessage        = ''
    })
}

# ============================================
# Export Reports
# ============================================

try {
    $SummaryReport |
        Sort-Object InputGroup, SafeName |
        Export-Csv -LiteralPath $SummaryCsvPath -NoTypeInformation -Encoding UTF8

    Write-Log ("Summary report exported: {0}" -f $SummaryCsvPath) 'Green'
} catch {
    Write-Log ("FATAL: Failed to export summary report. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

try {
    # Export a valid header-only file when no account detail rows exist.
    if ($AccountReport.Count -gt 0) {
        $AccountReport |
            Sort-Object InputGroup, SafeName, AccountName |
            Export-Csv -LiteralPath $AccountCsvPath -NoTypeInformation -Encoding UTF8
    } else {
        @([PSCustomObject]@{
            InputGroup    = ''
            MatchedMember = ''
            MatchType     = ''
            SafeName      = ''
            AccountID     = ''
            AccountName   = ''
            UserName      = ''
            Address       = ''
            PlatformID    = ''
        }) |
            Export-Csv -LiteralPath $AccountCsvPath -NoTypeInformation -Encoding UTF8

        # Remove the placeholder data row, retaining only the header.
        $content = Get-Content -LiteralPath $AccountCsvPath
        if ($content.Count -gt 0) {
            Set-Content -LiteralPath $AccountCsvPath -Value $content[0] -Encoding UTF8
        }
    }

    Write-Log ("Account detail report exported: {0}" -f $AccountCsvPath) 'Green'
} catch {
    Write-Log ("FATAL: Failed to export account detail report. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

try {
    if ($ErrorReport.Count -gt 0) {
        $ErrorReport |
            Sort-Object SafeName, Operation |
            Export-Csv -LiteralPath $ErrorCsvPath -NoTypeInformation -Encoding UTF8
    } else {
        @([PSCustomObject]@{
            SafeName     = ''
            Operation    = ''
            ErrorMessage = ''
        }) |
            Export-Csv -LiteralPath $ErrorCsvPath -NoTypeInformation -Encoding UTF8

        $content = Get-Content -LiteralPath $ErrorCsvPath
        if ($content.Count -gt 0) {
            Set-Content -LiteralPath $ErrorCsvPath -Value $content[0] -Encoding UTF8
        }
    }

    Write-Log ("Error report exported: {0}" -f $ErrorCsvPath) 'Green'
} catch {
    Write-Log ("ERROR: Failed to export error report. {0}" -f $_.Exception.Message) 'Red'
}

# ============================================
# Close Session
# ============================================

try {
    Close-PASSession | Out-Null
    Write-Log 'PAS session closed.' 'Gray'
} catch {
    Write-Log ("WARNING: Could not close PAS session cleanly. {0}" -f $_.Exception.Message) 'Yellow'
}

# ============================================
# Completion
# ============================================

$matchedGroupCount = @($groupRecords | Where-Object {
    $matchedGroupRecordIDs.ContainsKey([string]$_.RecordID)
}).Count

$unmatchedGroupCount = $groupRecords.Count - $matchedGroupCount
$matchedMembershipRows = @($SummaryReport | Where-Object { $_.IsSafeMember -eq $true }).Count
$matchedSafesWithAccounts = @($SummaryReport |
    Where-Object { $_.Status -eq 'MatchedSafeHasAccounts' } |
    Select-Object -ExpandProperty SafeName -Unique).Count
$matchedSafesWithoutAccounts = @($SummaryReport |
    Where-Object { $_.Status -eq 'MatchedSafeNoAccounts' } |
    Select-Object -ExpandProperty SafeName -Unique).Count
$accountLookupFailedSafes = @($SummaryReport |
    Where-Object { $_.Status -eq 'MatchedSafeAccountLookupFailed' } |
    Select-Object -ExpandProperty SafeName -Unique).Count

Write-Log '============================================================' 'Gray'
Write-Log 'CNA Group-to-Safe and Safe-to-Account report completed.' 'Green'
Write-Log ("Authenticated User             : {0}" -f $AuthenticatedUser) 'Gray'
Write-Log ("Unique Input Groups            : {0}" -f $groupRecords.Count) 'Gray'
Write-Log ("Groups Matched to a Safe       : {0}" -f $matchedGroupCount) 'Green'
Write-Log ("Groups With No Safe Match      : {0}" -f $unmatchedGroupCount) 'Yellow'
Write-Log ("Group-to-Safe Membership Rows  : {0}" -f $matchedMembershipRows) 'Gray'
Write-Log ("Total Safes Scanned            : {0}" -f $totalSafes) 'Gray'
Write-Log ("Safe Member Reads Successful   : {0}" -f $safeMemberReadOK) 'Green'
Write-Log ("Safe Member Reads Failed       : {0}" -f $safeMemberReadFail) 'Red'
Write-Log ("Matched Safes With Accounts    : {0}" -f $matchedSafesWithAccounts) 'Green'
Write-Log ("Matched Safes Without Accounts : {0}" -f $matchedSafesWithoutAccounts) 'Yellow'
Write-Log ("Account Lookup Failed Safes    : {0}" -f $accountLookupFailedSafes) 'Red'
Write-Log ("Summary Report                 : {0}" -f $SummaryCsvPath) 'Gray'
Write-Log ("Account Detail Report          : {0}" -f $AccountCsvPath) 'Gray'
Write-Log ("Error Report                   : {0}" -f $ErrorCsvPath) 'Gray'
Write-Log ("Log File                       : {0}" -f $LogFile) 'Gray'
Write-Log '============================================================' 'Gray'
