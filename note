<#
.SYNOPSIS
    Disables CyberArk Automatic Password Management for accounts listed by AccountID.

.DESCRIPTION
    This utility is intended for accounts showing messages such as:
        "The password for this account has been manually scheduled for change"

    Research finding:
      - ResetImmediately=ChangeTask is an internal CyberArk/CPM property.
      - In Privilege Cloud v10 account APIs, internal properties are not normal platformAccountProperties.
      - There is no supported Privilege Cloud REST endpoint found to directly cancel/delete ResetImmediately.

    Therefore, this script does the supported safe action:
      - Reads each account by AccountID.
      - Disables Automatic Password Management on the account.
      - Does not retrieve the password.
      - Does not call Change, Verify, Reconcile, SetNextPassword, or Delete.
      - Does not try to remove ResetImmediately as a platform property.

    The script uses multiple PATCH shapes because some CyberArk tenants/versions respond differently:
      1. Replace the whole /secretManagement object.
      2. Replace /secretManagement/automaticManagementEnabled only.
      3. Replace /secretManagement/manualManagementReason only, optional.

.NOTES
    Designed for Windows PowerShell 5.1.
    CSV requires only AccountID.
    If the account is already inProcess and CPM has picked up the ChangeTask, there may be no REST API cancel.
    In that case, the script records IN_PROCESS_RETRY_LATER or PATCH_FAILED and does not mask the failure.
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    [string]$CsvFile = (Join-Path $PSScriptRoot 'samples\clear-scheduled-change-template.csv'),

    [ValidateSet('dev','prod')]
    [string]$Environment = 'dev',

    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    [switch]$Execute,

    [ValidateSet('NO','YES')]
    [string]$ConfirmClear = 'NO',

    [string]$DisableReason = 'Manual scheduled password change cleanup: Automatic Password Management disabled to prevent CPM from processing a pending ChangeTask.',

    # Optional. Some tenants reject manualManagementReason updates while the account has an active CPM task.
    # By default, the script first tries disabling AMD without touching the reason.
    [switch]$SetManualManagementReason,

    # Optional. If the account is checked out/locked, this attempts a check-in before the AMD PATCH.
    [switch]$TryCheckInBeforePatch,

    [switch]$ProxyUseDefaultCredentials,

    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    [string]$LogId = ''
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$proxyUri = 'Placehold'
if ($proxyUri -and $proxyUri.Trim() -notmatch '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') {
    $proxy = New-Object System.Net.WebProxy($proxyUri, $true)
    [System.Net.WebRequest]::DefaultWebProxy = $proxy
    [System.Net.WebRequest]::DefaultWebProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
    [System.Net.WebRequest]::DefaultWebProxy.Address | Out-Null
}

$script:Config = $null
$script:LogFile = $null
$script:ReportFile = $null
$script:ChangedReportFile = $null

function Test-BlankValue {
    param([object]$Value)
    if ($null -eq $Value) { return $true }
    $text = $Value.ToString().Trim()
    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }
    return $false
}

function New-RunLog {
    if (-not (Test-Path $LogFolder)) { New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null }
    if (-not (Test-Path $ReportFolder)) { New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null }
    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }
    $script:LogFile = Join-Path $LogFolder "Clear-ScheduledPasswordChange_$stamp$suffix.log"
    $script:ReportFile = Join-Path $ReportFolder "Clear-ScheduledPasswordChange_Report_$stamp$suffix.csv"
    $script:ChangedReportFile = Join-Path $ReportFolder "Clear-ScheduledPasswordChange_Changed_$stamp$suffix.csv"
    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) source=New-RunLog [INFO] Starting run"
}

function Write-RunLog {
    param(
        [string]$Source,
        [string]$Message,
        [ValidateSet('DEBUG','INFO','WARN','ERROR')]
        [string]$Level = 'INFO'
    )
    $line = "$(Get-Date -Format s) source=$Source [$Level] $Message"
    Add-Content -Path $script:LogFile -Value $line
    if ($Level -eq 'ERROR') { Write-Host $line -ForegroundColor Red }
    elseif ($Level -eq 'WARN') { Write-Host $line -ForegroundColor Yellow }
    else { Write-Host $line }
}

function Read-DotEnvFile {
    param([string]$Path)
    $result = @{}
    if (-not (Test-Path $Path)) { return $result }
    foreach ($line in (Get-Content -Path $Path -ErrorAction Stop)) {
        $trimmed = $line.Trim()
        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }
        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()
        if ($value.Length -ge 2) {
            if (($value.StartsWith('"') -and $value.EndsWith('"')) -or ($value.StartsWith("'") -and $value.EndsWith("'"))) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }
        if (-not (Test-BlankValue $key)) { $result[$key] = $value }
    }
    return $result
}

function Join-EnvValues {
    param([hashtable[]]$Maps)
    $merged = @{}
    foreach ($map in $Maps) {
        foreach ($key in $map.Keys) { $merged[$key] = $map[$key] }
    }
    return $merged
}

function Normalize-PvwaApiBase {
    param([string]$PvwaValue)
    $base = $PvwaValue.Trim().TrimEnd('/')
    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Accounts/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/.+$', '/PasswordVault/API'
    if ($base -match '/PasswordVault/API$') { return $base }
    if ($base -match '/PasswordVault$') { return "$base/API" }
    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    param([hashtable]$Settings)
    $tenant = $Settings['TENANT_ID']
    if (Test-BlankValue $tenant) { throw 'TENANT_ID is missing in .env. Example: TENANT_ID=abq4291 or TENANT_ID=https://abq4291.id.cyberark.cloud' }
    $tenant = $tenant.Trim().TrimEnd('/')
    if ($tenant -match '^https?://') { return $tenant }
    if ($tenant -match '\.id\.cyberark\.cloud$') { return "https://$tenant" }
    if ($tenant -match '\.') { return "https://$tenant" }
    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    param([hashtable]$Settings)
    $proxy = $Settings['PROXY']
    if (-not (Test-BlankValue $proxy)) { return $proxy.Trim() }
    $proxyAddress = $Settings['PROXY_ADDRESS']
    if (Test-BlankValue $proxyAddress) { $proxyAddress = $Settings['ROXY_ADDRESS'] }
    $proxyPort = $Settings['PROXY_PORT']
    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) { return $null }
    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')
    if ($proxyAddress -notmatch '^https?://') { $proxyAddress = "http://$proxyAddress" }
    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"
    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}
    if (Test-Path $envFile1) { $envSpecific = Read-DotEnvFile -Path $envFile1 }
    elseif (Test-Path $envFile2) { $envSpecific = Read-DotEnvFile -Path $envFile2 }
    else { throw "Could not find environment file for '$Environment'. Expected $envFile1 or $envFile2" }
    $settings = Join-EnvValues -Maps @($base, $envSpecific)
    if (Test-BlankValue $settings['PVWA']) {
        if (Test-BlankValue $settings['SUB_DOMAIN']) { throw 'PVWA is missing and SUB_DOMAIN is not set. Set PVWA in dev.env/prod.env or SUB_DOMAIN in .env.' }
        $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud"
    }
    $identityBase = Resolve-IdentityBase -Settings $settings
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings
    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)
        if ($ProxyUseDefaultCredentials) { $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials }
        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }
    $script:Config = [pscustomobject]@{
        Environment = $Environment
        IdentityBase = $identityBase
        TokenUrl = "$identityBase/oauth2/platformtoken"
        ApiBase = $apiBase
        Proxy = $proxyFromEnv
    }
    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    param([hashtable]$Body)
    $pairs = @()
    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }
    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    param([string]$Text)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)
        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally { $sha.Dispose() }
}

function Get-WebErrorText {
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)
    $parts = New-Object System.Collections.Generic.List[string]
    if ($null -ne $ErrorRecord.Exception -and -not (Test-BlankValue $ErrorRecord.Exception.Message)) { [void]$parts.Add($ErrorRecord.Exception.Message) }
    $response = $ErrorRecord.Exception.Response
    if ($null -ne $response) {
        try {
            $statusCode = [int]$response.StatusCode
            $statusDescription = [string]$response.StatusDescription
            if (-not (Test-BlankValue $statusDescription)) { [void]$parts.Add("HTTPStatus=$statusCode $statusDescription") }
            else { [void]$parts.Add("HTTPStatus=$statusCode") }
        } catch {}
    }
    $body = $null
    if ($null -ne $ErrorRecord.ErrorDetails -and -not (Test-BlankValue $ErrorRecord.ErrorDetails.Message)) { $body = [string]$ErrorRecord.ErrorDetails.Message }
    if ((Test-BlankValue $body) -and $null -ne $response) {
        try {
            $stream = $response.GetResponseStream()
            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)
                try { $body = $reader.ReadToEnd() } finally { $reader.Dispose() }
            }
        } catch {}
    }
    if (-not (Test-BlankValue $body)) { [void]$parts.Add("Response=$body") }
    if ($parts.Count -eq 0) { return 'Unknown web request error.' }
    return ($parts -join ' | ')
}

function Get-IdentityBearerToken {
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'
    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'
    $body = ConvertTo-FormBody -Body @{
        grant_type = 'client_credentials'
        client_id = $credential.UserName
        client_secret = $credential.GetNetworkCredential().Password
    }
    $params = @{
        Method = 'Post'
        Uri = $script:Config.TokenUrl
        Body = $body
        ContentType = 'application/x-www-form-urlencoded'
        Headers = @{ Accept = 'application/json' }
        ErrorAction = 'Stop'
    }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { $response = Invoke-RestMethod @params }
    catch { throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)" }
    if ($null -eq $response.access_token) { throw 'Identity token response did not include access_token.' }
    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token
    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'INFO'
    return $token
}

function Invoke-CyberArkRest {
    param(
        [ValidateSet('GET','POST','PATCH','DELETE')]
        [string]$Method,
        [string]$Path,
        [string]$Token,
        [object]$Body = $null,
        [string]$ContentType = 'application/json'
    )
    if ($Path -match '^https?://') { $uri = $Path }
    else { $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))" }
    $params = @{
        Method = $Method
        Uri = $uri
        Headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }
        ErrorAction = 'Stop'
    }
    if ($Method -ne 'GET' -and $Method -ne 'DELETE') { $params['ContentType'] = $ContentType }
    if ($null -ne $Body) {
        if ($Body -is [string]) { $params['Body'] = $Body }
        else { $params['Body'] = ConvertTo-Json -InputObject $Body -Depth 30 -Compress }
    }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { return Invoke-RestMethod @params }
    catch { throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)" }
}

function Invoke-CyberArkPatchRaw {
    param(
        [string]$AccountId,
        [object[]]$Operations,
        [string]$Token,
        [string]$MethodName
    )
    $id = [System.Uri]::EscapeDataString($AccountId)
    $jsonBody = ConvertTo-Json -InputObject ([object[]]$Operations) -Depth 30 -Compress
    Write-RunLog 'Invoke-CyberArkPatchRaw' "AccountID=$AccountId Method=$MethodName Payload=$jsonBody" 'INFO'
    return Invoke-CyberArkRest -Method PATCH -Path "Accounts/$id/" -Token $Token -Body $jsonBody -ContentType 'application/json'
}

function Get-CsvRows {
    if (-not (Test-Path $CsvFile)) { throw "CSV file not found: $CsvFile" }
    if ((Get-Item $CsvFile).Length -eq 0) { throw "CSV file is empty: $CsvFile" }
    $rows = Import-Csv -Path $CsvFile | Where-Object {
        ($_.PSObject.Properties.Value | Where-Object { $null -ne $_ -and $_.ToString().Trim().Length -gt 0 }).Count -gt 0
    }
    if ($null -eq $rows -or @($rows).Count -eq 0) { throw "CSV contains no data rows: $CsvFile" }
    $first = @($rows)[0]
    $hasAccountId = $false
    foreach ($name in @('AccountID','Account ID','id','ID')) { if ($first.PSObject.Properties[$name]) { $hasAccountId = $true } }
    if (-not $hasAccountId) { throw 'CSV is missing required AccountID column. Accepted aliases: AccountID, Account ID, id, ID.' }
    Write-RunLog 'Get-CsvRows' "Imported $(@($rows).Count) row(s) from $CsvFile" 'INFO'
    return @($rows)
}

function Get-RowValue {
    param([pscustomobject]$Row, [string[]]$Names)
    foreach ($name in $Names) {
        $p = $Row.PSObject.Properties[$name]
        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) { return $p.Value.ToString().Trim() }
    }
    return $null
}

function Add-CsvRow {
    param([string]$Path, [pscustomobject]$Row)
    if (-not (Test-Path $Path)) { $Row | Export-Csv -Path $Path -NoTypeInformation }
    else { $Row | Export-Csv -Path $Path -NoTypeInformation -Append }
}

function Get-AccountById {
    param([string]$AccountId, [string]$Token)
    $id = [System.Uri]::EscapeDataString($AccountId)
    return Invoke-CyberArkRest -Method GET -Path "Accounts/$id/" -Token $Token
}

function Try-CheckInAccount {
    param([string]$AccountId, [string]$Token)
    $id = [System.Uri]::EscapeDataString($AccountId)
    try {
        Invoke-CyberArkRest -Method POST -Path "Accounts/$id/CheckIn/" -Token $Token -Body @{} | Out-Null
        Write-RunLog 'Try-CheckInAccount' "AccountID=$AccountId check-in/release call succeeded." 'INFO'
        return $true
    }
    catch {
        Write-RunLog 'Try-CheckInAccount' "AccountID=$AccountId check-in/release call failed but cleanup will continue. $($_.Exception.Message)" 'WARN'
        return $false
    }
}

function Disable-AccountAutomaticManagement {
    param([object]$Account, [string]$Token)

    $accountId = [string]$Account.id
    $status = ''
    $currentAutomatic = ''
    $currentReason = ''

    if ($null -ne $Account.secretManagement) {
        if ($null -ne $Account.secretManagement.status) { $status = [string]$Account.secretManagement.status }
        if ($null -ne $Account.secretManagement.automaticManagementEnabled) { $currentAutomatic = [string]$Account.secretManagement.automaticManagementEnabled }
        if ($null -ne $Account.secretManagement.manualManagementReason) { $currentReason = [string]$Account.secretManagement.manualManagementReason }
    }

    if ($currentAutomatic -ieq 'False') {
        return [pscustomobject]@{
            Success = $true
            Method = 'AlreadyDisabled'
            Message = 'Automatic Password Management is already disabled.'
        }
    }

    if ($TryCheckInBeforePatch) {
        Try-CheckInAccount -AccountId $accountId -Token $Token | Out-Null
    }

    $attemptMessages = New-Object System.Collections.Generic.List[string]

    # Method 1: replace the whole secretManagement object.
    # This avoids tenants that throw errors when only a nested field is changed.
    try {
        $secretManagementValue = [ordered]@{
            automaticManagementEnabled = $false
        }
        if ($SetManualManagementReason) {
            $secretManagementValue['manualManagementReason'] = $DisableReason
        }

        Invoke-CyberArkPatchRaw -AccountId $accountId -Token $Token -MethodName 'ReplaceSecretManagementObject' -Operations @(
            @{ op = 'replace'; path = '/secretManagement'; value = $secretManagementValue }
        ) | Out-Null

        return [pscustomobject]@{
            Success = $true
            Method = 'ReplaceSecretManagementObject'
            Message = 'Automatic Password Management disabled by replacing /secretManagement.'
        }
    }
    catch {
        [void]$attemptMessages.Add("ReplaceSecretManagementObject failed: $($_.Exception.Message)")
        Write-RunLog 'Disable-AccountAutomaticManagement' "AccountID=$accountId ReplaceSecretManagementObject failed. $($_.Exception.Message)" 'WARN'
    }

    # Method 2: replace only the nested AMD boolean, with no manual reason.
    try {
        Invoke-CyberArkPatchRaw -AccountId $accountId -Token $Token -MethodName 'ReplaceAutomaticManagementOnly' -Operations @(
            @{ op = 'replace'; path = '/secretManagement/automaticManagementEnabled'; value = $false }
        ) | Out-Null

        if ($SetManualManagementReason) {
            try {
                Invoke-CyberArkPatchRaw -AccountId $accountId -Token $Token -MethodName 'ReplaceManualManagementReasonOnly' -Operations @(
                    @{ op = 'replace'; path = '/secretManagement/manualManagementReason'; value = $DisableReason }
                ) | Out-Null
            }
            catch {
                Write-RunLog 'Disable-AccountAutomaticManagement' "AccountID=$accountId AMD disabled, but manualManagementReason update failed. $($_.Exception.Message)" 'WARN'
            }
        }

        return [pscustomobject]@{
            Success = $true
            Method = 'ReplaceAutomaticManagementOnly'
            Message = 'Automatic Password Management disabled by replacing /secretManagement/automaticManagementEnabled.'
        }
    }
    catch {
        [void]$attemptMessages.Add("ReplaceAutomaticManagementOnly failed: $($_.Exception.Message)")
        Write-RunLog 'Disable-AccountAutomaticManagement' "AccountID=$accountId ReplaceAutomaticManagementOnly failed. $($_.Exception.Message)" 'WARN'
    }

    # Method 3: some older tenant paths treat JSON patch value as string.
    # This is last because boolean is the documented v10 shape.
    try {
        Invoke-CyberArkPatchRaw -AccountId $accountId -Token $Token -MethodName 'ReplaceAutomaticManagementStringFalse' -Operations @(
            @{ op = 'replace'; path = '/secretManagement/automaticManagementEnabled'; value = 'false' }
        ) | Out-Null

        return [pscustomobject]@{
            Success = $true
            Method = 'ReplaceAutomaticManagementStringFalse'
            Message = 'Automatic Password Management disabled using string false fallback.'
        }
    }
    catch {
        [void]$attemptMessages.Add("ReplaceAutomaticManagementStringFalse failed: $($_.Exception.Message)")
        Write-RunLog 'Disable-AccountAutomaticManagement' "AccountID=$accountId ReplaceAutomaticManagementStringFalse failed. $($_.Exception.Message)" 'WARN'
    }

    $finalMessage = ($attemptMessages.ToArray() -join ' || ')

    if ($status -ieq 'inProcess') {
        $finalMessage = "Account secretManagement.status is inProcess. CPM may have already picked up the task; no supported REST cancel endpoint was found. Wait for CPM to finish/fail, then rerun. Attempts: $finalMessage"
    }

    return [pscustomobject]@{
        Success = $false
        Method = 'None'
        Message = $finalMessage
    }
}

function Invoke-RowClear {
    param([pscustomobject]$CsvRow, [int]$RowNumber, [string]$Token)

    $accountId = Get-RowValue -Row $CsvRow -Names @('AccountID','Account ID','id','ID')

    $result = [ordered]@{
        Row = $RowNumber
        AccountID = $accountId
        SafeName = ''
        AccountName = ''
        PlatformID = ''
        UserName = ''
        Address = ''
        BeforeAutomaticManagementEnabled = ''
        BeforeSecretManagementStatus = ''
        Action = ''
        Result = ''
        Method = ''
        Message = ''
    }

    try {
        if (Test-BlankValue $accountId) { throw 'AccountID is blank.' }

        $account = Get-AccountById -AccountId $accountId -Token $Token
        $result.SafeName = $account.safeName
        $result.AccountName = $account.name
        $result.PlatformID = $account.platformId
        $result.UserName = $account.userName
        $result.Address = $account.address

        if ($null -ne $account.secretManagement) {
            $result.BeforeAutomaticManagementEnabled = [string]$account.secretManagement.automaticManagementEnabled
            $result.BeforeSecretManagementStatus = [string]$account.secretManagement.status
        }

        if (-not $Execute) {
            $result.Action = 'PreviewDisableAMD'
            $result.Result = 'PREVIEW'
            $result.Message = 'Preview only. No account update sent because -Execute was not supplied.'
            return [pscustomobject]$result
        }

        if ($ConfirmClear -ne 'YES') {
            $result.Action = 'None'
            $result.Result = 'SKIPPED'
            $result.Message = 'Execute was supplied, but ConfirmClear was not YES.'
            return [pscustomobject]$result
        }

        $disableResult = Disable-AccountAutomaticManagement -Account $account -Token $Token
        $result.Action = 'DisableAutomaticPasswordManagement'
        $result.Method = $disableResult.Method
        $result.Message = $disableResult.Message

        if ($disableResult.Success) {
            $result.Result = if ($disableResult.Method -eq 'AlreadyDisabled') { 'SKIPPED' } else { 'SUCCESS' }
            Add-CsvRow -Path $script:ChangedReportFile -Row ([pscustomobject]@{
                Row = $RowNumber
                AccountID = $accountId
                SafeName = $result.SafeName
                AccountName = $result.AccountName
                PlatformID = $result.PlatformID
                UserName = $result.UserName
                Address = $result.Address
                BeforeAutomaticManagementEnabled = $result.BeforeAutomaticManagementEnabled
                BeforeSecretManagementStatus = $result.BeforeSecretManagementStatus
                Method = $disableResult.Method
                ChangedTime = (Get-Date -Format s)
                Message = $disableResult.Message
            })
        }
        else {
            $result.Result = 'FAILED'
        }

        return [pscustomobject]$result
    }
    catch {
        $result.Action = 'DisableAutomaticPasswordManagement'
        $result.Result = 'FAILED'
        $result.Message = $_.Exception.Message
        return [pscustomobject]$result
    }
}

function Start-ClearRun {
    New-RunLog
    Import-RunConfig

    if (-not $Execute) {
        Write-RunLog 'Start-ClearRun' 'Preview mode. No accounts will be updated because -Execute was not supplied.' 'WARN'
    }
    elseif ($ConfirmClear -ne 'YES') {
        Write-RunLog 'Start-ClearRun' 'Execute was supplied, but ConfirmClear is not YES. No accounts will be updated.' 'WARN'
    }
    else {
        Write-RunLog 'Start-ClearRun' 'CLEAR MODE ENABLED. No per-account prompt will be used.' 'WARN'
        Write-RunLog 'Start-ClearRun' 'Supported cleanup action: disable Automatic Password Management. Internal ResetImmediately is not patched directly.' 'WARN'
    }

    Write-RunLog 'Start-ClearRun' "Using CSV file: $CsvFile" 'INFO'

    $rows = Get-CsvRows
    $token = Get-IdentityBearerToken

    $rowNumber = 1
    foreach ($row in $rows) {
        $accountId = Get-RowValue -Row $row -Names @('AccountID','Account ID','id','ID')
        Write-RunLog 'Start-ClearRun' "Processing CSV row $rowNumber AccountID=$accountId" 'INFO'
        $outcome = Invoke-RowClear -CsvRow $row -RowNumber $rowNumber -Token $token
        Add-CsvRow -Path $script:ReportFile -Row $outcome
        if ($outcome.Result -eq 'FAILED') {
            Write-RunLog 'Start-ClearRun' "Row $rowNumber failed. AccountID=$($outcome.AccountID) Message=$($outcome.Message)" 'ERROR'
        }
        elseif ($outcome.Result -eq 'SUCCESS') {
            Write-RunLog 'Start-ClearRun' "Row $rowNumber updated. AccountID=$($outcome.AccountID) Method=$($outcome.Method)" 'WARN'
        }
        else {
            Write-RunLog 'Start-ClearRun' "Row $rowNumber $($outcome.Result). AccountID=$($outcome.AccountID) Message=$($outcome.Message)" 'INFO'
        }
        $rowNumber++
    }

    Write-RunLog 'Start-ClearRun' "Run completed. MainReport=$script:ReportFile" 'INFO'
    Write-RunLog 'Start-ClearRun' "ChangedReport=$script:ChangedReportFile" 'INFO'
    Write-RunLog 'Start-ClearRun' "Log=$script:LogFile" 'INFO'
}

Start-ClearRun
