<#
.SYNOPSIS
    CNA Privilege Cloud Bulk Azure Account Onboarding by Duplicating Existing Account

.DESCRIPTION
    - Authenticates to CNA Privilege Cloud using CCP + psPAS Identity Header
    - Uses source Account ID 2889_5 as the template
    - Bulk onboards accounts from CSV
    - Allows target SafeName per CSV row
    - Copies template address, secret type, platform properties, management settings, and remote machine settings
    - Changes username, password, platform, and safe per CSV row
    - Explicitly links:
        ExtraPasswordIndex 1 = logonAccount
        ExtraPasswordIndex 2 = ApplicationAccount
        ExtraPasswordIndex 3 = ReconcileAccount

.NOTES
    Required CSV columns:
        SafeName,Username,Password

    Optional CSV columns:
        LinkedAccountSafe,LinkedAccountName,LinkedAccountFolder

    Default linked account object:
        portal.azure.com-AzureCyberArkCPM

    This script does not print passwords to screen or log.
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings CNA =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Duplicate / Onboard settings =====
    [string]$SourceAccountID   = '2889_5',
    [string]$TargetPlatformID  = 'MicrosoftAzureConferenceRoom',

    # ===== Default linked account settings =====
    [string]$DefaultLinkedAccountName   = 'portal.azure.com-AzureCyberArkCPM',
    [string]$DefaultLinkedAccountFolder = 'Root',

    # If blank, the script uses the CSV SafeName as the linked account safe.
    [string]$DefaultLinkedAccountSafe   = '',

    # ===== Input / Output =====
    [string]$InputCsvPath      = 'E:\Installation Media\Script\OnboardScript\AzureBulkAccountOnboard\AzureBulkOnboard.csv',
    [string]$OutputFolder      = 'E:\Installation Media\Script\OnboardScript\AzureBulkAccountOnboard',
    [string]$ResultCsvName     = 'AzureBulkOnboard_Results.csv',
    [string]$LogFileName       = 'AzureBulkOnboard.log',

    # ===== Safety =====
    [switch]$DryRun
)

# ============================================
# Runtime Settings
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ============================================
# Paths
# ============================================

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
}

$LogFile       = Join-Path $OutputFolder $LogFileName
$ResultCsvPath = Join-Path $OutputFolder $ResultCsvName

New-Item -ItemType File -Force -Path $LogFile | Out-Null

# ============================================
# Logger
# ============================================

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# ============================================
# Helper: Normalize Identity Tenant URL
# ============================================

function Get-NormalizedIdentityTenant {
    param(
        [Parameter(Mandatory)]
        [string]$TenantUrl
    )

    $normalized = $TenantUrl.Trim()

    if ($normalized -notmatch '^https?://') {
        $normalized = "https://$normalized"
    }

    return $normalized.TrimEnd('/')
}

# ============================================
# Helper: Safely get object property
# ============================================

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propName in $PropertyNames) {
        if ($InputObject.PSObject.Properties.Name -contains $propName) {
            return $InputObject.$propName
        }
    }

    return $null
}

# ============================================
# Helper: Convert object to hashtable recursively
# ============================================

function ConvertTo-PlainHashtable {
    param(
        [object]$InputObject
    )

    if ($null -eq $InputObject) {
        return $null
    }

    if ($InputObject -is [System.Collections.IDictionary]) {
        $hash = @{}

        foreach ($key in $InputObject.Keys) {
            $hash[$key] = ConvertTo-PlainHashtable -InputObject $InputObject[$key]
        }

        return $hash
    }

    if ($InputObject -is [System.Array]) {
        $array = @()

        foreach ($item in $InputObject) {
            $array += ConvertTo-PlainHashtable -InputObject $item
        }

        return $array
    }

    if (
        $InputObject.PSObject.Properties.Count -gt 0 -and
        -not ($InputObject -is [string]) -and
        -not ($InputObject -is [int]) -and
        -not ($InputObject -is [long]) -and
        -not ($InputObject -is [bool]) -and
        -not ($InputObject -is [datetime])
    ) {
        $hash = @{}

        foreach ($prop in $InputObject.PSObject.Properties) {
            $hash[$prop.Name] = ConvertTo-PlainHashtable -InputObject $prop.Value
        }

        return $hash
    }

    return $InputObject
}

# ============================================
# Helper: Remove account-name and linked-account properties from create body
# ============================================

function Clean-PlatformAccountProperties {
    param(
        [hashtable]$PlatformProperties
    )

    if ($null -eq $PlatformProperties) {
        return $null
    }

    $keysToRemove = @()

    foreach ($key in @($PlatformProperties.Keys)) {
        $keyText = [string]$key

        if (
            $keyText -ieq 'name' -or
            $keyText -ieq 'accountName' -or
            $keyText -ieq 'platformAccountName' -or
            $keyText -ieq 'objectName' -or
            $keyText -imatch '^ExtraPass[123]' -or
            $keyText -imatch 'LogonAccount' -or
            $keyText -imatch 'ApplicationAccount' -or
            $keyText -imatch '^AppAccount' -or
            $keyText -imatch 'ReconcileAccount'
        ) {
            $keysToRemove += $key
        }
    }

    foreach ($removeKey in $keysToRemove) {
        if ($PlatformProperties.ContainsKey($removeKey)) {
            $PlatformProperties.Remove($removeKey)
        }
    }

    return $PlatformProperties
}

# ============================================
# Helper: Convert plain password to SecureString
# ============================================

function ConvertTo-SafeSecureString {
    param(
        [Parameter(Mandatory)]
        [string]$PlainText
    )

    return ConvertTo-SecureString $PlainText -AsPlainText -Force
}

# ============================================
# Helper: Friendly error message
# ============================================

function Get-FriendlyErrorMessage {
    param(
        [Parameter(Mandatory)]
        [System.Management.Automation.ErrorRecord]$ErrorRecord
    )

    $message = $ErrorRecord.Exception.Message

    if ($ErrorRecord.ErrorDetails -and -not [string]::IsNullOrWhiteSpace($ErrorRecord.ErrorDetails.Message)) {
        $message = "$message | Details: $($ErrorRecord.ErrorDetails.Message)"
    }

    return $message
}

# ============================================
# Import psPAS
# ============================================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $psPASModule = Get-Module psPAS

    if ($psPASModule) {
        Write-Log ("psPAS module loaded. Version: {0}" -f $psPASModule.Version) 'Green'
    } else {
        Write-Log "psPAS module loaded." 'Green'
    }
} catch {
    Write-Log ("ERROR: Failed to import psPAS module. {0}" -f $_.Exception.Message) 'Red'
    throw
}

# ============================================
# Validate Required Cmdlets
# ============================================

if (-not (Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Get-IdentityHeader cmdlet was not found. Confirm IdentityCommand module is installed and available." 'Red'
    throw "Get-IdentityHeader cmdlet not found."
}

if (-not (Get-Command Get-PASAccount -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Get-PASAccount cmdlet was not found. Confirm psPAS module is installed correctly." 'Red'
    throw "Get-PASAccount cmdlet not found."
}

if (-not (Get-Command Add-PASAccount -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Add-PASAccount cmdlet was not found. Confirm psPAS module is installed correctly." 'Red'
    throw "Add-PASAccount cmdlet not found."
}

if (-not (Get-Command Set-PASLinkedAccount -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Set-PASLinkedAccount cmdlet was not found. Confirm psPAS module supports linked account association." 'Red'
    throw "Set-PASLinkedAccount cmdlet not found."
}

# ============================================
# Login Method: CCP + psPAS Identity Header
# ============================================

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)]
        [string]$ObjectName
    )

    $headers = @{
        'Content-Type' = 'application/json'
    }

    $ccpUrl = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod `
            -Uri $ccpUrl `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response or missing Content field.'
        }
    } catch {
        Write-Log ("ERROR: CCP credential fetch failed. {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null

    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("Successfully retrieved CCP credential for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication using psPAS Identity header as {0}..." -f $resolvedUser) 'Cyan'
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'
        Write-Log ("Privilege Cloud Subdomain: {0}" -f $PCloudSubdomain) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established.'
        }

        Write-Log ("Authentication successful. PAS session established as {0}." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("ERROR: Failed to authenticate via psPAS Identity header. {0}" -f $_.Exception.Message) 'Red'
        throw
    } finally {
        if ($resp.PSObject.Properties.Name -contains 'Content') {
            $resp.Content = $null
        }

        if ($securePass) {
            $securePass.Dispose()
        }
    }

    return $resolvedUser
}

# ============================================
# Get source/template account by Account ID
# ============================================

function Get-TemplateAccountById {
    param(
        [Parameter(Mandatory)]
        [string]$AccountID
    )

    Write-Log ("Retrieving source/template account by Account ID: {0}" -f $AccountID) 'Cyan'

    try {
        $template = Get-PASAccount -id $AccountID -ErrorAction Stop

        if ($null -eq $template) {
            throw "No account details returned for Account ID $AccountID."
        }

        return $template
    } catch {
        $msg = Get-FriendlyErrorMessage -ErrorRecord $_
        Write-Log ("ERROR: Failed to retrieve template account {0}. {1}" -f $AccountID, $msg) 'Red'
        throw
    }
}

# ============================================
# Build Add-PASAccount parameters
# ============================================

function New-AddPASAccountParamsFromTemplate {
    param(
        [Parameter(Mandatory)]
        [object]$TemplateAccount,

        [Parameter(Mandatory)]
        [string]$TargetSafeName,

        [Parameter(Mandatory)]
        [string]$NewUsername,

        [Parameter(Mandatory)]
        [string]$NewPassword,

        [Parameter(Mandatory)]
        [string]$NewPlatformID
    )

    $address = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'address',
        'Address'
    )

    $secretType = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'secretType',
        'SecretType'
    )

    if ([string]::IsNullOrWhiteSpace([string]$TargetSafeName)) {
        throw "Target SafeName is missing."
    }

    if ([string]::IsNullOrWhiteSpace([string]$secretType)) {
        $secretType = 'Password'
    }

    if ([string]$secretType -ieq 'password') {
        $secretType = 'Password'
    } elseif ([string]$secretType -ieq 'key') {
        $secretType = 'Key'
    } else {
        $secretType = 'Password'
    }

    $secureSecret = ConvertTo-SafeSecureString -PlainText $NewPassword

    $params = @{
        userName   = $NewUsername
        platformID = $NewPlatformID
        SafeName   = [string]$TargetSafeName
        secretType = [string]$secretType
        secret     = $secureSecret
    }

    if (-not [string]::IsNullOrWhiteSpace([string]$address)) {
        $params['address'] = [string]$address
    }

    $templatePlatformProperties = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'platformAccountProperties',
        'PlatformAccountProperties',
        'properties',
        'Properties'
    )

    if ($null -ne $templatePlatformProperties) {
        $platformProps = ConvertTo-PlainHashtable -InputObject $templatePlatformProperties

        if ($null -ne $platformProps -and $platformProps -is [hashtable]) {
            $platformProps = Clean-PlatformAccountProperties -PlatformProperties $platformProps

            if ($platformProps.Count -gt 0) {
                $params['platformAccountProperties'] = $platformProps
            }
        }
    }

    $templateSecretManagement = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'secretManagement',
        'SecretManagement'
    )

    if ($null -ne $templateSecretManagement) {
        $automaticManagementEnabled = Get-ObjectPropertyValue -InputObject $templateSecretManagement -PropertyNames @(
            'automaticManagementEnabled',
            'AutomaticManagementEnabled'
        )

        $manualManagementReason = Get-ObjectPropertyValue -InputObject $templateSecretManagement -PropertyNames @(
            'manualManagementReason',
            'ManualManagementReason'
        )

        if ($null -ne $automaticManagementEnabled) {
            $params['automaticManagementEnabled'] = [bool]$automaticManagementEnabled
        }

        if (-not [string]::IsNullOrWhiteSpace([string]$manualManagementReason)) {
            $params['manualManagementReason'] = [string]$manualManagementReason
        }
    }

    $templateRemoteMachinesAccess = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'remoteMachinesAccess',
        'RemoteMachinesAccess'
    )

    if ($null -ne $templateRemoteMachinesAccess) {
        $remoteMachines = Get-ObjectPropertyValue -InputObject $templateRemoteMachinesAccess -PropertyNames @(
            'remoteMachines',
            'RemoteMachines'
        )

        $accessRestricted = Get-ObjectPropertyValue -InputObject $templateRemoteMachinesAccess -PropertyNames @(
            'accessRestrictedToRemoteMachines',
            'AccessRestrictedToRemoteMachines'
        )

        if (-not [string]::IsNullOrWhiteSpace([string]$remoteMachines)) {
            $params['remoteMachines'] = [string]$remoteMachines
        }

        if ($null -ne $accessRestricted) {
            $params['accessRestrictedToRemoteMachines'] = [bool]$accessRestricted
        }
    }

    return $params
}

# ============================================
# Add account
# ============================================

function Add-BulkAzureAccount {
    param(
        [Parameter(Mandatory)]
        [hashtable]$AddAccountParams
    )

    try {
        $response = Add-PASAccount @AddAccountParams -ErrorAction Stop
        return $response
    } catch {
        $msg = Get-FriendlyErrorMessage -ErrorRecord $_
        throw $msg
    }
}

# ============================================
# Resolve new account ID when Add-PASAccount does not return it
# ============================================

function Resolve-NewAccountID {
    param(
        [Parameter(Mandatory)]
        [object]$CreateResponse,

        [Parameter(Mandatory)]
        [string]$SafeName,

        [Parameter(Mandatory)]
        [string]$Username,

        [Parameter(Mandatory)]
        [string]$Address,

        [Parameter(Mandatory)]
        [string]$PlatformID
    )

    $newAccountId = Get-ObjectPropertyValue -InputObject $CreateResponse -PropertyNames @(
        'id',
        'Id',
        'accountId',
        'AccountID',
        'AccountId'
    )

    if (-not [string]::IsNullOrWhiteSpace([string]$newAccountId)) {
        return [string]$newAccountId
    }

    Write-Log "Add-PASAccount did not return AccountID. Attempting to locate newly created account..." 'Yellow'

    try {
        $searchText = $Username
        $matches = @(Get-PASAccount -search $searchText -ErrorAction Stop)

        foreach ($match in $matches) {
            $matchId = Get-ObjectPropertyValue -InputObject $match -PropertyNames @('id','Id','accountId','AccountID','AccountId')
            $matchSafe = Get-ObjectPropertyValue -InputObject $match -PropertyNames @('safeName','SafeName','safe','Safe')
            $matchUser = Get-ObjectPropertyValue -InputObject $match -PropertyNames @('userName','UserName','username','Username')
            $matchAddress = Get-ObjectPropertyValue -InputObject $match -PropertyNames @('address','Address')
            $matchPlatform = Get-ObjectPropertyValue -InputObject $match -PropertyNames @('platformId','PlatformId','PlatformID','PolicyID')

            if (
                [string]$matchSafe -ieq [string]$SafeName -and
                [string]$matchUser -ieq [string]$Username -and
                [string]$matchAddress -ieq [string]$Address -and
                [string]$matchPlatform -ieq [string]$PlatformID -and
                -not [string]::IsNullOrWhiteSpace([string]$matchId)
            ) {
                return [string]$matchId
            }
        }
    } catch {
        Write-Log ("WARNING: Could not resolve new AccountID by search. {0}" -f $_.Exception.Message) 'Yellow'
    }

    return ''
}

# ============================================
# Link fixed Azure linked accounts
# ============================================

function Set-FixedAzureLinkedAccounts {
    param(
        [Parameter(Mandatory)]
        [string]$NewAccountID,

        [Parameter(Mandatory)]
        [string]$LinkedAccountSafe,

        [Parameter(Mandatory)]
        [string]$LinkedAccountName,

        [Parameter(Mandatory)]
        [string]$LinkedAccountFolder
    )

    $copied = New-Object System.Collections.Generic.List[string]
    $failed = New-Object System.Collections.Generic.List[string]

    $links = @(
        [PSCustomObject]@{
            Label = 'logonAccount'
            Index = '1'
        },
        [PSCustomObject]@{
            Label = 'ApplicationAccount'
            Index = '2'
        },
        [PSCustomObject]@{
            Label = 'ReconcileAccount'
            Index = '3'
        }
    )

    foreach ($link in $links) {
        $description = "$($link.Label): Index=$($link.Index); Safe=$LinkedAccountSafe; Name=$LinkedAccountName; Folder=$LinkedAccountFolder"

        try {
            Write-Log ("Linking {0} to new AccountID='{1}'..." -f $description, $NewAccountID) 'Cyan'

            Set-PASLinkedAccount `
                -AccountID $NewAccountID `
                -safe $LinkedAccountSafe `
                -extraPasswordIndex $link.Index `
                -name $LinkedAccountName `
                -folder $LinkedAccountFolder `
                -Confirm:$false `
                -ErrorAction Stop | Out-Null

            $copied.Add($description)
            Write-Log ("Linked successfully: {0}" -f $description) 'Green'
        } catch {
            $errorText = "$description | Error=$($_.Exception.Message)"
            $failed.Add($errorText)
            Write-Log ("WARNING: Failed to link {0}" -f $errorText) 'Yellow'
        }
    }

    return [PSCustomObject]@{
        CopiedCount = $copied.Count
        FailedCount = $failed.Count
        CopiedLinks = ($copied -join ' | ')
        FailedLinks = ($failed -join ' | ')
    }
}

# ============================================
# Start Script
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "CNA Bulk Azure Account Onboarding started." 'Cyan'
Write-Log ("Identity Tenant URL       : {0}" -f $IdentityTenantURL) 'Gray'
Write-Log ("Privilege Cloud URL       : {0}" -f $PrivilegeCloudURL) 'Gray'
Write-Log ("PCloud Subdomain          : {0}" -f $PCloudSubdomain) 'Gray'
Write-Log ("CCP Address               : {0}" -f $CCPAddress) 'Gray'
Write-Log ("CCP AppID                 : {0}" -f $CCPAppID) 'Gray'
Write-Log ("CCP Safe                  : {0}" -f $CCPSafe) 'Gray'
Write-Log ("CCP Object                : {0}" -f $CCPObject) 'Gray'
Write-Log ("Source Account ID         : {0}" -f $SourceAccountID) 'Gray'
Write-Log ("Target Platform ID        : {0}" -f $TargetPlatformID) 'Gray'
Write-Log ("Default Linked Name       : {0}" -f $DefaultLinkedAccountName) 'Gray'
Write-Log ("Default Linked Safe       : {0}" -f $DefaultLinkedAccountSafe) 'Gray'
Write-Log ("Default Linked Folder     : {0}" -f $DefaultLinkedAccountFolder) 'Gray'
Write-Log ("Input CSV                 : {0}" -f $InputCsvPath) 'Gray'
Write-Log ("Result CSV                : {0}" -f $ResultCsvPath) 'Gray'
Write-Log ("DryRun                    : {0}" -f $DryRun.IsPresent) 'Gray'
Write-Log "============================================================" 'Gray'

# ============================================
# Validate CSV
# ============================================

if (-not (Test-Path -Path $InputCsvPath)) {
    Write-Log ("FATAL: Input CSV was not found: {0}" -f $InputCsvPath) 'Red'
    exit 1
}

try {
    $CsvRows = Import-Csv -Path $InputCsvPath -ErrorAction Stop
    $CsvRows = @($CsvRows)

    if ($CsvRows.Count -eq 0) {
        throw "CSV contains no rows."
    }

    Write-Log ("Imported {0} row(s) from CSV." -f $CsvRows.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to import CSV. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Authenticate
# ============================================

try {
    $AuthenticatedUser = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    Write-Log ("FATAL: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve source/template account
# ============================================

try {
    $TemplateAccount = Get-TemplateAccountById -AccountID $SourceAccountID

    $templateSafe = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'safeName',
        'SafeName',
        'safe',
        'Safe'
    )

    $templateAddress = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'address',
        'Address'
    )

    $templateUser = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'userName',
        'UserName',
        'username',
        'Username'
    )

    $templatePlatform = Get-ObjectPropertyValue -InputObject $TemplateAccount -PropertyNames @(
        'platformId',
        'PlatformId',
        'PlatformID',
        'PolicyID'
    )

    Write-Log "Template account resolved successfully." 'Green'
    Write-Log ("Template Safe        : {0}" -f $templateSafe) 'Gray'
    Write-Log ("Template Address     : {0}" -f $templateAddress) 'Gray'
    Write-Log ("Template Username    : {0}" -f $templateUser) 'Gray'
    Write-Log ("Template Platform ID : {0}" -f $templatePlatform) 'Gray'
} catch {
    Write-Log ("FATAL: Could not continue without source/template account. {0}" -f $_.Exception.Message) 'Red'

    try {
        Close-PASSession | Out-Null
    } catch {}

    exit 1
}

# ============================================
# Process bulk onboarding
# ============================================

$Results = New-Object System.Collections.Generic.List[object]

$totalRows = $CsvRows.Count
$currentRow = 0
$successCount = 0
$failedCount = 0
$skippedCount = 0
$linkedCopySuccessTotal = 0
$linkedCopyFailedTotal = 0

foreach ($row in $CsvRows) {
    $currentRow++

    $targetSafeName = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'SafeName',
        'safeName',
        'Safe',
        'safe'
    )

    $newUsername = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'Username',
        'UserName',
        'userName',
        'username'
    )

    $newPassword = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'Password',
        'password',
        'Secret',
        'secret'
    )

    $csvLinkedSafe = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'LinkedAccountSafe',
        'linkedAccountSafe',
        'LinkedSafe',
        'linkedSafe'
    )

    $csvLinkedName = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'LinkedAccountName',
        'linkedAccountName',
        'LinkedName',
        'linkedName'
    )

    $csvLinkedFolder = Get-ObjectPropertyValue -InputObject $row -PropertyNames @(
        'LinkedAccountFolder',
        'linkedAccountFolder',
        'LinkedFolder',
        'linkedFolder'
    )

    $targetSafeName = [string]$targetSafeName
    $newUsername = [string]$newUsername
    $newPassword = [string]$newPassword
    $csvLinkedSafe = [string]$csvLinkedSafe
    $csvLinkedName = [string]$csvLinkedName
    $csvLinkedFolder = [string]$csvLinkedFolder

    if ([string]::IsNullOrWhiteSpace($targetSafeName)) {
        $skippedCount++
        $msg = "Missing SafeName value."

        Write-Log ("[{0}/{1}] SKIPPED: {2}" -f $currentRow, $totalRows, $msg) 'Yellow'

        $Results.Add([PSCustomObject]@{
            RowNumber            = $currentRow
            SourceAccountID      = $SourceAccountID
            NewAccountID         = ''
            SafeName             = ''
            Username             = $newUsername
            Address              = [string]$templateAddress
            PlatformID           = $TargetPlatformID
            LinkedAccountSafe    = ''
            LinkedAccountName    = ''
            LinkedAccountsCopied = 0
            LinkedAccountsFailed = 0
            LinkedAccountDetails = ''
            LinkedAccountErrors  = ''
            Status               = 'Skipped'
            ErrorMessage         = $msg
        })

        continue
    }

    if ([string]::IsNullOrWhiteSpace($newUsername)) {
        $skippedCount++
        $msg = "Missing Username value."

        Write-Log ("[{0}/{1}] SKIPPED: SafeName='{2}'. {3}" -f $currentRow, $totalRows, $targetSafeName, $msg) 'Yellow'

        $Results.Add([PSCustomObject]@{
            RowNumber            = $currentRow
            SourceAccountID      = $SourceAccountID
            NewAccountID         = ''
            SafeName             = $targetSafeName
            Username             = ''
            Address              = [string]$templateAddress
            PlatformID           = $TargetPlatformID
            LinkedAccountSafe    = ''
            LinkedAccountName    = ''
            LinkedAccountsCopied = 0
            LinkedAccountsFailed = 0
            LinkedAccountDetails = ''
            LinkedAccountErrors  = ''
            Status               = 'Skipped'
            ErrorMessage         = $msg
        })

        continue
    }

    if ([string]::IsNullOrWhiteSpace($newPassword)) {
        $skippedCount++
        $msg = "Missing Password value."

        Write-Log ("[{0}/{1}] SKIPPED: SafeName='{2}', Username='{3}'. {4}" -f $currentRow, $totalRows, $targetSafeName, $newUsername, $msg) 'Yellow'

        $Results.Add([PSCustomObject]@{
            RowNumber            = $currentRow
            SourceAccountID      = $SourceAccountID
            NewAccountID         = ''
            SafeName             = $targetSafeName
            Username             = $newUsername
            Address              = [string]$templateAddress
            PlatformID           = $TargetPlatformID
            LinkedAccountSafe    = ''
            LinkedAccountName    = ''
            LinkedAccountsCopied = 0
            LinkedAccountsFailed = 0
            LinkedAccountDetails = ''
            LinkedAccountErrors  = ''
            Status               = 'Skipped'
            ErrorMessage         = $msg
        })

        continue
    }

    $linkedSafeToUse = ''
    $linkedNameToUse = ''
    $linkedFolderToUse = ''

    if (-not [string]::IsNullOrWhiteSpace($csvLinkedSafe)) {
        $linkedSafeToUse = $csvLinkedSafe
    } elseif (-not [string]::IsNullOrWhiteSpace($DefaultLinkedAccountSafe)) {
        $linkedSafeToUse = $DefaultLinkedAccountSafe
    } else {
        $linkedSafeToUse = $targetSafeName
    }

    if (-not [string]::IsNullOrWhiteSpace($csvLinkedName)) {
        $linkedNameToUse = $csvLinkedName
    } else {
        $linkedNameToUse = $DefaultLinkedAccountName
    }

    if (-not [string]::IsNullOrWhiteSpace($csvLinkedFolder)) {
        $linkedFolderToUse = $csvLinkedFolder
    } else {
        $linkedFolderToUse = $DefaultLinkedAccountFolder
    }

    Write-Log ("[{0}/{1}] Preparing onboarding for SafeName='{2}', Username='{3}'..." -f $currentRow, $totalRows, $targetSafeName, $newUsername) 'Cyan'
    Write-Log ("[{0}/{1}] Linked account target: Safe='{2}', Name='{3}', Folder='{4}'." -f $currentRow, $totalRows, $linkedSafeToUse, $linkedNameToUse, $linkedFolderToUse) 'Gray'

    try {
        $addParams = New-AddPASAccountParamsFromTemplate `
            -TemplateAccount $TemplateAccount `
            -TargetSafeName $targetSafeName `
            -NewUsername $newUsername `
            -NewPassword $newPassword `
            -NewPlatformID $TargetPlatformID

        if ($DryRun.IsPresent) {
            Write-Log ("[{0}/{1}] DRYRUN: Would create account for Username='{2}' in Safe='{3}' Platform='{4}'." -f $currentRow, $totalRows, $newUsername, $targetSafeName, $TargetPlatformID) 'Yellow'
            Write-Log ("[{0}/{1}] DRYRUN: Would link logonAccount/ApplicationAccount/ReconcileAccount to '{2}' in safe '{3}'." -f $currentRow, $totalRows, $linkedNameToUse, $linkedSafeToUse) 'Yellow'

            $Results.Add([PSCustomObject]@{
                RowNumber            = $currentRow
                SourceAccountID      = $SourceAccountID
                NewAccountID         = ''
                SafeName             = $targetSafeName
                Username             = $newUsername
                Address              = [string]$templateAddress
                PlatformID           = $TargetPlatformID
                LinkedAccountSafe    = $linkedSafeToUse
                LinkedAccountName    = $linkedNameToUse
                LinkedAccountsCopied = 0
                LinkedAccountsFailed = 0
                LinkedAccountDetails = ''
                LinkedAccountErrors  = ''
                Status               = 'DryRun'
                ErrorMessage         = ''
            })

            continue
        }

        $response = Add-BulkAzureAccount -AddAccountParams $addParams

        $newAccountId = Resolve-NewAccountID `
            -CreateResponse $response `
            -SafeName $targetSafeName `
            -Username $newUsername `
            -Address ([string]$templateAddress) `
            -PlatformID $TargetPlatformID

        if ([string]::IsNullOrWhiteSpace([string]$newAccountId)) {
            throw "Account may have been created, but the new AccountID could not be resolved. Linked accounts cannot be applied without AccountID."
        }

        Write-Log ("[{0}/{1}] SUCCESS: Created account for Username='{2}'. New AccountID='{3}'." -f $currentRow, $totalRows, $newUsername, $newAccountId) 'Green'

        $linkCopyResult = Set-FixedAzureLinkedAccounts `
            -NewAccountID ([string]$newAccountId) `
            -LinkedAccountSafe $linkedSafeToUse `
            -LinkedAccountName $linkedNameToUse `
            -LinkedAccountFolder $linkedFolderToUse

        $linkedCopySuccessTotal += $linkCopyResult.CopiedCount
        $linkedCopyFailedTotal += $linkCopyResult.FailedCount

        $successCount++

        $finalStatus = if ($linkCopyResult.FailedCount -gt 0) {
            'SuccessWithLinkedAccountWarning'
        } else {
            'Success'
        }

        $Results.Add([PSCustomObject]@{
            RowNumber            = $currentRow
            SourceAccountID      = $SourceAccountID
            NewAccountID         = [string]$newAccountId
            SafeName             = $targetSafeName
            Username             = $newUsername
            Address              = [string]$templateAddress
            PlatformID           = $TargetPlatformID
            LinkedAccountSafe    = $linkedSafeToUse
            LinkedAccountName    = $linkedNameToUse
            LinkedAccountsCopied = $linkCopyResult.CopiedCount
            LinkedAccountsFailed = $linkCopyResult.FailedCount
            LinkedAccountDetails = $linkCopyResult.CopiedLinks
            LinkedAccountErrors  = $linkCopyResult.FailedLinks
            Status               = $finalStatus
            ErrorMessage         = ''
        })
    } catch {
        $failedCount++
        $errorMessage = $_.Exception.Message

        Write-Log ("[{0}/{1}] FAILED: SafeName='{2}', Username='{3}'. {4}" -f $currentRow, $totalRows, $targetSafeName, $newUsername, $errorMessage) 'Red'

        $Results.Add([PSCustomObject]@{
            RowNumber            = $currentRow
            SourceAccountID      = $SourceAccountID
            NewAccountID         = ''
            SafeName             = $targetSafeName
            Username             = $newUsername
            Address              = [string]$templateAddress
            PlatformID           = $TargetPlatformID
            LinkedAccountSafe    = $linkedSafeToUse
            LinkedAccountName    = $linkedNameToUse
            LinkedAccountsCopied = 0
            LinkedAccountsFailed = 0
            LinkedAccountDetails = ''
            LinkedAccountErrors  = ''
            Status               = 'Failed'
            ErrorMessage         = $errorMessage
        })
    } finally {
        $newPassword = $null
        $addParams = $null
        $response = $null
    }
}

# ============================================
# Export Results
# ============================================

try {
    Write-Log "Exporting onboarding results..." 'Yellow'

    $Results |
        Sort-Object RowNumber |
        Export-Csv -Path $ResultCsvPath -NoTypeInformation -Encoding UTF8

    Write-Log ("Results exported to: {0}" -f $ResultCsvPath) 'Green'
} catch {
    Write-Log ("ERROR: Failed to export results CSV. {0}" -f $_.Exception.Message) 'Red'
}

# ============================================
# Close Session
# ============================================

try {
    Close-PASSession | Out-Null
    Write-Log "PAS session closed." 'Gray'
} catch {
    Write-Log ("WARNING: Could not close PAS session cleanly. {0}" -f $_.Exception.Message) 'Yellow'
}

# ============================================
# Completion
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "CNA Bulk Azure Account Onboarding completed." 'Green'
Write-Log ("Authenticated User              : {0}" -f $AuthenticatedUser) 'Gray'
Write-Log ("Source Account ID               : {0}" -f $SourceAccountID) 'Gray'
Write-Log ("Target Platform ID              : {0}" -f $TargetPlatformID) 'Gray'
Write-Log ("Total CSV Rows                  : {0}" -f $totalRows) 'Gray'
Write-Log ("Success Count                   : {0}" -f $successCount) 'Green'
Write-Log ("Failed Count                    : {0}" -f $failedCount) 'Red'
Write-Log ("Skipped Count                   : {0}" -f $skippedCount) 'Yellow'
Write-Log ("Linked Accounts Copied Total    : {0}" -f $linkedCopySuccessTotal) 'Green'
Write-Log ("Linked Accounts Failed Total    : {0}" -f $linkedCopyFailedTotal) 'Yellow'
Write-Log ("Result CSV                      : {0}" -f $ResultCsvPath) 'Gray'
Write-Log ("Log File                        : {0}" -f $LogFile) 'Gray'
Write-Log "============================================================" 'Gray'
