<#
CNA_Create_Identity_WebApp_From_Json_NonServiceUser.ps1

Purpose
- Use CCP/service-user only for PAS lookup
- Use an interactive NON-SERVICE Identity admin user for Identity app-management APIs
- Create a new Browser Extension (advanced) style app from exported JSON
- Update the app with the exported configuration
- Rename the app
- Apply direct application permissions to a target group

Notes
- IdentityApiTenantURL should be your preferred tenant URL if available, for example:
    https://yourtenant.my.idaptive.app
- Supports password and simple text/OTP challenge prompts for Identity auth.
- Skips GetUserInfo and skips Redrock/query entirely.
#>

[CmdletBinding()]
param(
    # ===== PAS / Privilege Cloud auth path =====
    [string]$IdentityTenantURL    = 'https://aat4012.id.cyberark.cloud',

    # ===== Identity API path =====
    [string]$IdentityApiTenantURL = 'https://aat4012.id.cyberark.cloud',

    [string]$PCloudSubdomain      = 'cna-prod',
    [string]$PrivilegeCloudURL    = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings (for PAS only) =====
    [string]$CCPAddress           = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation          = 'AIMWebService',
    [string]$CCPAppID             = 'PAMDiscovery',
    [string]$CCPSafe              = 'CA_PCloud_Admins',
    [string]$CCPObject            = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth         = $false,

    # ===== Interactive Identity admin login =====
    [string]$IdentityAdminUserName = '',

    # ===== New app settings =====
    [string]$SourceAppName        = 'GCP - Okta Prod',
    [string]$NewAppName           = 'g-test-pam1',
    [string]$AppDescription       = 'GCP - Okta Prod created via CyberArk Identity API',
    [string]$TemplateIdOverride   = '',

    # ===== Identity application permission target =====
    [string]$TargetGroupDisplayName          = 'ca_PCloud_Admins',
    [string]$TargetGroupSystemName           = 'ca_PCloud_Admins',
    [string]$TargetGroupInternalName         = '',
    [string]$TargetGroupDirectoryServiceUuid = '',

    # ===== PAS validation / reporting =====
    [string]$SafeName             = 'CyberArkTestValidation',
    [string]$AccountName          = 'PC0VPXSB.cna.com-administrator',

    # ===== Optional exported app JSON =====
    [string]$SourceAppExportJson  = '',

    # ===== Logging =====
    [string]$LogPath              = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_From_Json_NonServiceUser.log',
    [string]$ReportCsvPath        = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_From_Json_NonServiceUser_Report.csv',

    # ===== Advanced =====
    [switch]$WhatIf
)

# ------------------------------------------------------------
# Setup
# ------------------------------------------------------------
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

$script:IdentityAuthToken  = $null
$script:IdentityUser       = $null
$script:IdentityWebSession = $null
$script:PasCredential      = $null
$script:ReportRows         = New-Object System.Collections.Generic.List[object]

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Add-ReportRow {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail
    )
    $script:ReportRows.Add([pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }) | Out-Null
}

function ConvertTo-JsonSafe {
    param([Parameter()][object]$Object)
    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 60)
}

function Get-HttpStatusCode {
    param([Parameter(Mandatory)]$Exception)
    try { return [int]$Exception.Response.StatusCode.value__ } catch { return $null }
}

function Get-NormalizedIdentityTenant {
    param([Parameter(Mandatory)][string]$TenantUrl)
    $value = $TenantUrl.Trim()
    $value = $value -replace '^https?://', ''
    $value = $value.TrimEnd('/')
    return $value
}

function Get-DirectField {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$FieldName
    )

    if ($null -eq $Object) { return $null }

    if ($Object -is [System.Collections.IDictionary]) {
        if ($Object.Contains($FieldName)) { return $Object[$FieldName] }
        return $null
    }

    if ($Object.PSObject -and $Object.PSObject.Properties.Name -contains $FieldName) {
        return $Object.$FieldName
    }

    return $null
}

function Convert-SecureStringToPlainText {
    param([Parameter(Mandatory)][SecureString]$SecureString)

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecureString)
    try {
        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    } finally {
        if ($bstr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        }
    }
}

function Get-DefaultSourceExportJson {
@'
{"CBEScript":"loginData.applicationUrl = \"https://cna.okta.com/login/default\";\n \nloginData.addField(\"username\", \"input#input28\", LoginUsername + \"@cna.com\");\nloginData.addField(\"password\", \"input[name='credentials.passcode']\", LoginPassword);\n \nloginData.formPattern = \"form\";\nloginData.globalSelectorTimeout = 10000;\n \nloginData.order = [\n  [\"fill\", \"username\"],\n  [\"fill\", \"password\"],\n  [\"click\", \"input[type='submit'][value='Sign in']\"]\n];","Name":"GCP - Okta Prod","Category":"_I18N_AppCategory_Other","DefaultAuthProfileInfo":{"Uuid":"AlwaysAllowed"},"DisplayName":"GCP - Okta Prod","OnPrem":true,"IsSwsEnabled":true,"ShowRegistration":false,"AdminTag":"_I18N_AppCategory_Other","UserNameStrategy":"SetByUser","Description":"_I18N_AppDesc_Generic_BE_Script","FormFillingEnabled":true,"Generic":true,"AppType":"Web","DefaultAuthProfile":"AlwaysAllowed","Icon":"/vfslow/lib/application/icons/GenericBrowserExtension.svg","AuthRules":{"_UniqueKey":"Condition","_Value":[],"Enabled":true,"_Type":"RowSet"},"WebAppType":"UsernamePassword","TemplateName":"GenericBrowserExtensionScript","Notes":"","LocalizationEnabled":false,"WebUPAppType":"BrowserExtensionScript","NotSelfService":true}
'@
}

# ------------------------------------------------------------
# Load psPAS
# ------------------------------------------------------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) 'Green'
    Add-ReportRow -Step 'Load psPAS' -Status 'SUCCESS' -Detail ("Version {0}" -f $mod.Version)
} catch {
    Write-Log ("FAILED: psPAS module not found/loaded: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Load psPAS' -Status 'FAILED' -Detail $_.Exception.Message
    exit 1
}

# ------------------------------------------------------------
# PAS auth from CCP
# ------------------------------------------------------------
function Start-PASSessionFromCCP {
    param([Parameter(Mandatory)][string]$ObjectName)

    $headers = @{ 'Content-Type' = 'application/json' }
    $ccpUrl  = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
    if (-not $resp -or -not $resp.Content) {
        throw 'Empty CCP response.'
    }

    $resolvedUser = $null
    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    $secure = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $script:PasCredential = [PSCredential]::new($resolvedUser, $secure)

    Write-Log ("Successfully retrieved credentials for PAS service user: {0}" -f $resolvedUser) 'Green'
    Add-ReportRow -Step 'CCP Retrieve' -Status 'SUCCESS' -Detail ("User {0}" -f $resolvedUser)

    $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

    Write-Log 'Requesting PAS session via psPAS Identity header...' 'Cyan'
    $header = Get-IdentityHeader `
        -IdentityTenantURL $normalizedTenant `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $script:PasCredential

    Use-PASSession $header | Out-Null

    if (-not (Get-PASSession)) {
        throw 'psPAS session not established.'
    }

    Write-Log ("PAS session established ({0})." -f $script:PasCredential.UserName) 'Green'
    Add-ReportRow -Step 'PAS Session' -Status 'SUCCESS' -Detail ("Authenticated as {0}" -f $script:PasCredential.UserName)

    return $resp
}

# ------------------------------------------------------------
# Interactive Identity authentication (non-service user)
# ------------------------------------------------------------
function Get-AuthPayload {
    param([Parameter(Mandatory)]$Response)

    if ($Response.PSObject -and $Response.PSObject.Properties.Name -contains 'Result' -and $null -ne $Response.Result) {
        return $Response.Result
    }

    return $Response
}

function Get-AuthSummaryValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'Summary')
}

function Get-AuthSessionId {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'SessionId')
}

function Get-AuthTokenValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'Auth')
}

function Get-AuthUserValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'User')
}

function Get-FirstMechanism {
    param([Parameter(Mandatory)]$Payload)

    $challenges = @(Get-DirectField -Object $Payload -FieldName 'Challenges')
    foreach ($challenge in $challenges) {
        $mechs = @(Get-DirectField -Object $challenge -FieldName 'Mechanisms')
        foreach ($mech in $mechs) {
            $mechId = [string](Get-DirectField -Object $mech -FieldName 'MechanismId')
            if (-not [string]::IsNullOrWhiteSpace($mechId)) {
                return $mech
            }
        }
    }

    return $null
}

function Get-MechanismPrompt {
    param([Parameter(Mandatory)]$Mechanism)

    $name   = [string](Get-DirectField -Object $Mechanism -FieldName 'Name')
    $prompt = [string](Get-DirectField -Object $Mechanism -FieldName 'PromptSelectMech')
    $type   = [string](Get-DirectField -Object $Mechanism -FieldName 'AnswerType')

    if ($name -eq 'UP' -or $prompt -match 'Password') {
        $secure = Read-Host "Enter password for the Identity admin account" -AsSecureString
        return @{
            Action = 'Answer'
            Answer = (Convert-SecureStringToPlainText -SecureString $secure)
            Name   = $name
            Prompt = $prompt
        }
    }

    $display = if (-not [string]::IsNullOrWhiteSpace($prompt)) { $prompt } else { $name }
    $answer = Read-Host ("Enter response for challenge [{0}] {1}" -f $type, $display)

    return @{
        Action = 'Answer'
        Answer = $answer
        Name   = $name
        Prompt = $prompt
    }
}

function Start-IdentityInteractiveSession {
    param(
        [Parameter(Mandatory)][string]$TenantUrl,
        [string]$UserName
    )

    if ([string]::IsNullOrWhiteSpace($UserName)) {
        $UserName = Read-Host 'Enter the NON-SERVICE Identity admin username'
    }

    if ([string]::IsNullOrWhiteSpace($UserName)) {
        throw 'Identity admin username cannot be empty.'
    }

    $baseHeaders = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    $startUri = ($TenantUrl.TrimEnd('/') + '/Security/StartAuthentication')
    $advUri   = ($TenantUrl.TrimEnd('/') + '/Security/AdvanceAuthentication')

    $script:IdentityWebSession = New-Object Microsoft.PowerShell.Commands.WebRequestSession

    Write-Log ("Starting interactive CyberArk Identity authentication for '{0}'..." -f $UserName) 'Cyan'

    $startBody = @{
        User    = $UserName
        Version = '1.0'
    }

    $startResp = Invoke-RestMethod -Method POST -Uri $startUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body (ConvertTo-JsonSafe $startBody) -ErrorAction Stop
    $payload = Get-AuthPayload -Response $startResp

    for ($i = 0; $i -lt 10; $i++) {
        $summary = Get-AuthSummaryValue -Payload $payload
        $authVal = Get-AuthTokenValue -Payload $payload

        if ($summary -eq 'LoginSuccess' -or -not [string]::IsNullOrWhiteSpace($authVal)) {
            $script:IdentityAuthToken = $authVal
            $script:IdentityUser      = Get-AuthUserValue -Payload $payload

            $cookieCount = 0
            try { $cookieCount = $script:IdentityWebSession.Cookies.GetCookies($TenantUrl).Count } catch {}

            Write-Log ("Identity API authentication succeeded as '{0}'. CookieCount={1}" -f $script:IdentityUser, $cookieCount) 'Green'
            Add-ReportRow -Step 'Identity API Session' -Status 'SUCCESS' -Detail ("Authenticated as {0}; CookieCount={1}" -f $script:IdentityUser, $cookieCount)
            return
        }

        $sessionId = Get-AuthSessionId -Payload $payload
        if ([string]::IsNullOrWhiteSpace($sessionId)) {
            throw 'Authentication package did not include SessionId.'
        }

        $mechanism = Get-FirstMechanism -Payload $payload
        if ($null -eq $mechanism) {
            throw 'No supported authentication mechanism was returned. Use a password or text/OTP-based admin flow for this test.'
        }

        $mechId = [string](Get-DirectField -Object $mechanism -FieldName 'MechanismId')
        $name   = [string](Get-DirectField -Object $mechanism -FieldName 'Name')
        $prompt = [string](Get-DirectField -Object $mechanism -FieldName 'PromptSelectMech')

        Write-Log ("Responding to Identity challenge. Mechanism='{0}' Prompt='{1}'." -f $name, $prompt) 'Gray'

        $response = Get-MechanismPrompt -Mechanism $mechanism

        $advBody = @{
            SessionId   = $sessionId
            MechanismId = $mechId
            Action      = $response.Action
            Answer      = $response.Answer
        }

        $advResp = Invoke-RestMethod -Method POST -Uri $advUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body (ConvertTo-JsonSafe $advBody) -ErrorAction Stop
        $payload = Get-AuthPayload -Response $advResp
    }

    throw 'Interactive Identity authentication did not complete after multiple challenge rounds.'
}

function Invoke-IdentityPostRaw {
    param(
        [Parameter(Mandatory)][string]$AbsoluteUri,
        [Parameter()][object]$Body,
        [ValidateSet('BearerCookie','CookieOnly','BearerOnly')][string]$AuthMode = 'BearerCookie'
    )

    $headers = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    if ($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'BearerOnly') {
        if ([string]::IsNullOrWhiteSpace($script:IdentityAuthToken)) {
            throw 'Identity auth token is not initialized.'
        }
        $headers['Authorization'] = ("Bearer {0}" -f $script:IdentityAuthToken)
    }

    $invokeParams = @{
        Method      = 'POST'
        Uri         = $AbsoluteUri
        Headers     = $headers
        ContentType = 'application/json'
        ErrorAction = 'Stop'
    }

    $json = ConvertTo-JsonSafe -Object $Body
    if ($null -ne $json) { $invokeParams['Body'] = $json }

    if (($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'CookieOnly') -and $null -ne $script:IdentityWebSession) {
        $invokeParams['WebSession'] = $script:IdentityWebSession
    }

    return Invoke-RestMethod @invokeParams
}

function Invoke-IdentityApiWithRetry {
    param(
        [Parameter(Mandatory)][string[]]$AbsoluteUris,
        [Parameter()][object]$Body,
        [string]$LogicalName = 'Identity API call'
    )

    $authModes = @('BearerCookie','CookieOnly','BearerOnly')
    $errors = New-Object System.Collections.Generic.List[string]

    foreach ($uri in $AbsoluteUris) {
        foreach ($mode in $authModes) {
            try {
                Write-Log ("Trying {0} via URI '{1}' using auth mode '{2}'..." -f $LogicalName, $uri, $mode) 'Gray'
                $resp = Invoke-IdentityPostRaw -AbsoluteUri $uri -Body $Body -AuthMode $mode
                Write-Log ("Succeeded: {0} via URI '{1}' using auth mode '{2}'." -f $LogicalName, $uri, $mode) 'Gray'
                return $resp
            } catch {
                $status = Get-HttpStatusCode -Exception $_.Exception
                $msg    = $_.Exception.Message
                $errors.Add(("URI={0}; Mode={1}; Status={2}; Error={3}" -f $uri, $mode, $status, $msg)) | Out-Null

                if ($status -eq 401) {
                    Write-Log ("401 on {0} via URI '{1}' using auth mode '{2}'. Retrying..." -f $LogicalName, $uri, $mode) 'Yellow'
                    continue
                }

                throw
            }
        }
    }

    throw ("Unauthorized persisted for {0}. Details: {1}" -f $LogicalName, ($errors -join ' || '))
}

# ------------------------------------------------------------
# PAS account validation - safe only + exact match
# ------------------------------------------------------------
function Get-AccountCandidateFields {
    param([Parameter(Mandatory)]$Account)

    $fields = New-Object System.Collections.Generic.List[string]

    foreach ($prop in @('name','Name','userName','UserName','address','Address')) {
        $val = [string](Get-DirectField -Object $Account -FieldName $prop)
        if (-not [string]::IsNullOrWhiteSpace($val) -and -not $fields.Contains($val)) {
            $fields.Add($val) | Out-Null
        }
    }

    $addr = [string](Get-DirectField -Object $Account -FieldName 'address')
    if ([string]::IsNullOrWhiteSpace($addr)) { $addr = [string](Get-DirectField -Object $Account -FieldName 'Address') }

    $usr = [string](Get-DirectField -Object $Account -FieldName 'userName')
    if ([string]::IsNullOrWhiteSpace($usr)) { $usr = [string](Get-DirectField -Object $Account -FieldName 'UserName') }

    if (-not [string]::IsNullOrWhiteSpace($addr) -and -not [string]::IsNullOrWhiteSpace($usr)) {
        $composite = "$addr-$usr"
        if (-not $fields.Contains($composite)) {
            $fields.Add($composite) | Out-Null
        }
    }

    return @($fields)
}

function Test-ExactAccountIdentifierMatch {
    param(
        [Parameter(Mandatory)]$Account,
        [Parameter(Mandatory)][string]$Identifier
    )

    $needle = $Identifier.Trim().ToLowerInvariant()
    foreach ($candidate in (Get-AccountCandidateFields -Account $Account)) {
        if ($candidate.Trim().ToLowerInvariant() -eq $needle) {
            return $true
        }
    }
    return $false
}

function Find-VaultAccountInSafeOnly {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$AccountIdentifier
    )

    Write-Log ("Searching PAS account in Safe '{0}' using exact identifier '{1}' only..." -f $SafeName, $AccountIdentifier) 'Cyan'

    $matches = @()

    try {
        $getPasCmd = Get-Command Get-PASAccount -ErrorAction Stop

        if ($getPasCmd.Parameters.ContainsKey('SafeName')) {
            try {
                Write-Log "Trying Get-PASAccount -SafeName scoped lookup..." 'Gray'
                $safeSearch = @(Get-PASAccount -SafeName $SafeName -Search $AccountIdentifier -ErrorAction Stop)
                $matches = @($safeSearch | Where-Object { Test-ExactAccountIdentifierMatch -Account $_ -Identifier $AccountIdentifier })
            } catch {
                Write-Log ("Get-PASAccount -SafeName scoped lookup failed: {0}" -f $_.Exception.Message) 'Yellow'
            }

            if ($matches.Count -lt 1) {
                Write-Log "Trying Get-PASAccount -SafeName enumeration for the target safe only..." 'Gray'
                $safeAll = @(Get-PASAccount -SafeName $SafeName -ErrorAction Stop)
                $matches = @($safeAll | Where-Object { Test-ExactAccountIdentifierMatch -Account $_ -Identifier $AccountIdentifier })
            }
        } else {
            throw 'Get-PASAccount does not expose -SafeName in this environment.'
        }
    } catch {
        throw ("Safe-only PAS lookup failed: {0}" -f $_.Exception.Message)
    }

    if ($matches.Count -lt 1) {
        throw ("No exact PAS account match was found in Safe '{0}' for identifier '{1}'. The script will not continue with a fuzzy match." -f $SafeName, $AccountIdentifier)
    }

    if ($matches.Count -gt 1) {
        $ids = ($matches | ForEach-Object { [string](Get-DirectField -Object $_ -FieldName 'id') }) -join ','
        throw ("Multiple exact PAS account matches were found in Safe '{0}' for identifier '{1}'. Matching Account IDs: {2}" -f $SafeName, $AccountIdentifier, $ids)
    }

    $acct = $matches[0]
    $acctId   = [string](Get-DirectField -Object $acct -FieldName 'id')
    $acctUser = [string](Get-DirectField -Object $acct -FieldName 'userName')
    if ([string]::IsNullOrWhiteSpace($acctUser)) { $acctUser = [string](Get-DirectField -Object $acct -FieldName 'UserName') }
    $acctAddr = [string](Get-DirectField -Object $acct -FieldName 'address')
    if ([string]::IsNullOrWhiteSpace($acctAddr)) { $acctAddr = [string](Get-DirectField -Object $acct -FieldName 'Address') }
    $acctName = [string](Get-DirectField -Object $acct -FieldName 'name')
    if ([string]::IsNullOrWhiteSpace($acctName)) { $acctName = [string](Get-DirectField -Object $acct -FieldName 'Name') }

    Write-Log ("Matched exact PAS account. ID='{0}' Name='{1}' Username='{2}' Address='{3}'." -f $acctId, $acctName, $acctUser, $acctAddr) 'Green'
    Add-ReportRow -Step 'Find Vault Account' -Status 'SUCCESS' -Detail ("Safe={0}; AccountID={1}; Name={2}; Username={3}; Address={4}" -f $SafeName, $acctId, $acctName, $acctUser, $acctAddr)
    return $acct
}

# ------------------------------------------------------------
# Export JSON -> config object
# ------------------------------------------------------------
function Get-ExportConfig {
    param([string]$JsonText)

    if ([string]::IsNullOrWhiteSpace($JsonText)) {
        $JsonText = Get-DefaultSourceExportJson
    }

    try {
        return ($JsonText | ConvertFrom-Json -ErrorAction Stop)
    } catch {
        throw ("Failed to parse SourceAppExportJson: {0}" -f $_.Exception.Message)
    }
}

# ------------------------------------------------------------
# App creation / update
# ------------------------------------------------------------
function Import-AppFromTemplateAdaptive {
    param(
        [Parameter(Mandatory)][object]$Config,
        [string]$TemplateIdOverride = ''
    )

    $candidates = New-Object System.Collections.Generic.List[string]
    foreach ($candidate in @(
        $TemplateIdOverride,
        [string]$Config.TemplateName,
        'GenericBrowserExtensionScript',
        'GenericBrowserExtension',
        'BrowserExtensionScript'
    )) {
        if (-not [string]::IsNullOrWhiteSpace($candidate) -and -not $candidates.Contains($candidate)) {
            $candidates.Add($candidate) | Out-Null
        }
    }

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/ImportAppFromTemplate'

    foreach ($templateId in $candidates) {
        try {
            Write-Log ("Trying ImportAppFromTemplate with template ID '{0}'..." -f $templateId) 'Gray'
            $body = @{ ID = @($templateId) }
            $resp = Invoke-IdentityApiWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'ImportAppFromTemplate'

            if (-not $resp.success) {
                throw ('ImportAppFromTemplate returned success=false: ' + ($resp.Message | Out-String))
            }

            $resultItems = @($resp.Result)
            if ($resultItems.Count -lt 1) {
                throw 'ImportAppFromTemplate returned no result items.'
            }

            $rowKey = $null
            foreach ($item in $resultItems) {
                $success = Get-DirectField -Object $item -FieldName 'success'
                $rk1     = Get-DirectField -Object $item -FieldName '_RowKey'
                $rk2     = Get-DirectField -Object $item -FieldName '_Rowkey'
                if ($success -eq $true -and -not [string]::IsNullOrWhiteSpace([string]$rk1)) { $rowKey = [string]$rk1; break }
                if ($success -eq $true -and -not [string]::IsNullOrWhiteSpace([string]$rk2)) { $rowKey = [string]$rk2; break }
            }

            if ([string]::IsNullOrWhiteSpace($rowKey)) {
                throw ("Template '{0}' returned success but no app row key." -f $templateId)
            }

            Write-Log ("Imported new application from template '{0}'. New _RowKey='{1}'." -f $templateId, $rowKey) 'Green'
            Add-ReportRow -Step 'Import App From Template' -Status 'SUCCESS' -Detail ("TemplateID={0}; AppRowKey={1}" -f $templateId, $rowKey)
            return $rowKey
        } catch {
            $msg = $_.Exception.Message
            if ($msg -match 'Unauthorized persisted for ImportAppFromTemplate' -or $msg -match '\(401\).*Unauthorized') {
                throw "ImportAppFromTemplate returned 401 Unauthorized for the interactive admin account. Check the account's effective Application Management rights and the IdentityApiTenantURL value."
            }

            Write-Log ("ImportAppFromTemplate failed for template '{0}': {1}" -f $templateId, $msg) 'Yellow'
        }
    }

    throw 'All ImportAppFromTemplate attempts failed.'
}

function Get-IdentityApplicationDetails {
    param([Parameter(Mandatory)][string]$AppKey)

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/GetApplication?_RowKey=' + [uri]::EscapeDataString($AppKey)
    $resp = Invoke-IdentityApiWithRetry -AbsoluteUris @($uri) -LogicalName 'GetApplication'
    if (-not $resp.success) { throw ('GetApplication failed: ' + ($resp.Message | Out-String)) }
    return $resp.Result
}

function Assert-IdentityWebApp {
    param(
        [Parameter(Mandatory)][object]$AppDetails,
        [Parameter(Mandatory)][string]$Label
    )

    $appTypeDisplay = [string](Get-DirectField -Object $AppDetails -FieldName 'AppTypeDisplayName')
    $appType        = [string](Get-DirectField -Object $AppDetails -FieldName 'AppType')
    $webUPAppType   = [string](Get-DirectField -Object $AppDetails -FieldName 'WebUPAppType')
    $templateName   = [string](Get-DirectField -Object $AppDetails -FieldName 'TemplateName')
    $name           = [string](Get-DirectField -Object $AppDetails -FieldName 'Name')

    $isWeb = $false
    if ($appTypeDisplay -match '^Web') { $isWeb = $true }
    elseif ($appType -eq 'Web')        { $isWeb = $true }
    elseif (-not [string]::IsNullOrWhiteSpace($webUPAppType)) { $isWeb = $true }

    if (-not $isWeb) {
        throw ("{0} is not a Web App. Name='{1}' AppTypeDisplayName='{2}' AppType='{3}' WebUPAppType='{4}' TemplateName='{5}'" -f $Label, $name, $appTypeDisplay, $appType, $webUPAppType, $templateName)
    }

    Write-Log ("Validated {0} as Web App. Name='{1}' Template='{2}' AppTypeDisplayName='{3}' WebUPAppType='{4}'" -f $Label, $name, $templateName, $appTypeDisplay, $webUPAppType) 'Green'
    Add-ReportRow -Step ("Validate {0}" -f $Label) -Status 'SUCCESS' -Detail ("Name={0}; Template={1}; AppTypeDisplayName={2}; WebUPAppType={3}" -f $name, $templateName, $appTypeDisplay, $webUPAppType)
}

function Assert-AppScriptPresent {
    param(
        [Parameter(Mandatory)][object]$AppDetails,
        [Parameter(Mandatory)][string]$ExpectedUrl
    )

    $scriptText = [string](Get-DirectField -Object $AppDetails -FieldName 'CBEScript')
    if ([string]::IsNullOrWhiteSpace($scriptText)) {
        $scriptText = [string](Get-DirectField -Object $AppDetails -FieldName 'UserPassScript')
    }

    if ([string]::IsNullOrWhiteSpace($scriptText)) {
        Write-Log 'WARNING: Updated app does not appear to return CBEScript/UserPassScript in GetApplication.' 'Yellow'
        Add-ReportRow -Step 'Validate Script' -Status 'WARNING' -Detail 'GetApplication did not return CBEScript/UserPassScript.'
        return
    }

    if ($scriptText -notmatch [regex]::Escape($ExpectedUrl)) {
        Write-Log ("WARNING: Updated script does not contain expected applicationUrl '{0}'." -f $ExpectedUrl) 'Yellow'
        Add-ReportRow -Step 'Validate Script' -Status 'WARNING' -Detail ("Expected applicationUrl {0} not found in returned script." -f $ExpectedUrl)
        return
    }

    Write-Log ("Validated Browser Extension script contains expected applicationUrl '{0}'." -f $ExpectedUrl) 'Green'
    Add-ReportRow -Step 'Validate Script' -Status 'SUCCESS' -Detail ("applicationUrl {0} found in returned script." -f $ExpectedUrl)
}

function New-AppUpdatePayloadVariants {
    param(
        [Parameter(Mandatory)][string]$AppKey,
        [Parameter(Mandatory)][object]$Config,
        [Parameter(Mandatory)][string]$RenameTo,
        [Parameter(Mandatory)][string]$DescriptionToUse
    )

    $commonFull = [ordered]@{
        Name                   = $RenameTo
        DisplayName            = $RenameTo
        Description            = $DescriptionToUse
        AppType                = $(if ($Config.AppType) { [string]$Config.AppType } else { 'Web' })
        TemplateName           = [string]$Config.TemplateName
        WebAppType             = [string]$Config.WebAppType
        WebUPAppType           = [string]$Config.WebUPAppType
        UserNameStrategy       = [string]$Config.UserNameStrategy
        OnPrem                 = [bool]$Config.OnPrem
        IsSwsEnabled           = [bool]$Config.IsSwsEnabled
        ShowRegistration       = [bool]$Config.ShowRegistration
        FormFillingEnabled     = [bool]$Config.FormFillingEnabled
        Generic                = [bool]$Config.Generic
        DefaultAuthProfile     = [string]$Config.DefaultAuthProfile
        DefaultAuthProfileInfo = $Config.DefaultAuthProfileInfo
        AuthRules              = $Config.AuthRules
        NotSelfService         = [bool]$Config.NotSelfService
        LocalizationEnabled    = [bool]$Config.LocalizationEnabled
        Notes                  = [string]$Config.Notes
        Category               = [string]$Config.Category
        AdminTag               = [string]$Config.AdminTag
        CBEScript              = [string]$Config.CBEScript
        UserPassScript         = [string]$Config.CBEScript
    }

    if ($Config.PSObject.Properties.Name -contains 'Icon' -and -not [string]::IsNullOrWhiteSpace([string]$Config.Icon)) {
        $commonFull['Icon']    = [string]$Config.Icon
        $commonFull['IconUri'] = [string]$Config.Icon
    }

    $commonMinimal = [ordered]@{
        Name               = $RenameTo
        Description        = $DescriptionToUse
        AppType            = $(if ($Config.AppType) { [string]$Config.AppType } else { 'Web' })
        TemplateName       = [string]$Config.TemplateName
        WebAppType         = [string]$Config.WebAppType
        WebUPAppType       = [string]$Config.WebUPAppType
        UserNameStrategy   = [string]$Config.UserNameStrategy
        IsSwsEnabled       = [bool]$Config.IsSwsEnabled
        FormFillingEnabled = [bool]$Config.FormFillingEnabled
        Generic            = [bool]$Config.Generic
        OnPrem             = [bool]$Config.OnPrem
        DefaultAuthProfile = [string]$Config.DefaultAuthProfile
        AuthRules          = $Config.AuthRules
        NotSelfService     = [bool]$Config.NotSelfService
        CBEScript          = [string]$Config.CBEScript
        UserPassScript     = [string]$Config.CBEScript
    }

    $variants = @()

    foreach ($rowKeyField in @('_Rowkey','_RowKey')) {
        $full = [ordered]@{}
        $full[$rowKeyField] = $AppKey
        foreach ($k in $commonFull.Keys) { $full[$k] = $commonFull[$k] }
        $variants += $full

        $minimal = [ordered]@{}
        $minimal[$rowKeyField] = $AppKey
        foreach ($k in $commonMinimal.Keys) { $minimal[$k] = $commonMinimal[$k] }
        $variants += $minimal
    }

    return $variants
}

function Update-IdentityApplicationFromConfig {
    param(
        [Parameter(Mandatory)][string]$AppKey,
        [Parameter(Mandatory)][object]$Config,
        [Parameter(Mandatory)][string]$RenameTo,
        [Parameter(Mandatory)][string]$DescriptionToUse
    )

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/UpdateApplicationDE'
    $payloads = New-AppUpdatePayloadVariants -AppKey $AppKey -Config $Config -RenameTo $RenameTo -DescriptionToUse $DescriptionToUse

    $attempt = 0
    foreach ($payload in $payloads) {
        $attempt++
        try {
            Write-Log ("Trying UpdateApplicationDE payload attempt #{0}..." -f $attempt) 'Gray'
            $resp = Invoke-IdentityApiWithRetry -AbsoluteUris @($uri) -Body $payload -LogicalName 'UpdateApplicationDE'
            if (-not $resp.success) {
                throw ('UpdateApplicationDE returned success=false: ' + ($resp.Message | Out-String))
            }

            Write-Log ("UpdateApplicationDE succeeded on attempt #{0}." -f $attempt) 'Green'
            Add-ReportRow -Step 'Update Application' -Status 'SUCCESS' -Detail ("Attempt={0}; AppKey={1}" -f $attempt, $AppKey)
            return
        } catch {
            $msg = $_.Exception.Message
            if ($msg -match 'Unauthorized persisted for UpdateApplicationDE' -or $msg -match '\(401\).*Unauthorized') {
                throw "UpdateApplicationDE returned 401 Unauthorized for the interactive admin account. Check effective Application Management rights and IdentityApiTenantURL."
            }

            Write-Log ("UpdateApplicationDE attempt #{0} failed: {1}" -f $attempt, $msg) 'Yellow'
            if ($attempt -eq $payloads.Count) {
                throw
            }
        }
    }
}

# ------------------------------------------------------------
# Permission helpers
# ------------------------------------------------------------
function Find-FirstPropertyValue {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string[]]$Names,
        [int]$Depth = 0,
        [int]$MaxDepth = 8
    )

    if ($null -eq $Object -or $Depth -gt $MaxDepth) { return $null }
    if ($Object -is [string] -or $Object -is [ValueType]) { return $null }

    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($name in $Names) {
            if ($Object.Contains($name) -and $null -ne $Object[$name]) { return $Object[$name] }
        }
        foreach ($key in $Object.Keys) {
            $v = Find-FirstPropertyValue -Object $Object[$key] -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($null -ne $v) { return $v }
        }
        return $null
    }

    if ($Object -is [System.Collections.IEnumerable] -and -not ($Object -is [string])) {
        foreach ($item in $Object) {
            $v = Find-FirstPropertyValue -Object $item -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($null -ne $v) { return $v }
        }
        return $null
    }

    if ($Object.PSObject) {
        foreach ($name in $Names) {
            if ($Object.PSObject.Properties.Name -contains $name) {
                $v = $Object.$name
                if ($null -ne $v -and -not [string]::IsNullOrWhiteSpace([string]$v)) { return $v }
            }
        }

        foreach ($p in $Object.PSObject.Properties) {
            $v = Find-FirstPropertyValue -Object $p.Value -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($null -ne $v) { return $v }
        }
    }

    return $null
}

function Find-GrantArray {
    param(
        [Parameter(Mandatory)]$Object,
        [int]$Depth = 0,
        [int]$MaxDepth = 8
    )

    if ($null -eq $Object -or $Depth -gt $MaxDepth) { return $null }
    if ($Object -is [string] -or $Object -is [ValueType]) { return $null }

    if ($Object -is [System.Collections.IEnumerable] -and -not ($Object -is [string])) {
        $arr = @($Object)
        if ($arr.Count -gt 0) {
            $first = $arr[0]
            $props = @()
            if ($first -is [System.Collections.IDictionary]) {
                $props = @($first.Keys)
            } elseif ($first.PSObject) {
                $props = @($first.PSObject.Properties.Name)
            }

            if (($props -contains 'Principal') -or ($props -contains 'PrincipalId') -or ($props -contains 'Rights') -or (($props -contains 'PType') -and ($props -contains 'Type'))) {
                return $arr
            }
        }

        foreach ($item in $arr) {
            $found = Find-GrantArray -Object $item -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($found) { return $found }
        }
        return $null
    }

    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($key in $Object.Keys) {
            $found = Find-GrantArray -Object $Object[$key] -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($found) { return $found }
        }
        return $null
    }

    if ($Object.PSObject) {
        foreach ($p in $Object.PSObject.Properties) {
            $found = Find-GrantArray -Object $p.Value -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($found) { return $found }
        }
    }

    return $null
}

function Get-AppPermissionState {
    param([Parameter(Mandatory)][string]$AppRowKey)

    $details = Get-IdentityApplicationDetails -AppKey $AppRowKey

    $rowKey = $AppRowKey
    $idVal  = $null
    $pvid   = $null

    $tmpRowKey = Find-FirstPropertyValue -Object $details -Names @('_RowKey','_Rowkey','RowKey')
    if ($tmpRowKey) { $rowKey = [string]$tmpRowKey }

    $tmpId = Find-FirstPropertyValue -Object $details -Names @('ID','AppID')
    if ($tmpId) { $idVal = [string]$tmpId }

    $tmpPvid = Find-FirstPropertyValue -Object $details -Names @('PVID','PVId','PermissionVersionId')
    if ($tmpPvid) { $pvid = [string]$tmpPvid }

    $grants = Find-GrantArray -Object $details

    return [pscustomobject]@{
        Details = $details
        RowKey  = $rowKey
        ID      = $idVal
        PVID    = $pvid
        Grants  = $grants
    }
}

function New-GrantCandidates {
    param([Parameter(Mandatory)][string]$Rights)

    $effectiveSystemName = if ([string]::IsNullOrWhiteSpace($TargetGroupSystemName)) { $TargetGroupDisplayName } else { $TargetGroupSystemName }
    $effectivePrincipal  = if ([string]::IsNullOrWhiteSpace($TargetGroupDisplayName)) { $effectiveSystemName } else { $TargetGroupDisplayName }

    $candidates = @()

    $candidates += [pscustomobject]@{
        Principal            = $effectivePrincipal
        PType                = 'Group'
        Rights               = $Rights
        PrincipalId          = $TargetGroupInternalName
        DirectoryServiceUuid = $TargetGroupDirectoryServiceUuid
        SystemName           = $effectiveSystemName
        Type                 = 'Group'
    }

    $candidates += [pscustomobject]@{
        Principal  = $effectivePrincipal
        PType      = 'Group'
        Rights     = $Rights
        SystemName = $effectiveSystemName
        Type       = 'Group'
    }

    $candidates += [pscustomobject]@{
        Principal = $effectiveSystemName
        PType     = 'Group'
        Rights    = $Rights
        Type      = 'Group'
    }

    return $candidates
}

function Get-MergedGrantSet {
    param(
        [Parameter()][object[]]$ExistingGrants,
        [Parameter(Mandatory)][object]$NewGrant
    )

    if (-not $ExistingGrants -or @($ExistingGrants).Count -lt 1) {
        Write-Log 'No existing grants were discovered. Will try applying only the target group grant.' 'Yellow'
        Add-ReportRow -Step 'Inspect App Permissions' -Status 'INFO' -Detail 'No existing grants discovered; attempting to set only the target group grant.'
        return @($NewGrant)
    }

    $merged = New-Object System.Collections.Generic.List[object]
    $found = $false

    foreach ($g in @($ExistingGrants)) {
        $principalId = [string](Get-DirectField -Object $g -FieldName 'PrincipalId')
        $systemName  = [string](Get-DirectField -Object $g -FieldName 'SystemName')
        $principal   = [string](Get-DirectField -Object $g -FieldName 'Principal')

        $isTarget = $false
        if (-not [string]::IsNullOrWhiteSpace($TargetGroupInternalName) -and $principalId -eq $TargetGroupInternalName) { $isTarget = $true }
        elseif (-not [string]::IsNullOrWhiteSpace($TargetGroupSystemName) -and $systemName -eq $TargetGroupSystemName) { $isTarget = $true }
        elseif (-not [string]::IsNullOrWhiteSpace($TargetGroupDisplayName) -and $principal -eq $TargetGroupDisplayName) { $isTarget = $true }
        elseif (-not [string]::IsNullOrWhiteSpace($TargetGroupSystemName) -and $principal -eq $TargetGroupSystemName) { $isTarget = $true }

        if ($isTarget) {
            $merged.Add($NewGrant) | Out-Null
            $found = $true
        } else {
            $merged.Add($g) | Out-Null
        }
    }

    if (-not $found) {
        $merged.Add($NewGrant) | Out-Null
    }

    return @($merged)
}

function New-SetPermissionsBodies {
    param(
        [Parameter(Mandatory)][object[]]$Grants,
        [Parameter(Mandatory)][object]$State
    )

    $bodies = @()

    $bodies += [ordered]@{
        Grants = $Grants
        ID     = $(if ($State.ID) { $State.ID } else { '' })
        RowKey = $(if ($State.RowKey) { $State.RowKey } else { '' })
        PVID   = $(if ($State.PVID) { $State.PVID } else { '' })
    }

    $bodies += [ordered]@{
        Grants = $Grants
        RowKey = $(if ($State.RowKey) { $State.RowKey } else { '' })
        PVID   = $(if ($State.PVID) { $State.PVID } else { '' })
    }

    $bodies += [ordered]@{
        Grants = $Grants
        RowKey = $(if ($State.RowKey) { $State.RowKey } else { '' })
    }

    return $bodies
}

function Set-ApplicationPermissionsDirectGroup {
    param([Parameter(Mandatory)][string]$AppRowKey)

    $state = Get-AppPermissionState -AppKey $AppRowKey
}

function Get-AppPermissionState {
    param([Parameter(Mandatory)][string]$AppKey)

    $details = Get-IdentityApplicationDetails -AppKey $AppKey

    $rowKey = $AppKey
    $idVal  = $null
    $pvid   = $null

    $tmpRowKey = Find-FirstPropertyValue -Object $details -Names @('_RowKey','_Rowkey','RowKey')
    if ($tmpRowKey) { $rowKey = [string]$tmpRowKey }

    $tmpId = Find-FirstPropertyValue -Object $details -Names @('ID','AppID')
    if ($tmpId) { $idVal = [string]$tmpId }

    $tmpPvid = Find-FirstPropertyValue -Object $details -Names @('PVID','PVId','PermissionVersionId')
    if ($tmpPvid) { $pvid = [string]$tmpPvid }

    $grants = Find-GrantArray -Object $details

    return [pscustomobject]@{
        Details = $details
        RowKey  = $rowKey
        ID      = $idVal
        PVID    = $pvid
        Grants  = $grants
    }
}

function Set-ApplicationPermissionsDirectGroup {
    param([Parameter(Mandatory)][string]$AppRowKey)

    $state = Get-AppPermissionState -AppKey $AppRowKey
    $existingGrantCount = 0
    if ($state.Grants) { $existingGrantCount = @($state.Grants).Count }

    Write-Log ("Discovered app permission metadata. RowKey='{0}' ID='{1}' PVID='{2}' ExistingGrantCount='{3}'" -f $state.RowKey, $state.ID, $state.PVID, $existingGrantCount) 'Gray'
    Add-ReportRow -Step 'Inspect App Permissions' -Status 'SUCCESS' -Detail ("RowKey={0}; ID={1}; PVID={2}; ExistingGrantCount={3}" -f $state.RowKey, $state.ID, $state.PVID, $existingGrantCount)

    $rightsCandidates = @(
        'View,Run,AutoDeploy',
        'View,Run,Automatically Deploy',
        'View,Run,AutomaticallyDeploy'
    )

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/SetApplicationPermissions'

    foreach ($rights in $rightsCandidates) {
        foreach ($grant in (New-GrantCandidates -Rights $rights)) {
            $merged = Get-MergedGrantSet -ExistingGrants @($state.Grants) -NewGrant $grant
            foreach ($body in (New-SetPermissionsBodies -Grants $merged -State $state)) {
                try {
                    Write-Log ("Trying SetApplicationPermissions with Rights='{0}' Principal='{1}' SystemName='{2}'..." -f $rights, $grant.Principal, $grant.SystemName) 'Gray'
                    $resp = Invoke-IdentityApiWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'SetApplicationPermissions'
                    if ($resp.success) {
                        Write-Log ("Direct group permission assignment succeeded for group '{0}' using Rights='{1}'." -f $grant.SystemName, $rights) 'Green'
                        Add-ReportRow -Step 'Set Application Permissions' -Status 'SUCCESS' -Detail ("Group={0}; Rights={1}; RowKey={2}" -f $grant.SystemName, $rights, $state.RowKey)
                        return
                    }
                } catch {
                    $msg = $_.Exception.Message
                    if ($msg -match 'Unauthorized persisted for SetApplicationPermissions' -or $msg -match '\(401\).*Unauthorized') {
                        throw "SetApplicationPermissions returned 401 Unauthorized for the interactive admin account."
                    }

                    Write-Log ("SetApplicationPermissions attempt failed with Rights='{0}' and grant Principal='{1}': {2}" -f $rights, $grant.Principal, $msg) 'Yellow'
                }
            }
        }
    }

    throw 'All SetApplicationPermissions attempts failed. Review the target group metadata and tenant-specific Rights value.'
}

# ------------------------------------------------------------
# MAIN
# ------------------------------------------------------------
$response       = $null
$exportConfig   = $null
$newAppKey      = $null
$createdDetails = $null
$updatedDetails = $null

try {
    if ([string]::IsNullOrWhiteSpace($SourceAppExportJson)) {
        $SourceAppExportJson = Get-DefaultSourceExportJson
    }

    $exportConfig = Get-ExportConfig -JsonText $SourceAppExportJson

    if ([string]::IsNullOrWhiteSpace($NewAppName)) {
        throw 'NewAppName cannot be empty.'
    }
    if ([string]::IsNullOrWhiteSpace($TargetGroupDisplayName) -and [string]::IsNullOrWhiteSpace($TargetGroupSystemName)) {
        throw 'At least one of TargetGroupDisplayName or TargetGroupSystemName must be provided.'
    }
    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        throw 'SafeName cannot be empty.'
    }
    if ([string]::IsNullOrWhiteSpace($AccountName)) {
        throw 'AccountName cannot be empty.'
    }

    $response = Start-PASSessionFromCCP -ObjectName $CCPObject
    $vaultAccount = Find-VaultAccountInSafeOnly -SafeName $SafeName -AccountIdentifier $AccountName

    Start-IdentityInteractiveSession -TenantUrl $IdentityApiTenantURL -UserName $IdentityAdminUserName
    Write-Log "Using interactive non-service Identity admin login for app-management operations." "Yellow"
    Add-ReportRow -Step 'Identity Login Mode' -Status 'INFO' -Detail 'Interactive non-service admin login'

    Write-Log ("Using exported config Name='{0}', TemplateName='{1}', AppType='{2}', WebUPAppType='{3}', IsSwsEnabled='{4}'." -f $exportConfig.Name, $exportConfig.TemplateName, $exportConfig.AppType, $exportConfig.WebUPAppType, $exportConfig.IsSwsEnabled) 'Cyan'
    Add-ReportRow -Step 'Input Summary' -Status 'INFO' -Detail ("SourceAppName={0}; ExportedTemplateName={1}; NewAppName={2}; GroupDisplayName={3}; GroupSystemName={4}; GroupInternalName={5}; GroupDirectoryServiceUuid={6}; SafeName={7}; AccountName={8}; IdentityApiTenantURL={9}" -f $SourceAppName, $exportConfig.TemplateName, $NewAppName, $TargetGroupDisplayName, $TargetGroupSystemName, $TargetGroupInternalName, $TargetGroupDirectoryServiceUuid, $SafeName, $AccountName, $IdentityApiTenantURL)

    if ($WhatIf) {
        Write-Log ("WHATIF: Would import a new app from template candidates based on '{0}'." -f $exportConfig.TemplateName) 'Yellow'
        Add-ReportRow -Step 'Import App From Template' -Status 'WHATIF' -Detail ("TemplateName={0}; Override={1}" -f $exportConfig.TemplateName, $TemplateIdOverride)
    } else {
        $newAppKey = Import-AppFromTemplateAdaptive -Config $exportConfig -TemplateIdOverride $TemplateIdOverride
        $createdDetails = Get-IdentityApplicationDetails -AppKey $newAppKey
        Assert-IdentityWebApp -AppDetails $createdDetails -Label 'Newly Created Application (pre-update)'
    }

    if ($WhatIf) {
        Write-Log ("WHATIF: Would update new app '{0}' with exported Browser Extension configuration." -f $newAppKey) 'Yellow'
        Add-ReportRow -Step 'Update Application' -Status 'WHATIF' -Detail ("AppKey={0}; NewName={1}" -f $newAppKey, $NewAppName)
    } else {
        Update-IdentityApplicationFromConfig -AppKey $newAppKey -Config $exportConfig -RenameTo $NewAppName -DescriptionToUse $AppDescription
        $updatedDetails = Get-IdentityApplicationDetails -AppKey $newAppKey
        Assert-IdentityWebApp -AppDetails $updatedDetails -Label 'Updated Application'
        Assert-AppScriptPresent -AppDetails $updatedDetails -ExpectedUrl 'https://cna.okta.com/login/default'
    }

    if ($WhatIf) {
        Write-Log ("WHATIF: Would add direct app permissions for group '{0}'." -f $(if ($TargetGroupSystemName) { $TargetGroupSystemName } else { $TargetGroupDisplayName })) 'Yellow'
        Add-ReportRow -Step 'Set Application Permissions' -Status 'WHATIF' -Detail ("AppKey={0}; Group={1}" -f $newAppKey, $(if ($TargetGroupSystemName) { $TargetGroupSystemName } else { $TargetGroupDisplayName }))
    } else {
        Set-ApplicationPermissionsDirectGroup -AppRowKey $newAppKey
    }

    Write-Log ("Completed create-from-JSON workflow. New app key='{0}'. PAS account '{1}' in Safe '{2}' was validated and recorded in the report." -f $newAppKey, $AccountName, $SafeName) 'Green'
    Add-ReportRow -Step 'Overall' -Status 'SUCCESS' -Detail ("NewAppKey={0}; Workflow completed." -f $newAppKey)
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Overall' -Status 'FAILED' -Detail $_.Exception.Message
}
finally {
    try {
        $csvDir = Split-Path -Path $ReportCsvPath -Parent
        if ($csvDir -and -not (Test-Path $csvDir)) {
            New-Item -Path $csvDir -ItemType Directory -Force | Out-Null
        }

        if ($script:ReportRows.Count -gt 0) {
            $script:ReportRows | Export-Csv -Path $ReportCsvPath -NoTypeInformation -Force
            Write-Log ("Report exported: {0}" -f $ReportCsvPath) 'Green'
        }
    } catch {
        Write-Log ("Could not export report CSV: {0}" -f $_.Exception.Message) 'Yellow'
    }

    try {
        Close-PASSession | Out-Null
        Write-Log 'PAS session closed.' 'Green'
    } catch {}
}
