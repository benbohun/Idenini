# --- Allow this process to load unsigned modules & unblock psPAS files (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
  try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# Small helper to draw a simple "box" in console
Function Show-Box {
    param([string]$Title, [string]$BodyLine1 = "", [string]$BodyLine2 = "")
    $line = ('=' * 72)
    Write-Host $line -ForegroundColor DarkGray
    if ($Title) { Write-Host ("[ " + $Title + " ]") -ForegroundColor Gray }
    if ($BodyLine1) { Write-Host $BodyLine1 -ForegroundColor Gray }
    if ($BodyLine2) { Write-Host $BodyLine2 -ForegroundColor Gray }
    Write-Host $line -ForegroundColor DarkGray
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log "psPAS loaded ($($mod.Version))." "Green"
} catch {
    Write-Log "❌ psPAS module not found/loaded: $($_.Exception.Message)" "Red"
    exit 1
}

# --- Try to import AD module for OU validation (non-fatal if missing) ---
$ADModuleLoaded = $false
try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $ADModuleLoaded = $true
} catch {
    Write-Log "⚠️ ActiveDirectory module not available; will still try to add group by UPN." "Yellow"
}

# --- Retrieve CyberArk API Credentials from CCP (for CA_PAMDiscovery_SVC) ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safeCCP    = "CA_PCloud_Admins"
$object     = "cna.com-CA_PAMDiscovery_SVC"   # per your request

$headers = @{ "Content-Type" = "application/json" }
$windowsAuth = $false

Write-Log "Retrieving CyberArk API credentials from CCP via Object method..."
$ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$object"
try {
    $response = Invoke-RestMethod $ccpUrl -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response -or -not $response.Content) { throw "Empty CCP response" }
    Write-Log "Successfully retrieved credentials for user: $($response.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch failed - $_" "Red"
    exit 1
}

# --- psPAS Authentication using CCP secret + fixed username (CA_PAMDiscovery_SVC) ---
try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header)..."
    $UPUser = 'CA_PAMDiscovery_SVC'
    $UPPass = ConvertTo-SecureString $response.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    $header = Get-IdentityHeader `
        -IdentityTenantURL "aat4012.id.cyberark.cloud" `
        -psPASFormat `
        -PCloudSubdomain "cna-prod" `
        -UPCreds $UPCred

    Use-PASSession $header

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established" }
    Write-Log "✅ Authentication successful, PAS session established." "Green"
} catch {
    Write-Log "❌ Failed to authenticate via psPAS Identity header: $($_.Exception.Message)" "Red"
    exit 1
}

# --- Prompt for Safe Name & Description (single line up to 200 chars) ---
$SafeName = Read-Host "Enter the Safe Name"
Show-Box -Title "Safe Description" `
        -BodyLine1 "Paste a single-line description for the Safe (max 200 characters)." `
        -BodyLine2 "Example: 'Service accounts for AppX PROD'."
$DescriptionRaw = Read-Host "Enter the Safe Description (single line, up to 200 chars)"

if ([string]::IsNullOrWhiteSpace($SafeName)) {
    Write-Log "❌ ERROR: Safe Name cannot be empty. Exiting..." "Red"
    exit 1
}
if ([string]::IsNullOrWhiteSpace($DescriptionRaw)) {
    Write-Log "❌ ERROR: Safe Description cannot be empty. Exiting..." "Red"
    exit 1
}
$Description = $DescriptionRaw.Trim()
if ($Description.Length -gt 200) {
    Write-Log "ℹ️ Safe Description >200 chars, auto-truncating."
    $Description = $Description.Substring(0,200)
}

# --- Create Safe (always attempt; continue if already exists) ---
$ManagingCPM = "CNA_PASS_MANG"
try {
    Write-Log "🔹 Creating Safe: ${SafeName}..."
    Add-PASSafe -SafeName $SafeName -ManagingCPM $ManagingCPM -Description $Description -NumberOfVersionsRetention 180 -ErrorAction Stop | Out-Null
    Write-Log "✅ Successfully created Safe: ${SafeName}." "Green"
} catch {
    Write-Log "⚠️ Could not create Safe '${SafeName}': $($_.Exception.Message). Continuing to member add..." "Yellow"
}

# --- Permissions ---
$LimitedPermPAS = [PSCustomObject]@{
    UseAccounts                            = $false
    RetrieveAccounts                       = $false
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $false
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $false
    RenameAccounts                         = $false
    DeleteAccounts                         = $false
    UnlockAccounts                         = $true
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}
$FullPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $true
    DeleteAccounts                         = $true
    UnlockAccounts                         = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
    BackupSafe                             = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $true
    DeleteFolders                          = $true
    MoveAccountsAndFolders                 = $true
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}

# --- Target AD Group prompt & validation (in OU=Groups,OU=CyberArk,DC=cna,DC=com) ---
$SearchBaseOU = 'OU=Groups,OU=CyberArk,DC=cna,DC=com'
Function Read-ValidGroup {
    while ($true) {
        $g = Read-Host "Enter the AD Safe Group (sAMAccountName only, e.g., ca_xxx_xxx_prod)"
        if ([string]::IsNullOrWhiteSpace($g)) {
            Write-Log "❌ Group cannot be empty." "Red"
            continue
        }
        if ($g -notmatch '^[A-Za-z0-9_\-\.]+$') {
            Write-Log "❌ Invalid characters in group name. Try again." "Red"
            continue
        }

        if ($ADModuleLoaded) {
            try {
                $adGroup = Get-ADGroup -LDAPFilter "(|(sAMAccountName=$g)(userPrincipalName=$g@cna.com))" -SearchBase $SearchBaseOU -ErrorAction Stop
                if ($adGroup) {
                    Write-Log ("✅ Found AD Group in {0}: {1} (sAM={2})" -f ${SearchBaseOU}, $adGroup.Name, $adGroup.SamAccountName) "Green"
                    return $g
                } else {
                    Write-Log ("❌ Group not found under {0}. Re-enter." -f ${SearchBaseOU}) "Red"
                }
            } catch {
                Write-Log "❌ Error searching AD for '$g' in ${SearchBaseOU}: $($_.Exception.Message)" "Red"
            }
        } else {
            Write-Log "⚠️ AD module not loaded, proceeding with provided group name (will add as UPN)." "Yellow"
            return $g
        }
    }
}
$GroupSam = Read-ValidGroup
$TargetGroupUPN = "$GroupSam@cna.com"

# --- Members (admins unchanged, plus cnarestbot admin) ---
$Members = @(
    @{ Name = $TargetGroupUPN;                     Type = "Group"; Perm = $LimitedPermPAS }, # target AD group (Limited)
    @{ Name = "CA_PCloud_Admins@cna.com";          Type = "Group"; Perm = $FullPermPAS    }, # Full
    @{ Name = "cna_pas_admin@cyberark.cloud.6679"; Type = "User";  Perm = $FullPermPAS    }, # Full
    @{ Name = "cnarestbot@cyberark.cloud.6679";    Type = "User";  Perm = $FullPermPAS    }  # Full (new)
)

# --- Helper: Add member via psPAS, piping permissions ---
Function Add-MemberToSafe {
    param(
        [string]$SafeName,
        [string]$MemberName,
        [ValidateSet("Group","User","Role")]
        [string]$MemberType,
        [pscustomobject]$Permissions
    )
    try {
        Write-Log "Adding ${MemberType} '${MemberName}' to ${SafeName}..."
        $Permissions | Add-PASSafeMember -SafeName $SafeName -MemberType $MemberType -MemberName $MemberName -ErrorAction Stop | Out-Null
        Write-Log "✅ Added ${MemberType}: ${MemberName}." "Green"
        return $true
    } catch {
        Write-Log "❌ Failed to add '${MemberName}' - $($_.Exception.Message)" "Red"
        return $false
    }
}

# --- Add all members ---
foreach ($m in $Members) {
    [void](Add-MemberToSafe -SafeName $SafeName -MemberName $m.Name -MemberType $m.Type -Permissions $m.Perm)
}

# --- Close psPAS session ---
try { Close-PASSession | Out-Null; Write-Log "✅ Session closed." "Green" } catch {}

# ===================================================================
# Re-auth as cnarestbot (client credentials via CCP) & remove discovery user
# ===================================================================

# --- Retrieve credentials for cnarestbot from CCP ---
$object2 = "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"
Write-Log "Retrieving CyberArk API credentials from CCP (cnarestbot)..."
$ccpUrl2 = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$object2"
try {
    $response2 = Invoke-RestMethod $ccpUrl2 -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response2 -or -not $response2.Content) { throw "Empty CCP response for cnarestbot" }
    Write-Log "✅ Successfully retrieved credentials for user: $($response2.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch (cnarestbot) failed - $_" "Red"
    exit 1
}

# --- Identity OAuth2 client_credentials (platformtoken) ---
$IdentityTenantID = "aat4012"
$ClientID         = $response2.Username
$ClientSecret     = $response2.Content

if ([string]::IsNullOrEmpty($ClientID) -or [string]::IsNullOrEmpty($ClientSecret)) {
    Write-Log "❌ ERROR: Client ID or Secret missing for cnarestbot. Exiting..." "Red"
    exit 1
}

Write-Log "Requesting initial CyberArk ISPSS token (client credentials)..."
$TokenURL     = "https://$IdentityTenantID.id.cyberark.cloud/oauth2/platformtoken"
$TokenBody    = @{ grant_type = "client_credentials"; client_id = $ClientID; client_secret = $ClientSecret }
$headersToken = @{ "Content-Type" = "application/x-www-form-urlencoded" }

try {
    $TokenResponse = Invoke-RestMethod -Uri $TokenURL -Method Post -Headers $headersToken -Body $TokenBody
    $BearerToken   = [string]$TokenResponse.access_token
    if ([string]::IsNullOrEmpty($BearerToken) -or $BearerToken.Length -lt 50) {
        Write-Log "❌ ERROR: Received an invalid token. Length: $($BearerToken.Length)" "Red"
        exit
    }
    Write-Log "✅ Authentication successful, token obtained." "Green"
} catch {
    Write-Log "❌ ERROR: Failed to authenticate with CyberArk ISPSS. $_" "Red"
    exit
}

# --- Define REST removal helpers (list members -> find exact name -> delete) ---
$PVWABase = "https://cna-prod.privilegecloud.cyberark.cloud/PasswordVault"
$headers_api = @{
  "Authorization" = "Bearer $BearerToken"
  "Content-Type"  = "application/json"
}

Function Get-SafeMembers {
  param([string]$Safe)
  $members = @()
  foreach ($seg in @("api","API")) {
    $url = "$PVWABase/$seg/Safes/$([uri]::EscapeDataString($Safe))/Members?limit=1000&offset=0"
    try {
      $resp = Invoke-RestMethod -Uri $url -Headers $headers_api -Method Get -ErrorAction Stop
      if ($null -ne $resp) {
        if ($resp.members) { $members = $resp.members }
        elseif ($resp -is [System.Collections.IEnumerable]) { $members = $resp }
        if ($members.Count -gt 0) { break }
      }
    } catch {
      # try next path case
    }
  }
  return $members
}

Function Get-MemberDisplayName {
  param($m)
  foreach ($k in "memberName","MemberName","userName","UserName","Username","name","displayName") {
    if ($m.PSObject.Properties.Name -contains $k -and $m.$k) { return [string]$m.$k }
  }
  return $null
}

Function Find-DiscoveryUserNames {
  param([array]$Members)
  $targets = @(
    'CA_PAMDiscovery_SVC',
    'CA_PAMDiscovery_SVC@cna.com',
    'CNA\CA_PAMDiscovery_SVC'
  )
  $hits = New-Object System.Collections.Generic.List[string]
  foreach ($m in $Members) {
    $disp = Get-MemberDisplayName $m
    if ([string]::IsNullOrWhiteSpace($disp)) { continue }
    foreach ($t in $targets) {
      if ($disp -ieq $t) { $hits.Add($disp); break }
      if ($disp -imatch '^CA_PAMDiscovery_SVC(@.+)?$') { $hits.Add($disp); break }
      if ($disp -ieq 'CNA\CA_PAMDiscovery_SVC') { $hits.Add($disp); break }
    }
  }
  return ($hits | Select-Object -Unique)
}

Function Remove-SafeMemberByExactName {
  param([string]$Safe, [string]$ExactName)
  $encName = [uri]::EscapeDataString($ExactName)
  foreach ($seg in @("api","API")) {
    $url = "$PVWABase/$seg/Safes/$([uri]::EscapeDataString($Safe))/Members/$encName"
    try {
      Invoke-RestMethod -Uri $url -Headers $headers_api -Method Delete -ErrorAction Stop | Out-Null
      Write-Log "✅ Removed '$ExactName' from Safe '$Safe' (path '/$seg')." "Green"
      return $true
    } catch {
      Write-Log "ℹ️ DELETE $url failed for '$ExactName': $($_.Exception.Message)" "Yellow"
    }
  }
  return $false
}

# --- Perform removal of discovery user on the created Safe ---
Write-Log "Enumerating members of Safe '$SafeName'..."
$members = Get-SafeMembers -Safe $SafeName
if (-not $members -or $members.Count -eq 0) {
  Write-Log "❌ No members returned (check token scope or Safe name). Aborting removal." "Red"
} else {
  $targets = Find-DiscoveryUserNames -Members $members
  if ($targets.Count -eq 0) {
    Write-Log "ℹ️ No member matching 'CA_PAMDiscovery_SVC' variants found. Current stored names:" "Yellow"
    foreach ($m in $members) { Write-Log (" - " + (Get-MemberDisplayName $m)) }
  } else {
    foreach ($name in $targets) {
      [void](Remove-SafeMemberByExactName -Safe $SafeName -ExactName $name)
    }
  }
}

Write-Log "✅ Completed Safe creation, member additions, and discovery user cleanup." "Green"
