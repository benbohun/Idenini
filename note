<#
IND_SafeDeletion_Identity.ps1

- Uses SAME login pattern:
    CCP → Identity Shared Services → Service User
- Reads Safe names from CSV
- For each Safe:
    1) Lists all accounts tied to the Safe
    2) Prompts for confirmation
    3) Deletes all accounts
    4) Deletes the Safe
- Abort-safe if user declines
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [string]$CsvPath = "I:\Script\IDENTITY Script New\csv\safes_to_delete.csv",

    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP =====
    [string]$CCPAddress     = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation    = "AIMWebService",
    [string]$CCPAppID       = "ACURestAPI",
    [string]$CCPSafe        = "ACU-VAULT-API",
    [string]$CCPObject      = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth = $false
)

Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# ---- Logging helpers ----
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

# ---- CCP Credential Retrieval (same as your creation script) ----
function Get-ServiceUserCredentialFromCCP {
    param(
        [string]$CCPAddress,
        [string]$Location,
        [string]$AppID,
        [string]$Safe,
        [string]$Object,
        [bool]$WindowsAuth
    )

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $Location.Trim('/'),
        $AppID,
        $Safe,
        $Object

    Write-Info "Retrieving Service User credential from CCP"
    $resp = Invoke-RestMethod -Uri $url -Method GET -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "Invalid CCP response"
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"
    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# ---- Confirmation Prompt ----
function Confirm-Deletion {
    param(
        [string]$SafeName,
        [int]$AccountCount
    )

    Write-Host ""
    Write-Warn "Safe: $SafeName"
    Write-Warn "Accounts found: $AccountCount"
    Write-Warn "This will DELETE ALL accounts and the Safe."
    Write-Host ""

    $choice = Read-Host "Type YES to proceed, anything else to abort"
    return ($choice -eq "YES")
}

# ---- Process One Safe ----
function Process-SafeDeletion {
    param([string]$SafeName)

    Write-Info "Processing Safe: $SafeName"

    # Verify Safe exists
    $safe = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue
    if (-not $safe) {
        Write-Warn "Safe '$SafeName' not found. Skipping."
        return
    }

    # List accounts
    $accounts = Get-PASAccount -SafeName $SafeName -ErrorAction SilentlyContinue
    $count = ($accounts | Measure-Object).Count

    if ($count -gt 0) {
        Write-Info "Accounts tied to '$SafeName':"
        $accounts | ForEach-Object {
            Write-Host ("  - {0} @ {1} (ID={2})" -f $_.UserName, $_.Address, $_.id)
        }
    }
    else {
        Write-Info "No accounts found in '$SafeName'."
    }

    if (-not (Confirm-Deletion -SafeName $SafeName -AccountCount $count)) {
        Write-Warn "Deletion aborted by user for '$SafeName'."
        return
    }

    # Delete accounts first
    foreach ($acct in $accounts) {
        if ($PSCmdlet.ShouldProcess("$($acct.UserName)@$($acct.Address)", "Remove-PASAccount")) {
            try {
                Remove-PASAccount -AccountID $acct.id -ErrorAction Stop
                Write-Ok "Deleted account: $($acct.UserName) @ $($acct.Address)"
            }
            catch {
                Write-Err "Failed deleting account $($acct.UserName): $($_.Exception.Message)"
                throw
            }
        }
    }

    # Delete Safe
    if ($PSCmdlet.ShouldProcess($SafeName, "Remove-PASSafe")) {
        try {
            Remove-PASSafe -SafeName $SafeName -ErrorAction Stop
            Write-Ok "Deleted Safe '$SafeName'"
        }
        catch {
            Write-Err "Failed deleting Safe '$SafeName': $($_.Exception.Message)"
        }
    }
}

# ---- MAIN ----
$sessionCreated = $false

try {
    if (-not (Test-Path $CsvPath)) {
        throw "CSV not found: $CsvPath"
    }

    $rows = Import-Csv $CsvPath
    if (-not $rows) {
        throw "CSV is empty."
    }

    $cred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Write-Info "Authenticating via Identity Shared Services..."
    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $cred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $sessionCreated = $true
    Write-Ok "Authenticated as service user: $($cred.UserName)"

    foreach ($row in $rows) {
        Process-SafeDeletion -SafeName $row.SafeName.Trim()
    }

    Write-Ok "Safe deletion processing completed."
}
catch {
    Write-Err $_
}
finally {
    if ($sessionCreated) {
        Close-PASSession | Out-Null
        Write-Ok "Logged off."
    }
}
