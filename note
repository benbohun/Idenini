<#
.SYNOPSIS
    Compares a CyberArk CSV containing Username and Address against an
    Active Directory CSV containing distinguished names in the Username column.

.CYBERARK CSV FORMAT
    Username,Address

.AD CSV FORMAT
    Username

.AD EXAMPLE
    CN=SVCCWFDDI=Service,OU=Accounts,DC=prod,DC=mtb,DC=com

.DERIVED AD VALUES
    Username: SVCCWFDDI
    Address : prod.mtb.com

.CYBERARK UNIQUENESS
    Because no CyberArk Account ID is provided, each CyberArk CSV row receives
    a generated identifier such as CA-000001.

.NOTES
    Compatible with Windows PowerShell 5.1.
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $false)]
    [string]$CyberArkCsvPath,

    [Parameter(Mandatory = $false)]
    [string]$ADCsvPath,

    [Parameter(Mandatory = $false)]
    [string]$OutputFolder
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

# ============================================================
# Logging
# ============================================================

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [ValidateSet('INFO', 'WARNING', 'ERROR', 'SUCCESS')]
        [string]$Level = 'INFO'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    Write-Host "$timestamp | $Level | $Message"
}

# ============================================================
# CSV file selection
# ============================================================

function Select-CsvFile {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Title
    )

    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop

        $dialog = New-Object System.Windows.Forms.OpenFileDialog
        $dialog.Title = $Title
        $dialog.Filter = 'CSV files (*.csv)|*.csv|All files (*.*)|*.*'
        $dialog.Multiselect = $false
        $dialog.CheckFileExists = $true
        $dialog.CheckPathExists = $true

        if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            return $dialog.FileName
        }
    }
    catch {
        Write-Log `
            -Level 'WARNING' `
            -Message 'Graphical file selection is unavailable.'
    }

    $selectedPath = Read-Host "$Title - enter the complete CSV path"

    if ([string]::IsNullOrWhiteSpace($selectedPath)) {
        throw 'No CSV file was selected.'
    }

    return $selectedPath.Trim().Trim('"')
}

# ============================================================
# CSV column detection
# ============================================================

function ConvertTo-ColumnKey {
    param(
        [AllowNull()]
        [string]$Name
    )

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return ''
    }

    return ($Name.ToLowerInvariant() -replace '[^a-z0-9]', '')
}

function Find-ColumnName {
    param(
        [Parameter(Mandatory = $true)]
        [object]$SampleRow,

        [Parameter(Mandatory = $true)]
        [string[]]$AcceptedNames,

        [Parameter(Mandatory = $true)]
        [string]$Description
    )

    $availableColumns = @($SampleRow.PSObject.Properties.Name)

    foreach ($acceptedName in $AcceptedNames) {
        $acceptedKey = ConvertTo-ColumnKey -Name $acceptedName

        foreach ($columnName in $availableColumns) {
            $columnKey = ConvertTo-ColumnKey -Name $columnName

            if ($columnKey -eq $acceptedKey) {
                return $columnName
            }
        }
    }

    throw "Could not find the $Description column. Available columns: $($availableColumns -join ', ')"
}

# ============================================================
# Text cleanup
# ============================================================

function Remove-OuterCharacters {
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    $result = $Value.Trim()
    $result = $result.Trim('"')
    $result = $result.Trim("'")
    $result = $result.Trim('`')

    $result = $result -replace '^[^a-zA-Z0-9]+', ''
    $result = $result -replace '[^a-zA-Z0-9$_.-]+$', ''

    return $result.Trim()
}

function Get-CompactUsername {
    param(
        [AllowNull()]
        [string]$Username
    )

    if ([string]::IsNullOrWhiteSpace($Username)) {
        return ''
    }

    return ($Username.ToLowerInvariant() -replace '[^a-z0-9]', '')
}

function Get-NormalizedUsername {
    param(
        [AllowNull()]
        [string]$Username
    )

    if ([string]::IsNullOrWhiteSpace($Username)) {
        return ''
    }

    $value = Remove-OuterCharacters -Value $Username

    if ([string]::IsNullOrWhiteSpace($value)) {
        return ''
    }

    # DOMAIN\Username or DOMAIN/Username
    if ($value -match '[\\/]') {
        $parts = @(
            [regex]::Split($value, '[\\/]+') |
                Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_)
                }
        )

        if ($parts.Count -gt 0) {
            $value = $parts[$parts.Count - 1]
        }
    }

    # Username@domain.com
    if ($value.Contains('@')) {
        $value = ($value -split '@', 2)[0]
    }

    $value = Remove-OuterCharacters -Value $value

    return $value.ToLowerInvariant()
}

# ============================================================
# Address cleanup
# ============================================================

function Get-NormalizedAddress {
    param(
        [AllowNull()]
        [string]$Address
    )

    if ([string]::IsNullOrWhiteSpace($Address)) {
        return ''
    }

    $value = $Address.Trim()
    $value = $value.Trim('"')
    $value = $value.Trim("'")
    $value = $value.ToLowerInvariant()

    $value = $value -replace '^https?://', ''
    $value = $value -replace '^\\\\', ''
    $value = $value -replace '^//', ''

    # Remove a port, such as server.domain.com:443.
    if ($value -match '^[^:]+:\d+$') {
        $value = ($value -split ':', 2)[0]
    }

    # Remove paths after a hostname.
    if ($value.Contains('/')) {
        $value = ($value -split '/', 2)[0]
    }

    if ($value.Contains('\')) {
        $value = ($value -split '\\', 2)[0]
    }

    return $value.TrimEnd('.', '/', '\', ' ')
}

function Get-ShortAddress {
    param(
        [AllowNull()]
        [string]$Address
    )

    $normalizedAddress = Get-NormalizedAddress -Address $Address

    if ([string]::IsNullOrWhiteSpace($normalizedAddress)) {
        return ''
    }

    if ($normalizedAddress.Contains('.')) {
        return ($normalizedAddress -split '\.', 2)[0]
    }

    return $normalizedAddress
}

# ============================================================
# Parse AD distinguished name
# ============================================================

function ConvertFrom-ADUsernameField {
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return [PSCustomObject]@{
            OriginalValue   = $Value
            DerivedUsername = ''
            DerivedAddress  = ''
            ParseMethod     = 'Blank'
            ParseWarning    = 'The AD Username field was blank.'
        }
    }

    $originalValue = $Value
    $value = $Value.Trim().Trim('"').Trim("'")

    $derivedUsername = ''
    $derivedAddress = ''
    $parseMethod = ''
    $parseWarning = ''

    $isDistinguishedName = (
        $value -match '(?i)(^|,)\s*CN\s*=' -or
        $value -match '(?i)(^|,)\s*DC\s*='
    )

    if ($isDistinguishedName) {
        # Split on commas that are not escaped.
        $dnParts = @(
            [regex]::Split($value, '(?<!\\),')
        )

        $cnValue = ''

        foreach ($dnPart in $dnParts) {
            if ($dnPart -match '^\s*CN\s*=(.*)$') {
                $cnValue = $Matches[1].Trim()
                break
            }
        }

        if (-not [string]::IsNullOrWhiteSpace($cnValue)) {
            $cnValue = $cnValue.Replace('\,', ',')
            $cnValue = $cnValue.Replace('\=', '=')
            $cnValue = $cnValue.Replace('\\', '\')

            # Example:
            # SVCCWFDDI=Service -> SVCCWFDDI
            if ($cnValue.Contains('=')) {
                $derivedUsername = ($cnValue -split '=', 2)[0]
                $parseMethod = 'CN value before descriptive equals suffix'
            }
            else {
                $derivedUsername = $cnValue
                $parseMethod = 'CN value'
            }
        }
        else {
            $parseWarning = 'No CN component was found.'
        }

        $domainComponents = New-Object System.Collections.Generic.List[string]

        foreach ($dnPart in $dnParts) {
            if ($dnPart -match '^\s*DC\s*=(.*)$') {
                $dcValue = $Matches[1].Trim()
                $dcValue = $dcValue.Replace('\,', ',')
                $dcValue = $dcValue.Replace('\=', '=')

                if (-not [string]::IsNullOrWhiteSpace($dcValue)) {
                    $domainComponents.Add($dcValue)
                }
            }
        }

        if ($domainComponents.Count -gt 0) {
            $derivedAddress = $domainComponents -join '.'
        }
        elseif ([string]::IsNullOrWhiteSpace($parseWarning)) {
            $parseWarning = 'No DC components were found.'
        }
    }
    else {
        $derivedUsername = Get-NormalizedUsername -Username $value
        $parseMethod = 'Plain username'
        $parseWarning = 'The value was not formatted as a distinguished name; no address was derived.'
    }

    $derivedUsername = Remove-OuterCharacters -Value $derivedUsername

    return [PSCustomObject]@{
        OriginalValue   = $originalValue
        DerivedUsername = $derivedUsername
        DerivedAddress  = $derivedAddress.ToLowerInvariant()
        ParseMethod     = $parseMethod
        ParseWarning    = $parseWarning
    }
}

# ============================================================
# CyberArk username candidate extraction
# ============================================================

function Add-UsernameCandidate {
    param(
        [Parameter(Mandatory = $true)]
        [System.Collections.ArrayList]$CandidateList,

        [Parameter(Mandatory = $true)]
        [hashtable]$SeenCandidates,

        [AllowNull()]
        [string]$Value,

        [Parameter(Mandatory = $true)]
        [string]$Source
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return
    }

    $cleanedValue = Remove-OuterCharacters -Value $Value

    if ([string]::IsNullOrWhiteSpace($cleanedValue)) {
        return
    }

    $normalizedValue = $cleanedValue.ToLowerInvariant()
    $compactValue = Get-CompactUsername -Username $cleanedValue

    if ($compactValue.Length -lt 2) {
        return
    }

    $stopWords = @{
        'service'         = $true
        'services'        = $true
        'account'         = $true
        'accounts'        = $true
        'serviceaccount'  = $true
        'serviceaccounts' = $true
        'sql'             = $true
        'oracle'          = $true
        'windows'         = $true
        'linux'           = $true
        'database'        = $true
        'description'     = $true
        'production'      = $true
        'development'     = $true
        'prod'            = $true
        'dev'             = $true
        'cert'            = $true
        'domain'          = $true
        'cyberark'        = $true
        'credential'      = $true
        'credentials'     = $true
    }

    if ($stopWords.ContainsKey($compactValue)) {
        return
    }

    $candidateKey = "$normalizedValue|$compactValue"

    if ($SeenCandidates.ContainsKey($candidateKey)) {
        return
    }

    $SeenCandidates[$candidateKey] = $true

    [void]$CandidateList.Add(
        [PSCustomObject]@{
            CandidateUsername  = $cleanedValue
            NormalizedUsername = $normalizedValue
            CompactUsername    = $compactValue
            CandidateSource    = $Source
        }
    )
}

function Get-CyberArkUsernameCandidates {
    param(
        [AllowNull()]
        [string]$Username
    )

    $candidates = New-Object System.Collections.ArrayList
    $seenCandidates = @{}
    $processedValues = @{}
    $queue = New-Object System.Collections.ArrayList

    if ([string]::IsNullOrWhiteSpace($Username)) {
        return @()
    }

    [void]$queue.Add(
        [PSCustomObject]@{
            Value  = $Username
            Source = 'Original CyberArk username'
        }
    )

    $queuePosition = 0

    while (
        $queuePosition -lt $queue.Count -and
        $queuePosition -lt 100
    ) {
        $queueItem = $queue[$queuePosition]
        $queuePosition++

        $currentValue = [string]$queueItem.Value
        $currentSource = [string]$queueItem.Source

        if ([string]::IsNullOrWhiteSpace($currentValue)) {
            continue
        }

        $currentValue = $currentValue.Trim().Trim('"').Trim("'")
        $processedKey = $currentValue.ToLowerInvariant()

        if ($processedValues.ContainsKey($processedKey)) {
            continue
        }

        $processedValues[$processedKey] = $true

        Add-UsernameCandidate `
            -CandidateList $candidates `
            -SeenCandidates $seenCandidates `
            -Value $currentValue `
            -Source $currentSource

        # SVCWDBSQLAGC_:_SQL_SERVICE_ACCOUNTS
        if ($currentValue -match '\s*_+\s*:\s*_+\s*') {
            $parts = @(
                [regex]::Split(
                    $currentValue,
                    '\s*_+\s*:\s*_+\s*'
                )
            )

            if ($parts.Count -gt 0) {
                [void]$queue.Add(
                    [PSCustomObject]@{
                        Value  = $parts[0]
                        Source = 'Before CyberArk descriptive suffix'
                    }
                )
            }
        }

        # DOMAIN\Username or DOMAIN/Username
        if ($currentValue -match '[\\/]') {
            $slashParts = @(
                [regex]::Split($currentValue, '[\\/]+') |
                    Where-Object {
                        -not [string]::IsNullOrWhiteSpace($_)
                    }
            )

            if ($slashParts.Count -gt 0) {
                [void]$queue.Add(
                    [PSCustomObject]@{
                        Value  = $slashParts[$slashParts.Count - 1]
                        Source = 'Domain or path removed'
                    }
                )
            }

            foreach ($slashPart in $slashParts) {
                [void]$queue.Add(
                    [PSCustomObject]@{
                        Value  = $slashPart
                        Source = 'Slash-delimited section'
                    }
                )
            }
        }

        # Username@domain.com
        if ($currentValue.Contains('@')) {
            $upnParts = $currentValue -split '@', 2

            if ($upnParts.Count -gt 0) {
                [void]$queue.Add(
                    [PSCustomObject]@{
                        Value  = $upnParts[0]
                        Source = 'UPN suffix removed'
                    }
                )
            }
        }

        # Account name before bracketed description.
        if ($currentValue -match '^([^\(\[\{]+)[\(\[\{]') {
            [void]$queue.Add(
                [PSCustomObject]@{
                    Value  = $Matches[1]
                    Source = 'Bracketed description removed'
                }
            )
        }

        # Split other special-character formats.
        $specialParts = @(
            [regex]::Split(
                $currentValue,
                '[\|\;\,\:\=\(\)\[\]\{\}\s]+'
            ) |
                Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_)
                }
        )

        if ($specialParts.Count -gt 1) {
            foreach ($specialPart in $specialParts) {
                [void]$queue.Add(
                    [PSCustomObject]@{
                        Value  = $specialPart
                        Source = 'Special-character section'
                    }
                )
            }
        }
    }

    return @($candidates)
}

# ============================================================
# Username similarity
# ============================================================

function Get-LevenshteinDistance {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Source,

        [Parameter(Mandatory = $true)]
        [string]$Target
    )

    if ($Source.Length -eq 0) {
        return $Target.Length
    }

    if ($Target.Length -eq 0) {
        return $Source.Length
    }

    $rows = $Source.Length + 1
    $columns = $Target.Length + 1
    $matrix = New-Object 'int[,]' $rows, $columns

    for ($row = 0; $row -lt $rows; $row++) {
        $matrix[$row, 0] = $row
    }

    for ($column = 0; $column -lt $columns; $column++) {
        $matrix[0, $column] = $column
    }

    for ($row = 1; $row -lt $rows; $row++) {
        for ($column = 1; $column -lt $columns; $column++) {
            $cost = 1

            if ($Source[$row - 1] -eq $Target[$column - 1]) {
                $cost = 0
            }

            $deletion = $matrix[$row - 1, $column] + 1
            $insertion = $matrix[$row, $column - 1] + 1
            $substitution = $matrix[$row - 1, $column - 1] + $cost

            $matrix[$row, $column] = [Math]::Min(
                [Math]::Min($deletion, $insertion),
                $substitution
            )
        }
    }

    return $matrix[$Source.Length, $Target.Length]
}

function Get-UsernameSimilarity {
    param(
        [AllowNull()]
        [string]$FirstUsername,

        [AllowNull()]
        [string]$SecondUsername
    )

    $first = Get-CompactUsername -Username $FirstUsername
    $second = Get-CompactUsername -Username $SecondUsername

    if (
        [string]::IsNullOrWhiteSpace($first) -or
        [string]::IsNullOrWhiteSpace($second)
    ) {
        return 0
    }

    if ($first -eq $second) {
        return 1
    }

    $maximumLength = [Math]::Max(
        $first.Length,
        $second.Length
    )

    if ($maximumLength -eq 0) {
        return 1
    }

    $distance = Get-LevenshteinDistance `
        -Source $first `
        -Target $second

    return [Math]::Round(
        1 - ($distance / [double]$maximumLength),
        4
    )
}

# ============================================================
# Address evaluation
# ============================================================

function Get-AddressEvaluation {
    param(
        [AllowNull()]
        [string]$CyberArkAddress,

        [AllowNull()]
        [string]$ADAddress
    )

    $caAddress = Get-NormalizedAddress -Address $CyberArkAddress
    $adAddress = Get-NormalizedAddress -Address $ADAddress

    if (
        [string]::IsNullOrWhiteSpace($caAddress) -and
        [string]::IsNullOrWhiteSpace($adAddress)
    ) {
        return [PSCustomObject]@{
            Method    = 'Both addresses blank'
            Score     = 0
            IsExact   = $false
            IsRelated = $false
        }
    }

    if (
        [string]::IsNullOrWhiteSpace($caAddress) -or
        [string]::IsNullOrWhiteSpace($adAddress)
    ) {
        return [PSCustomObject]@{
            Method    = 'One address blank'
            Score     = 0
            IsExact   = $false
            IsRelated = $false
        }
    }

    if ($caAddress -eq $adAddress) {
        return [PSCustomObject]@{
            Method    = 'Exact address'
            Score     = 30
            IsExact   = $true
            IsRelated = $true
        }
    }

    $caShortAddress = Get-ShortAddress -Address $caAddress
    $adShortAddress = Get-ShortAddress -Address $adAddress

    if (
        -not [string]::IsNullOrWhiteSpace($caShortAddress) -and
        $caShortAddress -eq $adShortAddress
    ) {
        return [PSCustomObject]@{
            Method    = 'Short address or FQDN match'
            Score     = 20
            IsExact   = $false
            IsRelated = $true
        }
    }

    if (
        $caAddress.EndsWith(".$adAddress") -or
        $adAddress.EndsWith(".$caAddress")
    ) {
        return [PSCustomObject]@{
            Method    = 'Related DNS address'
            Score     = 15
            IsExact   = $false
            IsRelated = $true
        }
    }

    return [PSCustomObject]@{
        Method    = 'Different address'
        Score     = 0
        IsExact   = $false
        IsRelated = $false
    }
}

# ============================================================
# Match evaluation
# ============================================================

function Get-MatchEvaluation {
    param(
        [Parameter(Mandatory = $true)]
        [object]$CyberArkCandidate,

        [Parameter(Mandatory = $true)]
        [object]$CyberArkRecord,

        [Parameter(Mandatory = $true)]
        [object]$ADRecord
    )

    $caNormalized = $CyberArkCandidate.NormalizedUsername
    $caCompact = $CyberArkCandidate.CompactUsername

    $adNormalized = $ADRecord.NormalizedUsername
    $adCompact = $ADRecord.CompactUsername

    $usernameMethod = 'No username match'
    $usernameScore = 0
    $similarity = 0

    if (
        -not [string]::IsNullOrWhiteSpace($caNormalized) -and
        $caNormalized -eq $adNormalized
    ) {
        $usernameMethod = 'Exact after username extraction'
        $usernameScore = 70
        $similarity = 1
    }
    elseif (
        -not [string]::IsNullOrWhiteSpace($caCompact) -and
        $caCompact -eq $adCompact
    ) {
        $usernameMethod = 'Exact after special-character removal'
        $usernameScore = 62
        $similarity = 1
    }
    elseif (
        $caCompact.Length -ge 6 -and
        $adCompact.Length -ge 6 -and
        (
            $caCompact.StartsWith($adCompact) -or
            $adCompact.StartsWith($caCompact)
        )
    ) {
        $shortLength = [Math]::Min(
            $caCompact.Length,
            $adCompact.Length
        )

        $longLength = [Math]::Max(
            $caCompact.Length,
            $adCompact.Length
        )

        $lengthRatio = $shortLength / [double]$longLength

        if ($lengthRatio -ge 0.75) {
            $usernameMethod = 'Username prefix or suffix variation'
            $usernameScore = 48
            $similarity = $lengthRatio
        }
    }

    if ($usernameScore -eq 0) {
        $similarity = Get-UsernameSimilarity `
            -FirstUsername $caCompact `
            -SecondUsername $adCompact

        if (
            $caCompact.Length -ge 6 -and
            $adCompact.Length -ge 6 -and
            $similarity -ge 0.88
        ) {
            $usernameMethod = 'High username similarity'
            $usernameScore = 45
        }
    }

    $addressEvaluation = Get-AddressEvaluation `
        -CyberArkAddress $CyberArkRecord.Address `
        -ADAddress $ADRecord.DerivedAddress

    $totalScore = $usernameScore + $addressEvaluation.Score
    $matchStatus = 'Unmatched'
    $matchReason = 'Username and address did not meet the matching threshold.'

    if (
        $usernameMethod -eq 'Exact after username extraction' -and
        $addressEvaluation.IsExact
    ) {
        $matchStatus = 'Matched'
        $totalScore = 100
        $matchReason = 'CyberArk username and AD-derived address matched exactly.'
    }
    elseif (
        $usernameMethod -eq 'Exact after username extraction' -and
        $addressEvaluation.IsRelated
    ) {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 90)
        $matchReason = 'Username matched exactly and the addresses appear related.'
    }
    elseif ($usernameMethod -eq 'Exact after username extraction') {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 78)
        $matchReason = 'Username matched exactly, but the addresses differ.'
    }
    elseif (
        $usernameMethod -eq 'Exact after special-character removal' -and
        $addressEvaluation.IsExact
    ) {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 92)
        $matchReason = 'Usernames matched after special-character removal and addresses matched.'
    }
    elseif (
        $usernameMethod -eq 'Exact after special-character removal' -and
        $addressEvaluation.IsRelated
    ) {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 84)
        $matchReason = 'Usernames matched after special-character removal and addresses appear related.'
    }
    elseif (
        (
            $usernameMethod -eq 'Username prefix or suffix variation' -or
            $usernameMethod -eq 'High username similarity'
        ) -and
        $addressEvaluation.IsExact
    ) {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 75)
        $matchReason = 'Usernames are highly similar and addresses matched exactly.'
    }
    elseif (
        (
            $usernameMethod -eq 'Username prefix or suffix variation' -or
            $usernameMethod -eq 'High username similarity'
        ) -and
        $addressEvaluation.IsRelated
    ) {
        $matchStatus = 'Likely Matched'
        $totalScore = [Math]::Max($totalScore, 70)
        $matchReason = 'Usernames and addresses appear related and require review.'
    }

    return [PSCustomObject]@{
        MatchStatus       = $matchStatus
        ConfidenceScore   = [Math]::Min([int]$totalScore, 100)
        MatchReason       = $matchReason
        UsernameMethod    = $usernameMethod
        AddressMethod     = $addressEvaluation.Method
        SimilarityPercent = [Math]::Round($similarity * 100, 2)
    }
}

# ============================================================
# Add unique AD candidates
# ============================================================

function Add-UniqueADRecords {
    param(
        [Parameter(Mandatory = $true)]
        [System.Collections.ArrayList]$TargetList,

        [Parameter(Mandatory = $true)]
        [hashtable]$SeenRecords,

        [AllowNull()]
        [object[]]$Records
    )

    foreach ($record in @($Records)) {
        if ($null -eq $record) {
            continue
        }

        $recordNumber = [int]$record.RecordNumber

        if (-not $SeenRecords.ContainsKey($recordNumber)) {
            $SeenRecords[$recordNumber] = $true
            [void]$TargetList.Add($record)
        }
    }
}

# ============================================================
# Export helper
# ============================================================

function Export-ResultSet {
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Data,

        [Parameter(Mandatory = $true)]
        [string]$Path,

        [Parameter(Mandatory = $true)]
        [string[]]$Columns
    )

    if (@($Data).Count -gt 0) {
        $Data |
            Select-Object -Property $Columns |
            Export-Csv `
                -LiteralPath $Path `
                -NoTypeInformation `
                -Encoding UTF8
    }
    else {
        $header = @(
            foreach ($column in $Columns) {
                '"' + ($column -replace '"', '""') + '"'
            }
        ) -join ','

        Set-Content `
            -LiteralPath $Path `
            -Value $header `
            -Encoding UTF8
    }
}

# ============================================================
# Main
# ============================================================

try {
    Write-Host
    Write-Log -Message ('=' * 72)
    Write-Log -Message 'CyberArk and AD account comparison starting.'
    Write-Log -Message ('=' * 72)

    if ([string]::IsNullOrWhiteSpace($CyberArkCsvPath)) {
        $CyberArkCsvPath = Select-CsvFile `
            -Title 'Select CyberArk CSV: Username and Address'
    }

    if ([string]::IsNullOrWhiteSpace($ADCsvPath)) {
        $ADCsvPath = Select-CsvFile `
            -Title 'Select AD CSV containing the Username distinguished-name column'
    }

    $CyberArkCsvPath = $CyberArkCsvPath.Trim().Trim('"')
    $ADCsvPath = $ADCsvPath.Trim().Trim('"')

    if (-not (Test-Path -LiteralPath $CyberArkCsvPath -PathType Leaf)) {
        throw "CyberArk CSV was not found: $CyberArkCsvPath"
    }

    if (-not (Test-Path -LiteralPath $ADCsvPath -PathType Leaf)) {
        throw "AD CSV was not found: $ADCsvPath"
    }

    if ([string]::IsNullOrWhiteSpace($OutputFolder)) {
        $OutputFolder = Split-Path -Parent $CyberArkCsvPath
    }

    if (-not (Test-Path -LiteralPath $OutputFolder -PathType Container)) {
        New-Item `
            -Path $OutputFolder `
            -ItemType Directory `
            -Force |
            Out-Null
    }

    # --------------------------------------------------------
    # Import CSV files
    # --------------------------------------------------------

    $cyberArkCsv = @(
        Import-Csv -LiteralPath $CyberArkCsvPath
    )

    $adCsv = @(
        Import-Csv -LiteralPath $ADCsvPath
    )

    if ($cyberArkCsv.Count -eq 0) {
        throw 'The CyberArk CSV contains no records.'
    }

    if ($adCsv.Count -eq 0) {
        throw 'The AD CSV contains no records.'
    }

    # --------------------------------------------------------
    # Detect columns
    # --------------------------------------------------------

    $caUsernameColumn = Find-ColumnName `
        -SampleRow $cyberArkCsv[0] `
        -AcceptedNames @(
            'Username',
            'User Name',
            'CyberArk Username'
        ) `
        -Description 'CyberArk Username'

    $caAddressColumn = Find-ColumnName `
        -SampleRow $cyberArkCsv[0] `
        -AcceptedNames @(
            'Address',
            'CyberArk Address',
            'Machine Address',
            'Domain',
            'Host',
            'Hostname'
        ) `
        -Description 'CyberArk Address'

    $adUsernameColumn = Find-ColumnName `
        -SampleRow $adCsv[0] `
        -AcceptedNames @(
            'Username',
            'User Name',
            'Distinguished Name',
            'DistinguishedName',
            'DN'
        ) `
        -Description 'AD Username'

    Write-Log -Message "CyberArk records loaded : $($cyberArkCsv.Count)"
    Write-Log -Message "AD records loaded       : $($adCsv.Count)"
    Write-Log -Message "CyberArk username column: $caUsernameColumn"
    Write-Log -Message "CyberArk address column : $caAddressColumn"
    Write-Log -Message "AD source column        : $adUsernameColumn"

    # --------------------------------------------------------
    # Prepare CyberArk rows and generate row identifiers
    # --------------------------------------------------------

    $preparedCyberArkRecords = New-Object System.Collections.Generic.List[object]
    $compositeKeyCounts = @{}
    $cyberArkSourceRow = 0

    foreach ($cyberArkRow in $cyberArkCsv) {
        $cyberArkSourceRow++

        $cyberArkUsername = [string]$cyberArkRow.$caUsernameColumn
        $cyberArkAddress = [string]$cyberArkRow.$caAddressColumn

        $normalizedAddress = Get-NormalizedAddress `
            -Address $cyberArkAddress

        $normalizedRawUsername = $cyberArkUsername.Trim().ToLowerInvariant()

        $compositeKey = "$normalizedRawUsername|$normalizedAddress"

        if (-not $compositeKeyCounts.ContainsKey($compositeKey)) {
            $compositeKeyCounts[$compositeKey] = 0
        }

        $compositeKeyCounts[$compositeKey]++

        $preparedCyberArkRecords.Add(
            [PSCustomObject]@{
                SourceRow             = $cyberArkSourceRow
                CyberArkRecordID      = 'CA-{0:D6}' -f $cyberArkSourceRow
                Username              = $cyberArkUsername
                Address               = $cyberArkAddress
                NormalizedAddress     = $normalizedAddress
                ShortAddress          = Get-ShortAddress -Address $cyberArkAddress
                CyberArkCompositeKey  = $compositeKey
            }
        )
    }

    $compositeOccurrenceCounts = @{}

    foreach ($record in $preparedCyberArkRecords) {
        $key = $record.CyberArkCompositeKey

        if (-not $compositeOccurrenceCounts.ContainsKey($key)) {
            $compositeOccurrenceCounts[$key] = 0
        }

        $compositeOccurrenceCounts[$key]++

        $record |
            Add-Member `
                -NotePropertyName DuplicateGroupCount `
                -NotePropertyValue $compositeKeyCounts[$key]

        $record |
            Add-Member `
                -NotePropertyName DuplicateOccurrence `
                -NotePropertyValue $compositeOccurrenceCounts[$key]
    }

    # --------------------------------------------------------
    # Parse AD records
    # --------------------------------------------------------

    $adRecords = New-Object System.Collections.Generic.List[object]
    $adRowNumber = 0
    $adParseWarningCount = 0

    foreach ($adRow in $adCsv) {
        $adRowNumber++

        $originalADValue = [string]$adRow.$adUsernameColumn

        $parsedADValue = ConvertFrom-ADUsernameField `
            -Value $originalADValue

        if (-not [string]::IsNullOrWhiteSpace($parsedADValue.ParseWarning)) {
            $adParseWarningCount++
        }

        $normalizedUsername = Get-NormalizedUsername `
            -Username $parsedADValue.DerivedUsername

        $adRecords.Add(
            [PSCustomObject]@{
                RecordNumber       = $adRowNumber
                OriginalADValue    = $originalADValue
                DerivedUsername    = $parsedADValue.DerivedUsername
                DerivedAddress     = $parsedADValue.DerivedAddress
                NormalizedUsername = $normalizedUsername
                CompactUsername    = Get-CompactUsername -Username $normalizedUsername
                NormalizedAddress  = Get-NormalizedAddress -Address $parsedADValue.DerivedAddress
                ShortAddress       = Get-ShortAddress -Address $parsedADValue.DerivedAddress
                ParseMethod        = $parsedADValue.ParseMethod
                ParseWarning       = $parsedADValue.ParseWarning
            }
        )
    }

    # --------------------------------------------------------
    # Build AD indexes
    # --------------------------------------------------------

    $adByNormalizedUsername = @{}
    $adByCompactUsername = @{}
    $adByAddress = @{}
    $adByShortAddress = @{}
    $adByPrefix = @{}

    foreach ($adRecord in $adRecords) {
        if (-not [string]::IsNullOrWhiteSpace($adRecord.NormalizedUsername)) {
            if (-not $adByNormalizedUsername.ContainsKey($adRecord.NormalizedUsername)) {
                $adByNormalizedUsername[$adRecord.NormalizedUsername] =
                    New-Object System.Collections.ArrayList
            }

            [void]$adByNormalizedUsername[$adRecord.NormalizedUsername].Add($adRecord)
        }

        if (-not [string]::IsNullOrWhiteSpace($adRecord.CompactUsername)) {
            if (-not $adByCompactUsername.ContainsKey($adRecord.CompactUsername)) {
                $adByCompactUsername[$adRecord.CompactUsername] =
                    New-Object System.Collections.ArrayList
            }

            [void]$adByCompactUsername[$adRecord.CompactUsername].Add($adRecord)

            if ($adRecord.CompactUsername.Length -ge 3) {
                $prefix = $adRecord.CompactUsername.Substring(0, 3)

                if (-not $adByPrefix.ContainsKey($prefix)) {
                    $adByPrefix[$prefix] =
                        New-Object System.Collections.ArrayList
                }

                [void]$adByPrefix[$prefix].Add($adRecord)
            }
        }

        if (-not [string]::IsNullOrWhiteSpace($adRecord.NormalizedAddress)) {
            if (-not $adByAddress.ContainsKey($adRecord.NormalizedAddress)) {
                $adByAddress[$adRecord.NormalizedAddress] =
                    New-Object System.Collections.ArrayList
            }

            [void]$adByAddress[$adRecord.NormalizedAddress].Add($adRecord)
        }

        if (-not [string]::IsNullOrWhiteSpace($adRecord.ShortAddress)) {
            if (-not $adByShortAddress.ContainsKey($adRecord.ShortAddress)) {
                $adByShortAddress[$adRecord.ShortAddress] =
                    New-Object System.Collections.ArrayList
            }

            [void]$adByShortAddress[$adRecord.ShortAddress].Add($adRecord)
        }
    }

    # --------------------------------------------------------
    # Compare CyberArk records against AD
    # --------------------------------------------------------

    $results = New-Object System.Collections.Generic.List[object]
    $matchedADRecordNumbers = @{}
    $processedCyberArkAccounts = 0

    foreach ($cyberArkRecord in $preparedCyberArkRecords) {
        $processedCyberArkAccounts++

        $usernameCandidates = @(
            Get-CyberArkUsernameCandidates `
                -Username $cyberArkRecord.Username
        )

        $possibleADRecords = New-Object System.Collections.ArrayList
        $seenPossibleADRecords = @{}

        foreach ($usernameCandidate in $usernameCandidates) {
            if (
                -not [string]::IsNullOrWhiteSpace($usernameCandidate.NormalizedUsername) -and
                $adByNormalizedUsername.ContainsKey($usernameCandidate.NormalizedUsername)
            ) {
                Add-UniqueADRecords `
                    -TargetList $possibleADRecords `
                    -SeenRecords $seenPossibleADRecords `
                    -Records $adByNormalizedUsername[$usernameCandidate.NormalizedUsername]
            }

            if (
                -not [string]::IsNullOrWhiteSpace($usernameCandidate.CompactUsername) -and
                $adByCompactUsername.ContainsKey($usernameCandidate.CompactUsername)
            ) {
                Add-UniqueADRecords `
                    -TargetList $possibleADRecords `
                    -SeenRecords $seenPossibleADRecords `
                    -Records $adByCompactUsername[$usernameCandidate.CompactUsername]
            }

            if ($usernameCandidate.CompactUsername.Length -ge 3) {
                $candidatePrefix = $usernameCandidate.CompactUsername.Substring(0, 3)

                if ($adByPrefix.ContainsKey($candidatePrefix)) {
                    Add-UniqueADRecords `
                        -TargetList $possibleADRecords `
                        -SeenRecords $seenPossibleADRecords `
                        -Records $adByPrefix[$candidatePrefix]
                }
            }
        }

        if (
            -not [string]::IsNullOrWhiteSpace($cyberArkRecord.NormalizedAddress) -and
            $adByAddress.ContainsKey($cyberArkRecord.NormalizedAddress)
        ) {
            Add-UniqueADRecords `
                -TargetList $possibleADRecords `
                -SeenRecords $seenPossibleADRecords `
                -Records $adByAddress[$cyberArkRecord.NormalizedAddress]
        }

        if (
            -not [string]::IsNullOrWhiteSpace($cyberArkRecord.ShortAddress) -and
            $adByShortAddress.ContainsKey($cyberArkRecord.ShortAddress)
        ) {
            Add-UniqueADRecords `
                -TargetList $possibleADRecords `
                -SeenRecords $seenPossibleADRecords `
                -Records $adByShortAddress[$cyberArkRecord.ShortAddress]
        }

        $evaluatedMatches = New-Object System.Collections.Generic.List[object]

        foreach ($adRecord in $possibleADRecords) {
            foreach ($usernameCandidate in $usernameCandidates) {
                $evaluation = Get-MatchEvaluation `
                    -CyberArkCandidate $usernameCandidate `
                    -CyberArkRecord $cyberArkRecord `
                    -ADRecord $adRecord

                if ($evaluation.MatchStatus -ne 'Unmatched') {
                    $evaluatedMatches.Add(
                        [PSCustomObject]@{
                            ADRecord          = $adRecord
                            UsernameCandidate = $usernameCandidate
                            Evaluation        = $evaluation
                        }
                    )
                }
            }
        }

        if ($evaluatedMatches.Count -gt 0) {
            $sortedMatches = @(
                $evaluatedMatches |
                    Sort-Object `
                        @{
                            Expression = {
                                $_.Evaluation.ConfidenceScore
                            }
                            Descending = $true
                        },
                        @{
                            Expression = {
                                $_.Evaluation.SimilarityPercent
                            }
                            Descending = $true
                        },
                        @{
                            Expression = {
                                $_.ADRecord.RecordNumber
                            }
                            Descending = $false
                        }
            )

            $bestMatch = $sortedMatches[0]
            $bestADRecord = $bestMatch.ADRecord
            $bestCandidate = $bestMatch.UsernameCandidate
            $bestEvaluation = $bestMatch.Evaluation

            $equalBestADRecords = @(
                $sortedMatches |
                    Where-Object {
                        $_.Evaluation.ConfidenceScore -eq
                        $bestEvaluation.ConfidenceScore
                    } |
                    ForEach-Object {
                        $_.ADRecord.RecordNumber
                    } |
                    Sort-Object -Unique
            )

            $equalBestCount = $equalBestADRecords.Count
            $matchedADRecordNumbers[$bestADRecord.RecordNumber] = $true

            $reviewRequired = 'No'

            if (
                $bestEvaluation.MatchStatus -eq 'Likely Matched' -or
                $equalBestCount -gt 1 -or
                $cyberArkRecord.DuplicateGroupCount -gt 1 -or
                -not [string]::IsNullOrWhiteSpace($bestADRecord.ParseWarning)
            ) {
                $reviewRequired = 'Yes'
            }

            $results.Add(
                [PSCustomObject]@{
                    RecordSource              = 'CyberArk'
                    MatchStatus               = $bestEvaluation.MatchStatus
                    ConfidenceScore           = $bestEvaluation.ConfidenceScore
                    PresenceInCyberArk         = 'Yes'

                    CyberArkRecordID           = $cyberArkRecord.CyberArkRecordID
                    CyberArkSourceRow          = $cyberArkRecord.SourceRow
                    CyberArkOriginalUsername   = $cyberArkRecord.Username
                    CyberArkMatchedCandidate   = $bestCandidate.CandidateUsername
                    CyberArkCandidateSource    = $bestCandidate.CandidateSource
                    CyberArkAddress            = $cyberArkRecord.Address
                    CyberArkCompositeKey       = $cyberArkRecord.CyberArkCompositeKey
                    DuplicateGroupCount        = $cyberArkRecord.DuplicateGroupCount
                    DuplicateOccurrence        = $cyberArkRecord.DuplicateOccurrence

                    ADOriginalUsernameField    = $bestADRecord.OriginalADValue
                    ADDerivedUsername          = $bestADRecord.DerivedUsername
                    ADDerivedAddress           = $bestADRecord.DerivedAddress
                    ADParseMethod              = $bestADRecord.ParseMethod
                    ADParseWarning             = $bestADRecord.ParseWarning

                    UsernameMatchMethod        = $bestEvaluation.UsernameMethod
                    UsernameSimilarityPercent  = $bestEvaluation.SimilarityPercent
                    AddressMatchMethod         = $bestEvaluation.AddressMethod
                    MatchReason                = $bestEvaluation.MatchReason

                    ADCandidatesConsidered     = $possibleADRecords.Count
                    EqualBestADMatchCount      = $equalBestCount
                    ReviewRequired             = $reviewRequired
                }
            )
        }
        else {
            $candidateDisplay = @(
                $usernameCandidates |
                    Select-Object `
                        -ExpandProperty CandidateUsername `
                        -Unique
            ) -join ' | '

            $results.Add(
                [PSCustomObject]@{
                    RecordSource              = 'CyberArk'
                    MatchStatus               = 'Unmatched CyberArk'
                    ConfidenceScore           = 0
                    PresenceInCyberArk         = 'Yes'

                    CyberArkRecordID           = $cyberArkRecord.CyberArkRecordID
                    CyberArkSourceRow          = $cyberArkRecord.SourceRow
                    CyberArkOriginalUsername   = $cyberArkRecord.Username
                    CyberArkMatchedCandidate   = $candidateDisplay
                    CyberArkCandidateSource    = 'No matching candidate'
                    CyberArkAddress            = $cyberArkRecord.Address
                    CyberArkCompositeKey       = $cyberArkRecord.CyberArkCompositeKey
                    DuplicateGroupCount        = $cyberArkRecord.DuplicateGroupCount
                    DuplicateOccurrence        = $cyberArkRecord.DuplicateOccurrence

                    ADOriginalUsernameField    = ''
                    ADDerivedUsername          = ''
                    ADDerivedAddress           = ''
                    ADParseMethod              = ''
                    ADParseWarning             = ''

                    UsernameMatchMethod        = 'No match'
                    UsernameSimilarityPercent  = 0
                    AddressMatchMethod         = 'No match'
                    MatchReason                = 'No AD record met the username and address matching thresholds.'

                    ADCandidatesConsidered     = $possibleADRecords.Count
                    EqualBestADMatchCount      = 0
                    ReviewRequired             = 'Yes'
                }
            )
        }

        if (($processedCyberArkAccounts % 100) -eq 0) {
            Write-Log `
                -Message "Processed CyberArk records: $processedCyberArkAccounts of $($preparedCyberArkRecords.Count)"
        }
    }

    # --------------------------------------------------------
    # Add AD records absent from CyberArk
    # --------------------------------------------------------

    foreach ($adRecord in $adRecords) {
        if (-not $matchedADRecordNumbers.ContainsKey($adRecord.RecordNumber)) {
            $results.Add(
                [PSCustomObject]@{
                    RecordSource              = 'Active Directory'
                    MatchStatus               = 'Unmatched AD'
                    ConfidenceScore           = 0
                    PresenceInCyberArk         = 'No'

                    CyberArkRecordID           = ''
                    CyberArkSourceRow          = ''
                    CyberArkOriginalUsername   = ''
                    CyberArkMatchedCandidate   = ''
                    CyberArkCandidateSource    = ''
                    CyberArkAddress            = ''
                    CyberArkCompositeKey       = ''
                    DuplicateGroupCount        = ''
                    DuplicateOccurrence        = ''

                    ADOriginalUsernameField    = $adRecord.OriginalADValue
                    ADDerivedUsername          = $adRecord.DerivedUsername
                    ADDerivedAddress           = $adRecord.DerivedAddress
                    ADParseMethod              = $adRecord.ParseMethod
                    ADParseWarning             = $adRecord.ParseWarning

                    UsernameMatchMethod        = 'No match'
                    UsernameSimilarityPercent  = 0
                    AddressMatchMethod         = 'No match'
                    MatchReason                = 'No CyberArk CSV row matched this AD record.'

                    ADCandidatesConsidered     = 0
                    EqualBestADMatchCount      = 0
                    ReviewRequired             = 'Yes'
                }
            )
        }
    }

    # --------------------------------------------------------
    # Export reports
    # --------------------------------------------------------

    $timestamp = Get-Date -Format 'yyyyMMdd_HHmmss'

    $allReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_CyberArk_All_Results_$timestamp.csv"

    $matchedReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_CyberArk_Matched_$timestamp.csv"

    $likelyReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_CyberArk_Likely_Matched_$timestamp.csv"

    $unmatchedReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_CyberArk_Unmatched_$timestamp.csv"

    $adParsedReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_Parsed_Username_Address_$timestamp.csv"

    $cyberArkPreparedReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "CyberArk_Prepared_Data_$timestamp.csv"

    $summaryReportPath = Join-Path `
        -Path $OutputFolder `
        -ChildPath "AD_CyberArk_Summary_$timestamp.txt"

    $orderedResults = @(
        $results |
            Sort-Object `
                @{
                    Expression = {
                        switch ($_.MatchStatus) {
                            'Matched'            { 1 }
                            'Likely Matched'     { 2 }
                            'Unmatched CyberArk' { 3 }
                            'Unmatched AD'       { 4 }
                            default              { 5 }
                        }
                    }
                },
                CyberArkSourceRow,
                ADDerivedUsername
    )

    $matchedResults = @(
        $orderedResults |
            Where-Object {
                $_.MatchStatus -eq 'Matched'
            }
    )

    $likelyMatchedResults = @(
        $orderedResults |
            Where-Object {
                $_.MatchStatus -eq 'Likely Matched'
            }
    )

    $unmatchedResults = @(
        $orderedResults |
            Where-Object {
                $_.MatchStatus -eq 'Unmatched CyberArk' -or
                $_.MatchStatus -eq 'Unmatched AD'
            }
    )

    $resultColumns = @(
        $orderedResults[0].PSObject.Properties.Name
    )

    Export-ResultSet `
        -Data $orderedResults `
        -Path $allReportPath `
        -Columns $resultColumns

    Export-ResultSet `
        -Data $matchedResults `
        -Path $matchedReportPath `
        -Columns $resultColumns

    Export-ResultSet `
        -Data $likelyMatchedResults `
        -Path $likelyReportPath `
        -Columns $resultColumns

    Export-ResultSet `
        -Data $unmatchedResults `
        -Path $unmatchedReportPath `
        -Columns $resultColumns

    $adRecords |
        Select-Object `
            RecordNumber,
            OriginalADValue,
            DerivedUsername,
            DerivedAddress,
            NormalizedUsername,
            ParseMethod,
            ParseWarning |
        Export-Csv `
            -LiteralPath $adParsedReportPath `
            -NoTypeInformation `
            -Encoding UTF8

    $preparedCyberArkRecords |
        Select-Object `
            CyberArkRecordID,
            SourceRow,
            Username,
            Address,
            NormalizedAddress,
            CyberArkCompositeKey,
            DuplicateGroupCount,
            DuplicateOccurrence |
        Export-Csv `
            -LiteralPath $cyberArkPreparedReportPath `
            -NoTypeInformation `
            -Encoding UTF8

    $unmatchedCyberArkCount = @(
        $orderedResults |
            Where-Object {
                $_.MatchStatus -eq 'Unmatched CyberArk'
            }
    ).Count

    $unmatchedADCount = @(
        $orderedResults |
            Where-Object {
                $_.MatchStatus -eq 'Unmatched AD'
            }
    ).Count

    $duplicateCyberArkRowCount = @(
        $preparedCyberArkRecords |
            Where-Object {
                $_.DuplicateGroupCount -gt 1
            }
    ).Count

    $summary = @"
CyberArk and Active Directory Account Comparison
=================================================

Run Date                         : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')

CyberArk CSV                     : $CyberArkCsvPath
AD CSV                           : $ADCsvPath

CyberArk Source Rows             : $($preparedCyberArkRecords.Count)
CyberArk Rows in Duplicate Groups: $duplicateCyberArkRowCount
Actual CyberArk Account IDs      : Not supplied
Generated CyberArk Record IDs    : CA-000001 through CA-$('{0:D6}' -f $preparedCyberArkRecords.Count)

AD Source Rows                   : $($adRecords.Count)
AD Parse Warnings                : $adParseWarningCount

Matched                          : $($matchedResults.Count)
Likely Matched                   : $($likelyMatchedResults.Count)
Unmatched CyberArk               : $unmatchedCyberArkCount
Unmatched AD                     : $unmatchedADCount

Reports
-------
All Results                      : $allReportPath
Matched                          : $matchedReportPath
Likely Matched                   : $likelyReportPath
Unmatched                        : $unmatchedReportPath
Parsed AD Data                   : $adParsedReportPath
Prepared CyberArk Data           : $cyberArkPreparedReportPath
"@

    Set-Content `
        -LiteralPath $summaryReportPath `
        -Value $summary `
        -Encoding UTF8

    # --------------------------------------------------------
    # Completion summary
    # --------------------------------------------------------

    Write-Host
    Write-Log `
        -Level 'SUCCESS' `
        -Message 'Comparison completed successfully.'

    Write-Log -Message "CyberArk rows          : $($preparedCyberArkRecords.Count)"
    Write-Log -Message "Matched                : $($matchedResults.Count)"
    Write-Log -Message "Likely matched         : $($likelyMatchedResults.Count)"
    Write-Log -Message "Unmatched CyberArk     : $unmatchedCyberArkCount"
    Write-Log -Message "Unmatched AD           : $unmatchedADCount"
    Write-Log -Message "Duplicate-group rows   : $duplicateCyberArkRowCount"
    Write-Log -Message "AD parse warnings      : $adParseWarningCount"

    Write-Host
    Write-Host "All results          : $allReportPath"
    Write-Host "Matched              : $matchedReportPath"
    Write-Host "Likely matched       : $likelyReportPath"
    Write-Host "Unmatched            : $unmatchedReportPath"
    Write-Host "Parsed AD data       : $adParsedReportPath"
    Write-Host "Prepared CyberArk data: $cyberArkPreparedReportPath"
    Write-Host "Summary              : $summaryReportPath"
    Write-Host
}
catch {
    Write-Host
    Write-Log -Level 'ERROR' -Message $_.Exception.Message
    Write-Log -Level 'ERROR' -Message 'The comparison did not complete.'
    exit 1
}
