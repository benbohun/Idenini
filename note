<#
SafeMembershipReport_NormalUser_MFA.ps1

PURPOSE
- Prompts for normal CyberArk Identity / Privilege Cloud user credentials.
- Does NOT use CCP.
- Does NOT use ServiceUser mode.
- Explicitly runs CyberArk Identity MFA using New-IDSession.
- Converts the successful MFA-authenticated Identity session into a psPAS session.
- Enumerates all Safes via Get-PASSafe.
- Enumerates Safe Members via Get-PASSafeMember.
- Exports full Safe membership and permissions report to CSV.

IMPORTANT
- Run this from an interactive PowerShell console.
- When MFA challenge selection appears, select the required MFA method and complete the challenge.
- After MFA succeeds, the script continues automatically.

REQUIREMENTS
- psPAS module.
- IdentityCommand module.
- Your user must be allowed to authenticate to CyberArk Identity.
- Your user must have permission to list Safes and view Safe Members.
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud URLs =====
    [string]$IdentityTenantURL = "https://abq4291.id.cyberark.cloud",

    [string]$PrivilegeCloudURL = "https://mtbanktest.privilegecloud.cyberark.cloud",

    # ===== Output =====
    [string]$CsvFilePath = "",

    [string]$LogFile = ""
)

# =========================
# Runtime settings
# =========================

$ErrorActionPreference = "Stop"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# =========================
# Default paths
# =========================

$ScriptRoot = $PSScriptRoot

if ([string]::IsNullOrWhiteSpace($ScriptRoot)) {
    $ScriptRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
}

if ([string]::IsNullOrWhiteSpace($ScriptRoot)) {
    $ScriptRoot = (Get-Location).Path
}

if ([string]::IsNullOrWhiteSpace($CsvFilePath)) {
    $CsvFilePath = Join-Path $ScriptRoot "csv\SafeMembersReport.csv"
}

if ([string]::IsNullOrWhiteSpace($LogFile)) {
    $LogFile = Join-Path $ScriptRoot "logs\SafeMemberAudit.log"
}

# =========================
# Helper functions
# =========================

function Ensure-ParentFolder {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    $parent = Split-Path -Path $Path -Parent

    if (-not [string]::IsNullOrWhiteSpace($parent)) {
        if (-not (Test-Path -Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
    }
}

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = [ConsoleColor]::White
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "$timestamp | $Message"

    Add-Content -Path $LogFile -Value $entry
    Write-Host $entry -ForegroundColor $Color
}

function Assert-UrlReady {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Name,

        [Parameter(Mandatory)]
        [string]$Url
    )

    if ([string]::IsNullOrWhiteSpace($Url)) {
        throw "$Name is empty. Please provide a valid URL."
    }

    if (
        $Url -match "YOUR-" -or
        $Url -match "PLACEHOLDER" -or
        $Url -match "<" -or
        $Url -match ">"
    ) {
        throw "$Name still contains a placeholder value: $Url"
    }

    if ($Url -notmatch "^https://") {
        throw "$Name must start with https://. Current value: $Url"
    }
}

function Get-ObjectPropertyValue {
    [CmdletBinding()]
    param(
        [Parameter()]
        $InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propertyName in $PropertyNames) {
        $property = $InputObject.PSObject.Properties |
            Where-Object { $_.Name -ieq $propertyName } |
            Select-Object -First 1

        if ($null -ne $property) {
            return $property.Value
        }
    }

    return $null
}

function Get-PermissionValue {
    [CmdletBinding()]
    param(
        [Parameter()]
        $Permissions,

        [Parameter(Mandatory)]
        [string]$PermissionName
    )

    if ($null -eq $Permissions) {
        return $null
    }

    return Get-ObjectPropertyValue -InputObject $Permissions -PropertyNames @($PermissionName)
}

function Write-ExceptionDetails {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        $ErrorRecord,

        [string]$Prefix = "ERROR"
    )

    try {
        Write-Log "$Prefix Message: $($ErrorRecord.Exception.Message)" "Red"

        if ($ErrorRecord.Exception.InnerException) {
            Write-Log "$Prefix InnerException: $($ErrorRecord.Exception.InnerException.Message)" "Red"
        }

        if ($ErrorRecord.ErrorDetails -and $ErrorRecord.ErrorDetails.Message) {
            Write-Log "$Prefix ErrorDetails: $($ErrorRecord.ErrorDetails.Message)" "Red"
        }

        if ($ErrorRecord.InvocationInfo) {
            Write-Log "$Prefix ScriptLineNumber: $($ErrorRecord.InvocationInfo.ScriptLineNumber)" "Red"
            Write-Log "$Prefix PositionMessage: $($ErrorRecord.InvocationInfo.PositionMessage)" "Red"
        }
    }
    catch {
        Write-Log "$Prefix Unable to expand exception details: $($_.Exception.Message)" "Yellow"
    }
}

function Start-MFAIdentitySession {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$TenantURL,

        [Parameter(Mandatory)]
        [PSCredential]$Credential
    )

    Write-Log "Starting CyberArk Identity login with MFA support..." "Cyan"
    Write-Log "Identity tenant: $TenantURL" "Cyan"
    Write-Log "When prompted, select and complete the MFA challenge." "Yellow"

    $idSession = New-IDSession `
        -tenant_url $TenantURL `
        -Credential $Credential `
        -ErrorAction Stop

    if ($null -eq $idSession) {
        throw "New-IDSession returned no session object after authentication."
    }

    $token = Get-ObjectPropertyValue -InputObject $idSession -PropertyNames @(
        "Token",
        "token",
        "access_token",
        "accessToken"
    )

    if ([string]::IsNullOrWhiteSpace($token)) {
        throw "Identity MFA authentication completed, but no token was returned from New-IDSession."
    }

    Write-Log "CyberArk Identity MFA authentication completed successfully." "Green"

    return $idSession
}

function Convert-IDSessionTo-PASSession {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        $IDSession,

        [Parameter(Mandatory)]
        [string]$PrivilegeCloudURL,

        [Parameter(Mandatory)]
        [string]$Username
    )

    Write-Log "Converting Identity MFA session into psPAS session..." "Cyan"

    $PrivilegeCloudURL = $PrivilegeCloudURL.TrimEnd("/")
    $baseUri = "$PrivilegeCloudURL/PasswordVault"

    $token = Get-ObjectPropertyValue -InputObject $IDSession -PropertyNames @(
        "Token",
        "token"
    )

    $accessToken = Get-ObjectPropertyValue -InputObject $IDSession -PropertyNames @(
        "access_token",
        "accessToken"
    )

    $tokenType = Get-ObjectPropertyValue -InputObject $IDSession -PropertyNames @(
        "token_type",
        "tokenType"
    )

    if (-not [string]::IsNullOrWhiteSpace($token)) {
        $authHeader = "Bearer $token"
    }
    elseif (-not [string]::IsNullOrWhiteSpace($accessToken)) {
        if ([string]::IsNullOrWhiteSpace($tokenType)) {
            $tokenType = "Bearer"
        }

        $authHeader = "$tokenType $accessToken"
    }
    else {
        throw "Unable to locate Identity token or access_token on the New-IDSession result."
    }

    $webSession = $null

    try {
        $webSession = $IDSession.GetWebSession()
    }
    catch {
        Write-Log "IDSession.GetWebSession() failed. Creating a new WebRequestSession object. Warning: $($_.Exception.Message)" "Yellow"
    }

    if ($null -eq $webSession) {
        $webSession = New-Object Microsoft.PowerShell.Commands.WebRequestSession
    }

    if (-not ($webSession.PSObject.Properties.Name -contains "Headers")) {
        $webSession | Add-Member -MemberType NoteProperty -Name Headers -Value @{} -Force
    }

    if ($null -eq $webSession.Headers) {
        $webSession.Headers = @{}
    }

    $webSession.Headers["Authorization"] = $authHeader

    $pasSession = [PSCustomObject]@{
        BaseURI         = $baseUri
        ApiURI          = $PrivilegeCloudURL
        WebSession      = $webSession
        ExternalVersion = [System.Version]"0.0"
        StartTime       = Get-Date
        User            = $Username
    }

    $pasSession.PSObject.TypeNames.Insert(0, "psPAS.CyberArk.Vault.Session")

    Use-PASSession -Session $pasSession

    if (-not (Get-PASSession)) {
        throw "Use-PASSession did not establish a psPAS session."
    }

    try {
        $server = Get-PASServer -ErrorAction Stop
        if ($server.ExternalVersion) {
            $currentSession = Get-PASSession
            $currentSession.ExternalVersion = [System.Version]$server.ExternalVersion
            Use-PASSession -Session $currentSession
            Write-Log "Privilege Cloud server version detected: $($server.ExternalVersion)" "Green"
        }
    }
    catch {
        Write-Log "Version check warning. Session is still usable. Details: $($_.Exception.Message)" "Yellow"
    }

    Write-Log "psPAS session established using MFA-authenticated Identity token." "Green"
}

# =========================
# Initialize output paths
# =========================

Ensure-ParentFolder -Path $CsvFilePath
Ensure-ParentFolder -Path $LogFile

Write-Log "Safe Member Report starting..." "Cyan"
Write-Log "CSV output path: $CsvFilePath" "Cyan"
Write-Log "Log file path: $LogFile" "Cyan"

# =========================
# Validate URLs
# =========================

$IdentityTenantURL = $IdentityTenantURL.TrimEnd("/")
$PrivilegeCloudURL = $PrivilegeCloudURL.TrimEnd("/")

Assert-UrlReady -Name "IdentityTenantURL" -Url $IdentityTenantURL
Assert-UrlReady -Name "PrivilegeCloudURL" -Url $PrivilegeCloudURL

# =========================
# Import modules
# =========================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    Write-Log "psPAS module loaded successfully." "Green"
}
catch {
    Write-Log "Failed to load psPAS module." "Red"
    Write-ExceptionDetails -ErrorRecord $_ -Prefix "psPAS IMPORT ERROR"
    throw
}

try {
    Import-Module IdentityCommand -Force -ErrorAction Stop
    Write-Log "IdentityCommand module loaded successfully." "Green"
}
catch {
    Write-Log "Failed to load IdentityCommand module. MFA login requires IdentityCommand." "Red"
    Write-ExceptionDetails -ErrorRecord $_ -Prefix "IdentityCommand IMPORT ERROR"
    throw
}

# =========================
# Validate required commands
# =========================

foreach ($requiredCommand in @("New-IDSession", "Use-PASSession", "Get-PASSession", "Get-PASSafe", "Get-PASSafeMember")) {
    if (-not (Get-Command $requiredCommand -ErrorAction SilentlyContinue)) {
        throw "Required command not found: $requiredCommand"
    }
}

# =========================
# Main
# =========================

$sessionCreated = $false
$SafeMembersReport = New-Object System.Collections.Generic.List[object]

try {
    # Prompt for normal Identity user credential
    Write-Log "Prompting for normal CyberArk Identity / Privilege Cloud user credential..." "Cyan"

    $Credential = Get-Credential -Message "Enter your CyberArk Identity / Privilege Cloud username and password"

    if ($null -eq $Credential) {
        throw "Credential prompt was cancelled."
    }

    if ([string]::IsNullOrWhiteSpace($Credential.UserName)) {
        throw "Credential username is empty."
    }

    # MFA authentication first
    try {
        $idSession = Start-MFAIdentitySession `
            -TenantURL $IdentityTenantURL `
            -Credential $Credential

        Convert-IDSessionTo-PASSession `
            -IDSession $idSession `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Username $Credential.UserName

        $sessionCreated = $true
    }
    catch {
        Write-Log "Authentication failed before Safe enumeration." "Red"
        Write-ExceptionDetails -ErrorRecord $_ -Prefix "AUTH ERROR"
        throw
    }

    # Confirm logged-on user if supported
    try {
        $loggedOnUser = Get-PASLoggedOnUser -ErrorAction Stop
        if ($loggedOnUser) {
            Write-Log "Logged on to Privilege Cloud as: $($loggedOnUser.UserName)" "Green"
        }
    }
    catch {
        Write-Log "Get-PASLoggedOnUser warning. Continuing. Details: $($_.Exception.Message)" "Yellow"
    }

    # Retrieve Safes
    Write-Log "Retrieving Safes via Get-PASSafe..." "Cyan"

    $Safes = @(Get-PASSafe -ErrorAction Stop)

    if (-not $Safes -or $Safes.Count -eq 0) {
        Write-Log "No Safes returned from Get-PASSafe. Validate Admin PCloud membership and Safe permissions." "Yellow"
        return
    }

    Write-Log "Retrieved $($Safes.Count) Safe(s)." "Green"

    # Enumerate Safe Members
    $safeIndex = 0

    foreach ($Safe in $Safes) {
        $safeIndex++

        $SafeName = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @(
            "SafeName",
            "safeName",
            "safeUrlId"
        )

        if ([string]::IsNullOrWhiteSpace($SafeName)) {
            Write-Log "Skipping Safe at index $safeIndex because SafeName could not be resolved." "Yellow"
            continue
        }

        Write-Log "[$safeIndex/$($Safes.Count)] Retrieving members for Safe: $SafeName" "Cyan"

        try {
            $SafeMembers = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)

            if (-not $SafeMembers -or $SafeMembers.Count -eq 0) {
                Write-Log "No members found for Safe: $SafeName" "Yellow"
                continue
            }

            foreach ($Member in $SafeMembers) {
                $perm = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                    "Permissions",
                    "permissions"
                )

                $memberName = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                    "MemberName",
                    "memberName",
                    "UserName",
                    "username",
                    "Name",
                    "name"
                )

                $memberType = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                    "MemberType",
                    "memberType",
                    "Type",
                    "type"
                )

                $SafeMembersReport.Add([PSCustomObject]@{
                    SafeName                               = $SafeName
                    Member                                 = $memberName
                    MemberType                             = $memberType

                    UseAccounts                            = Get-PermissionValue -Permissions $perm -PermissionName "useAccounts"
                    RetrieveAccounts                       = Get-PermissionValue -Permissions $perm -PermissionName "retrieveAccounts"
                    ListAccounts                           = Get-PermissionValue -Permissions $perm -PermissionName "listAccounts"
                    AddAccounts                            = Get-PermissionValue -Permissions $perm -PermissionName "addAccounts"
                    UpdateAccountContent                   = Get-PermissionValue -Permissions $perm -PermissionName "updateAccountContent"
                    UpdateAccountProperties                = Get-PermissionValue -Permissions $perm -PermissionName "updateAccountProperties"
                    InitiateCPMAccountManagementOperations = Get-PermissionValue -Permissions $perm -PermissionName "initiateCPMAccountManagementOperations"
                    SpecifyNextAccountContent              = Get-PermissionValue -Permissions $perm -PermissionName "specifyNextAccountContent"
                    RenameAccounts                         = Get-PermissionValue -Permissions $perm -PermissionName "renameAccounts"
                    DeleteAccounts                         = Get-PermissionValue -Permissions $perm -PermissionName "deleteAccounts"
                    UnlockAccounts                         = Get-PermissionValue -Permissions $perm -PermissionName "unlockAccounts"
                    ManageSafe                             = Get-PermissionValue -Permissions $perm -PermissionName "manageSafe"
                    ManageSafeMembers                      = Get-PermissionValue -Permissions $perm -PermissionName "manageSafeMembers"
                    BackupSafe                             = Get-PermissionValue -Permissions $perm -PermissionName "backupSafe"
                    ViewAuditLog                           = Get-PermissionValue -Permissions $perm -PermissionName "viewAuditLog"
                    ViewSafeMembers                        = Get-PermissionValue -Permissions $perm -PermissionName "viewSafeMembers"
                    AccessWithoutConfirmation              = Get-PermissionValue -Permissions $perm -PermissionName "accessWithoutConfirmation"
                    CreateFolders                          = Get-PermissionValue -Permissions $perm -PermissionName "createFolders"
                    DeleteFolders                          = Get-PermissionValue -Permissions $perm -PermissionName "deleteFolders"
                    MoveAccountsAndFolders                 = Get-PermissionValue -Permissions $perm -PermissionName "moveAccountsAndFolders"
                    RequestsAuthorizationLevel1            = Get-PermissionValue -Permissions $perm -PermissionName "requestsAuthorizationLevel1"
                    RequestsAuthorizationLevel2            = Get-PermissionValue -Permissions $perm -PermissionName "requestsAuthorizationLevel2"
                }) | Out-Null
            }

            Write-Log "Retrieved $($SafeMembers.Count) member(s) for Safe: $SafeName" "Green"
        }
        catch {
            Write-Log "ERROR: Failed to retrieve members for Safe '$SafeName'." "Red"
            Write-ExceptionDetails -ErrorRecord $_ -Prefix "SAFE MEMBER ERROR"
            continue
        }
    }

    # Export report
    if (-not $SafeMembersReport -or $SafeMembersReport.Count -eq 0) {
        Write-Log "No Safe Member data collected. CSV export skipped." "Yellow"
    }
    else {
        Write-Log "Exporting Safe Member Report to: $CsvFilePath" "Cyan"

        $SafeMembersReport |
            Sort-Object SafeName, Member |
            Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

        Write-Log "Safe Member Report exported successfully. Total rows: $($SafeMembersReport.Count)" "Green"
    }

    Write-Log "Safe Member Report generation completed." "Cyan"
}
catch {
    Write-Log "FATAL ERROR: $($_.Exception.Message)" "Red"
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Log "Logged off from Privilege Cloud." "Green"
        }
        catch {
            Write-Log "Logoff warning: $($_.Exception.Message)" "Yellow"
        }
    }
}
