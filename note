# 1) Close any old loaded copies
Remove-Module psPAS,IdentityCommand -ErrorAction SilentlyContinue

# 2) Back up or remove the old unversioned CurrentUser psPAS folder
if (Test-Path "$HOME\Documents\WindowsPowerShell\Modules\psPAS") {
    Rename-Item `
        -Path "$HOME\Documents\WindowsPowerShell\Modules\psPAS" `
        -NewName "psPAS_5.5.110_backup" `
        -Force
}

# 3) Install the versions you want into the CurrentUser path
Install-Module -Name psPAS -RequiredVersion 6.4.85 -Scope CurrentUser -Force -AllowClobber
Install-Module -Name IdentityCommand -RequiredVersion 0.3.61 -Scope CurrentUser -Force -AllowClobber

# 4) Import the exact versions you want
Import-Module psPAS -RequiredVersion 6.4.85 -Force
Import-Module IdentityCommand -RequiredVersion 0.3.61 -Force

# 5) Verify what actually loaded
(Get-Command New-PASSession).Module | Select Name,Version,Path
Get-Command New-PASSession -Syntax
Get-Command -Module IdentityCommand | Select Name




(Get-Command New-PASSession).Module | Select Name,Version,Path
