<#
Get-PCloudAccounts_PeriodicChange_SingleCSV.ps1

- Auth: CCP → Identity Shared Services → ServiceUser (same as your working scripts)
- Pull /API/Platforms once and cache PerformPeriodicChange by PlatformID (plus merged platform info)
- Pull /API/Accounts (paged)
- Reflect PerformPeriodicChange onto each account based on its PlatformID
- Export ONE CSV (single output file)

“All attributes” approach:
- AccountRawJson: full (compressed) JSON of the account record
- PlatformRawJson: full (compressed) JSON of the merged platform record (REST + NF* best-effort)
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",  # CCP base URL (no trailing slash)
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Output =====
    [string]$CsvFilePath        = ".\CyberArk_Accounts_PerformPeriodicChange_Report.csv",

    # Accounts paging
    [int]   $PageSize           = 1000
)

# --- TLS & modules ---
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
Import-Module psPAS           -ErrorAction Stop
Import-Module IdentityCommand -ErrorAction Stop
$ErrorActionPreference = 'Stop'

# --- Pretty log helpers ---
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

function Normalize-Bool {
    param([object]$Value)
    if ($null -eq $Value) { return $null }
    if ($Value -is [bool]) { return $Value }
    $s = $Value.ToString().Trim().ToLower()
    if ($s -in @('true','1','yes','y'))  { return $true }
    if ($s -in @('false','0','no','n')) { return $false }
    return $null
}

function To-JsonCompressed {
    param([object]$Obj, [int]$Depth = 35)
    try { return ($Obj | ConvertTo-Json -Depth $Depth -Compress) } catch { return $null }
}

# --- CCP → PSCredential (API Service User) ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }

    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content. Raw: $($resp | ConvertTo-Json -Depth 5)"
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

function Get-AllPlatformsMergedMap {
    param(
        [Parameter(Mandatory)][string]$BaseUri,
        [Parameter(Mandatory)]$WebSession
    )

    $platformsUrl = "$BaseUri/API/Platforms"
    Write-Info "Retrieving platform list from: $platformsUrl"

    $platformsResponse = Invoke-RestMethod -Uri $platformsUrl -Method GET -WebSession $WebSession -ErrorAction Stop
    $restPlatforms =
        if ($platformsResponse.PSObject.Properties.Name -contains 'Platforms') { $platformsResponse.Platforms }
        else { $platformsResponse }

    if (-not $restPlatforms -or $restPlatforms.Count -eq 0) {
        throw "No platforms found in /API/Platforms response."
    }

    Write-Ok ("REST /Platforms returned {0} platform(s)." -f $restPlatforms.Count)

    $map = @{}
    $idx = 0

    foreach ($p in $restPlatforms) {
        $idx++
        $id   = $p.general.id
        $name = $p.general.name
        Write-Info ("[{0}/{1}] Caching platform '{2}' (ID={3})" -f $idx, $restPlatforms.Count, $name, $id)

        # Best-effort NF* enrich
        $details = $null
        try {
            $full = Get-PASPlatform -PlatformID $id -ErrorAction Stop
            if ($full -and $full.Details) { $details = $full.Details }
        } catch {
            Write-Warn ("Get-PASPlatform failed for ID {0}: {1}" -f $id, $_.Exception.Message)
        }

        $merged = [PSCustomObject]@{
            PlatformID   = $id
            PlatformName = $name

            # Key field you need:
            PerformPeriodicChange = Normalize-Bool $p.credentialsManagement.performPeriodicChange

            # Some common platform controls (nice to have)
            AllowManualChange                     = Normalize-Bool $p.credentialsManagement.allowManualChange
            RequirePasswordChangeEveryXDays       = $p.credentialsManagement.requirePasswordChangeEveryXDays
            PerformPeriodicVerification           = Normalize-Bool $p.credentialsManagement.performPeriodicVerification
            RequirePasswordVerificationEveryXDays = $p.credentialsManagement.requirePasswordVerificationEveryXDays
            AutomaticReconcileWhenUnsynched       = Normalize-Bool $p.credentialsManagement.automaticReconcileWhenUnsynched

            # NF* from Details (if available)
            NFNotifyPriorExpiration           = $details.NFNotifyPriorExpiration
            NFPriorExpirationRecipients       = $details.NFPriorExpirationRecipients
            NFNotifyOnPasswordDisable         = $details.NFNotifyOnPasswordDisable
            NFOnPasswordDisableRecipients     = $details.NFOnPasswordDisableRecipients
            NFNotifyOnVerificationErrors      = $details.NFNotifyOnVerificationErrors
            NFOnVerificationErrorsRecipients  = $details.NFOnVerificationErrorsRecipients
            NFNotifyOnPasswordUsed            = $details.NFNotifyOnPasswordUsed
            NFOnPasswordUsedRecipients        = $details.NFOnPasswordUsedRecipients

            # Raw payloads for “all attributes”
            PlatformRestJson    = To-JsonCompressed $p
            PlatformDetailsJson = To-JsonCompressed $details
        }

        $map[$id] = $merged
    }

    return $map
}

function Get-AllAccountsPaged {
    param(
        [Parameter(Mandatory)][string]$BaseUri,
        [Parameter(Mandatory)]$WebSession,
        [int]$Limit = 1000
    )

    $all = New-Object System.Collections.Generic.List[object]
    $offset = 0

    while ($true) {
        $url = "$BaseUri/API/Accounts?limit=$Limit&offset=$offset"
        Write-Info "Retrieving accounts page: limit=$Limit offset=$offset"

        $resp = Invoke-RestMethod -Uri $url -Method GET -WebSession $WebSession -ErrorAction Stop

        $page =
            if ($resp.PSObject.Properties.Name -contains 'value') { $resp.value }
            elseif ($resp.PSObject.Properties.Name -contains 'accounts') { $resp.accounts }
            else { $resp }

        if (-not $page -or $page.Count -eq 0) { break }

        foreach ($a in $page) { $all.Add($a) }

        if ($page.Count -lt $Limit) { break }
        $offset += $Limit
    }

    return $all
}

# --- MAIN ---
$sessionCreated = $false

try {
    # 1) Get Service User creds from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 2) Authenticate via Identity Shared Services using SERVICE USER
    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    $baseUri    = $session.BaseURI.TrimEnd('/')   # includes /PasswordVault
    $webSession = $session.WebSession

    # 3) Cache platforms
    $platformMap = Get-AllPlatformsMergedMap -BaseUri $baseUri -WebSession $webSession

    # 4) Get all accounts (paged)
    $accounts = Get-AllAccountsPaged -BaseUri $baseUri -WebSession $webSession -Limit $PageSize
    Write-Ok ("Retrieved {0} total account(s)." -f $accounts.Count)

    # 5) Build report rows
    $rows = New-Object System.Collections.Generic.List[object]
    $i = 0

    foreach ($a in $accounts) {
        $i++
        if (($i % 1000) -eq 0) { Write-Info "Processing account $i / $($accounts.Count)..." }

        $plat = $null
        if ($a.platformId -and $platformMap.ContainsKey($a.platformId)) {
            $plat = $platformMap[$a.platformId]
        }

        $rows.Add([PSCustomObject]@{
            # --- Required columns ---
            AccountName  = $a.name
            SafeName     = $a.safeName
            PlatformID   = $a.platformId
            PlatformName = if ($plat) { $plat.PlatformName } else { $null }
            UserName     = $a.userName
            Address      = $a.address

            # --- Reflected platform setting ---
            PerformPeriodicChange = if ($plat) { $plat.PerformPeriodicChange } else { $null }

            # --- Common account fields (best-effort) ---
            AccountID     = $a.id
            SecretType    = $a.secretType
            CPMDisabled   = $a.cpmDisabled
            AutomaticManagementEnabled = $a.automaticManagementEnabled
            CreatedTime   = $a.createdTime
            LastChangeTime= $a.lastChangeTime
            LastVerifiedTime = $a.lastVerifiedTime

            # --- Helpful platform controls (best-effort) ---
            Platform_AllowManualChange                     = if ($plat) { $plat.AllowManualChange } else { $null }
            Platform_RequirePasswordChangeEveryXDays       = if ($plat) { $plat.RequirePasswordChangeEveryXDays } else { $null }
            Platform_PerformPeriodicVerification           = if ($plat) { $plat.PerformPeriodicVerification } else { $null }
            Platform_RequirePasswordVerificationEveryXDays = if ($plat) { $plat.RequirePasswordVerificationEveryXDays } else { $null }
            Platform_AutomaticReconcileWhenUnsynched       = if ($plat) { $plat.AutomaticReconcileWhenUnsynched } else { $null }

            # --- “All attributes” capture ---
            AccountRawJson  = To-JsonCompressed $a
            PlatformRawJson = if ($plat) { To-JsonCompressed $plat } else { $null }
        })
    }

    # 6) Export ONE CSV
    Write-Info "Exporting report to: $CsvFilePath"
    $rows | Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8
    Write-Ok ("Export complete: {0} (Rows={1})" -f $CsvFilePath, $rows.Count)
}
catch {
    Write-Err $_
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
