<#
IND_AddNewIdentityUsersToSafe.ps1

Purpose:
- Retrieve CyberArk Identity API service user credential from CCP.
- Authenticate to CyberArk Identity OAuth using Application ID RestAPI.
- Query CyberArk Identity User/DSUsers tables for current Identity users.
- Bypass the Event table because this tenant is returning:
    Argument types do not match
  for all Event DateFunc query attempts.
- Locate matching IND Safe:
    IND_<samAccountName>
    IND_<samAccountName>_*
- Add samAccountName@alliantcreditunion.com to the matching IND Safe.
- Apply default individual Safe permissions.
- Export audit results to CSV.
- Designed for daily scheduled task execution.

Important:
- This script does NOT rename/remove old psPAS modules.
- This script does NOT permanently change the server/global/user PSModulePath.
- It uses a private module folder for this script only:
    I:\Script\IDENTITY Script New\Onbarding Project\Modules

Why this replacement is different:
- The previous script depended on the Identity Event table and DateFunc().
- Your tenant is rejecting every Event query with "Argument types do not match".
- CyberArk Identity User/DSUsers tables do not provide a reliable user-created timestamp.
- Therefore, this script uses an idempotent Safe-driven workflow:
    1. Query current Identity users from DSUsers/User.
    2. Retrieve all IND Safes from Privilege Cloud.
    3. Match users to IND_<samAccountName> or IND_<samAccountName>_* Safes.
    4. Add the user only if a matching Safe exists and the member is missing.
- This makes the scheduled job safe to run daily without depending on the Event table.

Safety:
- Script defaults to dry-run.
- Use -LiveRun to actually add/update Safe members.
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # Confirmed working OAuth Application ID.
    [string]$IdentityOAuthAppId = "RestAPI",

    # OAuth scope configured with REST Regex: Redrock/query
    [string]$OAuthScope         = "reporting",

    # ===== CCP settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== IND Safe matching =====
    [string]$IndSafePrefix      = "IND_",
    [string]$DefaultUserDomain  = "alliantcreditunion.com",
    [string]$PreferredSearchIn  = "alliantcreditunion.com",

    # Kept for compatibility with previous scheduled task command line.
    # Not used in Safe-driven mode because Event table DateFunc queries are failing in this tenant.
    [int]$LookbackDays          = 1,

    # ===== Output =====
    [string]$OutputFolder       = "I:\Script\IDENTITY Script New\logs\INDSafeUserMembership",
    [string]$CsvFilePath        = "",
    [string]$LogFile            = "",

    # ===== Private module folder for this script only =====
    [string]$ScriptModuleRoot   = "I:\Script\IDENTITY Script New\Onbarding Project\Modules",
    [version]$MinimumPsPASVersion = "6.0.0",

    # ===== Run behavior =====
    [switch]$LiveRun,
    [switch]$UpdateExistingMember,
    [switch]$TokenOnly,
    [switch]$IdentityQueryOnly,
    [switch]$ReportUsersWithoutMatchingSafe,

    # ===== Redrock paging =====
    [int]$PageSize              = 1000
)

# Bare execution is dry-run. Live changes require -LiveRun.
$DryRun = -not $LiveRun

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Stop"

# =========================
# Output setup
# =========================

if ($PageSize -lt 1) {
    throw "PageSize must be 1 or higher."
}

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
}

$RunStamp = Get-Date -Format "yyyyMMdd_HHmmss"

if ([string]::IsNullOrWhiteSpace($LogFile)) {
    $LogFile = Join-Path $OutputFolder "INDSafeUserMembership_$RunStamp.log"
}

if ([string]::IsNullOrWhiteSpace($CsvFilePath)) {
    $CsvFilePath = Join-Path $OutputFolder "INDSafeUserMembership_$RunStamp.csv"
}

$script:RunResults = New-Object System.Collections.Generic.List[object]
$script:OriginalPSModulePath = $null

# =========================
# Default IND Safe permissions
# =========================

$IndividualSafePermissions = @{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $false
    RenameAccounts                         = $false
