#Requires -Version 5.1
<#[
 Restores the pre-evidence-workflow Default.aspx backup.
 Does not change stored evidence, records, web.config, or IIS site configuration.
]#>
[CmdletBinding(SupportsShouldProcess=$true,ConfirmImpact='High')]
param(
  [string]$WebRoot='C:\inetpub\PAMDailyHealthCheck',
  [string]$BackupPath='',
  [switch]$AllowOlderChecklistBackup
)
$ErrorActionPreference='Stop'
$target=Join-Path $WebRoot 'Default.aspx'
$backupDir=Join-Path $WebRoot 'ConfigBackups'
if(-not (Test-Path -LiteralPath $target -PathType Leaf)) { throw "Default.aspx not found: $target" }
if(-not (Test-Path -LiteralPath $backupDir -PathType Container)) { throw "Backup directory not found: $backupDir" }
if([string]::IsNullOrWhiteSpace($BackupPath)) {
  $all=@(Get-ChildItem -LiteralPath $backupDir -File -Filter 'Default.before-evidence-workflow-*.aspx' | Sort-Object LastWriteTime -Descending)
  if($all.Count -eq 0) { throw 'No pre-evidence-workflow backup found. No changes made. Do NOT restore an unrelated or older backup.' }
  $BackupPath=$all[0].FullName
}
if(-not (Test-Path -LiteralPath $BackupPath -PathType Leaf)) { throw "Specified backup not found: $BackupPath" }
$backupFull=[IO.Path]::GetFullPath($BackupPath)
$rootFull=[IO.Path]::GetFullPath($backupDir).TrimEnd('\')+'\'
if(-not $backupFull.StartsWith($rootFull,[StringComparison]::OrdinalIgnoreCase)) { throw 'Backup must be within the application ConfigBackups folder.' }
$before=[IO.File]::ReadAllText($backupFull)
if(-not $before.Contains('private void SavePost()') -or -not $before.Contains('private void RenderPage()') -or -not $before.Contains('private void Download()')) { throw 'Selected backup does not look like the expected application.' }
if(-not $AllowOlderChecklistBackup -and -not $before.Contains('Session Diagnostics')) { throw 'Backup lacks check #24 Session Diagnostics. No changes made. Supply the correct patch backup.' }
$live=[IO.File]::ReadAllText($target)
if(-not $live.Contains('private bool EvidenceValid(HttpPostedFile f') -and -not $live.Contains('Manage submission')) {
  Write-Warning 'Current Default.aspx does not show the expected evidence-workflow patch signature. Review before restoring.'
}
$timestamp=Get-Date -Format 'yyyyMMdd-HHmmss'
$failedCopy=Join-Path $backupDir ("Default.failed-evidence-workflow-$timestamp.aspx")
Write-Host "Restore from: $backupFull"
Write-Host "Current file: $target"
Write-Host "Safety copy: $failedCopy"
if($PSCmdlet.ShouldProcess($target,'Restore selected pre-update Default.aspx')) {
  Copy-Item -LiteralPath $target -Destination $failedCopy -ErrorAction Stop
  $temp=Join-Path $WebRoot ("Default.restore-$timestamp.tmp")
  try {
    Copy-Item -LiteralPath $backupFull -Destination $temp -ErrorAction Stop
    Move-Item -LiteralPath $temp -Destination $target -Force -ErrorAction Stop
    Write-Host 'RESTORE COMPLETE. Reload portal with Ctrl+F5.' -ForegroundColor Green
    Write-Host 'Records, Evidence, Revisions, IP allowlist and IIS settings were not modified.'
  } catch {
    if(Test-Path -LiteralPath $failedCopy) { Copy-Item -LiteralPath $failedCopy -Destination $target -Force -ErrorAction SilentlyContinue }
    throw
  } finally { Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue }
}
