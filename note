#Requires -RunAsAdministrator
[CmdletBinding(SupportsShouldProcess=$true)]
param(
    [switch]$Apply,
    [switch]$Rollback,
    [string]$BackupFile,
    [string]$BackupDirectory = 'C:\ProgramData\CyberArk-RDP-TLS-Backup'
)
$ErrorActionPreference = 'Stop'
$ns = 'root/cimv2/TerminalServices'
$filter = "TerminalName='RDP-tcp'"
$policyPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services'
$localPath = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp'
function CurrentSetting {
    Get-CimInstance -Namespace $ns -ClassName Win32_TSGeneralSetting -Filter $filter -ErrorAction Stop
}
function Set-Layer([int]$layer) {
    $obj = CurrentSetting
    $result = Invoke-CimMethod -InputObject $obj -MethodName SetSecurityLayer -Arguments @{SecurityLayer=[uint32]$layer}
    if ($result.ReturnValue -ne 0) { throw "SetSecurityLayer failed, return value $($result.ReturnValue). Check RDP policy and encryption level." }
}
$service = Get-Service TermService -ErrorAction SilentlyContinue
$setting = CurrentSetting
$policy = if (Test-Path $policyPath) { Get-ItemProperty $policyPath -ErrorAction Stop } else { $null }
$policyLayer = if ($null -ne $policy -and $policy.PSObject.Properties.Name -contains 'SecurityLayer') { $policy.SecurityLayer } else { $null }
Write-Host "Host: $env:COMPUTERNAME" -ForegroundColor Cyan
Write-Host "TermService: $($service.Status)"
Write-Host "Effective SecurityLayer: $($setting.SecurityLayer) (0=RDP, 1=Negotiate, 2=SSL/TLS)"
Write-Host "PolicySourceSecurityLayer: $($setting.PolicySourceSecurityLayer) (0=server,1=GPO,2=default)"
Write-Host "GPO registry SecurityLayer: $policyLayer"
Write-Host "MinEncryptionLevel: $($setting.MinEncryptionLevel)"
Write-Host "RDP certificate thumbprint: $($setting.SSLCertificateSHA1Hash)"
if ($Apply -and $Rollback) { throw 'Specify only -Apply or -Rollback.' }
if (-not $Apply -and -not $Rollback) {
    Write-Host 'Audit only. Use -Apply to require SSL/TLS, or -Rollback -BackupFile <path> to restore.' -ForegroundColor Yellow
    return
}
if ($setting.PolicySourceSecurityLayer -eq 1 -or $null -ne $policyLayer) {
    throw "RDP security layer is controlled by Group Policy. No changes made. Change 'Require use of specific security layer for remote (RDP) connections' to SSL in the applicable GPO."
}
if ($Rollback) {
    if (-not $BackupFile) { throw 'Provide -BackupFile pointing to an earlier JSON backup.' }
    $backup = Get-Content -LiteralPath $BackupFile -Raw | ConvertFrom-Json
    if ($backup.ComputerName -ne $env:COMPUTERNAME) { throw 'Backup belongs to a different computer.' }
    $previous = [int]$backup.SecurityLayer
    if ($previous -notin 0,1,2) { throw 'Invalid previous SecurityLayer in backup.' }
    if ($PSCmdlet.ShouldProcess('Local RDP-Tcp','Restore SecurityLayer to ' + $previous)) { Set-Layer $previous }
} else {
    if ($setting.SecurityLayer -eq 2) { Write-Host 'Already configured for SSL/TLS. No change needed.' -ForegroundColor Green; return }
    if ($setting.MinEncryptionLevel -eq 1) { throw 'RDP minimum encryption is Low (1); Windows does not permit SSL/TLS SecurityLayer=2 with this encryption level. No changes made.' }
    if ([string]::IsNullOrWhiteSpace($setting.SSLCertificateSHA1Hash)) { throw 'No bound RDP TLS certificate. No changes made.' }
    $thumb = $setting.SSLCertificateSHA1Hash -replace '\s',''
    $cert = Get-ChildItem Cert:\LocalMachine -Recurse -ErrorAction SilentlyContinue | Where-Object Thumbprint -eq $thumb | Select-Object -First 1
    if (-not $cert -or -not $cert.HasPrivateKey -or $cert.NotAfter -le (Get-Date) -or $cert.NotBefore -gt (Get-Date)) {
        throw 'Bound RDP certificate is absent, invalid, or has no accessible private key. No changes made.'
    }
    if ($PSCmdlet.ShouldProcess('Local RDP-Tcp','Back up settings and set SecurityLayer to 2 (SSL/TLS)')) {
        New-Item -ItemType Directory -Path $BackupDirectory -Force | Out-Null
        $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
        $backupPath = Join-Path $BackupDirectory "RDP-TLS-$env:COMPUTERNAME-$stamp.json"
        [pscustomobject]@{
            ComputerName=$env:COMPUTERNAME
            Timestamp=(Get-Date).ToString('o')
            SecurityLayer=[int]$setting.SecurityLayer
            PolicySourceSecurityLayer=[int]$setting.PolicySourceSecurityLayer
            CertificateThumbprint=$thumb
        } | ConvertTo-Json | Set-Content -LiteralPath $backupPath -Encoding UTF8
        $regBackup = Join-Path $BackupDirectory "RDP-Tcp-$env:COMPUTERNAME-$stamp.reg"
        & reg.exe export 'HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' $regBackup /y | Out-Null
        Set-Layer 2
        Write-Host "Backup JSON: $backupPath" -ForegroundColor Green
        Write-Host "Registry backup: $regBackup"
    }
}
$new = CurrentSetting
Write-Host "Current effective SecurityLayer: $($new.SecurityLayer)" -ForegroundColor Cyan
if ($new.SecurityLayer -ne $(if ($Rollback) {$previous} else {2})) { Write-Warning 'Setting does not match requested value. Check Group Policy and applied configuration.' }
Write-Warning 'Do not restart TermService automatically on a production PSM; it may disconnect sessions. Test a new connection in an approved change window and review SIA Session Diagnostics.'
