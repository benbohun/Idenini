review permission payload below

  # --- Permissions payloads ---
    $permAdmin = Get-AdminPerms
    $permOwner = Get-OwnerPerms

    # --- Add IAM_ACU_CA_Admins (full perms) – UPN then sAM on invalid parameters ---
    $iamUpn = 'IAM_ACU_CA_Admins@alliantcreditunion.com'
    $iamSam = 'IAM_ACU_CA_Admins'

    Write-Info "Ensuring IAM_ACU_CA_Admins membership on '$safeName'..."
    $iamDone = $false
    try {
        Ensure-SafeMember -SafeName $safeName -MemberName $iamUpn -MemberType Group -PermFlags $permAdmin
        $iamDone = $true
    }
    catch {
        $msg = $_.Exception.Message
        Write-Warn "UPN '$iamUpn' failed on '$safeName': $msg"
        if ($msg -match 'invalid parameters') {
            Write-Info "Retrying with sAMAccountName '$iamSam'..."
            Ensure-SafeMember -SafeName $safeName -MemberName $iamSam -MemberType Group -PermFlags $permAdmin
            $iamDone = $true
        }
        else {
            throw
        }
    }
    if ($iamDone) {
        Write-Ok "IAM_ACU_CA_Admins membership ensured on '$safeName'."
    }

    # --- Add Owner (email) with limited owner perms; same pattern as IAM group ---
    Write-Info "Ensuring Owner '$mail' membership on '$safeName'..."
    $ownerDone = $false

    try {
        Ensure-SafeMember -SafeName $safeName -MemberName $mail -MemberType User -PermFlags $permOwner
        $ownerDone = $true
    }
    catch {
        $msg = $_.Exception.Message
        Write-Warn "Owner UPN '$mail' failed on '$safeName': $msg"

        if ($msg -match 'invalid parameters' -and $mail -like '*@*') {
            $ownerSam = $mail.Split('@')[0]
            Write-Info "Retrying Owner with sAM '$ownerSam'..."
            Ensure-SafeMember -SafeName $safeName -MemberName $ownerSam -MemberType User -PermFlags $permOwner
            $ownerDone = $true
        }
        else {
            throw
        }
    }

    if ($ownerDone) {
        # Description: strip domain from owner for description
        $ownerNoDomain = $mail.Split('@')[0]
        try {
            $desc = "Individual safe for $sam ($eid) – Managed By $ownerNoDomain"
            Set-PASSafe -SafeName $safeName -Description $desc -ErrorAction Stop | Out-Null
            Write-Ok "Description set on '$safeName': '$desc'"
        } catch {
            Write-Warn "Could not set description on '$safeName': $($_.Exception.Message)"
        }
    }

    Write-Ok "Completed processing '$safeName'."
}

# --- MAIN ---
$sessionCreated = $false

try {
    # 1) Get Shared Services API Service User creds from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 2) Authenticate via Identity Shared Services using SERVICE USER
    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    # 3) Process based on Mode
    if ($Mode -eq 'CSV') {
        Write-Info "Mode = CSV. Loading: $CsvPath"
        if (-not (Test-Path $CsvPath)) {
            throw "CSV not found: $CsvPath"
        }
        $rows = Import-Csv -Path $CsvPath
        if (-not $rows -or $rows.Count -eq 0) {
            throw "CSV '$CsvPath' has no rows."
        }

        foreach ($row in $rows) {
            $sam  = ($row.Samaccountname).ToString()
            $eid  = ($row.employeeID).ToString()
            $mail = ($row.email).ToString()
            Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail
        }

        Write-Ok "CSV processing completed for $($rows.Count) row(s)."
    }
    else {
        Write-Info "Mode = Single. Prompting for one IND_ Safe owner..."

        $sam = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter SamAccountName (e.g. jdoe)" `
            -Default "" `
            -ValidationHint "SamAccountName only" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $sam) { Write-Warn "Cancelled (SamAccountName)."; return }

        $eid = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter employeeID" `
            -Default "" `
            -ValidationHint "HR/AD employeeID" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $eid) { Write-Warn "Cancelled (employeeID)."; return }

        $mail = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter owner email (UPN)" `
            -Default "" `
            -ValidationHint "Example: user@alliantcreditunion.com" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }

        if (-not $mail) { Write-Warn "Cancelled (email)."; return }

        Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail
    }
}
catch {
    Write-Err $_
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
