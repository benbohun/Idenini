<#
Test_SWS_TokenGeneration_Only_V6_NoSilentClose.ps1

Purpose
- ONLY test CyberArk SWS service-account token generation.
- Does NOT create Identity apps.
- Does NOT update Identity apps.
- Does NOT call/copy SWS policies.
- Uses CyberArk public API auth helper JAR.
- PowerShell 5.1 compatible.
- Prevents silent-close by logging everything and pausing at the end.

Expected files in same folder as this script:
- public-api-auth-helper-*.jar
- SWS service-account JSON file containing serviceAccountId, privateKey, discoveryURI
- Portable Java path default below, or pass -JavaPath
#>

[CmdletBinding()]
param(
    [string]$TenantId = 'eef31a0b-0e67-4024-a644-be08614190db',
    [string]$JavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',
    [string]$JsonPath = '',
    [string]$HelperJarPath = '',
    [int]$TimeoutSeconds = 90,
    [switch]$ShowToken,
    [switch]$NoPause
)

$script:ScriptRoot = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Path }
$script:LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only_V6.log'
$script:RunStamp = Get-Date -Format 'yyyyMMdd_HHmmss'

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $line = "{0} - {1}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $script:LogPath -Value $line -Encoding UTF8 } catch {}
}

function Protect-Token {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 20) { return ('*' * $Token.Length) }
    return ('{0}...{1}' -f $Token.Substring(0,10), $Token.Substring($Token.Length-8))
}

function Get-FileTextSafe {
    param([string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) { return '' }
    try { return [System.IO.File]::ReadAllText($Path) } catch { return '' }
}

function Get-NewestHelperJar {
    if (-not [string]::IsNullOrWhiteSpace($HelperJarPath)) {
        $resolved = if ([System.IO.Path]::IsPathRooted($HelperJarPath)) { $HelperJarPath } else { Join-Path $script:ScriptRoot $HelperJarPath }
        if (-not (Test-Path -LiteralPath $resolved)) { throw "Helper JAR not found: $resolved" }
        return (Get-Item -LiteralPath $resolved).FullName
    }

    $jars = @(Get-ChildItem -Path $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -lt 1) { throw "No public-api-auth-helper*.jar found in $script:ScriptRoot" }
    return $jars[0].FullName
}

function Get-NewestSwsJson {
    if (-not [string]::IsNullOrWhiteSpace($JsonPath)) {
        $resolved = if ([System.IO.Path]::IsPathRooted($JsonPath)) { $JsonPath } else { Join-Path $script:ScriptRoot $JsonPath }
        if (-not (Test-Path -LiteralPath $resolved)) { throw "SWS JSON not found: $resolved" }
        return (Get-Item -LiteralPath $resolved).FullName
    }

    $valid = @()
    $jsonFiles = @(Get-ChildItem -Path $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    foreach ($f in $jsonFiles) {
        try {
            $raw = Get-Content -LiteralPath $f.FullName -Raw -ErrorAction Stop
            $obj = $raw | ConvertFrom-Json -ErrorAction Stop
            $sid = $obj.serviceAccountId
            $pk  = $obj.privateKey
            $du  = $obj.discoveryURI
            if (-not [string]::IsNullOrWhiteSpace($sid) -and -not [string]::IsNullOrWhiteSpace($pk) -and -not [string]::IsNullOrWhiteSpace($du)) {
                $valid += [pscustomobject]@{
                    FullName         = $f.FullName
                    Name             = $f.Name
                    LastWriteTime    = $f.LastWriteTime
                    ServiceAccountId = [string]$sid
                    DiscoveryURI     = [string]$du
                }
            }
        } catch {}
    }

    if ($valid.Count -lt 1) { throw "No valid SWS service-account JSON found in $script:ScriptRoot. Expected fields: serviceAccountId, privateKey, discoveryURI." }

    Write-Log ("Valid SWS JSON file count={0}" -f $valid.Count) 'Cyan'
    foreach ($v in $valid) {
        Write-Log ("JSON candidate: File={0}; ServiceAccountId={1}; LastWriteTime={2}" -f $v.Name, $v.ServiceAccountId, $v.LastWriteTime) 'Gray'
    }

    return $valid[0].FullName
}

function Get-TenantCandidates {
    param([Parameter(Mandatory)][string]$Tenant)
    $items = New-Object System.Collections.Generic.List[string]
    $raw = $Tenant.Trim()
    if (-not [string]::IsNullOrWhiteSpace($raw)) { $items.Add($raw) }
    $normalized = ($raw -replace '-', '').Trim()
    if (-not [string]::IsNullOrWhiteSpace($normalized) -and -not $items.Contains($normalized)) { $items.Add($normalized) }
    return @($items.ToArray())
}

function Test-JavaExecutable {
    param([Parameter(Mandatory)][string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) { throw "java.exe not found: $Path" }
    Write-Log "Testing Java executable: $Path" 'Cyan'

    $out = Join-Path $script:ScriptRoot ("SWS_JavaVersion_{0}_stdout.txt" -f $script:RunStamp)
    $err = Join-Path $script:ScriptRoot ("SWS_JavaVersion_{0}_stderr.txt" -f $script:RunStamp)

    $cmd = '"{0}" -version > "{1}" 2> "{2}"' -f $Path, $out, $err
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = 'cmd.exe'
    $psi.Arguments = '/d /s /c "' + $cmd + '"'
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true

    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi
    [void]$p.Start()
    $ok = $p.WaitForExit(15000)
    if (-not $ok) {
        try { & taskkill.exe /PID $p.Id /T /F | Out-Null } catch {}
        throw "java -version timed out after 15 seconds."
    }

    $text = ((Get-FileTextSafe $out) + "`n" + (Get-FileTextSafe $err)).Trim()
    if ([string]::IsNullOrWhiteSpace($text)) { $text = '<no version output captured>' }
    Write-Log "Java version output: $text" 'Gray'
    if ($p.ExitCode -ne 0) { throw "java -version returned exit code $($p.ExitCode). See $out and $err" }
}

function Extract-AccessToken {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $null }

    $patterns = @(
        '"access_token"\s*:\s*"([^"]+)"',
        'access_token\s*[=:]\s*"?([A-Za-z0-9_\-\.]+)"?',
        '(eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+)'
    )

    foreach ($pattern in $patterns) {
        $m = [regex]::Match($Text, $pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
        if ($m.Success -and $m.Groups.Count -gt 1) { return $m.Groups[1].Value }
    }
    return $null
}

function Run-HelperAttempt {
    param(
        [Parameter(Mandatory)][string]$Tenant,
        [Parameter(Mandatory)][string]$Java,
        [Parameter(Mandatory)][string]$Jar,
        [Parameter(Mandatory)][string]$Json,
        [Parameter(Mandatory)][int]$Attempt
    )

    $stdout = Join-Path $script:ScriptRoot ("SWS_Helper_Attempt_{0}_{1}_stdout.txt" -f $Attempt, $script:RunStamp)
    $stderr = Join-Path $script:ScriptRoot ("SWS_Helper_Attempt_{0}_{1}_stderr.txt" -f $Attempt, $script:RunStamp)

    Write-Log ("Helper token attempt #{0}: TenantId={1}" -f $Attempt, $Tenant) 'Cyan'
    Write-Log ("Helper stdout file: {0}" -f $stdout) 'Gray'
    Write-Log ("Helper stderr file: {0}" -f $stderr) 'Gray'

    $cmd = '"{0}" -jar "{1}" -t "{2}" -p "{3}" > "{4}" 2> "{5}"' -f $Java, $Jar, $Tenant, $Json, $stdout, $stderr
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = 'cmd.exe'
    $psi.Arguments = '/d /s /c "' + $cmd + '"'
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true

    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi
    [void]$p.Start()

    $timeoutMs = [Math]::Max(10, $TimeoutSeconds) * 1000
    $finished = $p.WaitForExit($timeoutMs)
    if (-not $finished) {
        Write-Log ("Helper attempt #{0} timed out after {1} seconds. Killing process tree..." -f $Attempt, $TimeoutSeconds) 'Red'
        try { & taskkill.exe /PID $p.Id /T /F | Out-Null } catch {}
        return [pscustomobject]@{
            Success = $false
            Token = $null
            ExitCode = $null
            TimedOut = $true
            StdoutPath = $stdout
            StderrPath = $stderr
            Output = ((Get-FileTextSafe $stdout) + "`n" + (Get-FileTextSafe $stderr)).Trim()
        }
    }

    $combined = ((Get-FileTextSafe $stdout) + "`n" + (Get-FileTextSafe $stderr)).Trim()
    $token = Extract-AccessToken -Text $combined

    Write-Log ("Helper attempt #{0} completed. ExitCode={1}; OutputLength={2}" -f $Attempt, $p.ExitCode, $combined.Length) 'Gray'

    if (-not [string]::IsNullOrWhiteSpace($token)) {
        Write-Log ("SUCCESS: Helper returned access_token. MaskedToken={0}; Length={1}" -f (Protect-Token $token), $token.Length) 'Green'
        return [pscustomobject]@{
            Success = $true
            Token = $token
            ExitCode = $p.ExitCode
            TimedOut = $false
            StdoutPath = $stdout
            StderrPath = $stderr
            Output = $combined
        }
    }

    $preview = $combined
    if ($preview.Length -gt 2500) { $preview = $preview.Substring(0,2500) + '...<truncated>' }
    if ([string]::IsNullOrWhiteSpace($preview)) { $preview = '<no helper output captured>' }

    Write-Log ("FAILED: Helper did not return access_token. ExitCode={0}. OutputPreview={1}" -f $p.ExitCode, $preview) 'Yellow'

    return [pscustomobject]@{
        Success = $false
        Token = $null
        ExitCode = $p.ExitCode
        TimedOut = $false
        StdoutPath = $stdout
        StderrPath = $stderr
        Output = $combined
    }
}

$overallSuccess = $false
try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V6 Started =====' 'Cyan'
    Write-Log "ScriptRoot=$script:ScriptRoot" 'Gray'
    Write-Log "LogPath=$script:LogPath" 'Gray'

    $java = if ([System.IO.Path]::IsPathRooted($JavaPath)) { $JavaPath } else { Join-Path $script:ScriptRoot $JavaPath }
    Test-JavaExecutable -Path $java

    $jar = Get-NewestHelperJar
    $json = Get-NewestSwsJson
    Write-Log "Using helper JAR: $jar" 'Cyan'
    Write-Log "Using SWS service-account JSON: $json" 'Cyan'

    $jsonObj = (Get-Content -LiteralPath $json -Raw -ErrorAction Stop) | ConvertFrom-Json -ErrorAction Stop
    Write-Log ("JSON summary: ServiceAccountId={0}; DiscoveryURI={1}" -f $jsonObj.serviceAccountId, $jsonObj.discoveryURI) 'Cyan'

    $tenants = Get-TenantCandidates -Tenant $TenantId
    Write-Log ("Tenant candidate count={0}; Candidates={1}" -f $tenants.Count, ($tenants -join ', ')) 'Cyan'

    $attempt = 0
    foreach ($tenant in $tenants) {
        $attempt++
        $result = Run-HelperAttempt -Tenant $tenant -Java $java -Jar $jar -Json $json -Attempt $attempt
        if ($result.Success) {
            $overallSuccess = $true
            Write-Log 'TOKEN GENERATION SUCCESS.' 'Green'
            Write-Log ("SuccessfulTenantId={0}" -f $tenant) 'Green'
            Write-Log ("Token stdout file: {0}" -f $result.StdoutPath) 'Gray'
            Write-Log ("Token stderr file: {0}" -f $result.StderrPath) 'Gray'
            if ($ShowToken) {
                Write-Host ''
                Write-Host '===== RAW ACCESS TOKEN START =====' -ForegroundColor Green
                Write-Host $result.Token
                Write-Host '===== RAW ACCESS TOKEN END =====' -ForegroundColor Green
                Write-Host ''
            }
            break
        }
    }

    if (-not $overallSuccess) {
        throw 'TOKEN GENERATION FAILED. No access_token was returned by the CyberArk helper. Review the SWS_Helper_Attempt_*_stdout/stderr files created beside this script.'
    }
}
catch {
    Write-Log ("FATAL ERROR: {0}" -f $_.Exception.Message) 'Red'
}
finally {
    if ($overallSuccess) {
        Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V6 Finished: SUCCESS =====' 'Green'
    } else {
        Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V6 Finished: FAILED =====' 'Red'
    }

    if (-not $NoPause) {
        try { Read-Host 'Press ENTER to close this token diagnostic window' | Out-Null } catch {}
    }
}
