PAPMAPIConnect
$Error.clear()

If ($Session){

#Path
$ToolPath = "D:\Scripts\PRODToolScripts\PAPM-Tools\"

#Read Warning
Write-Host ""
Write-Host -ForegroundColor Red -BackgroundColor Gray        " WARNING                                                                                "
Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Before you proceed, the following is required:                                         "
