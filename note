whoami
$env:USERPROFILE

::::::::::::::::::::::::::::::::::

$Path = 'C:\Users\CAG1896a'

Write-Host "`nProfile directory:"
Test-Path -LiteralPath $Path

Write-Host "`nProfile registry hive:"
Test-Path -LiteralPath "$Path\NTUSER.DAT"

Write-Host "`nProfile folder permissions:"
icacls $Path

Write-Host "`nProfile hive permissions:"
if (Test-Path "$Path\NTUSER.DAT") {
    icacls "$Path\NTUSER.DAT"
}


:::::::::::::::::::::::::::::::::::::::::


$ErrorActionPreference = 'Stop'

$SID = 'S-1-5-21-1757981266-1417001333-725345543-944238'
$Profile = 'C:\Users\CAG1896a'
$Base = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
$NativeBase = 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
$Backup = 'E:\ProfileRepairBackup'

if ($env:USERNAME -ieq 'CAG1896a') {
    throw 'Sign in with a different administrator account.'
}

if (-not (Test-Path -LiteralPath "$Profile\NTUSER.DAT")) {
    throw 'Original profile hive is missing. Repair stopped.'
}

$Sessions = @(quser 2>$null)
if ($Sessions | Where-Object {
    $_ -match '(?i)\bcag1896a\b'
}) {
    throw 'CAG1896a still has a session. Sign it out first.'
}

$Old = Get-ItemProperty -LiteralPath "$Base\$SID"
$Bak = Get-ItemProperty -LiteralPath "$Base\$SID.bak"

if ($Old.ProfileImagePath -ine 'C:\Users\TEMP') {
    throw 'Unexpected active profile path. Repair stopped.'
}
if ($Bak.ProfileImagePath -ine $Profile) {
    throw 'Unexpected backup profile path. Repair stopped.'
}

New-Item -ItemType Directory -Path $Backup -Force |
    Out-Null

& reg.exe export "$NativeBase\$SID" `
    "$Backup\TEMP-SID.reg" /y
if ($LASTEXITCODE -ne 0) {
    throw 'TEMP key backup failed'
}

& reg.exe export "$NativeBase\$SID.bak" `
    "$Backup\Original-SID.reg" /y
if ($LASTEXITCODE -ne 0) {
    throw 'Original key backup failed'
}

$Preserved = "$SID.temp-preserved"

if (Test-Path -LiteralPath "$Base\$Preserved") {
    throw 'A preserved key already exists. Repair stopped.'
}

$Confirm = Read-Host 'Type REPAIR to restore the original profile'
if ($Confirm -cne 'REPAIR') {
    throw 'Cancelled'
}

Rename-Item -LiteralPath "$Base\$SID" `
    -NewName $Preserved

Rename-Item -LiteralPath "$Base\$SID.bak" `
    -NewName $SID

Set-ItemProperty -LiteralPath "$Base\$SID" `
    -Name State -Type DWord -Value 0

Set-ItemProperty -LiteralPath "$Base\$SID" `
    -Name RefCount -Type DWord -Value 0

Get-ItemProperty -LiteralPath "$Base\$SID" |
    Select-Object ProfileImagePath,State,RefCount

Write-Host 'Registry mapping restored. Re-login and verify.' `
    -ForegroundColor Green
  
