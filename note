Update the set offline and online script, instead of updating the content of the htlp file, leave as it is and just rename file to Healthcheck_Offline.html to set offline and rename back to Healthcheck.html to set online
Content should remain as 

$OkHtmlContent = @"
<!DOCTYPE html>
<html lang="en">
<body>
    <p>Status: OK</p>
</body>
</html>
"@

Offline

# Define path to HTML file and log file
$IndexFilePath = "C:\inetpub\wwwroot\Healthcheck.html"
$LogFile = "C:\log\Set_Component_Status.log"

# Define OFFLINE HTML content
$OfflineHtmlContent = @"
<!DOCTYPE html>
<html lang="en">
<body>
    <p>Status: OFFLINE</p>
</body>
</html>
"@

# Write the OFFLINE content to the HTML file
$OfflineHtmlContent | Set-Content -Path $IndexFilePath -Force

# Perform IIS reset and capture output
$Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
try {
    $IISResetOutput = iisreset
    Add-Content -Path $LogFile -Value "[$Timestamp] IISReset executed successfully:`n$IISResetOutput"
} catch {
    Add-Content -Path $LogFile -Value "[$Timestamp] IISReset failed: $_"
    Write-Host "❗ IISReset failed. Check log for details."
    exit 1
}

# Log the status change
$Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
"[$Timestamp] Status set to OFFLINE" | Add-Content -Path $LogFile

Write-Host "❌ Status set to OFFLINE and changes applied."



::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


Online

# Define path to HTML file and log file
$IndexFilePath = "C:\inetpub\wwwroot\Healthcheck.html"
$LogFile = "C:\log\Set_Component_Status.log"

# Define OK HTML content
$OkHtmlContent = @"
<!DOCTYPE html>
<html lang="en">
<body>
    <p>Status: OK</p>
</body>
</html>
"@

# Write the OK content to the HTML file
$OkHtmlContent | Set-Content -Path $IndexFilePath -Force

# Perform IIS reset and capture output
$Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
try {
    $IISResetOutput = iisreset
    Add-Content -Path $LogFile -Value "[$Timestamp] IISReset executed successfully:`n$IISResetOutput"
} catch {
    Add-Content -Path $LogFile -Value "[$Timestamp] IISReset failed: $_"
    Write-Host "❗ IISReset failed. Check log for details."
    exit 1
}

# Log the status change
$Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
"[$Timestamp] Status set to OK" | Add-Content -Path $LogFile

Write-Host "✔ Status set to OK and changes applied."
