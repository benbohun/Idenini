# ============================

# Script A: Generate CSR + Private Key (exportable)

# ============================
 
$ErrorActionPreference = 'Stop'
 
# ---- Prompts ----

$CN   = Read-Host "CN (e.g. sqlserver.cna.com)"

$SANs = Read-Host "Optional: extra SANs (comma-separated) or blank"
 
# ---- Config ----

$UseLocalMachine = $false        # $false = CurrentUser\My (no admin), $true = LocalMachine\My (run as Admin)

$keyBits         = 2048          # use 3072/4096 if your policy requires
 
# Subject fields (edit for your org)

$OU='IAM-CyberArk CCP'; $O='CNA FINANCIAL CORPORATION'; $L='Chicago'; $ST='Illinois'; $C='US'
 
# Provider (broad compatibility; CSP)

$ProviderName = 'Microsoft Enhanced RSA and AES Cryptographic Provider'

$ProviderType = 24  # PROV_RSA_AES
 
# ---- Paths / names ----

$TempRoot = 'C:\Temp'

if (!(Test-Path $TempRoot)) { New-Item -ItemType Directory -Path $TempRoot | Out-Null }
 
$SafeCN   = ($CN -replace '[^\w\.-]','_')

$Stamp    = Get-Date -Format 'yyyyMMdd_HHmmss'

$BaseDir  = Join-Path $TempRoot "CyberArk_CCP_${SafeCN}_$Stamp"

[IO.Directory]::CreateDirectory($BaseDir) | Out-Null
 
$ReqInf    = Join-Path $BaseDir 'csr.inf'

$CsrPath   = Join-Path $BaseDir 'client.csr'

$MetaPath  = Join-Path $BaseDir 'metadata.txt'
 
$MachineKeySet  = if ($UseLocalMachine) { 'TRUE' } else { 'FALSE' }

$CertreqContext = if ($UseLocalMachine) { '' }    else { '-user' }

$StorePath      = if ($UseLocalMachine) { 'Cert:\LocalMachine\My' } else { 'Cert:\CurrentUser\My' }
 
$KeyContainer = "CCP_${SafeCN}_$Stamp"

$Subject      = "CN=$CN, OU=$OU, O=$O, L=$L, S=$ST, C=$C"
 
# SANs (always include CN)

$sanList = @($CN)

if ($SANs) { $sanList += ($SANs -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ }) }

$sanText = 'dns=' + ($sanList -join '&dns=')
 
# ---- Build INF (single-quoted here-string; placeholders replaced)

$csrInf = @'

[Version]

Signature="$Windows NT$"
 
[NewRequest]

Subject = "{SUBJECT}"

KeySpec = 1

KeyLength = {KEYBITS}

Exportable = TRUE

MachineKeySet = {MACHINEKEYSET}

SMIME = FALSE

PrivateKeyArchive = FALSE

UserProtected = FALSE

UseExistingKeySet = FALSE

ProviderName = "{PROVIDERNAME}"

ProviderType = {PROVIDERTYPE}

RequestType = PKCS10

KeyUsage = 0xa0

KeyContainer = "{KEYCONTAINER}"
 
[Extensions]

; Subject Alternative Name

2.5.29.17 = "{text}"

_continue_ = "{SANTEXT}"

; EKU: Client Authentication

2.5.29.37 = "{text}"

_continue_ = "1.3.6.1.5.5.7.3.2"

'@
 
$csrInf = $csrInf.Replace('{SUBJECT}',$Subject).

                  Replace('{KEYBITS}',$keyBits).

                  Replace('{MACHINEKEYSET}',$MachineKeySet).

                  Replace('{PROVIDERNAME}',$ProviderName).

                  Replace('{PROVIDERTYPE}',$ProviderType).

                  Replace('{KEYCONTAINER}',$KeyContainer).

                  Replace('{SANTEXT}',$sanText)
 
[IO.File]::WriteAllText($ReqInf, $csrInf, [Text.Encoding]::ASCII)
 
# ---- Create CSR (and generate the key in the store)
& certreq $CertreqContext -new "`"$ReqInf`"" "`"$CsrPath`"" | Out-Null

if (!(Test-Path $CsrPath)) { throw "CSR was not created. See $ReqInf for details." }
 
# ---- Metadata for later step

$meta = @"

== CSR Generated ==

CN:           $CN

Subject:      $Subject

SANs:         $($sanList -join ', ')

CSR path:     $CsrPath

Store:        $StorePath

KeyContainer: $KeyContainer

Provider:     $ProviderName (Type $ProviderType)

"@

[IO.File]::WriteAllText($MetaPath, $meta, [Text.Encoding]::UTF8)
 
Write-Host "✅ CSR created: $CsrPath"

Write-Host "   (Private key is in: $StorePath ; KeyContainer: $KeyContainer)"

Write-Host "ℹ️  Metadata: $MetaPath"
