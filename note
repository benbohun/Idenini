<#
.SYNOPSIS
    Looks up CyberArk Account IDs from a CSV using CyberArk username and address.

.DESCRIPTION
    Read-only lookup helper.

    The input CSV keeps the AD account name field so it can be used later as the
    desired CyberArk username value during a separate update process.

    Line of action:
      1. Load shared .env and selected env\<dev|prod>.env.
      2. Apply proxy settings.
      3. Prompt for CyberArk Identity service-user credentials.
      4. Request an OAuth bearer token from /oauth2/platformtoken.
      5. Keep the real token only in memory and log only a short SHA256 fingerprint.
      6. Import CSV with AD account name, CyberArk username, and CyberArk address.
      7. Search CyberArk accounts by username and filter exact username/address matches.
      8. If needed, search by address as a secondary lookup and filter exact matches.
      9. Write a result CSV with AccountID, SafeName, PlatformID, and match status.

.NOTES
    Designed for Windows PowerShell 5.1.
    Read-only script. No CyberArk account data is changed.
    Do not store service-user passwords, bearer tokens, or production CSV output in Git.

.EXAMPLE
    .\Find-CyberArkAccountIds.ps1 -Environment dev

.EXAMPLE
    .\Find-CyberArkAccountIds.ps1 -Environment prod -CsvFile .\samples\account-id-lookup-template.csv

.EXAMPLE
    .\Find-CyberArkAccountIds.ps1 -Environment prod -ProxyUseDefaultCredentials
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    # CSV with AD account name, current CyberArk username, and CyberArk address.
    [string]$CsvFile = (Join-Path $PSScriptRoot 'samples\account-id-lookup-template.csv'),

    # Selects env\dev.env or env\prod.env.
    [ValidateSet('dev','prod')]
    [string]$Environment = 'dev',

    # Folder that contains dev.env and prod.env.
    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    # Uses the logged-in Windows identity for proxy authentication.
    [switch]$ProxyUseDefaultCredentials,

    # Case-insensitive exact match is the default. Use this for case-sensitive filtering.
    [switch]$CaseSensitiveMatch,

    # Where CSV reports are written.
    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    # Where logs are written.
    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    # Optional suffix for log/report file names.
    [string]$LogId = ''
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

<#
    Bootstrap proxy setup.
    Leave as Placehold and use env\dev.env or env\prod.env normally:
        PROXY="http://proxy.company.com:8080"
#>
$proxyUri = "Placehold"

if ($proxyUri -and $proxyUri.Trim() -notmatch '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') {
    $proxy = New-Object System.Net.WebProxy($proxyUri, $true)
    [System.Net.WebRequest]::DefaultWebProxy = $proxy
    [System.Net.WebRequest]::DefaultWebProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
    [System.Net.WebRequest]::DefaultWebProxy.Address | Out-Null
}

$script:LogFile = $null
$script:ReportFile = $null
$script:Config = $null
$script:SearchCache = @{}

function Test-BlankValue {
    param([object]$Value)

    if ($null -eq $Value) { return $true }

    $text = $Value.ToString().Trim()

    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }

    return $false
}

function New-RunLog {
    if (-not (Test-Path $LogFolder)) {
        New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null
    }

    if (-not (Test-Path $ReportFolder)) {
        New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
    }

    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }

    $script:LogFile = Join-Path $LogFolder "Find-CyberArkAccountIds_$stamp$suffix.log"
    $script:ReportFile = Join-Path $ReportFolder "CyberArk_AccountIdLookup_Report_$stamp$suffix.csv"

    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) source=New-RunLog [INFO] Starting run"
}

function Write-RunLog {
    param(
        [string]$Source,
        [string]$Message,

        [ValidateSet('DEBUG','INFO','WARN','ERROR')]
        [string]$Level = 'INFO'
    )

    $line = "$(Get-Date -Format s) source=$Source [$Level] $Message"
    Add-Content -Path $script:LogFile -Value $line

    if ($Level -eq 'ERROR') {
        Write-Host $line -ForegroundColor Red
    }
    elseif ($Level -eq 'WARN') {
        Write-Host $line -ForegroundColor Yellow
    }
    else {
        Write-Host $line
    }
}

function Read-DotEnvFile {
    param([string]$Path)

    $result = @{}

    if (-not (Test-Path $Path)) {
        return $result
    }

    foreach ($line in (Get-Content -Path $Path -ErrorAction Stop)) {
        $trimmed = $line.Trim()

        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }

        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()

        if ($value.Length -ge 2) {
            if (
                ($value.StartsWith('"') -and $value.EndsWith('"')) -or
                ($value.StartsWith("'") -and $value.EndsWith("'"))
            ) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }

        if (-not (Test-BlankValue $key)) {
            $result[$key] = $value
        }
    }

    return $result
}

function Join-EnvValues {
    param([hashtable[]]$Maps)

    $merged = @{}

    foreach ($map in $Maps) {
        foreach ($key in $map.Keys) {
            $merged[$key] = $map[$key]
        }
    }

    return $merged
}

function Normalize-PvwaApiBase {
    param([string]$PvwaValue)

    $base = $PvwaValue.Trim().TrimEnd('/')

    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Accounts/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/Accounts/.+$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/.+$', '/PasswordVault/API'

    if ($base -match '/PasswordVault/API$') {
        return $base
    }

    if ($base -match '/PasswordVault$') {
        return "$base/API"
    }

    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    param([hashtable]$Settings)

    $tenant = $Settings['TENANT_ID']

    if (Test-BlankValue $tenant) {
        throw 'TENANT_ID is missing in .env. Example: TENANT_ID=abq4291 or TENANT_ID=https://abq4291.id.cyberark.cloud'
    }

    $tenant = $tenant.Trim().TrimEnd('/')

    if ($tenant -match '^https?://') {
        return $tenant
    }

    if ($tenant -match '\.id\.cyberark\.cloud$') {
        return "https://$tenant"
    }

    if ($tenant -match '\.') {
        return "https://$tenant"
    }

    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    param([hashtable]$Settings)

    $proxy = $Settings['PROXY']

    if (-not (Test-BlankValue $proxy)) {
        return $proxy.Trim()
    }

    $proxyAddress = $Settings['PROXY_ADDRESS']

    if (Test-BlankValue $proxyAddress) {
        $proxyAddress = $Settings['ROXY_ADDRESS']
    }

    $proxyPort = $Settings['PROXY_PORT']

    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) {
        return $null
    }

    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')

    if ($proxyAddress -notmatch '^https?://') {
        $proxyAddress = "http://$proxyAddress"
    }

    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"

    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}

    if (Test-Path $envFile1) {
        $envSpecific = Read-DotEnvFile -Path $envFile1
    }
    elseif (Test-Path $envFile2) {
        $envSpecific = Read-DotEnvFile -Path $envFile2
    }
    else {
        throw "Could not find environment file for '$Environment'. Expected $envFile1 or $envFile2"
    }

    $settings = Join-EnvValues -Maps @($base, $envSpecific)

    if (Test-BlankValue $settings['PVWA']) {
        if (Test-BlankValue $settings['SUB_DOMAIN']) {
            throw 'PVWA is missing and SUB_DOMAIN is not set. Set PVWA in dev.env/prod.env or SUB_DOMAIN in .env.'
        }

        $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud"
    }

    $identityBase = Resolve-IdentityBase -Settings $settings
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings

    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)

        if ($ProxyUseDefaultCredentials) {
            $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
        }

        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }

    $script:Config = [pscustomobject]@{
        Environment = $Environment
        IdentityBase = $identityBase
        TokenUrl = "$identityBase/oauth2/platformtoken"
        ApiBase = $apiBase
        Proxy = $proxyFromEnv
    }

    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    param([hashtable]$Body)

    $pairs = @()

    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }

    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    param([string]$Text)

    $sha = [System.Security.Cryptography.SHA256]::Create()

    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)
        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally {
        $sha.Dispose()
    }
}

function Get-WebErrorText {
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)

    $msg = $ErrorRecord.Exception.Message
    $response = $ErrorRecord.Exception.Response

    if ($null -ne $response) {
        try {
            $stream = $response.GetResponseStream()

            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)
                $body = $reader.ReadToEnd()

                if (-not (Test-BlankValue $body)) {
                    $msg = "$msg | Response: $body"
                }
            }
        }
        catch {
            # Keep original error.
        }
    }

    return $msg
}

function Get-IdentityBearerToken {
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'

    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'

    $body = ConvertTo-FormBody -Body @{
        grant_type = 'client_credentials'
        client_id = $credential.UserName
        client_secret = $credential.GetNetworkCredential().Password
    }

    $params = @{
        Method = 'Post'
        Uri = $script:Config.TokenUrl
        Body = $body
        ContentType = 'application/x-www-form-urlencoded'
        Headers = @{ Accept = 'application/json' }
        ErrorAction = 'Stop'
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        $response = Invoke-RestMethod @params
    }
    catch {
        throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)"
    }

    if ($null -eq $response.access_token) {
        throw 'Identity token response did not include access_token.'
    }

    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token

    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'INFO'

    return $token
}

function Invoke-CyberArkRest {
    param(
        [ValidateSet('GET','POST','PATCH','DELETE')]
        [string]$Method,

        [string]$Path,

        [string]$Token,

        [object]$Body = $null,

        [string]$ContentType = 'application/json'
    )

    if ($Path -match '^https?://') {
        $uri = $Path
    }
    else {
        $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))"
    }

    $params = @{
        Method = $Method
        Uri = $uri
        Headers = @{ Authorization = "Bearer $Token" }
        ErrorAction = 'Stop'
    }

    if ($Method -ne 'GET' -and $Method -ne 'DELETE') {
        $params['ContentType'] = $ContentType
    }

    if ($null -ne $Body) {
        if ($Body -is [string]) {
            $params['Body'] = $Body
        }
        else {
            $params['Body'] = ($Body | ConvertTo-Json -Depth 30 -Compress)
        }
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        return Invoke-RestMethod @params
    }
    catch {
        throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)"
    }
}

function Get-RowValue {
    param(
        [pscustomobject]$Row,
        [string[]]$Names
    )

    foreach ($name in $Names) {
        $p = $Row.PSObject.Properties[$name]

        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) {
            return $p.Value.ToString().Trim()
        }
    }

    return $null
}

function Get-CsvRows {
    if (-not (Test-Path $CsvFile)) {
        throw "CSV file not found: $CsvFile"
    }

    if ((Get-Item $CsvFile).Length -eq 0) {
        throw "CSV file is empty: $CsvFile"
    }

    $rows = Import-Csv -Path $CsvFile | Where-Object {
        ($_.PSObject.Properties.Value | Where-Object {
            $null -ne $_ -and $_.ToString().Trim().Length -gt 0
        }).Count -gt 0
    }

    if ($null -eq $rows -or @($rows).Count -eq 0) {
        throw "CSV contains no data rows: $CsvFile"
    }

    $first = @($rows)[0]

    $checks = @(
        @{ Canonical = 'Account Name'; Aliases = @('Account Name','AD Account Name','ADAccountName','AccountName','ADName','SamAccountName','sAMAccountName') },
        @{ Canonical = 'Username'; Aliases = @('Username','UserName','CyberArk Username','CyberArkUsername','Current CyberArk Username','CurrentUsername') },
        @{ Canonical = 'CyberArk Address'; Aliases = @('CyberArk Address','CyberArkAddress','Address','Target Address','TargetAddress') }
    )

    foreach ($check in $checks) {
        $found = $false

        foreach ($alias in $check.Aliases) {
            if ($first.PSObject.Properties[$alias]) {
                $found = $true
                break
            }
        }

        if (-not $found) {
            throw "CSV is missing required column '$($check.Canonical)'. Accepted aliases: $($check.Aliases -join ', ')"
        }
    }

    Write-RunLog 'Get-CsvRows' "Imported $(@($rows).Count) row(s) from $CsvFile" 'INFO'

    return @($rows)
}

function ConvertTo-AccountList {
    param([object]$Response)

    if ($null -eq $Response) {
        return @()
    }

    if ($Response -is [System.Array]) {
        return @($Response)
    }

    foreach ($name in @('value','accounts','Accounts')) {
        $p = $Response.PSObject.Properties[$name]

        if ($null -ne $p) {
            return @($p.Value)
        }
    }

    return @($Response)
}

function Get-AccountFieldValue {
    param(
        [object]$Account,
        [string[]]$Names
    )

    foreach ($name in $Names) {
        $p = $Account.PSObject.Properties[$name]

        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) {
            return $p.Value.ToString()
        }
    }

    return ''
}

function Test-TextEqual {
    param(
        [string]$Left,
        [string]$Right
    )

    if ($CaseSensitiveMatch) {
        return ($Left -ceq $Right)
    }

    return ($Left -ieq $Right)
}

function Search-CyberArkAccounts {
    param(
        [string]$SearchText,
        [string]$Token
    )

    if (Test-BlankValue $SearchText) {
        return @()
    }

    $cacheKey = $SearchText.ToLowerInvariant()

    if ($script:SearchCache.ContainsKey($cacheKey)) {
        return @($script:SearchCache[$cacheKey])
    }

    $all = @()
    $limit = 1000
    $offset = 0

    do {
        $encoded = [System.Uri]::EscapeDataString($SearchText)
        $path = "Accounts?search=$encoded&limit=$limit&offset=$offset"

        Write-RunLog 'Search-CyberArkAccounts' "Searching accounts. SearchText='$SearchText' Offset=$offset" 'INFO'

        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-AccountList -Response $response)

        foreach ($item in $items) {
            $all += $item
        }

        $offset += $limit
    } while ($items.Count -eq $limit)

    $script:SearchCache[$cacheKey] = @($all)

    return @($all)
}

function Select-ExactAccountMatches {
    param(
        [object[]]$Accounts,
        [string]$CyberArkUsername,
        [string]$CyberArkAddress
    )

    $matches = @()

    foreach ($account in @($Accounts)) {
        $acctUserName = Get-AccountFieldValue -Account $account -Names @('userName','username','UserName','Username')
        $acctAddress = Get-AccountFieldValue -Account $account -Names @('address','Address')

        if ((Test-TextEqual -Left $acctUserName.Trim() -Right $CyberArkUsername.Trim()) -and (Test-TextEqual -Left $acctAddress.Trim() -Right $CyberArkAddress.Trim())) {
            $matches += $account
        }
    }

    return @($matches)
}

function Select-UsernameOnlyCandidates {
    param(
        [object[]]$Accounts,
        [string]$CyberArkUsername
    )

    $matches = @()

    foreach ($account in @($Accounts)) {
        $acctUserName = Get-AccountFieldValue -Account $account -Names @('userName','username','UserName','Username')

        if (Test-TextEqual -Left $acctUserName.Trim() -Right $CyberArkUsername.Trim()) {
            $matches += $account
        }
    }

    return @($matches)
}

function Select-AddressOnlyCandidates {
    param(
        [object[]]$Accounts,
        [string]$CyberArkAddress
    )

    $matches = @()

    foreach ($account in @($Accounts)) {
        $acctAddress = Get-AccountFieldValue -Account $account -Names @('address','Address')

        if (Test-TextEqual -Left $acctAddress.Trim() -Right $CyberArkAddress.Trim()) {
            $matches += $account
        }
    }

    return @($matches)
}

function Get-AccountSummaryText {
    param([object[]]$Accounts)

    $parts = @()

    foreach ($account in @($Accounts)) {
        $id = Get-AccountFieldValue -Account $account -Names @('id','ID','accountId','AccountID')
        $safe = Get-AccountFieldValue -Account $account -Names @('safeName','SafeName')
        $name = Get-AccountFieldValue -Account $account -Names @('name','Name')
        $user = Get-AccountFieldValue -Account $account -Names @('userName','username','UserName','Username')
        $addr = Get-AccountFieldValue -Account $account -Names @('address','Address')
        $platform = Get-AccountFieldValue -Account $account -Names @('platformId','PlatformID')

        $parts += "AccountID=$id|Safe=$safe|Name=$name|UserName=$user|Address=$addr|Platform=$platform"
    }

    return ($parts -join '; ')
}

function New-LookupResult {
    param(
        [pscustomobject]$Row,
        [int]$RowNumber,
        [string]$Token
    )

    $adAccountName = Get-RowValue -Row $Row -Names @('Account Name','AD Account Name','ADAccountName','AccountName','ADName','SamAccountName','sAMAccountName')
    $cyberArkUsername = Get-RowValue -Row $Row -Names @('Username','UserName','CyberArk Username','CyberArkUsername','Current CyberArk Username','CurrentUsername')
    $cyberArkAddress = Get-RowValue -Row $Row -Names @('CyberArk Address','CyberArkAddress','Address','Target Address','TargetAddress')

    $result = [ordered]@{
        Row = $RowNumber
        ADAccountName = $adAccountName
        CurrentCyberArkUsername = $cyberArkUsername
        SuggestedNewCyberArkUsername = $adAccountName
        CyberArkAddress = $cyberArkAddress
        ExistsInCyberArk = $false
        MatchStatus = ''
        AccountID = ''
        SafeName = ''
        CyberArkAccountName = ''
        MatchedUserName = ''
        MatchedAddress = ''
        PlatformID = ''
        ExactMatchCount = 0
        UsernameOnlyCandidateCount = 0
        AddressOnlyCandidateCount = 0
        AllExactMatchedAccountIDs = ''
        CandidateDetails = ''
        Result = ''
        Message = ''
    }

    try {
        if (Test-BlankValue $adAccountName) {
            throw 'AD Account Name / Account Name is blank.'
        }

        if (Test-BlankValue $cyberArkUsername) {
            throw 'CyberArk Username is blank.'
        }

        if (Test-BlankValue $cyberArkAddress) {
            throw 'CyberArk Address is blank.'
        }

        $usernameResults = @(Search-CyberArkAccounts -SearchText $cyberArkUsername -Token $Token)
        $exactMatches = @(Select-ExactAccountMatches -Accounts $usernameResults -CyberArkUsername $cyberArkUsername -CyberArkAddress $cyberArkAddress)

        # In some tenants/search configurations, address may return better coverage than username.
        # Only run the secondary search if the username search did not find an exact username+address match.
        if ($exactMatches.Count -eq 0) {
            $addressResults = @(Search-CyberArkAccounts -SearchText $cyberArkAddress -Token $Token)
            $exactMatches = @(Select-ExactAccountMatches -Accounts $addressResults -CyberArkUsername $cyberArkUsername -CyberArkAddress $cyberArkAddress)
            $usernameOnlyCandidates = @(Select-UsernameOnlyCandidates -Accounts $usernameResults -CyberArkUsername $cyberArkUsername)
            $addressOnlyCandidates = @(Select-AddressOnlyCandidates -Accounts $addressResults -CyberArkAddress $cyberArkAddress)
        }
        else {
            $addressResults = @()
            $usernameOnlyCandidates = @(Select-UsernameOnlyCandidates -Accounts $usernameResults -CyberArkUsername $cyberArkUsername)
            $addressOnlyCandidates = @()
        }

        $uniqueExact = @{}

        foreach ($match in $exactMatches) {
            $id = Get-AccountFieldValue -Account $match -Names @('id','ID','accountId','AccountID')

            if (-not (Test-BlankValue $id)) {
                $uniqueExact[$id] = $match
            }
        }

        $exactAccounts = @($uniqueExact.Values)
        $exactIds = @($uniqueExact.Keys | Sort-Object)

        $result.ExactMatchCount = $exactAccounts.Count
        $result.UsernameOnlyCandidateCount = @($usernameOnlyCandidates).Count
        $result.AddressOnlyCandidateCount = @($addressOnlyCandidates).Count
        $result.AllExactMatchedAccountIDs = ($exactIds -join '; ')

        if ($exactAccounts.Count -eq 1) {
            $account = $exactAccounts[0]

            $result.ExistsInCyberArk = $true
            $result.MatchStatus = 'EXACT_MATCH'
            $result.AccountID = Get-AccountFieldValue -Account $account -Names @('id','ID','accountId','AccountID')
            $result.SafeName = Get-AccountFieldValue -Account $account -Names @('safeName','SafeName')
            $result.CyberArkAccountName = Get-AccountFieldValue -Account $account -Names @('name','Name')
            $result.MatchedUserName = Get-AccountFieldValue -Account $account -Names @('userName','username','UserName','Username')
            $result.MatchedAddress = Get-AccountFieldValue -Account $account -Names @('address','Address')
            $result.PlatformID = Get-AccountFieldValue -Account $account -Names @('platformId','PlatformID')
            $result.Result = 'SUCCESS'
            $result.Message = 'One exact CyberArk account match found by Username and Address.'
        }
        elseif ($exactAccounts.Count -gt 1) {
            $result.ExistsInCyberArk = $true
            $result.MatchStatus = 'MULTIPLE_EXACT_MATCHES'
            $result.CandidateDetails = Get-AccountSummaryText -Accounts $exactAccounts
            $result.Result = 'REVIEW'
            $result.Message = "Multiple exact CyberArk matches found by Username and Address. Review before updating. Count=$($exactAccounts.Count)."
        }
        else {
            $result.ExistsInCyberArk = $false
            $result.MatchStatus = 'NO_EXACT_MATCH'

            $candidateList = @()
            if (@($usernameOnlyCandidates).Count -gt 0) { $candidateList += @($usernameOnlyCandidates) }
            if (@($addressOnlyCandidates).Count -gt 0) { $candidateList += @($addressOnlyCandidates) }

            if ($candidateList.Count -gt 0) {
                $result.CandidateDetails = Get-AccountSummaryText -Accounts $candidateList
                $result.Message = 'No exact Username+Address match found. Candidate accounts were found by username or address only.'
            }
            else {
                $result.Message = 'No CyberArk account found by Username and Address.'
            }

            $result.Result = 'SUCCESS'
        }

        return [pscustomobject]$result
    }
    catch {
        $result.Result = 'FAILED'
        $result.MatchStatus = 'ERROR'
        $result.Message = $_.Exception.Message

        return [pscustomobject]$result
    }
}

function Add-CsvRow {
    param(
        [string]$Path,
        [pscustomobject]$Row
    )

    if (-not (Test-Path $Path)) {
        $Row | Export-Csv -Path $Path -NoTypeInformation
    }
    else {
        $Row | Export-Csv -Path $Path -NoTypeInformation -Append
    }
}

function Start-AccountIdLookupRun {
    New-RunLog
    Import-RunConfig

    Write-RunLog 'Start-AccountIdLookupRun' "Using CSV file: $CsvFile" 'INFO'
    Write-RunLog 'Start-AccountIdLookupRun' 'This is a read-only lookup. No CyberArk account updates will be sent.' 'INFO'

    $rows = Get-CsvRows
    $token = Get-IdentityBearerToken

    $rowNumber = 1

    foreach ($row in $rows) {
        Write-RunLog 'Start-AccountIdLookupRun' "Processing CSV row $rowNumber" 'INFO'

        $outcome = New-LookupResult -Row $row -RowNumber $rowNumber -Token $token

        Add-CsvRow -Path $script:ReportFile -Row $outcome

        if ($outcome.Result -eq 'FAILED') {
            Write-RunLog 'Start-AccountIdLookupRun' "Row $rowNumber failed. Username=$($outcome.CurrentCyberArkUsername) Address=$($outcome.CyberArkAddress) Message=$($outcome.Message)" 'ERROR'
        }
        elseif ($outcome.Result -eq 'REVIEW') {
            Write-RunLog 'Start-AccountIdLookupRun' "Row $rowNumber requires review. Username=$($outcome.CurrentCyberArkUsername) Address=$($outcome.CyberArkAddress) Status=$($outcome.MatchStatus)" 'WARN'
        }
        else {
            Write-RunLog 'Start-AccountIdLookupRun' "Row $rowNumber complete. Username=$($outcome.CurrentCyberArkUsername) Address=$($outcome.CyberArkAddress) Status=$($outcome.MatchStatus) AccountID=$($outcome.AccountID)" 'INFO'
        }

        $rowNumber++
    }

    Write-RunLog 'Start-AccountIdLookupRun' "Run completed. Report=$script:ReportFile" 'INFO'
    Write-RunLog 'Start-AccountIdLookupRun' "Log=$script:LogFile" 'INFO'
}

Start-AccountIdLookupRun
