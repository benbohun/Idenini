Import-Module IdentityCommand -Force
Import-Module psPAS -Force

$cred = Get-Credential

New-PASSession `
  -IdentityTenantURL "https://aak4521.id.cyberark.cloud" `
  -PrivilegeCloudURL "https://alliantcredit.privilegecloud.cyberark.cloud" `
  -Credential $cred `
  -IdentityUser

Get-PASSession
Get-PASSafe -Search "IND_"

Close-PASSession
