# Set-Component-Offline.ps1

# --- Paths ---
$IndexFilePath   = "C:\inetpub\wwwroot\Healthcheck.html"
$OfflineFilePath = "C:\inetpub\wwwroot\Healthcheck_Offline.html"
$LogFile         = "C:\log\Set_Component_Status.log"

# (Kept for reference — file contents are NOT modified)
$OkHtmlContent = @"
<!DOCTYPE html>
<html lang="en">
<body>
    <p>Status: OK</p>
</body>
</html>
"@

# --- Ensure log folder exists ---
$logDir = Split-Path $LogFile -Parent
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }

function Write-Log($msg) {
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Add-Content -Path $LogFile -Value "[$Timestamp] $msg"
}

try {
    Write-Log "OFFLINE: Starting operation."

    # Rename Healthcheck.html -> Healthcheck_Offline.html if needed
    if (Test-Path $IndexFilePath) {
        Rename-Item -Path $IndexFilePath -NewName (Split-Path $OfflineFilePath -Leaf) -Force
        Write-Log "OFFLINE: Renamed '$IndexFilePath' to '$OfflineFilePath'."
    } elseif (Test-Path $OfflineFilePath) {
        Write-Log "OFFLINE: File already offline ('$OfflineFilePath' exists)."
    } else {
        throw "Neither '$IndexFilePath' nor '$OfflineFilePath' exists. Nothing to take offline."
    }

    # Perform IIS reset and capture output, log as it completes
    Write-Log "OFFLINE: Initiating IISReset..."
    try {
        $iisOut = iisreset 2>&1
        Write-Log "OFFLINE: IISReset output:`n$iisOut"
        Write-Log "OFFLINE: IISReset completed successfully."
    } catch {
        Write-Log "OFFLINE: IISReset FAILED. $_"
        throw
    }

    Write-Host "❌ Status set to OFFLINE and IIS reset completed."
    Write-Log "OFFLINE: Status set to OFFLINE."
}
catch {
    Write-Host "❗ OFFLINE operation failed: $($_.Exception.Message)"
    Write-Log "OFFLINE: Operation failed: $($_.Exception.Message)"
    exit 1
}



:::::::::::::::::::::::::::::::::::::::::



# Set-Component-Online.ps1

# --- Paths ---
$IndexFilePath   = "C:\inetpub\wwwroot\Healthcheck.html"
$OfflineFilePath = "C:\inetpub\wwwroot\Healthcheck_Offline.html"
$LogFile         = "C:\log\Set_Component_Status.log"

# (Kept for reference — file contents are NOT modified)
$OkHtmlContent = @"
<!DOCTYPE html>
<html lang="en">
<body>
    <p>Status: OK</p>
</body>
</html>
"@

# --- Ensure log folder exists ---
$logDir = Split-Path $LogFile -Parent
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir -Force | Out-Null }

function Write-Log($msg) {
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Add-Content -Path $LogFile -Value "[$Timestamp] $msg"
}

try {
    Write-Log "ONLINE: Starting operation."

    # Rename Healthcheck_Offline.html -> Healthcheck.html if needed
    if (Test-Path $OfflineFilePath) {
        Rename-Item -Path $OfflineFilePath -NewName (Split-Path $IndexFilePath -Leaf) -Force
        Write-Log "ONLINE: Renamed '$OfflineFilePath' to '$IndexFilePath'."
    } elseif (Test-Path $IndexFilePath) {
        Write-Log "ONLINE: File already online ('$IndexFilePath' exists)."
    } else {
        throw "Neither '$OfflineFilePath' nor '$IndexFilePath' exists. Nothing to bring online."
    }

    # Perform IIS reset and capture output, log as it completes
    Write-Log "ONLINE: Initiating IISReset..."
    try {
        $iisOut = iisreset 2>&1
        Write-Log "ONLINE: IISReset output:`n$iisOut"
        Write-Log "ONLINE: IISReset completed successfully."
    } catch {
        Write-Log "ONLINE: IISReset FAILED. $_"
        throw
    }

    Write-Host "✔ Status set to OK and IIS reset completed."
    Write-Log "ONLINE: Status set to OK."
}
catch {
    Write-Host "❗ ONLINE operation failed: $($_.Exception.Message)"
    Write-Log "ONLINE: Operation failed: $($_.Exception.Message)"
    exit 1
}

