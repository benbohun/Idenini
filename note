Get-ADUser SVCQTGAcct -Server dev.mtb.com -Properties Enabled,LockedOut,PasswordExpired,PasswordLastSet,PasswordNeverExpires,AccountExpirationDate,LogonWorkstations,logonHours,SmartcardLogonRequired,DoesNotRequirePreAuth,TrustedForDelegation,TrustedToAuthForDelegation,AccountNotDelegated,msDS-AssignedAuthNPolicy,msDS-AuthNPolicySilo,msDS-SupportedEncryptionTypes,userAccountControl | Format-List *



#requires -Modules ActiveDirectory

<#
.SYNOPSIS
    Checks Active Directory account properties that may cause
    "Account restrictions are preventing this user from signing in"
    (Win32 error 1327).

.DESCRIPTION
    Reviews:
      - Enabled / Locked state
      - Password expiration
      - Account expiration
      - Logon workstation restrictions
      - Logon hours
      - Smart card requirement
      - Authentication Policy
      - Authentication Policy Silo
      - Protected Users membership
      - Kerberos encryption types
      - UserAccountControl flags
      - Delegation-related settings
      - Direct and recursive AD group membership

.NOTES
    Read-only script. Makes no changes to Active Directory.
#>

Import-Module ActiveDirectory -ErrorAction Stop

# ============================================================
# UPDATE THIS VALUE
# ============================================================
$ServiceAccount = "SVCQTGAcct"

# Optional: specify domain/DC if required.
# Leave blank to use the current/default domain.
$Server = "dev.mtb.com"

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " Active Directory Service Account Restriction Check" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "Account : $ServiceAccount"
Write-Host "Server  : $Server"
Write-Host ""

try {

    $Properties = @(
        "Enabled"
        "LockedOut"
        "PasswordExpired"
        "PasswordLastSet"
        "PasswordNeverExpires"
        "AccountExpirationDate"
        "LogonWorkstations"
        "logonHours"
        "SmartcardLogonRequired"
        "DoesNotRequirePreAuth"
        "TrustedForDelegation"
        "TrustedToAuthForDelegation"
        "AccountNotDelegated"
        "msDS-AssignedAuthNPolicy"
        "msDS-AuthNPolicySilo"
        "msDS-SupportedEncryptionTypes"
        "userAccountControl"
        "LastLogonDate"
        "DistinguishedName"
    )

    $User = Get-ADUser `
        -Identity $ServiceAccount `
        -Server $Server `
        -Properties $Properties `
        -ErrorAction Stop

}
catch {
    Write-Host "ERROR: Unable to locate account '$ServiceAccount'." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    return
}


# ============================================================
# BASIC ACCOUNT STATUS
# ============================================================

Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "1. BASIC ACCOUNT STATUS" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

[PSCustomObject]@{
    SamAccountName        = $User.SamAccountName
    Enabled               = $User.Enabled
    LockedOut             = $User.LockedOut
    PasswordExpired       = $User.PasswordExpired
    PasswordNeverExpires  = $User.PasswordNeverExpires
    PasswordLastSet       = $User.PasswordLastSet
    AccountExpirationDate = $User.AccountExpirationDate
    LastLogonDate         = $User.LastLogonDate
} | Format-List


# ============================================================
# LOGON RESTRICTIONS
# ============================================================

Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "2. LOGON RESTRICTIONS" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

if ([string]::IsNullOrWhiteSpace($User.LogonWorkstations)) {
    Write-Host "LogonWorkstations : NONE" -ForegroundColor Green
}
else {
    Write-Host "LogonWorkstations : $($User.LogonWorkstations)" -ForegroundColor Red
}


if ($null -eq $User.logonHours) {
    Write-Host "LogonHours        : No restriction detected" -ForegroundColor Green
}
else {
    Write-Host "LogonHours        : Configured - review required" -ForegroundColor Yellow
}


# ============================================================
# SMART CARD / PRE-AUTH / DELEGATION
# ============================================================

Write-Host ""
Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "3. AUTHENTICATION FLAGS" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

[PSCustomObject]@{
    SmartcardLogonRequired      = $User.SmartcardLogonRequired
    DoesNotRequirePreAuth       = $User.DoesNotRequirePreAuth
    TrustedForDelegation        = $User.TrustedForDelegation
    TrustedToAuthForDelegation  = $User.TrustedToAuthForDelegation
    AccountNotDelegated         = $User.AccountNotDelegated
} | Format-List


# ============================================================
# AUTHENTICATION POLICY / SILO
# ============================================================

Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "4. AUTHENTICATION POLICY / SILO" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

if ($User.'msDS-AssignedAuthNPolicy') {
    Write-Host "Authentication Policy:" -ForegroundColor Red
    Write-Host " $($User.'msDS-AssignedAuthNPolicy')"
}
else {
    Write-Host "Authentication Policy : NONE" -ForegroundColor Green
}


if ($User.'msDS-AuthNPolicySilo') {
    Write-Host "Authentication Policy Silo:" -ForegroundColor Red
    Write-Host " $($User.'msDS-AuthNPolicySilo')"
}
else {
    Write-Host "Authentication Policy Silo : NONE" -ForegroundColor Green
}


# ============================================================
# KERBEROS ENCRYPTION
# ============================================================

Write-Host ""
Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "5. KERBEROS ENCRYPTION TYPES" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

$Enc = $User.'msDS-SupportedEncryptionTypes'

Write-Host "Raw Value: $Enc"

if ($null -eq $Enc -or $Enc -eq 0) {

    Write-Host "No explicit msDS-SupportedEncryptionTypes configured." -ForegroundColor Yellow

}
else {

    $EncryptionTypes = @()

    if ($Enc -band 1)  { $EncryptionTypes += "DES-CBC-CRC" }
    if ($Enc -band 2)  { $EncryptionTypes += "DES-CBC-MD5" }
    if ($Enc -band 4)  { $EncryptionTypes += "RC4-HMAC" }
    if ($Enc -band 8)  { $EncryptionTypes += "AES128-CTS-HMAC-SHA1-96" }
    if ($Enc -band 16) { $EncryptionTypes += "AES256-CTS-HMAC-SHA1-96" }
    if ($Enc -band 32) { $EncryptionTypes += "FAST / Claims / Compound Authentication" }

    Write-Host ""
    Write-Host "Configured encryption types:"

    foreach ($Type in $EncryptionTypes) {
        Write-Host "  - $Type"
    }
}


# ============================================================
# USERACCOUNTCONTROL
# ============================================================

Write-Host ""
Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "6. USERACCOUNTCONTROL" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

$UAC = [int64]$User.UserAccountControl

Write-Host "Raw UserAccountControl value: $UAC"
Write-Host ""

$UACFlags = [ordered]@{
    ACCOUNTDISABLE                   = 0x0002
    HOMEDIR_REQUIRED                 = 0x0008
    LOCKOUT                          = 0x0010
    PASSWD_NOTREQD                   = 0x0020
    PASSWD_CANT_CHANGE               = 0x0040
    ENCRYPTED_TEXT_PWD_ALLOWED       = 0x0080
    NORMAL_ACCOUNT                   = 0x0200
    DONT_EXPIRE_PASSWORD             = 0x10000
    SMARTCARD_REQUIRED               = 0x40000
    TRUSTED_FOR_DELEGATION           = 0x80000
    NOT_DELEGATED                    = 0x100000
    USE_DES_KEY_ONLY                 = 0x200000
    DONT_REQUIRE_PREAUTH             = 0x400000
    PASSWORD_EXPIRED                 = 0x800000
    TRUSTED_TO_AUTH_FOR_DELEGATION   = 0x1000000
}

foreach ($Flag in $UACFlags.GetEnumerator()) {

    if (($UAC -band $Flag.Value) -eq $Flag.Value) {
        Write-Host ("{0,-35} : TRUE" -f $Flag.Key) -ForegroundColor Yellow
    }
}


# ============================================================
# PROTECTED USERS CHECK
# ============================================================

Write-Host ""
Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "7. PROTECTED USERS MEMBERSHIP" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

try {

    $ProtectedUsers = Get-ADGroup `
        -Identity "Protected Users" `
        -Server $Server `
        -ErrorAction Stop

    $IsProtected = Get-ADGroupMember `
        -Identity $ProtectedUsers `
        -Recursive `
        -Server $Server `
        -ErrorAction Stop |
        Where-Object {
            $_.SamAccountName -eq $User.SamAccountName
        }

    if ($IsProtected) {
        Write-Host "WARNING: Account IS a member of Protected Users." -ForegroundColor Red
    }
    else {
        Write-Host "Account is NOT a member of Protected Users." -ForegroundColor Green
    }

}
catch {

    Write-Host "Could not query Protected Users group." -ForegroundColor Yellow
    Write-Host $_.Exception.Message
}


# ============================================================
# GROUP MEMBERSHIP
# ============================================================

Write-Host ""
Write-Host "------------------------------------------------------------" -ForegroundColor Yellow
Write-Host "8. GROUP MEMBERSHIP" -ForegroundColor Yellow
Write-Host "------------------------------------------------------------"

try {

    $Groups = Get-ADPrincipalGroupMembership `
        -Identity $ServiceAccount `
        -Server $Server |
        Sort-Object Name

    $Groups |
        Select-Object Name, GroupScope, GroupCategory |
        Format-Table -AutoSize

}
catch {

    Write-Host "Unable to retrieve group membership." -ForegroundColor Red
    Write-Host $_.Exception.Message
}


# ============================================================
# POTENTIAL FINDINGS
# ============================================================

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " POTENTIAL ISSUES FOUND" -ForegroundColor Cyan
Write-Host "============================================================"

$Issues = @()

if (-not $User.Enabled) {
    $Issues += "Account is disabled."
}

if ($User.LockedOut) {
    $Issues += "Account is locked."
}

if ($User.PasswordExpired) {
    $Issues += "Password is expired."
}

if ($User.AccountExpirationDate -and
    $User.AccountExpirationDate -lt (Get-Date)) {

    $Issues += "Account has expired."
}

if ($User.LogonWorkstations) {
    $Issues += "Account has workstation logon restrictions."
}

if ($User.logonHours) {
    $Issues += "Account has logon-hour restrictions configured."
}

if ($User.SmartcardLogonRequired) {
    $Issues += "Smart card is required for logon."
}

if ($User.'msDS-AssignedAuthNPolicy') {
    $Issues += "Authentication Policy is assigned."
}

if ($User.'msDS-AuthNPolicySilo') {
    $Issues += "Authentication Policy Silo is assigned."
}

if ($IsProtected) {
    $Issues += "Account is a member of Protected Users."
}

if (($UAC -band 0x200000) -eq 0x200000) {
    $Issues += "USE_DES_KEY_ONLY is enabled."
}

if ($Issues.Count -eq 0) {

    Write-Host ""
    Write-Host "No obvious account-level restriction was detected." -ForegroundColor Green
    Write-Host ""
    Write-Host "Next recommended step:" -ForegroundColor Cyan
    Write-Host "Check Windows Security Event 4625 generated during the CPM Verify attempt."
    Write-Host "Capture Status, SubStatus, Logon Type and Authentication Package."

}
else {

    foreach ($Issue in $Issues) {
        Write-Host " - $Issue" -ForegroundColor Red
    }
}

Write-Host ""
Write-Host "============================================================"
Write-Host "CHECK COMPLETE"
Write-Host "============================================================"
