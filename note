$DefaultSafeMembers = @{
    "Privilege Cloud Administrators" = "PamAdmin"
    "Privilege Cloud Safe Managers"   = "PrivilegeCloudSafeManagers"
    "a-WPAxx-DataCenterUsers"  =  "Approvers"
    "a-WPAxx-ControlCenterUsers"  =  "Approvers"
    "a-WPAxx-PCloudOperations"  =  "PrivilegeCloudOperations"
    "Privilege Cloud Auditors" = "PamAuditors"
}

# map CPMs to safe types
$ProdCPMs = @{"IN"="wpa-1cpm001"; "AP"="wpa-1cpm002"; "U"="WPA-1CPM003"} 
$DevCPMs = @{"IN"="wpa-7cpm001"; "AP"="wpa-7cpm002"; "U"="wpa-7cpm001"}

$ProdApproverEmails = @("controlcenter@cyberark.cloud.29266", "datacenter@cyberark.cloud.29266")
$DevApproverEmails = @("pamfam@cyberark.cloud.29268")

<#	
	.NOTES
	===========================================================================
	 Created on:   	05-01-2025
	 Created by:   	PAM FAM
	 Organization: 	M&T Bank
	 Filename:      Add-Safe.ps1
     Updated: 9/10/2025 adds CPM to safe mapping      
	===========================================================================
	.DESCRIPTION
		PowerShell script for automatically creating a safe in CyberArk via the REST API
#>

param (
        [System.String] $SafeName, # The name of the safe based on WIAM PAM's naming convention https://mtbtools.atlassian.net/wiki/spaces/PF/pages/4289364439/Safe+Naming+Convention
        [System.String] $Description, # Optional description for the safe
        [System.String] $NumberOfVersionsRetention = 7, # Optional description for the safe
        [System.String] $EnvPath = '..\.env',  # Path to .env file, following wpa repo structure by default
        [System.String] $AuthScriptPath = '..\auth\Get-AuthToken.ps1',  # Path to script for retrieving Auth Token, following wpa repo structure by default
        [System.String] $FormSafeNameScriptPath = '.\Form-Safe-Name.ps1',  # Path to script for forming safe names, following wpa repo structure by default
        [System.String] $AddSafeMemberScriptPath = '..\SafeMembers\Add-Safe-Member.ps1',  # Path to script for adding safe members, following wpa repo structure by default
        [System.String] $SafeMembershipJsonPath = '..\SafeMembers\Safe-Membership-Permissions.json', # Path to the JSON file containing safe membership permission data   
        [System.Management.Automation.PSCredential] $AccessToken # Optionally pass the the access token for CyberArk REST API callouts if it has already been retrieved
)

Get-Content -Path $EnvPath | foreach {
    $name, $value = $_.split('=').Trim()
    Set-Content env:\$name $value
}

$ValidSafePrefixes = @("IN", "AP", "U")

$DefaultSafeMembers = @{
    "Privilege Cloud Administrators" = "PamAdmin"
    "Privilege Cloud Safe Managers"   = "PrivilegeCloudSafeManagers"
    "a-WPAxx-DataCenterUsers"  =  "Approvers"
    "a-WPAxx-ControlCenterUsers"  =  "Approvers"
    "a-WPAxx-PCloudOperations"  =  "PrivilegeCloudOperations"
    "Privilege Cloud Auditors" = "PamAuditors"
}

# map CPMs to safe types
$ProdCPMs = @{"IN"="wpa-1cpm001"; "AP"="wpa-1cpm002"; "U"="WPA-1CPM003"} 
$DevCPMs = @{"IN"="wpa-7cpm001"; "AP"="wpa-7cpm002"; "U"="wpa-7cpm001"}

$ProdApproverEmails = @("controlcenter@cyberark.cloud.29266", "datacenter@cyberark.cloud.29266")
$DevApproverEmails = @("pamfam@cyberark.cloud.29268")

$AddSafeApi = "https://$($env:SUB_DOMAIN).privilegecloud.cyberark.cloud/PasswordVault/API/Safes/"
$proxy = "$($env:PROXY_ADDRESS):$($env:PROXY_PORT)"

function Add-Safe {
    param(
        [System.Management.Automation.PSCredential] $accessToken,
        [System.String] $safeName
    )

    $body = "{`"safeName`":`"$($safeName)`", `"numberOfVersionsRetention`":$($NumberOfVersionsRetention)}"

    if(-not [string]::IsNullOrEmpty($Description)){
        $body = $body -replace "}", ",`"description`":`"$($Description)`"}"
    }
    
    $response = Invoke-Restmethod -Uri $AddSafeApi -ContentType 'application/json' -Proxy $proxy -Method Post -Body $body -Headers @{
	    Authorization = "Bearer $($([System.Runtime.InteropServices.Marshal]::PtrToStringAuto([System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($accessToken.Password))))"
    }

    return $response
}

function Add-Default-Safe-Members {
    param(
        [System.Management.Automation.PSCredential] $accessToken,
        [System.String] $safeUrlId
    )

    # Add default roles to safe
    foreach ($defaultMember in $DefaultSafeMembers.GetEnumerator()) {
        if($SafeName -like "u-*" -and ($defaultMember.Key -eq "a-WPAxx-DataCenterUsers" -or $defaultMember.Key -eq "a-WPAxx-ControlCenterUsers")){
            continue
        }
        . $AddSafeMemberScriptPath -SafeUrlId $safeUrlId -MemberName $defaultMember.Key -MemberType "Group" -MemberPermissionsKeyName $defaultMember.Value -SafeMembershipJsonPath $SafeMembershipJsonPath -AccessToken $accessToken -EnvPath $EnvPath
    }

    # Assign all Approval Email Accounts to safe
    if ($SafeName -notlike "u-*") {
        $allApproverEmails = if("mtbanktest" -eq $env:SUB_DOMAIN) {$DevApproverEmails} else {$ProdApproverEmails}
        foreach ($email in $allApproverEmails) { 
            . $AddSafeMemberScriptPath -SafeUrlId $safeUrlId -MemberName $email -MemberType "User" -MemberPermissionsKeyName "Approvers" -SafeMembershipJsonPath $SafeMembershipJsonPath  -AccessToken $accessToken -EnvPath $EnvPath
        }    
    }

    # Assign CPM to safe if mapping exists
    $allCPMs = if("mtbanktest" -eq $env:SUB_DOMAIN) {$DevCPMs} else {$ProdCPMs}
    foreach ($prefix in $ValidSafePrefixes) {
        if ($SafeName -like "$prefix-*") {
            $cpm = $allCPMs[$prefix]
            . $AddSafeMemberScriptPath -SafeUrlId $safeUrlId -MemberName $cpm -MemberType "User" -MemberPermissionsKeyName "CPM" -SafeMembershipJsonPath $SafeMembershipJsonPath  -AccessToken $accessToken -EnvPath $EnvPath
            break
        }
    }

}


# If the safe name was not provided, ask the user if they'd like to use the Form-Safe-Name script
if ([string]::IsNullOrEmpty($SafeName)){
    $safeNameSourceResponse = (Read-Host "No safe name was provided. Use Form-Safe-Name script to form a name (Y or N)").ToUpper()
    
    if ('Y' -eq $safeNameSourceResponse) {

        $safeType = (Read-Host "Please enter the safe type ($($ValidSafePrefixes -join ", "))").ToUpper()
        $SafeName = . $FormSafeNameScriptPath -SafeType $safeType
    }
    elseif ('N' -eq $safeNameSourceResponse) {
        $SafeName = (Read-Host "Please enter a safe name or script will terminate").ToUpper()
    }
}

if ($null -ne $AccessToken) {
    $authToken = $AccessToken
}
else {
    # Grab auth token for API callout
    $authToken = . $AuthScriptPath
}

if ($authToken -is [System.Management.Automation.PSCredential] -and -not [string]::IsNullOrEmpty($SafeName)) {

    try {

        $calloutResults = (Add-Safe $authToken $SafeName)
        Write-Host "Successfully created $($calloutResults.safeName)"

        (Add-Default-Safe-Members $authToken $calloutResults.safeUrlId)

    }
    catch [System.Exception] {
        Write-Host "Error adding safe"
        Write-Host $_
    }
}
else {
    Write-Host "Invalid auth token or safe name"
}


