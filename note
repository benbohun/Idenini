<#
.SYNOPSIS
    Identifies CyberArk Privilege Cloud accounts with failed CPM operations and
    matches SSH fingerprint errors when the REST/API data exposes them.

.DESCRIPTION
    Authentication follows:
      CCP -> CyberArk Identity Shared Services -> Privilege Cloud service user.

    Detection:
      - Queries FailedVerify, FailedChange, and FailedReconcile saved filters.
      - Retrieves account details and account activity.
      - Searches returned data for:
          Fingerprint mismatch
          FingerPrintMismatchException
          RC: 9007
          Error code: 9007
      - MATCHED   = exact fingerprint/9007 evidence was returned by API.
      - CANDIDATE = failed CPM account, but detailed plugin error was not exposed.

    Some CPM/plugin versions do not expose the full TPC/Expect.NET exception
    through account/activity APIs. Those are deliberately retained as CANDIDATE.

.REQUIREMENTS
    Windows PowerShell 5.1
    psPAS
#>

[CmdletBinding()]
param(
    [string]$SafeName = "APP_NetSecEngOps_BreakGlass",
    [string]$PlatformID = "NET_PaloAlto",
    # ===== EDIT THIS PATH AS NEEDED =====
    [string]$OutputPath = "C:\Temp\CyberArk-SSHFingerprintMismatch.csv",

    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    [string]$CCPAddress     = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation    = "AIMWebService",
    [string]$CCPAppID       = "ACURestAPI",
    [string]$CCPSafe        = "ACU-VAULT-API",
    [string]$CCPObject      = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth = $false,

    [bool]$IncludeCandidates = $true
)

Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'

function Write-Info { param([string]$m) Write-Host "[INFO] $m" -ForegroundColor Cyan }
function Write-Ok   { param([string]$m) Write-Host "[ OK ] $m" -ForegroundColor Green }
function Write-Warn { param([string]$m) Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Write-Err  { param([string]$m) Write-Host "[FAIL] $m" -ForegroundColor Red }

function Get-ServiceUserCredentialFromCCP {
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $Location.Trim('/'),
        [uri]::EscapeDataString($AppID),
        [uri]::EscapeDataString($Safe),
        [uri]::EscapeDataString($Object)

    Write-Info "Retrieving API service-user credential from CCP..."
    $resp = Invoke-RestMethod -Uri $url -Method GET `
        -Headers @{"Content-Type"="application/json"} `
        -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    $secure = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    [PSCredential]::new([string]$resp.UserName,$secure)
}

function Get-PropertyValue {
    param([object]$Object,[string[]]$Names)
    if (-not $Object) { return $null }
    foreach ($n in $Names) {
        $p = $Object.PSObject.Properties[$n]
        if ($p -and $null -ne $p.Value) { return $p.Value }
    }
    return $null
}

function Get-AccountIdValue {
    param([object]$Account)
    [string](Get-PropertyValue $Account @('id','ID','AccountID','AccountId'))
}

function ConvertTo-SearchableText {
    param([object]$Object)
    if ($null -eq $Object) { return '' }
    try { return ($Object | ConvertTo-Json -Depth 12 -Compress) }
    catch { return [string]$Object }
}

function Test-FingerprintError {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $false }
    return (
        $Text -match '(?i)fingerprint\s+mismatch' -or
        $Text -match '(?i)FingerPrintMismatchException' -or
        $Text -match '(?i)RC\s*:\s*9007' -or
        $Text -match '(?i)error\s*code\s*:\s*9007'
    )
}

function Get-ShortEvidence {
    param([string]$Text,[int]$MaxLength=900)
    if ([string]::IsNullOrWhiteSpace($Text)) { return '' }
    foreach ($p in @(
        '(?i).{0,180}fingerprint mismatch.{0,450}',
        '(?i).{0,180}FingerPrintMismatchException.{0,450}',
        '(?i).{0,180}RC\s*:\s*9007.{0,350}',
        '(?i).{0,180}error\s*code\s*:\s*9007.{0,350}'
    )) {
        $m=[regex]::Match($Text,$p)
        if ($m.Success) {
            $v=($m.Value -replace '\s+',' ').Trim()
            if ($v.Length -gt $MaxLength) { return $v.Substring(0,$MaxLength) }
            return $v
        }
    }
    return ''
}

function Get-AccountActivitySafe {
    param([string]$AccountID)
    try { return @(Get-PASAccountActivity -AccountID $AccountID -ErrorAction Stop) }
    catch {
        Write-Warn "Could not retrieve activity for AccountID=$AccountID : $($_.Exception.Message)"
        return @()
    }
}

$sessionCreated=$false
$results=New-Object System.Collections.Generic.List[object]

try {
    foreach ($cmd in @('New-PASSession','Get-PASAccount','Get-PASAccountActivity','Close-PASSession')) {
        if (-not (Get-Command $cmd -ErrorAction SilentlyContinue)) {
            throw "Required psPAS command '$cmd' is unavailable. Update/import psPAS."
        }
    }

    $cred=Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress -Location $CCPLocation -AppID $CCPAppID `
        -Safe $CCPSafe -Object $CCPObject -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud..."
    New-PASSession -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL -Credential $cred `
        -ServiceUser -ErrorAction Stop | Out-Null
    $sessionCreated=$true
    Write-Ok "Authenticated."

    $candidateMap=@{}
    foreach ($filter in @('FailedVerify','FailedChange','FailedReconcile')) {
        Write-Info "Querying saved filter '$filter'..."
        $p=@{ savedFilter=$filter; limit=1000; ErrorAction='Stop' }
        if ($SafeName) { $p.safeName=$SafeName }
        $items=@(Get-PASAccount @p)

        foreach ($acct in $items) {
            $id=Get-AccountIdValue $acct
            if (-not $id) { continue }
            if (-not $candidateMap.ContainsKey($id)) {
                $candidateMap[$id]=[pscustomobject]@{
                    Account=$acct
                    Filters=New-Object System.Collections.Generic.List[string]
                }
            }
            $candidateMap[$id].Filters.Add($filter) | Out-Null
        }
    }

    Write-Info "Unique failed CPM candidates: $($candidateMap.Count)"

    foreach ($id in $candidateMap.Keys) {
        $candidate=$candidateMap[$id]
        $acct=$candidate.Account

        try {
            $full=Get-PASAccount -id $id -ErrorAction Stop
            if ($full) { $acct=$full }
        } catch {
            Write-Warn "Get-PASAccount -id $id failed; using filter result."
        }

        $platform=[string](Get-PropertyValue $acct @('platformId','PlatformID','platformID'))
        if ($PlatformID -and $platform -ine $PlatformID) { continue }

        $safe=[string](Get-PropertyValue $acct @('safeName','safe','SafeName','Safe'))
        $user=[string](Get-PropertyValue $acct @('userName','UserName','username'))
        $addr=[string](Get-PropertyValue $acct @('address','Address'))

        $accountText=ConvertTo-SearchableText $acct
        $activity=Get-AccountActivitySafe $id
        $activityText=ConvertTo-SearchableText $activity

        $matchedAccount=Test-FingerprintError $accountText
        $matchedActivity=Test-FingerprintError $activityText
        $state=if ($matchedAccount -or $matchedActivity) {'MATCHED'} else {'CANDIDATE'}
        if ($state -eq 'CANDIDATE' -and -not $IncludeCandidates) { continue }

        if ($matchedAccount) {
            $source='AccountDetails'; $evidence=Get-ShortEvidence $accountText
        } elseif ($matchedActivity) {
            $source='AccountActivity'; $evidence=Get-ShortEvidence $activityText
        } else {
            $source='FailedCPMFilterOnly'
            $evidence='Failed CPM operation detected, but REST response did not expose fingerprint/RC9007 text. Confirm in CPM plugin log.'
        }

        $secretMgmt=Get-PropertyValue $acct @('secretManagement','SecretManagement')
        $lastTask=''; $mgmtStatus=''
        if ($secretMgmt) {
            $lastTask=[string](Get-PropertyValue $secretMgmt @('lastTask','LastTask'))
            $mgmtStatus=[string](Get-PropertyValue $secretMgmt @('status','Status'))
        }

        $results.Add([pscustomobject]@{
            DetectionState=$state
            AccountID=$id
            SafeName=$safe
            UserName=$user
            Address=$addr
            PlatformID=$platform
            FailedFilters=(($candidate.Filters | Select-Object -Unique) -join ';')
            LastTask=$lastTask
            CPMStatus=$mgmtStatus
            MatchSource=$source
            ErrorEvidence=$evidence
        }) | Out-Null
    }

    $dir=Split-Path -Parent $OutputPath
    if ($dir -and -not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    $results | Sort-Object DetectionState,Address,UserName | Export-Csv -Path $OutputPath -NoTypeInformation -Encoding UTF8

    $matched=@($results | Where-Object DetectionState -eq 'MATCHED').Count
    $candidates=@($results | Where-Object DetectionState -eq 'CANDIDATE').Count
    Write-Host ''
    Write-Ok "Export complete: $OutputPath"
    Write-Host "MATCHED=$matched  CANDIDATE=$candidates  TOTAL=$($results.Count)" -ForegroundColor White
    if ($candidates -gt 0) {
        Write-Warn "CANDIDATE means failed CPM state was found, but the API did not expose the exact plugin fingerprint error."
    }
}
finally {
    if ($sessionCreated) {
        try { Close-PASSession | Out-Null; Write-Ok "CyberArk session closed." }
        catch { Write-Warn "Logoff warning: $($_.Exception.Message)" }
    }
}
