<#
Validate_Usernames_Against_DomainExport.ps1

PURPOSE
  Compare a first/source CSV containing likely usernames against a second/reference CSV
  exported from the domain list.

  FIRST CSV:
    - Source/CyberArk list.
    - Script auto-detects username column unless provided.
    - Script auto-detects AccountID column unless provided.
    - Carries SourceAccountID into the final report.

  SECOND CSV:
    - Domain/reference export.
    - Must contain:
        Email, Username, Address, Appcode

EXAMPLE SECOND CSV
  Email,Username,Address,Appcode
  SVCCWFDDI@prod.domain.com,SVCCWFDDI,prod.domain.com,CWF

OUTPUT INCLUDES
  SourceAccountID
  SourceAppcode
  InputValue
  CleanedCandidate
  Status
  MatchType
  MatchedEmail
  MatchedUsername
  MatchedAddress
  MatchedAppcode
  ReferenceRowNumber
  MatchedOn
  MatchCountForInput
  Notes

EXAMPLES
  Interactive prompt:
    .\Validate_Usernames_Against_DomainExport.ps1

  With parameters:
    .\Validate_Usernames_Against_DomainExport.ps1 `
      -CsvPath "C:\Temp\CyberArk_Source.csv" `
      -ReferenceCsvPath "C:\Temp\Domain_Export.csv" `
      -UsernameColumn "Username" `
      -AccountIdColumn "AccountID" `
      -NoFuzzy
#>

[CmdletBinding()]
param(
    # First/source CSV. If not supplied, script will prompt.
    [string]$CsvPath,

    # Second/reference CSV. If not supplied, script will prompt.
    [string]$ReferenceCsvPath,

    # First/source CSV username column. If omitted, script auto-detects.
    [string]$UsernameColumn,

    # First/source CSV CyberArk unique Account ID column. If omitted, script auto-detects if present.
    [string]$AccountIdColumn,

    # Optional first/source CSV Appcode column, if it exists.
    [string]$SourceAppcodeColumn,

    # Second/reference CSV columns.
    [string]$RefEmailColumn    = 'Email',
    [string]$RefUsernameColumn = 'Username',
    [string]$RefAddressColumn  = 'Address',
    [string]$RefAppcodeColumn  = 'Appcode',

    # Where reports are written. Defaults to the first/source CSV folder.
    [string]$OutputDir,

    # Turn off fuzzy fallback.
    [switch]$NoFuzzy,

    # Safety cap on fuzzy matches per source row.
    [int]$MaxFuzzyMatchesPerInput = 25
)

$ErrorActionPreference = 'Continue'

function Write-Info($m){ Write-Host "[INFO]  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "[OK]    $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[WARN]  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "[ERROR] $m" -ForegroundColor Red }

function Read-CsvPathPrompt {
    param(
        [Parameter(Mandatory)]
        [string]$PromptMessage
    )

    while ($true) {
        Write-Host ""
        $path = Read-Host $PromptMessage

        if ([string]::IsNullOrWhiteSpace($path)) {
            Write-Warn "Path cannot be blank. Please enter a valid CSV path."
            continue
        }

        $path = $path.Trim().Trim('"',"'").Trim()

        if (-not (Test-Path -Path $path -PathType Leaf)) {
            Write-Warn "CSV file not found: $path"
            continue
        }

        if ([System.IO.Path]::GetExtension($path) -notmatch '(?i)^\.csv$') {
            Write-Warn "The selected file does not appear to be a CSV file: $path"
            $continue = Read-Host "Continue anyway? Type Y to continue"
            if ($continue -ne 'Y') {
                continue
            }
        }

        return (Resolve-Path $path).Path
    }
}

function Get-ObjectValue {
    param(
        [Parameter(Mandatory)]
        [object]$Object,

        [string]$PropertyName
    )

    if ([string]::IsNullOrWhiteSpace($PropertyName)) {
        return ''
    }

    $prop = $Object.PSObject.Properties[$PropertyName]

    if ($null -eq $prop) {
        return ''
    }

    return [string]$prop.Value
}

function Get-CleanValue {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return $Value.Trim().Trim('"',"'").Trim()
}

function Get-EmailLocalPart {
    param([string]$Email)

    $e = Get-CleanValue $Email

    if ([string]::IsNullOrWhiteSpace($e)) {
        return ''
    }

    if ($e -match '@') {
        return (($e -split '@')[0]).Trim()
    }

    return $e
}

function Get-NormalizedKey {
    param([string]$Value)

    $v = Get-CleanValue $Value

    if ([string]::IsNullOrWhiteSpace($v)) {
        return ''
    }

    return $v.ToLower()
}

function Get-SearchCandidates {
    param([string]$Raw)

    $exact = New-Object System.Collections.Generic.List[string]
    $fuzzy = New-Object System.Collections.Generic.List[string]

    if ([string]::IsNullOrWhiteSpace($Raw)) {
        return @{
            Exact = @()
            Fuzzy = @()
        }
    }

    $core = $Raw.Trim().Trim('"',"'").Trim()

    if ($core -match '\\') {
        $core = ($core -split '\\')[-1]
    }

    if ($core -match '@') {
        $core = ($core -split '@')[0]
    }

    $core = $core.Trim()

    if ([string]::IsNullOrWhiteSpace($core)) {
        return @{
            Exact = @()
            Fuzzy = @()
        }
    }

    $variants = New-Object System.Collections.Generic.List[string]

    [void]$variants.Add($core)
    [void]$variants.Add(($core -replace '\s+',''))
    [void]$variants.Add(($core -replace '\s+','.'))
    [void]$variants.Add(($core -replace '\s+','_'))
    [void]$variants.Add(($core -replace '\s+','-'))

    foreach ($v in $variants) {
        $vv = Get-CleanValue $v

        if ($vv -and -not $exact.Contains($vv)) {
            [void]$exact.Add($vv)
        }
    }

    $fuzzyRaw = New-Object System.Collections.Generic.List[string]

    [void]$fuzzyRaw.Add(($core -replace '\s+',''))

    foreach ($w in ($core -split '\s+')) {
        $wt = ($w -replace '[^A-Za-z0-9_\-\.]', '').Trim()

        if ($wt.Length -gt 2) {
            [void]$fuzzyRaw.Add($wt)
        }
    }

    foreach ($f in $fuzzyRaw) {
        $ff = Get-CleanValue $f

        if ($ff -and -not $fuzzy.Contains($ff)) {
            [void]$fuzzy.Add($ff)
        }
    }

    return @{
        Exact = $exact.ToArray()
        Fuzzy = $fuzzy.ToArray()
    }
}

function New-ResultRow {
    param(
        [string]$SourceAccountId,
        [string]$SourceAppcode,
        [string]$InputValue,
        [string]$CleanedCandidate,
        [string]$Status,
        [string]$MatchType,
        [object]$ReferenceRecord,
        [string]$MatchedOn,
        [int]$MatchCount,
        [string]$Notes
    )

    [pscustomobject]@{
        SourceAccountID        = $SourceAccountId
        SourceAppcode          = $SourceAppcode
        InputValue             = $InputValue
        CleanedCandidate       = $CleanedCandidate
        Status                 = $Status
        MatchType              = $MatchType

        MatchedEmail           = if ($ReferenceRecord) { $ReferenceRecord.Email }    else { '' }
        MatchedUsername        = if ($ReferenceRecord) { $ReferenceRecord.Username } else { '' }
        MatchedAddress         = if ($ReferenceRecord) { $ReferenceRecord.Address }  else { '' }
        MatchedAppcode         = if ($ReferenceRecord) { $ReferenceRecord.Appcode }  else { '' }

        ReferenceRowNumber     = if ($ReferenceRecord) { $ReferenceRecord.RowNumber } else { '' }
        MatchedOn              = $MatchedOn
        MatchCountForInput     = $MatchCount
        Notes                  = $Notes
    }
}

# Prompt for CSV paths if not supplied.

if ([string]::IsNullOrWhiteSpace($CsvPath)) {
    $CsvPath = Read-CsvPathPrompt -PromptMessage "Enter the full path for the FIRST/source CSV"
}
else {
    $CsvPath = $CsvPath.Trim().Trim('"',"'").Trim()
}

if ([string]::IsNullOrWhiteSpace($ReferenceCsvPath)) {
    $ReferenceCsvPath = Read-CsvPathPrompt -PromptMessage "Enter the full path for the SECOND/reference/domain-export CSV"
}
else {
    $ReferenceCsvPath = $ReferenceCsvPath.Trim().Trim('"',"'").Trim()
}

# Path validation.

if (-not (Test-Path $CsvPath)) {
    Write-Err "First/source CSV not found: $CsvPath"
    return
}

if (-not (Test-Path $ReferenceCsvPath)) {
    Write-Err "Second/reference CSV not found: $ReferenceCsvPath"
    return
}

$CsvPath = (Resolve-Path $CsvPath).Path
$ReferenceCsvPath = (Resolve-Path $ReferenceCsvPath).Path

if (-not $OutputDir) {
    $OutputDir = Split-Path -Parent $CsvPath
}

if (-not (Test-Path $OutputDir)) {
    New-Item -ItemType Directory -Path $OutputDir -Force | Out-Null
}

$stamp       = Get-Date -Format 'yyyyMMdd_HHmmss'
$baseName    = [System.IO.Path]::GetFileNameWithoutExtension($CsvPath)
$resultsPath = Join-Path $OutputDir ("{0}_Validation_Results_{1}.csv" -f $baseName, $stamp)

# Load first/source CSV.

$rows = @(Import-Csv -Path $CsvPath)

if ($rows.Count -eq 0) {
    Write-Err "First/source CSV '$CsvPath' has no data rows."
    return
}

$columns = $rows[0].PSObject.Properties.Name

if (-not $UsernameColumn) {
    $preferred = @(
        'samaccountname',
        'sAMAccountName',
        'username',
        'user name',
        'user',
        'login',
        'logon',
        'account',
        'accountname',
        'account name',
        'name',
        'userid',
        'user id',
        'id'
    )

    foreach ($p in $preferred) {
        $hit = $columns |
            Where-Object { $_.Trim().ToLower() -eq $p.ToLower() } |
            Select-Object -First 1

        if ($hit) {
            $UsernameColumn = $hit
            break
        }
    }

    if (-not $UsernameColumn) {
        $UsernameColumn = $columns |
            Where-Object { $_ -match '(?i)user|account|name|login|logon' } |
            Select-Object -First 1
    }

    if (-not $UsernameColumn) {
        Write-Err "Could not auto-detect a username column in the first/source CSV."
        Write-Err "Available columns: $($columns -join ', ')"
        Write-Err "Re-run with -UsernameColumn '<columnName>'."
        return
    }

    Write-Info "Auto-detected source username column: '$UsernameColumn'"
}
elseif ($columns -notcontains $UsernameColumn) {
    Write-Err "Username column '$UsernameColumn' not found in first/source CSV."
    Write-Err "Available columns: $($columns -join ', ')"
    return
}

if (-not $AccountIdColumn) {
    $idPreferred = @(
        'accountid',
        'account id',
        'cyberarkid',
        'cyberark id',
        'pasaccountid',
        'pas account id',
        'uniqueid',
        'unique id',
        'objectid',
        'object id',
        'id'
    )

    foreach ($p in $idPreferred) {
        $hit = $columns |
            Where-Object {
                $_.Trim().ToLower() -eq $p.ToLower() -and
                $_ -ne $UsernameColumn
            } |
            Select-Object -First 1

        if ($hit) {
            $AccountIdColumn = $hit
            break
        }
    }

    if ($AccountIdColumn) {
        Write-Info "Auto-detected source Account ID column: '$AccountIdColumn'"
    }
    else {
        Write-Warn "No Account ID column detected in first/source CSV; SourceAccountID will be blank."
    }
}
elseif ($columns -notcontains $AccountIdColumn) {
    Write-Err "Account ID column '$AccountIdColumn' not found in first/source CSV."
    Write-Err "Available columns: $($columns -join ', ')"
    return
}

if (-not $SourceAppcodeColumn) {
    $hitSourceAppcode = $columns |
        Where-Object { $_.Trim().ToLower() -eq 'appcode' } |
        Select-Object -First 1

    if ($hitSourceAppcode) {
        $SourceAppcodeColumn = $hitSourceAppcode
        Write-Info "Auto-detected source Appcode column: '$SourceAppcodeColumn'"
    }
}
elseif ($columns -notcontains $SourceAppcodeColumn) {
    Write-Err "Source Appcode column '$SourceAppcodeColumn' not found in first/source CSV."
    Write-Err "Available columns: $($columns -join ', ')"
    return
}

# Load second/reference CSV.

$refRows = @(Import-Csv -Path $ReferenceCsvPath)

if ($refRows.Count -eq 0) {
    Write-Err "Second/reference CSV '$ReferenceCsvPath' has no data rows."
    return
}

$refColumns = $refRows[0].PSObject.Properties.Name

$requiredRefColumns = @(
    $RefEmailColumn,
    $RefUsernameColumn,
    $RefAddressColumn,
    $RefAppcodeColumn
)

foreach ($col in $requiredRefColumns) {
    if ($refColumns -notcontains $col) {
        Write-Err "Required reference column '$col' not found in second/reference CSV."
        Write-Err "Available columns: $($refColumns -join ', ')"
        return
    }
}

Write-Info "Loaded $($rows.Count) source row(s) from first CSV."
Write-Info "Loaded $($refRows.Count) reference row(s) from second CSV."
Write-Info "Source username column: '$UsernameColumn'"
Write-Info "Source Account ID column: '$AccountIdColumn'"
Write-Info "Reference columns: Email='$RefEmailColumn', Username='$RefUsernameColumn', Address='$RefAddressColumn', Appcode='$RefAppcodeColumn'"

# Build reference lookup.

$referenceRecords = New-Object System.Collections.Generic.List[object]
$exactIndex = @{}

$refRowNum = 0

foreach ($ref in $refRows) {
    $refRowNum++

    $email    = Get-CleanValue (Get-ObjectValue -Object $ref -PropertyName $RefEmailColumn)
    $username = Get-CleanValue (Get-ObjectValue -Object $ref -PropertyName $RefUsernameColumn)
    $address  = Get-CleanValue (Get-ObjectValue -Object $ref -PropertyName $RefAddressColumn)
    $appcode  = Get-CleanValue (Get-ObjectValue -Object $ref -PropertyName $RefAppcodeColumn)

    $emailLocal = Get-EmailLocalPart $email

    $keys = New-Object System.Collections.Generic.List[string]

    foreach ($candidateKey in @($username, $emailLocal, $email)) {
        $k = Get-NormalizedKey $candidateKey

        if ($k -and -not $keys.Contains($k)) {
            [void]$keys.Add($k)
        }
    }

    $record = [pscustomobject]@{
        RowNumber  = $refRowNum
        Email      = $email
        Username   = $username
        Address    = $address
        Appcode    = $appcode
        ExactKeys  = $keys.ToArray()
        SearchText = ("{0} {1} {2} {3}" -f $username, $email, $address, $appcode).ToLower()
    }

    [void]$referenceRecords.Add($record)

    foreach ($key in $record.ExactKeys) {
        if (-not $exactIndex.ContainsKey($key)) {
            $exactIndex[$key] = New-Object System.Collections.Generic.List[object]
        }

        [void]$exactIndex[$key].Add($record)
    }
}

function Find-ExactReferenceMatches {
    param(
        [string[]]$Candidates,
        [hashtable]$Index
    )

    $found = @{}

    foreach ($cand in $Candidates) {
        $key = Get-NormalizedKey $cand

        if ([string]::IsNullOrWhiteSpace($key)) {
            continue
        }

        if ($Index.ContainsKey($key)) {
            foreach ($record in $Index[$key]) {
                $unique = "{0}|{1}|{2}|{3}|{4}" -f `
                    $record.RowNumber,
                    $record.Email,
                    $record.Username,
                    $record.Address,
                    $record.Appcode

                if (-not $found.ContainsKey($unique)) {
                    $found[$unique] = [pscustomobject]@{
                        Record    = $record
                        MatchedOn = $cand
                        MatchType = 'Exact'
                    }
                }
            }
        }
    }

    return @($found.Values)
}

function Find-FuzzyReferenceMatches {
    param(
        [string[]]$Tokens,
        [object[]]$ReferenceRecords,
        [int]$Cap
    )

    $found = @{}

    foreach ($token in $Tokens) {
        $t = Get-NormalizedKey $token

        if ([string]::IsNullOrWhiteSpace($t) -or $t.Length -lt 3) {
            continue
        }

        foreach ($record in $ReferenceRecords) {
            if ($found.Count -ge $Cap) {
                break
            }

            if ($record.SearchText -like "*$t*") {
                $unique = "{0}|{1}|{2}|{3}|{4}" -f `
                    $record.RowNumber,
                    $record.Email,
                    $record.Username,
                    $record.Address,
                    $record.Appcode

                if (-not $found.ContainsKey($unique)) {
                    $found[$unique] = [pscustomobject]@{
                        Record    = $record
                        MatchedOn = $token
                        MatchType = 'Fuzzy'
                    }
                }
            }
        }

        if ($found.Count -ge $Cap) {
            break
        }
    }

    return @($found.Values)
}

# Main validation.

$results = New-Object System.Collections.Generic.List[object]
$rowNum = 0

foreach ($row in $rows) {
    $rowNum++

    $raw = Get-ObjectValue -Object $row -PropertyName $UsernameColumn

    $sourceAccountId = ''
    if ($AccountIdColumn) {
        $sourceAccountId = Get-ObjectValue -Object $row -PropertyName $AccountIdColumn
    }

    $sourceAppcode = ''
    if ($SourceAppcodeColumn) {
        $sourceAppcode = Get-ObjectValue -Object $row -PropertyName $SourceAppcodeColumn
    }

    Write-Info ("[{0}/{1}] Validating InputValue='{2}' SourceAccountID='{3}'" -f `
        $rowNum,
        $rows.Count,
        $raw,
        $sourceAccountId)

    $cand = Get-SearchCandidates -Raw $raw

    if ($cand.Exact.Count -eq 0) {
        $results.Add((New-ResultRow `
            -SourceAccountId $sourceAccountId `
            -SourceAppcode $sourceAppcode `
            -InputValue $raw `
            -CleanedCandidate '' `
            -Status 'BLANK_OR_INVALID' `
            -MatchType '' `
            -ReferenceRecord $null `
            -MatchedOn '' `
            -MatchCount 0 `
            -Notes 'Empty or unparseable value')) | Out-Null

        continue
    }

    $matches = @(Find-ExactReferenceMatches `
        -Candidates $cand.Exact `
        -Index $exactIndex)

    if ($matches.Count -eq 0 -and -not $NoFuzzy -and $cand.Fuzzy.Count -gt 0) {
        $matches = @(Find-FuzzyReferenceMatches `
            -Tokens $cand.Fuzzy `
            -ReferenceRecords $referenceRecords.ToArray() `
            -Cap $MaxFuzzyMatchesPerInput)
    }

    $count = $matches.Count

    if ($count -eq 0) {
        $results.Add((New-ResultRow `
            -SourceAccountId $sourceAccountId `
            -SourceAppcode $sourceAppcode `
            -InputValue $raw `
            -CleanedCandidate $cand.Exact[0] `
            -Status 'NOT_FOUND' `
            -MatchType '' `
            -ReferenceRecord $null `
            -MatchedOn ($cand.Exact -join ' | ') `
            -MatchCount 0 `
            -Notes 'No match found in second/reference CSV')) | Out-Null

        continue
    }

    foreach ($m in $matches) {
        $note = ''

        if ($m.MatchType -eq 'Fuzzy') {
            $note = 'Fuzzy suggestion - verify before use'
        }
        elseif ($count -gt 1) {
            $note = "Multiple matches found in second/reference CSV"
        }

        $results.Add((New-ResultRow `
            -SourceAccountId $sourceAccountId `
            -SourceAppcode $sourceAppcode `
            -InputValue $raw `
            -CleanedCandidate $cand.Exact[0] `
            -Status 'FOUND' `
            -MatchType $m.MatchType `
            -ReferenceRecord $m.Record `
            -MatchedOn $m.MatchedOn `
            -MatchCount $count `
            -Notes $note)) | Out-Null
    }
}

# Export.

$results | Export-Csv -Path $resultsPath -NoTypeInformation -Encoding UTF8

Write-Host ""
Write-Ok "Validation complete."
Write-Host "----------------------------------------"

$byStatus = $results | Group-Object Status | Sort-Object Name

foreach ($g in $byStatus) {
    Write-Host ("  {0,-18} {1} line(s)" -f $g.Name, $g.Count)
}

Write-Host "----------------------------------------"
Write-Host ("  Source CSV rows processed   : {0}" -f $rows.Count)
Write-Host ("  Reference CSV rows loaded   : {0}" -f $refRows.Count)
Write-Host ("  Total result lines          : {0}" -f $results.Count)
Write-Host "----------------------------------------"
Write-Ok "Results report: $resultsPath"
