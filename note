<#
.SYNOPSIS
  Audit + enforce membership for identity-privilege-integration-user$ on IND_/APP_ safes.

.DESCRIPTION
  - Builds a membership report for all safes.
  - For safes starting with IND_ or APP_, ensures the user
    'identity-privilege-integration-user$' (MemberType=User) exists with full permissions.
  - Uses -Full (Gen2) when available; otherwise splats individual switches.
  - Logs steps and exports CSVs. PS 5.1 compatible.
#>

param(
  [switch]$DryRun
)

# =========================
# Config
# =========================
$LogFile        = "SafeMemberAudit.log"
$CsvFilePath    = "I:\Script\REPORTS\csv\SafeMembersReport.csv"
$PVWAURL        = "https://alliantcredit.privilegecloud.cyberark.com"
$TargetMember   = "identity-privilege-integration-user$"
$TargetPrefixes = '^IND_|^APP_'   # enforce only on these
$Stopwatch      = [System.Diagnostics.Stopwatch]::StartNew()

# =========================
# Helpers
# =========================
function Write-Log {
    param ([string]$Message)
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "$timestamp | $Message"
    Add-Content -Path $LogFile -Value $entry
    Write-Host $entry
}

# Tolerant matcher: "identity-privilege-integration-user$" or "...$@tenant"
$TargetRegex = '^' + [regex]::Escape($TargetMember) + '($|@)'

# Build *supported* full-permission switch set dynamically for your psPAS version
function Get-FullPermissionSwitches {
    param([System.Management.Automation.CommandInfo]$Cmd)

    $desired = @(
        'UseAccounts','RetrieveAccounts','ListAccounts','AddAccounts',
        'UpdateAccountContent','UpdateAccountProperties',
        'InitiateCPMAccountManagementOperations','SpecifyNextAccountContent',
        'RenameAccounts','DeleteAccounts','UnlockAccounts',
        'ManageSafe','ManageSafeMembers','BackupSafe',
        'ViewAuditLog','ViewSafeMembers','AccessWithoutConfirmation',
        'CreateFolders','DeleteFolders','MoveAccountsAndFolders',
        # Gen2-only request auth flags (if present)
        'requestsAuthorizationLevel1','requestsAuthorizationLevel2'
    )

    $supported = @{}
    foreach ($k in $desired) {
        if ($Cmd.Parameters.ContainsKey($k)) { $supported[$k] = $true }
    }
    return $supported
}

# =========================
# Module + Auth
# =========================
try {
    Import-Module psPAS -ErrorAction Stop
    $psPASVersion = (Get-Module psPAS).Version
    Write-Log "🔧 psPAS loaded (v$psPASVersion)."
} catch {
    Write-Log "❌ psPAS module not found or failed to import: $_"
    exit 1
}

try { Start-Transcript -Path ($LogFile -replace '\.log$','.transcript.log') -Append | Out-Null } catch {}

$Cred = Get-Credential -Message "Enter CyberArk (PVWA/Privilege Cloud) credentials"
try {
    New-PASSession -Credential $Cred -BaseURI $PVWAURL -ErrorAction Stop | Out-Null
    Write-Log "✅ Connected to CyberArk Privilege Cloud."
} catch {
    Write-Log "❌ Authentication failed: $_"
    try { Stop-Transcript | Out-Null } catch {}
    exit 1
}

# =========================
# Discover safes
# =========================
try {
    $Safes = Get-PASSafe -ErrorAction Stop
    if (-not $Safes) { $Safes = @() }
    Write-Log "📦 Retrieved $($Safes.Count) safes."
} catch {
    Write-Log "❌ Failed to retrieve safes: $_"
    try { Close-PASSession | Out-Null } catch {}
    try { Stop-Transcript | Out-Null } catch {}
    exit 1
}

# Determine Add-PASSafeMember capabilities (Full vs switches)
$AddMemberCmd = Get-Command Add-PASSafeMember -ErrorAction SilentlyContinue
$SupportsFull = $false
if ($AddMemberCmd) { $SupportsFull = $AddMemberCmd.Parameters.ContainsKey('Full') }

$supportsText = 'No (-Full not available; will splat switches)'
if ($SupportsFull) { $supportsText = 'Yes (will use -Full)' }
Write-Log ("🔎 Add-PASSafeMember -Full supported: " + $supportsText)

$SwitchMap = Get-FullPermissionSwitches -Cmd $AddMemberCmd

# =========================
# Process safes
# =========================
$SafeMembersReport = @()
$AddedMembers      = @()

$Total = [math]::Max(1, $Safes.Count)
for ($i=0; $i -lt $Safes.Count; $i++) {
    $SafeObj  = $Safes[$i]
    $SafeName = $SafeObj.safeName

    Write-Progress -Activity "Scanning safes & enforcing member" `
                   -Status "Processing: $SafeName" `
                   -PercentComplete ([int](($i+1)/$Total*100))

    if ($SafeName -notmatch $TargetPrefixes) {
        Write-Log "➖ Skipping (prefix mismatch): $SafeName"
        continue
    }

    Write-Log "🔹 Retrieving members for Safe: $SafeName"
    try {
        $SafeMembers = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
    } catch {
        Write-Log "❌ ERROR: Failed to retrieve members for ${SafeName} - $_"
        continue
    }

    if (-not $SafeMembers) { $SafeMembers = @() }

    foreach ($Member in $SafeMembers) {
        $p = $Member.Permissions
        $SafeMembersReport += [PSCustomObject]@{
            SafeName                                 = $SafeName
            Member                                   = $Member.MemberName
            MemberType                               = $Member.MemberType
            UseAccounts                              = $p.useAccounts
            RetrieveAccounts                         = $p.retrieveAccounts
            ListAccounts                             = $p.listAccounts
            AddAccounts                              = $p.addAccounts
            UpdateAccountContent                     = $p.updateAccountContent
            UpdateAccountProperties                  = $p.updateAccountProperties
            InitiateCPMAccountManagementOperations   = $p.initiateCPMAccountManagementOperations
            SpecifyNextAccountContent                = $p.specifyNextAccountContent
            RenameAccounts                           = $p.renameAccounts
            DeleteAccounts                           = $p.deleteAccounts
            UnlockAccounts                           = $p.unlockAccounts
            ManageSafe                               = $p.manageSafe
            ManageSafeMembers                        = $p.manageSafeMembers
            BackupSafe                               = $p.backupSafe
            ViewAuditLog                             = $p.viewAuditLog
            ViewSafeMembers                          = $p.viewSafeMembers
            AccessWithoutConfirmation                = $p.accessWithoutConfirmation
            CreateFolders                            = $p.createFolders
            DeleteFolders                            = $p.deleteFolders
            MoveAccountsAndFolders                   = $p.moveAccountsAndFolders
            RequestsAuthorizationLevel1              = $p.requestsAuthorizationLevel1
            RequestsAuthorizationLevel2              = $p.requestsAuthorizationLevel2
        }
    }

    # Tolerant existence check
    $exists = $false
    foreach ($m in $SafeMembers) {
        $n = ($m.MemberName -as [string]).Trim()
        if ([string]::IsNullOrWhiteSpace($n)) { continue }
        if ([regex]::IsMatch($n, $TargetRegex, 'IgnoreCase')) { $exists = $true; break }
    }

    if ($exists) {
        Write-Log "✅ Member already present on ${SafeName}: $TargetMember"
        continue
    }

    if ($DryRun) {
        Write-Log "🧪 DRY-RUN: Would add $TargetMember (User) with full permissions to ${SafeName}"
        $AddedMembers += [PSCustomObject]@{ SafeName = $SafeName; MemberAdded = $TargetMember; Mode='DryRun'; When = (Get-Date) }
        continue
    }

    Write-Log "🛠 Adding missing member to ${SafeName}: $TargetMember (User, full permissions)"
    try {
        if ($SupportsFull) {
            # Preferred Gen2 path (PSPAS 12.1+)
            Add-PASSafeMember -SafeName $SafeName `
                              -MemberName $TargetMember `
                              -MemberType User `
                              -SearchIn Vault `
                              -Full `
                              -ErrorAction Stop | Out-Null
        } else {
            # Fallback: splat only switches your psPAS exposes
            $args = @{
                SafeName   = $SafeName
                MemberName = $TargetMember
                MemberType = 'User'
                SearchIn   = 'Vault'
                ErrorAction= 'Stop'
            }
            foreach ($k in $SwitchMap.Keys) { $args[$k] = $true }
            Add-PASSafeMember @args | Out-Null
        }

        Write-Log "✅ Added $TargetMember with full permissions to ${SafeName}"
        $AddedMembers += [PSCustomObject]@{ SafeName = $SafeName; MemberAdded = $TargetMember; Mode='Applied'; When = (Get-Date) }
    } catch {
        Write-Log "❌ ERROR: Failed adding $TargetMember to ${SafeName} - $_"
    }
}

# =========================
# Export report(s)
# =========================
try {
    $dir = Split-Path $CsvFilePath -Parent
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }

    $SafeMembersReport | Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8
    Write-Log "✅ Safe Member Report exported: $CsvFilePath"
} catch {
    Write-Log "❌ Failed to export Safe Member Report: $_"
}

if ($AddedMembers.Count -gt 0) {
    $AddedSummaryPath = "I:\Script\REPORTS\csv\SafeMembers_Added_$((Get-Date).ToString('yyyyMMdd_HHmmss')).csv"
    try {
        $AddedMembers | Export-Csv -Path $AddedSummaryPath -NoTypeInformation -Encoding UTF8
        Write-Log "📄 Summary of added members exported: $AddedSummaryPath"
    } catch {
        Write-Log "❌ Failed to export summary of added members: $_"
    }
} else {
    Write-Log "ℹ️ No additions were necessary (all matching safes already contained $TargetMember)."
}

# =========================
# Cleanup
# =========================
try { Close-PASSession | Out-Null } catch {}
$Stopwatch.Stop()
$modeText = 'Changes applied.'
if ($DryRun) { $modeText = 'Mode: DRY-RUN' }
Write-Log ("🔹 Completed in " + [int]$Stopwatch.Elapsed.TotalSeconds + "s. " + $modeText)

try { Stop-Transcript | Out-Null } catch {}
