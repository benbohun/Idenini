<#
Creates or replaces the scheduled task:

    \PAM\Move Disabled Accounts Daily

The installer does NOT configure a service account, SYSTEM account,
username, or password. Configure the task's Security Options manually
in Task Scheduler after installation.

Run from Windows PowerShell 5.1 as Administrator.
#>

[CmdletBinding()]
param(
    [string]$TaskFolder = "PAM",

    [string]$TaskName = "Move Disabled Accounts Daily",

    [string]$ScriptPath = "I:\Script\IDENTITY Script New\Onbarding Project\Move-DisabledAccount.ps1",

    [ValidatePattern("^(?:[01]\d|2[0-3]):[0-5]\d$")]
    [string]$DailyAt = "02:00",

    [switch]$RunNow
)

$ErrorActionPreference = "Stop"

function Assert-Administrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)

    if (-not $principal.IsInRole(
            [Security.Principal.WindowsBuiltInRole]::Administrator
        )) {
        throw "Run this installer from Windows PowerShell 5.1 as Administrator."
    }
}

function Ensure-TaskFolder {
    param(
        [Parameter(Mandatory)]
        [string]$FolderName
    )

    $service = New-Object -ComObject "Schedule.Service"
    $service.Connect()

    try {
        return $service.GetFolder("\$FolderName")
    }
    catch {
        $rootFolder = $service.GetFolder("\")
        return $rootFolder.CreateFolder($FolderName, $null)
    }
}

try {
    Assert-Administrator

    if (-not (Test-Path -LiteralPath $ScriptPath -PathType Leaf)) {
        throw "Working script was not found: $ScriptPath"
    }

    $TaskFolder = $TaskFolder.Trim().Trim("\")
    $TaskPath = "\$TaskFolder\"
    $workingDirectory = Split-Path -Path $ScriptPath -Parent

    $null = Ensure-TaskFolder -FolderName $TaskFolder

    $powerShellExe = Join-Path `
        $env:SystemRoot `
        "System32\WindowsPowerShell\v1.0\powershell.exe"

    $action = New-ScheduledTaskAction `
        -Execute $powerShellExe `
        -Argument "-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File `"$ScriptPath`"" `
        -WorkingDirectory $workingDirectory

    $trigger = New-ScheduledTaskTrigger `
        -Daily `
        -At $DailyAt

    $settings = New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -MultipleInstances IgnoreNew `
        -ExecutionTimeLimit (New-TimeSpan -Hours 6)

    Register-ScheduledTask `
        -TaskName $TaskName `
        -TaskPath $TaskPath `
        -Action $action `
        -Trigger $trigger `
        -Settings $settings `
        -Description "Runs Move-DisabledAccount.ps1 daily." `
        -Force | Out-Null

    Write-Host ""
    Write-Host "Scheduled task created successfully." -ForegroundColor Green
    Write-Host "Task      : $TaskPath$TaskName"
    Write-Host "Schedule  : Daily at $DailyAt"
    Write-Host "Script    : $ScriptPath"
    Write-Host ""
    Write-Host "Open Task Scheduler and configure the required account under:"
    Write-Host "General > Security options > Change User or Group"

    if ($RunNow) {
        Start-ScheduledTask `
            -TaskName $TaskName `
            -TaskPath $TaskPath

        Write-Host "Task started." -ForegroundColor Green
    }
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
