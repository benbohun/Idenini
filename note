<#
Single Platform Report (CSV)
Auth: CCP -> Get-IdentityHeader (psPASFormat) -> Use-PASSession
Report: /PasswordVault/API/Platforms (or fallback /PasswordVault/api/Platforms)

Exports ONE CSV with these fields:
PlatformID, PlatformName, Active, Description, PlatformBaseID, PlatformType, SystemType,
RequiredProperties, OptionalProperties, LinkedAccounts,
AllowedSafes, AllowManualChange, PerformPeriodicChange, RequirePasswordChangeEveryXDays,
AllowManualVerification, PerformPeriodicVerification, RequirePasswordVerificationEveryXDays,
AllowManualReconciliation, AutomaticReconcileWhenUnsynched,
RequirePrivilegedSessionMonitoringAndIsolation, RecordAndSaveSessionActivity, PSMServerID,
RequireDualControlPasswordAccessApproval, EnforceCheckinCheckoutExclusiveAccess, EnforceOnetimePasswordAccess
#>

# --- Allow this process to load unsigned modules & unblock psPAS files (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
  try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# -------------------- SETTINGS --------------------
$OutDir     = "E:\Installation Media\RemovePendingAccount"
$CsvFile    = Join-Path $OutDir "CyberArk_Platforms.csv"
$DebugFile  = Join-Path $OutDir "CyberArk_Platforms_Raw.json"
$LogPath    = Join-Path $OutDir "CyberArk_PlatformReportLog.txt"

# --- Logging Utility ---
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# Ensure output directory exists
try {
    if (-not (Test-Path $OutDir)) { New-Item -ItemType Directory -Path $OutDir -Force | Out-Null }
} catch {
    Write-Host "❌ Cannot create output directory: $OutDir : $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
} catch {
    Write-Log ("❌ psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

# -------------------- CCP + IDENTITY LOGIN (YOUR METHOD) --------------------
# CCP parameters (shared)
$CCPAddress   = "https://vskau1p1231.cna.com"
$location     = "AIMWebService"
$application  = "PAMDiscovery"
$safeCCP      = "CA_PCloud_Admins"
$headers      = @{ "Content-Type" = "application/json" }
$windowsAuth  = $false

# Identity + PCloud
$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"   # safe: include https
$PCloudSubdomain   = "cna-prod"

# Helper: start a PAS session from CCP creds using the SAME psPAS Identity method
Function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,   # e.g. cna.com-CA_PAMDiscovery_SVC
        [Parameter(Mandatory)] [string]$UPUser        # e.g. CA_PAMDiscovery_SVC
    )

    # Normalize Identity URL if someone passes without https
    if ($IdentityTenantURL -notmatch '^https?://') { $script:IdentityTenantURL = "https://$IdentityTenantURL" }

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log ("Retrieving CyberArk API credentials from CCP via Object method..." ) "Cyan"
    Write-Log ("CCP URL: {0}" -f $ccpUrl) "Gray"

    try {
        $resp = Invoke-RestMethod $ccpUrl -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth -ErrorAction Stop
        if (-not $resp -or -not $resp.Content) { throw "Empty CCP response (missing Content)" }
        Write-Log ("✅ Successfully retrieved CCP secret for: {0}" -f $UPUser) "Green"
    } catch {
        Write-Log ("❌ ERROR: CCP credential fetch failed - {0}" -f $_.Exception.Message) "Red"
        throw
    }

    try {
        Write-Log ("Requesting CyberArk PAS authentication (psPAS Identity header) as {0}..." -f $UPUser) "Cyan"
        $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $UPCred = [PSCredential]::new($UPUser, $UPPass)

        # This assumes Get-IdentityHeader exists in your environment (as in your working script)
        $headerSession = Get-IdentityHeader `
            -IdentityTenantURL $IdentityTenantURL `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $UPCred

        # Use-PASSession expects an object containing BaseURI/WebSession (psPASFormat provides it)
        Use-PASSession $headerSession

        if (-not (Get-PASSession)) { throw "psPAS session not established" }
        Write-Log ("✅ Authentication successful, PAS session established ({0})." -f $UPUser) "Green"
    } catch {
        Write-Log ("❌ Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) "Red"
        throw
    }
}

# -------------------- REPORT HELPERS --------------------
function Join-Names($arr) {
    if (-not $arr) { return "" }
    try { return ($arr | ForEach-Object { $_.name } | Where-Object { $_ } | Sort-Object -Unique) -join "; " } catch { return "" }
}
function Join-PropNames($arr) {
    if (-not $arr) { return "" }
    try { return ($arr | ForEach-Object { $_.name } | Where-Object { $_ } | Sort-Object -Unique) -join "; " } catch { return "" }
}

# -------------------- MAIN --------------------
$sessionStarted = $false
try {
    # Start session
    $ObjectName = "cna.com-CA_PAMDiscovery_SVC"
    $UPUser     = "CA_PAMDiscovery_SVC"
    Start-PASSessionFromCCP -ObjectName $ObjectName -UPUser $UPUser
    $sessionStarted = $true

    # Ask optional filter
    $useActiveOnly = Read-Host "Filter Active platforms only? (yes/no)"
    $querySuffix = ""
    if ($useActiveOnly -match '^(y|yes)$') { $querySuffix = "?Active=True" }

    # Use the auth session from psPAS
    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) { throw "Get-PASSession returned no WebSession; cannot call API." }

    # Call Platforms endpoint (try API then api)
    $base1 = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/$querySuffix"
    $base2 = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/$querySuffix"

    Write-Log ("Fetching platforms from: {0}" -f $base1) "Cyan"

    try {
        $PlatformsResponse = Invoke-RestMethod -Uri $base1 -Method Get -WebSession $s.WebSession -ErrorAction Stop
    } catch {
        Write-Log ("⚠️ First endpoint failed, trying lowercase /api path... Error: {0}" -f $_.Exception.Message) "Yellow"
        $PlatformsResponse = Invoke-RestMethod -Uri $base2 -Method Get -WebSession $s.WebSession -ErrorAction Stop
    }

    # Save raw JSON for troubleshooting
    try {
        $PlatformsResponse | ConvertTo-Json -Depth 10 | Out-File -LiteralPath $DebugFile -Encoding utf8
        Write-Log ("Raw API Response saved to: {0}" -f $DebugFile) "Green"
    } catch {
        Write-Log ("⚠️ Could not save raw JSON: {0}" -f $_.Exception.Message) "Yellow"
    }

    # Extract platforms node (per CyberArk docs it is Platforms) but keep fallback
    $platforms = $null
    if ($PlatformsResponse.Platforms) { $platforms = $PlatformsResponse.Platforms }
    elseif ($PlatformsResponse.platforms) { $platforms = $PlatformsResponse.platforms }
    elseif ($PlatformsResponse.value) { $platforms = $PlatformsResponse.value }
    else { $platforms = @() }

    if (-not $platforms -or $platforms.Count -eq 0) {
        throw "No platforms found in response. Check API permissions or filters. (See raw JSON: $DebugFile)"
    }

    Write-Log ("Retrieved {0} platforms. Building report..." -f $platforms.Count) "Green"

    # Build report (ONLY the fields you requested)
    $ProcessedPlatforms = $platforms | ForEach-Object {
        $g      = $_.general
        $props  = $_.properties
        $linked = $_.linkedAccounts
        $cred   = $_.credentialsManagement
        $sess   = $_.sessionManagement
        $wf     = $_.privilegedAccessWorkflows

        [PSCustomObject]@{
            PlatformID       = $g.id
            PlatformName     = $g.name
            Active           = $g.active
            Description      = $g.description
            PlatformBaseID   = $g.platformBaseID
            PlatformType     = $g.platformType
            SystemType       = $g.systemType

            RequiredProperties = (Join-PropNames $props.required)
            OptionalProperties = (Join-PropNames $props.optional)

            LinkedAccounts     = (Join-Names $linked)

            AllowedSafes                          = $cred.allowedSafes
            AllowManualChange                     = [string]$cred.allowManualChange
            PerformPeriodicChange                 = [string]$cred.performPeriodicChange
            RequirePasswordChangeEveryXDays       = [string]$cred.requirePasswordChangeEveryXDays
            AllowManualVerification               = [string]$cred.allowManualVerification
