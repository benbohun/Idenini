<# 
Single Platform Report (CSV)
AUTH: CCP -> Get-IdentityHeader (psPASFormat) -> Use-PASSession

EXPORTS:
  - CyberArk_Platforms.csv
  - CyberArk_Platforms_Raw.json (debug)

UPDATED:
  - Includes ReconcileAccountSafe
  - Includes ReconcileAccountName
  - Includes LogonAccountSafe
  - Includes LogonAccountName
  - Includes HasAssignedAccounts
  - Includes AssignedAccountCount
  - Includes AssignedAccountSample
  - Includes PlatformAssignmentStatus

NOTES:
  - Get-Platforms returns summary fields only.
  - Get-PlatformDetails returns the platform Policy INI key/value list.
  - If values are still blank there, this script falls back to Export Platform ZIP
    and parses the CPM INI / PVWA XML.
  - Export Platform requires Vault Admin rights.
  - Account assignment check pulls all accounts once, groups them by platformId,
    then joins the result back to each platform.
#>

# ---- Execution policy & unblock psPAS (silent) ----
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# ---------------- SETTINGS ----------------
$OutDir    = "E:\Installation Media\Script\OnboardScript\data"
$CsvFile   = Join-Path $OutDir "CyberArk_Platforms.csv"
$DebugFile = Join-Path $OutDir "CyberArk_Platforms_Raw.json"
$LogFile   = Join-Path $OutDir "CyberArk_PlatformReportLog.txt"

# Account lookup settings
$AccountPageLimit  = 1000
$AccountSampleLimit = 10

# ---------------- LOGGING ----------------
function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [Parameter()][ValidateSet("White","Green","Yellow","Red","Cyan","Gray")][string]$Color = "White"
    )

    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "{0} - {1}" -f $ts, $Message

    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogFile -Value $line } catch {}
}

# Ensure output directory exists
try {
    if (-not (Test-Path $OutDir)) {
        New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
    }
}
catch {
    Write-Host ("ERROR: Cannot create output directory: {0}. {1}" -f $OutDir, $_.Exception.Message) -ForegroundColor Red
    exit 1
}

# ---------------- LOAD psPAS ----------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
}
catch {
    Write-Log ("ERROR: psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

# ---------------- CCP + IDENTITY SETTINGS ----------------
$CCPAddress      = "https://vskau1p1231.cna.com"
$CCPLocation     = "AIMWebService"
$CCPAppID        = "PAMDiscovery"
$CCPSafe         = "CA_PCloud_Admins"
$CCPObject       = "cna.com-CA_PAMDiscovery_SVC"
$ServiceUPUser   = "CA_PAMDiscovery_SVC"
$CCPWindowsAuth  = $false

$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# ---------------- HELPERS ----------------
function Join-Names {
    param($arr)

    if (-not $arr) { return "" }

    try {
        return (($arr | ForEach-Object { $_.name } | Where-Object { $_ }) -join "; ")
    }
    catch {
        return ""
    }
}

function Join-PropNames {
    param($arr)

    if (-not $arr) { return "" }

    try {
        return (($arr | ForEach-Object { $_.name } | Where-Object { $_ }) -join "; ")
    }
    catch {
        return ""
    }
}

function Get-CaseInsensitiveMemberValue {
    param(
        [Parameter(Mandatory)]$InputObject,
        [Parameter(Mandatory)][string[]]$Names
    )

    if ($null -eq $InputObject) { return $null }

    if ($InputObject -is [System.Collections.IDictionary]) {
        foreach ($n in $Names) {
            foreach ($k in $InputObject.Keys) {
                if ([string]$k -ieq $n) {
                    return $InputObject[$k]
                }
            }
        }
        return $null
    }

    $propNames = @($InputObject.PSObject.Properties.Name)
    foreach ($n in $Names) {
        $match = $propNames | Where-Object { $_ -ieq $n } | Select-Object -First 1
        if ($match) {
            return $InputObject.$match
        }
    }

    return $null
}

function ConvertTo-BoolSafe {
    param($Value)

    if ($null -eq $Value) { return $false }

    $s = [string]$Value
    return ($s -match '^(true|1|yes)$')
}

function Format-AssignedAccountSample {
    param(
        [Parameter()]$Accounts,
        [Parameter()][int]$Limit = 10
    )

    if (-not $Accounts) { return "" }

    $sample = @($Accounts | Select-Object -First $Limit | ForEach-Object {
        $safeName = [string](Get-CaseInsensitiveMemberValue -InputObject $_ -Names @('safeName','SafeName','safe'))
        $name     = [string](Get-CaseInsensitiveMemberValue -InputObject $_ -Names @('name','Name'))
        $userName = [string](Get-CaseInsensitiveMemberValue -InputObject $_ -Names @('userName','UserName','username'))
        $address  = [string](Get-CaseInsensitiveMemberValue -InputObject $_ -Names @('address','Address'))

        $left = ""
        if (-not [string]::IsNullOrWhiteSpace($safeName) -and -not [string]::IsNullOrWhiteSpace($name)) {
            $left = "{0}\{1}" -f $safeName, $name
        }
        elseif (-not [string]::IsNullOrWhiteSpace($name)) {
            $left = $name
        }
        elseif (-not [string]::IsNullOrWhiteSpace($userName)) {
            $left = $userName
        }
        else {
            $left = "UnknownAccount"
        }

        $rightParts = @()
        if (-not [string]::IsNullOrWhiteSpace($userName)) { $rightParts += $userName }
        if (-not [string]::IsNullOrWhiteSpace($address))  { $rightParts += $address }

        if ($rightParts.Count -gt 0) {
            "{0} ({1})" -f $left, ($rightParts -join "@")
        }
        else {
            $left
        }
    })

    return ($sample -join "; ")
}

# ---------------- AUTH ----------------
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $headers = @{ "Content-Type" = "application/json" }
    $ccpUrl  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"
    Write-Log ("CCP URL: {0}" -f $ccpUrl) "Gray"

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    Write-Log ("CCP secret retrieved successfully for: {0}" -f $UPUser) "Green"

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred

    Use-PASSession $headerSession

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

# ---------------- PLATFORM API ----------------
function Get-Platforms {
    param([string]$QueryString)

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms{1}" -f $PCloudSubdomain, $QueryString
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms{1}" -f $PCloudSubdomain, $QueryString

    try {
        Write-Log ("Calling: {0}" -f $u1) "Cyan"
        return Invoke-RestMethod -Uri $u1 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
    catch {
        Write-Log ("First endpoint failed, trying lowercase path. Reason: {0}" -f $_.Exception.Message) "Yellow"
        Write-Log ("Calling: {0}" -f $u2) "Cyan"
        return Invoke-RestMethod -Uri $u2 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
}

function Get-PlatformDetails {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/{1}/" -f $PCloudSubdomain, $encodedPlatformID
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/{1}/" -f $PCloudSubdomain, $encodedPlatformID

    try {
        Write-Log ("Calling platform details: {0}" -f $u1) "Gray"
        return Invoke-RestMethod -Uri $u1 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
    catch {
        Write-Log ("Platform details uppercase path failed for [{0}], trying lowercase path. Reason: {1}" -f $PlatformID, $_.Exception.Message) "Yellow"
        Write-Log ("Calling platform details: {0}" -f $u2) "Gray"
        return Invoke-RestMethod -Uri $u2 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
}

function Get-PlatformExportZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)

    $tempRoot = Join-Path ([System.IO.Path]::GetTempPath()) ("CA_PlatformExport_" + [guid]::NewGuid().ToString("N"))
    $null = New-Item -ItemType Directory -Path $tempRoot -Force
    $zipPath = Join-Path $tempRoot ($PlatformID + ".zip")

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/{1}/Export/" -f $PCloudSubdomain, $encodedPlatformID
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/{1}/Export/" -f $PCloudSubdomain, $encodedPlatformID

    try {
        Write-Log ("Exporting platform package: {0}" -f $u1) "Gray"
        Invoke-WebRequest -Uri $u1 -Method POST -WebSession $s.WebSession -OutFile $zipPath -ErrorAction Stop | Out-Null
    }
    catch {
        Write-Log ("Platform export uppercase path failed for [{0}], trying lowercase path. Reason: {1}" -f $PlatformID, $_.Exception.Message) "Yellow"
        Write-Log ("Exporting platform package: {0}" -f $u2) "Gray"
        Invoke-WebRequest -Uri $u2 -Method POST -WebSession $s.WebSession -OutFile $zipPath -ErrorAction Stop | Out-Null
    }

    if (-not (Test-Path $zipPath)) {
        throw "Platform export did not produce a ZIP file."
    }

    return $zipPath
}

# ---------------- ACCOUNT API ----------------
function Get-Accounts {
    param([string]$QueryString)

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts{1}" -f $PCloudSubdomain, $QueryString
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Accounts{1}" -f $PCloudSubdomain, $QueryString

    try {
        Write-Log ("Calling accounts: {0}" -f $u1) "Gray"
        return Invoke-RestMethod -Uri $u1 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
    catch {
        Write-Log ("Accounts uppercase path failed, trying lowercase path. Reason: {0}" -f $_.Exception.Message) "Yellow"
        Write-Log ("Calling accounts: {0}" -f $u2) "Gray"
        return Invoke-RestMethod -Uri $u2 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
}

function Get-AccountsFromResponse {
    param($Response)

    if ($null -eq $Response) { return @() }

    if ($Response -is [System.Array]) {
        return @($Response)
    }

    $value = Get-CaseInsensitiveMemberValue -InputObject $Response -Names @('value','accounts','Accounts')
    if ($null -ne $value) {
        return @($value)
    }

    return @()
}

function Get-AllPASAccounts {
    param(
        [Parameter()][int]$Limit = 1000
    )

    $allAccounts = New-Object System.Collections.Generic.List[object]
    $offset = 0
    $page = 1

    while ($true) {
        $qs = "?limit={0}&offset={1}" -f $Limit, $offset

        $resp = Get-Accounts -QueryString $qs
        $items = @(Get-AccountsFromResponse -Response $resp)

        Write-Log ("Accounts page {0}: returned {1}; offset {2}" -f $page, $items.Count, $offset) "Gray"

        foreach ($acct in $items) {
            [void]$allAccounts.Add($acct)
        }

        if ($items.Count -lt $Limit) {
            break
        }

        $offset += $Limit
        $page++

        if ($page -gt 10000) {
            throw "Account pagination safety stop reached. Review API pagination behavior."
        }
    }

    return @($allAccounts)
}

function Build-AccountPlatformLookup {
    param(
        [Parameter(Mandatory)]$Accounts
    )

    $lookup = @{}

    foreach ($acct in @($Accounts)) {
        if ($null -eq $acct) { continue }

        $platformId = [string](Get-CaseInsensitiveMemberValue -InputObject $acct -Names @(
            'platformId',
            'platformID',
            'PlatformId',
            'PlatformID'
        ))

        if ([string]::IsNullOrWhiteSpace($platformId)) {
            continue
        }

        if (-not $lookup.ContainsKey($platformId)) {
            $lookup[$platformId] = New-Object System.Collections.Generic.List[object]
        }

        [void]$lookup[$platformId].Add($acct)
    }

    return $lookup
}

function Get-PlatformAssignmentStatus {
    param(
        [Parameter(Mandatory)]$Active,
        [Parameter(Mandatory)][int]$AssignedAccountCount,
        [Parameter(Mandatory)][bool]$AccountLookupReady
    )

    if (-not $AccountLookupReady) {
        return "AccountLookupFailed"
    }

    $isActive = ConvertTo-BoolSafe $Active

    if ($isActive -and $AssignedAccountCount -gt 0) {
        return "Active_Assigned"
    }
    elseif ($isActive -and $AssignedAccountCount -eq 0) {
        return "Active_NotAssigned"
    }
    elseif (-not $isActive -and $AssignedAccountCount -gt 0) {
        return "Inactive_Assigned"
    }
    else {
        return "Inactive_NotAssigned"
    }
}

# ---------------- PLATFORM LINKED VALUE HELPERS ----------------
function Get-PlatformPropertyValue {
    param(
        [Parameter(Mandatory)]$PlatformDetails,
        [Parameter(Mandatory)][string[]]$PropertyNames
    )

    $props = Get-CaseInsensitiveMemberValue -InputObject $PlatformDetails -Names @('Properties','properties')
    if ($null -eq $props) { return "" }

    if ($props -is [System.Collections.IDictionary]) {
        foreach ($wanted in $PropertyNames) {
            $direct = Get-CaseInsensitiveMemberValue -InputObject $props -Names @($wanted)
            if ($null -ne $direct -and -not [string]::IsNullOrWhiteSpace([string]$direct)) {
                return [string]$direct
            }
        }
    }

    foreach ($entry in @($props)) {
        if ($null -eq $entry) { continue }

        if ($entry -is [string]) {
            $line = $entry.Trim()

            if ($line -match '^\s*([^=]+?)\s*=\s*(.*)$') {
                $key   = $matches[1].Trim()
                $value = $matches[2]

                foreach ($wanted in $PropertyNames) {
                    if ($key -ieq $wanted) {
                        return [string]$value
                    }
                }
            }

            continue
        }

        $entryName = Get-CaseInsensitiveMemberValue -InputObject $entry -Names @('Key','Name','key','name')
        if ($null -ne $entryName) {
            foreach ($wanted in $PropertyNames) {
                if ([string]$entryName -ieq $wanted) {
                    $entryValue = Get-CaseInsensitiveMemberValue -InputObject $entry -Names @('Value','value')
                    if ($null -ne $entryValue) {
                        return [string]$entryValue
                    }
                }
            }
        }
    }

    return ""
}

function Get-TextKeyValue {
    param(
        [Parameter(Mandatory)][string]$Text,
        [Parameter(Mandatory)][string]$Key
    )

    if ([string]::IsNullOrWhiteSpace($Text)) { return "" }

    $escaped = [regex]::Escape($Key)

    $patterns = @(
        "(?im)^\s*$escaped\s*=\s*(.+?)\s*$",
        "(?is)(?:Name|Key)\s*=\s*[`"']$escaped[`"'][^>]*?(?:Value|value)\s*=\s*[`"']([^`"']*)[`"']",
        "(?is)(?:Value|value)\s*=\s*[`"']([^`"']*)[`"'][^>]*?(?:Name|Key)\s*=\s*[`"']$escaped[`"']",
        "(?is)<$escaped>\s*([^<]*)\s*</$escaped>",
        "(?is)<add[^>]*\bkey\s*=\s*[`"']$escaped[`"'][^>]*\bvalue\s*=\s*[`"']([^`"']*)[`"']"
    )

    foreach ($pattern in $patterns) {
        $m = [regex]::Match($Text, $pattern)
        if ($m.Success) {
            return $m.Groups[1].Value.Trim()
        }
    }

    return ""
}

function Get-PlatformLinkedValuesFromExport {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $zipPath  = $null
    $tempRoot = $null
    $expandTo = $null

    try {
        $zipPath  = Get-PlatformExportZip -PlatformID $PlatformID
        $tempRoot = Split-Path -Path $zipPath -Parent
        $expandTo = Join-Path $tempRoot "expanded"

        Expand-Archive -LiteralPath $zipPath -DestinationPath $expandTo -Force

        $files = Get-ChildItem -Path $expandTo -Recurse -File -ErrorAction SilentlyContinue |
                 Where-Object { $_.Extension -in @('.ini', '.xml') }

        $reconcileSafe   = ""
        $reconcileFolder = ""
        $reconcileName   = ""
        $logonSafe       = ""
        $logonFolder     = ""
        $logonName       = ""

        foreach ($file in $files) {
            $raw = Get-Content -LiteralPath $file.FullName -Raw -ErrorAction SilentlyContinue
            if ([string]::IsNullOrWhiteSpace($raw)) { continue }

            if ([string]::IsNullOrWhiteSpace($reconcileSafe)) {
                $reconcileSafe = Get-TextKeyValue -Text $raw -Key 'ReconcileAccountSafe'
            }

            if ([string]::IsNullOrWhiteSpace($reconcileFolder)) {
                $reconcileFolder = Get-TextKeyValue -Text $raw -Key 'ReconcileAccountFolder'
            }

            if ([string]::IsNullOrWhiteSpace($reconcileName)) {
                $reconcileName = Get-TextKeyValue -Text $raw -Key 'ReconcileAccountName'
            }

            if ([string]::IsNullOrWhiteSpace($logonSafe)) {
                $logonSafe = Get-TextKeyValue -Text $raw -Key 'LogonAccountSafe'
            }

            if ([string]::IsNullOrWhiteSpace($logonFolder)) {
                $logonFolder = Get-TextKeyValue -Text $raw -Key 'LogonAccountFolder'
            }

            if ([string]::IsNullOrWhiteSpace($logonName)) {
                $logonName = Get-TextKeyValue -Text $raw -Key 'LogonAccountName'
            }

            $haveReconcile = (-not [string]::IsNullOrWhiteSpace($reconcileSafe) -and -not [string]::IsNullOrWhiteSpace($reconcileName))
            $haveLogon     = (-not [string]::IsNullOrWhiteSpace($logonSafe) -and -not [string]::IsNullOrWhiteSpace($logonName))

            if ($haveReconcile -and $haveLogon) {
                break
            }
        }

        return [PSCustomObject]@{
            ReconcileAccountSafe   = $reconcileSafe
            ReconcileAccountFolder = $reconcileFolder
            ReconcileAccountName   = $reconcileName
            LogonAccountSafe       = $logonSafe
            LogonAccountFolder     = $logonFolder
            LogonAccountName       = $logonName
        }
    }
    finally {
        if ($tempRoot -and (Test-Path $tempRoot)) {
            Remove-Item -LiteralPath $tempRoot -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

# ---------------- MAIN ----------------
$sessionCreated = $false

try {
    Start-PASSessionFromCCP -ObjectName $CCPObject -UPUser $ServiceUPUser
    $sessionCreated = $true

    $useActiveOnly = Read-Host "Filter Active platforms only? (yes/no)"
    $qs = ""
    if ($useActiveOnly -match '^(y|yes)$') {
        $qs = "?Active=True"
    }

    $PlatformsResponse = Get-Platforms -QueryString $qs

    try {
        $PlatformsResponse | ConvertTo-Json -Depth 10 | Out-File -LiteralPath $DebugFile -Encoding utf8
        Write-Log ("Raw platform response saved: {0}" -f $DebugFile) "Green"
    }
    catch {
        Write-Log ("Could not save raw platform JSON: {0}" -f $_.Exception.Message) "Yellow"
    }

    if ($PlatformsResponse.Platforms) {
        $platforms = $PlatformsResponse.Platforms
    }
    elseif ($PlatformsResponse.platforms) {
        $platforms = $PlatformsResponse.platforms
    }
    elseif ($PlatformsResponse.value) {
        $platforms = $PlatformsResponse.value
    }
    else {
        $platforms = @()
    }

    $platforms = @($platforms)

    if (-not $platforms -or $platforms.Count -eq 0) {
        throw ("No platforms returned. Verify permissions/filters. Check: {0}" -f $DebugFile)
    }

    Write-Log ("Platforms returned: {0}" -f $platforms.Count) "Green"

    # Pull all accounts once and group by platformId
    $accountLookupReady = $false
    $accountsByPlatform = @{}

    try {
        Write-Log "Retrieving accounts to determine platform assignment status..." "Cyan"

        $allAccounts = @(Get-AllPASAccounts -Limit $AccountPageLimit)
        Write-Log ("Accounts returned for assignment lookup: {0}" -f $allAccounts.Count) "Green"

        $accountsByPlatform = Build-AccountPlatformLookup -Accounts $allAccounts
        $accountLookupReady = $true

        Write-Log ("Platforms with at least one assigned account: {0}" -f $accountsByPlatform.Keys.Count) "Green"
    }
    catch {
        Write-Log ("WARNING: Account assignment lookup failed. Platform report will still export, but account assignment columns will show Unknown/AccountLookupFailed. Error: {0}" -f $_.Exception.Message) "Yellow"
        $accountLookupReady = $false
        $accountsByPlatform = @{}
    }

    $ProcessedPlatforms = foreach ($p in $platforms) {

        $g      = $p.general
        $props  = $p.properties
        $linked = $p.linkedAccounts
        $cred   = $p.credentialsManagement
        $sess   = $p.sessionManagement
        $wf     = $p.privilegedAccessWorkflows

        $platformId = [string]$g.id

        # Account assignment lookup
        $assignedAccounts = @()
        if ($accountLookupReady -and -not [string]::IsNullOrWhiteSpace($platformId) -and $accountsByPlatform.ContainsKey($platformId)) {
            $assignedAccounts = @($accountsByPlatform[$platformId])
        }

        $assignedAccountCount = $assignedAccounts.Count

        if ($accountLookupReady) {
            $hasAssignedAccounts = [string]($assignedAccountCount -gt 0)
            $assignedAccountSample = Format-AssignedAccountSample -Accounts $assignedAccounts -Limit $AccountSampleLimit
        }
        else {
            $hasAssignedAccounts = "Unknown"
            $assignedAccountSample = ""
        }

        $platformAssignmentStatus = Get-PlatformAssignmentStatus `
            -Active $g.active `
            -AssignedAccountCount $assignedAccountCount `
            -AccountLookupReady $accountLookupReady

        # Future-proof direct reads if CyberArk ever exposes them in summary payload
        $reconcileSafe = [string](Get-CaseInsensitiveMemberValue -InputObject $cred -Names @('ReconcileAccountSafe','reconcileAccountSafe'))
        $reconcileName = [string](Get-CaseInsensitiveMemberValue -InputObject $cred -Names @('ReconcileAccountName','reconcileAccountName'))

        $logonSafe = [string](Get-CaseInsensitiveMemberValue -InputObject $sess -Names @('LogonAccountSafe','logonAccountSafe'))
        $logonName = [string](Get-CaseInsensitiveMemberValue -InputObject $sess -Names @('LogonAccountName','logonAccountName'))

        # First attempt: Get-PlatformDetails
        if ([string]::IsNullOrWhiteSpace($reconcileSafe) -or
            [string]::IsNullOrWhiteSpace($reconcileName) -or
            [string]::IsNullOrWhiteSpace($logonSafe) -or
            [string]::IsNullOrWhiteSpace($logonName)) {
            try {
                $detail = Get-PlatformDetails -PlatformID $platformId

                if ([string]::IsNullOrWhiteSpace($reconcileSafe)) {
                    $reconcileSafe = Get-PlatformPropertyValue -PlatformDetails $detail -PropertyNames @('ReconcileAccountSafe')
                }

                if ([string]::IsNullOrWhiteSpace($reconcileName)) {
                    $reconcileName = Get-PlatformPropertyValue -PlatformDetails $detail -PropertyNames @('ReconcileAccountName')
                }

                if ([string]::IsNullOrWhiteSpace($logonSafe)) {
                    $logonSafe = Get-PlatformPropertyValue -PlatformDetails $detail -PropertyNames @('LogonAccountSafe')
                }

                if ([string]::IsNullOrWhiteSpace($logonName)) {
                    $logonName = Get-PlatformPropertyValue -PlatformDetails $detail -PropertyNames @('LogonAccountName')
                }
            }
            catch {
                Write-Log ("WARNING: Could not retrieve Get-PlatformDetails for [{0}]: {1}" -f $platformId, $_.Exception.Message) "Yellow"
            }
        }

        # Fallback: Export Platform ZIP and parse CPM INI / PVWA XML
        if ([string]::IsNullOrWhiteSpace($reconcileSafe) -or
            [string]::IsNullOrWhiteSpace($reconcileName) -or
            [string]::IsNullOrWhiteSpace($logonSafe) -or
            [string]::IsNullOrWhiteSpace($logonName)) {
            try {
                $exportVals = Get-PlatformLinkedValuesFromExport -PlatformID $platformId

                if ([string]::IsNullOrWhiteSpace($reconcileSafe)) {
                    $reconcileSafe = [string]$exportVals.ReconcileAccountSafe
                }

                if ([string]::IsNullOrWhiteSpace($reconcileName)) {
                    $reconcileName = [string]$exportVals.ReconcileAccountName
                }

                if ([string]::IsNullOrWhiteSpace($logonSafe)) {
                    $logonSafe = [string]$exportVals.LogonAccountSafe
                }

                if ([string]::IsNullOrWhiteSpace($logonName)) {
                    $logonName = [string]$exportVals.LogonAccountName
                }
            }
            catch {
                Write-Log ("WARNING: Could not export/parse platform package for [{0}]: {1}" -f $platformId, $_.Exception.Message) "Yellow"
            }
        }

        [PSCustomObject]@{
            PlatformID       = $platformId
            PlatformName     = $g.name
            Active           = $g.active

            HasAssignedAccounts    = $hasAssignedAccounts
            AssignedAccountCount   = if ($accountLookupReady) { $assignedAccountCount } else { "" }
            AssignedAccountSample  = $assignedAccountSample
            PlatformAssignmentStatus = $platformAssignmentStatus

            Description      = $g.description
            PlatformBaseID   = $g.platformBaseID
            PlatformType     = $g.platformType
            SystemType       = $g.systemType

            RequiredProperties = (Join-PropNames $props.required)
            OptionalProperties = (Join-PropNames $props.optional)

            LinkedAccounts     = (Join-Names $linked)

            AllowedSafes                          = $cred.allowedSafes
            AllowManualChange                     = [string]$cred.allowManualChange
            PerformPeriodicChange                 = [string]$cred.performPeriodicChange
            RequirePasswordChangeEveryXDays       = [string]$cred.requirePasswordChangeEveryXDays
            AllowManualVerification               = [string]$cred.allowManualVerification
            PerformPeriodicVerification           = [string]$cred.performPeriodicVerification
            RequirePasswordVerificationEveryXDays = [string]$cred.requirePasswordVerificationEveryXDays
            AllowManualReconciliation             = [string]$cred.allowManualReconciliation
            AutomaticReconcileWhenUnsynched       = [string]$cred.automaticReconcileWhenUnsynched

            ReconcileAccountSafe                  = $reconcileSafe
            ReconcileAccountName                  = $reconcileName

            LogonAccountSafe                      = $logonSafe
            LogonAccountName                      = $logonName

            RequirePrivilegedSessionMonitoringAndIsolation = [string]$sess.requirePrivilegedSessionMonitoringAndIsolation
            RecordAndSaveSessionActivity                  = [string]$sess.recordAndSaveSessionActivity
            PSMServerID                                   = [string]$sess.PSMServerID

            RequireDualControlPasswordAccessApproval = [string]$wf.requireDualControlPasswordAccessApproval
            EnforceCheckinCheckoutExclusiveAccess    = [string]$wf.enforceCheckinCheckoutExclusiveAccess
            EnforceOnetimePasswordAccess             = [string]$wf.enforceOnetimePasswordAccess
        }
    }

    $ProcessedPlatforms | Export-Csv -LiteralPath $CsvFile -NoTypeInformation -Encoding utf8
    Write-Log ("Platform report exported: {0}" -f $CsvFile) "Green"
}
catch {
    Write-Log ("ERROR: {0}" -f $_.Exception.Message) "Red"
    throw
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Log "Logged off." "Green"
        }
        catch {
            Write-Log ("Logoff warning: {0}" -f $_.Exception.Message) "Yellow"
        }
    }
}
