<#
.SYNOPSIS
    Onboards Palo Alto local accounts into CyberArk Privilege Cloud and groups HA peers.

.DESCRIPTION
    - Authenticates using CCP -> CyberArk Identity Shared Services service user,
      following the same authentication model as the supplied IND onboarding script.
    - Reads a device inventory CSV.
    - For every device, processes the two required local accounts:
          bg_caadmin
          lcl_nseo_ops
    - Onboards each account to:
          Safe:            APP_NetSecEngOps_BreakGlass
          Platform:        NET_PaloAlto
          Address:         device IP address
          Details:         device name
    - Creates one CyberArk account group PER HA pair / username:
          <BaseGroup>-bg_caadmin
          <BaseGroup>-lcl_nseo_ops
    - Uses group platform:
          PaloAltoUATGroupPlatform
    - Adds all devices sharing the same BaseGroup to the corresponding username group.
    - Existing accounts/groups/memberships are detected so the script can be re-run.
    - If an account already exists, the script does NOT change its password.
      It ensures the Details custom property and group membership.
    - If a Secret cell is blank for a new account, the script securely prompts at runtime.
    - Secrets are never written to console or result CSV.

.INPUT CSV
    Required columns:
        DeviceName,Group,Model,IPAddress,HAStatus

    Optional secret columns:
        bg_caadmin_Secret,lcl_nseo_ops_Secret

    IMPORTANT:
    Plain-text secrets in CSV are supported only for unattended onboarding.
    For better security, leave the secret cells blank and the script will prompt
    with Read-Host -AsSecureString for each NEW account.

.NOTES
    PowerShell: 5.1
    Module:     psPAS

    Group naming behavior:
        Base CSV Group: ACUFndProdUSNCssPalo
        CyberArk groups:
            ACUFndProdUSNCssPalo-bg_caadmin
            ACUFndProdUSNCssPalo-lcl_nseo_ops

    This intentionally keeps the two usernames in separate account groups so
    CyberArk does not synchronize one password across two different identities.
#>

[CmdletBinding(SupportsShouldProcess=$true)]
param(
    [Parameter()]
    [string]$CsvPath = ".\PaloAlto-HA-Onboarding.csv",

    # ===== CyberArk Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== Target account settings =====
    [string]$SafeName        = "APP_NetSecEngOps_BreakGlass",
    [string]$PlatformID      = "NET_PaloAlto",
    [string]$GroupPlatformID = "PaloAltoUATGroupPlatform",

    # ===== Accounts to onboard on every Palo Alto device =====
    [string[]]$UserNames = @(
        "bg_caadmin",
        "lcl_nseo_ops"
    ),

    # ===== CCP settings for CyberArk API service user =====
    [string]$CCPAddress     = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation    = "AIMWebService",
    [string]$CCPAppID       = "ACURestAPI",
    [string]$CCPSafe        = "ACU-VAULT-API",
    [string]$CCPObject      = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth = $false,

    # If specified, existing account properties will be corrected when needed.
    [switch]$UpdateExistingProperties,

    # If specified, a base Group with only one device is still processed.
    # Without this switch the script still processes it, but emits a warning.
    [switch]$AllowSingleMemberGroups,

    # Result file. No secrets are included.
    [string]$ResultPath = ".\PaloAlto-HA-Onboarding-Results.csv"
)

# ---------------------------------------------------------------------------
# Module / runtime
# ---------------------------------------------------------------------------
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'

function Write-Info { param([string]$Message) Write-Host "[INFO] $Message" -ForegroundColor Cyan }
function Write-Ok   { param([string]$Message) Write-Host "[ OK ] $Message" -ForegroundColor Green }
function Write-Warn { param([string]$Message) Write-Host "[WARN] $Message" -ForegroundColor Yellow }
function Write-Err  { param([string]$Message) Write-Host "[FAIL] $Message" -ForegroundColor Red }

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')
    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
            $base,
            $loc,
            [uri]::EscapeDataString($AppID),
            [uri]::EscapeDataString($Safe),
            [uri]::EscapeDataString($Object)

    Write-Info "Retrieving CyberArk API service-user credential from CCP..."
    $headers = @{ "Content-Type" = "application/json" }

    $resp = Invoke-RestMethod `
        -Uri $url `
        -Method GET `
        -Headers $headers `
        -UseDefaultCredentials:$WindowsAuth `
        -ErrorAction Stop

    if ([string]::IsNullOrWhiteSpace([string]$resp.UserName) -or
        [string]::IsNullOrWhiteSpace([string]$resp.Content)) {
        throw "CCP response did not contain UserName and Content."
    }

    Write-Ok "CCP returned service user '$($resp.UserName)'."
    $secure = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $secure)
}

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        $p = $Object.PSObject.Properties[$name]
        if ($p -and $null -ne $p.Value -and
            -not [string]::IsNullOrWhiteSpace([string]$p.Value)) {
            return $p.Value
        }
    }
    return $null
}

function Get-AccountId {
    param([Parameter(Mandatory)][object]$Account)
    return [string](Get-ObjectPropertyValue -Object $Account -Names @('id','ID','AccountID','AccountId'))
}

function Get-GroupId {
    param([Parameter(Mandatory)][object]$Group)
    return [string](Get-ObjectPropertyValue -Object $Group -Names @('GroupID','GroupId','groupID','groupId','id','ID'))
}

function Get-GroupNameValue {
    param([Parameter(Mandatory)][object]$Group)
    return [string](Get-ObjectPropertyValue -Object $Group -Names @('GroupName','groupName','Name','name'))
}

function Normalize-IP {
    param([Parameter(Mandatory)][string]$Value)

    $v = $Value.Trim()
    # Input examples can be "10.128.6.100 (DHCP)".
    if ($v -match '^(?<ip>\d{1,3}(?:\.\d{1,3}){3})') {
        return $Matches['ip']
    }
    return $v
}

function Test-IPv4 {
    param([Parameter(Mandatory)][string]$Value)

    $ip = $null
    if (-not [System.Net.IPAddress]::TryParse($Value, [ref]$ip)) {
        return $false
    }
    return $ip.AddressFamily -eq [System.Net.Sockets.AddressFamily]::InterNetwork
}

function Get-AccountExact {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address
    )

    $matches = @(Get-PASAccount -SafeName $SafeName -Search $UserName -ErrorAction Stop)

    return $matches |
        Where-Object {
            ([string]$_.UserName -ieq $UserName) -and
            ([string]$_.Address  -ieq $Address)
        } |
        Select-Object -First 1
}

function Get-OrCreateAccountGroup {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$GroupName,
        [Parameter(Mandatory)][string]$GroupPlatformID
    )

    Write-Info "Checking account group '$GroupName'..."
    $groups = @(Get-PASAccountGroup -Safe $Safe -ErrorAction Stop)

    $existing = $groups |
        Where-Object { (Get-GroupNameValue -Group $_) -ieq $GroupName } |
        Select-Object -First 1

    if ($existing) {
        $gid = Get-GroupId -Group $existing
        if ([string]::IsNullOrWhiteSpace($gid)) {
            throw "Existing group '$GroupName' was found, but its GroupID could not be resolved."
        }

        Write-Ok "Account group '$GroupName' already exists (GroupID=$gid)."
        return $existing
    }

    if ($PSCmdlet.ShouldProcess("$Safe/$GroupName", "Create account group using '$GroupPlatformID'")) {
        Write-Info "Creating account group '$GroupName'..."
        $created = New-PASAccountGroup `
            -GroupName $GroupName `
            -GroupPlatformID $GroupPlatformID `
            -Safe $Safe `
            -ErrorAction Stop

        # Some module/API combinations return little/no object data.
        # Re-query the Safe to reliably obtain GroupID.
        Start-Sleep -Milliseconds 500
        $groups = @(Get-PASAccountGroup -Safe $Safe -ErrorAction Stop)
        $created = $groups |
            Where-Object { (Get-GroupNameValue -Group $_) -ieq $GroupName } |
            Select-Object -First 1

        if (-not $created) {
            throw "Group '$GroupName' was created but could not be found during verification."
        }

        $gid = Get-GroupId -Group $created
        if ([string]::IsNullOrWhiteSpace($gid)) {
            throw "Group '$GroupName' was created but GroupID could not be resolved."
        }

        Write-Ok "Created account group '$GroupName' (GroupID=$gid)."
        return $created
    }

    return $null
}

function Ensure-AccountGroupMember {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][string]$GroupID,
        [Parameter(Mandatory)][string]$GroupName,
        [Parameter(Mandatory)][string]$AccountID,
        [Parameter(Mandatory)][string]$DisplayName
    )

    $members = @(Get-PASAccountGroupMember -GroupID $GroupID -ErrorAction Stop)

    $already = $members | Where-Object {
        $memberId = [string](Get-ObjectPropertyValue -Object $_ -Names @('AccountID','AccountId','accountID','accountId','id','ID'))
        $memberId -eq $AccountID
    } | Select-Object -First 1

    if ($already) {
        Write-Ok "'$DisplayName' is already a member of '$GroupName'."
        return 'AlreadyGrouped'
    }

    if ($PSCmdlet.ShouldProcess("$GroupName/$DisplayName", "Add account to account group")) {
        Add-PASAccountGroupMember `
            -GroupID $GroupID `
            -AccountID $AccountID `
            -ErrorAction Stop | Out-Null

        Write-Ok "Added '$DisplayName' to account group '$GroupName'."
        return 'Grouped'
    }

    return 'WhatIf'
}

function Get-SecureSecretForAccount {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$DeviceName
    )

    $column = "${UserName}_Secret"
    $prop = $Row.PSObject.Properties[$column]

    if ($prop -and -not [string]::IsNullOrWhiteSpace([string]$prop.Value)) {
        # Never log this value.
        return ConvertTo-SecureString ([string]$prop.Value) -AsPlainText -Force
    }

    Write-Warn "No secret supplied in column '$column' for NEW account '$UserName@$DeviceName'."
    return Read-Host "Enter current password for $UserName on $DeviceName" -AsSecureString
}

function Ensure-ExistingAccountProperties {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][object]$Account,
        [Parameter(Mandatory)][string]$ExpectedPlatformID,
        [Parameter(Mandatory)][string]$ExpectedAddress,
        [Parameter(Mandatory)][string]$ExpectedDetails
    )

    if (-not $UpdateExistingProperties) {
        return
    }

    $accountId = Get-AccountId -Account $Account
    if ([string]::IsNullOrWhiteSpace($accountId)) {
        throw "Cannot update existing account because its AccountID is empty."
    }

    $ops = @()

    if ([string]$Account.Address -cne $ExpectedAddress) {
        $ops += @{
            op    = 'replace'
            path  = '/address'
            value = $ExpectedAddress
        }
    }

    $currentPlatform = [string](Get-ObjectPropertyValue -Object $Account -Names @('platformId','PlatformID','platformID'))
    if ($currentPlatform -and $currentPlatform -cne $ExpectedPlatformID) {
        $ops += @{
            op    = 'replace'
            path  = '/platformId'
            value = $ExpectedPlatformID
        }
    }

    $currentDetails = $null
    if ($Account.PSObject.Properties['platformAccountProperties'] -and
        $Account.platformAccountProperties) {
        $detailsProp = $Account.platformAccountProperties.PSObject.Properties['Details']
        if ($detailsProp) {
            $currentDetails = [string]$detailsProp.Value
        }
    }

    if ($currentDetails -cne $ExpectedDetails) {
        $opName = if ($null -eq $currentDetails) { 'add' } else { 'replace' }
        $ops += @{
            op    = $opName
            path  = '/platformAccountProperties/Details'
            value = $ExpectedDetails
        }
    }

    if ($ops.Count -gt 0) {
        if ($PSCmdlet.ShouldProcess($accountId, "Update existing account properties")) {
            Set-PASAccount -AccountID $accountId -operations $ops -ErrorAction Stop | Out-Null
            Write-Ok "Updated existing account properties for AccountID=$accountId."
        }
    }
}

function Ensure-PaloAltoAccount {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string]$UserName
    )

    $device = ([string]$Row.DeviceName).Trim()
    $ip     = Normalize-IP -Value ([string]$Row.IPAddress)

    $existing = Get-AccountExact `
        -SafeName $SafeName `
        -UserName $UserName `
        -Address $ip

    if ($existing) {
        $accountId = Get-AccountId -Account $existing
        if ([string]::IsNullOrWhiteSpace($accountId)) {
            throw "Existing account '$UserName@$ip' was found but AccountID is empty."
        }

        Write-Ok "Account already exists: $UserName@$ip (AccountID=$accountId)."

        Ensure-ExistingAccountProperties `
            -Account $existing `
            -ExpectedPlatformID $PlatformID `
            -ExpectedAddress $ip `
            -ExpectedDetails $device

        return [pscustomobject]@{
            Account      = $existing
            AccountID    = $accountId
            AccountState = 'Existing'
        }
    }

    $secureSecret = Get-SecureSecretForAccount `
        -Row $Row `
        -UserName $UserName `
        -DeviceName $device

    if (-not $secureSecret) {
        throw "No secret was provided for '$UserName@$device'."
    }

    $props = @{
        Details = $device
    }

    if ($PSCmdlet.ShouldProcess("$UserName@$ip", "Onboard to Safe '$SafeName' using platform '$PlatformID'")) {
        Write-Info "Onboarding account '$UserName' on '$device' ($ip)..."

        $newAccount = Add-PASAccount `
            -SafeName $SafeName `
            -PlatformID $PlatformID `
            -Address $ip `
            -UserName $UserName `
            -secretType 'Password' `
            -secret $secureSecret `
            -platformAccountProperties $props `
            -automaticManagementEnabled $true `
            -ErrorAction Stop

        $accountId = Get-AccountId -Account $newAccount

        if ([string]::IsNullOrWhiteSpace($accountId)) {
            Start-Sleep -Seconds 1
            $newAccount = Get-AccountExact `
                -SafeName $SafeName `
                -UserName $UserName `
                -Address $ip

            if (-not $newAccount) {
                throw "Account '$UserName@$ip' was added but could not be found during verification."
            }
            $accountId = Get-AccountId -Account $newAccount
        }

        if ([string]::IsNullOrWhiteSpace($accountId)) {
            throw "Account '$UserName@$ip' was added but AccountID could not be resolved."
        }

        Write-Ok "Onboarded '$UserName@$ip' (AccountID=$accountId)."

        return [pscustomobject]@{
            Account      = $newAccount
            AccountID    = $accountId
            AccountState = 'Created'
        }
    }

    return $null
}

function Test-RequiredCommands {
    $required = @(
        'New-PASSession',
        'Close-PASSession',
        'Get-PASAccount',
        'Add-PASAccount',
        'Set-PASAccount',
        'Get-PASAccountGroup',
        'New-PASAccountGroup',
        'Get-PASAccountGroupMember',
        'Add-PASAccountGroupMember'
    )

    $missing = @()
    foreach ($cmd in $required) {
        if (-not (Get-Command $cmd -ErrorAction SilentlyContinue)) {
            $missing += $cmd
        }
    }

    if ($missing.Count -gt 0) {
        throw "The installed psPAS module is missing required commands: $($missing -join ', '). Update psPAS before running this script."
    }
}

function Test-InputRows {
    param([Parameter(Mandatory)][object[]]$Rows)

    $requiredColumns = @('DeviceName','Group','IPAddress')
    foreach ($col in $requiredColumns) {
        if (-not $Rows[0].PSObject.Properties[$col]) {
            throw "CSV is missing required column '$col'."
        }
    }

    $normalized = New-Object System.Collections.Generic.List[object]

    foreach ($row in $Rows) {
        $device = ([string]$row.DeviceName).Trim()
        $group  = ([string]$row.Group).Trim()
        $ip     = Normalize-IP -Value ([string]$row.IPAddress)

        if ([string]::IsNullOrWhiteSpace($device)) {
            throw "A CSV row has an empty DeviceName."
        }
        if ([string]::IsNullOrWhiteSpace($group)) {
            throw "Device '$device' has an empty Group."
        }
        if ([string]::IsNullOrWhiteSpace($ip) -or -not (Test-IPv4 -Value $ip)) {
            throw "Device '$device' has invalid IPv4 address '$ip'."
        }

        # Keep original row but attach normalized values.
        $row | Add-Member -NotePropertyName '_NormalizedDeviceName' -NotePropertyValue $device -Force
        $row | Add-Member -NotePropertyName '_NormalizedGroup'      -NotePropertyValue $group  -Force
        $row | Add-Member -NotePropertyName '_NormalizedIP'         -NotePropertyValue $ip     -Force
        $normalized.Add($row) | Out-Null
    }

    # Duplicate address + username would generate an ambiguous CyberArk identity.
    $duplicateIps = $normalized |
        Group-Object _NormalizedIP |
        Where-Object Count -gt 1

    if ($duplicateIps) {
        foreach ($dup in $duplicateIps) {
            $devices = ($dup.Group | ForEach-Object { $_._NormalizedDeviceName }) -join ', '
            Write-Warn "IP '$($dup.Name)' appears more than once in the CSV: $devices"
        }
    }

    return $normalized.ToArray()
}

# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------
$sessionCreated = $false
$results = New-Object System.Collections.Generic.List[object]

try {
    Test-RequiredCommands

    if (-not (Test-Path -LiteralPath $CsvPath)) {
        throw "CSV not found: $CsvPath"
    }

    Write-Info "Loading Palo Alto inventory from '$CsvPath'..."
    $rawRows = @(Import-Csv -LiteralPath $CsvPath)

    if ($rawRows.Count -eq 0) {
        throw "CSV '$CsvPath' contains no device rows."
    }

    $rows = @(Test-InputRows -Rows $rawRows)
    Write-Ok "Loaded $($rows.Count) device row(s)."

    # Validate pair structure before doing any writes.
    $baseGroups = @($rows | Group-Object _NormalizedGroup)
    foreach ($g in $baseGroups) {
        if ($g.Count -eq 1) {
            if ($AllowSingleMemberGroups) {
                Write-Warn "Base group '$($g.Name)' has one device. It will be processed because -AllowSingleMemberGroups was supplied."
            }
            else {
                Write-Warn "Base group '$($g.Name)' has one device, not an HA pair. It will still be processed; use -AllowSingleMemberGroups to explicitly acknowledge this condition."
            }
        }
        elseif ($g.Count -gt 2) {
            Write-Warn "Base group '$($g.Name)' contains $($g.Count) devices. All will be added to each username group."
        }
    }

    # Authenticate using the supplied environment pattern.
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via CyberArk Identity Shared Services..."
    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session was not established."
    }

    $sessionCreated = $true
    Write-Ok "Authenticated to '$PrivilegeCloudURL'."

    # Process by base HA group, then username.
    foreach ($baseGroup in $baseGroups) {
        $baseGroupName = $baseGroup.Name
        $deviceRows = @($baseGroup.Group)

        Write-Host ""
        Write-Host "=====================================================================" -ForegroundColor DarkCyan
        Write-Host "BASE HA GROUP: $baseGroupName   Devices=$($deviceRows.Count)" -ForegroundColor DarkCyan
        Write-Host "=====================================================================" -ForegroundColor DarkCyan

        foreach ($userName in $UserNames) {
            # Separate CyberArk group for each local identity.
            $cyberArkGroupName = "{0}-{1}" -f $baseGroupName, $userName

            try {
                $group = Get-OrCreateAccountGroup `
                    -Safe $SafeName `
                    -GroupName $cyberArkGroupName `
                    -GroupPlatformID $GroupPlatformID

                if (-not $group) {
                    throw "No account-group object was returned for '$cyberArkGroupName'."
                }

                $groupId = Get-GroupId -Group $group
                if ([string]::IsNullOrWhiteSpace($groupId)) {
                    throw "Unable to resolve GroupID for '$cyberArkGroupName'."
                }

                foreach ($row in $deviceRows) {
                    $device = $row._NormalizedDeviceName
                    $ip     = $row._NormalizedIP
                    $ha     = ([string]$row.HAStatus).Trim()

                    $status = 'FAILED'
                    $accountState = ''
                    $membershipState = ''
                    $errorText = ''

                    try {
                        $acctResult = Ensure-PaloAltoAccount `
                            -Row $row `
                            -UserName $userName

                        if (-not $acctResult) {
                            throw "Account processing returned no result."
                        }

                        $accountState = $acctResult.AccountState

                        $membershipState = Ensure-AccountGroupMember `
                            -GroupID $groupId `
                            -GroupName $cyberArkGroupName `
                            -AccountID $acctResult.AccountID `
                            -DisplayName "$userName@$device"

                        $status = 'OK'
                    }
                    catch {
                        $errorText = $_.Exception.Message
                        Write-Err "$userName@$device failed: $errorText"
                    }

                    $results.Add([pscustomobject]@{
                        DeviceName      = $device
                        IPAddress       = $ip
                        HAStatus        = $ha
                        UserName        = $userName
                        SafeName        = $SafeName
                        PlatformID      = $PlatformID
                        BaseGroup       = $baseGroupName
                        AccountGroup    = $cyberArkGroupName
                        GroupPlatformID = $GroupPlatformID
                        AccountState    = $accountState
                        MembershipState = $membershipState
                        Status          = $status
                        Error           = $errorText
                    }) | Out-Null
                }
            }
            catch {
                $groupError = $_.Exception.Message
                Write-Err "Group '$cyberArkGroupName' failed: $groupError"

                foreach ($row in $deviceRows) {
                    $results.Add([pscustomobject]@{
                        DeviceName      = $row._NormalizedDeviceName
                        IPAddress       = $row._NormalizedIP
                        HAStatus        = ([string]$row.HAStatus).Trim()
                        UserName        = $userName
                        SafeName        = $SafeName
                        PlatformID      = $PlatformID
                        BaseGroup       = $baseGroupName
                        AccountGroup    = $cyberArkGroupName
                        GroupPlatformID = $GroupPlatformID
                        AccountState    = ''
                        MembershipState = ''
                        Status          = 'FAILED'
                        Error           = $groupError
                    }) | Out-Null
                }
            }
        }
    }
}
catch {
    Write-Err $_.Exception.Message
    throw
}
finally {
    if ($results.Count -gt 0) {
        try {
            $resultDirectory = Split-Path -Parent $ResultPath
            if ($resultDirectory -and -not (Test-Path -LiteralPath $resultDirectory)) {
                New-Item -ItemType Directory -Path $resultDirectory -Force | Out-Null
            }

            $results | Export-Csv -LiteralPath $ResultPath -NoTypeInformation -Encoding UTF8
            Write-Ok "Result report written to '$ResultPath'."

            $okCount = @($results | Where-Object Status -eq 'OK').Count
            $failedCount = @($results | Where-Object Status -eq 'FAILED').Count
            Write-Host ""
            Write-Host "Summary: OK=$okCount FAILED=$failedCount TOTAL=$($results.Count)" -ForegroundColor White
        }
        catch {
            Write-Warn "Could not write result report: $($_.Exception.Message)"
        }
    }

    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "CyberArk session closed."
        }
        catch {
            Write-Warn "Session logoff warning: $($_.Exception.Message)"
        }
    }
}
