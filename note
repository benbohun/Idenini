# Import required module
Import-Module psPAS

# Define Log File
$LogFile = "CyberArk_PlatformReportLog.txt"
Function Write-Log {
    Param ([string]$Message)
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    Add-Content -Path $LogFile -Value $LogEntry
    Write-Output $LogEntry
}

# Step 1: Authenticate with CyberArk API
$IdentityTenantID = "aat4012"
$PCloudSubdomain = "cna-prod"
$ClientID = Read-Host "Enter your CyberArk API Client ID"
$ClientSecret = Read-Host "Enter your CyberArk API Client Secret" -AsSecureString
$ClientSecret = [System.Net.NetworkCredential]::new("", $ClientSecret).Password

# Authenticate
$TokenURL = "https://$IdentityTenantID.id.cyberark.cloud/oauth2/platformtoken"
$TokenBody = @{
    grant_type    = "client_credentials"
    client_id     = $ClientID
    client_secret = $ClientSecret
}
$headers = @{
    "Content-Type" = "application/x-www-form-urlencoded"
}

try {
    $TokenResponse = Invoke-RestMethod -Uri $TokenURL -Method Post -Headers $headers -Body $TokenBody
    $BearerToken = [string]$TokenResponse.access_token

    if ([string]::IsNullOrEmpty($BearerToken) -or $BearerToken.Length -lt 100) {
        Write-Log "ERROR: Received an invalid token. Exiting..."
        exit
    }
    Write-Log "Authentication successful."
} catch {
    Write-Log "ERROR: Authentication failed - $_"
    exit
}

# Define API Headers and Endpoint
$headers = @{
    "Authorization" = "Bearer $BearerToken"
    "Content-Type"  = "application/json"
}

# Define API Endpoints for All Platforms & Filtered Platforms
$AllPlatformsEndpoint = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/"
$ActivePlatformsEndpoint = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/?Active=True"

# Choose which endpoint to use
$UseFiltered = Read-Host "Do you want to filter by active platforms only? (yes/no)"
if ($UseFiltered -eq "yes") {
    $APIEndpoint = $ActivePlatformsEndpoint
    Write-Log "Fetching only active platforms..."
} else {
    $APIEndpoint = $AllPlatformsEndpoint
    Write-Log "Fetching all platforms..."
}

# Fetch Platforms
try {
    $PlatformsResponse = Invoke-RestMethod -Uri $APIEndpoint -Method Get -Headers $headers -ErrorAction Stop

    # Save Debug File
    $DebugFile = "E:\Installation Media\RemovePendingAccount\CyberArk_Platforms_Debug.json"
    $PlatformsResponse | ConvertTo-Json -Depth 3 | Out-File $DebugFile
    Write-Output "Raw API Response saved to: $DebugFile"

    # Extract platforms correctly
    if ($null -eq $PlatformsResponse.Platforms -or $PlatformsResponse.Platforms.Count -eq 0) {
        Write-Log "ERROR: No platforms found. Check API permissions."
        exit
    }

    Write-Log "Retrieved $(($PlatformsResponse.Platforms | Measure-Object).Count) platforms."
} catch {
    Write-Log "ERROR: Failed to retrieve platform list - $_"
    exit
}

# Export Path
$CsvFilePath = "E:\Installation Media\RemovePendingAccount\CyberArk_Platforms.csv"

# Process Data with Correct JSON Structure
$ProcessedPlatforms = $PlatformsResponse.Platforms | ForEach-Object {
    [PSCustomObject]@{
        PlatformID    = $_.general.id
        PlatformName  = $_.general.name
        Active        = $_.general.active
        Description   = $_.general.description
        PlatformBaseID = $_.general.platformBaseID
        PlatformType  = $_.general.platformType
        SystemType    = $_.general.systemType

        # Required Properties
        RequiredProperties = ($_.properties.required.name -join "; ")
        OptionalProperties = ($_.properties.optional.name -join "; ")

        # Linked Accounts
        LinkedAccounts = ($_.linkedAccounts.name -join "; ")

        # Credentials Management
        AllowedSafes                       = $_.credentialsManagement.allowedSafes
        AllowManualChange                  = $_.credentialsManagement.allowManualChange -as [string]
        PerformPeriodicChange              = $_.credentialsManagement.performPeriodicChange -as [string]
        RequirePasswordChangeEveryXDays    = $_.credentialsManagement.requirePasswordChangeEveryXDays -as [string]
        AllowManualVerification            = $_.credentialsManagement.allowManualVerification -as [string]
        PerformPeriodicVerification        = $_.credentialsManagement.performPeriodicVerification -as [string]
        RequirePasswordVerificationEveryXDays = $_.credentialsManagement.requirePasswordVerificationEveryXDays -as [string]
        AllowManualReconciliation          = $_.credentialsManagement.allowManualReconciliation -as [string]
        AutomaticReconcileWhenUnsynched    = $_.credentialsManagement.automaticReconcileWhenUnsynched -as [string]

        # Session Management
        RequirePrivilegedSessionMonitoringAndIsolation = $_.sessionManagement.requirePrivilegedSessionMonitoringAndIsolation -as [string]
        RecordAndSaveSessionActivity       = $_.sessionManagement.recordAndSaveSessionActivity -as [string]
        PSMServerID                        = $_.sessionManagement.PSMServerID -as [string]

        # Privileged Access Workflows
        RequireDualControlPasswordAccessApproval = $_.privilegedAccessWorkflows.requireDualControlPasswordAccessApproval -as [string]
        EnforceCheckinCheckoutExclusiveAccess    = $_.privilegedAccessWorkflows.enforceCheckinCheckoutExclusiveAccess -as [string]
        EnforceOnetimePasswordAccess             = $_.privilegedAccessWorkflows.enforceOnetimePasswordAccess -as [string]
    }
}

# Export to CSV
$ProcessedPlatforms | Export-Csv -Path $CsvFilePath -NoTypeInformation

Write-Log "✅ CyberArk platform report has been successfully exported to: $CsvFilePath"
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


# --- Allow this process to load unsigned modules & unblock psPAS files (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
  try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\data\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# --- Console "box" helper (for fallback dialog text) ---
Function Show-Box {
    param([string]$Title, [string]$BodyLine1 = "", [string]$BodyLine2 = "")
    $line = ('=' * 72)
    Write-Host $line -ForegroundColor DarkGray
    if ($Title)    { Write-Host ("[ " + $Title + " ]") -ForegroundColor Gray }
    if ($BodyLine1){ Write-Host $BodyLine1 -ForegroundColor Gray }
    if ($BodyLine2){ Write-Host $BodyLine2 -ForegroundColor Gray }
    Write-Host $line -ForegroundColor DarkGray
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
} catch {
    Write-Log ("❌ psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

# --- Try to import AD module for OU validation (non-fatal if missing) ---
$ADModuleLoaded = $false
try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $ADModuleLoaded = $true
} catch {
    Write-Log "⚠️ ActiveDirectory module not available; will still try to add group by UPN." "Yellow"
}

# --- CCP parameters (shared) ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safeCCP    = "CA_PCloud_Admins"
$headers    = @{ "Content-Type" = "application/json" }
$windowsAuth = $false

# --- Helper: start a PAS session from CCP creds using the SAME psPAS Identity method ---
Function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,   # e.g. cna.com-CA_PAMDiscovery_SVC
        [Parameter(Mandatory)] [string]$UPUser        # e.g. CA_PAMDiscovery_SVC
    )
    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log ("Retrieving CyberArk API credentials from CCP ({0}) via Object method..." -f $UPUser)
    try {
        $resp = Invoke-RestMethod $ccpUrl -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
        if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
        Write-Log ("✅ Successfully retrieved credentials for user: {0}" -f $resp.Username) "Green"
    } catch {
        Write-Log ("❌ ERROR: CCP credential fetch failed - {0}" -f $_) "Red"
        throw
    }

    try {
        Write-Log ("Requesting CyberArk PAS authentication (psPAS Identity header) as {0}..." -f $UPUser)
        $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $UPCred = [PSCredential]::new($UPUser, $UPPass)

        $header = Get-IdentityHeader `
            -IdentityTenantURL "aat4012.id.cyberark.cloud" `
            -psPASFormat `
            -PCloudSubdomain "cna-prod" `
            -UPCreds $UPCred

        Use-PASSession $header
        if (-not (Get-PASSession)) { throw "psPAS session not established" }
        Write-Log ("✅ Authentication successful, PAS session established ({0})." -f $UPUser) "Green"
    } catch {
        Write-Log ("❌ Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) "Red"
        throw
    }

    return $resp   # return CCP record (may be useful later)
}
