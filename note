<#
CNA_Create_And_Update_Identity_WebApp_Reauth_NamePrompt_DescriptionOnly.ps1

Purpose
- Prompt for regular CyberArk Identity credential once
- Prompt for Name of App to be created
- Dynamically set app Description to:
  This GCP Application is managed by Service Account ("Name of App")
- Create app from GenericBrowserExtensionScript
- Re-establish CyberArk Identity session for the update phase
- Update the newly created app using the returned _RowKey
- Apply non-script settings and the Browser Extension (advanced) login workflow
- No PAS validation
- No psPAS dependency
- Optional SWS policy replication from a reference SWS Identity app key

Why this version
- This is based on the known working version
- Only Name prompt and dynamic Description were added
- No account mapping changes
- No permission assignment changes
#>

[CmdletBinding()]
param(
    [string]$IdentityApiTenantURL      = 'https://aat4012.id.cyberark.cloud',

    [string]$RegularUserName           = '',
    [string]$RegularUserPassword       = '',

    # Create
    [string]$TemplateId                = 'GenericBrowserExtensionScript',

    # App settings
    [string]$Name                      = 'g-test-pam1',
    [string]$DisplayName               = 'GCP - Okta Prod',
    [string]$Category                  = '_I18N_AppCategory_Other',
    [string]$DefaultAuthProfile        = 'AlwaysAllowed',
    [string]$DefaultAuthProfileUuid    = 'AlwaysAllowed',
    [bool]$OnPrem                      = $true,
    [bool]$IsSwsEnabled                = $true,
    [bool]$ShowRegistration            = $false,
    [string]$AdminTag                  = '_I18N_AppCategory_Other',
    [string]$UserNameStrategy          = 'SetByUser',
    [bool]$FormFillingEnabled          = $true,
    [bool]$Generic                     = $true,
    [string]$AppType                   = 'Web',
    [string]$Description               = '_I18N_AppDesc_Generic_BE_Script',
    [string]$IconUri                   = '/vfslow/lib/application/icons/GenericBrowserExtension.svg',
    [string]$WebAppType                = 'UsernamePassword',
    [string]$TemplateName              = 'GenericBrowserExtensionScript',
    [string]$Notes                     = '',
    [bool]$LocalizationEnabled         = $false,
    [string]$WebUPAppType              = 'BrowserExtensionScript',
    [bool]$NotSelfService              = $true,

    # Advanced Browser Extension workflow
    [string]$AdvancedScript            = @'
loginData.applicationUrl = "https://cna.okta.com/login/default";
loginData.addField("username", "input#input44", LoginUsername + "@cna.com");
loginData.addField("password", "input#input77", LoginPassword);
loginData.formPattern = "form";
loginData.globalSelectorTimeout = 10000;
loginData.order = [
  ["fill", "username"],
  ["click", "input[type='submit'][value='Next']"],
  ["waitForNewPage"],
  ["sleep", 1000],
  ["fill", "password"],
  ["click", "input[type='submit'][value='Verify']"]
];
'@,


    # SWS policy replication
    # ReferenceSwsAppKey is the existing SWS/Identity app key whose policy settings should be used as the source.
    [bool]$ReplicateSwsPolicy          = $true,
    [string]$ReferenceSwsAppKey        = '3c696971-5812-430a-88b1-417c6be2628f',
    [string]$SwsAccessToken            = '',
    [string]$SwsApiBaseUrl             = 'https://api.alero.io/v2-edge',
    [string]$SwsProxyAddress           = '',
    [switch]$SwsProxyUseDefaultCredentials,
    [int]$SwsPolicyReadyWaitSeconds    = 600,
    [int]$SwsPolicyPollIntervalSeconds = 30,
    [switch]$CopySwsPolicyStatus,
    [switch]$SkipSwsDefaultSecurityLayerCopy,
    [switch]$SkipSwsApplicationConfigurationCopy,
    [switch]$WhatIfSwsCopy,
    [switch]$FailOnSwsReplicationError,

    # Timing / retries
    [int]$PreUpdateDelaySeconds        = 15,
    [int]$UpdateRetryWindowSeconds     = 300,
    [int]$RetryIntervalSeconds         = 20,
    [int]$MaxUpdateReauthAttempts      = 2,

    # Logging
    [string]$LogPath                   = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_And_Update_Reauth.log',
    [string]$ReportCsvPath             = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_And_Update_Reauth_Report.csv'
)

$script:IdentityAuthToken         = $null
$script:IdentityUser              = $null
$script:IdentityWebSession        = $null
$script:RegularCredential         = $null
$script:RegularUserPlainPassword  = $null
$script:ReportRows                = @()

$script:SwsAccessTokenToUse        = $null
$script:SwsReplicationSummary      = @()

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Add-ReportRow {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail
    )
    $script:ReportRows += [pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }
}

function ConvertTo-JsonSafe {
    param([Parameter()][object]$Object)
    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 100)
}

function Get-DirectField {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$FieldName
    )

    if ($null -eq $Object) { return $null }

    if ($Object -is [System.Collections.IDictionary]) {
        if ($Object.Contains($FieldName)) { return $Object[$FieldName] }
        return $null
    }

    if ($Object.PSObject -and $Object.PSObject.Properties.Name -contains $FieldName) {
        return $Object.$FieldName
    }

    return $null
}

function Convert-SecureStringToPlainText {
    param([Parameter(Mandatory)][SecureString]$SecureString)

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecureString)
    try {
        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    } finally {
        if ($bstr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        }
    }
}

function Get-RegularCredential {
    if ([string]::IsNullOrWhiteSpace($RegularUserName)) {
        $script:RegularCredential = Get-Credential -Message 'Enter REGULAR user credential for CyberArk Identity'
        if ($null -eq $script:RegularCredential) {
            throw 'Credential prompt was cancelled.'
        }
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $script:RegularCredential.Password
        return
    }

    if ([string]::IsNullOrWhiteSpace($RegularUserPassword)) {
        $secure = Read-Host "Enter password for $RegularUserName" -AsSecureString
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $secure
    } else {
        $secure = ConvertTo-SecureString $RegularUserPassword -AsPlainText -Force
        $script:RegularUserPlainPassword = $RegularUserPassword
    }

    $script:RegularCredential = [pscredential]::new($RegularUserName, $secure)
}

function Get-ResolvedAppNameAndDescription {
    $enteredName = Read-Host ("Enter the Name of App to be created [{0}]" -f $Name)

    if (-not [string]::IsNullOrWhiteSpace($enteredName)) {
        $script:Name = $enteredName.Trim()
    }

    if ([string]::IsNullOrWhiteSpace($script:Name)) {
        throw 'Name cannot be empty.'
    }

    $script:Description = 'This GCP Application is managed by Service Account ("{0}")' -f $script:Name

    Write-Log ("Resolved app Name: '{0}'." -f $script:Name) 'Cyan'
    Write-Log ("Resolved app Description: '{0}'." -f $script:Description) 'Cyan'

    Add-ReportRow -Step 'Resolved App Name' -Status 'INFO' -Detail ("Name={0}" -f $script:Name)
    Add-ReportRow -Step 'Resolved App Description' -Status 'INFO' -Detail ("Description={0}" -f $script:Description)
}

function Reset-IdentitySessionState {
    $script:IdentityAuthToken  = $null
    $script:IdentityUser       = $null
    $script:IdentityWebSession = $null
}

function Get-AuthPayload {
    param([Parameter(Mandatory)]$Response)

    if ($Response.PSObject -and $Response.PSObject.Properties.Name -contains 'Result' -and $null -ne $Response.Result) {
        return $Response.Result
    }

    return $Response
}

function Get-AuthSummaryValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'Summary')
}

function Get-AuthSessionId {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'SessionId')
}

function Get-AuthTokenValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'Auth')
}

function Get-AuthUserValue {
    param([Parameter(Mandatory)]$Payload)
    return [string](Get-DirectField -Object $Payload -FieldName 'User')
}

function Get-FirstMechanism {
    param([Parameter(Mandatory)]$Payload)

    $challenges = @(Get-DirectField -Object $Payload -FieldName 'Challenges')
    foreach ($challenge in $challenges) {
        $mechs = @(Get-DirectField -Object $challenge -FieldName 'Mechanisms')
        foreach ($mech in $mechs) {
            $mechId = [string](Get-DirectField -Object $mech -FieldName 'MechanismId')
            if (-not [string]::IsNullOrWhiteSpace($mechId)) {
                return $mech
            }
        }
    }

    return $null
}

function Get-MechanismPrompt {
    param([Parameter(Mandatory)]$Mechanism)

    $name   = [string](Get-DirectField -Object $Mechanism -FieldName 'Name')
    $prompt = [string](Get-DirectField -Object $Mechanism -FieldName 'PromptSelectMech')
    $type   = [string](Get-DirectField -Object $Mechanism -FieldName 'AnswerType')

    if ($name -eq 'UP' -or $prompt -match 'Password') {
        return @{
            Action = 'Answer'
            Answer = $script:RegularUserPlainPassword
        }
    }

    $display = if (-not [string]::IsNullOrWhiteSpace($prompt)) { $prompt } else { $name }
    $answer = Read-Host ("Enter response for challenge [{0}] {1}" -f $type, $display)

    return @{
        Action = 'Answer'
        Answer = $answer
    }
}

function Start-IdentityRegularUserSession {
    if ($null -eq $script:RegularCredential) {
        throw 'Regular user credential is not initialized.'
    }

    $tenantUrl = $IdentityApiTenantURL
    $userName  = $script:RegularCredential.UserName

    $baseHeaders = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    $startUri = ($tenantUrl.TrimEnd('/') + '/Security/StartAuthentication')
    $advUri   = ($tenantUrl.TrimEnd('/') + '/Security/AdvanceAuthentication')

    $script:IdentityWebSession = New-Object Microsoft.PowerShell.Commands.WebRequestSession

    Write-Log ("Starting interactive CyberArk Identity authentication for regular user '{0}'..." -f $userName) 'Cyan'

    $startBody = @{
        User    = $userName
        Version = '1.0'
    }

    $startResp = Invoke-RestMethod -Method POST -Uri $startUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body (ConvertTo-JsonSafe $startBody) -ErrorAction Stop
    $payload = Get-AuthPayload -Response $startResp

    for ($i = 0; $i -lt 10; $i++) {
        $summary = Get-AuthSummaryValue -Payload $payload
        $authVal = Get-AuthTokenValue -Payload $payload

        if ($summary -eq 'LoginSuccess' -or -not [string]::IsNullOrWhiteSpace($authVal)) {
            $script:IdentityAuthToken = $authVal
            $script:IdentityUser      = Get-AuthUserValue -Payload $payload

            $cookieCount = 0
            try { $cookieCount = $script:IdentityWebSession.Cookies.GetCookies($tenantUrl).Count } catch {}

            Write-Log ("Identity API authentication succeeded as '{0}'. CookieCount={1}" -f $script:IdentityUser, $cookieCount) 'Green'
            Add-ReportRow -Step 'Identity Login' -Status 'SUCCESS' -Detail ("Authenticated as {0}; CookieCount={1}" -f $script:IdentityUser, $cookieCount)
            return
        }

        $sessionId = Get-AuthSessionId -Payload $payload
        if ([string]::IsNullOrWhiteSpace($sessionId)) {
            throw 'Authentication package did not include SessionId.'
        }

        $mechanism = Get-FirstMechanism -Payload $payload
        if ($null -eq $mechanism) {
            throw 'No supported authentication mechanism was returned.'
        }

        $mechId = [string](Get-DirectField -Object $mechanism -FieldName 'MechanismId')
        $name   = [string](Get-DirectField -Object $mechanism -FieldName 'Name')
        $prompt = [string](Get-DirectField -Object $mechanism -FieldName 'PromptSelectMech')

        Write-Log ("Responding to Identity challenge. Mechanism='{0}' Prompt='{1}'." -f $name, $prompt) 'Gray'

        $response = Get-MechanismPrompt -Mechanism $mechanism

        $advBody = @{
            SessionId   = $sessionId
            MechanismId = $mechId
            Action      = $response.Action
            Answer      = $response.Answer
        }

        $advResp = Invoke-RestMethod -Method POST -Uri $advUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body (ConvertTo-JsonSafe $advBody) -ErrorAction Stop
        $payload = Get-AuthPayload -Response $advResp
    }

    throw 'Interactive Identity authentication did not complete after multiple challenge rounds.'
}

function Invoke-IdentityRequestRaw {
    param(
        [Parameter(Mandatory)][string]$AbsoluteUri,
        [Parameter()][object]$Body,
        [ValidateSet('BearerCookie','CookieOnly','BearerOnly')][string]$AuthMode = 'BearerCookie'
    )

    $headers = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Accept'               = 'application/json'
        'Content-Type'         = 'application/json'
    }

    if ($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'BearerOnly') {
        if ([string]::IsNullOrWhiteSpace($script:IdentityAuthToken)) {
            throw 'Identity auth token is not initialized.'
        }
        $headers['Authorization'] = ("Bearer {0}" -f $script:IdentityAuthToken)
    }

    $invokeParams = @{
        Method      = 'POST'
        Uri         = $AbsoluteUri
        Headers     = $headers
        ContentType = 'application/json'
        ErrorAction = 'Stop'
    }

    $json = ConvertTo-JsonSafe -Object $Body
    if ($null -ne $json) { $invokeParams['Body'] = $json }

    if (($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'CookieOnly') -and $null -ne $script:IdentityWebSession) {
        $invokeParams['WebSession'] = $script:IdentityWebSession
    }

    return Invoke-RestMethod @invokeParams
}

function Invoke-IdentityRequestWithRetry {
    param(
        [Parameter(Mandatory)][string[]]$AbsoluteUris,
        [Parameter()][object]$Body,
        [string]$LogicalName = 'Identity API call'
    )

    $authModes = @('BearerCookie','CookieOnly','BearerOnly')
    $errors = @()

    foreach ($uri in $AbsoluteUris) {
        foreach ($mode in $authModes) {
            try {
                Write-Log ("Trying {0} via URI '{1}' using auth mode '{2}'..." -f $LogicalName, $uri, $mode) 'Gray'
                $resp = Invoke-IdentityRequestRaw -AbsoluteUri $uri -Body $Body -AuthMode $mode
                Write-Log ("Succeeded: {0} via URI '{1}' using auth mode '{2}'." -f $LogicalName, $uri, $mode) 'Gray'
                return $resp
            } catch {
                $status = $null
                try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
                $msg = $_.Exception.Message
                $errors += ("URI={0}; Mode={1}; Status={2}; Error={3}" -f $uri, $mode, $status, $msg)

                if ($status -eq 401) {
                    Write-Log ("401 on {0} via URI '{1}' using auth mode '{2}'. Retrying..." -f $LogicalName, $uri, $mode) 'Yellow'
                    continue
                }

                throw
            }
        }
    }

    throw ("Unauthorized persisted for {0}. Details: {1}" -f $LogicalName, ($errors -join ' || '))
}

function Import-AppFromTemplate {
    param([Parameter(Mandatory)][string]$ResolvedTemplateId)

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/ImportAppFromTemplate'
    $body = @{ ID = @($ResolvedTemplateId) }

    $resp = Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'ImportAppFromTemplate'
    if (-not $resp.success) {
        throw ('ImportAppFromTemplate returned success=false: ' + ($resp.Message | Out-String))
    }

    $resultItems = @($resp.Result)
    if ($resultItems.Count -lt 1) {
        throw 'ImportAppFromTemplate returned no result items.'
    }

    $first = $resultItems[0]
    $created = Get-DirectField -Object $first -FieldName 'success'
    if ($created -ne $true) {
        $idVal = [string](Get-DirectField -Object $first -FieldName 'ID')
        $msg = [string](Get-DirectField -Object $first -FieldName 'Message')
        throw ("ImportAppFromTemplate result item failed. ID={0}; Message={1}" -f $idVal, $msg)
    }

    $rowKey = [string](Get-DirectField -Object $first -FieldName '_RowKey')
    if ([string]::IsNullOrWhiteSpace($rowKey)) {
        $rowKey = [string](Get-DirectField -Object $first -FieldName '_Rowkey')
    }

    if ([string]::IsNullOrWhiteSpace($rowKey)) {
        throw 'ImportAppFromTemplate did not return _RowKey.'
    }

    Write-Log ("Imported new application from template '{0}'. New _RowKey='{1}'." -f $ResolvedTemplateId, $rowKey) 'Green'
    Add-ReportRow -Step 'Create Application' -Status 'SUCCESS' -Detail ("TemplateID={0}; RowKey={1}" -f $ResolvedTemplateId, $rowKey)
    return $rowKey
}

function New-BaseNonScriptFields {
    param([Parameter(Mandatory)][string]$ResolvedRowKey)

    $authRules = @{
        _UniqueKey = 'Condition'
        _Value     = @()
        Enabled    = $true
        _Type      = 'RowSet'
    }

    $defaultAuthProfileInfo = @{
        Uuid = $DefaultAuthProfileUuid
    }

    return [ordered]@{
        _Rowkey                = $ResolvedRowKey
        Name                   = $Name
        DisplayName            = $DisplayName
        Category               = $Category
        DefaultAuthProfileInfo = $defaultAuthProfileInfo
        OnPrem                 = $OnPrem
        IsSwsEnabled           = $IsSwsEnabled
        ShowRegistration       = $ShowRegistration
        AdminTag               = $AdminTag
        UserNameStrategy       = $UserNameStrategy
        Description            = $Description
        FormFillingEnabled     = $FormFillingEnabled
        Generic                = $Generic
        AppType                = $AppType
        DefaultAuthProfile     = $DefaultAuthProfile
        IconUri                = $IconUri
        AuthRules              = $authRules
        WebAppType             = $WebAppType
        TemplateName           = $TemplateName
        Notes                  = $Notes
        LocalizationEnabled    = $LocalizationEnabled
        WebUPAppType           = $WebUPAppType
        NotSelfService         = $NotSelfService
    }
}

function New-AdvancedScriptPayloadVariants {
    param([Parameter(Mandatory)][string]$ResolvedRowKey)

    $base = New-BaseNonScriptFields -ResolvedRowKey $ResolvedRowKey
    $variants = @()

    $v1 = [ordered]@{}
    foreach ($k in $base.Keys) { $v1[$k] = $base[$k] }
    $v1['Script'] = $AdvancedScript
    $variants += ,$v1

    $v2 = [ordered]@{}
    foreach ($k in $v1.Keys) {
        if ($k -eq '_Rowkey') { $v2['_RowKey'] = $v1[$k] } else { $v2[$k] = $v1[$k] }
    }
    $variants += ,$v2

    $v3 = [ordered]@{
        _Rowkey             = $ResolvedRowKey
        Name                = $Name
        DisplayName         = $DisplayName
        Description         = $Description
        IconUri             = $IconUri
        IsSwsEnabled        = $IsSwsEnabled
        UserNameStrategy    = $UserNameStrategy
        FormFillingEnabled  = $FormFillingEnabled
        AppType             = $AppType
        WebAppType          = $WebAppType
        WebUPAppType        = $WebUPAppType
        TemplateName        = $TemplateName
        DefaultAuthProfile  = $DefaultAuthProfile
        Script              = $AdvancedScript
    }
    $variants += ,$v3

    $v4 = [ordered]@{}
    foreach ($k in $v3.Keys) {
        if ($k -eq '_Rowkey') { $v4['_RowKey'] = $v3[$k] } else { $v4[$k] = $v3[$k] }
    }
    $variants += ,$v4

    $v5 = [ordered]@{}
    foreach ($k in $base.Keys) { $v5[$k] = $base[$k] }
    $v5['CBEScript'] = $AdvancedScript
    $variants += ,$v5

    $v6 = [ordered]@{}
    foreach ($k in $v5.Keys) {
        if ($k -eq '_Rowkey') { $v6['_RowKey'] = $v5[$k] } else { $v6[$k] = $v5[$k] }
    }
    $variants += ,$v6

    $v7 = [ordered]@{
        _Rowkey     = $ResolvedRowKey
        Name        = $Name
        Description = $Description
        Script      = $AdvancedScript
    }
    $variants += ,$v7

    $v8 = [ordered]@{
        _Rowkey     = $ResolvedRowKey
        Name        = $Name
        Description = $Description
        CBEScript   = $AdvancedScript
    }
    $variants += ,$v8

    return $variants
}

function Update-CurrentApplicationWithAdvancedScript {
    param([Parameter(Mandatory)][string]$ResolvedRowKey)

    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/UpdateApplicationDE'
    $variants = New-AdvancedScriptPayloadVariants -ResolvedRowKey $ResolvedRowKey

    $variantNumber = 0
    foreach ($payload in $variants) {
        $variantNumber++
        try {
            Write-Log ("Trying UpdateApplicationDE advanced-script payload variant #{0}..." -f $variantNumber) 'Gray'
            $resp = Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $payload -LogicalName 'UpdateApplicationDE'

            $success = Get-DirectField -Object $resp -FieldName 'success'
            if ($success -ne $true) {
                $msg = [string](Get-DirectField -Object $resp -FieldName 'Message')
                throw ("UpdateApplicationDE returned success=false. Message={0}" -f $msg)
            }

            Write-Log ("UpdateApplicationDE succeeded on advanced-script payload variant #{0}." -f $variantNumber) 'Green'
            Add-ReportRow -Step 'Update Application' -Status 'SUCCESS' -Detail ("RowKey={0}; Variant={1}" -f $ResolvedRowKey, $variantNumber)
            return
        } catch {
            Write-Log ("Advanced-script payload variant #{0} failed: {1}" -f $variantNumber, $_.Exception.Message) 'Yellow'
        }
    }

    throw 'All UpdateApplicationDE advanced-script payload variants failed.'
}

function Invoke-EventuallyConsistentStep {
    param(
        [Parameter(Mandatory)][scriptblock]$Operation,
        [Parameter(Mandatory)][string]$OperationName,
        [Parameter(Mandatory)][int]$MaxWaitSeconds,
        [int]$IntervalSeconds = 15
    )

    $deadline = (Get-Date).AddSeconds($MaxWaitSeconds)
    $attempt = 0
    $lastMessage = $null

    while ((Get-Date) -lt $deadline) {
        $attempt++
        try {
            Write-Log ("{0} attempt #{1}..." -f $OperationName, $attempt) 'Gray'
            & $Operation
            Write-Log ("{0} succeeded on attempt #{1}." -f $OperationName, $attempt) 'Green'
            return
        } catch {
            $lastMessage = $_.Exception.Message
            Write-Log ("{0} not ready yet on attempt #{1}. Retrying in {2}s. Remaining window: {3}s. Last error: {4}" -f $OperationName, $attempt, $IntervalSeconds, [int][Math]::Max(0, ($deadline - (Get-Date)).TotalSeconds), $lastMessage) 'Yellow'
            Start-Sleep -Seconds $IntervalSeconds
        }
    }

    throw ("{0} did not succeed within {1} seconds. Last error: {2}" -f $OperationName, $MaxWaitSeconds, $lastMessage)
}

function Invoke-PostCreateUpdatePhase {
    param([Parameter(Mandatory)][string]$CreatedRowKey)

    $attempt = 0
    while ($attempt -lt $MaxUpdateReauthAttempts) {
        $attempt++
        try {
            Write-Log ("Starting post-create update phase with fresh Identity session (attempt {0}/{1})..." -f $attempt, $MaxUpdateReauthAttempts) 'Cyan'
            Reset-IdentitySessionState
            Start-IdentityRegularUserSession

            Invoke-EventuallyConsistentStep `
                -Operation {
                    Update-CurrentApplicationWithAdvancedScript -ResolvedRowKey $CreatedRowKey
                } `
                -OperationName 'Post-Create UpdateApplicationDE' `
                -MaxWaitSeconds $UpdateRetryWindowSeconds `
                -IntervalSeconds $RetryIntervalSeconds

            return
        } catch {
            $msg = $_.Exception.Message
            Write-Log ("Post-create update phase attempt {0} failed: {1}" -f $attempt, $msg) 'Yellow'

            if ($attempt -ge $MaxUpdateReauthAttempts) {
                throw
            }

            Write-Log "Re-establishing Identity session and retrying update phase..." 'Yellow'
            Start-Sleep -Seconds $RetryIntervalSeconds
        }
    }
}


function Add-SwsReplicationSummary {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail
    )

    $script:SwsReplicationSummary += [pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }

    Add-ReportRow -Step ("SWS - {0}" -f $Step) -Status $Status -Detail $Detail
}

function Join-UrlPath {
    param(
        [Parameter(Mandatory)][string]$BaseUrl,
        [Parameter(Mandatory)][string]$RelativePath
    )

    return ($BaseUrl.TrimEnd('/') + '/' + $RelativePath.TrimStart('/'))
}

function ConvertTo-CompressedJson {
    param([Parameter()]$Object)
    if ($null -eq $Object) { return '' }
    try { return ($Object | ConvertTo-Json -Depth 100 -Compress) } catch { return [string]$Object }
}

function Get-DirectPropertyValue {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string[]]$PropertyNames
    )

    if ($null -eq $Object) { return $null }

    foreach ($name in $PropertyNames) {
        if ($Object -is [System.Collections.IDictionary]) {
            if ($Object.Contains($name)) { return $Object[$name] }
        } elseif ($Object.PSObject -and $Object.PSObject.Properties.Name -contains $name) {
            return $Object.$name
        }
    }

    return $null
}

function Get-SwsObjectArrayCandidate {
    param([Parameter()]$Object)

    if ($null -eq $Object) { return @() }

    if ($Object -is [System.Array]) { return @($Object) }

    if (($Object -is [System.Collections.IEnumerable]) -and -not ($Object -is [string]) -and -not ($Object.PSObject.Properties.Name.Count -gt 0)) {
        return @($Object)
    }

    $candidateNames = @('policies','items','data','result','results','content','value','applications')
    foreach ($name in $candidateNames) {
        $value = Get-DirectPropertyValue -Object $Object -PropertyNames @($name)
        if ($null -ne $value) {
            if ($value -is [System.Array]) { return @($value) }
            if (($value -is [System.Collections.IEnumerable]) -and -not ($value -is [string])) { return @($value) }
            return @($value)
        }
    }

    return @($Object)
}

function Get-SwsPolicyId {
    param([Parameter()]$Policy)

    $id = Get-DirectPropertyValue -Object $Policy -PropertyNames @('id','policyId','policyID','policy_id','uuid','policyUuid','policyUUID','_id')
    if ($null -ne $id -and -not [string]::IsNullOrWhiteSpace([string]$id)) {
        return [string]$id
    }

    return $null
}

function Get-SwsPolicyName {
    param([Parameter()]$Policy)

    $name = Get-DirectPropertyValue -Object $Policy -PropertyNames @('name','policyName','displayName','title','applicationName','appName')
    if ($null -ne $name -and -not [string]::IsNullOrWhiteSpace([string]$name)) {
        return [string]$name
    }

    return '<unknown>'
}

function Get-NestedPropertyValueByName {
    param(
        [Parameter()]$Object,
        [Parameter(Mandatory)][string[]]$PropertyNames,
        [int]$MaxDepth = 8
    )

    if ($null -eq $Object) { return $null }

    $queue = New-Object System.Collections.Queue
    $queue.Enqueue([pscustomobject]@{ Value = $Object; Depth = 0 })

    while ($queue.Count -gt 0) {
        $entry = $queue.Dequeue()
        $current = $entry.Value
        $depth = [int]$entry.Depth

        if ($null -eq $current -or $depth -gt $MaxDepth) { continue }

        foreach ($name in $PropertyNames) {
            $direct = Get-DirectPropertyValue -Object $current -PropertyNames @($name)
            if ($null -ne $direct) { return $direct }
        }

        if ($current -is [System.Collections.IDictionary]) {
            foreach ($k in $current.Keys) {
                $v = $current[$k]
                if ($null -ne $v -and -not ($v -is [string]) -and (($v -is [System.Collections.IEnumerable]) -or ($v.PSObject.Properties.Name.Count -gt 0))) {
                    $queue.Enqueue([pscustomobject]@{ Value = $v; Depth = ($depth + 1) })
                }
            }
        } elseif (($current -is [System.Collections.IEnumerable]) -and -not ($current -is [string])) {
            foreach ($item in $current) {
                if ($null -ne $item) {
                    $queue.Enqueue([pscustomobject]@{ Value = $item; Depth = ($depth + 1) })
                }
            }
        } elseif ($current.PSObject) {
            foreach ($prop in $current.PSObject.Properties) {
                $v = $prop.Value
                if ($null -ne $v -and -not ($v -is [string]) -and (($v -is [System.Collections.IEnumerable]) -or ($v.PSObject.Properties.Name.Count -gt 0))) {
                    $queue.Enqueue([pscustomobject]@{ Value = $v; Depth = ($depth + 1) })
                }
            }
        }
    }

    return $null
}

function Copy-ObjectJsonRoundTrip {
    param([Parameter()]$Object)

    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 100 | ConvertFrom-Json)
}

function Remove-SwsSourceAppKeyProperties {
    param([Parameter()]$Object)

    if ($null -eq $Object) { return }

    $unsafeNamePattern = '^(appKey|applicationKey|identityAppKey|identityApplicationKey|identityApplicationId|idpAppKey|idpApplicationKey|sourceAppKey|sourceApplicationKey)$'

    if ($Object -is [System.Collections.IDictionary]) {
        $keys = @($Object.Keys)
        foreach ($k in $keys) {
            if ([string]$k -match $unsafeNamePattern) {
                $Object.Remove($k)
            } else {
                Remove-SwsSourceAppKeyProperties -Object $Object[$k]
            }
        }
    } elseif (($Object -is [System.Collections.IEnumerable]) -and -not ($Object -is [string])) {
        foreach ($item in $Object) { Remove-SwsSourceAppKeyProperties -Object $item }
    } elseif ($Object.PSObject) {
        $props = @($Object.PSObject.Properties)
        foreach ($prop in $props) {
            if ($prop.Name -match $unsafeNamePattern) {
                try { $Object.PSObject.Properties.Remove($prop.Name) } catch {}
            } else {
                Remove-SwsSourceAppKeyProperties -Object $prop.Value
            }
        }
    }
}

function Initialize-SwsAccessToken {
    if (-not [string]::IsNullOrWhiteSpace($script:SwsAccessTokenToUse)) { return }

    if (-not [string]::IsNullOrWhiteSpace($SwsAccessToken)) {
        $script:SwsAccessTokenToUse = $SwsAccessToken
        return
    }

    $secureToken = Read-Host 'Enter SWS API Bearer access token from your SWS service account' -AsSecureString
    $script:SwsAccessTokenToUse = Convert-SecureStringToPlainText -SecureString $secureToken

    if ([string]::IsNullOrWhiteSpace($script:SwsAccessTokenToUse)) {
        throw 'SWS access token is empty. Provide -SwsAccessToken or paste a token when prompted.'
    }
}

function Invoke-SwsApiRequest {
    param(
        [Parameter(Mandatory)][ValidateSet('GET','POST','PUT','DELETE')][string]$Method,
        [Parameter(Mandatory)][string]$RelativePath,
        [Parameter()]$Body
    )

    Initialize-SwsAccessToken

    $uri = Join-UrlPath -BaseUrl $SwsApiBaseUrl -RelativePath $RelativePath
    $headers = @{
        Authorization = ('Bearer {0}' -f $script:SwsAccessTokenToUse)
        Accept        = 'application/json'
        'Content-Type'= 'application/json'
    }

    $params = @{
        Method      = $Method
        Uri         = $uri
        Headers     = $headers
        ErrorAction = 'Stop'
    }

    if ($null -ne $Body) {
        $params['ContentType'] = 'application/json'
        $params['Body'] = ($Body | ConvertTo-Json -Depth 100)
    }

    if (-not [string]::IsNullOrWhiteSpace($SwsProxyAddress)) {
        $params['Proxy'] = $SwsProxyAddress
        if ($SwsProxyUseDefaultCredentials.IsPresent) { $params['ProxyUseDefaultCredentials'] = $true }
    }

    try {
        return Invoke-RestMethod @params
    } catch {
        $status = $null
        $responseBody = ''
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        try {
            $stream = $_.Exception.Response.GetResponseStream()
            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)
                $responseBody = $reader.ReadToEnd()
            }
        } catch {}

        if ([string]::IsNullOrWhiteSpace($responseBody)) { $responseBody = $_.Exception.Message }
        throw ("SWS API call failed. Method={0}; Uri={1}; Status={2}; Error={3}" -f $Method, $uri, $status, $responseBody)
    }
}

function Get-SwsPolicies {
    return Invoke-SwsApiRequest -Method GET -RelativePath '/sws/policies'
}

function Get-SwsPolicyById {
    param([Parameter(Mandatory)][string]$PolicyId)

    $paths = @(
        ("/sws/policies/{0}?includeSecurityLayers=true&includeMembers=true&includeApplicationConfiguration=true" -f [uri]::EscapeDataString($PolicyId)),
        ("/sws/policies/{0}?securityLayers=true&members=true&applicationConfiguration=true" -f [uri]::EscapeDataString($PolicyId)),
        ("/sws/policies/{0}" -f [uri]::EscapeDataString($PolicyId))
    )

    $lastError = $null
    foreach ($path in $paths) {
        try { return Invoke-SwsApiRequest -Method GET -RelativePath $path } catch { $lastError = $_.Exception.Message }
    }

    throw $lastError
}

function Find-SwsPolicyByTextOnce {
    param(
        [Parameter(Mandatory)][string[]]$SearchTexts,
        [switch]$FetchDetails
    )

    $cleanSearchTexts = @($SearchTexts | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    if ($cleanSearchTexts.Count -eq 0) { throw 'No search text was provided for SWS policy lookup.' }

    $policyListResponse = Get-SwsPolicies
    $policyItems = @(Get-SwsObjectArrayCandidate -Object $policyListResponse)

    foreach ($item in $policyItems) {
        $policyId = Get-SwsPolicyId -Policy $item
        $policyToSearch = $item

        if ($FetchDetails.IsPresent -and -not [string]::IsNullOrWhiteSpace($policyId)) {
            try { $policyToSearch = Get-SwsPolicyById -PolicyId $policyId } catch {}
        }

        $json = ConvertTo-CompressedJson -Object $policyToSearch
        foreach ($text in $cleanSearchTexts) {
            if ($json -match [regex]::Escape($text)) {
                if ([string]::IsNullOrWhiteSpace($policyId)) { $policyId = Get-SwsPolicyId -Policy $policyToSearch }
                return [pscustomobject]@{
                    PolicyId    = $policyId
                    Policy      = $policyToSearch
                    MatchedText = $text
                    Name        = Get-SwsPolicyName -Policy $policyToSearch
                }
            }
        }
    }

    if (-not $FetchDetails.IsPresent) {
        return Find-SwsPolicyByTextOnce -SearchTexts $cleanSearchTexts -FetchDetails
    }

    return $null
}

function Wait-SwsPolicyByText {
    param(
        [Parameter(Mandatory)][string[]]$SearchTexts,
        [Parameter(Mandatory)][string]$Purpose,
        [int]$MaxWaitSeconds = 300,
        [int]$PollIntervalSeconds = 30
    )

    $deadline = (Get-Date).AddSeconds($MaxWaitSeconds)
    $attempt = 0
    $lastError = $null

    while ((Get-Date) -lt $deadline) {
        $attempt++
        try {
            Write-Log ("SWS lookup for {0}, attempt #{1}..." -f $Purpose, $attempt) 'Gray'
            $match = Find-SwsPolicyByTextOnce -SearchTexts $SearchTexts
            if ($null -ne $match) {
                Write-Log ("SWS lookup for {0} succeeded. PolicyId={1}; Name={2}; MatchedText={3}" -f $Purpose, $match.PolicyId, $match.Name, $match.MatchedText) 'Green'
                return $match
            }
        } catch {
            $lastError = $_.Exception.Message
            Write-Log ("SWS lookup for {0} failed on attempt #{1}: {2}" -f $Purpose, $attempt, $lastError) 'Yellow'
        }

        Start-Sleep -Seconds $PollIntervalSeconds
    }

    if ([string]::IsNullOrWhiteSpace($lastError)) { $lastError = 'No matching SWS policy was found before timeout.' }
    throw ("SWS lookup for {0} did not complete within {1} seconds. Last error: {2}" -f $Purpose, $MaxWaitSeconds, $lastError)
}

function Invoke-SwsPutIfPayloadExists {
    param(
        [Parameter(Mandatory)][string]$TargetPolicyId,
        [Parameter(Mandatory)][string]$RelativePath,
        [Parameter(Mandatory)][string]$SectionName,
        [Parameter()]$Payload
    )

    if ($null -eq $Payload) {
        Write-Log ("Skipping SWS {0}; source payload section was not found." -f $SectionName) 'Yellow'
        Add-SwsReplicationSummary -Step $SectionName -Status 'SKIPPED' -Detail 'Source payload section was not found.'
        return
    }

    if ($WhatIfSwsCopy.IsPresent) {
        Write-Log ("WHATIF: Would update SWS {0} on target policy {1}." -f $SectionName, $TargetPolicyId) 'Yellow'
        Add-SwsReplicationSummary -Step $SectionName -Status 'WHATIF' -Detail ("TargetPolicyId={0}; Payload={1}" -f $TargetPolicyId, (ConvertTo-CompressedJson -Object $Payload))
        return
    }

    try {
        $null = Invoke-SwsApiRequest -Method PUT -RelativePath $RelativePath -Body $Payload
        Write-Log ("Updated SWS {0} on target policy {1}." -f $SectionName, $TargetPolicyId) 'Green'
        Add-SwsReplicationSummary -Step $SectionName -Status 'SUCCESS' -Detail ("TargetPolicyId={0}" -f $TargetPolicyId)
    } catch {
        Write-Log ("Failed to update SWS {0} on target policy {1}: {2}" -f $SectionName, $TargetPolicyId, $_.Exception.Message) 'Yellow'
        Add-SwsReplicationSummary -Step $SectionName -Status 'FAILED' -Detail $_.Exception.Message
        if ($FailOnSwsReplicationError.IsPresent) { throw }
    }
}

function Copy-SwsReferencePolicyToTarget {
    param(
        [Parameter(Mandatory)]$SourcePolicyMatch,
        [Parameter(Mandatory)]$TargetPolicyMatch
    )

    $sourcePolicyId = $SourcePolicyMatch.PolicyId
    $targetPolicyId = $TargetPolicyMatch.PolicyId

    if ([string]::IsNullOrWhiteSpace($sourcePolicyId)) { throw 'Source SWS policy ID could not be resolved.' }
    if ([string]::IsNullOrWhiteSpace($targetPolicyId)) { throw 'Target SWS policy ID could not be resolved.' }

    Write-Log ("Preparing to copy SWS policy settings from source PolicyId={0} to target PolicyId={1}." -f $sourcePolicyId, $targetPolicyId) 'Cyan'

    $sourceDetails = Get-SwsPolicyById -PolicyId $sourcePolicyId

    if ($CopySwsPolicyStatus.IsPresent) {
        $status = Get-NestedPropertyValueByName -Object $sourceDetails -PropertyNames @('status','enabled','active','state') -MaxDepth 3
        if ($null -ne $status) {
            $statusPayload = $null
            $sourceStatusDirectName = $null
            foreach ($candidate in @('status','enabled','active','state')) {
                $direct = Get-DirectPropertyValue -Object $sourceDetails -PropertyNames @($candidate)
                if ($null -ne $direct) { $sourceStatusDirectName = $candidate; break }
            }
            if ([string]::IsNullOrWhiteSpace($sourceStatusDirectName)) { $sourceStatusDirectName = 'status' }
            $statusPayload = @{}
            $statusPayload[$sourceStatusDirectName] = $status

            Invoke-SwsPutIfPayloadExists `
                -TargetPolicyId $targetPolicyId `
                -RelativePath ("/sws/policies/{0}" -f [uri]::EscapeDataString($targetPolicyId)) `
                -SectionName 'Policy Status' `
                -Payload $statusPayload
        } else {
            Write-Log 'Skipping SWS policy status; source status field was not found.' 'Yellow'
            Add-SwsReplicationSummary -Step 'Policy Status' -Status 'SKIPPED' -Detail 'Source status field was not found.'
        }
    }

    if (-not $SkipSwsDefaultSecurityLayerCopy.IsPresent) {
        $defaultLayers = Get-NestedPropertyValueByName -Object $sourceDetails -PropertyNames @('defaultSecurityLayers','default_security_layers','defaultLayers','default_security_layers_settings','securityLayersDefault') -MaxDepth 5
        $defaultLayersPayload = Copy-ObjectJsonRoundTrip -Object $defaultLayers

        Invoke-SwsPutIfPayloadExists `
            -TargetPolicyId $targetPolicyId `
            -RelativePath ("/sws/policies/{0}/default-security-layers" -f [uri]::EscapeDataString($targetPolicyId)) `
            -SectionName 'Default Security Layers' `
            -Payload $defaultLayersPayload
    }

    if (-not $SkipSwsApplicationConfigurationCopy.IsPresent) {
        $appConfig = Get-NestedPropertyValueByName -Object $sourceDetails -PropertyNames @('applicationConfiguration','application_configuration','applicationConfig','appConfiguration','configuration') -MaxDepth 5
        $appConfigPayload = Copy-ObjectJsonRoundTrip -Object $appConfig
        Remove-SwsSourceAppKeyProperties -Object $appConfigPayload

        Invoke-SwsPutIfPayloadExists `
            -TargetPolicyId $targetPolicyId `
            -RelativePath ("/sws/policies/{0}/configuration" -f [uri]::EscapeDataString($targetPolicyId)) `
            -SectionName 'Application Configuration' `
            -Payload $appConfigPayload
    }
}

function Invoke-SwsPolicyReplicationForCreatedApp {
    param([Parameter(Mandatory)][string]$CreatedAppRowKey)

    if (-not $ReplicateSwsPolicy) {
        Write-Log 'SWS policy replication is disabled.' 'Gray'
        return
    }

    if ([string]::IsNullOrWhiteSpace($ReferenceSwsAppKey)) {
        throw 'ReferenceSwsAppKey is empty. Provide the existing SWS app key to use as the policy reference.'
    }

    Write-Log ("Starting SWS policy replication. ReferenceSwsAppKey={0}" -f $ReferenceSwsAppKey) 'Cyan'
    Add-SwsReplicationSummary -Step 'Start' -Status 'INFO' -Detail ("ReferenceSwsAppKey={0}; CreatedRowKey={1}; Name={2}; DisplayName={3}" -f $ReferenceSwsAppKey, $CreatedAppRowKey, $Name, $DisplayName)

    $sourceMatch = Wait-SwsPolicyByText `
        -SearchTexts @($ReferenceSwsAppKey) `
        -Purpose 'reference policy by app key' `
        -MaxWaitSeconds $SwsPolicyReadyWaitSeconds `
        -PollIntervalSeconds $SwsPolicyPollIntervalSeconds

    $targetSearches = @(
        @($CreatedAppRowKey),
        @($Name),
        @($DisplayName)
    )

    $targetMatch = $null
    foreach ($searchGroup in $targetSearches) {
        try {
            $targetMatch = Wait-SwsPolicyByText `
                -SearchTexts $searchGroup `
                -Purpose ('target policy for created Identity app using search text {0}' -f ($searchGroup -join ',')) `
                -MaxWaitSeconds $SwsPolicyReadyWaitSeconds `
                -PollIntervalSeconds $SwsPolicyPollIntervalSeconds
            if ($null -ne $targetMatch) { break }
        } catch {
            Write-Log $_.Exception.Message 'Yellow'
        }
    }

    if ($null -eq $targetMatch) {
        throw 'Target SWS policy for the newly created Identity app could not be found by RowKey, Name, or DisplayName.'
    }

    Copy-SwsReferencePolicyToTarget -SourcePolicyMatch $sourceMatch -TargetPolicyMatch $targetMatch
    Add-SwsReplicationSummary -Step 'Overall' -Status 'SUCCESS' -Detail ("SourcePolicyId={0}; TargetPolicyId={1}" -f $sourceMatch.PolicyId, $targetMatch.PolicyId)
    Write-Log 'SWS policy replication completed.' 'Green'
}

$createdAppRowKey = $null

try {
    if ([string]::IsNullOrWhiteSpace($TemplateId)) {
        throw 'TemplateId cannot be empty.'
    }

    Get-RegularCredential
    Get-ResolvedAppNameAndDescription

    Write-Log ("Using regular user credential '{0}' for create + reauth + update flow." -f $script:RegularCredential.UserName) 'Cyan'
    Add-ReportRow -Step 'Credential Mode' -Status 'INFO' -Detail ("Regular user login as {0}" -f $script:RegularCredential.UserName)

    # Phase 1: create
    Start-IdentityRegularUserSession
    $createdAppRowKey = Import-AppFromTemplate -ResolvedTemplateId $TemplateId

    Write-Log ("Waiting {0} second(s) before starting fresh-session update phase..." -f $PreUpdateDelaySeconds) 'Yellow'
    Start-Sleep -Seconds $PreUpdateDelaySeconds

    # Phase 2: fresh session update
    Invoke-PostCreateUpdatePhase -CreatedRowKey $createdAppRowKey

    # Phase 3: optional SWS policy replication from reference app key
    Invoke-SwsPolicyReplicationForCreatedApp -CreatedAppRowKey $createdAppRowKey

    Write-Log ("Create + update completed successfully. Created app row key is '{0}'." -f $createdAppRowKey) 'Green'
    Add-ReportRow -Step 'Overall' -Status 'SUCCESS' -Detail ("CreatedRowKey={0}; FinalName={1}; Description={2}" -f $createdAppRowKey, $Name, $Description)
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Overall' -Status 'FAILED' -Detail $_.Exception.Message
}
finally {
    try {
        $csvDir = Split-Path -Path $ReportCsvPath -Parent
        if ($csvDir -and -not (Test-Path $csvDir)) {
            New-Item -Path $csvDir -ItemType Directory -Force | Out-Null
        }

        if ($script:ReportRows.Count -gt 0) {
            $script:ReportRows | Export-Csv -Path $ReportCsvPath -NoTypeInformation -Force
            Write-Log ("Report exported: {0}" -f $ReportCsvPath) 'Green'
        }
    } catch {
        Write-Log ("Could not export report CSV: {0}" -f $_.Exception.Message) 'Yellow'
    }
}
