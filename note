$HealthCheckPath = "C:\Program Files (x86)\CyberArk\PSM\HealthCheck"
$AppPoolName     = "HealthCheckAppPool"

Import-Module WebAdministration

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "1. HEALTH CHECK RUNTIME REQUIREMENT"
Write-Host "============================================" -ForegroundColor Cyan

$RuntimeFiles = Get-ChildItem `
    -Path $HealthCheckPath `
    -Filter "*.runtimeconfig.json" `
    -Recurse `
    -ErrorAction SilentlyContinue

if (-not $RuntimeFiles) {
    Write-Warning "No runtimeconfig.json file was found under $HealthCheckPath"
}
else {
    foreach ($File in $RuntimeFiles) {
        Write-Host "`nFile: $($File.FullName)" -ForegroundColor Yellow
        Get-Content -Path $File.FullName -Raw
    }
}

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "2. 64-BIT INSTALLED RUNTIMES"
Write-Host "============================================" -ForegroundColor Cyan

$DotNet64 = "$env:ProgramFiles\dotnet\dotnet.exe"

if (Test-Path $DotNet64) {
    & $DotNet64 --list-runtimes
}
else {
    Write-Warning "64-bit dotnet.exe is missing."
}

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "3. 32-BIT INSTALLED RUNTIMES"
Write-Host "============================================" -ForegroundColor Cyan

$DotNet32 = "${env:ProgramFiles(x86)}\dotnet\dotnet.exe"

if (Test-Path $DotNet32) {
    & $DotNet32 --list-runtimes
}
else {
    Write-Warning "32-bit dotnet.exe is missing."
}

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "4. APPLICATION POOL CONFIGURATION"
Write-Host "============================================" -ForegroundColor Cyan

if (Test-Path "IIS:\AppPools\$AppPoolName") {
    $Pool = Get-Item "IIS:\AppPools\$AppPoolName"

    [PSCustomObject]@{
        Name                    = $Pool.Name
        State                   = $Pool.State
        ManagedRuntimeVersion   = $Pool.ManagedRuntimeVersion
        ManagedPipelineMode     = $Pool.ManagedPipelineMode
        Enable32BitApplications = $Pool.Enable32BitAppOnWin64
        IdentityType            = $Pool.ProcessModel.IdentityType
        StartMode               = $Pool.StartMode
    } | Format-List
}
else {
    Write-Warning "Application pool '$AppPoolName' was not found."
}

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "5. ASP.NET CORE IIS MODULE"
Write-Host "============================================" -ForegroundColor Cyan

$Module64 = "$env:ProgramFiles\IIS\Asp.Net Core Module\V2\aspnetcorev2.dll"
$Module32 = "${env:ProgramFiles(x86)}\IIS\Asp.Net Core Module\V2\aspnetcorev2.dll"

[PSCustomObject]@{
    Module64Path   = $Module64
    Module64Exists = Test-Path $Module64
    Module32Path   = $Module32
    Module32Exists = Test-Path $Module32
} | Format-List

Get-WebGlobalModule |
    Where-Object Name -match "AspNetCore" |
    Format-Table Name, Image -AutoSize

Write-Host "`n============================================" -ForegroundColor Cyan
Write-Host "6. RECENT ASP.NET CORE/IIS EVENTS"
Write-Host "============================================" -ForegroundColor Cyan

Get-WinEvent -FilterHashtable @{
    LogName   = "Application"
    StartTime = (Get-Date).AddHours(-4)
} -ErrorAction SilentlyContinue |
Where-Object {
    $_.ProviderName -match "IIS AspNetCore|IIS-W3SVC-WP|ASP.NET Core" -or
    $_.Message -match "500\.31|Microsoft\.NETCore\.App|Microsoft\.AspNetCore\.App"
} |
Select-Object -First 15 TimeCreated, ProviderName, Id, LevelDisplayName, Message |
Format-List
