<#
Export-AllSafes_CreationDate_CNA.ps1

PURPOSE
- Log in to CNA Privilege Cloud using the same CCP + Identity header pattern
- Retrieve all safes visible to the service user
- Export Safe Name + Creation Date report to CSV

NOTES
- Gen2 safe listing returns all visible safes and includes creationTime
- creationTime is returned as Unix time; this script converts it to local datetime
- Optional -UseGen1API switch is included as a fallback path
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings (CNA) =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Output =====
    [string]$ReportPath        = 'E:\Installation Media\Script\OnboardScript\logs\CNA_AllSafes_CreationDate.csv',
    [string]$LogPath           = 'E:\Installation Media\Script\OnboardScript\logs\CNA_AllSafes_CreationDate.log',

    # ===== Retrieval options =====
    [switch]$UseGen1API
)

# -----------------------------
# Initial setup
# -----------------------------
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

foreach ($path in @($ReportPath, $LogPath)) {
    try {
        $parent = Split-Path -Path $path -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
    } catch {}
}

# -----------------------------
# Logging
# -----------------------------
function Write-Log {
    param(
        [string]$Message,
        [string]$Color = 'White'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $entry = "$timestamp - $Message"

    try { Write-Host $entry -ForegroundColor $Color } catch { Write-Host $entry }
    try { Add-Content -Path $LogPath -Value $entry } catch {}
}

# -----------------------------
# Helpers
# -----------------------------
function Get-NormalizedIdentityTenant {
    param([Parameter(Mandatory)][string]$TenantUrl)

    $value = $TenantUrl.Trim()
    $value = $value -replace '^https?://', ''
    $value = $value.TrimEnd('/')

    return $value
}

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string[]]$Names
    )

    foreach ($name in $Names) {
        $prop = $Object.PSObject.Properties[$name]
        if ($prop -and $null -ne $prop.Value -and "$($prop.Value)".Trim() -ne '') {
            return $prop.Value
        }
    }

    return $null
}

function Convert-FromUnixLikeTime {
    param(
        [Parameter(ValueFromPipeline = $true)]
        [AllowNull()]
        $Value
    )

    process {
        if ($null -eq $Value -or "$Value".Trim() -eq '') {
            return $null
        }

        $text = "$Value".Trim()

        if ($text -notmatch '^\d+$') {
            # Already looks like a formatted date string
            try { return [datetime]$text } catch { return $null }
        }

        try {
            $num = [int64]$text

            # Common formats:
            # 10 digits  = Unix seconds
            # 13 digits  = Unix milliseconds
            # 16 digits  = Unix microseconds
            # 19 digits  = Unix nanoseconds (rare in this context)
            switch ($text.Length) {
                10 { return [DateTimeOffset]::FromUnixTimeSeconds($num).LocalDateTime }
                13 { return [DateTimeOffset]::FromUnixTimeMilliseconds($num).LocalDateTime }
                16 { return [DateTimeOffset]::FromUnixTimeMilliseconds([int64]($num / 1000)).LocalDateTime }
                19 { return [DateTimeOffset]::FromUnixTimeMilliseconds([int64]($num / 1000000)).LocalDateTime }
                default {
                    # Best effort fallback:
                    if ($num -lt 32503680000) {
                        return [DateTimeOffset]::FromUnixTimeSeconds($num).LocalDateTime
                    } elseif ($num -lt 32503680000000) {
                        return [DateTimeOffset]::FromUnixTimeMilliseconds($num).LocalDateTime
                    } else {
                        return [DateTimeOffset]::FromUnixTimeMilliseconds([int64]($num / 1000)).LocalDateTime
                    }
                }
            }
        } catch {
            return $null
        }
    }
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName
    )

    $headers = @{ 'Content-Type' = 'application/json' }
    $ccpUrl  = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName)
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response'
        }
    } catch {
        Write-Log ("❌ ERROR: CCP credential fetch failed - {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null
    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("✅ Successfully retrieved credentials for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL
        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication (psPAS Identity header) as {0}..." -f $resolvedUser)
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established'
        }

        Write-Log ("✅ Authentication successful, PAS session established ({0})." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("❌ Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    return $resp
}

# -----------------------------
# Load modules
# -----------------------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) 'Green'
} catch {
    Write-Log ("❌ psPAS module not found/loaded: {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# -----------------------------
# Login
# -----------------------------
try {
    [void](Start-PASSessionFromCCP -ObjectName $CCPObject)
} catch {
    exit 1
}

# -----------------------------
# Get safes
# -----------------------------
$report = @()

try {
    Write-Log "Retrieving safes from CyberArk..." 'Cyan'

    if ($UseGen1API) {
        $safes = @(Get-PASSafe -FindAll -UseGen1API -ErrorAction Stop)
    } else {
        $safes = @(Get-PASSafe -ErrorAction Stop)
    }

    Write-Log ("Retrieved {0} safe(s)." -f $safes.Count) 'Green'

    foreach ($safe in $safes) {
        $safeName      = Get-ObjectPropertyValue -Object $safe -Names @('safeName','SafeName','Safe')
        $safeUrlId     = Get-ObjectPropertyValue -Object $safe -Names @('safeUrlId','SafeUrlId')
        $safeNumber    = Get-ObjectPropertyValue -Object $safe -Names @('safeNumber','SafeNumber')
        $description   = Get-ObjectPropertyValue -Object $safe -Names @('description','Description')
        $location      = Get-ObjectPropertyValue -Object $safe -Names @('location','Location')
        $managingCPM   = Get-ObjectPropertyValue -Object $safe -Names @('managingCPM','ManagingCPM')
        $creationRaw   = Get-ObjectPropertyValue -Object $safe -Names @('creationTime','CreationTime')
        $modifiedRaw   = Get-ObjectPropertyValue -Object $safe -Names @('lastModificationTime','LastModificationTime')
        $createdDate   = Convert-FromUnixLikeTime $creationRaw
        $modifiedDate  = Convert-FromUnixLikeTime $modifiedRaw

        $creatorName = $null
        $creatorProp = $safe.PSObject.Properties['creator']
        if ($creatorProp -and $null -ne $creatorProp.Value) {
            $creatorName = Get-ObjectPropertyValue -Object $creatorProp.Value -Names @('name','Name')
        }

        $report += [pscustomobject]@{
            SafeName                  = $safeName
            SafeUrlId                 = $safeUrlId
            SafeNumber                = $safeNumber
            CreationTimeRaw           = $creationRaw
            CreationDateLocal         = if ($createdDate) { $createdDate.ToString('yyyy-MM-dd HH:mm:ss') } else { '' }
            LastModificationTimeRaw   = $modifiedRaw
            LastModificationDateLocal = if ($modifiedDate) { $modifiedDate.ToString('yyyy-MM-dd HH:mm:ss') } else { '' }
            CreatorName               = $creatorName
            ManagingCPM               = $managingCPM
            Location                  = $location
            Description               = $description
        }
    }
}
catch {
    Write-Log ("❌ Failed to retrieve safes: {0}" -f $_.Exception.Message) 'Red'
    try { Close-PASSession | Out-Null } catch {}
    exit 1
}
finally {
    try {
        Close-PASSession | Out-Null
        Write-Log '✅ PAS session closed.' 'Green'
    } catch {}
}

# -----------------------------
# Export report
# -----------------------------
try {
    $report |
        Sort-Object @{ Expression = { if ($_.CreationDateLocal) { [datetime]$_.CreationDateLocal } else { [datetime]'1900-01-01' } } }, SafeName |
        Export-Csv -Path $ReportPath -NoTypeInformation -Encoding UTF8

    Write-Log ("✅ Report exported to: {0}" -f $ReportPath) 'Green'
}
catch {
    Write-Log ("❌ Failed to export report: {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

Write-Log ("✅ Completed. Total safes in report: {0}" -f $report.Count) 'Cyan'
