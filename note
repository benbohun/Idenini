<#
.SYNOPSIS
    Verify AD domains / SearchBases before running Validate_Usernames_AcrossDomains.ps1

.DESCRIPTION
    This script checks:
      1. ActiveDirectory PowerShell module availability
      2. Domain DNS name derived from each SearchBase
      3. DNS resolution for the derived domain/server
      4. TCP connectivity to LDAP ports 389 and 636
      5. AD domain readability
      6. SearchBase readability using Get-ADObject

    Output:
      - Console summary
      - Timestamped CSV report

.REQUIREMENTS
    - PowerShell 5.1
    - RSAT ActiveDirectory module
    - Network/trust/DNS path to target domains
    - Read permission to the target OUs

.EXAMPLES
    .\Verify-DomainSearchBases.ps1

    .\Verify-DomainSearchBases.ps1 -Credential (Get-Credential)

    .\Verify-DomainSearchBases.ps1 -OutputDir "C:\Temp\DomainChecks"
#>

[CmdletBinding()]
param(
    # ============================================================
    # DOMAIN SEARCH BASES -- EDIT THESE TO MATCH YOUR ENVIRONMENT
    # ============================================================
    [string[]]$DomainSearchBases = @(
        'OU=Service,OU=Accounts,DC=prod,DC=domain1,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain2,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain3,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain4,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain5,DC=com'
    ),

    # OPTIONAL: force a specific DC/server for a given DNS domain.
    # Example:
    # @{
    #   'prod.domain1.com' = 'dc01.prod.domain1.com'
    #   'prod.domain2.com' = 'dc01.prod.domain2.com'
    # }
    [hashtable]$ServerOverrides = @{},

    # Optional credential for cross-domain validation
    [System.Management.Automation.PSCredential]$Credential,

    # Where report will be written
    [string]$OutputDir = $PSScriptRoot,

    # TCP ports to test before AD query
    [int[]]$TcpPorts = @(389, 636),

    # Skip TCP checks if blocked by firewall policy but AD cmdlets still work
    [switch]$SkipTcp
)

$ErrorActionPreference = 'Continue'

function Write-Info($m){ Write-Host "[INFO]  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "[OK]    $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[WARN]  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "[ERROR] $m" -ForegroundColor Red }

function ConvertTo-DnsDomain {
    param(
        [Parameter(Mandatory)]
        [string]$DistinguishedName
    )

    $dcs = [regex]::Matches($DistinguishedName, '(?i)DC=([^,]+)') |
        ForEach-Object { $_.Groups[1].Value }

    if (-not $dcs -or $dcs.Count -eq 0) {
        return $null
    }

    return ($dcs -join '.')
}

function Test-DnsNameBasic {
    param(
        [Parameter(Mandatory)]
        [string]$Name
    )

    try {
        $addresses = [System.Net.Dns]::GetHostAddresses($Name)
        if ($addresses -and $addresses.Count -gt 0) {
            return @{
                Success = $true
                Detail  = ($addresses | ForEach-Object { $_.IPAddressToString }) -join '; '
            }
        }

        return @{
            Success = $false
            Detail  = 'No IP address returned'
        }
    }
    catch {
        return @{
            Success = $false
            Detail  = $_.Exception.Message
        }
    }
}

function Test-TcpPortBasic {
    param(
        [Parameter(Mandatory)]
        [string]$ComputerName,

        [Parameter(Mandatory)]
        [int]$Port,

        [int]$TimeoutMs = 3000
    )

    $client = New-Object System.Net.Sockets.TcpClient

    try {
        $async = $client.BeginConnect($ComputerName, $Port, $null, $null)
        $wait = $async.AsyncWaitHandle.WaitOne($TimeoutMs, $false)

        if (-not $wait) {
            $client.Close()
            return @{
                Success = $false
                Detail  = "Timeout after $TimeoutMs ms"
            }
        }

        $client.EndConnect($async)
        $client.Close()

        return @{
            Success = $true
            Detail  = 'Connected'
        }
    }
    catch {
        try { $client.Close() } catch {}
        return @{
            Success = $false
            Detail  = $_.Exception.Message
        }
    }
}

function New-ResultRow {
    param(
        [string]$SearchBase,
        [string]$DnsDomain,
        [string]$ServerUsed,
        [string]$DnValid,
        [string]$DomainDnsResolved,
        [string]$DomainDnsDetail,
        [string]$ServerDnsResolved,
        [string]$ServerDnsDetail,
        [string]$Tcp389,
        [string]$Tcp389Detail,
        [string]$Tcp636,
        [string]$Tcp636Detail,
        [string]$AdDomainReadable,
        [string]$AdDomainDetail,
        [string]$SearchBaseReadable,
        [string]$SearchBaseDetail,
        [string]$Status,
        [string]$Notes
    )

    [pscustomobject]@{
        SearchBase          = $SearchBase
        DnsDomain           = $DnsDomain
        ServerUsed          = $ServerUsed
        DN_IsValid          = $DnValid
        DomainDnsResolved   = $DomainDnsResolved
        DomainDnsDetail     = $DomainDnsDetail
        ServerDnsResolved   = $ServerDnsResolved
        ServerDnsDetail     = $ServerDnsDetail
        Tcp389              = $Tcp389
        Tcp389Detail        = $Tcp389Detail
        Tcp636              = $Tcp636
        Tcp636Detail        = $Tcp636Detail
        ADDomainReadable    = $AdDomainReadable
        ADDomainDetail      = $AdDomainDetail
        SearchBaseReadable  = $SearchBaseReadable
        SearchBaseDetail    = $SearchBaseDetail
        Status              = $Status
        Notes               = $Notes
    }
}

Write-Info "Starting AD domain/SearchBase validation."

if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
    Write-Err "ActiveDirectory module not found. Install RSAT AD PowerShell tools and re-run."
    return
}

try {
    Import-Module ActiveDirectory -ErrorAction Stop
    Write-Ok "ActiveDirectory module loaded."
}
catch {
    Write-Err "Failed to import ActiveDirectory module: $($_.Exception.Message)"
    return
}

if (-not $OutputDir) {
    $OutputDir = $PSScriptRoot
}

if (-not (Test-Path $OutputDir)) {
    New-Item -ItemType Directory -Path $OutputDir -Force | Out-Null
}

$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$reportPath = Join-Path $OutputDir ("DomainSearchBase_Verification_{0}.csv" -f $stamp)

$results = New-Object System.Collections.Generic.List[object]

foreach ($sb in $DomainSearchBases) {
    Write-Host ""
    Write-Info "Validating SearchBase: $sb"

    $dnsDomain = ''
    $server = ''
    $dnValid = 'No'
    $domainDnsResolved = 'No'
    $domainDnsDetail = ''
    $serverDnsResolved = 'No'
    $serverDnsDetail = ''
    $tcp389 = 'Skipped'
    $tcp389Detail = ''
    $tcp636 = 'Skipped'
    $tcp636Detail = ''
    $adDomainReadable = 'No'
    $adDomainDetail = ''
    $searchBaseReadable = 'No'
    $searchBaseDetail = ''
    $status = 'FAIL'
    $notes = New-Object System.Collections.Generic.List[string]

    if ([string]::IsNullOrWhiteSpace($sb)) {
        [void]$notes.Add('Blank SearchBase entry')
        Write-Warn "Blank SearchBase entry skipped."

        $results.Add((New-ResultRow `
            -SearchBase $sb `
            -DnsDomain $dnsDomain `
            -ServerUsed $server `
            -DnValid $dnValid `
            -DomainDnsResolved $domainDnsResolved `
            -DomainDnsDetail $domainDnsDetail `
            -ServerDnsResolved $serverDnsResolved `
            -ServerDnsDetail $serverDnsDetail `
            -Tcp389 $tcp389 `
            -Tcp389Detail $tcp389Detail `
            -Tcp636 $tcp636 `
            -Tcp636Detail $tcp636Detail `
            -AdDomainReadable $adDomainReadable `
            -AdDomainDetail $adDomainDetail `
            -SearchBaseReadable $searchBaseReadable `
            -SearchBaseDetail $searchBaseDetail `
            -Status $status `
            -Notes ($notes -join ' | '))) | Out-Null

        continue
    }

    $dnsDomain = ConvertTo-DnsDomain -DistinguishedName $sb

    if ([string]::IsNullOrWhiteSpace($dnsDomain)) {
        [void]$notes.Add('Could not derive DNS domain from DC= components')
        Write-Warn "Invalid DN/SearchBase. Could not derive DNS domain."

        $results.Add((New-ResultRow `
            -SearchBase $sb `
            -DnsDomain $dnsDomain `
            -ServerUsed $server `
            -DnValid $dnValid `
            -DomainDnsResolved $domainDnsResolved `
            -DomainDnsDetail $domainDnsDetail `
            -ServerDnsResolved $serverDnsResolved `
            -ServerDnsDetail $serverDnsDetail `
            -Tcp389 $tcp389 `
            -Tcp389Detail $tcp389Detail `
            -Tcp636 $tcp636 `
            -Tcp636Detail $tcp636Detail `
            -AdDomainReadable $adDomainReadable `
            -AdDomainDetail $adDomainDetail `
            -SearchBaseReadable $searchBaseReadable `
            -SearchBaseDetail $searchBaseDetail `
            -Status $status `
            -Notes ($notes -join ' | '))) | Out-Null

        continue
    }

    $dnValid = 'Yes'

    if ($ServerOverrides.ContainsKey($dnsDomain)) {
        $server = $ServerOverrides[$dnsDomain]
        [void]$notes.Add("Server override used")
    }
    else {
        $server = $dnsDomain
    }

    Write-Info "Derived DNS domain: $dnsDomain"
    Write-Info "Server used: $server"

    # DNS check for derived domain
    $domainDns = Test-DnsNameBasic -Name $dnsDomain
    if ($domainDns.Success) {
        $domainDnsResolved = 'Yes'
        $domainDnsDetail = $domainDns.Detail
        Write-Ok "DNS resolved for domain: $dnsDomain"
    }
    else {
        $domainDnsResolved = 'No'
        $domainDnsDetail = $domainDns.Detail
        [void]$notes.Add("Domain DNS resolution failed")
        Write-Warn "DNS resolution failed for domain '$dnsDomain': $domainDnsDetail"
    }

    # DNS check for server/DC
    $serverDns = Test-DnsNameBasic -Name $server
    if ($serverDns.Success) {
        $serverDnsResolved = 'Yes'
        $serverDnsDetail = $serverDns.Detail
        Write-Ok "DNS resolved for server: $server"
    }
    else {
        $serverDnsResolved = 'No'
        $serverDnsDetail = $serverDns.Detail
        [void]$notes.Add("Server DNS resolution failed")
        Write-Warn "DNS resolution failed for server '$server': $serverDnsDetail"
    }

    # TCP port checks
    if (-not $SkipTcp) {
        foreach ($port in $TcpPorts) {
            $tcp = Test-TcpPortBasic -ComputerName $server -Port $port

            if ($port -eq 389) {
                $tcp389 = if ($tcp.Success) { 'Open' } else { 'Closed/Blocked' }
                $tcp389Detail = $tcp.Detail
            }

            if ($port -eq 636) {
                $tcp636 = if ($tcp.Success) { 'Open' } else { 'Closed/Blocked' }
                $tcp636Detail = $tcp.Detail
            }

            if ($tcp.Success) {
                Write-Ok "TCP $port open to $server"
            }
            else {
                [void]$notes.Add("TCP $port failed")
                Write-Warn "TCP $port failed to $server`: $($tcp.Detail)"
            }
        }
    }
    else {
        [void]$notes.Add('TCP checks skipped by switch')
        Write-Warn "TCP checks skipped."
    }

    # Common AD parameters
    $common = @{
        Server = $server
    }

    if ($Credential) {
        $common['Credential'] = $Credential
    }

    # AD domain readability
    try {
        $domainObj = Get-ADDomain @common -ErrorAction Stop
        $adDomainReadable = 'Yes'
        $adDomainDetail = "NetBIOS=$($domainObj.NetBIOSName); DNSRoot=$($domainObj.DNSRoot)"
        Write-Ok "AD domain readable: $($domainObj.DNSRoot)"
    }
    catch {
        $adDomainReadable = 'No'
        $adDomainDetail = $_.Exception.Message
        [void]$notes.Add('Get-ADDomain failed')
        Write-Warn "Get-ADDomain failed for '$server': $adDomainDetail"
    }

    # SearchBase readability
    try {
        Get-ADObject -Identity $sb @common -ErrorAction Stop | Out-Null
        $searchBaseReadable = 'Yes'
        $searchBaseDetail = 'SearchBase exists and is readable'
        Write-Ok "SearchBase readable."
    }
    catch {
        $searchBaseReadable = 'No'
        $searchBaseDetail = $_.Exception.Message
        [void]$notes.Add('SearchBase unreadable or does not exist')
        Write-Warn "SearchBase check failed: $searchBaseDetail"
    }

    if ($searchBaseReadable -eq 'Yes') {
        $status = 'PASS'
    }
    elseif ($adDomainReadable -eq 'Yes') {
        $status = 'WARN'
        [void]$notes.Add('Domain is reachable, but SearchBase failed')
    }
    else {
        $status = 'FAIL'
    }

    $results.Add((New-ResultRow `
        -SearchBase $sb `
        -DnsDomain $dnsDomain `
        -ServerUsed $server `
        -DnValid $dnValid `
        -DomainDnsResolved $domainDnsResolved `
        -DomainDnsDetail $domainDnsDetail `
        -ServerDnsResolved $serverDnsResolved `
        -ServerDnsDetail $serverDnsDetail `
        -Tcp389 $tcp389 `
        -Tcp389Detail $tcp389Detail `
        -Tcp636 $tcp636 `
        -Tcp636Detail $tcp636Detail `
        -AdDomainReadable $adDomainReadable `
        -AdDomainDetail $adDomainDetail `
        -SearchBaseReadable $searchBaseReadable `
        -SearchBaseDetail $searchBaseDetail `
        -Status $status `
        -Notes ($notes -join ' | '))) | Out-Null
}

$results | Export-Csv -Path $reportPath -NoTypeInformation -Encoding UTF8

Write-Host ""
Write-Ok "Domain/SearchBase validation complete."
Write-Host "----------------------------------------"

$summary = $results | Group-Object Status | Sort-Object Name
foreach ($item in $summary) {
    Write-Host ("  {0,-8} {1} target(s)" -f $item.Name, $item.Count)
}

Write-Host "----------------------------------------"
Write-Host ("  Total SearchBases : {0}" -f $results.Count)
Write-Host ("  Report            : {0}" -f $reportPath)
Write-Host "----------------------------------------"

$failed = @($results | Where-Object { $_.Status -ne 'PASS' })

if ($failed.Count -gt 0) {
    Write-Warn "One or more domains/SearchBases did not fully pass. Review the CSV before running the username validation script."
}
else {
    Write-Ok "All domains/SearchBases passed. You can proceed with the username validation script."
}
