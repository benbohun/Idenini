[CmdletBinding()]
param(
    [string]$CsvPath    = "E:\Installation Media\Script\OnboardScript\csv\OverrideComponentPlatform.csv",
    [string]$OutputRoot = "E:\Installation Media\Script\OnboardScript\logs\Platform_HTML5_Override",
    [switch]$WhatIf
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

# ---------------- TARGET OVERRIDE ----------------
$OverrideParam = [ordered]@{
    Name                        = "AllowSelectHTML5"
    DisplayName                 = "Connect Via Browser"
    Visible                     = "Yes"
    Type                        = "CyberArk.TransparentConnection.BooleanUserParameter, CyberArk.PasswordVault.TransparentConnection"
    Required                    = "Yes"
    Value                       = "No"
    EnforceInDualControlRequest = "No"
}

# ---------------- ZIP SUPPORT ----------------
try { Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop } catch {}

# ---------------- LOGGING ----------------
function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet("Gray","Green","Yellow","Red","Cyan","White","Magenta")]
        [string]$Color = "White"
    )

    $stamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Host ("{0} | {1}" -f $stamp, $Message) -ForegroundColor $Color
}

# ---------------- LOAD psPAS ----------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
}
catch {
    Write-Log ("ERROR: psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

# ---------------- CYBERARK SETTINGS ----------------
$CCPAddress      = "https://vskau1p1231.cna.com"
$CCPLocation     = "AIMWebService"
$CCPAppID        = "PAMDiscovery"
$CCPSafe         = "CA_PCloud_Admins"
$CCPObject       = "cna.com-CA_PAMDiscovery_SVC"
$ServiceUPUser   = "CA_PAMDiscovery_SVC"
$CCPWindowsAuth  = $false

$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# ---------------- OUTPUT PATHS ----------------
$BackupRoot = Join-Path $OutputRoot "Backups"
$WorkRoot   = Join-Path $OutputRoot "Work"
$ReportRoot = Join-Path $OutputRoot "Reports"

foreach ($folder in @($OutputRoot, $BackupRoot, $WorkRoot, $ReportRoot)) {
    if (-not (Test-Path -LiteralPath $folder)) {
        $null = New-Item -Path $folder -ItemType Directory -Force
    }
}

# ---------------- HELPERS ----------------
function Get-SafeFileName {
    param([Parameter(Mandatory)][string]$Name)
    return ($Name -replace '[\\/:*?"<>|]', '_')
}

function Normalize-Token {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return "" }
    return (($Value.ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function Get-OptionalCsvValue {
    param(
        [Parameter(Mandatory)]$Row,
        [Parameter(Mandatory)][string]$ColumnName
    )

    $prop = $Row.PSObject.Properties[$ColumnName]
    if ($null -eq $prop) { return $null }

    $value = [string]$prop.Value
    if ([string]::IsNullOrWhiteSpace($value)) { return $null }

    return $value.Trim()
}

function Set-XmlAttribute {
    param(
        [Parameter(Mandatory)][System.Xml.XmlElement]$Element,
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Value
    )

    $existing = $Element.GetAttributeNode($Name)
    if ($null -eq $existing) {
        $attr = $Element.OwnerDocument.CreateAttribute($Name)
        $attr.Value = $Value
        [void]$Element.Attributes.Append($attr)
    }
    else {
        $existing.Value = $Value
    }
}

function Get-PASWebSession {
    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found."
    }
    return $s.WebSession
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $ccpUrl = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"

    $resp = Invoke-RestMethod `
        -Uri $ccpUrl `
        -Method GET `
        -Headers @{ "Content-Type" = "application/json" } `
        -UseDefaultCredentials:$CCPWindowsAuth `
        -ErrorAction Stop

    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred `
        -ErrorAction Stop

    Use-PASSession $headerSession | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

function Invoke-EPVRest {
    param(
        [Parameter(Mandatory)]
        [ValidateSet("GET","POST","PUT","DELETE")]
        [string]$Method,

        [Parameter(Mandatory)][string]$RelativePath,
        [object]$Body,
        [switch]$Raw
    )

    $webSession = Get-PASWebSession
    $path = $RelativePath.TrimStart('/')

    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $candidatePath = $path -replace '^(API|api)', $apiPrefix
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}" -f $PCloudSubdomain, $candidatePath

        try {
            $params = @{
                Uri         = $uri
                Method      = $Method
                WebSession  = $webSession
                ErrorAction = "Stop"
            }

            if ($null -ne $Body) {
                $params["ContentType"] = "application/json"
                $params["Body"] = ($Body | ConvertTo-Json -Depth 50 -Compress)
            }

            if ($Raw) {
                return Invoke-WebRequest @params
            }
            else {
                return Invoke-RestMethod @params
            }
        }
        catch {
            $lastError = $_
        }
    }

    throw $lastError
}

function Get-PlatformByStringId {
    param([Parameter(Mandatory)][string]$PlatformID)

    $search = [uri]::EscapeDataString($PlatformID)
    $result = Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets?search={0}" -f $search)

    $matches = @($result.Platforms | Where-Object {
        $_.PlatformID -eq $PlatformID
    })

    if ($matches.Count -eq 0) {
        throw "Platform [$PlatformID] was not found."
    }

    if ($matches.Count -gt 1) {
        throw "Multiple exact matches returned for platform [$PlatformID]."
    }

    return $matches[0]
}

function Get-PlatformDetails {
    param([Parameter(Mandatory)][string]$PlatformID)

    $encoded = [uri]::EscapeDataString($PlatformID)
    return Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/{0}/" -f $encoded)
}

function Get-PlatformSessionManagementByNumericId {
    param([Parameter(Mandatory)][int]$PlatformNumericID)

    return Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets/{0}/PrivilegedSessionManagement/" -f $PlatformNumericID)
}

function Export-PlatformZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$DestinationFolder
    )

    $safeName = Get-SafeFileName -Name $PlatformID
    $stamp    = Get-Date -Format "yyyyMMdd_HHmmss"
    $zipPath  = Join-Path $DestinationFolder ("{0}_{1}.zip" -f $safeName, $stamp)

    $webSession = Get-PASWebSession
    $encoded = [uri]::EscapeDataString($PlatformID)
    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}/Platforms/{2}/Export/" -f `
            $PCloudSubdomain, $apiPrefix, $encoded

        try {
            Invoke-WebRequest -Uri $uri -Method POST -WebSession $webSession -OutFile $zipPath -ErrorAction Stop | Out-Null
            break
        }
        catch {
            $lastError = $_
        }
    }

    if (-not (Test-Path -LiteralPath $zipPath)) {
        throw $lastError
    }

    return $zipPath
}

function Clear-StoredPlatformSilently {
    try {
        Invoke-EPVRest -Method DELETE -RelativePath "API/Platforms/Storage" | Out-Null
    }
    catch {}
}

function Import-PlatformZipToStorage {
    param([Parameter(Mandatory)][string]$ZipPath)

    $bytes  = [System.IO.File]::ReadAllBytes($ZipPath)
    $base64 = [System.Convert]::ToBase64String($bytes)

    return Invoke-EPVRest -Method POST -RelativePath "API/Platforms/Import/" -Body @{ ImportFile = $base64 }
}

function Update-PlatformWithStored {
    param([Parameter(Mandatory)][string]$PlatformID)

    $encoded = [uri]::EscapeDataString($PlatformID)
    return Invoke-EPVRest -Method POST -RelativePath ("API/Platforms/{0}/Update" -f $encoded)
}

function Get-NodeContextStrings {
    param([Parameter(Mandatory)][System.Xml.XmlNode]$Node)

    $items = New-Object System.Collections.Generic.List[string]
    $current = $Node

    while ($null -ne $current) {
        if ($null -ne $current.Attributes) {
            foreach ($attrName in @("Name","ID","Id","ComponentName","ConnectionComponent","PSMConnectorID","ConnectorID","DisplayName")) {
                $attr = $current.Attributes[$attrName]
                if ($null -ne $attr -and -not [string]::IsNullOrWhiteSpace($attr.Value)) {
                    $val = $attr.Value.Trim()
                    if (-not $items.Contains($val)) {
                        $items.Add($val)
                    }
                }
            }
        }
        $current = $current.ParentNode
    }

    return @($items)
}

function Test-ComponentMatch {
    param(
        [Parameter(Mandatory)][System.Xml.XmlNode]$Node,
        [string]$ConnectionComponentName
    )

    if ([string]::IsNullOrWhiteSpace($ConnectionComponentName)) {
        return $true
    }

    $needle = Normalize-Token $ConnectionComponentName
    $contexts = @(Get-NodeContextStrings -Node $Node)

    foreach ($ctx in $contexts) {
        $norm = Normalize-Token $ctx
        if ([string]::IsNullOrWhiteSpace($norm)) { continue }
        if ($norm -eq $needle) { return $true }
        if ($norm.Contains($needle)) { return $true }
        if ($needle.Contains($norm)) { return $true }
    }

    return $false
}

function Get-PackageSignals {
    param([Parameter(Mandatory)][string]$ExtractDir)

    $files = @(Get-ChildItem -LiteralPath $ExtractDir -Recurse -File)
    $textFiles = @($files | Where-Object { $_.Extension -match '\.(xml|ini|txt|config)$' })

    $signalHits = New-Object System.Collections.Generic.List[object]

    foreach ($file in $textFiles) {
        try {
            $raw = Get-Content -LiteralPath $file.FullName -Raw -ErrorAction Stop

            $hasUserParameters = $raw -match 'UserParameters'
            $hasAllowMapping   = $raw -match 'AllowMappingLocalDrives'
            $hasAllowSelect    = $raw -match 'AllowSelectHTML5'

            if ($hasUserParameters -or $hasAllowMapping -or $hasAllowSelect) {
                $signalHits.Add([pscustomobject]@{
                    FilePath             = $file.FullName
                    HasUserParameters    = $hasUserParameters
                    HasAllowMapping      = $hasAllowMapping
                    HasAllowSelectHTML5  = $hasAllowSelect
                })
            }
        }
        catch {}
    }

    return @($signalHits)
}

function Update-AllowSelectHTML5InXml {
    param(
        [Parameter(Mandatory)][string]$XmlPath,
        [string]$ConnectionComponentName,
        [switch]$AllowSingleBlockFallback
    )

    [xml]$xml = Get-Content -LiteralPath $XmlPath -Raw

    $allBlocks = @($xml.SelectNodes("//*[local-name()='UserParameters']"))
    $contexts  = New-Object System.Collections.Generic.List[string]
    $changed   = $false
    $updated   = 0
    $added     = 0
    $touched   = 0

    if (-not $allBlocks -or $allBlocks.Count -eq 0) {
        return [pscustomobject]@{
            Changed       = $false
            UpdatedNodes  = 0
            AddedNodes    = 0
            BlocksTouched = 0
            Contexts      = @()
        }
    }

    $matchedBlocks = New-Object System.Collections.Generic.List[System.Xml.XmlNode]

    foreach ($block in $allBlocks) {
        $ctx = (Get-NodeContextStrings -Node $block) -join " | "
        if (-not [string]::IsNullOrWhiteSpace($ctx) -and -not $contexts.Contains($ctx)) {
            $contexts.Add($ctx)
        }

        if (Test-ComponentMatch -Node $block -ConnectionComponentName $ConnectionComponentName) {
            $matchedBlocks.Add($block)
        }
    }

    if ($matchedBlocks.Count -eq 0 -and $AllowSingleBlockFallback -and $allBlocks.Count -eq 1) {
        $matchedBlocks.Add($allBlocks[0])
    }

    foreach ($block in $matchedBlocks) {
        $existing = @($block.SelectNodes("./*[local-name()='Parameter' and @Name='AllowSelectHTML5']"))

        if ($existing.Count -gt 0) {
            foreach ($node in $existing) {
                $el = [System.Xml.XmlElement]$node
                Set-XmlAttribute -Element $el -Name "Name" -Value $OverrideParam.Name
                Set-XmlAttribute -Element $el -Name "DisplayName" -Value $OverrideParam.DisplayName
                Set-XmlAttribute -Element $el -Name "Visible" -Value $OverrideParam.Visible
                Set-XmlAttribute -Element $el -Name "Type" -Value $OverrideParam.Type
                Set-XmlAttribute -Element $el -Name "Required" -Value $OverrideParam.Required
                Set-XmlAttribute -Element $el -Name "Value" -Value $OverrideParam.Value
                Set-XmlAttribute -Element $el -Name "EnforceInDualControlRequest" -Value $OverrideParam.EnforceInDualControlRequest
                $updated++
                $changed = $true
            }
            $touched++
            continue
        }

        $template = $block.SelectSingleNode("./*[local-name()='Parameter' and @Name='AllowMappingLocalDrives']")
        if ($null -eq $template) { continue }

        $newNode = $template.CloneNode($true)
        $newEl   = [System.Xml.XmlElement]$newNode

        Set-XmlAttribute -Element $newEl -Name "Name" -Value $OverrideParam.Name
        Set-XmlAttribute -Element $newEl -Name "DisplayName" -Value $OverrideParam.DisplayName
        Set-XmlAttribute -Element $newEl -Name "Visible" -Value $OverrideParam.Visible
        Set-XmlAttribute -Element $newEl -Name "Type" -Value $OverrideParam.Type
        Set-XmlAttribute -Element $newEl -Name "Required" -Value $OverrideParam.Required
        Set-XmlAttribute -Element $newEl -Name "Value" -Value $OverrideParam.Value
        Set-XmlAttribute -Element $newEl -Name "EnforceInDualControlRequest" -Value $OverrideParam.EnforceInDualControlRequest

        [void]$block.AppendChild($newEl)
        $added++
        $touched++
        $changed = $true
    }

    if ($changed) {
        $xml.Save($XmlPath)
    }

    return [pscustomobject]@{
        Changed       = $changed
        UpdatedNodes  = $updated
        AddedNodes    = $added
        BlocksTouched = $touched
        Contexts      = @($contexts)
    }
}

function Update-PlatformPackage {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$InputZip,
        [Parameter(Mandatory)][string]$WorkingRoot,
        [string]$ConnectionComponentName
    )

    $safeName    = Get-SafeFileName -Name $PlatformID
    $extractDir  = Join-Path $WorkingRoot ("Extract_{0}_{1}" -f $safeName, ([guid]::NewGuid().ToString("N")))
    $modifiedZip = Join-Path $WorkingRoot ("{0}_modified_{1}.zip" -f $safeName, (Get-Date -Format "yyyyMMdd_HHmmss"))

    if (Test-Path -LiteralPath $extractDir) {
        Remove-Item -LiteralPath $extractDir -Recurse -Force
    }
    $null = New-Item -Path $extractDir -ItemType Directory -Force

    try {
        [System.IO.Compression.ZipFile]::ExtractToDirectory($InputZip, $extractDir)

        $signals = @(Get-PackageSignals -ExtractDir $extractDir)
        if ($signals.Count -eq 0) {
            throw "Connector linkage and export were validated, but the package does not expose UserParameters or AllowMappingLocalDrives. No safe package-based override edit is possible for this export."
        }

        $xmlFiles = @(Get-ChildItem -LiteralPath $extractDir -Recurse -File -Filter "*.xml")
        if ($xmlFiles.Count -eq 0) {
            throw "Export succeeded, but no XML files were found in the package."
        }

        $xmlChanged = 0
        $updated    = 0
        $added      = 0
        $touched    = 0
        $contexts   = New-Object System.Collections.Generic.List[string]

        foreach ($xmlFile in $xmlFiles) {
            $result = Update-AllowSelectHTML5InXml `
                -XmlPath $xmlFile.FullName `
                -ConnectionComponentName $ConnectionComponentName `
                -AllowSingleBlockFallback

            foreach ($ctx in @($result.Contexts)) {
                if (-not [string]::IsNullOrWhiteSpace($ctx) -and -not $contexts.Contains($ctx)) {
                    $contexts.Add($ctx)
                }
            }

            if ($result.Changed) {
                $xmlChanged++
                $updated += $result.UpdatedNodes
                $added   += $result.AddedNodes
                $touched += $result.BlocksTouched
            }
        }

        if (($updated + $added) -lt 1) {
            $ctxText = ""
            if ($contexts.Count -gt 0) {
                $ctxText = " Candidate contexts: " + (($contexts | Select-Object -First 5) -join " || ")
            }
            throw ("Export exposed signal files, but no editable UserParameters block was updated for this connector." + $ctxText)
        }

        if (Test-Path -LiteralPath $modifiedZip) {
            Remove-Item -LiteralPath $modifiedZip -Force
        }

        [System.IO.Compression.ZipFile]::CreateFromDirectory($extractDir, $modifiedZip)

        return [pscustomobject]@{
            ModifiedZip      = $modifiedZip
            XmlFilesChanged  = $xmlChanged
            UpdatedNodes     = $updated
            AddedNodes       = $added
            BlocksTouched    = $touched
            ContextsFound    = (@($contexts) -join " || ")
            SignalFiles      = (@($signals | ForEach-Object { $_.FilePath }) -join " || ")
        }
    }
    finally {
        if (Test-Path -LiteralPath $extractDir) {
            Remove-Item -LiteralPath $extractDir -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

# ---------------- VALIDATE CSV ----------------
Write-Log ("Using CSV path: {0}" -f $CsvPath) "Cyan"

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "CSV not found: $CsvPath"
}

$rows = @(Import-Csv -LiteralPath $CsvPath)
if (@($rows).Count -eq 0) {
    throw "CSV is empty: $CsvPath"
}

if (-not ($rows[0].PSObject.Properties.Name -contains "PlatformID")) {
    throw "CSV must contain column 'PlatformID'. Optional column: 'ConnectionComponentName'."
}

$rows = @($rows | Where-Object { -not [string]::IsNullOrWhiteSpace($_.PlatformID) })
if (@($rows).Count -eq 0) {
    throw "CSV contains no usable PlatformID values."
}

# ---------------- MAIN ----------------
$reportItems = New-Object System.Collections.Generic.List[object]
Write-Log ("Platforms to process: {0}" -f @($rows).Count) "Green"

try {
    Start-PASSessionFromCCP -ObjectName $CCPObject -UPUser $ServiceUPUser

    $index = 0
    foreach ($row in $rows) {
        $index++
        $platformID    = ([string]$row.PlatformID).Trim()
        $componentName = Get-OptionalCsvValue -Row $row -ColumnName "ConnectionComponentName"

        $report = [ordered]@{
            Timestamp               = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            PlatformID              = $platformID
            PlatformNumericID       = ""
            ConnectionComponentName = $componentName
            PSMServerId             = ""
            LinkedConnectorIDs      = ""
            BackupZip               = ""
            ModifiedZip             = ""
            XmlFilesChanged         = 0
            UpdatedNodes            = 0
            AddedNodes              = 0
            ContextsFound           = ""
            SignalFiles             = ""
            Result                  = ""
            Error                   = ""
        }

        Write-Log ("[{0}/{1}] {2}" -f $index, @($rows).Count, $platformID) "Magenta"

        try {
            $platformLookup = Get-PlatformByStringId -PlatformID $platformID
            $platformNumericID = [int]$platformLookup.ID
            $report.PlatformNumericID = $platformNumericID

            $null = Get-PlatformDetails -PlatformID $platformID

            $psmPolicy = Get-PlatformSessionManagementByNumericId -PlatformNumericID $platformNumericID
            $connectorList = @($psmPolicy.PSMConnectors)
            $report.PSMServerId = [string]$psmPolicy.PSMServerId
            $report.LinkedConnectorIDs = (($connectorList | ForEach-Object { $_.PSMConnectorID }) -join "; ")

            if (-not $connectorList -or $connectorList.Count -eq 0) {
                throw "No PSM connectors are linked to this platform."
            }

            if ($componentName) {
                $targetConnector = @($connectorList | Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_.PSMConnectorID) -and
                    (Normalize-Token $_.PSMConnectorID) -eq (Normalize-Token $componentName)
                })

                if ($targetConnector.Count -eq 0) {
                    throw ("Connector [{0}] is not linked to platform. Linked connectors: {1}" -f `
                        $componentName, $report.LinkedConnectorIDs)
                }

                Write-Log ("Validated connector [{0}] on platform." -f $componentName) "Green"
            }
            else {
                Write-Log ("Validated platform PSM linkage." ) "Green"
            }

            $exportZip = Export-PlatformZip -PlatformID $platformID -DestinationFolder $BackupRoot
            $report.BackupZip = $exportZip
            Write-Log "Platform export validated." "Green"

            $packageUpdate = Update-PlatformPackage `
                -PlatformID $platformID `
                -InputZip $exportZip `
                -WorkingRoot $WorkRoot `
                -ConnectionComponentName $componentName

            $report.ModifiedZip     = $packageUpdate.ModifiedZip
            $report.XmlFilesChanged = $packageUpdate.XmlFilesChanged
            $report.UpdatedNodes    = $packageUpdate.UpdatedNodes
            $report.AddedNodes      = $packageUpdate.AddedNodes
            $report.ContextsFound   = $packageUpdate.ContextsFound
            $report.SignalFiles     = $packageUpdate.SignalFiles

            if ($WhatIf) {
                Write-Log ("Validated editable package. UpdatedNodes={0}; AddedNodes={1}. WHATIF only." -f `
                    $packageUpdate.UpdatedNodes, $packageUpdate.AddedNodes) "Yellow"
                $report.Result = "WHATIF_ONLY"
            }
            else {
                Clear-StoredPlatformSilently
                $null = Import-PlatformZipToStorage -ZipPath $packageUpdate.ModifiedZip
                $null = Update-PlatformWithStored -PlatformID $platformID

                Write-Log ("Platform updated successfully. UpdatedNodes={0}; AddedNodes={1}" -f `
                    $packageUpdate.UpdatedNodes, $packageUpdate.AddedNodes) "Green"
                $report.Result = "UPDATED"
            }
        }
        catch {
            $report.Result = "FAILED"
            $report.Error  = $_.Exception.Message
            Write-Log ("FAILED: {0}" -f $_.Exception.Message) "Red"
        }
        finally {
            $reportItems.Add([pscustomobject]$report)
        }
    }
}
finally {
    try {
        if (Get-Command Close-PASSession -ErrorAction SilentlyContinue) {
            Close-PASSession | Out-Null
        }
    }
    catch {}
}

$reportPath = Join-Path $ReportRoot ("Platform_HTML5_Override_Report_{0}.csv" -f (Get-Date -Format "yyyyMMdd_HHmmss"))
$reportItems | Export-Csv -LiteralPath $reportPath -NoTypeInformation -Encoding UTF8

$success = @($reportItems | Where-Object { $_.Result -eq "UPDATED" -or $_.Result -eq "WHATIF_ONLY" }).Count
$failed  = @($reportItems | Where-Object { $_.Result -eq "FAILED" }).Count

Write-Log ("Report exported: {0}" -f $reportPath) "Green"
Write-Log ("Completed. Success/WhatIf: {0} | Failed: {1}" -f $success, $failed) "Cyan"
