# ============================================
# Export Discovered Accounts to CSV (psPAS + Privilege Cloud)
# ============================================

# Use TLS 1.2
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# Ensure psPAS is available
try {
    if (-not (Get-Module -ListAvailable -Name psPAS)) {
        Write-Host "psPAS not found. Installing to CurrentUser..." -ForegroundColor Yellow
        Install-Module psPAS -Scope CurrentUser -Force -AllowClobber -ErrorAction Stop
    }
    Import-Module psPAS -ErrorAction Stop
} catch {
    Write-Host "Failed to install/import psPAS: $_" -ForegroundColor Red
    exit 1
}

# Try to use IdentityCommand (for Identity-based auth to ISPSS) if present
$HasIdentityCmd = $false
try {
    if (Get-Module -ListAvailable -Name IdentityCommand) {
        Import-Module IdentityCommand -ErrorAction Stop
        $HasIdentityCmd = $true
    }
} catch {}

# Prompt for credentials
$Cred = Get-Credential -Message "Enter your CyberArk user (Identity user or local PVWA user)"

# Tenant / URLs
$TenantSubdomain = "alliantcredit"
$PrivilegeCloudBase = "https://$TenantSubdomain.privilegecloud.cyberark.cloud"

# Authenticate: Prefer Identity Shared Services; fall back to direct PVWA auth if Identity module isn't available
try {
    if ($HasIdentityCmd) {
        # Identity user auth to Privilege Cloud Shared Services
        New-PASSession -TenantSubdomain $TenantSubdomain -Credential $Cred -IdentityUser | Out-Null
        Write-Host "Authenticated via Identity Shared Services." -ForegroundColor Green
    } else {
        # Direct CyberArk (PVWA) auth
        New-PASSession -Credential $Cred -BaseURI $PrivilegeCloudBase -type CyberArk | Out-Null
        Write-Host "Authenticated directly to PVWA." -ForegroundColor Green
    }
} catch {
    Write-Host "Authentication failed: $_" -ForegroundColor Red
    exit 1
}

# Output paths
$OutDir   = Join-Path $env:USERPROFILE "Documents\CyberArkReports"
if (-not (Test-Path $OutDir)) { New-Item -ItemType Directory -Path $OutDir | Out-Null }
$Stamp    = (Get-Date).ToString("yyyyMMdd_HHmmss")
$CsvPath  = Join-Path $OutDir "DiscoveredAccounts_psPAS_$Stamp.csv"
$JsonPath = Join-Path $OutDir "DiscoveredAccounts_psPAS_$Stamp.json"

# Pull discovered accounts (Pending list) - up to 1000 per call
# If you routinely exceed 1000, run additional calls with search filters or segment by platformType.
try {
    $Discovered = Get-PASDiscoveredAccount -limit 1000
} catch {
    Write-Host "Failed to retrieve discovered accounts: $_" -ForegroundColor Red
    Close-PASSession | Out-Null
    exit 1
}

if (-not $Discovered -or $Discovered.Count -eq 0) {
    Write-Host "No discovered accounts returned. Check permissions (Vault Admins) and that discovery has results." -ForegroundColor Yellow
} else {
    # Save raw JSON for auditing
    $Discovered | ConvertTo-Json -Depth 6 | Out-File -FilePath $JsonPath -Encoding UTF8

    # Pick common properties if they exist; otherwise export everything (flattened)
    $preferredProps = @(
        'id','platformType','userName','address','domainName','machineName',
        'privileged','AccountEnabled','discoveryDate','osType','serviceName',
        'ip','dnsName'
    )

    $first = $Discovered | Select-Object -First 1
    $available = foreach ($p in $preferredProps) {
        if ($first.PSObject.Properties.Match($p)) { $p }
    }

    if ($available.Count -gt 0) {
        $Discovered | Select-Object -Property $available |
            Export-Csv -NoTypeInformation -Encoding UTF8 -Path $CsvPath
    } else {
        # Fallback: dump everything PowerShell can flatten
        $Discovered | ConvertTo-Csv -NoTypeInformation | Out-File -Encoding UTF8 $CsvPath
    }

    Write-Host "Export complete." -ForegroundColor Green
    Write-Host "CSV:  $CsvPath" -ForegroundColor Green
    Write-Host "JSON: $JsonPath" -ForegroundColor DarkGray
}

# Log off / close session
try { Close-PASSession | Out-Null } catch {}
