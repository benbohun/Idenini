
We are trying to identify accounts with the reconcile linked at the account level, that do not have a reconcile account at the platform level

something like

Get-PASLinkedAccount -id $account_id | Select extraPasswordIndex, Name, Descriptor, IsDefaultFromPolicy

Generate script using the login pattern below and export report of accounts that do not conform to the reconcile account defined at platform level.

Think thouroughly to define this

export report with details and show what reconcile account is set and what it has at platform level.

# ---------------- LOAD psPAS ----------------
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) "Green"
}
catch {
    Write-Log ("ERROR: psPAS module not found/loaded: {0}" -f $_.Exception.Message) "Red"
    exit 1
}

# ---------------- CCP + IDENTITY SETTINGS ----------------
$CCPAddress      = "https://vskau1p1231.cna.com"
$CCPLocation     = "AIMWebService"
$CCPAppID        = "PAMDiscovery"
$CCPSafe         = "CA_PCloud_Admins"
$CCPObject       = "cna.com-CA_PAMDiscovery_SVC"
$ServiceUPUser   = "CA_PAMDiscovery_SVC"
$CCPWindowsAuth  = $false

$IdentityTenantURL = "https://aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# ---------------- HELPERS ----------------
function Join-Names {
    param($arr)

    if (-not $arr) { return "" }

    try {
        return (($arr | ForEach-Object { $_.name } | Where-Object { $_ }) -join "; ")
    }
    catch {
        return ""
    }
}

function Join-PropNames {
    param($arr)

    if (-not $arr) { return "" }

    try {
        return (($arr | ForEach-Object { $_.name } | Where-Object { $_ }) -join "; ")
    }
    catch {
        return ""
    }
}

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $headers = @{ "Content-Type" = "application/json" }
    $ccpUrl  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"
    Write-Log ("CCP URL: {0}" -f $ccpUrl) "Gray"

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    Write-Log ("CCP secret retrieved successfully for: {0}" -f $UPUser) "Green"

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred

    Use-PASSession $headerSession

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

function Get-Platforms {
    param([string]$QueryString)

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms{1}" -f $PCloudSubdomain, $QueryString
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms{1}" -f $PCloudSubdomain, $QueryString

    try {
        Write-Log ("Calling: {0}" -f $u1) "Cyan"
        return Invoke-RestMethod -Uri $u1 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
    catch {
        Write-Log ("First endpoint failed, trying lowercase path. Reason: {0}" -f $_.Exception.Message) "Yellow"
        Write-Log ("Calling: {0}" -f $u2) "Cyan"
        return Invoke-RestMethod -Uri $u2 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
}

function Get-PlatformDetails {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)

    # Trailing slash helps when the platform name contains dots
    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/{1}/" -f $PCloudSubdomain, $encodedPlatformID
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/{1}/" -f $PCloudSubdomain, $encodedPlatformID

    try {
        Write-Log ("Calling platform details: {0}" -f $u1) "Gray"
        return Invoke-RestMethod -Uri $u1 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
    catch {
        Write-Log ("Platform details (uppercase path) failed for [{0}], trying lowercase path. Reason: {1}" -f $PlatformID, $_.Exception.Message) "Yellow"
        Write-Log ("Calling platform details: {0}" -f $u2) "Gray"
        return Invoke-RestMethod -Uri $u2 -Method GET -WebSession $s.WebSession -ErrorAction Stop
    }
}

function Get-PlatformExportZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID
    )

    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found. Auth failed or session not set."
    }

    $encodedPlatformID = [uri]::EscapeDataString($PlatformID)

    $tempRoot = Join-Path ([System.IO.Path]::GetTempPath()) ("CA_PlatformExport_" + [guid]::NewGuid().ToString("N"))
    $null = New-Item -ItemType Directory -Path $tempRoot -Force
    $zipPath = Join-Path $tempRoot ($PlatformID + ".zip")

    $u1 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/{1}/Export/" -f $PCloudSubdomain, $encodedPlatformID
    $u2 = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/api/Platforms/{1}/Export/" -f $PCloudSubdomain, $encodedPlatformID

    try {
        Write-Log ("Exporting platform package: {0}" -f $u1) "Gray"
        Invoke-WebRequest -Uri $u1 -Method POST -WebSession $s.WebSession -OutFile $zipPath -ErrorAction Stop | Out-Null
    }
    catch {
        Write-Log ("Platform export (uppercase path) failed for [{0}], trying lowercase path. Reason: {1}" -f $PlatformID, $_.Exception.Message) "Yellow"
        Write-Log ("Exporting platform package: {0}" -f $u2) "Gray"
        Invoke-WebRequest -Uri $u2 -Method POST -WebSession $s.WebSession -OutFile $zipPath -ErrorAction Stop | Out-Null
    }

    if (-not (Test-Path $zipPath)) {
        throw "Platform export did not produce a ZIP file."
    }

    return $zipPath
}

function Get-CaseInsensitiveMemberValue {
    param(
        [Parameter(Mandatory)]$InputObject,
        [Parameter(Mandatory)][string[]]$Names
    )

    if ($null -eq $InputObject) { return $null }

    if ($InputObject -is [System.Collections.IDictionary]) {
        foreach ($n in $Names) {
            foreach ($k in $InputObject.Keys) {
                if ([string]$k -ieq $n) {
                    return $InputObject[$k]
                }
            }
        }
        return $null
    }

    $propNames = @($InputObject.PSObject.Properties.Name)
    foreach ($n in $Names) {
        $match = $propNames | Where-Object { $_ -ieq $n } | Select-Object -First 1
        if ($match) {
            return $InputObject.$match
        }
    }

    return $null
}


