 Function Show-RoleMenu {
     param (
           [string]$Title = 'ROLES'
     )
    
    Write-Host ""
    Write-Host ""
    Write-Host ""
    Write-Host ""
    Write-Host -BackgroundColor Gray -ForegroundColor Black   "                $Title                  "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "                                       "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[0] Admin                              "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[1] Privileged-Owner                   "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[2] Privileged-Shared-AccessNoConfirm  "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[3] Privileged-Shared-AccessConfirm    "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[4] Service-Owner                      "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[5] Service-User                       "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[6] Application-Owner                  "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[7] ApproverLevel1                     "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[8] ApproverLevel2                     "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "[9] Custom                             "
       #Add New Tool Here
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "                                       "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "                                       "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Yellow "Press 'q' to quit.                     "
    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray  "                                       "
    Write-Host ""
    Write-Host ""

    } 
 Function AddSafeMember {

                $Error.clear()
                $Group = "$($Group)@mbh.mhs.magellanhealth.com"
                $RoleVaultUser | Add-PASSafeMember -SafeName $Safe -memberType Group -MemberName $Group -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue

                If (!($Error)) {
                    
                    $result = Get-PASSafeMember -SafeName $Safe

                    If ($Group -in $result.Username) {

                    Write-Host -ForegroundColor Green "Successfully added group"
                    Write-Host ""
                    pause
                    
            
                    }

                    Else {

                    Write-Host -ForegroundColor Red "Failed to add group"
                    Write-Host ""
                    pause

                    }
    
                }

                Else {
                
                    Write-Host -ForegroundColor Red -BackgroundColor Black "Error adding $($Group) to $($Safe)"
                    Write-Host -ForegroundColor Red -BackgroundColor Black "Error: $($Error.exception.message)"
                    Write-Host ""
                }
                
            }
 Function Admin {$RoleVaultUser = [PSCustomObject]@{
                        UseAccounts                            = $true
                        RetrieveAccounts                       = $true
                        ListAccounts                           = $true
                        AddAccounts                            = $true
                        UpdateAccountContent                   = $true
                        UpdateAccountProperties                = $true
                        InitiateCPMAccountManagementOperations = $true
                        SpecifyNextAccountContent              = $true
                        RenameAccounts                         = $true
                        DeleteAccounts                         = $true
                        UnlockAccounts                         = $true
                        ManageSafe                             = $false
                        ManageSafeMembers                      = $false
                        BackupSafe                             = $false
                        ViewAuditLog                           = $true
                        ViewSafeMembers                        = $true
                        RequestsAuthorizationLevel1            = $false
                        RequestsAuthorizationLevel2            = $false
                        AccessWithoutConfirmation              = $true
                        CreateFolders                          = $false
                        DeleteFolders                          = $false
                        MoveAccountsAndFolders                 = $false
                        }
                    AddSafeMember  
                    }
 Function Privileged-Owner {$RoleVaultUser = [PSCustomObject]@{
                            UseAccounts                            = $true
                            RetrieveAccounts                       = $true
                            ListAccounts                           = $true
                            UpdateAccountContent                   = $false
                            InitiateCPMAccountManagementOperations = $true
                            ViewAuditLog                           = $true
                            ViewSafeMembers                        = $true
                            AccessWithoutConfirmation              = $true
                            UnlockAccounts                         = $false

                            }
                          AddSafeMember
                        }
 Function Privileged-Shared-AccessNoConfirm {$RoleVaultUser = [PSCustomObject]@{
                            UseAccounts                            = $true
                            RetrieveAccounts                       = $true
                            ListAccounts                           = $true
                            UpdateAccountContent                   = $false
                            InitiateCPMAccountManagementOperations = $true
                            ViewAuditLog                           = $true
                            ViewSafeMembers                        = $true
                            AccessWithoutConfirmation              = $true
                            UnlockAccounts                         = $false

                            }
                          AddSafeMember
                        }
