<# =====================================================================
WinRc1384_Accounts_ACTIVITY_REVIEW.ps1

- CCP -> Identity Header -> psPAS (same login approach)
- Finds accounts that experienced:
    Reason: During a logon attempt, the user's security context accumulated too many security IDs. (winRc=1384)
- Reviews:
    1) account-level secretManagement / lastTask / lastFailedTask text
    2) account activity history for EVERY account
- Designed to catch older verify failures even when account is now healthy/reconciled

Exports ONLY:
  AccountID, Username, Address, Safe, Platform

Outputs:
  E:\Installation Media\Script\OnboardScript\data\WinRc1384_Accounts.csv
  E:\Installation Media\Script\OnboardScript\data\WinRc1384_Accounts.log
===================================================================== #>

[CmdletBinding()]
param(
    [ValidateRange(1,1000)]
    [int]$PageSize = 1000,

    [ValidateRange(1,200000)]
    [int]$MaxAccountsToInspect = 50000,

    [ValidateRange(1,2000)]
    [int]$MaxActivitiesToInspect = 250
)

# =========================
# Baseline
# =========================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force

# =========================
# Output paths
# =========================
$OutDir = "E:\Installation Media\Script\OnboardScript\data"
if (-not (Test-Path $OutDir)) {
    New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
}

$LogFile = Join-Path $OutDir "WinRc1384_Accounts.log"
$CsvFile = Join-Path $OutDir "WinRc1384_Accounts.csv"
New-Item -ItemType File -Force -Path $LogFile -Force | Out-Null

# =========================
# Global result trackers
# =========================
$script:Results = New-Object 'System.Collections.Generic.List[object]'
$script:SeenIds = @{}

function Write-Log {
    param(
        [string]$Message,
        [ConsoleColor]$Color = 'White'
    )
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# =========================
# CCP / Identity config
# =========================
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# =========================
# Match logic
# =========================
$NeedleRegex = '(?i)winRc\s*=\s*1384|security\s+context\s+accumulated\s+too\s+many\s+security\s+ids|too\s+many\s+security\s+ids'

# =========================
# Login helper: CCP -> Identity header -> psPAS
# =========================
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,
        [Parameter(Mandatory)] [string]$UPUser
    )

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log "Retrieving CCP credential for '$UPUser' via Object..." 'Cyan'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }

    Write-Log "CCP returned username for service principal." 'Green'

    $secPass = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upCred  = [PSCredential]::new($UPUser, $secPass)

    Write-Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." 'Cyan'
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upCred

    Use-PASSession $hdr
    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    $resp.Content = $null
    Write-Log "PAS session established." 'Green'
}

function Cmd-HasParam {
    param(
        [string]$CommandName,
        [string]$ParamName
    )
    $cmd = Get-Command $CommandName -ErrorAction Stop
    return $cmd.Parameters.ContainsKey($ParamName)
}

function Get-AccountsPaged {
    param(
        [string]$SavedFilter,
        [int]$Limit = 1000
    )

    $all = New-Object System.Collections.Generic.List[object]
    $offset = 0

    $hasSavedFilter = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "savedFilter"
    $hasOffset      = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "offset"
    $hasLimit       = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "limit"

    while ($true) {
        $params = @{}

        if ($SavedFilter -and $hasSavedFilter) { $params["savedFilter"] = $SavedFilter }
        if ($hasLimit)  { $params["limit"]  = $Limit }
        if ($hasOffset) { $params["offset"] = $offset }

        if (-not $hasOffset -and $offset -gt 0) { break }

        $page = @()
        try {
            $page = @(Get-PASAccount @params -ErrorAction Stop)
        }
        catch {
            if ($SavedFilter -and -not $hasSavedFilter) {
                $page = @(Get-PASAccount -ErrorAction Stop)
            }
            else {
                throw
            }
        }

        if ($page.Count -eq 0) { break }

        foreach ($acct in $page) {
            $all.Add($acct) | Out-Null
        }

        if (-not $hasOffset) { break }
        if ($page.Count -lt $Limit) { break }
        if ($all.Count -ge $MaxAccountsToInspect) { break }

        $offset += $Limit
    }

    return @(
        $all |
        Group-Object id |
        ForEach-Object { $_.Group | Select-Object -First 1 }
    )
}

function Get-ActivitiesSafe {
    param([string]$AccountId)

    try {
        return @(Get-PASAccountActivity -AccountID $AccountId -ErrorAction Stop)
    }
    catch {
        return @(Get-PASAccountActivity -AccountID $AccountId -UseGen1API -ErrorAction Stop)
    }
}

function Get-DeepScalarText {
    param(
        [Parameter(Mandatory)] [object]$InputObject,
        [int]$MaxDepth = 8
    )

    $parts = New-Object System.Collections.Generic.List[string]

    function Add-DeepScalarText {
        param(
            [object]$Obj,
            [int]$Depth,
            [System.Collections.Generic.List[string]]$Bucket
        )

        if ($null -eq $Obj) { return }
        if ($Depth -lt 0) { return }

        if ($Obj -is [string] -or $Obj -is [char] -or $Obj -is [ValueType] -or $Obj -is [datetime]) {
            $s = [string]$Obj
            if (-not [string]::IsNullOrWhiteSpace($s)) {
                $Bucket.Add($s) | Out-Null
            }
            return
        }

        if ($Obj -is [System.Collections.IDictionary]) {
            foreach ($k in $Obj.Keys) {
                try { Add-DeepScalarText -Obj $Obj[$k] -Depth ($Depth - 1) -Bucket $Bucket } catch {}
            }
            return
        }

        if (($Obj -is [System.Collections.IEnumerable]) -and -not ($Obj -is [string])) {
            foreach ($item in $Obj) {
                try { Add-DeepScalarText -Obj $item -Depth ($Depth - 1) -Bucket $Bucket } catch {}
            }
            return
        }

        foreach ($prop in $Obj.PSObject.Properties) {
            if ($prop.MemberType -notin @('NoteProperty','Property','AliasProperty','ScriptProperty')) { continue }
            try {
                Add-DeepScalarText -Obj $prop.Value -Depth ($Depth - 1) -Bucket $Bucket
            }
            catch {}
        }
    }

    try {
        $json = $InputObject | ConvertTo-Json -Depth $MaxDepth -Compress -ErrorAction Stop
        if (-not [string]::IsNullOrWhiteSpace($json)) {
            $parts.Add($json) | Out-Null
        }
    }
    catch {}

    Add-DeepScalarText -Obj $InputObject -Depth $MaxDepth -Bucket $parts

    return (
        $parts |
        Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
        Select-Object -Unique
    ) -join ' | '
}

function AccountMatchesFast {
    param([object]$Acct)

    $segments = New-Object System.Collections.Generic.List[string]

    try {
        if ($Acct.secretManagement) {
            $txt = Get-DeepScalarText -InputObject $Acct.secretManagement -MaxDepth 6
            if ($txt) { $segments.Add($txt) | Out-Null }
        }
    } catch {}

    if ($segments.Count -eq 0) { return $false }

    $hay = ($segments -join ' | ')
    return ($hay -match $NeedleRegex)
}

function ActivityMatchesFast {
    param([object]$Activity)

    $hay = Get-DeepScalarText -InputObject $Activity -MaxDepth 8
    if (-not $hay) { return $false }

    return ($hay -match $NeedleRegex)
}

function Add-ResultRow {
    param(
        [Parameter(Mandatory)] [object]$Acct
    )

    $id = [string]$Acct.id
    if ([string]::IsNullOrWhiteSpace($id)) { return $false }

    if ($script:SeenIds.ContainsKey($id)) { return $false }

    $script:SeenIds[$id] = $true

    $row = [PSCustomObject]@{
        AccountID = [string]$Acct.id
        Username  = [string]$Acct.userName
        Address   = [string]$Acct.address
        Safe      = [string]$Acct.safeName
        Platform  = [string]$Acct.platformId
    }

    $script:Results.Add($row) | Out-Null
    return $true
}

# =========================
# MAIN
# =========================
try {
    Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC"

    Write-Log "Searching for accounts that have experienced winRc=1384..." 'Yellow'
    Write-Log "NeedleRegex: $NeedleRegex" 'DarkYellow'
    Write-Log "Pulling full inventory..." 'Cyan'

    $accounts = @(Get-AccountsPaged -SavedFilter $null -Limit $PageSize)
    Write-Log "Inventory returned $($accounts.Count) account(s)." 'Green'

    $inspected            = 0
    $fastHits             = 0
    $activityHits         = 0
    $activityReadFailures = 0

    foreach ($acct in $accounts) {
        $inspected++

        if ($inspected -gt $MaxAccountsToInspect) {
            Write-Log "Safety stop reached at $MaxAccountsToInspect accounts." 'Yellow'
            break
        }

        if ($inspected % 100 -eq 0) {
            Write-Log "Progress: inspected $inspected / $($accounts.Count). FastHits=$fastHits ActivityHits=$activityHits ReadFailures=$activityReadFailures" 'DarkGray'
        }

        $matched = $false

        # -------- FAST PATH: account-level secretManagement text --------
        try {
            if (AccountMatchesFast -Acct $acct) {
                if (Add-ResultRow -Acct $acct) {
                    $fastHits++
                    Write-Log ("FAST MATCH: AccountID={0} User={1} Address={2} Safe={3} Platform={4}" -f `
                        [string]$acct.id, [string]$acct.userName, [string]$acct.address, [string]$acct.safeName, [string]$acct.platformId) 'Green'
                }
                $matched = $true
            }
        }
        catch {
            Write-Log ("FAST PATH inspection failed for AccountID={0}: {1}" -f [string]$acct.id, $_.Exception.Message) 'DarkYellow'
        }

        if ($matched) { continue }

        # -------- AUTHORITATIVE PATH: review account activity history --------
        $acts = @()
        try {
            $acts = @(Get-ActivitiesSafe -AccountId $acct.id)
        }
        catch {
            $activityReadFailures++
            Write-Log ("Could not read activities for AccountID={0}: {1}" -f [string]$acct.id, $_.Exception.Message) 'DarkYellow'
            continue
        }

        if ($acts.Count -eq 0) { continue }

        foreach ($act in ($acts | Select-Object -First $MaxActivitiesToInspect)) {
            $isMatch = $false

            try {
                $isMatch = ActivityMatchesFast -Activity $act
            }
            catch {
                Write-Log ("Activity inspection error for AccountID={0}: {1}" -f [string]$acct.id, $_.Exception.Message) 'DarkYellow'
            }

            if (-not $isMatch) { continue }

            if (Add-ResultRow -Acct $acct) {
                $activityHits++
                Write-Log ("ACTIVITY MATCH: AccountID={0} User={1} Address={2} Safe={3} Platform={4}" -f `
                    [string]$acct.id, [string]$acct.userName, [string]$acct.address, [string]$acct.safeName, [string]$acct.platformId) 'Green'
            }
            break
        }
    }

    # =========================
    # Export
    # =========================
    if ($script:Results.Count -gt 0) {
        $script:Results |
            Sort-Object Safe, Address, Username |
            Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8

        Write-Log "Exported $($script:Results.Count) matching account(s) to: $CsvFile" 'Green'
    }
    else {
        Write-Log "No matching accounts found." 'Yellow'
        @(
            [PSCustomObject]@{
                AccountID = ""
                Username  = ""
                Address   = ""
                Safe      = ""
                Platform  = ""
            }
        ) | Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8
    }

    Write-Log "Summary: FastHits=$fastHits ActivityHits=$activityHits ReadFailures=$activityReadFailures Total=$($script:Results.Count)" 'Cyan'
}
finally {
    try { Close-PASSession | Out-Null } catch {}
    Write-Log "Done." 'Green'
}
