<#
Test_SWS_TokenGeneration_Only_V7_AllTenantCandidates.ps1

Purpose:
- Token-generation-only diagnostic for CyberArk Secure Web Sessions (SWS) service accounts.
- Does NOT create Identity apps.
- Does NOT call SWS policy APIs unless -ValidateAgainstSwsApi is used.
- Uses CyberArk public-api-auth-helper*.jar and the SWS service-account JSON.
- Tries all likely tenant formats, including Identity tenant alias aat4012 and SWS tenant GUID variants.
- PowerShell 5.1 compatible.

Expected files in same folder as script:
- public-api-auth-helper-*.jar
- one SWS service-account JSON file containing serviceAccountId/privateKey/discoveryURI
- optional portable Java path below, already defaulted for your folder
#>

[CmdletBinding()]
param(
    [string]$JavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',
    [string]$SwsAuthHelperJarPath = '',
    [string]$SwsServiceAccountJsonPath = '',

    # Try short Identity tenant alias AND long SWS tenant GUID formats.
    [string[]]$TenantCandidates = @(
        'aat4012',
        'eef31a0b-0e67-4024-a644-be08614190db',
        'eef31a0b0e674024a644be08614190db'
    ),

    [int]$TimeoutSeconds = 60,
    [switch]$ShowToken,
    [switch]$SaveTokenToFile,
    [switch]$ValidateAgainstSwsApi,
    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',

    # Optional Java proxy flags for helper JAR. Leave blank unless needed.
    # Example: -ProxyAddress 'http://proxy.company.com:8080'
    [string]$ProxyAddress = '',

    [switch]$NoPause
)

$ErrorActionPreference = 'Stop'
$script:HadFatal = $false

function Get-ScriptRootSafe {
    if ($PSScriptRoot) { return $PSScriptRoot }
    return (Split-Path -Parent $MyInvocation.MyCommand.Path)
}

$ScriptRoot = Get-ScriptRootSafe
$LogPath = Join-Path $ScriptRoot 'SWS_TokenGeneration_Only_V7.log'

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $line = '{0} - {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogPath -Value $line } catch {}
}

function Quote-CmdArg {
    param([Parameter(Mandatory)][string]$Value)
    return '"' + ($Value -replace '"','\"') + '"'
}

function Read-TextFileSafe {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) { return '' }
    try { return [System.IO.File]::ReadAllText($Path) } catch { return '' }
}

function Get-MaskedToken {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 24) { return ('*' * $Token.Length) }
    return ($Token.Substring(0,12) + '...' + $Token.Substring($Token.Length - 8))
}

function Resolve-JavaPath {
    param([string]$Preferred)
    $candidates = New-Object System.Collections.Generic.List[string]
    if (-not [string]::IsNullOrWhiteSpace($Preferred)) { [void]$candidates.Add($Preferred) }
    [void]$candidates.Add((Join-Path $ScriptRoot 'java.exe'))
    [void]$candidates.Add((Join-Path $ScriptRoot 'java\bin\java.exe'))
    [void]$candidates.Add((Join-Path $ScriptRoot 'jre\bin\java.exe'))
    [void]$candidates.Add((Join-Path $ScriptRoot 'jdk\bin\java.exe'))

    foreach ($c in $candidates) {
        if (-not [string]::IsNullOrWhiteSpace($c) -and (Test-Path -LiteralPath $c)) {
            return (Resolve-Path -LiteralPath $c).Path
        }
    }

    $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
    if ($cmd) { return $cmd.Source }

    throw 'java.exe was not found. Pass -JavaPath with the full path to java.exe.'
}

function Test-JavaVersion {
    param([Parameter(Mandatory)][string]$JavaExe)
    $stdout = Join-Path $ScriptRoot ('JavaVersion_stdout_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    $stderr = Join-Path $ScriptRoot ('JavaVersion_stderr_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $JavaExe
    $psi.Arguments = '-version'
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi
    [void]$p.Start()
    $out = $p.StandardOutput.ReadToEnd()
    $err = $p.StandardError.ReadToEnd()
    $p.WaitForExit()
    $combined = (($out + "`n" + $err).Trim())
    if ($p.ExitCode -ne 0) { throw "java -version failed. ExitCode=$($p.ExitCode); Output=$combined" }
    if ([string]::IsNullOrWhiteSpace($combined)) { $combined = '<no version text returned>' }
    Write-Log "Java version output: $combined" 'Gray'
}

function Resolve-HelperJar {
    param([string]$Preferred)
    if (-not [string]::IsNullOrWhiteSpace($Preferred)) {
        if (-not (Test-Path -LiteralPath $Preferred)) { throw "Specified helper JAR not found: $Preferred" }
        return (Resolve-Path -LiteralPath $Preferred).Path
    }

    $jars = @(Get-ChildItem -LiteralPath $ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) { throw "No public-api-auth-helper*.jar found in $ScriptRoot" }
    if ($jars.Count -gt 1) {
        Write-Log "Multiple helper JARs found. Using newest: $($jars[0].Name)" 'Yellow'
        foreach ($j in $jars) { Write-Log "JAR candidate: $($j.Name); LastWriteTime=$($j.LastWriteTime)" 'Gray' }
    }
    return $jars[0].FullName
}

function Resolve-SwsJson {
    param([string]$Preferred)
    if (-not [string]::IsNullOrWhiteSpace($Preferred)) {
        if (-not (Test-Path -LiteralPath $Preferred)) { throw "Specified SWS JSON not found: $Preferred" }
        return (Resolve-Path -LiteralPath $Preferred).Path
    }

    $valid = New-Object System.Collections.Generic.List[object]
    $jsonFiles = @(Get-ChildItem -LiteralPath $ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    foreach ($f in $jsonFiles) {
        try {
            $obj = Get-Content -LiteralPath $f.FullName -Raw | ConvertFrom-Json
            $sid = [string]$obj.serviceAccountId
            $pk  = [string]$obj.privateKey
            $du  = [string]$obj.discoveryURI
            if (-not [string]::IsNullOrWhiteSpace($sid) -and -not [string]::IsNullOrWhiteSpace($pk) -and -not [string]::IsNullOrWhiteSpace($du)) {
                $valid.Add([pscustomobject]@{ File=$f; ServiceAccountId=$sid; DiscoveryURI=$du }) | Out-Null
            }
        } catch {}
    }

    Write-Log "Valid SWS JSON file count=$($valid.Count)" 'Cyan'
    foreach ($v in $valid) {
        Write-Log "JSON candidate: File=$($v.File.Name); ServiceAccountId=$($v.ServiceAccountId); LastWriteTime=$($v.File.LastWriteTime)" 'Gray'
    }

    if ($valid.Count -eq 0) { throw "No valid SWS service-account JSON found in $ScriptRoot" }
    return $valid[0].File.FullName
}

function Get-JsonSummary {
    param([Parameter(Mandatory)][string]$JsonPath)
    $obj = Get-Content -LiteralPath $JsonPath -Raw | ConvertFrom-Json
    return [pscustomobject]@{
        ServiceAccountId = [string]$obj.serviceAccountId
        DiscoveryURI     = [string]$obj.discoveryURI
    }
}

function Get-UniqueTenantCandidates {
    param([string[]]$InputCandidates)
    $list = New-Object System.Collections.Generic.List[string]
    foreach ($t in @($InputCandidates)) {
        if ([string]::IsNullOrWhiteSpace($t)) { continue }
        $clean = $t.Trim()
        if ($clean -match '^https?://([^./]+)\.') {
            $alias = $Matches[1]
            if (-not $list.Contains($alias)) { [void]$list.Add($alias) }
        }
        if (-not $list.Contains($clean)) { [void]$list.Add($clean) }
        $dashless = ($clean -replace '-','')
        if ($dashless -ne $clean -and -not $list.Contains($dashless)) { [void]$list.Add($dashless) }
    }
    return @($list)
}

function Get-AccessTokenFromText {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $null }

    # JSON style: "access_token":"..."
    $m = [regex]::Match($Text, '"access_token"\s*:\s*"(?<token>[^"\r\n]+)"')
    if ($m.Success) { return $m.Groups['token'].Value }

    # key=value or key: value style
    $m = [regex]::Match($Text, '(?im)^\s*access_token\s*[:=]\s*(?<token>[^\s]+)\s*$')
    if ($m.Success) { return $m.Groups['token'].Value }

    # Bare JWT fallback. Access tokens are often JWTs: eyJ...
    $m = [regex]::Match($Text, '(?<token>eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+)')
    if ($m.Success) { return $m.Groups['token'].Value }

    return $null
}

function Invoke-HelperAttempt {
    param(
        [Parameter(Mandatory)][string]$JavaExe,
        [Parameter(Mandatory)][string]$JarPath,
        [Parameter(Mandatory)][string]$TenantId,
        [Parameter(Mandatory)][string]$JsonPath,
        [Parameter(Mandatory)][int]$AttemptNumber
    )

    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $stdout = Join-Path $ScriptRoot ("SWS_Helper_Attempt_{0}_{1}_stdout.txt" -f $AttemptNumber, $stamp)
    $stderr = Join-Path $ScriptRoot ("SWS_Helper_Attempt_{0}_{1}_stderr.txt" -f $AttemptNumber, $stamp)

    $javaArgs = New-Object System.Collections.Generic.List[string]
    if (-not [string]::IsNullOrWhiteSpace($ProxyAddress)) {
        try {
            $uri = [Uri]$ProxyAddress
            if ($uri.Host) {
                [void]$javaArgs.Add('-Dhttp.proxyHost=' + $uri.Host)
                [void]$javaArgs.Add('-Dhttps.proxyHost=' + $uri.Host)
                if ($uri.Port -gt 0) {
                    [void]$javaArgs.Add('-Dhttp.proxyPort=' + $uri.Port)
                    [void]$javaArgs.Add('-Dhttps.proxyPort=' + $uri.Port)
                }
            }
        } catch {
            Write-Log "ProxyAddress could not be parsed for Java proxy flags: $ProxyAddress" 'Yellow'
        }
    }
    [void]$javaArgs.Add('-jar')
    [void]$javaArgs.Add($JarPath)
    [void]$javaArgs.Add('-t')
    [void]$javaArgs.Add($TenantId)
    [void]$javaArgs.Add('-p')
    [void]$javaArgs.Add($JsonPath)

    $argString = ($javaArgs | ForEach-Object { Quote-CmdArg $_ }) -join ' '

    Write-Log "Helper token attempt #$AttemptNumber: TenantId=$TenantId" 'Cyan'
    Write-Log "Helper stdout file: $stdout" 'Gray'
    Write-Log "Helper stderr file: $stderr" 'Gray'
    Write-Log "Command preview: $(Split-Path -Leaf $JavaExe) -jar $(Split-Path -Leaf $JarPath) -t $TenantId -p $(Split-Path -Leaf $JsonPath)" 'Gray'

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $JavaExe
    $psi.Arguments = $argString
    $psi.WorkingDirectory = $ScriptRoot
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true

    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi
    [void]$p.Start()

    $completed = $p.WaitForExit($TimeoutSeconds * 1000)
    if (-not $completed) {
        try { $p.Kill() } catch {}
        Write-Log "FAILED: Helper attempt #$AttemptNumber timed out after $TimeoutSeconds seconds." 'Red'
        return [pscustomobject]@{ Success=$false; ExitCode=-999; Token=$null; Output='Timed out'; StdoutPath=$stdout; StderrPath=$stderr }
    }

    $out = $p.StandardOutput.ReadToEnd()
    $err = $p.StandardError.ReadToEnd()
    [System.IO.File]::WriteAllText($stdout, $out)
    [System.IO.File]::WriteAllText($stderr, $err)

    $combined = (($out + "`n" + $err).Trim())
    $token = Get-AccessTokenFromText -Text $combined

    Write-Log "Helper attempt #$AttemptNumber completed. ExitCode=$($p.ExitCode); OutputLength=$($combined.Length)" 'Gray'

    if (-not [string]::IsNullOrWhiteSpace($token)) {
        Write-Log "SUCCESS: Helper returned access_token. Masked=$(Get-MaskedToken $token); Length=$($token.Length)" 'Green'
        return [pscustomobject]@{ Success=$true; ExitCode=$p.ExitCode; Token=$token; Output=$combined; StdoutPath=$stdout; StderrPath=$stderr }
    }

    $preview = $combined
    if ($preview.Length -gt 1600) { $preview = $preview.Substring(0,1600) + '...' }
    Write-Log "FAILED: Helper did not return access_token. ExitCode=$($p.ExitCode). OutputPreview=$preview" 'Red'
    return [pscustomobject]@{ Success=$false; ExitCode=$p.ExitCode; Token=$null; Output=$combined; StdoutPath=$stdout; StderrPath=$stderr }
}

function Test-SwsApiToken {
    param([Parameter(Mandatory)][string]$Token)
    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    Write-Log "Validating generated token with SWS API GET: $uri" 'Cyan'
    $headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }
    try {
        $resp = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        Write-Log "SWS API validation succeeded." 'Green'
        return $true
    } catch {
        $status = $null
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log "SWS API validation failed. Status=$status; Error=$($_.Exception.Message)" 'Red'
        return $false
    }
}

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V7 Started =====' 'Cyan'
    Write-Log "ScriptRoot=$ScriptRoot" 'Gray'
    Write-Log "LogPath=$LogPath" 'Gray'

    $resolvedJava = Resolve-JavaPath -Preferred $JavaPath
    Write-Log "Testing Java executable: $resolvedJava" 'Cyan'
    Test-JavaVersion -JavaExe $resolvedJava

    $resolvedJar = Resolve-HelperJar -Preferred $SwsAuthHelperJarPath
    Write-Log "Using helper JAR: $resolvedJar" 'Cyan'

    $resolvedJson = Resolve-SwsJson -Preferred $SwsServiceAccountJsonPath
    Write-Log "Using SWS service-account JSON: $resolvedJson" 'Cyan'

    $summary = Get-JsonSummary -JsonPath $resolvedJson
    Write-Log "JSON summary: ServiceAccountId=$($summary.ServiceAccountId); DiscoveryURI=$($summary.DiscoveryURI)" 'Cyan'

    $tenants = Get-UniqueTenantCandidates -InputCandidates $TenantCandidates
    Write-Log "Tenant candidate count=$($tenants.Count); Candidates=$($tenants -join ', ')" 'Cyan'

    $attempt = 0
    $successToken = $null
    foreach ($tenant in $tenants) {
        $attempt++
        $result = Invoke-HelperAttempt -JavaExe $resolvedJava -JarPath $resolvedJar -TenantId $tenant -JsonPath $resolvedJson -AttemptNumber $attempt
        if ($result.Success) {
            $successToken = $result.Token
            break
        }
    }

    if ([string]::IsNullOrWhiteSpace($successToken)) {
        throw 'TOKEN GENERATION FAILED. No access_token was returned by the CyberArk helper for any tenant candidate. Review SWS_Helper_Attempt_*_stdout/stderr files.'
    }

    Write-Log 'TOKEN GENERATION SUCCESS.' 'Green'
    if ($ShowToken) {
        Write-Host ''
        Write-Host '===== RAW access_token START =====' -ForegroundColor Yellow
        Write-Host $successToken
        Write-Host '===== RAW access_token END =====' -ForegroundColor Yellow
        Write-Host ''
    }
    if ($SaveTokenToFile) {
        $tokenPath = Join-Path $ScriptRoot ('SWS_access_token_{0}.txt' -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
        [System.IO.File]::WriteAllText($tokenPath, $successToken)
        Write-Log "Token saved to: $tokenPath" 'Yellow'
    }
    if ($ValidateAgainstSwsApi) {
        [void](Test-SwsApiToken -Token $successToken)
    }

    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V7 Finished: SUCCESS =====' 'Green'
}
catch {
    $script:HadFatal = $true
    Write-Log ("FATAL ERROR: {0}" -f $_.Exception.Message) 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V7 Finished: FAILED =====' 'Red'
}
finally {
    if (-not $NoPause) {
        try { Read-Host 'Press ENTER to close this token diagnostic window' | Out-Null } catch {}
    }
}

if ($script:HadFatal) { exit 1 } else { exit 0 }
