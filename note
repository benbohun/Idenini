# ---------------- HELPERS ----------------
function Normalize-Token {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return "" }
    return (($Value.ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function Get-SafeFileName {
    param([Parameter(Mandatory)][string]$Name)
    return ($Name -replace '[\\/:*?"<>|]', '_')
}

function Get-OptionalCsvValue {
    param(
        [Parameter(Mandatory)]$Row,
        [Parameter(Mandatory)][string]$ColumnName
    )

    $prop = $Row.PSObject.Properties[$ColumnName]
    if ($null -eq $prop) { return $null }

    $value = [string]$prop.Value
    if ([string]::IsNullOrWhiteSpace($value)) { return $null }

    return $value.Trim()
}

function Set-XmlAttribute {
    param(
        [Parameter(Mandatory)]$Element,
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$Value
    )

    $existing = $Element.GetAttributeNode($Name)
    if ($null -eq $existing) {
        $attr = $Element.OwnerDocument.CreateAttribute($Name)
        $attr.Value = $Value
        [void]$Element.Attributes.Append($attr)
    }
    else {
        $existing.Value = $Value
    }
}

function Apply-AllowSelectHtml5Values {
    param([Parameter(Mandatory)]$ParameterNode)

    Set-XmlAttribute -Element $ParameterNode -Name "Name" -Value $AllowSelectHtml5Param.Name
    Set-XmlAttribute -Element $ParameterNode -Name "DisplayName" -Value $AllowSelectHtml5Param.DisplayName
    Set-XmlAttribute -Element $ParameterNode -Name "Visible" -Value $AllowSelectHtml5Param.Visible
    Set-XmlAttribute -Element $ParameterNode -Name "Type" -Value $AllowSelectHtml5Param.Type
    Set-XmlAttribute -Element $ParameterNode -Name "Required" -Value $AllowSelectHtml5Param.Required
    Set-XmlAttribute -Element $ParameterNode -Name "Value" -Value $AllowSelectHtml5Param.Value
    Set-XmlAttribute -Element $ParameterNode -Name "EnforceInDualControlRequest" -Value $AllowSelectHtml5Param.EnforceInDualControlRequest
}

function Get-PASWebSession {
    $s = Get-PASSession
    if (-not $s -or -not $s.WebSession) {
        throw "No psPAS WebSession found."
    }
    return $s.WebSession
}

function Get-HttpStatusCodeFromError {
    param([Parameter(Mandatory)]$ErrorRecord)

    try {
        if ($ErrorRecord.Exception.Response -and $ErrorRecord.Exception.Response.StatusCode) {
            return [int]$ErrorRecord.Exception.Response.StatusCode
        }
    }
    catch {}

    try {
        if ($ErrorRecord.Exception.StatusCode) {
            return [int]$ErrorRecord.Exception.StatusCode
        }
    }
    catch {}

    return $null
}

# ---------------- AUTH ----------------
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName,
        [Parameter(Mandatory)][string]$UPUser
    )

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

    $ccpUrl = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $CCPAddress.TrimEnd('/'),
        $CCPLocation.Trim('/'),
        $CCPAppID,
        $CCPSafe,
        $ObjectName

    Write-Log "Retrieving API credentials from CCP..." "Cyan"

    $resp = Invoke-RestMethod `
        -Uri $ccpUrl `
        -Method GET `
        -Headers @{ "Content-Type" = "application/json" } `
        -UseDefaultCredentials:$CCPWindowsAuth `
        -ErrorAction Stop

    if (-not $resp -or -not $resp.Content) {
        throw "Empty CCP response (missing Content)."
    }

    $UPPass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    Write-Log ("Authenticating to Privilege Cloud via Identity header as {0}..." -f $UPUser) "Cyan"

    $headerSession = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred `
        -ErrorAction Stop

    Use-PASSession $headerSession | Out-Null

    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    Write-Log ("PAS session established ({0})." -f $UPUser) "Green"
}

# ---------------- REST ----------------
function Invoke-EPVRest {
    param(
        [Parameter(Mandatory)]
        [ValidateSet("GET","POST","PUT","DELETE","PATCH")]
        [string]$Method,

        [Parameter(Mandatory)][string]$RelativePath,
        [object]$Body
    )

    $webSession = Get-PASWebSession
    $path = $RelativePath.TrimStart('/')
    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $candidatePath = $path -replace '^(API|api)', $apiPrefix
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}" -f $PCloudSubdomain, $candidatePath

        try {
            $params = @{
                Uri         = $uri
                Method      = $Method
                WebSession  = $webSession
                ErrorAction = "Stop"
            }

            if ($null -ne $Body) {
                $params["ContentType"] = "application/json"
                $params["Body"] = ($Body | ConvertTo-Json -Depth 50 -Compress)
            }

            return Invoke-RestMethod @params
        }
        catch {
            $lastError = $_
        }
    }

    throw $lastError
}

function Get-PlatformByStringId {
    param([Parameter(Mandatory)][string]$PlatformID)

    $search = [uri]::EscapeDataString($PlatformID)
    $result = Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets?search={0}" -f $search)

    $platforms = @($result.Platforms)
    $matches = @($platforms | Where-Object { $_.PlatformID -eq $PlatformID })

    if ($matches.Count -eq 0) {
        throw "Platform [$PlatformID] was not found."
    }

    if ($matches.Count -gt 1) {
        throw "Multiple exact matches returned for platform [$PlatformID]."
    }

    return $matches[0]
}

function Get-PlatformSessionManagementByNumericId {
    param([Parameter(Mandatory)][int]$PlatformNumericID)

    return Invoke-EPVRest -Method GET -RelativePath ("API/Platforms/Targets/{0}/PrivilegedSessionManagement/" -f $PlatformNumericID)
}

function Get-StoredPlatformDetails {
    return Invoke-EPVRest -Method GET -RelativePath "API/Platforms/Storage"
}

function Export-PlatformZip {
    param(
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)][string]$DestinationFolder
    )

    $safeName = Get-SafeFileName -Name $PlatformID
    $stamp    = Get-Date -Format "yyyyMMdd_HHmmss"
    $zipPath  = Join-Path $DestinationFolder ("{0}_{1}.zip" -f $safeName, $stamp)

    $webSession = Get-PASWebSession
    $encoded = [uri]::EscapeDataString($PlatformID)
    $lastError = $null

    foreach ($apiPrefix in @("API","api")) {
        $uri = "https://{0}.privilegecloud.cyberark.cloud/PasswordVault/{1}/Platforms/{2}/Export/" -f `
            $PCloudSubdomain, $apiPrefix, $encoded

        try {
            Invoke-WebRequest -Uri $uri -Method POST -WebSession $webSession -OutFile $zipPath -ErrorAction Stop | Out-Null
            break
        }
        catch {
            $lastError = $_
        }
    }

    if (-not (Test-Path -LiteralPath $zipPath)) {
        throw $lastError
    }

    return $zipPath
}

function Clear-StoredPlatformSilently {
    try {
        Invoke-EPVRest -Method DELETE -RelativePath "API/Platforms/Storage" | Out-Null
    }
    catch {}
}

function Import-PlatformZipToStorageOrConflict {
    param([Parameter(Mandatory)][string]$ZipPath)

    $bytes  = [System.IO.File]::ReadAllBytes($ZipPath)
    $base64 = [System.Convert]::ToBase64String($bytes)

    try {
        $result = Invoke-EPVRest -Method POST -RelativePath "API/Platforms/Import/" -Body @{ ImportFile = $base64 }

        return [pscustomobject]@{
            ImportStatus = "CREATED"
            Result       = $result
        }
    }
    catch {
        $status = Get-HttpStatusCodeFromError -ErrorRecord $_
        if ($status -eq 409) {
            return [pscustomobject]@{
                ImportStatus = "CONFLICT_STORED"
                Result       = $null
            }
        }
        throw
    }
}

function Confirm-StoredPlatformConflict {
    param([Parameter(Mandatory)][string]$TargetPlatformID)

    $stored = Get-StoredPlatformDetails

    $storedPlatformId = ""
    try { $storedPlatformId = [string]$stored.StoredPlatformDetails.Id } catch {}

    $conflicted = @()
    try { $conflicted = @($stored.ConflictedPlatformsDetails) } catch {}

    $matchedConflict = @($conflicted | Where-Object { $_.Id -eq $TargetPlatformID })

    if ([string]::IsNullOrWhiteSpace($storedPlatformId)) {
        throw "Stored platform details are empty after import/conflict."
    }

    if ($matchedConflict.Count -eq 0 -and $storedPlatformId -ne $TargetPlatformID) {
        throw ("Stored platform exists, but target platform [{0}] is not listed as a conflicted platform." -f $TargetPlatformID)
    }

    return [pscustomobject]@{
        StoredPlatformId = $storedPlatformId
        StoredName       = [string]$stored.StoredPlatformDetails.Name
        ConflictedIds    = (($conflicted | ForEach-Object { $_.Id }) -join "; ")
    }
}

function Update-PlatformWithStored {
    param([Parameter(Mandatory)][string]$PlatformID)

    $encoded = [uri]::EscapeDataString($PlatformID)
    return Invoke-EPVRest -Method POST -RelativePath ("API/Platforms/{0}/Update" -f $encoded)
}

# ---------------- ZIP ----------------
function Expand-ZipPackage {
    param(
        [Parameter(Mandatory)][string]$ZipPath,
        [Parameter(Mandatory)][string]$DestinationPath
    )

    if (Test-Path -LiteralPath $DestinationPath) {
        Remove-Item -LiteralPath $DestinationPath -Recurse -Force
    }

    $null = New-Item -Path $DestinationPath -ItemType Directory -Force
    Expand-Archive -LiteralPath $ZipPath -DestinationPath $DestinationPath -Force
}

function Compress-ZipPackage {
    param(
        [Parameter(Mandatory)][string]$SourceDirectory,
        [Parameter(Mandatory)][string]$ZipPath
    )

    if (Test-Path -LiteralPath $ZipPath) {
        Remove-Item -LiteralPath $ZipPath -Force
    }

    $items = @(Get-ChildItem -LiteralPath $SourceDirectory -Force)
    if ($items.Count -eq 0) {
        throw "Source directory is empty: $SourceDirectory"
    }

    $paths = @($items | ForEach-Object { $_.FullName })
    Compress-Archive -Path $paths -DestinationPath $ZipPath -Force
}

function Get-XmlFilesFromFolder {
    param([Parameter(Mandatory)][string]$Folder)
    return @(Get-ChildItem -LiteralPath $Folder -Recurse -File -Filter "*.xml")
}

# ---------------- XML HELPER LOGIC ----------------
function Get-ParameterName {
    param([Parameter(Mandatory)]$Node)

    try {
        $n = [string]$Node.GetAttribute("Name")
        if (-not [string]::IsNullOrWhiteSpace($n)) { return $n }
    }
    catch {}

    return ""
}

function Get-ParameterValue {
    param([Parameter(Mandatory)]$Node)

    try {
        $v = [string]$Node.GetAttribute("Value")
        if (-not [string]::IsNullOrWhiteSpace($v)) { return $v }
    }
    catch {}

    try {
        $v2 = [string]$Node.InnerText
        if (-not [string]::IsNullOrWhiteSpace($v2)) { return $v2.Trim() }
    }
    catch {}

    return ""
}

function Get-NodeContextStrings {
    param([Parameter(Mandatory)]$Node)

    $items = @()
    $current = $Node

    while ($null -ne $current) {
        if ($null -ne $current.Attributes) {
            foreach ($attrName in @("Name","ID","Id","ComponentName","ConnectionComponent","PSMConnectorID","ConnectorID","DisplayName","Value")) {
                $attr = $current.Attributes[$attrName]
                if ($null -ne $attr -and -not [string]::IsNullOrWhiteSpace($attr.Value)) {
                    $val = $attr.Value.Trim()
                    if ($items -notcontains $val) {
                        $items += $val
                    }
                }
            }
        }

        try {
            $inner = [string]$current.InnerText
            if (-not [string]::IsNullOrWhiteSpace($inner)) {
                $trimmed = $inner.Trim()
                if ($trimmed.Length -le 200 -and $items -notcontains $trimmed) {
                    $items += $trimmed
                }
            }
        }
        catch {}

        $current = $current.ParentNode
    }

    return @($items)
}

function Test-ComponentMatch {
    param(
        [Parameter(Mandatory)]$Node,
        [Parameter(Mandatory)][string]$ConnectionComponentName
    )

    $needle = Normalize-Token $ConnectionComponentName
    $contexts = @(Get-NodeContextStrings -Node $Node)

    foreach ($ctx in $contexts) {
        $norm = Normalize-Token $ctx
        if ([string]::IsNullOrWhiteSpace($norm)) { continue }
        if ($norm -eq $needle) { return $true }
        if ($norm.Contains($needle)) { return $true }
        if ($needle.Contains($norm)) { return $true }
    }

    return $false
}

function Get-ConnectorIdParameterNodes {
    param(
        [Parameter(Mandatory)]$Xml,
        [Parameter(Mandatory)][string]$ConnectorID
    )

    $nodes = @($Xml.SelectNodes("//*[local-name()='Parameter']"))
    $hits = @()

    foreach ($node in $nodes) {
        $name  = Get-ParameterName -Node $node
        $value = Get-ParameterValue -Node $node

        if ((Normalize-Token $name) -eq "id" -and (Normalize-Token $value) -eq (Normalize-Token $ConnectorID)) {
            $hits += $node
        }
    }

    return @($hits)
}

function Get-NearestNamedAncestor {
    param(
        [Parameter(Mandatory)]$StartNode,
        [Parameter(Mandatory)][string]$ExpectedLocalName
    )

    $current = $StartNode
    while ($null -ne $current) {
        try {
            if ($current.LocalName -eq $ExpectedLocalName) {
                return $current
            }
        }
        catch {}
        $current = $current.ParentNode
    }

    return $null
}

function Get-SourceOverrideTemplate {
    param(
        [Parameter(Mandatory)][string]$ExtractDir,
        [Parameter(Mandatory)][string]$SourceConnectorID
    )

    $xmlFiles = Get-XmlFilesFromFolder -Folder $ExtractDir

    foreach ($xmlFile in $xmlFiles) {
        [xml]$xml = Get-Content -LiteralPath $xmlFile.FullName -Raw

        $allowSelectNodes = @($xml.SelectNodes("//*[local-name()='Parameter']"))
        foreach ($node in $allowSelectNodes) {
            $name = Get-ParameterName -Node $node
            if ($name -ne "AllowSelectHTML5") { continue }
            if (-not (Test-ComponentMatch -Node $node -ConnectionComponentName $SourceConnectorID)) { continue }

            $sourceBlock = $node.ParentNode
            $sourceConnectorContainer = $null
            if ($null -ne $sourceBlock) {
                $sourceConnectorContainer = $sourceBlock.ParentNode
            }

            if ($null -eq $sourceBlock) { continue }

            return [pscustomobject]@{
                XmlPath                     = $xmlFile.FullName
                SourceParamNode             = $node
                SourceBlockTemplate         = $sourceBlock.CloneNode($true)
                SourceBlockLocalName        = [string]$sourceBlock.LocalName
                SourceConnectorContainerName = $(if ($null -ne $sourceConnectorContainer) { [string]$sourceConnectorContainer.LocalName } else { "" })
            }
        }
    }

    throw ("Source connector [{0}] does not contain AllowSelectHTML5 in the exported platform XML." -f $SourceConnectorID)
}

function Add-AllowSelectToTargetConnector {
    param(
        [Parameter(Mandatory)][string]$ExtractDir,
        [Parameter(Mandatory)]$SourceTemplate,
        [Parameter(Mandatory)][string]$TargetConnectorID
    )

    $xmlFiles = Get-XmlFilesFromFolder -Folder $ExtractDir

    foreach ($xmlFile in $xmlFiles) {
        [xml]$xml = Get-Content -LiteralPath $xmlFile.FullName -Raw

        $existingAllowSelect = @($xml.SelectNodes("//*[local-name()='Parameter']") | Where-Object {
            (Get-ParameterName -Node $_) -eq "AllowSelectHTML5" -and
            (Test-ComponentMatch -Node $_ -ConnectionComponentName $TargetConnectorID)
        })

        if ($existingAllowSelect.Count -gt 0) {
            return [pscustomobject]@{
                Updated   = $false
                Already   = $true
                XmlPath   = $xmlFile.FullName
            }
        }

        $targetIdNodes = @(Get-ConnectorIdParameterNodes -Xml $xml -ConnectorID $TargetConnectorID)
        if ($targetIdNodes.Count -eq 0) { continue }

        foreach ($idNode in $targetIdNodes) {
            $targetConnectorContainer = $null

            if (-not [string]::IsNullOrWhiteSpace($SourceTemplate.SourceConnectorContainerName)) {
                $targetConnectorContainer = Get-NearestNamedAncestor -StartNode $idNode -ExpectedLocalName $SourceTemplate.SourceConnectorContainerName
            }

            if ($null -eq $targetConnectorContainer) {
                if ($null -ne $idNode.ParentNode -and $null -ne $idNode.ParentNode.ParentNode) {
                    $targetConnectorContainer = $idNode.ParentNode.ParentNode
                }
                elseif ($null -ne $idNode.ParentNode) {
                    $targetConnectorContainer = $idNode.ParentNode
                }
            }

            if ($null -eq $targetConnectorContainer) { continue }

            $existingBlock = $null
            if (-not [string]::IsNullOrWhiteSpace($SourceTemplate.SourceBlockLocalName)) {
                $children = @($targetConnectorContainer.ChildNodes | Where-Object {
                    $_.NodeType -eq [System.Xml.XmlNodeType]::Element -and $_.LocalName -eq $SourceTemplate.SourceBlockLocalName
                })
                if ($children.Count -gt 0) {
                    $existingBlock = $children[0]
                }
            }

            if ($null -ne $existingBlock) {
                $paramClone = $xml.ImportNode($SourceTemplate.SourceParamNode, $true)
                Apply-AllowSelectHtml5Values -ParameterNode $paramClone
                [void]$existingBlock.AppendChild($paramClone)
            }
            else {
                $blockClone = $xml.ImportNode($SourceTemplate.SourceBlockTemplate, $true)

                $paramNodes = @($blockClone.SelectNodes(".//*[local-name()='Parameter']"))
                foreach ($p in $paramNodes) {
                    if ((Get-ParameterName -Node $p) -eq "AllowSelectHTML5") {
                        Apply-AllowSelectHtml5Values -ParameterNode $p
                    }
                }

                [void]$targetConnectorContainer.AppendChild($blockClone)
            }

            $xml.Save($xmlFile.FullName)

            return [pscustomobject]@{
                Updated = $true
                Already = $false
                XmlPath = $xmlFile.FullName
            }
        }
    }

    throw ("Could not find a writable target connector node for [{0}] in the exported platform XML." -f $TargetConnectorID)
}

function Clone-AllowSelectWithinPlatformPackage {
    param(
        [Parameter(Mandatory)][string]$InputZip,
        [Parameter(Mandatory)][string]$WorkingRoot,
        [Parameter(Mandatory)][string]$PlatformID,
        [Parameter(Mandatory)]$PlatformRows
    )

    $safeName    = Get-SafeFileName -Name $PlatformID
    $extractDir  = Join-Path $WorkingRoot ("Extract_{0}_{1}" -f $safeName, ([guid]::NewGuid().ToString("N")))
    $modifiedZip = Join-Path $WorkingRoot ("{0}_modified_{1}.zip" -f $safeName, (Get-Date -Format "yyyyMMdd_HHmmss"))

    try {
        Expand-ZipPackage -ZipPath $InputZip -DestinationPath $extractDir

        $details = @()
        foreach ($row in $PlatformRows) {
            $sourceConnector = Get-OptionalCsvValue -Row $row -ColumnName "SourceConnectionComponentName"
            $targetConnector = Get-OptionalCsvValue -Row $row -ColumnName "TargetConnectionComponentName"

            if ([string]::IsNullOrWhiteSpace($sourceConnector)) {
                throw "SourceConnectionComponentName is required."
            }
            if ([string]::IsNullOrWhiteSpace($targetConnector)) {
                throw "TargetConnectionComponentName is required."
            }

            $sourceTemplate = Get-SourceOverrideTemplate -ExtractDir $extractDir -SourceConnectorID $sourceConnector
            $applyResult = Add-AllowSelectToTargetConnector `
                -ExtractDir $extractDir `
                -SourceTemplate $sourceTemplate `
                -TargetConnectorID $targetConnector

            $details += [pscustomobject]@{
                PlatformID                 = $PlatformID
                SourceConnectionComponent  = $sourceConnector
                TargetConnectionComponent  = $targetConnector
                XmlPath                    = $applyResult.XmlPath
                AlreadyPresent             = $applyResult.Already
                Applied                    = $applyResult.Updated
            }
        }

        Compress-ZipPackage -SourceDirectory $extractDir -ZipPath $modifiedZip

        return [pscustomobject]@{
            ModifiedZip = $modifiedZip
            Details     = @($details)
        }
    }
    finally {
        if (Test-Path -LiteralPath $extractDir) {
            Remove-Item -LiteralPath $extractDir -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

# ---------------- CSV VALIDATION ----------------
Write-Log ("Using CSV path: {0}" -f $CsvPath) "Cyan"

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "CSV not found: $CsvPath"
}

$rows = @(Import-Csv -LiteralPath $CsvPath)
if ($rows.Count -eq 0) {
    throw "CSV is empty: $CsvPath"
}

$requiredCols = @("PlatformID","SourceConnectionComponentName","TargetConnectionComponentName")
foreach ($col in $requiredCols) {
    if (-not ($rows[0].PSObject.Properties.Name -contains $col)) {
        throw "CSV must contain column '$col'."
    }
}

$rows = @($rows | Where-Object { -not [string]::IsNullOrWhiteSpace($_.PlatformID) })
if ($rows.Count -eq 0) {
    throw "CSV contains no usable PlatformID values."
}

# ---------------- MAIN ----------------
$reportItems = @()
Write-Log ("Platforms to process: {0}" -f (@($rows | Group-Object PlatformID).Count)) "Green"

try {
    Start-PASSessionFromCCP -ObjectName $CCPObject -UPUser $ServiceUPUser

    $platformGroups = @($rows | Group-Object PlatformID)
    $platformIndex = 0

    foreach ($group in $platformGroups) {
        $platformIndex++
        $platformID = [string]$group.Name
        $platformRows = @($group.Group)

        $report = [ordered]@{
            Timestamp         = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            PlatformID        = $platformID
            PlatformNumericID = ""
            PSMServerId       = ""
            LinkedConnectorIDs = ""
            BackupZip         = ""
            ModifiedZip       = ""
            ImportStatus      = ""
            StoredPlatformId  = ""
            StoredPlatformName = ""
            ConflictedIds     = ""
            Result            = ""
            Error             = ""
        }

        Write-Log ("[{0}/{1}] {2}" -f $platformIndex, $platformGroups.Count, $platformID) "Magenta"

        try {
            $platformLookup = Get-PlatformByStringId -PlatformID $platformID
            $platformNumericID = [int]$platformLookup.ID
            $report.PlatformNumericID = $platformNumericID

            $psmPolicy = Get-PlatformSessionManagementByNumericId -PlatformNumericID $platformNumericID
            $connectorList = @($psmPolicy.PSMConnectors)
            $report.PSMServerId = [string]$psmPolicy.PSMServerId
            $report.LinkedConnectorIDs = (($connectorList | ForEach-Object { $_.PSMConnectorID }) -join "; ")

            if ($connectorList.Count -eq 0) {
                throw "No PSM connectors are linked to this platform."
            }

            foreach ($row in $platformRows) {
                $src = Get-OptionalCsvValue -Row $row -ColumnName "SourceConnectionComponentName"
                $tgt = Get-OptionalCsvValue -Row $row -ColumnName "TargetConnectionComponentName"

                $srcOk = @($connectorList | Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_.PSMConnectorID) -and
                    (Normalize-Token $_.PSMConnectorID) -eq (Normalize-Token $src)
                }).Count -gt 0

                $tgtOk = @($connectorList | Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_.PSMConnectorID) -and
                    (Normalize-Token $_.PSMConnectorID) -eq (Normalize-Token $tgt)
                }).Count -gt 0

                if (-not $srcOk) {
                    throw ("Source connector [{0}] is not linked to platform [{1}]." -f $src, $platformID)
                }
                if (-not $tgtOk) {
                    throw ("Target connector [{0}] is not linked to platform [{1}]." -f $tgt, $platformID)
                }
            }

            Write-Log "Validated platform connector scope." "Green"

            $targetZip = Export-PlatformZip -PlatformID $platformID -DestinationFolder $BackupRoot
            $report.BackupZip = $targetZip
            Write-Log "Platform export validated." "Green"

            $cloneResult = Clone-AllowSelectWithinPlatformPackage `
                -InputZip $targetZip `
                -WorkingRoot $WorkRoot `
                -PlatformID $platformID `
                -PlatformRows $platformRows

            $report.ModifiedZip = $cloneResult.ModifiedZip

            foreach ($d in $cloneResult.Details) {
                if ($d.AlreadyPresent) {
                    Write-Log ("Skipped [{0}] because AllowSelectHTML5 already exists." -f $d.TargetConnectionComponent) "Gray"
                }
                elseif ($d.Applied) {
                    Write-Log ("Prepared AllowSelectHTML5 for [{0}] from [{1}]." -f $d.TargetConnectionComponent, $d.SourceConnectionComponent) "Green"
                }
            }

            if ($WhatIf) {
                Write-Log "Modified package prepared. WHATIF only." "Yellow"
                $report.Result = "WHATIF_ONLY"
            }
            else {
                Clear-StoredPlatformSilently

                $importResult = Import-PlatformZipToStorageOrConflict -ZipPath $cloneResult.ModifiedZip
                $report.ImportStatus = $importResult.ImportStatus

                if ($importResult.ImportStatus -eq "CONFLICT_STORED") {
                    Write-Log "Import returned 409 conflict; proceeding with stored-platform overwrite flow." "Yellow"
                }

                $storedCheck = Confirm-StoredPlatformConflict -TargetPlatformID $platformID
                $report.StoredPlatformId   = $storedCheck.StoredPlatformId
                $report.StoredPlatformName = $storedCheck.StoredName
                $report.ConflictedIds      = $storedCheck.ConflictedIds

                $null = Update-PlatformWithStored -PlatformID $platformID

                Write-Log "Platform updated successfully." "Green"
                $report.Result = "UPDATED"
            }
        }
        catch {
            $report.Result = "FAILED"
            $report.Error  = $_.Exception.Message
            Write-Log ("FAILED: {0}" -f $_.Exception.Message) "Red"
        }
        finally {
            $reportItems += [pscustomobject]$report
        }
    }
}
finally {
    try {
        if (Get-Command Close-PASSession -ErrorAction SilentlyContinue) {
            Close-PASSession | Out-Null
        }
    }
    catch {}
}

$reportPath = Join-Path $ReportRoot ("Platform_HTML5_Clone_Report_{0}.csv" -f (Get-Date -Format "yyyyMMdd_HHmmss"))
$reportItems | Export-Csv -LiteralPath $reportPath -NoTypeInformation -Encoding UTF8

$success = @($reportItems | Where-Object { $_.Result -eq "UPDATED" -or $_.Result -eq "WHATIF_ONLY" }).Count
$failed  = @($reportItems | Where-Object { $_.Result -eq "FAILED" }).Count

Write-Log ("Report exported: {0}" -f $reportPath) "Green"
Write-Log ("Completed. Success/WhatIf: {0} | Failed: {1}" -f $success, $failed) "Cyan"
