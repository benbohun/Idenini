```powershell
#requires -version 5.1

$TargetHost = "CHANGE-ME-HOSTNAME"
$Port = 2489

function Test-TlsVersion {
    param(
        [string]$HostName,
        [int]$PortNumber,
        [System.Security.Authentication.SslProtocols]$Protocol,
        [string]$ProtocolName
    )

    Write-Host ""
    Write-Host "========================================="
    Write-Host "Testing $ProtocolName"
    Write-Host "========================================="

    $tcp = $null
    $ssl = $null

    try {
        $tcp = New-Object System.Net.Sockets.TcpClient

        $connect = $tcp.BeginConnect($HostName,$PortNumber,$null,$null)

        if (-not $connect.AsyncWaitHandle.WaitOne(10000)) {
            throw "TCP connection timed out"
        }

        $tcp.EndConnect($connect)

        $ssl = New-Object System.Net.Security.SslStream(
            $tcp.GetStream(),
            $false,
            {
                param($sender,$certificate,$chain,$errors)
                return $true
            }
        )

        $ssl.AuthenticateAsClient(
            $HostName,
            $null,
            $Protocol,
            $false
        )

        Write-Host "RESULT              : SUCCESS" -ForegroundColor Green
        Write-Host "Requested TLS       : $ProtocolName"
        Write-Host "Negotiated TLS      : $($ssl.SslProtocol)"
        Write-Host "Cipher              : $($ssl.CipherAlgorithm)"
        Write-Host "Cipher Strength     : $($ssl.CipherStrength)"
        Write-Host "Hash                : $($ssl.HashAlgorithm)"
        Write-Host "Key Exchange        : $($ssl.KeyExchangeAlgorithm)"

        if ($ssl.RemoteCertificate) {

            $cert = New-Object `
                System.Security.Cryptography.X509Certificates.X509Certificate2 `
                $ssl.RemoteCertificate

            Write-Host ""
            Write-Host "SERVER CERTIFICATE"
            Write-Host "Subject     : $($cert.Subject)"
            Write-Host "Issuer      : $($cert.Issuer)"
            Write-Host "Thumbprint  : $($cert.Thumbprint)"
            Write-Host "Serial      : $($cert.SerialNumber)"
            Write-Host "Valid From  : $($cert.NotBefore)"
            Write-Host "Valid Until : $($cert.NotAfter)"
        }
    }
    catch {
        Write-Host "RESULT        : FAILED" -ForegroundColor Red
        Write-Host "Requested TLS : $ProtocolName"
        Write-Host "Error         : $($_.Exception.Message)"

        if ($_.Exception.InnerException) {
            Write-Host "Inner Error   : $($_.Exception.InnerException.Message)"
        }
    }
    finally {

        if ($ssl) {
            try { $ssl.Dispose() } catch {}
        }

        if ($tcp) {
            try { $tcp.Close() } catch {}
        }
    }
}

Write-Host ""
Write-Host "========================================="
Write-Host "CPM -> MAINFRAME TLS TEST"
Write-Host "========================================="
Write-Host "Host : $TargetHost"
Write-Host "Port : $Port"

Write-Host ""
Write-Host "Testing TCP..."

$tcpTest = Test-NetConnection $TargetHost -Port $Port -WarningAction SilentlyContinue

Write-Host "TCP Successful : $($tcpTest.TcpTestSucceeded)"

if (-not $tcpTest.TcpTestSucceeded) {
    Write-Host "TCP failed. Stopping." -ForegroundColor Red
    exit
}

Test-TlsVersion `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls) `
    -ProtocolName "TLS 1.0"

Test-TlsVersion `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls11) `
    -ProtocolName "TLS 1.1"

Test-TlsVersion `
    -HostName $TargetHost `
    -PortNumber $Port `
    -Protocol ([System.Security.Authentication.SslProtocols]::Tls12) `
    -ProtocolName "TLS 1.2"

Write-Host ""
Write-Host "========================================="
Write-Host "RECENT SCHANNEL ERRORS"
Write-Host "========================================="

Get-WinEvent -FilterHashtable @{
    LogName      = 'System'
    ProviderName = 'Schannel'
    StartTime    = (Get-Date).AddMinutes(-15)
} -ErrorAction SilentlyContinue |
Select-Object TimeCreated,Id,Message |
Format-List
```
