function New-SafeMemberResult {
    param(
        [bool]$Success,
        [string]$Status,
        [string]$Error = ""
    )

    [pscustomobject]@{
        Success = $Success
        Status  = $Status
        Error   = $Error
    }
}

function Find-ExistingSafeMember {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    try {
        Write-Info "Looking up members currently defined on safe '$SafeName'..."

        $members = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)

        if (-not $members -or $members.Count -eq 0) {
            return $null
        }

        $target = $MemberName.Trim()

        $match = $members | Where-Object {
            ($_.MemberName -eq $target) -or
            ($_.memberName -eq $target) -or
            ($_.UserName -eq $target) -or
            ($_.username -eq $target) -or
            ($_.Name -eq $target)
        } | Select-Object -First 1

        return $match
    } catch {
        Write-Warn "Could not retrieve members for safe '$SafeName': $($_.Exception.Message)"
        return $null
    }
}

function Ensure-SafeMember {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter()][ValidateSet("User", "Group", "Role")][string]$MemberType = $null,
        [Parameter(Mandatory)][hashtable]$PermFlags,
        [Parameter()][string]$SearchIn = $null
    )

    Write-Info "Validating member '$MemberName' on safe '$SafeName'..."

    $permParams = @{}
    foreach ($k in $PermFlags.Keys) {
        $permParams[$k] = $PermFlags[$k]
    }

    $existing = Find-ExistingSafeMember -SafeName $SafeName -MemberName $MemberName

    if ($existing) {
        Write-Ok "Member '$MemberName' already exists on safe '$SafeName'."

        if (-not $UpdateExistingMemberPermissions) {
            Write-Ok "Permission update skipped for existing member '$MemberName'. Use -UpdateExistingMemberPermissions to force permission changes."
            return New-SafeMemberResult -Success $true -Status "EXISTS_PERMISSION_UPDATE_SKIPPED"
        }

        Write-Warn "UpdateExistingMemberPermissions is enabled. Attempting to update permissions for '$MemberName'..."

        $setSplat = @{
            SafeName   = $SafeName
            MemberName = $MemberName
        }

        $setSplat += $permParams

        if ($PSCmdlet.ShouldProcess("$SafeName/$MemberName", "Set-PASSafeMember")) {
            try {
                Set-PASSafeMember @setSplat -ErrorAction Stop | Out-Null
                Write-Ok "Updated member '$MemberName' on safe '$SafeName'."
                return New-SafeMemberResult -Success $true -Status "EXISTS_PERMISSION_UPDATED"
            } catch {
                $err = $_.Exception.Message
                Write-Warn "Failed to update existing member '$MemberName' on safe '$SafeName': $err"
                return New-SafeMemberResult -Success $false -Status "EXISTS_PERMISSION_UPDATE_FAILED" -Error $err
            }
        }

        return New-SafeMemberResult -Success $true -Status "WHATIF_PERMISSION_UPDATE"
    }

    Write-Warn "Member '$MemberName' does not currently exist on safe '$SafeName'. Attempting to add."

    $addSupportsSearchIn   = Test-CommandHasParameter -CommandName "Add-PASSafeMember" -ParameterName "SearchIn"
    $addSupportsMemberType = (Test-CommandHasParameter -CommandName "Add-PASSafeMember" -ParameterName "memberType") -or
                             (Test-CommandHasParameter -CommandName "Add-PASSafeMember" -ParameterName "MemberType")

    $searchCandidates = New-Object System.Collections.Generic.List[string]

    if ($SearchIn) {
        $searchCandidates.Add($SearchIn)
    } else {
        if ($MemberName -like "*@*") {
            $domainPart = ($MemberName.Split("@")[-1]).Trim()
            if ($domainPart) {
                $searchCandidates.Add($domainPart)
            }
        }

        $searchCandidates.Add("Vault")
        $searchCandidates.Add($null)
    }

    $lastErr = ""

    foreach ($candidate in $searchCandidates) {
        $addSplat = @{
            SafeName   = $SafeName
            MemberName = $MemberName
        }

        $addSplat += $permParams

        if ($addSupportsSearchIn -and $candidate) {
            $addSplat["SearchIn"] = $candidate
        }

        if ($addSupportsMemberType -and $MemberType) {
            $addSplat["memberType"] = $MemberType
        }

        $hint = if ($candidate) { "SearchIn=$candidate" } else { "SearchIn=<none>" }

        Write-Info "Adding member '$MemberName' to safe '$SafeName' using $hint..."

        if ($PSCmdlet.ShouldProcess("$SafeName/$MemberName", "Add-PASSafeMember")) {
            try {
                Add-PASSafeMember @addSplat -ErrorAction Stop | Out-Null
                Write-Ok "Added member '$MemberName' to safe '$SafeName' using $hint."
                return New-SafeMemberResult -Success $true -Status "ADDED"
            } catch {
                $lastErr = $_.Exception.Message
                Write-Warn ("Add member attempt failed for '{0}' using {1}: {2}" -f $MemberName, $hint, $lastErr)
                continue
            }
        } else {
            return New-SafeMemberResult -Success $true -Status "WHATIF_ADD"
        }
    }

    Write-Warn "Could not add member '$MemberName' to safe '$SafeName'. Continuing with account/platform/reconcile processing. Last error: $lastErr"
    return New-SafeMemberResult -Success $false -Status "ADD_FAILED_CONTINUING" -Error $lastErr
}

# ============================================================
# CCP / Authentication
# ============================================================

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd("/")
    $loc  = $Location.Trim("/")

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving service user credential from CCP..."
    Write-Info "CCP URL: $url"

    $headers = @{
        "Content-Type" = "application/json"
    }

    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response is missing UserName or Content."
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# ============================================================
# CSV Validation
# ============================================================

function Validate-CsvInput {
    param(
        [Parameter(Mandatory)][object[]]$Rows
    )

    if (-not $Rows -or $Rows.Count -eq 0) {
        throw "CSV has no rows."
    }

    $headers = @($Rows[0].PSObject.Properties.Name)

    $hasSafeName = Test-AnyHeader -Headers $headers -Names @("SafeName", "Safe", "TargetSafe")
    $hasSam      = Test-AnyHeader -Headers $headers -Names @("Samaccountname", "SamAccountName", "SAM", "OwnerSam", "OwnerSamAccountName")
    $hasEmp      = Test-AnyHeader -Headers $headers -Names @("employeeID", "EmployeeID", "EmployeeId", "EmpID")
    $hasAcct     = Test-AnyHeader -Headers $headers -Names @("UserName", "Username", "AccountUserName", "AdminUserName", "DisabledAccount", "AccountName", "Account")
    $hasAddress  = Test-AnyHeader -Headers $headers -Names @("Address", "Domain", "AdminAddressDomain", "AccountAddress", "AccountDomain")
    $hasEmail    = Test-AnyHeader -Headers $headers -Names @("email", "Email", "OwnerEmail", "UPN", "OwnerUPN")

    if (-not $hasSafeName -and (-not $hasSam -or -not $hasEmp)) {
        throw "CSV must contain SafeName OR Samaccountname + employeeID."
    }

    if (-not $hasAcct -and -not $hasSam) {
        throw "CSV must contain UserName/AccountUserName OR Samaccountname so the account username can be resolved."
    }

    if (-not $hasAddress) {
        Write-Warn "CSV does not contain Address/Domain. Script will default Address to '$DefaultAddress'."
    }

    if (-not $hasEmail -and -not $SkipSafeMemberUpdate) {
        Write-Warn "CSV does not contain email/OwnerEmail. Owner membership will be skipped where email cannot be resolved."
    }

    Write-Ok "CSV validation completed. Rows found: $($Rows.Count)"
}

# ============================================================
# Safe Validation / Creation
# ============================================================

function Ensure-TargetSafe {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter()][string]$SamAccountName,
        [Parameter()][string]$EmployeeID,
        [Parameter()][string]$OwnerEmail
    )

    $result = [ordered]@{
        SafeName     = $SafeName
        ExistsBefore = $false
        Created      = $false
        Ready        = $false
        Status       = ""
        Error        = ""
    }

    try {
        $safe = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue
    } catch {
        $safe = $null
    }

    if ($safe) {
        $result.ExistsBefore = $true
        $result.Ready        = $true
        $result.Status       = "EXISTS"

        Write-Ok "Safe '$SafeName' already exists."

        try {
            Set-PASSafe -SafeName $SafeName -NumberOfDaysRetention $RetentionDays -ErrorAction SilentlyContinue | Out-Null
            Write-Ok "Ensured $RetentionDays-day retention on existing safe '$SafeName'."
        } catch {
            Write-Warn "Could not set retention on existing safe '$SafeName': $($_.Exception.Message)"
        }

        return [pscustomobject]$result
    }

    $ownerNoDomain = ""
    if (-not [string]::IsNullOrWhiteSpace($OwnerEmail) -and $OwnerEmail -like "*@*") {
        $ownerNoDomain = $OwnerEmail.Split("@")[0]
    }

    if (-not [string]::IsNullOrWhiteSpace($SamAccountName) -and -not [string]::IsNullOrWhiteSpace($EmployeeID)) {
        if (-not [string]::IsNullOrWhiteSpace($ownerNoDomain)) {
            $description = "Individual safe for $SamAccountName ($EmployeeID) - Managed By $ownerNoDomain"
        } else {
            $description = "Individual safe for $SamAccountName ($EmployeeID)"
        }
    } else {
        $description = "Safe created by IND safe automation"
    }

    $safeSplat = @{
        SafeName              = $SafeName
        Description           = $description
        ManagingCPM           = $ManagingCPM
        NumberOfDaysRetention = $RetentionDays
        Location              = $Location
    }

    Write-Warn "Safe '$SafeName' does not exist. Creating it now..."

    if ($PSCmdlet.ShouldProcess($SafeName, "Add-PASSafe")) {
        try {
            Add-PASSafe @safeSplat -ErrorAction Stop | Out-Null

            $result.Created = $true
            $result.Ready   = $true
            $result.Status  = "CREATED"

            Write-Ok "Created safe '$SafeName'."
            return [pscustomobject]$result
        } catch {
            $result.Status = "FAILED_CREATE"
            $result.Error  = $_.Exception.Message

            Write-Err "Failed to create safe '$SafeName': $($_.Exception.Message)"
            return [pscustomobject]$result
        }
    }

    $result.Status = "WHATIF_CREATE"
    $result.Ready  = $false
    return [pscustomobject]$result
}

# ============================================================
# Account Lookup / Platform Update / Reconcile
# ============================================================

function Find-PASAccountInSafe {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address
    )

    try {
        $accounts = @(Get-PASAccount -SafeName $SafeName -Search $UserName -ErrorAction SilentlyContinue)

        $match = $accounts |
            Where-Object {
                ($_.UserName -eq $UserName -or $_.username -eq $UserName) -and
                ($_.Address -eq $Address -or $_.address -eq $Address)
            } |
            Select-Object -First 1

        if ($match) {
            return $match
        }

        $userMatches = @(
            $accounts |
            Where-Object {
                ($_.UserName -eq $UserName -or $_.username -eq $UserName)
            }
        )

        if ($userMatches.Count -eq 1) {
            Write-Warn "Account '$UserName' matched by username only in safe '$SafeName'. Address returned by API did not exactly match '$Address'."
            return $userMatches[0]
        }

        return $null
    } catch {
        Write-Warn "Account lookup warning for '$UserName' in safe '$SafeName': $($_.Exception.Message)"
        return $null
    }
}

function Invoke-AccountReconcile {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$AccountID,
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName
    )

    $result = [ordered]@{
        ReconcileAttempted = $false
        ReconcileStatus    = ""
        ReconcileError     = ""
    }

    if ($SkipReconcile) {
        $result.ReconcileStatus = "SKIPPED"
        Write-Warn "Reconcile skipped by parameter for '$SafeName/$UserName'."
        return [pscustomobject]$result
    }

    if ([string]::IsNullOrWhiteSpace($AccountID)) {
        $result.ReconcileStatus = "SKIPPED_NO_ACCOUNT_ID"
        $result.ReconcileError  = "AccountID is blank."
        Write-Warn "Reconcile skipped for '$SafeName/$UserName' because AccountID is blank."
        return [pscustomobject]$result
    }

    if ($PSCmdlet.ShouldProcess("$SafeName/$UserName [$AccountID]", "Reconcile account password")) {
        $result.ReconcileAttempted = $true

        try {
            Invoke-PASCPMOperation `
                -AccountID $AccountID `
                -ReconcileTask `
                -ErrorAction Stop | Out-Null

            $result.ReconcileStatus = "RECONCILE_SUBMITTED"
            Write-Ok "Password reconcile submitted for '$SafeName/$UserName' using Invoke-PASCPMOperation."
            return [pscustomobject]$result
        } catch {
            $firstErr = $_.Exception.Message
            Write-Warn "Invoke-PASCPMOperation reconcile failed for '$SafeName/$UserName': $firstErr"

            try {
                Invoke-PASRestMethod `
                    -Uri "api/Accounts/$AccountID/Reconcile" `
                    -Method POST `
                    -ErrorAction Stop | Out-Null

                $result.ReconcileStatus = "RECONCILE_SUBMITTED_REST_FALLBACK"
                Write-Ok "Password reconcile submitted for '$SafeName/$UserName' using REST fallback."
                return [pscustomobject]$result
            } catch {
                $secondErr = $_.Exception.Message

                $result.ReconcileStatus = "RECONCILE_FAILED"
                $result.ReconcileError = "Invoke-PASCPMOperation failed: $firstErr | REST fallback failed: $secondErr"

                Write-Warn "Reconcile failed for '$SafeName/$UserName': $($result.ReconcileError)"
                return [pscustomobject]$result
            }
        }
    }

    $result.ReconcileStatus = "WHATIF_RECONCILE"
    return [pscustomobject]$result
}

function Update-ExistingAccountPlatformIfNeeded {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][object]$Account,
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address,
        [Parameter(Mandatory)][string]$TargetPlatformID
    )

    $result = [ordered]@{
        AccountID        = ""
        CurrentPlatform  = ""
        TargetPlatform   = $TargetPlatformID
        PlatformStatus   = ""
        PlatformChanged  = $false
        Error            = ""
    }

    $currentPlatform = Get-PASAccountPlatformValue -AccountObject $Account
    $accountId       = Get-PASAccountIdValue -AccountObject $Account

    $result.AccountID       = $accountId
    $result.CurrentPlatform = $currentPlatform

    if ([string]::IsNullOrWhiteSpace($accountId)) {
        $result.PlatformStatus = "EXISTS_ACCOUNT_ID_NOT_FOUND"
        $result.Error = "Existing account found, but AccountID could not be resolved."
        Write-Warn "Existing account '$UserName' found in safe '$SafeName', but AccountID could not be resolved."
        return [pscustomobject]$result
    }

    if ($currentPlatform -eq $TargetPlatformID) {
        $result.PlatformStatus = "EXISTS_PLATFORM_OK"
        Write-Ok "Existing account '$UserName' in safe '$SafeName' is already on platform '$TargetPlatformID'."
        return [pscustomobject]$result
    }

    Write-Warn "Existing account '$UserName' in safe '$SafeName' is on platform '$currentPlatform'. Target platform is '$TargetPlatformID'."

    if ($PSCmdlet.ShouldProcess("$SafeName/$UserName [$accountId]", "Update platformId to $TargetPlatformID using Gen2 patch")) {
        try {
            Set-PASAccount `
                -AccountID $accountId `
                -op replace `
                -path "/platformId" `
                -value $TargetPlatformID `
                -ErrorAction Stop | Out-Null

            $result.PlatformStatus  = "PLATFORM_UPDATED"
            $result.PlatformChanged = $true

            Write-Ok "Updated existing account '$UserName' platform from '$currentPlatform' to '$TargetPlatformID'."
            return [pscustomobject]$result
        } catch {
            $firstErr = $_.Exception.Message
            Write-Warn "Set-PASAccount Gen2 patch failed for '$SafeName/$UserName': $firstErr"

            try {
                $operations = @(
                    @{
                        op    = "replace"
                        path  = "/platformId"
                        value = $TargetPlatformID
                    }
                )

                $body = $operations | ConvertTo-Json -Depth 10

                Invoke-PASRestMethod `
                    -Uri "api/Accounts/$accountId/" `
                    -Method PATCH `
                    -Body $body `
                    -ErrorAction Stop | Out-Null

                $result.PlatformStatus  = "PLATFORM_UPDATED_REST_FALLBACK"
                $result.PlatformChanged = $true

                Write-Ok "Updated existing account '$UserName' platform to '$TargetPlatformID' using REST fallback."
                return [pscustomobject]$result
            } catch {
                $secondErr = $_.Exception.Message

                $result.PlatformStatus = "PLATFORM_UPDATE_FAILED"
                $result.Error = "Set-PASAccount Gen2 failed: $firstErr | REST fallback failed: $secondErr"

                Write-Warn "Failed to update existing account '$UserName' platform to '$TargetPlatformID': $($result.Error)"
                return [pscustomobject]$result
            }
        }
    }

    $result.PlatformStatus = "WHATIF_PLATFORM_UPDATE"
    return [pscustomobject]$result
}

function Add-Or-Update-INDAccount {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address,
        [Parameter(Mandatory)][string]$TargetPlatformID,
        [Parameter()][string]$Secret = ""
    )

    $result = [ordered]@{
        UserName             = $UserName
        Address              = $Address
        TargetPlatform       = $TargetPlatformID
        AccountID            = ""
        AccountStatus        = ""
        PlatformStatus       = ""
        ReconcileStatus      = ""
        ReconcileAttempted   = $false
        Error                = ""
    }

    if ([string]::IsNullOrWhiteSpace($SafeName) -or
        [string]::IsNullOrWhiteSpace($UserName) -or
        [string]::IsNullOrWhiteSpace($Address)) {

        $result.AccountStatus = "SKIPPED_MISSING_FIELD"
        $result.Error = "SafeName, UserName, or Address is blank."

        Write-Warn "Account processing skipped because SafeName, UserName, or Address is blank."
        return [pscustomobject]$result
    }

    Write-Info "Checking whether account '$UserName' exists in safe '$SafeName' with address '$Address'..."

    $existingAcct = Find-PASAccountInSafe -SafeName $SafeName -UserName $UserName -Address $Address

    if ($existingAcct) {
        $result.AccountStatus = "EXISTS"

        $platformResult = Update-ExistingAccountPlatformIfNeeded `
            -Account          $existingAcct `
            -SafeName         $SafeName `
            -UserName         $UserName `
            -Address          $Address `
            -TargetPlatformID $TargetPlatformID

        $result.AccountID      = $platformResult.AccountID
        $result.PlatformStatus = $platformResult.PlatformStatus

        if ($platformResult.Error) {
            $result.Error = $platformResult.Error
        }

        if ($platformResult.PlatformChanged -eq $true) {
            $reconcileResult = Invoke-AccountReconcile `
                -AccountID $platformResult.AccountID `
                -SafeName  $SafeName `
                -UserName  $UserName

            $result.ReconcileStatus    = $reconcileResult.ReconcileStatus
            $result.ReconcileAttempted = $reconcileResult.ReconcileAttempted

            if ($reconcileResult.ReconcileError) {
                if ($result.Error) {
                    $result.Error = "$($result.Error) | Reconcile: $($reconcileResult.ReconcileError)"
                } else {
                    $result.Error = $reconcileResult.ReconcileError
                }
            }
        } else {
            $result.ReconcileStatus = "NOT_REQUIRED_NO_PLATFORM_CHANGE"
        }

        return [pscustomobject]$result
    }

    $acctSplat = @{
        SafeName   = $SafeName
        PlatformID = $TargetPlatformID
        Address    = $Address
        UserName   = $UserName
    }

    $effectiveSecret = $Secret
    if ([string]::IsNullOrWhiteSpace($effectiveSecret) -and -not [string]::IsNullOrWhiteSpace($DefaultInitialPassword)) {
        $effectiveSecret = $DefaultInitialPassword
    }

    if (-not [string]::IsNullOrWhiteSpace($effectiveSecret)) {
        if (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "SecretType") {
            $acctSplat["SecretType"] = "Password"
        }

        if (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Secret") {
            $acctSplat["Secret"] = $effectiveSecret
        } elseif (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Password") {
            $acctSplat["Password"] = $effectiveSecret
        } elseif (Test-CommandHasParameter -CommandName "Add-PASAccount" -ParameterName "Content") {
            $acctSplat["Content"] = $effectiveSecret
        } else {
            Write-Warn "A password/secret was supplied, but this psPAS Add-PASAccount version does not expose Secret, Password, or Content parameter."
        }
    }

    Write-Info "Vaulting account '$UserName' to safe '$SafeName' using platform '$TargetPlatformID'..."

    if ($PSCmdlet.ShouldProcess("$SafeName/$UserName", "Add-PASAccount PlatformID=$TargetPlatformID")) {
        try {
            $newAcct = Add-PASAccount @acctSplat -ErrorAction Stop

            $result.AccountStatus  = "ONBOARDED"
            $result.PlatformStatus = "ONBOARDED_WITH_TARGET_PLATFORM"

            Write-Ok "Vaulted account '$UserName' into safe '$SafeName' with platform '$TargetPlatformID'."

            $accountId = Get-PASAccountIdValue -AccountObject $newAcct

            if ([string]::IsNullOrWhiteSpace($accountId)) {
                Start-Sleep -Seconds 2
                $lookupAfterAdd = Find-PASAccountInSafe -SafeName $SafeName -UserName $UserName -Address $Address
                $accountId = Get-PASAccountIdValue -AccountObject $lookupAfterAdd
            }

            $result.AccountID = $accountId

            $reconcileResult = Invoke-AccountReconcile `
                -AccountID $accountId `
                -SafeName  $SafeName `
                -UserName  $UserName

            $result.ReconcileStatus    = $reconcileResult.ReconcileStatus
            $result.ReconcileAttempted = $reconcileResult.ReconcileAttempted

            if ($reconcileResult.ReconcileError) {
                $result.Error = $reconcileResult.ReconcileError
            }

            return [pscustomobject]$result
        } catch {
            $result.AccountStatus = "FAILED_ONBOARD"
            $result.Error = $_.Exception.Message

            Write-Err "Failed to vault account '$UserName' into safe '$SafeName': $($_.Exception.Message)"
            return [pscustomobject]$result
        }
    }

    $result.AccountStatus = "WHATIF_ONBOARD"
    $result.PlatformStatus = "WHATIF_ONBOARD"
    $result.ReconcileStatus = "WHATIF_RECONCILE_AFTER_ONBOARD"
    return [pscustomobject]$result
}

# ============================================================
# Row Processor
# ============================================================

function Process-INDRow {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][int]$RowNumber
    )

    $sam   = Get-RowValue -Row $Row -Names @("Samaccountname", "SamAccountName", "SAM", "OwnerSam", "OwnerSamAccountName")
    $eid   = Get-RowValue -Row $Row -Names @("employeeID", "EmployeeID", "EmployeeId", "EmpID")
    $email = Get-RowValue -Row $Row -Names @("email", "Email", "OwnerEmail", "UPN", "OwnerUPN")

    $rawAddress       = Get-RowValue -Row $Row -Names @("Address", "Domain", "AdminAddressDomain", "AccountAddress", "AccountDomain")
    $address          = Normalize-Address -RawAddress $rawAddress
    $targetPlatformID = Resolve-TargetPlatformID -Address $address

    $safeName = Resolve-SafeName -Row $Row
    $userName = Resolve-AccountUserName -Row $Row -Address $address

    $secret = Get-RowValue -Row $Row -Names @("Password", "Secret", "InitialPassword", "Content")

    Write-Info "============================================================"
    Write-Info "Row $RowNumber | Safe='$safeName' | Account='$userName' | Address='$address' | TargetPlatform='$targetPlatformID'"

    $summary = [ordered]@{
        RowNumber          = $RowNumber
        Samaccountname     = $sam
        EmployeeID         = $eid
        OwnerEmail         = $email
        SafeName           = $safeName
        Address            = $address
        UserName           = $userName
        TargetPlatformID   = $targetPlatformID
        AccountID          = ""
        SafeStatus         = ""
        MemberStatus       = ""
        AccountStatus      = ""
        PlatformStatus     = ""
        ReconcileStatus    = ""
        ReconcileAttempted = $false
        OverallStatus      = ""
        Error              = ""
    }

    try {
        $safeResult = Ensure-TargetSafe `
            -SafeName       $safeName `
            -SamAccountName $sam `
            -EmployeeID     $eid `
            -OwnerEmail     $email

        $summary.SafeStatus = $safeResult.Status

        if (-not $safeResult.Ready) {
            $summary.OverallStatus = "FAILED_SAFE_NOT_READY"
            $summary.Error = $safeResult.Error
            return [pscustomobject]$summary
        }

        $memberWarnings = New-Object System.Collections.Generic.List[string]

        if (-not $SkipSafeMemberUpdate) {
            $adminPerms = Get-AdminPerms
            $ownerPerms = Get-OwnerPerms

            Write-Info "Validating admin group membership on safe '$safeName'..."

            $adminResult = Ensure-SafeMember `
                -SafeName   $safeName `
                -MemberName $AdminGroupUPN `
                -MemberType Group `
                -PermFlags  $adminPerms

            if (-not $adminResult.Success) {
                Write-Warn "Primary admin group validation/add failed for '$AdminGroupUPN'. Retrying admin group using SAM '$AdminGroupSAM'."

                $adminSamResult = Ensure-SafeMember `
                    -SafeName   $safeName `
                    -MemberName $AdminGroupSAM `
                    -MemberType Group `
                    -PermFlags  $adminPerms

                if (-not $adminSamResult.Success) {
                    $memberWarnings.Add("Admin group membership warning: $($adminResult.Status); $($adminSamResult.Status)") | Out-Null
                }
            }

            if (-not [string]::IsNullOrWhiteSpace($email)) {
                Write-Info "Validating owner membership '$email' on safe '$safeName'..."

                $ownerResult = Ensure-SafeMember `
                    -SafeName   $safeName `
                    -MemberName $email `
                    -MemberType User `
                    -PermFlags  $ownerPerms

                if (-not $ownerResult.Success -and $email -like "*@*") {
                    $ownerSam = $email.Split("@")[0]
                    Write-Warn "Owner UPN validation/add failed. Retrying owner membership using SAM '$ownerSam'."

                    $ownerSamResult = Ensure-SafeMember `
                        -SafeName   $safeName `
                        -MemberName $ownerSam `
                        -MemberType User `
                        -PermFlags  $ownerPerms

                    if (-not $ownerSamResult.Success) {
                        $memberWarnings.Add("Owner membership warning: $($ownerResult.Status); $($ownerSamResult.Status)") | Out-Null
                    }
                } elseif (-not $ownerResult.Success) {
                    $memberWarnings.Add("Owner membership warning: $($ownerResult.Status)") | Out-Null
                }
            } else {
                Write-Warn "Owner email is blank. Owner membership skipped."
                $memberWarnings.Add("Owner email blank; owner membership skipped") | Out-Null
            }

            if ($memberWarnings.Count -eq 0) {
                $summary.MemberStatus = "OK"
            } else {
                $summary.MemberStatus = ($memberWarnings -join "; ")
                Write-Warn "Member validation completed with warning(s), but account/platform/reconcile processing will continue."
            }
        } else {
            $summary.MemberStatus = "SKIPPED"
        }

        $acctResult = Add-Or-Update-INDAccount `
            -SafeName         $safeName `
            -UserName         $userName `
            -Address          $address `
            -TargetPlatformID $targetPlatformID `
            -Secret           $secret

        $summary.AccountID          = $acctResult.AccountID
        $summary.AccountStatus      = $acctResult.AccountStatus
        $summary.PlatformStatus     = $acctResult.PlatformStatus
        $summary.ReconcileStatus    = $acctResult.ReconcileStatus
        $summary.ReconcileAttempted = $acctResult.ReconcileAttempted

        if ($acctResult.Error) {
            $summary.Error = $acctResult.Error
        }

        if ($acctResult.AccountStatus -like "FAILED*" -or
            $acctResult.PlatformStatus -like "*FAILED*" -or
            $acctResult.ReconcileStatus -like "*FAILED*") {

            $summary.OverallStatus = "FAILED"
        }
        elseif ($summary.MemberStatus -ne "OK" -and $summary.MemberStatus -ne "SKIPPED") {
            $summary.OverallStatus = "COMPLETED_WITH_MEMBER_WARNING"
        }
        elseif ($acctResult.ReconcileStatus -like "RECONCILE_FAILED") {
            $summary.OverallStatus = "COMPLETED_WITH_RECONCILE_WARNING"
        }
        else {
            $summary.OverallStatus = "OK"
        }

        Write-Ok "Completed row $RowNumber | Safe='$safeName' | Account='$userName' | Status='$($summary.OverallStatus)'"

        return [pscustomobject]$summary
    } catch {
        $summary.OverallStatus = "FAILED_EXCEPTION"
        $summary.Error = $_.Exception.Message

        Write-Err "Row $RowNumber failed: $($_.Exception.Message)"
        return [pscustomobject]$summary
    }
}

# ============================================================
# MAIN
# ============================================================

$sessionCreated = $false
$runSummary = New-Object System.Collections.Generic.List[object]

try {
    Write-Info "IND Safe platform validation/onboarding/reconcile script starting..."
    Write-Info "CSV Path                         : $CsvPath"
    Write-Info "Report Folder                    : $ReportFolder"
    Write-Info "Default Platform                 : $DefaultPlatformID"
    Write-Info "EXT Target Platform              : $ExtDomainPlatformID"
    Write-Info "GDE Target Platform              : $GdeDomainPlatformID"
    Write-Info "Skip Reconcile                   : $SkipReconcile"
    Write-Info "Update Existing Member Permission: $UpdateExistingMemberPermissions"

    if (-not (Test-Path $CsvPath)) {
        throw "CSV not found: $CsvPath"
    }

    $rows = @(Import-Csv -Path $CsvPath)

    Validate-CsvInput -Rows $rows

    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via Identity ServiceUser..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) {
        throw "psPAS session was not established."
    }

    $sessionCreated = $true

    Write-Ok "Authenticated to Privilege Cloud as service user: $($serviceCred.UserName)"

    $rowNumber = 0

    foreach ($row in $rows) {
        $rowNumber++

        $rowResult = Process-INDRow -Row $row -RowNumber $rowNumber
        $runSummary.Add($rowResult) | Out-Null
    }

    $runSummary | Export-Csv -Path $script:ReportPath -NoTypeInformation -Encoding UTF8

    $okCount     = @($runSummary | Where-Object { $_.OverallStatus -eq "OK" }).Count
    $warnCount   = @($runSummary | Where-Object { $_.OverallStatus -like "*WARNING*" -or $_.OverallStatus -like "*WARN*" }).Count
    $failedCount = @($runSummary | Where-Object { $_.OverallStatus -like "FAILED*" }).Count
    $totalCount  = $runSummary.Count

    Write-Info "============================================================"
    Write-Ok "Processing completed."
    Write-Ok "Total rows : $totalCount"
    Write-Ok "OK         : $okCount"
    Write-Warn "Warnings   : $warnCount"
    Write-Err "Failed     : $failedCount"
    Write-Ok "Report     : $script:ReportPath"
    Write-Ok "Log        : $script:LogPath"
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off from Privilege Cloud."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
