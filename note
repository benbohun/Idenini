<#
Test_SWS_TokenGeneration_Only_V2.ps1

Purpose
- ONLY test CyberArk SWS API access token generation.
- Does NOT create Identity apps.
- Does NOT update Identity apps.
- Does NOT call SWS policy copy/merge logic.

What it does
1. Finds java.exe.
2. Finds the CyberArk public-api-auth-helper*.jar.
3. Finds/selects the SWS service-account JSON.
4. Runs the helper JAR with the tenant ID and JSON.
5. Confirms whether an access_token was returned.
6. Optionally validates the token against GET /sws/policies.

Important fix in V2
- java -version writes to STDERR by design. V1 incorrectly treated that as fatal.
- V2 captures STDERR safely and only checks the exit code.
#>

[CmdletBinding()]
param(
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',
    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',
    [string]$SwsAuthHelperJarPath = '',
    [string]$SwsServiceAccountJsonPath = '',
    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',
    [switch]$ValidateAgainstSwsApi,
    [switch]$ShowToken,
    [switch]$SaveTokenToFile,
    [string]$TokenOutputPath = '',
    [string]$LogPath = ''
)

$ErrorActionPreference = 'Stop'
$script:ScriptRoot = if ($PSScriptRoot) { $PSScriptRoot } else { (Get-Location).Path }
if ([string]::IsNullOrWhiteSpace($LogPath)) {
    $LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only.log'
}

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $line = '{0} - {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogPath -Value $line -ErrorAction SilentlyContinue } catch {}
}

function ConvertTo-JsonSafe {
    param([object]$Object)
    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 100)
}

function Get-ShortMaskedToken {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 24) { return ('{0}...' -f $Token.Substring(0, [Math]::Min(8, $Token.Length))) }
    return ('{0}...{1}' -f $Token.Substring(0, 12), $Token.Substring($Token.Length - 8))
}

function Get-UniqueStringList {
    param([string[]]$Values)
    $list = New-Object System.Collections.Generic.List[string]
    foreach ($v in $Values) {
        if (-not [string]::IsNullOrWhiteSpace($v) -and -not $list.Contains($v)) {
            [void]$list.Add($v)
        }
    }
    return @($list.ToArray())
}

function Resolve-JavaPath {
    $candidates = @()
    if (-not [string]::IsNullOrWhiteSpace($SwsJavaPath)) { $candidates += $SwsJavaPath }
    $candidates += (Join-Path $script:ScriptRoot 'java.exe')
    $candidates += (Join-Path $script:ScriptRoot 'java\bin\java.exe')
    $candidates += (Join-Path $script:ScriptRoot 'jre\bin\java.exe')
    $candidates += (Join-Path $script:ScriptRoot 'jdk\bin\java.exe')
    $candidates += (Join-Path $script:ScriptRoot 'jdk-25.0.3+9\bin\java.exe')

    foreach ($candidate in (Get-UniqueStringList -Values $candidates)) {
        if (Test-Path -LiteralPath $candidate -PathType Leaf) {
            return (Resolve-Path -LiteralPath $candidate).Path
        }
    }

    $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
    if ($cmd -and $cmd.Source) { return $cmd.Source }

    throw 'java.exe was not found. Pass -SwsJavaPath or place a portable JDK beside the script.'
}

function Test-JavaExecutable {
    param([Parameter(Mandatory)][string]$JavaPath)

    Write-Log "Testing Java executable: $JavaPath" 'Cyan'

    # java -version writes version info to STDERR by design. Do not treat STDERR text as failure.
    $outputLines = @(& $JavaPath -version 2>&1)
    $exit = $LASTEXITCODE
    $versionText = (($outputLines | ForEach-Object { $_.ToString() }) -join ' | ').Trim()

    if ($exit -ne 0) {
        throw "java.exe -version failed. ExitCode=$exit; Output=$versionText"
    }

    Write-Log "Java executable OK. Version=$versionText" 'Green'
}

function Resolve-HelperJarPath {
    if (-not [string]::IsNullOrWhiteSpace($SwsAuthHelperJarPath)) {
        if (-not (Test-Path -LiteralPath $SwsAuthHelperJarPath -PathType Leaf)) {
            throw "Specified SWS helper JAR was not found: $SwsAuthHelperJarPath"
        }
        return (Resolve-Path -LiteralPath $SwsAuthHelperJarPath).Path
    }

    $jars = @(Get-ChildItem -Path $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) {
        throw "CyberArk public API auth helper JAR was not found in $script:ScriptRoot."
    }
    if ($jars.Count -gt 1) {
        Write-Log 'Multiple helper JAR files found. Using newest file:' 'Yellow'
        foreach ($j in $jars) { Write-Log ("  {0} LastWriteTime={1}" -f $j.Name, $j.LastWriteTime) 'Yellow' }
    }
    return $jars[0].FullName
}

function Test-IsSwsServiceAccountJson {
    param([Parameter(Mandatory)][string]$Path)
    try {
        $obj = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
        $text = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop
        $hasPrivateKey = ($text -match 'BEGIN (RSA )?PRIVATE KEY') -or ($obj.PSObject.Properties.Name -contains 'privateKey')
        $hasDiscovery = ($obj.PSObject.Properties.Name -contains 'discoveryURI') -or ($obj.PSObject.Properties.Name -contains 'discoveryUrl') -or ($obj.PSObject.Properties.Name -contains 'discoveryURL')
        $hasServiceId = ($obj.PSObject.Properties.Name -contains 'serviceAccountId') -or ($obj.PSObject.Properties.Name -contains 'clientId') -or ($obj.PSObject.Properties.Name -contains 'id')
        return ($hasPrivateKey -and $hasDiscovery -and $hasServiceId)
    } catch {
        return $false
    }
}

function Resolve-ServiceAccountJsonPath {
    if (-not [string]::IsNullOrWhiteSpace($SwsServiceAccountJsonPath)) {
        if (-not (Test-Path -LiteralPath $SwsServiceAccountJsonPath -PathType Leaf)) {
            throw "Specified SWS service-account JSON was not found: $SwsServiceAccountJsonPath"
        }
        return (Resolve-Path -LiteralPath $SwsServiceAccountJsonPath).Path
    }

    $jsons = @(Get-ChildItem -Path $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue | Where-Object { Test-IsSwsServiceAccountJson -Path $_.FullName } | Sort-Object LastWriteTime -Descending)

    if ($jsons.Count -eq 0) {
        throw "No valid SWS service-account JSON found in $script:ScriptRoot."
    }

    Write-Log "Found $($jsons.Count) valid SWS service-account JSON file(s):" 'Cyan'
    for ($i = 0; $i -lt $jsons.Count; $i++) {
        Write-Log ("  [{0}] {1} LastWriteTime={2}" -f ($i + 1), $jsons[$i].Name, $jsons[$i].LastWriteTime) 'Cyan'
    }

    if ($jsons.Count -eq 1) {
        return $jsons[0].FullName
    }

    $choice = Read-Host 'Enter the number of the JSON file to use. Press ENTER to use newest [1]'
    if ([string]::IsNullOrWhiteSpace($choice)) { return $jsons[0].FullName }

    $idx = 0
    if (-not [int]::TryParse($choice, [ref]$idx)) { throw "Invalid JSON selection: $choice" }
    if ($idx -lt 1 -or $idx -gt $jsons.Count) { throw "Invalid JSON selection number: $idx" }
    return $jsons[$idx - 1].FullName
}

function Get-ServiceAccountJsonInfo {
    param([Parameter(Mandatory)][string]$Path)
    $raw = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop
    $obj = $raw | ConvertFrom-Json -ErrorAction Stop

    $serviceId = $null
    foreach ($n in @('serviceAccountId','clientId','id')) {
        if ($obj.PSObject.Properties.Name -contains $n -and -not [string]::IsNullOrWhiteSpace([string]$obj.$n)) {
            $serviceId = [string]$obj.$n
            break
        }
    }

    $discovery = $null
    foreach ($n in @('discoveryURI','discoveryUrl','discoveryURL')) {
        if ($obj.PSObject.Properties.Name -contains $n -and -not [string]::IsNullOrWhiteSpace([string]$obj.$n)) {
            $discovery = [string]$obj.$n
            break
        }
    }

    return [pscustomobject]@{
        ServiceAccountId = $serviceId
        DiscoveryURI     = $discovery
        FileName         = (Split-Path -Path $Path -Leaf)
        FullName         = $Path
    }
}

function Get-TenantCandidates {
    param([Parameter(Mandatory)][string]$TenantId)
    $raw = $TenantId.Trim()
    $dashless = ($raw -replace '-', '')
    return Get-UniqueStringList -Values @($raw, $dashless)
}

function Get-TokenFromHelperOutput {
    param([Parameter(Mandatory)][string]$Output)

    # Common JSON output pattern
    $m = [regex]::Match($Output, '"access_token"\s*:\s*"(?<token>[^"\r\n]+)"', 'IgnoreCase')
    if ($m.Success) { return $m.Groups['token'].Value }

    # access_token=... or access_token: ...
    $m = [regex]::Match($Output, 'access_token\s*[:=]\s*(?<token>[A-Za-z0-9_\-\.]+)', 'IgnoreCase')
    if ($m.Success) { return $m.Groups['token'].Value }

    # Raw JWT-looking token. Keep this last to avoid matching stack traces.
    $m = [regex]::Match($Output, '(?<token>eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+)')
    if ($m.Success) { return $m.Groups['token'].Value }

    return $null
}

function Invoke-HelperTokenAttempt {
    param(
        [Parameter(Mandatory)][string]$JavaPath,
        [Parameter(Mandatory)][string]$JarPath,
        [Parameter(Mandatory)][string]$TenantId,
        [Parameter(Mandatory)][string]$JsonPath,
        [Parameter(Mandatory)][int]$Attempt
    )

    Write-Log ("Helper attempt #{0}: TenantId={1}" -f $Attempt, $TenantId) 'Cyan'

    # Capture STDOUT + STDERR together. The helper prints stack traces to STDERR on failure.
    $outputLines = @(& $JavaPath -jar $JarPath -t $TenantId -p $JsonPath 2>&1)
    $exit = $LASTEXITCODE
    $output = (($outputLines | ForEach-Object { $_.ToString() }) -join "`n")
    $token = Get-TokenFromHelperOutput -Output $output

    if (-not [string]::IsNullOrWhiteSpace($token)) {
        Write-Log ("SUCCESS: Helper returned access_token. ExitCode={0}; TokenLength={1}; Masked={2}" -f $exit, $token.Length, (Get-ShortMaskedToken -Token $token)) 'Green'
        return [pscustomobject]@{
            Success = $true
            Token   = $token
            ExitCode = $exit
            Output = $output
            TenantId = $TenantId
        }
    }

    $sanitized = $output
    if ($sanitized.Length -gt 4000) { $sanitized = $sanitized.Substring(0, 4000) + '...[truncated]' }
    Write-Log ("FAILED: Helper did not return access_token. ExitCode={0}; Output={1}" -f $exit, $sanitized) 'Red'

    return [pscustomobject]@{
        Success = $false
        Token   = $null
        ExitCode = $exit
        Output = $output
        TenantId = $TenantId
    }
}

function Decode-JwtPayloadSafe {
    param([Parameter(Mandatory)][string]$Token)
    try {
        $parts = $Token.Split('.')
        if ($parts.Count -lt 2) { return $null }
        $payload = $parts[1].Replace('-', '+').Replace('_', '/')
        switch ($payload.Length % 4) {
            2 { $payload += '==' }
            3 { $payload += '=' }
        }
        $bytes = [Convert]::FromBase64String($payload)
        return [Text.Encoding]::UTF8.GetString($bytes) | ConvertFrom-Json
    } catch {
        return $null
    }
}

function Test-SwsApiWithToken {
    param([Parameter(Mandatory)][string]$Token)
    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    Write-Log "Validating token with GET $uri" 'Cyan'
    try {
        $headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }
        $resp = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        Write-Log 'SUCCESS: SWS API GET /sws/policies accepted the token.' 'Green'
        return $true
    } catch {
        $status = $null
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log ("FAILED: SWS API validation call rejected token or endpoint failed. Status={0}; Error={1}" -f $status, $_.Exception.Message) 'Red'
        return $false
    }
}

$finalStatus = 'FAILED'
try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic Started =====' 'Cyan'
    Write-Log "ScriptRoot=$script:ScriptRoot" 'Gray'
    Write-Log "LogPath=$LogPath" 'Gray'

    $java = Resolve-JavaPath
    Test-JavaExecutable -JavaPath $java

    $jar = Resolve-HelperJarPath
    Write-Log "Using helper JAR: $jar" 'Green'

    $json = Resolve-ServiceAccountJsonPath
    $jsonInfo = Get-ServiceAccountJsonInfo -Path $json
    Write-Log "Using SWS JSON: $($jsonInfo.FullName)" 'Green'
    Write-Log "JSON ServiceAccountId=$($jsonInfo.ServiceAccountId); DiscoveryURI=$($jsonInfo.DiscoveryURI)" 'Green'

    $tenants = Get-TenantCandidates -TenantId $SwsTenantId
    Write-Log "Tenant candidate count=$($tenants.Count). Values=$($tenants -join ', ')" 'Cyan'

    $attempt = 0
    $successResult = $null
    $allResults = @()
    foreach ($tenant in $tenants) {
        $attempt++
        $result = Invoke-HelperTokenAttempt -JavaPath $java -JarPath $jar -TenantId $tenant -JsonPath $json -Attempt $attempt
        $allResults += $result
        if ($result.Success) {
            $successResult = $result
            break
        }
    }

    if ($null -eq $successResult) {
        Write-Log 'TOKEN GENERATION FAILED: CyberArk helper did not return an access_token for any tenant candidate.' 'Red'
        Write-Log 'This confirms Java/JAR execution works, but CyberArk rejected the service-account authentication request.' 'Red'
        throw 'No access_token returned.'
    }

    $token = $successResult.Token

    $payload = Decode-JwtPayloadSafe -Token $token
    if ($null -ne $payload) {
        $payloadSummary = [ordered]@{
            iss = $payload.iss
            sub = $payload.sub
            aud = $payload.aud
            exp = $payload.exp
            iat = $payload.iat
            scope = $payload.scope
        }
        Write-Log ("JWT payload summary: {0}" -f (ConvertTo-JsonSafe $payloadSummary)) 'Green'
    } else {
        Write-Log 'Token was returned, but JWT payload could not be decoded. This may still be valid if token format is opaque.' 'Yellow'
    }

    if ($ValidateAgainstSwsApi) {
        $valid = Test-SwsApiWithToken -Token $token
        if (-not $valid) { throw 'Token was generated but failed SWS API validation.' }
    }

    if ($ShowToken) {
        Write-Host ''
        Write-Host '===== RAW ACCESS TOKEN =====' -ForegroundColor Yellow
        Write-Host $token
        Write-Host '===== END RAW ACCESS TOKEN =====' -ForegroundColor Yellow
    }

    if ($SaveTokenToFile) {
        if ([string]::IsNullOrWhiteSpace($TokenOutputPath)) {
            $TokenOutputPath = Join-Path $script:ScriptRoot 'sws_access_token.txt'
        }
        Set-Content -Path $TokenOutputPath -Value $token -NoNewline -Force
        Write-Log "Saved raw access token to: $TokenOutputPath" 'Yellow'
    }

    Write-Log 'TOKEN GENERATION SUCCESS.' 'Green'
    $finalStatus = 'SUCCESS'
}
catch {
    Write-Log ("FATAL ERROR: {0}" -f $_.Exception.Message) 'Red'
}
finally {
    Write-Log "===== CyberArk SWS Token Generation ONLY Diagnostic Finished: $finalStatus =====" $(if ($finalStatus -eq 'SUCCESS') { 'Green' } else { 'Red' })
}
