<#
.SYNOPSIS
    CNA CyberArk Safe Member + Account Compliance Report

.DESCRIPTION
    - Authenticates to CNA Privilege Cloud using CCP + psPAS Identity Header
    - Pulls account inventory using Get-PASAccount
    - Pulls platform rotation settings using Get-PASPlatform
    - Pulls safe members using Get-PASSafeMember
    - Joins safe membership data to account inventory by Safe name
    - Calculates Expiration Due (Days) using:
        1. Explicit expiration property, if CyberArk returns one
        2. Last Modified Date + platform requirePasswordChangeEveryXDays
        3. Last Modified Date + DefaultExpirationDays fallback

.OUTPUT
    CSV columns:
        Safe
        Member
        MemberType
        Target Username
        Address
        Account Safe
        Platform Identity
        Compliance Status
        Expiration Due (Days)
        Last Modified Date

.NOTES
    This script is report-only.
    It does not add, modify, delete, verify, reconcile, or rotate accounts.

    CyberArk API mapping:
        Target Username    = account.userName
        Address            = account.address
        Account Safe       = account.safeName
        Platform Identity  = account.platformId
        Compliance Status  = account.secretManagement.status
        Last Modified Date = account.secretManagement.lastModifiedDateTime / lastModifiedTime
        Expiration Due     = calculated from rotation policy where available
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings CNA =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Processing controls =====
    # Leave blank to include all account safes visible to the service user.
    [string]$SafeNameFilter = '',

    # Recommended default: process only safes that contain accounts.
    # This avoids spending time on internal/system safes such as VaultInternal, PVWAReports, SharedAuth_Internal, etc.
    [bool]$ProcessOnlySafesWithAccounts = $true,

    # Include safes that have no account rows in the report.
    # Usually false for this report because the requested output is account-driven.
    [bool]$IncludeSafesWithNoAccounts = $false,

    # If platform rotation days cannot be read, use this value.
    # Set to 0 if you want blank Expiration Due values when platform policy cannot be resolved.
    [int]$DefaultExpirationDays = 90,

    # If platform says performPeriodicChange = false, leave Expiration Due blank unless this is true.
    [bool]$CalculateExpirationWhenPeriodicChangeDisabled = $false,

    # ===== Output paths =====
    [string]$OutputFolder = 'E:\Installation Media\Script\OnboardScript\data',
    [string]$CsvName      = 'SafeMember_Account_Compliance_Report.csv',
    [string]$LogFileName  = 'SafeMember_Account_Compliance_Report.log'
)

# ============================================
# Runtime Settings
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ============================================
# Paths
# ============================================

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
}

$CsvFilePath = Join-Path $OutputFolder $CsvName
$LogFile     = Join-Path $OutputFolder $LogFileName

New-Item -ItemType File -Force -Path $LogFile | Out-Null

# ============================================
# Logger
# ============================================

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# ============================================
# Helper: Normalize Identity Tenant URL
# ============================================

function Get-NormalizedIdentityTenant {
    param(
        [Parameter(Mandatory)]
        [string]$TenantUrl
    )

    $normalized = $TenantUrl.Trim()

    if ($normalized -notmatch '^https?://') {
        $normalized = "https://$normalized"
    }

    return $normalized.TrimEnd('/')
}

# ============================================
# Helper: Get object property safely
# ============================================

function Get-ObjectPropertyValue {
    param(
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propName in $PropertyNames) {
        if ($InputObject.PSObject.Properties.Name -contains $propName) {
            return $InputObject.$propName
        }

        if ($InputObject -is [hashtable] -and $InputObject.ContainsKey($propName)) {
            return $InputObject[$propName]
        }
    }

    return $null
}

# ============================================
# Helper: Get nested object property safely
# ============================================

function Get-NestedPropertyValue {
    param(
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$ParentPropertyNames,

        [Parameter(Mandatory)]
        [string[]]$ChildPropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($parentName in $ParentPropertyNames) {
        $parent = Get-ObjectPropertyValue -InputObject $InputObject -PropertyNames @($parentName)

        if ($null -ne $parent) {
            foreach ($childName in $ChildPropertyNames) {
                if ($parent.PSObject.Properties.Name -contains $childName) {
                    return $parent.$childName
                }

                if ($parent -is [hashtable] -and $parent.ContainsKey($childName)) {
                    return $parent[$childName]
                }
            }
        }
    }

    return $null
}

# ============================================
# Helper: Convert CyberArk date safely
# Supports:
#   - ISO strings
#   - DateTime values
#   - Unix epoch seconds
#   - Unix epoch milliseconds
#   - Blank/null values
# ============================================

function Convert-CyberArkDate {
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($null -eq $Value) {
        return $null
    }

    if ($Value -is [datetime]) {
        return $Value.ToLocalTime()
    }

    $stringValue = [string]$Value

    if ([string]::IsNullOrWhiteSpace($stringValue)) {
        return $null
    }

    if ($stringValue -match '^\d+$') {
        try {
            $number = [int64]$stringValue

            if ($number -le 0) {
                return $null
            }

            # Epoch milliseconds
            if ($number -gt 9999999999) {
                return [DateTimeOffset]::FromUnixTimeMilliseconds($number).LocalDateTime
            }

            # Epoch seconds
            return [DateTimeOffset]::FromUnixTimeSeconds($number).LocalDateTime
        } catch {
            return $null
        }
    }

    try {
        return ([datetime]::Parse($stringValue)).ToLocalTime()
    } catch {
        return $null
    }
}

# ============================================
# Helper: Get account last modified date
# ============================================

function Get-AccountLastModifiedDate {
    param(
        [AllowNull()]
        [object]$Account
    )

    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime'
        )

    if ($null -eq $value) {
        $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime',
            'categoryModificationTime',
            'CategoryModificationTime',
            'createdTime',
            'CreatedTime'
        )
    }

    return Convert-CyberArkDate -Value $value
}

# ============================================
# Helper: Get account explicit expiration date if present
# CyberArk does not always expose this on standard account inventory.
# ============================================

function Get-AccountExplicitExpirationDate {
    param(
        [AllowNull()]
        [object]$Account
    )

    $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
        'expirationDate',
        'ExpirationDate',
        'expiryDate',
        'ExpiryDate',
        'accountExpirationDate',
        'AccountExpirationDate',
        'passwordExpirationDate',
        'PasswordExpirationDate',
        'passwordExpiryDate',
        'PasswordExpiryDate'
    )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @(
            'platformAccountProperties',
            'PlatformAccountProperties',
            'properties',
            'Properties'
        ) `
        -ChildPropertyNames @(
            'expirationDate',
            'ExpirationDate',
            'expiryDate',
            'ExpiryDate',
            'accountExpirationDate',
            'AccountExpirationDate',
            'passwordExpirationDate',
            'PasswordExpirationDate',
            'passwordExpiryDate',
            'PasswordExpiryDate'
        )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    return $null
}

# ============================================
# Helper: Get account compliance status
# ============================================

function Get-AccountComplianceStatus {
    param(
        [AllowNull()]
        [object]$Account
    )

    $status = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('status', 'Status')

    $automaticManagementEnabled = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('automaticManagementEnabled', 'AutomaticManagementEnabled')

    $manualReason = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('manualManagementReason', 'ManualManagementReason')

    if ($null -ne $automaticManagementEnabled) {
        $autoString = ([string]$automaticManagementEnabled).Trim()

        if ($autoString -ieq 'False') {
            if (-not [string]::IsNullOrWhiteSpace([string]$manualReason)) {
                return "Automatic Management Disabled - $manualReason"
            }

            return 'Automatic Management Disabled'
        }
    }

    if (-not [string]::IsNullOrWhiteSpace([string]$status)) {
        return [string]$status
    }

    return ''
}

# ============================================
# Helper: Calculate expiration due days safely
# Important fix: no [datetime] mandatory binding here.
# ============================================

function Get-ExpirationDueDays {
    param(
        [AllowNull()]
        [object]$ExplicitExpirationDate,

        [AllowNull()]
        [object]$LastModifiedDate,

        [AllowNull()]
        [object]$RotationPeriodDays
    )

    $expirationDate = Convert-CyberArkDate -Value $ExplicitExpirationDate
    $modifiedDate   = Convert-CyberArkDate -Value $LastModifiedDate

    $rotationDays = $null

    if ($null -ne $RotationPeriodDays -and -not [string]::IsNullOrWhiteSpace([string]$RotationPeriodDays)) {
        try {
            $rotationDays = [int]$RotationPeriodDays
        } catch {
            $rotationDays = $null
        }
    }

    $effectiveExpirationDate = $null

    if ($null -ne $expirationDate) {
        $effectiveExpirationDate = $expirationDate
    } elseif ($null -ne $modifiedDate -and $null -ne $rotationDays -and $rotationDays -gt 0) {
        $effectiveExpirationDate = $modifiedDate.AddDays($rotationDays)
    }

    if ($null -eq $effectiveExpirationDate) {
        return ''
    }

    return [math]::Floor(($effectiveExpirationDate - (Get-Date)).TotalDays)
}

# ============================================
# Helper: Get safe name from Safe or Account object
# ============================================

function Get-ResolvedSafeName {
    param(
        [AllowNull()]
        [object]$InputObject
    )

    return Get-ObjectPropertyValue -InputObject $InputObject -PropertyNames @(
        'safeName',
        'SafeName',
        'Safe',
        'safe',
        'Name',
        'name'
    )
}

# ============================================
# Import Modules
# ============================================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $psPASModule = Get-Module psPAS

    if ($psPASModule) {
        Write-Log ("psPAS module loaded. Version: {0}" -f $psPASModule.Version) 'Green'
    } else {
        Write-Log "psPAS module loaded." 'Green'
    }
} catch {
    Write-Log ("ERROR: Failed to import psPAS module. {0}" -f $_.Exception.Message) 'Red'
    throw
}

if (-not (Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Get-IdentityHeader cmdlet was not found. Confirm IdentityCommand module is installed and available." 'Red'
    throw "Get-IdentityHeader cmdlet not found."
}

# ============================================
# Login Method: CCP + psPAS Identity Header
# ============================================

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)]
        [string]$ObjectName
    )

    $headers = @{
        'Content-Type' = 'application/json'
    }

    $ccpUrl = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod `
            -Uri $ccpUrl `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response or missing Content field.'
        }
    } catch {
        Write-Log ("ERROR: CCP credential fetch failed. {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null

    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("Successfully retrieved CCP credential for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication using psPAS Identity header as {0}..." -f $resolvedUser) 'Cyan'
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'
        Write-Log ("Privilege Cloud Subdomain: {0}" -f $PCloudSubdomain) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established.'
        }

        Write-Log ("Authentication successful. PAS session established as {0}." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("ERROR: Failed to authenticate via psPAS Identity header. {0}" -f $_.Exception.Message) 'Red'
        throw
    } finally {
        try {
            if ($resp.PSObject.Properties.Name -contains 'Content') {
                $resp.Content = $null
            }
        } catch {}

        try {
            if ($securePass) {
                $securePass.Dispose()
            }
        } catch {}
    }

    return $resolvedUser
}

# ============================================
# Get Accounts Helper
# ============================================

function Get-AllVisiblePASAccounts {
    $params = @{}

    $cmd = Get-Command Get-PASAccount -ErrorAction Stop

    if ($cmd.Parameters.ContainsKey('Limit')) {
        $params['Limit'] = 1000
    } elseif ($cmd.Parameters.ContainsKey('limit')) {
        $params['limit'] = 1000
    }

    Write-Log "Retrieving all visible accounts using Get-PASAccount..." 'Yellow'

    $accounts = Get-PASAccount @params -ErrorAction Stop

    if ($null -eq $accounts) {
        return @()
    }

    return @($accounts)
}

# ============================================
# Get Platform Rotation Map
# ============================================

function Get-PlatformRotationMap {
    $map = @{}

    Write-Log "Retrieving platform rotation settings using Get-PASPlatform..." 'Yellow'

    try {
        $platformCommand = Get-Command Get-PASPlatform -ErrorAction Stop
        $platformParams = @{}

        if ($platformCommand.Parameters.ContainsKey('Active')) {
            $platformParams['Active'] = $true
        }

        if ($platformCommand.Parameters.ContainsKey('PlatformType')) {
            $platformParams['PlatformType'] = 'Regular'
        }

        $platformResponse = Get-PASPlatform @platformParams -ErrorAction Stop

        $platformItems = @()

        if ($null -eq $platformResponse) {
            $platformItems = @()
        } elseif ($platformResponse.PSObject.Properties.Name -contains 'Platforms') {
            $platformItems = @($platformResponse.Platforms)
        } else {
            $platformItems = @($platformResponse)
        }

        foreach ($platform in $platformItems) {
            $platformId = Get-NestedPropertyValue `
                -InputObject $platform `
                -ParentPropertyNames @('general', 'General') `
                -ChildPropertyNames @('id', 'ID', 'platformId', 'PlatformId')

            if ([string]::IsNullOrWhiteSpace([string]$platformId)) {
                $platformId = Get-ObjectPropertyValue -InputObject $platform -PropertyNames @(
                    'id',
                    'ID',
                    'platformId',
                    'PlatformId',
                    'PlatformID'
                )
            }

            $rotationDays = Get-NestedPropertyValue `
                -InputObject $platform `
                -ParentPropertyNames @('credentialsManagement', 'CredentialsManagement') `
                -ChildPropertyNames @(
                    'requirePasswordChangeEveryXDays',
                    'RequirePasswordChangeEveryXDays'
                )

            $performPeriodicChange = Get-NestedPropertyValue `
                -InputObject $platform `
                -ParentPropertyNames @('credentialsManagement', 'CredentialsManagement') `
                -ChildPropertyNames @(
                    'performPeriodicChange',
                    'PerformPeriodicChange'
                )

            if (-not [string]::IsNullOrWhiteSpace([string]$platformId)) {
                $map[[string]$platformId] = [PSCustomObject]@{
                    PlatformId            = [string]$platformId
                    RotationDays          = $rotationDays
                    PerformPeriodicChange = $performPeriodicChange
                }
            }
        }

        Write-Log ("Platform rotation settings loaded for {0} platform(s)." -f $map.Count) 'Green'
    } catch {
        Write-Log ("WARNING: Could not retrieve platform settings. Expiration calculation will use DefaultExpirationDays={0}. {1}" -f $DefaultExpirationDays, $_.Exception.Message) 'Yellow'
    }

    return $map
}

# ============================================
# Start Script
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "CNA Safe Member + Account Compliance Report started." 'Cyan'
Write-Log ("Identity Tenant URL                    : {0}" -f $IdentityTenantURL) 'Gray'
Write-Log ("Privilege Cloud URL                    : {0}" -f $PrivilegeCloudURL) 'Gray'
Write-Log ("PCloud Subdomain                       : {0}" -f $PCloudSubdomain) 'Gray'
Write-Log ("CCP Address                            : {0}" -f $CCPAddress) 'Gray'
Write-Log ("CCP AppID                              : {0}" -f $CCPAppID) 'Gray'
Write-Log ("CCP Safe                               : {0}" -f $CCPSafe) 'Gray'
Write-Log ("CCP Object                             : {0}" -f $CCPObject) 'Gray'
Write-Log ("SafeNameFilter                         : {0}" -f $SafeNameFilter) 'Gray'
Write-Log ("ProcessOnlySafesWithAccounts           : {0}" -f $ProcessOnlySafesWithAccounts) 'Gray'
Write-Log ("IncludeSafesWithNoAccounts             : {0}" -f $IncludeSafesWithNoAccounts) 'Gray'
Write-Log ("DefaultExpirationDays                  : {0}" -f $DefaultExpirationDays) 'Gray'
Write-Log ("CalculateWhenPeriodicChangeDisabled    : {0}" -f $CalculateExpirationWhenPeriodicChangeDisabled) 'Gray'
Write-Log ("CSV Report                             : {0}" -f $CsvFilePath) 'Gray'
Write-Log "============================================================" 'Gray'

# ============================================
# Authenticate
# ============================================

try {
    $AuthenticatedUser = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    Write-Log ("FATAL: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve accounts first
# This is faster than querying Get-PASAccount once per safe.
# ============================================

try {
    $Accounts = Get-AllVisiblePASAccounts

    if (-not [string]::IsNullOrWhiteSpace($SafeNameFilter)) {
        $Accounts = @(
            $Accounts | Where-Object {
                $acctSafe = Get-ResolvedSafeName -InputObject $_
                $acctSafe -like $SafeNameFilter
            }
        )
    }

    Write-Log ("Retrieved {0} visible account(s)." -f $Accounts.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to retrieve accounts. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Group accounts by Safe
# ============================================

$AccountsBySafe = @{}

foreach ($account in $Accounts) {
    $safeName = Get-ResolvedSafeName -InputObject $account

    if ([string]::IsNullOrWhiteSpace([string]$safeName)) {
        continue
    }

    $safeKey = [string]$safeName

    if (-not $AccountsBySafe.ContainsKey($safeKey)) {
        $AccountsBySafe[$safeKey] = New-Object System.Collections.Generic.List[object]
    }

    $AccountsBySafe[$safeKey].Add($account)
}

Write-Log ("Accounts grouped across {0} safe(s)." -f $AccountsBySafe.Keys.Count) 'Green'

# ============================================
# Retrieve Safes
# ============================================

Write-Log "Retrieving safe list..." 'Yellow'

try {
    $Safes = Get-PASSafe -ErrorAction Stop

    if ($null -eq $Safes) {
        $Safes = @()
    } else {
        $Safes = @($Safes)
    }

    if (-not [string]::IsNullOrWhiteSpace($SafeNameFilter)) {
        $Safes = @(
            $Safes | Where-Object {
                $safeName = Get-ResolvedSafeName -InputObject $_
                $safeName -like $SafeNameFilter
            }
        )
    }

    if ($ProcessOnlySafesWithAccounts) {
        $Safes = @(
            $Safes | Where-Object {
                $safeName = Get-ResolvedSafeName -InputObject $_
                $AccountsBySafe.ContainsKey([string]$safeName)
            }
        )
    }

    Write-Log ("Retrieved {0} safe(s) to process." -f $Safes.Count) 'Green'
} catch {
    Write-Log ("FATAL: Failed to retrieve safes. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve platform rotation map
# ============================================

$PlatformRotationMap = Get-PlatformRotationMap

# ============================================
# Build Report
# ============================================

$ReportRows = New-Object System.Collections.Generic.List[object]

$totalSafes      = $Safes.Count
$currentSafe     = 0
$successfulSafes = 0
$failedSafes     = 0
$totalRows       = 0

foreach ($Safe in $Safes) {
    $currentSafe++

    $SafeName = Get-ResolvedSafeName -InputObject $Safe

    if ([string]::IsNullOrWhiteSpace([string]$SafeName)) {
        Write-Log ("[{0}/{1}] WARNING: Could not resolve safe name. Skipping." -f $currentSafe, $totalSafes) 'Yellow'
        continue
    }

    $SafeName = [string]$SafeName

    Write-Log ("[{0}/{1}] Processing safe: {2}" -f $currentSafe, $totalSafes, $SafeName) 'Cyan'

    try {
        # -----------------------------
        # Retrieve safe members
        # -----------------------------
        try {
            $SafeMembers = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop

            if ($null -eq $SafeMembers) {
                $SafeMembers = @()
            } else {
                $SafeMembers = @($SafeMembers)
            }

            Write-Log ("Safe '{0}' member count: {1}" -f $SafeName, $SafeMembers.Count) 'Gray'
        } catch {
            Write-Log ("WARNING: Could not retrieve members for safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Yellow'
            $SafeMembers = @()
        }

        # -----------------------------
        # Get accounts from grouped cache
        # -----------------------------
        if ($AccountsBySafe.ContainsKey($SafeName)) {
            $SafeAccounts = @($AccountsBySafe[$SafeName])
        } else {
            $SafeAccounts = @()
        }

        Write-Log ("Safe '{0}' account count: {1}" -f $SafeName, $SafeAccounts.Count) 'Gray'

        if ($SafeAccounts.Count -eq 0 -and -not $IncludeSafesWithNoAccounts) {
            Write-Log ("Safe '{0}' has no accounts. Skipping rows." -f $SafeName) 'Yellow'
            $successfulSafes++
            continue
        }

        if ($SafeMembers.Count -eq 0) {
            $SafeMembers = @(
                [PSCustomObject]@{
                    memberName = ''
                    memberType = ''
                }
            )
        }

        if ($SafeAccounts.Count -eq 0 -and $IncludeSafesWithNoAccounts) {
            $SafeAccounts = @(
                [PSCustomObject]@{
                    safeName   = $SafeName
                    userName   = ''
                    address    = ''
                    platformId = ''
                }
            )
        }

        # -----------------------------
        # Join members to accounts
        # -----------------------------
        foreach ($Member in $SafeMembers) {
            $memberName = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'memberName',
                'MemberName',
                'UserName',
                'username',
                'Name',
                'name'
            )

            $memberType = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'memberType',
                'MemberType',
                'Type',
                'type'
            )

            foreach ($Account in $SafeAccounts) {
                $targetUsername = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'userName',
                    'UserName',
                    'username',
                    'Username'
                )

                $address = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'address',
                    'Address'
                )

                $accountSafe = Get-ResolvedSafeName -InputObject $Account

                if ([string]::IsNullOrWhiteSpace([string]$accountSafe)) {
                    $accountSafe = $SafeName
                }

                $platformIdentity = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'platformId',
                    'PlatformID',
                    'PlatformId',
                    'platformID'
                )

                $complianceStatus = Get-AccountComplianceStatus -Account $Account
                $lastModifiedDate = Get-AccountLastModifiedDate -Account $Account
                $explicitExpirationDate = Get-AccountExplicitExpirationDate -Account $Account

                $rotationDays = $null
                $performPeriodicChange = $null

                if (-not [string]::IsNullOrWhiteSpace([string]$platformIdentity) -and $PlatformRotationMap.ContainsKey([string]$platformIdentity)) {
                    $rotationDays = $PlatformRotationMap[[string]$platformIdentity].RotationDays
                    $performPeriodicChange = $PlatformRotationMap[[string]$platformIdentity].PerformPeriodicChange
                }

                if ($null -eq $rotationDays -or [string]::IsNullOrWhiteSpace([string]$rotationDays)) {
                    if ($DefaultExpirationDays -gt 0) {
                        $rotationDays = $DefaultExpirationDays
                    }
                }

                $shouldCalculateExpiration = $true

                if ($null -ne $performPeriodicChange) {
                    if (([string]$performPeriodicChange).Trim() -ieq 'False' -and -not $CalculateExpirationWhenPeriodicChangeDisabled) {
                        $shouldCalculateExpiration = $false
                    }
                }

                if ($shouldCalculateExpiration) {
                    $expirationDueDays = Get-ExpirationDueDays `
                        -ExplicitExpirationDate $explicitExpirationDate `
                        -LastModifiedDate $lastModifiedDate `
                        -RotationPeriodDays $rotationDays
                } else {
                    $expirationDueDays = ''
                }

                $lastModifiedOutput = ''

                if ($null -ne $lastModifiedDate) {
                    $lastModifiedOutput = $lastModifiedDate.ToString('yyyy-MM-dd HH:mm:ss')
                }

                $ReportRows.Add([PSCustomObject]@{
                    'Safe'                  = $SafeName
                    'Member'                = $memberName
                    'MemberType'            = $memberType
                    'Target Username'       = $targetUsername
                    'Address'               = $address
                    'Account Safe'          = $accountSafe
                    'Platform Identity'     = $platformIdentity
                    'Compliance Status'     = $complianceStatus
                    'Expiration Due (Days)' = $expirationDueDays
                    'Last Modified Date'    = $lastModifiedOutput
                })

                $totalRows++
            }
        }

        $successfulSafes++
        Write-Log ("Completed safe '{0}'." -f $SafeName) 'Green'
    } catch {
        $failedSafes++
        Write-Log ("ERROR: Failed while processing safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Red'
    }
}

# ============================================
# Export Report
# ============================================

try {
    Write-Log "Exporting report to CSV..." 'Yellow'

    $ReportRows |
        Sort-Object 'Safe', 'Member', 'Target Username', 'Address' |
        Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

    Write-Log ("Report exported successfully: {0}" -f $CsvFilePath) 'Green'
} catch {
    Write-Log ("ERROR: Failed to export CSV. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Close Session
# ============================================

try {
    Close-PASSession | Out-Null
    Write-Log "PAS session closed." 'Gray'
} catch {
    Write-Log ("WARNING: Could not close PAS session cleanly. {0}" -f $_.Exception.Message) 'Yellow'
}

# ============================================
# Completion
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "Safe Member + Account Compliance Report completed." 'Green'
Write-Log ("Authenticated User : {0}" -f $AuthenticatedUser) 'Gray'
Write-Log ("Accounts Retrieved : {0}" -f $Accounts.Count) 'Gray'
Write-Log ("Safes Processed    : {0}" -f $totalSafes) 'Gray'
Write-Log ("Successful Safes   : {0}" -f $successfulSafes) 'Green'
Write-Log ("Failed Safes       : {0}" -f $failedSafes) 'Red'
Write-Log ("Rows Exported      : {0}" -f $totalRows) 'Gray'
Write-Log ("Report Path        : {0}" -f $CsvFilePath) 'Gray'
Write-Log ("Log Path           : {0}" -f $LogFile) 'Gray'
Write-Log "============================================================" 'Gray'
