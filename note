<#
Outputs next to input CSV:
  - AccountStatus.csv     -> ADExists + Enabled (no DN)
  - AccountOwnership.csv  -> ONLY rows with both owners found in 'info'; ONLY 3 columns:
                             samAccountName, PrimaryOwner, SecondaryOwnerOrApprover

Notes:
- Primary/Secondary are parsed *exclusively* from the AD 'info' attribute using robust regex.
- Handles variants like:
    "PrimaryOwner:", "Primary Owner -", "Primary Owner =",
    "SecondaryOwner/approver:", "Secondary Owner / Approver -", "Secondary Owner Approver:"
- Captures values until a delimiter (; , | newline) or end-of-string.
#>

# ================================
# CONFIG — EDIT ME
# ================================
$InputCsvPath       = "C:\Data\accounts.csv"  # local path to input CSV
$EnforceStartsWithC = $false                  # optional internal check (no extra columns)
# ================================

# ---------- Prep & validation ----------
if (-not (Test-Path $InputCsvPath)) { throw "Input CSV not found: $InputCsvPath" }

$OutDir = Split-Path -Path $InputCsvPath -Parent
if (-not $OutDir) { $OutDir = "." }

$StatusCsv    = Join-Path $OutDir 'AccountStatus.csv'
$OwnershipCsv = Join-Path $OutDir 'AccountOwnership.csv'

# Ensure AD module
if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
  throw "ActiveDirectory module not found. Install RSAT or run on a domain-joined host with RSAT."
}

# ---------- Load input ----------
$rows = Import-Csv -Path $InputCsvPath
if (-not $rows -or $rows.Count -eq 0) { throw "Input CSV appears empty: $InputCsvPath" }

# Determine username column
$possibleCols = @('samAccountName','Account')
$samCol = $possibleCols | Where-Object { $_ -in $rows[0].PsObject.Properties.Name }
if (-not $samCol) { throw "Input CSV must contain a column named 'samAccountName' or 'Account'." }

# ---------- Regex built for 'info' parsing ----------
# Label patterns:
#   - Primary Owner variants: PrimaryOwner | Primary Owner
#   - Secondary variants: SecondaryOwner/approver | Secondary Owner/Approver | Secondary Owner Approver | Secondary Approver
# Separators: ':', '-', '=', or whitespace
# Value: everything until ; , | newline or end (non-greedy)
$rxPrimary = [regex]'(?im)\bPrimary\s*Owner\b\s*[:=\-]?\s*(?<val>.+?)(?=[;,\|\r\n]|$)'
$rxSecondary = [regex]'(?im)\bSecondary\s*Owner(?:\s*/\s*|\s+)?(?:Approver)?\b\s*[:=\-]?\s*(?<val>.+?)(?=[;,\|\r\n]|$)|\bSecondary\s*Approver\b\s*[:=\-]?\s*(?<val>.+?)(?=[;,\|\r\n]|$)'
$rxStartsWithC = [regex]'(?i)^\s*C'

function Clean-Val([string]$s) {
  if ([string]::IsNullOrWhiteSpace($s)) { return "" }
  # Trim spaces + trailing delimiters
  return ($s.Trim(" `t`r`n", ";", ",", "|")).Trim()
}

# ---------- Process ----------
$statusOut    = New-Object System.Collections.Generic.List[object]
$ownershipAll = New-Object System.Collections.Generic.List[object]  # collect, then filter to both owners

foreach ($row in $rows) {
  $sam = ($row.$samCol).ToString().Trim()
  if ([string]::IsNullOrWhiteSpace($sam)) { continue }

  $user = $null
  try {
    # We ONLY use 'info' for owners; other props used for status columns
    $user = Get-ADUser -LDAPFilter "(sAMAccountName=$sam)" -Properties Enabled, info, whenCreated, lastLogonDate
  } catch { }

  if ($null -eq $user) {
    # Status (no DN)
    $statusOut.Add([pscustomobject]@{
      samAccountName = $sam
      ADExists       = 'No'
      Enabled        = ''
      WhenCreated    = ''
      LastLogonDate  = ''
    })
    continue
  }

  $enabled = $false
  if ($user.PSObject.Properties['Enabled']) { $enabled = [bool]$user.Enabled }

  # Status (no DN)
  $statusOut.Add([pscustomobject]@{
    samAccountName = $sam
    ADExists       = 'Yes'
    Enabled        = $(if ($enabled) { 'Enabled' } else { 'Disabled' })
    WhenCreated    = $user.whenCreated
    LastLogonDate  = $user.lastLogonDate
  })

  # --- Parse ONLY from 'info' ---
  $infoText = ($user.info | Out-String)
  $primaryVal = ""
  $secondaryVal = ""

  if (-not [string]::IsNullOrWhiteSpace($infoText)) {
    $m1 = $rxPrimary.Matches($infoText)
    if ($m1.Count -gt 0) { $primaryVal = Clean-Val ($m1[0].Groups['val'].Value) }

    $m2 = $rxSecondary.Matches($infoText)
    if ($m2.Count -gt 0) { $secondaryVal = Clean-Val ($m2[0].Groups['val'].Value) }

    # Optional internal check—no extra columns produced
    if ($EnforceStartsWithC) {
      if ($primaryVal -and -not $rxStartsWithC.IsMatch($primaryVal))   { } # keep silently
      if ($secondaryVal -and -not $rxStartsWithC.IsMatch($secondaryVal)) { } # keep silently
    }
  }

  # Collect; we will filter to BOTH owners at export time
  $ownershipAll.Add([pscustomobject]@{
    samAccountName           = $sam
    PrimaryOwner             = $primaryVal
    SecondaryOwnerOrApprover = $secondaryVal
  })
}

# ---------- Output ----------
# Status as requested (no DN)
$statusOut | Export-Csv -Path $StatusCsv -NoTypeInformation -Encoding UTF8

# Ownership: ONLY rows where BOTH owners were found in 'info'; ONLY 3 columns
$ownershipAll
| Where-Object { $_.PrimaryOwner -and $_.SecondaryOwnerOrApprover }
| Select-Object samAccountName, PrimaryOwner, SecondaryOwnerOrApprover
| Export-Csv -Path $OwnershipCsv -NoTypeInformation -Encoding UTF8

Write-Host "✅ Done."
Write-Host " - Status CSV:    $StatusCsv"
Write-Host " - Ownership CSV: $OwnershipCsv (only rows with BOTH owners parsed from 'info')"
