<#
CNA_Clone_Identity_WebApp_DirectGroupPermissions_v2.ps1

Changes in this version
- Keeps the Identity web session cookie from Start/AdvanceAuthentication
- Retries Identity admin calls with:
    1) Bearer + Cookie
    2) Cookie only
    3) Bearer only
- Retries /Redrock/query and /Redrock/Query
- Lets you bypass Redrock lookup entirely if you already know the source App Key
- Hard-codes your current test values unless -UsePrompt is supplied

Current test defaults
- Source App      : GCP - Okta Prod
- New App Name    : g-test-pam1
- Target Group    : ca_PCloud_Admins
- Safe Name       : CyberArkTestValidation
- Account Name    : PC0VPXSB.cna.com-administrator
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings (CNA) =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Test defaults =====
    [string]$SourceAppInput    = 'GCP - Okta Prod',
    [string]$SourceAppKey      = '',
    [string]$VaultedUserName   = 'g-test-pam1',
    [string]$TargetGroup       = 'ca_PCloud_Admins',
    [string]$SafeName          = 'CyberArkTestValidation',
    [string]$AccountName       = 'PC0VPXSB.cna.com-administrator',

    # ===== Logging / reporting =====
    [string]$LogPath           = 'E:\Installation Media\Script\OnboardScript\data\Identity_DirectGroupPermissions_v2.log',
    [string]$ReportCsvPath     = 'E:\Installation Media\Script\OnboardScript\data\Identity_DirectGroupPermissions_v2_Report.csv',

    # ===== Advanced =====
    [string]$CloneEndpointPath = '/SaasManage/CloneApplication',
    [switch]$ForcePermissionReplace,
    [switch]$UsePrompt,
    [switch]$WhatIf
)

# --- Allow process-scope execution / unblock psPAS files ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try { Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {}
}

# --- Globals ---
$script:IdentityAuthToken  = $null
$script:IdentityUser       = $null
$script:IdentityWebSession = $null
$script:PasCredential      = $null
$script:ReportRows         = New-Object System.Collections.Generic.List[object]

# --- Logging ---
function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Add-ReportRow {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail
    )

    $script:ReportRows.Add([pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }) | Out-Null
}

# --- Helpers ---
function Get-NormalizedIdentityTenant {
    param([Parameter(Mandatory)][string]$TenantUrl)

    $value = $TenantUrl.Trim()
    $value = $value -replace '^https?://', ''
    $value = $value.TrimEnd('/')
    return $value
}

function Escape-SqlLiteral {
    param([AllowNull()][string]$Value)
    if ($null -eq $Value) { return '' }
    return ($Value -replace "'", "''")
}

function Get-HttpStatusCode {
    param([Parameter(Mandatory)]$Exception)
    try {
        return [int]$Exception.Response.StatusCode.value__
    } catch {
        return $null
    }
}

function ConvertTo-JsonSafe {
    param([Parameter()][object]$Object)

    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 30)
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) 'Green'
    Add-ReportRow -Step 'Load psPAS' -Status 'SUCCESS' -Detail ("Version {0}" -f $mod.Version)
} catch {
    Write-Log ("FAILED: psPAS module not found/loaded: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Load psPAS' -Status 'FAILED' -Detail $_.Exception.Message
    exit 1
}

# --- PAS auth from CCP ---
function Start-PASSessionFromCCP {
    param([Parameter(Mandatory)][string]$ObjectName)

    $headers = @{ 'Content-Type' = 'application/json' }
    $ccpUrl  = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response.'
        }

        $resolvedUser = $null
        if ($resp.PSObject.Properties.Name -contains 'Username') {
            $resolvedUser = [string]$resp.Username
        } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
            $resolvedUser = [string]$resp.UserName
        }

        if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
            throw 'CCP returned password but no Username/UserName field.'
        }

        $secure = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $script:PasCredential = [PSCredential]::new($resolvedUser, $secure)

        Write-Log ("Successfully retrieved credentials for service user: {0}" -f $resolvedUser) 'Green'
        Add-ReportRow -Step 'CCP Retrieve' -Status 'SUCCESS' -Detail ("User {0}" -f $resolvedUser)
    } catch {
        Write-Log ("FAILED: CCP credential fetch failed - {0}" -f $_.Exception.Message) 'Red'
        Add-ReportRow -Step 'CCP Retrieve' -Status 'FAILED' -Detail $_.Exception.Message
        throw
    }

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

        Write-Log 'Requesting PAS session via psPAS Identity header...' 'Cyan'
        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $script:PasCredential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established.'
        }

        Write-Log ("PAS session established ({0})." -f $script:PasCredential.UserName) 'Green'
        Add-ReportRow -Step 'PAS Session' -Status 'SUCCESS' -Detail ("Authenticated as {0}" -f $script:PasCredential.UserName)
    } catch {
        Write-Log ("FAILED: PAS authentication failed: {0}" -f $_.Exception.Message) 'Red'
        Add-ReportRow -Step 'PAS Session' -Status 'FAILED' -Detail $_.Exception.Message
        throw
    }

    return $resp
}

# --- Identity auth ---
function Start-IdentityApiSession {
    param(
        [Parameter(Mandatory)][string]$TenantUrl,
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Password
    )

    $baseHeaders = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    $startUri = ($TenantUrl.TrimEnd('/') + '/Security/StartAuthentication')
    $advUri   = ($TenantUrl.TrimEnd('/') + '/Security/AdvanceAuthentication')

    $script:IdentityWebSession = New-Object Microsoft.PowerShell.Commands.WebRequestSession

    Write-Log ("Starting CyberArk Identity authentication for '{0}'..." -f $UserName) 'Cyan'

    $startBody = @{
        User    = $UserName
        Version = '1.0'
    }

    $startJson = ConvertTo-JsonSafe -Object $startBody
    $startResp = Invoke-RestMethod -Method POST -Uri $startUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body $startJson -ErrorAction Stop

    if (-not $startResp.success) {
        throw ('StartAuthentication failed: ' + ($startResp.Message | Out-String))
    }

    $sessionId = $startResp.Result.SessionId
    if ([string]::IsNullOrWhiteSpace($sessionId)) {
        throw 'StartAuthentication did not return SessionId.'
    }

    $mechanism = $null
    foreach ($challenge in @($startResp.Result.Challenges)) {
        foreach ($mech in @($challenge.Mechanisms)) {
            if ($mech.Name -eq 'UP' -or $mech.PromptSelectMech -match 'Password') {
                $mechanism = $mech
                break
            }
        }
        if ($mechanism) { break }
    }

    if (-not $mechanism) {
        throw 'Could not find a username/password mechanism in StartAuthentication response.'
    }

    $advBody = @{
        SessionId   = $sessionId
        MechanismId = $mechanism.MechanismId
        Action      = 'Answer'
        Answer      = $Password
    }

    $advJson = ConvertTo-JsonSafe -Object $advBody
    $advResp = Invoke-RestMethod -Method POST -Uri $advUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body $advJson -ErrorAction Stop

    if (-not $advResp.success) {
        throw ('AdvanceAuthentication failed: ' + ($advResp.Message | Out-String))
    }

    $auth = $advResp.Result.Auth
    if ([string]::IsNullOrWhiteSpace($auth)) {
        throw 'AdvanceAuthentication did not return Auth token.'
    }

    $script:IdentityAuthToken = $auth
    $script:IdentityUser      = $advResp.Result.User

    $cookieCount = 0
    try {
        $cookieCount = $script:IdentityWebSession.Cookies.GetCookies($TenantUrl).Count
    } catch {}

    Write-Log ("Identity API authentication succeeded as '{0}'. CookieCount={1}" -f $script:IdentityUser, $cookieCount) 'Green'
    Add-ReportRow -Step 'Identity API Session' -Status 'SUCCESS' -Detail ("Authenticated as {0}; CookieCount={1}" -f $script:IdentityUser, $cookieCount)
}

function Invoke-IdentityPostRaw {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter()][object]$Body,
        [ValidateSet('BearerCookie','CookieOnly','BearerOnly')][string]$AuthMode = 'BearerCookie'
    )

    $uri = $IdentityTenantURL.TrimEnd('/') + $Path

    $headers = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    if ($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'BearerOnly') {
        if ([string]::IsNullOrWhiteSpace($script:IdentityAuthToken)) {
            throw 'Identity bearer token is not initialized.'
        }
        $headers['Authorization'] = ("Bearer {0}" -f $script:IdentityAuthToken)
    }

    $json = ConvertTo-JsonSafe -Object $Body

    $invokeParams = @{
        Method      = 'POST'
        Uri         = $uri
        Headers     = $headers
        ContentType = 'application/json'
        ErrorAction = 'Stop'
    }

    if ($null -ne $json) {
        $invokeParams['Body'] = $json
    }

    if (($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'CookieOnly') -and $null -ne $script:IdentityWebSession) {
        $invokeParams['WebSession'] = $script:IdentityWebSession
    }

    return Invoke-RestMethod @invokeParams
}

function Invoke-IdentityApiWithRetry {
    param(
        [Parameter(Mandatory)][string[]]$Paths,
        [Parameter()][object]$Body,
        [string]$LogicalName = 'Identity API call'
    )

    $authModes = @('BearerCookie','CookieOnly','BearerOnly')
    $errors = New-Object System.Collections.Generic.List[string]

    foreach ($path in $Paths) {
        foreach ($mode in $authModes) {
            try {
                Write-Log ("Trying {0} via path '{1}' using auth mode '{2}'..." -f $LogicalName, $path, $mode) 'Gray'
                $resp = Invoke-IdentityPostRaw -Path $path -Body $Body -AuthMode $mode
                Write-Log ("Succeeded: {0} via path '{1}' using auth mode '{2}'." -f $LogicalName, $path, $mode) 'Gray'
                return $resp
            } catch {
                $status = Get-HttpStatusCode -Exception $_.Exception
                $msg    = $_.Exception.Message
                $errors.Add(("Path={0}; Mode={1}; Status={2}; Error={3}" -f $path, $mode, $status, $msg)) | Out-Null

                if ($status -eq 401) {
                    Write-Log ("401 on {0} via path '{1}' using auth mode '{2}'. Retrying..." -f $LogicalName, $path, $mode) 'Yellow'
                    continue
                }

                throw
            }
        }
    }

    $detail = ($errors -join ' || ')
    throw ("401 Unauthorized persisted for {0}. This usually means the service user is authenticated but still lacks the required Identity API/query/application rights, or the tenant API security / client allow-list is not configured for this flow. Details: {1}" -f $LogicalName, $detail)
}

function Invoke-RedrockQuery {
    param([Parameter(Mandatory)][string]$Script)

    $body = @{
        Script = $Script
        Args   = @{
            PageNumber = 1
            PageSize   = 100
            Limit      = 10000
            SortBy     = ''
            direction  = 'False'
            Caching    = -1
        }
    }

    return Invoke-IdentityApiWithRetry -Paths @('/Redrock/query','/Redrock/Query') -Body $body -LogicalName 'Redrock query'
}

# --- App helpers ---
function Get-IdentityApplicationByNameOrId {
    param(
        [Parameter(Mandatory)][string]$NameOrId,
        [string]$KnownAppKey = ''
    )

    if (-not [string]::IsNullOrWhiteSpace($KnownAppKey)) {
        Write-Log ("Using provided SourceAppKey override: {0}" -f $KnownAppKey) 'Green'
        return [pscustomobject]@{
            ID   = $KnownAppKey
            Name = $NameOrId
        }
    }

    if ($NameOrId -match '^[0-9a-fA-F-]{20,}$') {
        return [pscustomobject]@{
            ID   = $NameOrId
            Name = $NameOrId
        }
    }

    $escaped = Escape-SqlLiteral -Value $NameOrId
    $query   = "Select ID, Name, Description from Application where Name = '$escaped' ORDER BY Name COLLATE NOCASE"

    $resp = Invoke-RedrockQuery -Script $query
    $rows = @($resp.Result.Results)

    if (-not $rows -or $rows.Count -lt 1) {
        throw ("Application not found by exact name: {0}" -f $NameOrId)
    }

    $row = $rows[0].Row
    return [pscustomobject]@{
        ID          = $row.ID
        Name        = $row.Name
        Description = $row.Description
    }
}

function Get-IdentityApplicationDetails {
    param([Parameter(Mandatory)][string]$AppKey)

    $resp = Invoke-IdentityApiWithRetry -Paths @('/SaasManage/GetApplication') -Body @{ _Rowkey = $AppKey } -LogicalName 'GetApplication'
    if (-not $resp.success) {
        throw ('GetApplication failed: ' + ($resp.Message | Out-String))
    }
    return $resp.Result
}

function Assert-IdentityWebApp {
    param(
        [Parameter(Mandatory)][object]$AppDetails,
        [Parameter(Mandatory)][string]$Label
    )

    $appTypeDisplay = $null
    $appType        = $null
    $webUPAppType   = $null
    $templateName   = $null
    $name           = $null

    if ($AppDetails.PSObject.Properties.Name -contains 'AppTypeDisplayName') { $appTypeDisplay = [string]$AppDetails.AppTypeDisplayName }
    if ($AppDetails.PSObject.Properties.Name -contains 'AppType')            { $appType        = [string]$AppDetails.AppType }
    if ($AppDetails.PSObject.Properties.Name -contains 'WebUPAppType')       { $webUPAppType   = [string]$AppDetails.WebUPAppType }
    if ($AppDetails.PSObject.Properties.Name -contains 'TemplateName')       { $templateName   = [string]$AppDetails.TemplateName }
    if ($AppDetails.PSObject.Properties.Name -contains 'Name')               { $name           = [string]$AppDetails.Name }

    $isWeb = $false
    if ($appTypeDisplay -match '^Web') { $isWeb = $true }
    elseif ($appType -eq 'Web')        { $isWeb = $true }
    elseif (-not [string]::IsNullOrWhiteSpace($webUPAppType)) { $isWeb = $true }

    if (-not $isWeb) {
        throw ("{0} is not a Web App. Name='{1}' AppTypeDisplayName='{2}' AppType='{3}' WebUPAppType='{4}'" -f $Label, $name, $appTypeDisplay, $appType, $webUPAppType)
    }

    Write-Log ("Validated {0} as Web App. Name='{1}' Template='{2}' AppTypeDisplayName='{3}' WebUPAppType='{4}'" -f $Label, $name, $templateName, $appTypeDisplay, $webUPAppType) 'Green'
    Add-ReportRow -Step ("Validate {0}" -f $Label) -Status 'SUCCESS' -Detail ("Web App; Name={0}; Template={1}; AppTypeDisplayName={2}; WebUPAppType={3}" -f $name, $templateName, $appTypeDisplay, $webUPAppType)
}

function Clone-IdentityApplicationAdaptive {
    param([Parameter(Mandatory)][string]$SourceAppKey)

    $candidatePaths = @(
        $CloneEndpointPath,
        '/SaasManage/CloneExistingApplication'
    ) | Select-Object -Unique

    $candidateBodies = @(
        @{ _RowKey = $SourceAppKey },
        @{ _Rowkey = $SourceAppKey },
        @{ appKey  = $SourceAppKey },
        @{ AppKey  = $SourceAppKey },
        @{ ID      = $SourceAppKey }
    )

    foreach ($path in $candidatePaths) {
        foreach ($body in $candidateBodies) {
            try {
                Write-Log ("Trying clone endpoint '{0}' with payload keys [{1}]" -f $path, ($body.Keys -join ',')) 'Gray'
                $resp = Invoke-IdentityApiWithRetry -Paths @($path) -Body $body -LogicalName 'Clone application'

                if ($resp.success) {
                    $newKey = $null

                    if ($resp.Result -is [string]) {
                        $newKey = [string]$resp.Result
                    } elseif ($resp.Result -is [System.Collections.IEnumerable] -and -not ($resp.Result -is [string])) {
                        $first = @($resp.Result)[0]
                        if ($first -and $first.PSObject.Properties.Name -contains '_RowKey') { $newKey = [string]$first._RowKey }
                        elseif ($first -and $first.PSObject.Properties.Name -contains '_Rowkey') { $newKey = [string]$first._Rowkey }
                        elseif ($first -and $first.PSObject.Properties.Name -contains 'ID') { $newKey = [string]$first.ID }
                    } else {
                        if ($resp.Result.PSObject.Properties.Name -contains '_RowKey') { $newKey = [string]$resp.Result._RowKey }
                        elseif ($resp.Result.PSObject.Properties.Name -contains '_Rowkey') { $newKey = [string]$resp.Result._Rowkey }
                        elseif ($resp.Result.PSObject.Properties.Name -contains 'ID') { $newKey = [string]$resp.Result.ID }
                    }

                    if (-not [string]::IsNullOrWhiteSpace($newKey)) {
                        Write-Log ("Clone succeeded on path '{0}'. New app key: {1}" -f $path, $newKey) 'Green'
                        Add-ReportRow -Step 'Clone Application' -Status 'SUCCESS' -Detail ("Path={0}; NewAppKey={1}" -f $path, $newKey)
                        return $newKey
                    }
                }
            } catch {
                Write-Log ("Clone attempt failed on '{0}' with keys [{1}]: {2}" -f $path, ($body.Keys -join ','), $_.Exception.Message) 'Yellow'
            }
        }
    }

    throw 'All clone endpoint/payload attempts failed. Validate the clone operation path/body in your tenant API hub.'
}

function Rename-IdentityApplication {
    param(
        [Parameter(Mandatory)][string]$AppKey,
        [Parameter(Mandatory)][string]$NewName,
        [Parameter()][object]$AppDetails
    )

    $body = @{
        _Rowkey = $AppKey
        Name    = $NewName
    }

    if ($AppDetails -and $AppDetails.PSObject.Properties.Name -contains 'Description' -and $AppDetails.Description) {
        $body['Description'] = $AppDetails.Description
    }
    if ($AppDetails -and $AppDetails.PSObject.Properties.Name -contains 'IconUri' -and $AppDetails.IconUri) {
        $body['IconUri'] = $AppDetails.IconUri
    }

    $resp = Invoke-IdentityApiWithRetry -Paths @('/SaasManage/UpdateApplicationDE') -Body $body -LogicalName 'Rename application'
    if (-not $resp.success) {
        throw ('UpdateApplicationDE rename failed: ' + ($resp.Message | Out-String))
    }

    Write-Log ("Application renamed to '{0}'." -f $NewName) 'Green'
    Add-ReportRow -Step 'Rename Application' -Status 'SUCCESS' -Detail ("Renamed to {0}" -f $NewName)
}

# --- Group lookup helpers ---
function Resolve-IdentityGroupFromDSGroups {
    param([Parameter(Mandatory)][string]$GroupInput)

    $escaped = Escape-SqlLiteral -Value $GroupInput
    $query = @"
SELECT InternalName, SystemName, DisplayName, DirectoryServiceUuid, ServiceInstance, ServiceType
FROM DSGroups
WHERE SystemName = '$escaped'
   OR DisplayName = '$escaped'
   OR InternalName = '$escaped'
ORDER BY DisplayName COLLATE NOCASE
"@

    $resp = Invoke-RedrockQuery -Script $query
    $rows = @($resp.Result.Results)

    if (-not $rows -or $rows.Count -lt 1) {
        throw ("Group not found in DSGroups: {0}" -f $GroupInput)
    }

    $selected = $rows[0].Row

    foreach ($r in $rows) {
        if ($r.Row.SystemName -eq $GroupInput) {
            $selected = $r.Row
            break
        }
    }

    Write-Log ("Resolved target group. DisplayName='{0}' SystemName='{1}' InternalName='{2}' DirectoryServiceUuid='{3}'" -f $selected.DisplayName, $selected.SystemName, $selected.InternalName, $selected.DirectoryServiceUuid) 'Green'
    Add-ReportRow -Step 'Resolve Group' -Status 'SUCCESS' -Detail ("DisplayName={0}; SystemName={1}; InternalName={2}; DirectoryServiceUuid={3}" -f $selected.DisplayName, $selected.SystemName, $selected.InternalName, $selected.DirectoryServiceUuid)

    return [pscustomobject]@{
        DisplayName          = [string]$selected.DisplayName
        SystemName           = [string]$selected.SystemName
        InternalName         = [string]$selected.InternalName
        DirectoryServiceUuid = [string]$selected.DirectoryServiceUuid
        ServiceInstance      = [string]$selected.ServiceInstance
        ServiceType          = [string]$selected.ServiceType
    }
}

# --- Recursive inspection helpers for permission state ---
function Find-FirstPropertyValue {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string[]]$Names,
        [int]$Depth = 0,
        [int]$MaxDepth = 8
    )

    if ($null -eq $Object) { return $null }
    if ($Depth -gt $MaxDepth) { return $null }

    if ($Object -is [string] -or $Object -is [ValueType]) {
        return $null
    }

    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($name in $Names) {
            if ($Object.Contains($name) -and $null -ne $Object[$name]) {
                return $Object[$name]
            }
        }
        foreach ($key in $Object.Keys) {
            $v = Find-FirstPropertyValue -Object $Object[$key] -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($null -ne $v) { return $v }
        }
        return $null
    }

    if ($Object -is [System.Collections.IEnumerable] -and -not ($Object -is [string])) {
        foreach ($item in $Object) {
            $v = Find-FirstPropertyValue -Object $item -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($null -ne $v) { return $v }
        }
        return $null
    }

    foreach ($name in $Names) {
        if ($Object.PSObject.Properties.Name -contains $name) {
            $v = $Object.$name
            if ($null -ne $v -and -not [string]::IsNullOrWhiteSpace([string]$v)) {
                return $v
            }
        }
    }

    foreach ($p in $Object.PSObject.Properties) {
        $v = Find-FirstPropertyValue -Object $p.Value -Names $Names -Depth ($Depth + 1) -MaxDepth $MaxDepth
        if ($null -ne $v) { return $v }
    }

    return $null
}

function Find-GrantArray {
    param(
        [Parameter(Mandatory)]$Object,
        [int]$Depth = 0,
        [int]$MaxDepth = 8
    )

    if ($null -eq $Object) { return $null }
    if ($Depth -gt $MaxDepth) { return $null }

    if ($Object -is [string] -or $Object -is [ValueType]) {
        return $null
    }

    if ($Object -is [System.Collections.IEnumerable] -and -not ($Object -is [string])) {
        $arr = @($Object)
        if ($arr.Count -gt 0) {
            $first = $arr[0]
            if ($first -and $first.PSObject) {
                $props = @($first.PSObject.Properties.Name)
                if (($props -contains 'Principal') -or ($props -contains 'PrincipalId') -or ($props -contains 'Rights') -or (($props -contains 'PType') -and ($props -contains 'Type'))) {
                    return $arr
                }
            }
        }

        foreach ($item in $arr) {
            $found = Find-GrantArray -Object $item -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($found) { return $found }
        }
        return $null
    }

    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($key in $Object.Keys) {
            $found = Find-GrantArray -Object $Object[$key] -Depth ($Depth + 1) -MaxDepth $MaxDepth
            if ($found) { return $found }
        }
        return $null
    }

    foreach ($p in $Object.PSObject.Properties) {
        $found = Find-GrantArray -Object $p.Value -Depth ($Depth + 1) -MaxDepth $MaxDepth
        if ($found) { return $found }
    }

    return $null
}

function Get-AppPermissionState {
    param(
        [Parameter(Mandatory)][string]$AppRowKey,
        [Parameter()][string]$FallbackId
    )

    $details = Get-IdentityApplicationDetails -AppKey $AppRowKey

    $rowKey = $AppRowKey
    $idVal  = $FallbackId
    $pvid   = $null

    $tmpRowKey = Find-FirstPropertyValue -Object $details -Names @('_RowKey','_Rowkey','RowKey')
    if ($tmpRowKey) { $rowKey = [string]$tmpRowKey }

    $tmpId = Find-FirstPropertyValue -Object $details -Names @('ID','AppID')
    if ($tmpId) { $idVal = [string]$tmpId }

    $tmpPvid = Find-FirstPropertyValue -Object $details -Names @('PVID','PVId','PermissionVersionId')
    if ($tmpPvid) { $pvid = [string]$tmpPvid }

    $grants = Find-GrantArray -Object $details

    return [pscustomobject]@{
        Details = $details
        RowKey  = $rowKey
        ID      = $idVal
        PVID    = $pvid
        Grants  = $grants
    }
}

function New-GrantFromResolvedGroup {
    param(
        [Parameter(Mandatory)][object]$GroupObject,
        [Parameter(Mandatory)][string]$Rights
    )

    return [pscustomobject]@{
        Principal            = $(if ($GroupObject.SystemName) { $GroupObject.SystemName } else { $GroupObject.DisplayName })
        PType                = 'Group'
        Rights               = $Rights
        PrincipalId          = $GroupObject.InternalName
        DirectoryServiceUuid = $GroupObject.DirectoryServiceUuid
        SystemName           = $GroupObject.SystemName
        Type                 = 'Group'
    }
}

function Get-MergedGrantSet {
    param(
        [Parameter()][object[]]$ExistingGrants,
        [Parameter(Mandatory)][object]$GroupObject,
        [Parameter(Mandatory)][string]$Rights
    )

    $merged = New-Object System.Collections.Generic.List[object]
    $found  = $false

    foreach ($g in @($ExistingGrants)) {
        $principalId = $null
        $systemName  = $null
        $principal   = $null

        if ($g.PSObject.Properties.Name -contains 'PrincipalId') { $principalId = [string]$g.PrincipalId }
        if ($g.PSObject.Properties.Name -contains 'SystemName')  { $systemName  = [string]$g.SystemName }
        if ($g.PSObject.Properties.Name -contains 'Principal')   { $principal   = [string]$g.Principal }

        $isTarget = $false
        if ($principalId -and $principalId -eq $GroupObject.InternalName) { $isTarget = $true }
        elseif ($systemName -and $systemName -eq $GroupObject.SystemName) { $isTarget = $true }
        elseif ($principal -and $principal -eq $GroupObject.SystemName)   { $isTarget = $true }
        elseif ($principal -and $principal -eq $GroupObject.DisplayName)  { $isTarget = $true }

        if ($isTarget) {
            $merged.Add((New-GrantFromResolvedGroup -GroupObject $GroupObject -Rights $Rights)) | Out-Null
            $found = $true
        } else {
            $merged.Add($g) | Out-Null
        }
    }

    if (-not $found) {
        $merged.Add((New-GrantFromResolvedGroup -GroupObject $GroupObject -Rights $Rights)) | Out-Null
    }

    return @($merged)
}

function Set-ApplicationPermissionsDirectGroup {
    param(
        [Parameter(Mandatory)][string]$AppRowKey,
        [Parameter()][string]$AppId,
        [Parameter(Mandatory)][object]$GroupObject
    )

    $state = Get-AppPermissionState -AppRowKey $AppRowKey -FallbackId $AppId

    $existingGrantCount = 0
    if ($state.Grants) { $existingGrantCount = @($state.Grants).Count }

    Write-Log ("Discovered app permission metadata. RowKey='{0}' ID='{1}' PVID='{2}' ExistingGrantCount='{3}'" -f $state.RowKey, $state.ID, $state.PVID, $existingGrantCount) 'Gray'
    Add-ReportRow -Step 'Inspect App Permissions' -Status 'SUCCESS' -Detail ("RowKey={0}; ID={1}; PVID={2}; ExistingGrantCount={3}" -f $state.RowKey, $state.ID, $state.PVID, $existingGrantCount)

    if ((-not $state.Grants -or @($state.Grants).Count -lt 1) -and (-not $ForcePermissionReplace)) {
        throw 'No existing grant list could be safely discovered from GetApplication output. Aborting to avoid replacing all app permissions. Re-run with -ForcePermissionReplace only if you are comfortable replacing the permission set.'
    }

    $rightsCandidates = @(
        'View,Run,AutoDeploy',
        'View,Run,Automatically Deploy',
        'View,Run,AutomaticallyDeploy'
    )

    foreach ($rights in $rightsCandidates) {
        $grantsToSend = $null

        if ($state.Grants -and @($state.Grants).Count -ge 1) {
            $grantsToSend = Get-MergedGrantSet -ExistingGrants @($state.Grants) -GroupObject $GroupObject -Rights $rights
        } else {
            $grantsToSend = @((New-GrantFromResolvedGroup -GroupObject $GroupObject -Rights $rights))
        }

        $body = @{
            Grants = $grantsToSend
            ID     = $(if ($state.ID) { $state.ID } else { '' })
            RowKey = $(if ($state.RowKey) { $state.RowKey } else { $AppRowKey })
            PVID   = $(if ($state.PVID) { $state.PVID } else { '' })
        }

        try {
            Write-Log ("Trying SetApplicationPermissions with Rights='{0}'..." -f $rights) 'Gray'
            $resp = Invoke-IdentityApiWithRetry -Paths @('/SaasManage/SetApplicationPermissions') -Body $body -LogicalName 'SetApplicationPermissions'
            if ($resp.success) {
                Write-Log ("Direct group permission assignment succeeded for group '{0}' using Rights='{1}'." -f $GroupObject.SystemName, $rights) 'Green'
                Add-ReportRow -Step 'Set Application Permissions' -Status 'SUCCESS' -Detail ("Group={0}; Rights={1}; RowKey={2}" -f $GroupObject.SystemName, $rights, $state.RowKey)
                return
            }
        } catch {
            Write-Log ("SetApplicationPermissions attempt failed with Rights='{0}': {1}" -f $rights, $_.Exception.Message) 'Yellow'
        }
    }

    throw 'All SetApplicationPermissions attempts failed. Review the logged payload metadata and tenant-specific rights format.'
}

# =========================
# MAIN
# =========================
$response      = $null
$sourceApp     = $null
$sourceDetails = $null
$clonedAppKey  = $null
$clonedDetails = $null
$groupObject   = $null

try {
    $response = Start-PASSessionFromCCP -ObjectName $CCPObject

    $resolvedUser = $null
    if ($response.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$response.Username
    } elseif ($response.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$response.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'Unable to resolve service username from CCP response.'
    }

    Start-IdentityApiSession -TenantUrl $IdentityTenantURL -UserName $resolvedUser -Password $response.Content

    if ($UsePrompt) {
        $SourceAppInput  = Read-Host 'Enter the SOURCE Identity application name (exact) or App Key'
        $VaultedUserName = Read-Host 'Enter the vaulted CyberArk username to stamp as the NEW app name'
        $TargetGroup     = Read-Host 'Enter the target GROUP to add directly to the application Permissions page'
        $SafeName        = Read-Host 'Enter the Vault Safe Name (saved to report for later credential binding)'
        $AccountName     = Read-Host 'Enter the Vault Account Name / Identifier (saved to report for later credential binding)'
    } else {
        Write-Log ("Using built-in test values: SourceApp='{0}', NewAppName='{1}', TargetGroup='{2}', SafeName='{3}', AccountName='{4}'" -f $SourceAppInput, $VaultedUserName, $TargetGroup, $SafeName, $AccountName) 'Cyan'
    }

    if ([string]::IsNullOrWhiteSpace($SourceAppInput))  { throw 'Source application cannot be empty.' }
    if ([string]::IsNullOrWhiteSpace($VaultedUserName)) { throw 'Vaulted username cannot be empty.' }
    if ([string]::IsNullOrWhiteSpace($TargetGroup))     { throw 'Target group cannot be empty.' }
    if ([string]::IsNullOrWhiteSpace($SafeName))        { throw 'Safe Name cannot be empty.' }
    if ([string]::IsNullOrWhiteSpace($AccountName))     { throw 'Account Name cannot be empty.' }

    Add-ReportRow -Step 'Input Summary' -Status 'INFO' -Detail ("SourceApp={0}; SourceAppKey={1}; NewAppName={2}; TargetGroup={3}; SafeName={4}; AccountName={5}" -f $SourceAppInput, $SourceAppKey, $VaultedUserName, $TargetGroup, $SafeName, $AccountName)

    $sourceApp     = Get-IdentityApplicationByNameOrId -NameOrId $SourceAppInput -KnownAppKey $SourceAppKey
    $sourceDetails = Get-IdentityApplicationDetails -AppKey $sourceApp.ID
    Assert-IdentityWebApp -AppDetails $sourceDetails -Label 'Source Application'

    if ($WhatIf) {
        Write-Log ("WHATIF: Would clone source app '{0}' ({1})." -f $sourceApp.Name, $sourceApp.ID) 'Yellow'
        Add-ReportRow -Step 'Clone Application' -Status 'WHATIF' -Detail ("Source={0}; AppKey={1}" -f $sourceApp.Name, $sourceApp.ID)
    } else {
        $clonedAppKey  = Clone-IdentityApplicationAdaptive -SourceAppKey $sourceApp.ID
        $clonedDetails = Get-IdentityApplicationDetails -AppKey $clonedAppKey
        Assert-IdentityWebApp -AppDetails $clonedDetails -Label 'Cloned Application (pre-rename)'
    }

    if ($WhatIf) {
        Write-Log ("WHATIF: Would rename cloned app to '{0}'." -f $VaultedUserName) 'Yellow'
        Add-ReportRow -Step 'Rename Application' -Status 'WHATIF' -Detail ("NewName={0}" -f $VaultedUserName)
    } else {
        Rename-IdentityApplication -AppKey $clonedAppKey -NewName $VaultedUserName -AppDetails $clonedDetails
        $clonedDetails = Get-IdentityApplicationDetails -AppKey $clonedAppKey
        Assert-IdentityWebApp -AppDetails $clonedDetails -Label 'Cloned Application (post-rename)'
    }

    $groupObject = Resolve-IdentityGroupFromDSGroups -GroupInput $TargetGroup

    if ($WhatIf) {
        Write-Log ("WHATIF: Would add group '{0}' directly to app permissions with View + Run + Automatically Deploy." -f $groupObject.SystemName) 'Yellow'
        Add-ReportRow -Step 'Set Application Permissions' -Status 'WHATIF' -Detail ("Group={0}; AppRowKey={1}" -f $groupObject.SystemName, $clonedAppKey)
    } else {
        Set-ApplicationPermissionsDirectGroup -AppRowKey $clonedAppKey -AppId $sourceApp.ID -GroupObject $groupObject
    }

    Write-Log ("Completed direct-group permission workflow. Safe '{0}' and Account '{1}' were saved in the report for later credential binding." -f $SafeName, $AccountName) 'Green'
    Add-ReportRow -Step 'Overall' -Status 'SUCCESS' -Detail 'Clone / rename / validate / direct-group-permission workflow completed.'
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Overall' -Status 'FAILED' -Detail $_.Exception.Message
}
finally {
    try {
        $csvDir = Split-Path -Path $ReportCsvPath -Parent
        if ($csvDir -and -not (Test-Path $csvDir)) {
            New-Item -Path $csvDir -ItemType Directory -Force | Out-Null
        }

        if ($script:ReportRows.Count -gt 0) {
            $script:ReportRows | Export-Csv -Path $ReportCsvPath -NoTypeInformation -Force
            Write-Log ("Report exported: {0}" -f $ReportCsvPath) 'Green'
        }
    } catch {
        Write-Log ("Could not export report CSV: {0}" -f $_.Exception.Message) 'Yellow'
    }

    try {
        Close-PASSession | Out-Null
        Write-Log 'PAS session closed.' 'Green'
    } catch {}
}
