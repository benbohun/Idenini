$users = Get-LocalUser |
    Where-Object { $_.Name -like "PSM-*" }

[PSCustomObject]@{
    TotalShadowUsers = $users.Count
    Enabled          = ($users | Where-Object Enabled).Count
    Disabled         = ($users | Where-Object { -not $_.Enabled }).Count
    NeverLoggedOn    = ($users | Where-Object { -not $_.LastLogon }).Count
    OlderThan30Days  = (
        $users |
        Where-Object {
            $_.LastLogon -and
            $_.LastLogon -lt (Get-Date).AddDays(-30)
        }
    ).Count
    OlderThan90Days  = (
        $users |
        Where-Object {
            $_.LastLogon -and
            $_.LastLogon -lt (Get-Date).AddDays(-90)
        }
    ).Count
}
