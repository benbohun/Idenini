<#
Test_SWS_TokenGeneration_Only_V3.ps1

Purpose
- ONLY test CyberArk SWS API service-account token generation.
- Does NOT create Identity apps.
- Does NOT update Identity apps.
- Does NOT modify SWS policies.

Why V3
- Uses Start-Process with redirected STDOUT/STDERR so java -version output is never treated as a fatal PowerShell error.
- Auto-detects helper JAR and SWS service-account JSON from the script folder.
- Tries tenant ID with dashes and without dashes.
- Confirms whether access_token was actually generated before reporting success.

Usage
  .\Test_SWS_TokenGeneration_Only_V3.ps1
  .\Test_SWS_TokenGeneration_Only_V3.ps1 -ShowToken
  .\Test_SWS_TokenGeneration_Only_V3.ps1 -ValidateAgainstSwsApi
  .\Test_SWS_TokenGeneration_Only_V3.ps1 -SwsServiceAccountJsonPath ".\your.json"
#>

[CmdletBinding()]
param(
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',
    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',
    [string]$SwsAuthHelperJarPath = '',
    [string]$SwsServiceAccountJsonPath = '',
    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',
    [string]$LogPath = '',
    [switch]$ShowToken,
    [switch]$SaveTokenToFile,
    [switch]$ValidateAgainstSwsApi
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$script:ScriptRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
if ([string]::IsNullOrWhiteSpace($script:ScriptRoot)) { $script:ScriptRoot = (Get-Location).Path }
if ([string]::IsNullOrWhiteSpace($LogPath)) { $LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only.log' }

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogPath -Value $line -Encoding UTF8 } catch {}
}

function Resolve-FullPath {
    param([Parameter(Mandatory)][string]$PathValue)
    if ([string]::IsNullOrWhiteSpace($PathValue)) { return $null }
    $expanded = [Environment]::ExpandEnvironmentVariables($PathValue)
    if ([System.IO.Path]::IsPathRooted($expanded)) { return $expanded }
    return (Join-Path $script:ScriptRoot $expanded)
}

function Invoke-NativeProcessCaptured {
    param(
        [Parameter(Mandatory)][string]$FilePath,
        [Parameter(Mandatory)][string[]]$Arguments,
        [int]$TimeoutSeconds = 120
    )

    if (-not (Test-Path -LiteralPath $FilePath)) {
        throw "Executable not found: $FilePath"
    }

    $stdoutFile = [System.IO.Path]::GetTempFileName()
    $stderrFile = [System.IO.Path]::GetTempFileName()

    try {
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = $FilePath
        $psi.UseShellExecute = $false
        $psi.RedirectStandardOutput = $true
        $psi.RedirectStandardError = $true
        $psi.CreateNoWindow = $true
        foreach ($arg in $Arguments) { [void]$psi.ArgumentList.Add($arg) }

        $p = New-Object System.Diagnostics.Process
        $p.StartInfo = $psi

        $stdoutBuilder = New-Object System.Text.StringBuilder
        $stderrBuilder = New-Object System.Text.StringBuilder

        $outHandler = [System.Diagnostics.DataReceivedEventHandler]{
            param($sender, $e)
            if ($null -ne $e.Data) { [void]$stdoutBuilder.AppendLine($e.Data) }
        }
        $errHandler = [System.Diagnostics.DataReceivedEventHandler]{
            param($sender, $e)
            if ($null -ne $e.Data) { [void]$stderrBuilder.AppendLine($e.Data) }
        }

        $p.add_OutputDataReceived($outHandler)
        $p.add_ErrorDataReceived($errHandler)

        [void]$p.Start()
        $p.BeginOutputReadLine()
        $p.BeginErrorReadLine()

        $exited = $p.WaitForExit($TimeoutSeconds * 1000)
        if (-not $exited) {
            try { $p.Kill() } catch {}
            throw "Native process timed out after $TimeoutSeconds seconds: $FilePath"
        }
        # Ensure async buffers finish
        $p.WaitForExit()

        return [pscustomobject]@{
            ExitCode = $p.ExitCode
            StdOut   = $stdoutBuilder.ToString()
            StdErr   = $stderrBuilder.ToString()
            Combined = (($stdoutBuilder.ToString(), $stderrBuilder.ToString()) -join [Environment]::NewLine).Trim()
        }
    }
    finally {
        try { Remove-Item -LiteralPath $stdoutFile -Force -ErrorAction SilentlyContinue } catch {}
        try { Remove-Item -LiteralPath $stderrFile -Force -ErrorAction SilentlyContinue } catch {}
    }
}

function Get-MaskedToken {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 20) { return ('*' * $Token.Length) }
    return ($Token.Substring(0,10) + '...' + $Token.Substring($Token.Length - 10))
}

function ConvertFrom-Base64UrlString {
    param([Parameter(Mandatory)][string]$Value)
    $s = $Value.Replace('-', '+').Replace('_', '/')
    switch ($s.Length % 4) {
        2 { $s += '==' }
        3 { $s += '=' }
        1 { throw 'Invalid base64url length.' }
    }
    return [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s))
}

function Show-JwtSummary {
    param([Parameter(Mandatory)][string]$Token)
    $parts = $Token.Split('.')
    if ($parts.Count -lt 2) {
        Write-Log 'Token does not look like JWT format; skipping JWT decode summary.' 'Yellow'
        return
    }
    try {
        $headerJson = ConvertFrom-Base64UrlString -Value $parts[0]
        $payloadJson = ConvertFrom-Base64UrlString -Value $parts[1]
        $header = $headerJson | ConvertFrom-Json
        $payload = $payloadJson | ConvertFrom-Json

        Write-Log ('JWT header alg={0}; typ={1}; kid={2}' -f $header.alg, $header.typ, $header.kid) 'Cyan'
        $sub = $null; $iss = $null; $aud = $null; $exp = $null
        try { $sub = $payload.sub } catch {}
        try { $iss = $payload.iss } catch {}
        try { $aud = ($payload.aud -join ',') } catch { try { $aud = [string]$payload.aud } catch {} }
        try {
            if ($payload.exp) {
                $epoch = [DateTimeOffset]::FromUnixTimeSeconds([int64]$payload.exp).LocalDateTime
                $exp = $epoch.ToString('yyyy-MM-dd HH:mm:ss')
            }
        } catch {}
        Write-Log ('JWT payload summary: iss={0}; sub={1}; aud={2}; expLocal={3}' -f $iss, $sub, $aud, $exp) 'Cyan'
    } catch {
        Write-Log ('Could not decode JWT summary: {0}' -f $_.Exception.Message) 'Yellow'
    }
}

function Find-JavaExe {
    $candidates = New-Object System.Collections.Generic.List[string]
    $explicit = Resolve-FullPath -PathValue $SwsJavaPath
    if (-not [string]::IsNullOrWhiteSpace($explicit)) { [void]$candidates.Add($explicit) }

    foreach ($rel in @('java.exe','java\bin\java.exe','jre\bin\java.exe','jdk\bin\java.exe')) {
        [void]$candidates.Add((Join-Path $script:ScriptRoot $rel))
    }

    try {
        $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
        if ($cmd -and $cmd.Source) { [void]$candidates.Add($cmd.Source) }
    } catch {}

    $unique = $candidates | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique
    foreach ($candidate in $unique) {
        if (Test-Path -LiteralPath $candidate) { return $candidate }
    }
    throw 'java.exe was not found. Pass -SwsJavaPath or place a portable JDK beside the script.'
}

function Find-HelperJar {
    if (-not [string]::IsNullOrWhiteSpace($SwsAuthHelperJarPath)) {
        $p = Resolve-FullPath -PathValue $SwsAuthHelperJarPath
        if (-not (Test-Path -LiteralPath $p)) { throw "SWS helper JAR not found: $p" }
        return $p
    }

    $jars = @(Get-ChildItem -Path $script:ScriptRoot -File -Filter 'public-api-auth-helper*.jar' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) { throw "No public-api-auth-helper*.jar found in $script:ScriptRoot" }
    if ($jars.Count -gt 1) {
        Write-Log 'Multiple helper JAR files found; using newest:' 'Yellow'
        foreach ($j in $jars) { Write-Log ('  {0} LastWrite={1}' -f $j.Name, $j.LastWriteTime) 'Yellow' }
    }
    return $jars[0].FullName
}

function Test-SwsJsonFile {
    param([Parameter(Mandatory)][string]$Path)
    try {
        $json = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
        $hasPrivateKey = $false
        $hasServiceId = $false
        foreach ($name in @('privateKey','private_key','key','secret')) {
            if ($json.PSObject.Properties.Name -contains $name -and -not [string]::IsNullOrWhiteSpace([string]$json.$name)) { $hasPrivateKey = $true }
        }
        foreach ($name in @('serviceAccountId','service_account_id','clientId','client_id','id')) {
            if ($json.PSObject.Properties.Name -contains $name -and -not [string]::IsNullOrWhiteSpace([string]$json.$name)) { $hasServiceId = $true }
        }
        return ($hasPrivateKey -and $hasServiceId)
    } catch { return $false }
}

function Find-SwsJson {
    if (-not [string]::IsNullOrWhiteSpace($SwsServiceAccountJsonPath)) {
        $p = Resolve-FullPath -PathValue $SwsServiceAccountJsonPath
        if (-not (Test-Path -LiteralPath $p)) { throw "SWS service-account JSON not found: $p" }
        if (-not (Test-SwsJsonFile -Path $p)) { throw "The specified JSON does not look like a SWS private-key service-account JSON: $p" }
        return $p
    }

    $jsonFiles = @(Get-ChildItem -Path $script:ScriptRoot -File -Filter '*.json' -ErrorAction SilentlyContinue | Where-Object { Test-SwsJsonFile -Path $_.FullName } | Sort-Object LastWriteTime -Descending)
    if ($jsonFiles.Count -eq 0) { throw "No valid-looking SWS service-account JSON found in $script:ScriptRoot" }

    if ($jsonFiles.Count -gt 1) {
        Write-Log 'Multiple valid-looking SWS service-account JSON files found.' 'Yellow'
        for ($i = 0; $i -lt $jsonFiles.Count; $i++) {
            Write-Log ('  [{0}] {1} LastWrite={2}' -f ($i+1), $jsonFiles[$i].Name, $jsonFiles[$i].LastWriteTime) 'Yellow'
        }
        $choice = Read-Host ('Select JSON number to use [1-{0}] or press Enter for newest [1]' -f $jsonFiles.Count)
        if ([string]::IsNullOrWhiteSpace($choice)) { return $jsonFiles[0].FullName }
        $index = 0
        if (-not [int]::TryParse($choice, [ref]$index) -or $index -lt 1 -or $index -gt $jsonFiles.Count) {
            throw "Invalid JSON selection: $choice"
        }
        return $jsonFiles[$index-1].FullName
    }
    return $jsonFiles[0].FullName
}

function Get-TenantCandidates {
    param([Parameter(Mandatory)][string]$TenantId)
    $items = New-Object System.Collections.Generic.List[string]
    if (-not [string]::IsNullOrWhiteSpace($TenantId)) { [void]$items.Add($TenantId.Trim()) }
    $dashless = ($TenantId -replace '-', '').Trim()
    if (-not [string]::IsNullOrWhiteSpace($dashless)) { [void]$items.Add($dashless) }
    return @($items | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique)
}

function Get-AccessTokenFromHelperOutput {
    param([Parameter(Mandatory)][string]$Output)

    # Try JSON first.
    try {
        $trim = $Output.Trim()
        if ($trim.StartsWith('{') -or $trim.StartsWith('[')) {
            $json = $trim | ConvertFrom-Json -ErrorAction Stop
            if ($json.access_token) { return [string]$json.access_token }
            if ($json.accessToken) { return [string]$json.accessToken }
            if ($json.Result -and $json.Result.access_token) { return [string]$json.Result.access_token }
        }
    } catch {}

    # Common output shapes: access_token: xxx, access_token=xxx, "access_token":"xxx"
    $patterns = @(
        '"access_token"\s*:\s*"(?<tok>[^"\r\n]+)"',
        'access_token\s*[:=]\s*(?<tok>eyJ[^\s,;]+)',
        'Access token\s*[:=]\s*(?<tok>eyJ[^\s,;]+)',
        '(?<tok>eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-\.]+)'
    )
    foreach ($pat in $patterns) {
        $m = [regex]::Match($Output, $pat, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
        if ($m.Success -and $m.Groups['tok'].Value) { return $m.Groups['tok'].Value.Trim() }
    }
    return $null
}

function Invoke-HelperTokenGeneration {
    param(
        [Parameter(Mandatory)][string]$JavaExe,
        [Parameter(Mandatory)][string]$HelperJar,
        [Parameter(Mandatory)][string]$JsonPath,
        [Parameter(Mandatory)][string[]]$TenantCandidates
    )

    $lastErrors = New-Object System.Collections.Generic.List[string]

    foreach ($tenant in $TenantCandidates) {
        Write-Log ('Running CyberArk helper: tenant={0}; jar={1}; json={2}' -f $tenant, (Split-Path -Leaf $HelperJar), (Split-Path -Leaf $JsonPath)) 'Cyan'
        $args = @('-jar', $HelperJar, '-t', $tenant, '-p', $JsonPath)
        $result = Invoke-NativeProcessCaptured -FilePath $JavaExe -Arguments $args -TimeoutSeconds 120
        $combined = $result.Combined
        $token = Get-AccessTokenFromHelperOutput -Output $combined

        $rawOutPath = Join-Path $script:ScriptRoot ('SWS_Helper_RawOutput_{0}.txt' -f ((Get-Date).ToString('yyyyMMdd_HHmmss')))
        try { Set-Content -Path $rawOutPath -Value $combined -Encoding UTF8 -Force } catch {}

        if (-not [string]::IsNullOrWhiteSpace($token)) {
            Write-Log ('SUCCESS: Helper returned an access_token. ExitCode={0}; Masked={1}; RawOutputFile={2}' -f $result.ExitCode, (Get-MaskedToken $token), $rawOutPath) 'Green'
            return [pscustomobject]@{ Token = $token; TenantUsed = $tenant; RawOutputFile = $rawOutPath; ExitCode = $result.ExitCode }
        }

        $summary = $combined
        if ($summary.Length -gt 2000) { $summary = $summary.Substring(0,2000) + '...[truncated]' }
        Write-Log ('FAILED: Helper did not return access_token. ExitCode={0}; RawOutputFile={1}; Output={2}' -f $result.ExitCode, $rawOutPath, $summary) 'Red'
        [void]$lastErrors.Add(('Tenant={0}; ExitCode={1}; RawOutputFile={2}' -f $tenant, $result.ExitCode, $rawOutPath))
    }

    throw ('CyberArk helper did not return access_token for any tenant candidate. Attempts: {0}' -f ($lastErrors -join ' || '))
}

function Test-TokenAgainstSwsApi {
    param([Parameter(Mandatory)][string]$Token)
    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    Write-Log "Validating token with SWS API GET: $uri" 'Cyan'
    $headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }
    try {
        $resp = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -ErrorAction Stop
        Write-Log 'SUCCESS: Token was accepted by SWS API.' 'Green'
        return $true
    } catch {
        $status = $null
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log ('FAILED: Token generation may have succeeded, but SWS API validation failed. Status={0}; Error={1}' -f $status, $_.Exception.Message) 'Red'
        return $false
    }
}

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V3 Started =====' 'Cyan'
    Write-Log "ScriptRoot=$script:ScriptRoot" 'Gray'
    Write-Log "LogPath=$LogPath" 'Gray'

    $java = Find-JavaExe
    Write-Log "Testing Java executable: $java" 'Cyan'
    $javaVersion = Invoke-NativeProcessCaptured -FilePath $java -Arguments @('-version') -TimeoutSeconds 30
    $javaText = $javaVersion.Combined.Trim()
    $javaOneLine = ($javaText -split "`r?`n" | Select-Object -First 1)
    Write-Log ('Java OK. ExitCode={0}; Version={1}' -f $javaVersion.ExitCode, $javaOneLine) 'Green'
    if ($javaVersion.ExitCode -ne 0) { throw "java -version returned exit code $($javaVersion.ExitCode). Output=$javaText" }

    $jar = Find-HelperJar
    Write-Log "HelperJar=$jar" 'Cyan'

    $jsonPath = Find-SwsJson
    Write-Log "SwsServiceAccountJson=$jsonPath" 'Cyan'

    try {
        $json = Get-Content -LiteralPath $jsonPath -Raw | ConvertFrom-Json
        foreach ($field in @('serviceAccountId','clientId','id')) {
            if ($json.PSObject.Properties.Name -contains $field -and -not [string]::IsNullOrWhiteSpace([string]$json.$field)) {
                Write-Log ('JSON {0}={1}' -f $field, [string]$json.$field) 'Gray'
            }
        }
        foreach ($field in @('discoveryURI','discoveryUrl','issuer','tokenEndpoint')) {
            if ($json.PSObject.Properties.Name -contains $field -and -not [string]::IsNullOrWhiteSpace([string]$json.$field)) {
                Write-Log ('JSON {0}={1}' -f $field, [string]$json.$field) 'Gray'
            }
        }
    } catch { Write-Log ('Could not print JSON metadata: {0}' -f $_.Exception.Message) 'Yellow' }

    $tenantCandidates = Get-TenantCandidates -TenantId $SwsTenantId
    Write-Log ('TenantCandidates={0}' -f ($tenantCandidates -join ', ')) 'Cyan'

    $tokenResult = Invoke-HelperTokenGeneration -JavaExe $java -HelperJar $jar -JsonPath $jsonPath -TenantCandidates $tenantCandidates
    $token = $tokenResult.Token

    Write-Log ('TOKEN GENERATION SUCCESS. TenantUsed={0}; TokenLength={1}; Masked={2}' -f $tokenResult.TenantUsed, $token.Length, (Get-MaskedToken $token)) 'Green'
    Show-JwtSummary -Token $token

    if ($ValidateAgainstSwsApi) {
        [void](Test-TokenAgainstSwsApi -Token $token)
    }

    if ($SaveTokenToFile) {
        $tokenPath = Join-Path $script:ScriptRoot 'SWS_access_token.txt'
        Set-Content -Path $tokenPath -Value $token -Encoding ASCII -Force
        Write-Log "Token saved to: $tokenPath" 'Yellow'
    }

    if ($ShowToken) {
        Write-Host ''
        Write-Host '================ RAW ACCESS TOKEN ================' -ForegroundColor Yellow
        Write-Host $token
        Write-Host '==================================================' -ForegroundColor Yellow
        Write-Host ''
    }

    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V3 Finished: SUCCESS =====' 'Green'
}
catch {
    Write-Log ('FATAL ERROR: {0}' -f $_.Exception.Message) 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic V3 Finished: FAILED =====' 'Red'
    exit 1
}
