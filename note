<#
.SYNOPSIS
    CNA CyberArk Safe Member + Account Compliance Report

.DESCRIPTION
    - Authenticates to CNA Privilege Cloud using CCP + psPAS Identity Header
    - Retrieves all safes visible to the service account
    - Retrieves safe members for each safe
    - Retrieves vaulted accounts for each safe
    - Joins safe membership data with account inventory data
    - Exports the requested report columns:

        Safe
        Member
        MemberType
        Target Username
        Address
        Account Safe
        Platform Identity
        Compliance Status
        Expiration Due (Days)
        Last Modified Date

.NOTES
    This script is report-only.
    It does not add, modify, delete, reconcile, verify, or rotate accounts.

    "Expiration Due (Days)" is calculated using this logic:
      1. If an account expiration field exists, calculate days from that date.
      2. If no expiration field exists and DefaultExpirationDays > 0,
         calculate LastModifiedDate + DefaultExpirationDays.
      3. If neither is available, value is blank.

.REQUIREMENTS
    - psPAS module
    - Get-IdentityHeader command available
    - CCP access to service account credential
    - Service account must have:
        View Safe Members on target safes
        List Accounts on target safes
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings CNA =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Optional report filtering =====
    # Leave blank to process all safes visible to the service account.
    [string]$SafeNameFilter    = '',

    # If CyberArk does not expose an account expiration date, this fallback can be used.
    # Example: 60 means ExpirationDueDays = LastModifiedDate + 60 days.
    # Use 0 to disable fallback calculation.
    [int]$DefaultExpirationDays = 0,

    # Include rows for safes that have members but no vaulted accounts.
    [bool]$IncludeSafesWithNoAccounts = $true,

    # ===== Output paths =====
    [string]$OutputFolder      = 'E:\Installation Media\Script\OnboardScript\data',
    [string]$CsvName           = 'SafeMember_Account_Compliance_Report.csv',
    [string]$LogFileName       = 'SafeMember_Account_Compliance_Report.log'
)

# ============================================
# Runtime Settings
# ============================================

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# ============================================
# Paths
# ============================================

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
}

$CsvFilePath = Join-Path $OutputFolder $CsvName
$LogFile     = Join-Path $OutputFolder $LogFileName

New-Item -ItemType File -Force -Path $LogFile | Out-Null

# ============================================
# Logger
# ============================================

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# ============================================
# Helper: Normalize Identity Tenant URL
# ============================================

function Get-NormalizedIdentityTenant {
    param(
        [Parameter(Mandatory)]
        [string]$TenantUrl
    )

    $normalized = $TenantUrl.Trim()

    if ($normalized -notmatch '^https?://') {
        $normalized = "https://$normalized"
    }

    return $normalized.TrimEnd('/')
}

# ============================================
# Helper: Get property value from object
# ============================================

function Get-ObjectPropertyValue {
    param(
        [Parameter(Mandatory)]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($propName in $PropertyNames) {
        if ($InputObject.PSObject.Properties.Name -contains $propName) {
            return $InputObject.$propName
        }
    }

    return $null
}

# ============================================
# Helper: Get nested property value
# ============================================

function Get-NestedPropertyValue {
    param(
        [Parameter(Mandatory)]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [string[]]$ParentPropertyNames,

        [Parameter(Mandatory)]
        [string[]]$ChildPropertyNames
    )

    foreach ($parentName in $ParentPropertyNames) {
        $parent = Get-ObjectPropertyValue -InputObject $InputObject -PropertyNames @($parentName)

        if ($null -ne $parent) {
            foreach ($childName in $ChildPropertyNames) {
                if ($parent.PSObject.Properties.Name -contains $childName) {
                    return $parent.$childName
                }

                if ($parent -is [hashtable] -and $parent.ContainsKey($childName)) {
                    return $parent[$childName]
                }
            }
        }
    }

    return $null
}

# ============================================
# Helper: Convert CyberArk date values
# Supports:
#   - ISO date string
#   - PowerShell DateTime
#   - Unix epoch seconds
#   - Unix epoch milliseconds
# ============================================

function Convert-CyberArkDate {
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($null -eq $Value) {
        return $null
    }

    if ($Value -is [datetime]) {
        return $Value
    }

    $stringValue = [string]$Value

    if ([string]::IsNullOrWhiteSpace($stringValue)) {
        return $null
    }

    # Unix epoch handling
    if ($stringValue -match '^\d+$') {
        try {
            $number = [int64]$stringValue

            # Milliseconds epoch
            if ($number -gt 9999999999) {
                return [DateTimeOffset]::FromUnixTimeMilliseconds($number).LocalDateTime
            }

            # Seconds epoch
            return [DateTimeOffset]::FromUnixTimeSeconds($number).LocalDateTime
        } catch {
            return $null
        }
    }

    try {
        return ([datetime]::Parse($stringValue)).ToLocalTime()
    } catch {
        return $null
    }
}

# ============================================
# Helper: Get Account Last Modified Date
# ============================================

function Get-AccountLastModifiedDate {
    param(
        [Parameter(Mandatory)]
        [object]$Account
    )

    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime'
        )

    if ($null -eq $value) {
        $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
            'lastModifiedDateTime',
            'LastModifiedDateTime',
            'lastModifiedTime',
            'LastModifiedTime',
            'categoryModificationTime',
            'CategoryModificationTime',
            'LastModificationTime'
        )
    }

    return Convert-CyberArkDate -Value $value
}

# ============================================
# Helper: Get Account Expiration Date
# ============================================

function Get-AccountExpirationDate {
    param(
        [Parameter(Mandatory)]
        [object]$Account
    )

    # Top-level fields
    $value = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
        'expirationDate',
        'ExpirationDate',
        'expiryDate',
        'ExpiryDate',
        'accountExpirationDate',
        'AccountExpirationDate',
        'passwordExpirationDate',
        'PasswordExpirationDate',
        'passwordExpiryDate',
        'PasswordExpiryDate'
    )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    # Platform account properties
    $value = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @(
            'platformAccountProperties',
            'PlatformAccountProperties',
            'InternalProperties',
            'internalProperties',
            'Properties',
            'properties'
        ) `
        -ChildPropertyNames @(
            'AccountExpirationDate',
            'accountExpirationDate',
            'ExpirationDate',
            'expirationDate',
            'ExpiryDate',
            'expiryDate',
            'PasswordExpirationDate',
            'passwordExpirationDate',
            'PasswordExpiryDate',
            'passwordExpiryDate'
        )

    if ($null -ne $value) {
        return Convert-CyberArkDate -Value $value
    }

    return $null
}

# ============================================
# Helper: Get Compliance Status
# ============================================

function Get-AccountComplianceStatus {
    param(
        [Parameter(Mandatory)]
        [object]$Account
    )

    $status = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('status', 'Status')

    $automaticManagementEnabled = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('automaticManagementEnabled', 'AutomaticManagementEnabled')

    $manualReason = Get-NestedPropertyValue `
        -InputObject $Account `
        -ParentPropertyNames @('secretManagement', 'SecretManagement') `
        -ChildPropertyNames @('manualManagementReason', 'ManualManagementReason')

    if (-not [string]::IsNullOrWhiteSpace([string]$status)) {
        return [string]$status
    }

    if ($null -ne $automaticManagementEnabled) {
        if ([string]$automaticManagementEnabled -eq 'False') {
            if (-not [string]::IsNullOrWhiteSpace([string]$manualReason)) {
                return "ManualManagementDisabled - $manualReason"
            }

            return 'ManualManagementDisabled'
        }
    }

    return ''
}

# ============================================
# Helper: Calculate Expiration Due Days
# ============================================

function Get-ExpirationDueDays {
    param(
        [AllowNull()]
        [datetime]$ExpirationDate,

        [AllowNull()]
        [datetime]$LastModifiedDate,

        [int]$FallbackExpirationDays
    )

    $effectiveExpirationDate = $null

    if ($null -ne $ExpirationDate) {
        $effectiveExpirationDate = $ExpirationDate
    } elseif ($FallbackExpirationDays -gt 0 -and $null -ne $LastModifiedDate) {
        $effectiveExpirationDate = $LastModifiedDate.AddDays($FallbackExpirationDays)
    }

    if ($null -eq $effectiveExpirationDate) {
        return ''
    }

    return [math]::Floor(($effectiveExpirationDate - (Get-Date)).TotalDays)
}

# ============================================
# Import Required Modules
# ============================================

try {
    Import-Module psPAS -Force -ErrorAction Stop
    $psPASModule = Get-Module psPAS

    if ($psPASModule) {
        Write-Log ("psPAS module loaded. Version: {0}" -f $psPASModule.Version) 'Green'
    } else {
        Write-Log "psPAS module loaded." 'Green'
    }
} catch {
    Write-Log ("ERROR: Failed to import psPAS module. {0}" -f $_.Exception.Message) 'Red'
    throw
}

if (-not (Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue)) {
    Write-Log "ERROR: Get-IdentityHeader cmdlet was not found. Confirm IdentityCommand module is installed and available." 'Red'
    throw "Get-IdentityHeader cmdlet not found."
}

# ============================================
# Login Method: CCP + psPAS Identity Header
# ============================================

function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)]
        [string]$ObjectName
    )

    $headers = @{
        'Content-Type' = 'application/json'
    }

    $ccpUrl = "$CCPAddress/$CCPLocation/api/Accounts?AppID=$CCPAppID&Safe=$CCPSafe&Object=$ObjectName"

    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName) 'Cyan'
    Write-Log ("CCP URL: {0}" -f $ccpUrl) 'Gray'

    try {
        $resp = Invoke-RestMethod `
            -Uri $ccpUrl `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        if (-not $resp -or -not $resp.Content) {
            throw 'Empty CCP response or missing Content field.'
        }
    } catch {
        Write-Log ("ERROR: CCP credential fetch failed. {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null

    if ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    } elseif ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        throw 'CCP returned password but no Username/UserName field.'
    }

    Write-Log ("Successfully retrieved CCP credential for user: {0}" -f $resolvedUser) 'Green'

    try {
        $normalizedTenant = Get-NormalizedIdentityTenant -TenantUrl $IdentityTenantURL

        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [PSCredential]::new($resolvedUser, $securePass)

        Write-Log ("Requesting CyberArk PAS authentication using psPAS Identity header as {0}..." -f $resolvedUser) 'Cyan'
        Write-Log ("IdentityTenantURL passed to Get-IdentityHeader: {0}" -f $normalizedTenant) 'Gray'
        Write-Log ("Privilege Cloud Subdomain: {0}" -f $PCloudSubdomain) 'Gray'

        $header = Get-IdentityHeader `
            -IdentityTenantURL $normalizedTenant `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $header | Out-Null

        if (-not (Get-PASSession)) {
            throw 'psPAS session not established.'
        }

        Write-Log ("Authentication successful. PAS session established as {0}." -f $resolvedUser) 'Green'
    } catch {
        Write-Log ("ERROR: Failed to authenticate via psPAS Identity header. {0}" -f $_.Exception.Message) 'Red'
        throw
    } finally {
        try {
            if ($resp.PSObject.Properties.Name -contains 'Content') {
                $resp.Content = $null
            }
        } catch {}

        try {
            if ($securePass) {
                $securePass.Dispose()
            }
        } catch {}
    }

    return $resolvedUser
}

# ============================================
# Start Script
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "CNA Safe Member + Account Compliance Report started." 'Cyan'
Write-Log ("Identity Tenant URL       : {0}" -f $IdentityTenantURL) 'Gray'
Write-Log ("Privilege Cloud URL       : {0}" -f $PrivilegeCloudURL) 'Gray'
Write-Log ("PCloud Subdomain          : {0}" -f $PCloudSubdomain) 'Gray'
Write-Log ("CCP Address               : {0}" -f $CCPAddress) 'Gray'
Write-Log ("CCP AppID                 : {0}" -f $CCPAppID) 'Gray'
Write-Log ("CCP Safe                  : {0}" -f $CCPSafe) 'Gray'
Write-Log ("CCP Object                : {0}" -f $CCPObject) 'Gray'
Write-Log ("SafeNameFilter            : {0}" -f $SafeNameFilter) 'Gray'
Write-Log ("DefaultExpirationDays     : {0}" -f $DefaultExpirationDays) 'Gray'
Write-Log ("IncludeSafesWithNoAccounts: {0}" -f $IncludeSafesWithNoAccounts) 'Gray'
Write-Log ("CSV Report                : {0}" -f $CsvFilePath) 'Gray'
Write-Log "============================================================" 'Gray'

# ============================================
# Authenticate
# ============================================

try {
    $AuthenticatedUser = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    Write-Log ("FATAL: Authentication failed. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Retrieve Safes
# ============================================

Write-Log "Retrieving safes..." 'Yellow'

try {
    $Safes = Get-PASSafe -ErrorAction Stop

    if ($null -eq $Safes) {
        $Safes = @()
    } else {
        $Safes = @($Safes)
    }

    if (-not [string]::IsNullOrWhiteSpace($SafeNameFilter)) {
        $Safes = $Safes | Where-Object {
            $resolvedSafeName = Get-ObjectPropertyValue -InputObject $_ -PropertyNames @(
                'safeName',
                'SafeName',
                'Safe',
                'Name'
            )

            $resolvedSafeName -like $SafeNameFilter
        }
    }

    Write-Log ("Retrieved {0} safe(s) to process." -f $Safes.Count) 'Green'
} catch {
    Write-Log ("ERROR: Failed to retrieve safes. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Build Report
# ============================================

$ReportRows = New-Object System.Collections.Generic.List[object]

$totalSafes = $Safes.Count
$current    = 0

$successfulSafes = 0
$failedSafes     = 0
$totalRows       = 0

foreach ($Safe in $Safes) {
    $current++

    $SafeName = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @(
        'safeName',
        'SafeName',
        'Safe',
        'Name'
    )

    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        Write-Log ("[{0}/{1}] WARNING: Could not resolve safe name. Skipping." -f $current, $totalSafes) 'Yellow'
        continue
    }

    Write-Log ("[{0}/{1}] Processing safe: {2}" -f $current, $totalSafes, $SafeName) 'Cyan'

    try {
        # -----------------------------
        # Retrieve Safe Members
        # -----------------------------
        try {
            $SafeMembers = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop

            if ($null -eq $SafeMembers) {
                $SafeMembers = @()
            } else {
                $SafeMembers = @($SafeMembers)
            }

            Write-Log ("Safe '{0}' member count: {1}" -f $SafeName, $SafeMembers.Count) 'Gray'
        } catch {
            Write-Log ("WARNING: Could not retrieve members for safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Yellow'
            $SafeMembers = @()
        }

        # -----------------------------
        # Retrieve Accounts in Safe
        # -----------------------------
        try {
            $Accounts = Get-PASAccount -SafeName $SafeName -ErrorAction Stop

            if ($null -eq $Accounts) {
                $Accounts = @()
            } else {
                $Accounts = @($Accounts)
            }

            Write-Log ("Safe '{0}' account count: {1}" -f $SafeName, $Accounts.Count) 'Gray'
        } catch {
            Write-Log ("WARNING: Could not retrieve accounts for safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Yellow'
            $Accounts = @()
        }

        # -----------------------------
        # Normalize blank member/account conditions
        # -----------------------------
        if ($SafeMembers.Count -eq 0) {
            $SafeMembers = @(
                [PSCustomObject]@{
                    MemberName = ''
                    MemberType = ''
                }
            )
        }

        if ($Accounts.Count -eq 0 -and $IncludeSafesWithNoAccounts) {
            $Accounts = @(
                [PSCustomObject]@{
                    Safe       = $SafeName
                    safeName   = $SafeName
                    userName   = ''
                    address    = ''
                    platformId = ''
                }
            )
        }

        if ($Accounts.Count -eq 0 -and -not $IncludeSafesWithNoAccounts) {
            Write-Log ("Safe '{0}' has no accounts. Skipping account join rows." -f $SafeName) 'Yellow'
            $successfulSafes++
            continue
        }

        # -----------------------------
        # Join Safe Members to Accounts
        # -----------------------------
        foreach ($Member in $SafeMembers) {
            $memberName = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'MemberName',
                'memberName',
                'UserName',
                'username',
                'Name',
                'name'
            )

            $memberType = Get-ObjectPropertyValue -InputObject $Member -PropertyNames @(
                'MemberType',
                'memberType',
                'Type',
                'type'
            )

            foreach ($Account in $Accounts) {
                $targetUsername = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'userName',
                    'UserName',
                    'username',
                    'Username'
                )

                $address = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'address',
                    'Address'
                )

                $accountSafe = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'safeName',
                    'SafeName',
                    'Safe',
                    'safe'
                )

                if ([string]::IsNullOrWhiteSpace($accountSafe)) {
                    $accountSafe = $SafeName
                }

                $platformIdentity = Get-ObjectPropertyValue -InputObject $Account -PropertyNames @(
                    'platformId',
                    'PlatformID',
                    'PlatformId',
                    'platformID'
                )

                $complianceStatus = Get-AccountComplianceStatus -Account $Account
                $lastModifiedDate = Get-AccountLastModifiedDate -Account $Account
                $expirationDate   = Get-AccountExpirationDate -Account $Account

                $expirationDueDays = Get-ExpirationDueDays `
                    -ExpirationDate $expirationDate `
                    -LastModifiedDate $lastModifiedDate `
                    -FallbackExpirationDays $DefaultExpirationDays

                $lastModifiedOutput = ''
                if ($null -ne $lastModifiedDate) {
                    $lastModifiedOutput = $lastModifiedDate.ToString('yyyy-MM-dd HH:mm:ss')
                }

                $ReportRows.Add([PSCustomObject]@{
                    'Safe'                  = $SafeName
                    'Member'                = $memberName
                    'MemberType'            = $memberType
                    'Target Username'       = $targetUsername
                    'Address'               = $address
                    'Account Safe'          = $accountSafe
                    'Platform Identity'     = $platformIdentity
                    'Compliance Status'     = $complianceStatus
                    'Expiration Due (Days)' = $expirationDueDays
                    'Last Modified Date'    = $lastModifiedOutput
                })

                $totalRows++
            }
        }

        $successfulSafes++
        Write-Log ("Completed safe '{0}'." -f $SafeName) 'Green'
    } catch {
        $failedSafes++
        Write-Log ("ERROR: Failed while processing safe '{0}'. {1}" -f $SafeName, $_.Exception.Message) 'Red'
    }
}

# ============================================
# Export Report
# ============================================

try {
    Write-Log "Exporting report to CSV..." 'Yellow'

    $ReportRows |
        Sort-Object 'Safe', 'Member', 'Target Username', 'Address' |
        Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8

    Write-Log ("Report exported successfully: {0}" -f $CsvFilePath) 'Green'
} catch {
    Write-Log ("ERROR: Failed to export CSV. {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# ============================================
# Close PAS Session
# ============================================

try {
    Close-PASSession | Out-Null
    Write-Log "PAS session closed." 'Gray'
} catch {
    Write-Log ("WARNING: Could not close PAS session cleanly. {0}" -f $_.Exception.Message) 'Yellow'
}

# ============================================
# Completion
# ============================================

Write-Log "============================================================" 'Gray'
Write-Log "Safe Member + Account Compliance Report completed." 'Green'
Write-Log ("Authenticated User : {0}" -f $AuthenticatedUser) 'Gray'
Write-Log ("Safes Processed    : {0}" -f $totalSafes) 'Gray'
Write-Log ("Successful Safes   : {0}" -f $successfulSafes) 'Green'
Write-Log ("Failed Safes       : {0}" -f $failedSafes) 'Red'
Write-Log ("Rows Exported      : {0}" -f $totalRows) 'Gray'
Write-Log ("Report Path        : {0}" -f $CsvFilePath) 'Gray'
Write-Log ("Log Path           : {0}" -f $LogFile) 'Gray'
Write-Log "============================================================" 'Gray'
