# --- Allow this process to load unsigned modules & unblock psPAS files (no prompts) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
  Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue
}

Import-Module psPAS -Force

<# =========================================
   CyberArk Safe Create + Member Add (psPAS) + Cleanup (REST)
   Phase 1:
     - Auth via CCP (CA_PAMDiscovery_SVC) -> psPAS Identity header
     - Create safe (no pre-check), add members:
        * <target AD group>@cna.com (Limited)
        * CA_PCloud_Admins@cna.com (Full)
        * cna_pas_admin@cyberark.cloud.6679 (Full)
        * cnarestbot@cyberark.cloud.6679 (Full)
     - Close psPAS session
   Phase 2:
     - CCP creds for object: "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"
     - OAuth client_credentials to https://aat4012.id.cyberark.cloud/oauth2/platformtoken
     - REST DELETE Safe member 'CA_PAMDiscovery_SVC' (try UPN + sAM)
   Notes:
     - No -SearchIn used
     - NumberOfVersionsRetention = 180
     - Safe description via dialog (console fallback)
   ========================================= #>

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# Simple console "box"
Function Show-Box {
    param([string]$Title, [string]$BodyLine1 = "", [string]$BodyLine2 = "")
    $line = ('=' * 72)
    Write-Host $line -ForegroundColor DarkGray
    if ($Title) { Write-Host ("[ " + $Title + " ]") -ForegroundColor Gray }
    if ($BodyLine1) { Write-Host $BodyLine1 -ForegroundColor Gray }
    if ($BodyLine2) { Write-Host $BodyLine2 -ForegroundColor Gray }
    Write-Host $line -ForegroundColor DarkGray
}

# --- Load psPAS ---
try {
    Import-Module psPAS -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log "psPAS loaded ($($mod.Version))." "Green"
} catch {
    Write-Log "❌ psPAS module not found/loaded: $($_.Exception.Message)" "Red"
    exit 1
}

# --- (Optional) AD module for OU validation (non-fatal) ---
$ADModuleLoaded = $false
try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $ADModuleLoaded = $true
} catch {
    Write-Log "⚠️ ActiveDirectory module not available; will still try to add group by UPN." "Yellow"
}

# ========== PHASE 1: Auth as CA_PAMDiscovery_SVC, Create Safe, Add Members ==========
# --- CCP for Discovery SVC ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safeAdmin  = "CA_PCloud_Admins"
$objectSVC  = "cna.com-CA_PAMDiscovery_SVC"  # per your request

$headers = @{ "Content-Type" = "application/json" }
$windowsAuth = $false

Write-Log "Retrieving CyberArk API credentials from CCP via Object method (CA_PAMDiscovery_SVC)..."
$ccpUrlSVC = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeAdmin&Object=$objectSVC"
try {
    $respSVC = Invoke-RestMethod $ccpUrlSVC -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $respSVC -or -not $respSVC.Content) {
        Write-Log "❌ ERROR: Failed to retrieve API credentials from CCP for CA_PAMDiscovery_SVC." "Red"
        exit 1
    }
    Write-Log "✅ Successfully retrieved credentials for user: $($respSVC.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch failed (SVC) - $_" "Red"
    exit 1
}

# --- psPAS Authentication using CCP secret + fixed username (SVC) ---
try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header) as CA_PAMDiscovery_SVC..."
    $UPUser = 'CA_PAMDiscovery_SVC'
    $UPPass = ConvertTo-SecureString $respSVC.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    $header = Get-IdentityHeader `
        -IdentityTenantURL "aat4012.id.cyberark.cloud" `
        -psPASFormat `
        -PCloudSubdomain "cna-prod" `
        -UPCreds $UPCred

    Use-PASSession $header

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established" }
    Write-Log "✅ Authentication successful, PAS session established (SVC)." "Green"
} catch {
    Write-Log "❌ Failed to authenticate via psPAS Identity header (SVC): $($_.Exception.Message)" "Red"
    exit 1
}

# --- Prompt for Safe Name ---
$SafeName = Read-Host "Enter the Safe Name"
if ([string]::IsNullOrWhiteSpace($SafeName)) {
    Write-Log "❌ ERROR: Safe Name cannot be empty. Exiting..." "Red"
    try { Close-PASSession -ErrorAction Stop; Write-Log "✅ Session closed." "Green" } catch {}
    exit 1
}

# --- Safe Description via DIALOG (with console fallback) ---
$Description = $null
try {
    Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop
    Show-Box -Title "Safe Description" -BodyLine1 "A dialog box will open. Paste a single-line description (max 200 chars)."
    $Description = [Microsoft.VisualBasic.Interaction]::InputBox(
        "Paste a single-line description for the Safe (max 200 characters).",
        "Safe Description",
        ""
    )
} catch {
    Show-Box -Title "Safe Description (Console Fallback)" `
        -BodyLine1 "Paste a single-line description for the Safe (max 200 chars)." `
        -BodyLine2 "Example: 'Service accounts for AppX PROD'."
    $Description = Read-Host "Enter the Safe Description"
}
if ([string]::IsNullOrWhiteSpace($Description)) {
    Write-Log "❌ ERROR: Safe Description cannot be empty. Exiting..." "Red"
    try { Close-PASSession -ErrorAction Stop; Write-Log "✅ Session closed." "Green" } catch {}
    exit 1
}
$Description = $Description.Trim()
if ($Description.Length -gt 200) {
    Write-Log "ℹ️ Safe Description >200 chars, auto-truncating."
    $Description = $Description.Substring(0,200)
}

# --- Create Safe (always try; continue if exists) ---
$ManagingCPM = "CNA_PASS_MANG"
try {
    Write-Log "Creating Safe: ${SafeName}..."
    Add-PASSafe -SafeName $SafeName -ManagingCPM $ManagingCPM -Description $Description -NumberOfVersionsRetention 180 -ErrorAction Stop | Out-Null
    Write-Log "✅ Successfully created Safe: ${SafeName}." "Green"
} catch {
    Write-Log "⚠️ Could not create Safe '${SafeName}': $($_.Exception.Message). Continuing to member add..." "Yellow"
}

# --- psPAS-friendly Permissions ---
$LimitedPermPAS = [PSCustomObject]@{
    UseAccounts=$false; RetrieveAccounts=$false; ListAccounts=$true; AddAccounts=$false
    UpdateAccountContent=$false; UpdateAccountProperties=$false; InitiateCPMAccountManagementOperations=$true
    SpecifyNextAccountContent=$false; RenameAccounts=$false; DeleteAccounts=$false; UnlockAccounts=$true
    ManageSafe=$false; ManageSafeMembers=$false; BackupSafe=$false; ViewAuditLog=$true; ViewSafeMembers=$true
    AccessWithoutConfirmation=$true; CreateFolders=$false; DeleteFolders=$false; MoveAccountsAndFolders=$false
    RequestsAuthorizationLevel1=$true; RequestsAuthorizationLevel2=$false
}
$FullPermPAS = [PSCustomObject]@{
    UseAccounts=$true; RetrieveAccounts=$true; ListAccounts=$true; AddAccounts=$true
    UpdateAccountContent=$true; UpdateAccountProperties=$true; InitiateCPMAccountManagementOperations=$true
    SpecifyNextAccountContent=$true; RenameAccounts=$true; DeleteAccounts=$true; UnlockAccounts=$true
    ManageSafe=$true; ManageSafeMembers=$true; BackupSafe=$true; ViewAuditLog=$true; ViewSafeMembers=$true
    AccessWithoutConfirmation=$true; CreateFolders=$true; DeleteFolders=$true; MoveAccountsAndFolders=$true
    RequestsAuthorizationLevel1=$true; RequestsAuthorizationLevel2=$false
}

# --- Target AD Group prompt & validation (OU=Groups,OU=CyberArk,DC=cna,DC=com) ---
$SearchBaseOU = 'OU=Groups,OU=CyberArk,DC=cna,DC=com'
Function Read-ValidGroup {
    while ($true) {
        $g = Read-Host "Enter the AD Safe Group (sAMAccountName only, e.g., ca_xxx_xxx_prod)"
        if ([string]::IsNullOrWhiteSpace($g)) { Write-Log "❌ Group cannot be empty." "Red"; continue }
        if ($g -notmatch '^[A-Za-z0-9_\-\.]+$') { Write-Log "❌ Invalid characters in group name. Try again." "Red"; continue }

        if ($ADModuleLoaded) {
            try {
                $adGroup = Get-ADGroup -LDAPFilter "(|(sAMAccountName=$g)(userPrincipalName=$g@cna.com))" -SearchBase $SearchBaseOU -ErrorAction Stop
                if ($adGroup) {
                    Write-Log ("✅ Found AD Group in {0}: {1} (sAM={2})" -f $SearchBaseOU, $adGroup.Name, $adGroup.SamAccountName) "Green"
                    return $g
                } else {
                    Write-Log ("❌ Group not found under {0}. Re-enter." -f $SearchBaseOU) "Red"
                }
            } catch {
                Write-Log ("❌ Error searching AD for '{0}' in {1}: {2}" -f $g, $SearchBaseOU, $_.Exception.Message) "Red"
            }
        } else {
            Write-Log "⚠️ AD module not loaded, proceeding with provided group name (will add as UPN)." "Yellow"
            return $g
        }
    }
}
$GroupSam = Read-ValidGroup
$TargetGroupUPN = "$GroupSam@cna.com"

# --- Members (admins unchanged + cnarestbot added with Full) ---
$Members = @(
    @{ Name = $TargetGroupUPN;                     Type = "Group"; Perm = $LimitedPermPAS }, # Target AD group (Limited)
    @{ Name = "CA_PCloud_Admins@cna.com";          Type = "Group"; Perm = $FullPermPAS    }, # Registered group (Full)
    @{ Name = "cna_pas_admin@cyberark.cloud.6679"; Type = "User";  Perm = $FullPermPAS    }, # Vault user (Full)
    @{ Name = "cnarestbot@cyberark.cloud.6679";    Type = "User";  Perm = $FullPermPAS    }  # Added admin (Full)
)

# Helper: Add member
Function Add-MemberToSafe {
    param(
        [string]$SafeName,
        [string]$MemberName,
        [ValidateSet("Group","User","Role")]
        [string]$MemberType,
        [pscustomobject]$Permissions
    )
    try {
        Write-Log "Adding ${MemberType} '${MemberName}' to ${SafeName}..."
        $Permissions | Add-PASSafeMember -SafeName $SafeName -MemberType $MemberType -MemberName $MemberName -ErrorAction Stop | Out-Null
        Write-Log "✅ Added ${MemberType}: ${MemberName}." "Green"
        return $true
    } catch {
        Write-Log "❌ Failed to add '${MemberName}' - $($_.Exception.Message)" "Red"
        return $false
    }
}

# --- Add all members (Phase 1) ---
foreach ($m in $Members) {
    [void](Add-MemberToSafe -SafeName $SafeName -MemberName $m.Name -MemberType $m.Type -Permissions $m.Perm)
}

Write-Log "✅ Safe member addition process completed." "Green"

# --- End Phase 1 session cleanly ---
try {
    Close-PASSession -ErrorAction Stop
    Write-Log "✅ Session closed." "Green"
} catch {
    Write-Log "ℹ️ Session close encountered an issue: $($_.Exception.Message)" "Yellow"
}

# ========== PHASE 2: OAuth (platformtoken) with cnarestbot, remove CA_PAMDiscovery_SVC ==========
# PVWA base
$PVWA = "https://cna-prod.privilegecloud.cyberark.cloud"

# CCP for cnarestbot (client credentials)
$objectBot = "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"
Write-Log "Retrieving CyberArk API credentials from CCP via Object method (cnarestbot)..."
$ccpUrlBot = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeAdmin&Object=$objectBot"
try {
    $respBot = Invoke-RestMethod $ccpUrlBot -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $respBot -or -not $respBot.Content) {
        Write-Log "❌ ERROR: Failed to retrieve API credentials from CCP for cnarestbot." "Red"
        exit 1
    }
    Write-Log "✅ Successfully retrieved credentials for user: $($respBot.Username)" "Green"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch failed (cnarestbot) - $_" "Red"
    exit 1
}

# ---- Identity OAuth client_credentials ----
$IdentityTenantID = "aat4012"
$ClientID         = $respBot.Username
$ClientSecret     = $respBot.Content

if ([string]::IsNullOrEmpty($ClientID) -or [string]::IsNullOrEmpty($ClientSecret)) {
    Write-Log "❌ ERROR: Client ID or Client Secret is missing. Exiting..." "Red"
    exit
}

Write-Log "Requesting initial CyberArk ISPSS token..."
$TokenURL = "https://$IdentityTenantID.id.cyberark.cloud/oauth2/platformtoken"
$TokenBody = @{
    grant_type    = "client_credentials"
    client_id     = $ClientID
    client_secret = $ClientSecret
}
$headers_token = @{ "Content-Type" = "application/x-www-form-urlencoded" }

try {
    $TokenResponse = Invoke-RestMethod -Uri $TokenURL -Method Post -Headers $headers_token -Body $TokenBody
    $BearerToken = [string]$TokenResponse.access_token
    if ([string]::IsNullOrEmpty($BearerToken) -or $BearerToken.Length -lt 100) {
        Write-Log "❌ ERROR: Received an invalid token. Length: $($BearerToken.Length)" "Red"
        exit
    }
    Write-Log "✅ Authentication successful, token obtained." "Green"
} catch {
    Write-Log "❌ ERROR: Failed to authenticate with CyberArk ISPSS. $_" "Red"
    exit
}

# REST headers
$headers_api = @{
    "Authorization" = "Bearer $BearerToken"
    "Content-Type"  = "application/json"
}

# Helper: Remove safe member via REST (tries /api and /API, UPN/sAM)
Function Remove-SafeMemberREST {
    param(
        [string]$BaseUrl,
        [string]$SafeName,
        [string]$MemberName,
        [hashtable]$Headers
    )

    $encodedMember = [System.Uri]::EscapeDataString($MemberName)
    $encodedSafe   = [System.Uri]::EscapeDataString($SafeName)

    $paths = @(
        "/PasswordVault/api/Safes/$encodedSafe/Members/$encodedMember",
        "/PasswordVault/API/Safes/$encodedSafe/Members/$encodedMember"
    )

    foreach ($p in $paths) {
        $url = "$BaseUrl$p"
        try {
            Invoke-RestMethod -Uri $url -Method Delete -Headers $Headers -ErrorAction Stop | Out-Null
            Write-Log "✅ Removed user '$MemberName' from Safe '$SafeName' via $p." "Green"
            return $true
        } catch {
            $msg = $_.Exception.Message
            # 404 -> not found/ not a member; other errors log & continue
            Write-Log "ℹ️ DELETE $p failed for '$MemberName': $msg" "Yellow"
        }
    }
    return $false
}

# Try removing SVC by UPN first, then sAM
$removed = $false
foreach ($candidate in @("CA_PAMDiscovery_SVC@cna.com","CA_PAMDiscovery_SVC")) {
    Write-Log "Attempting to remove user '$candidate' from Safe '$SafeName'..."
    if (Remove-SafeMemberREST -BaseUrl $PVWA -SafeName $SafeName -MemberName $candidate -Headers $headers_api) {
        $removed = $true
        break
    }
}

if (-not $removed) {
    Write-Log "ℹ️ Could not remove 'CA_PAMDiscovery_SVC' (may not be a member or mapping differs). Check PVWA > Safe Members for exact name." "Yellow"
}

Write-Log "✅ Script completed." "Green"
