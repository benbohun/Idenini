#region Functions
Function Start-Run {
    
    $Script:UserName = $null
    $Script:Selection = $null
    $Script:SelectionDomain = $null
    $Script:UserName = Read-Host "Enter the Service Account name"

    If ($UserName -ne "") { 

            Show-MenuAccountTypes
            $Script:Selection = Read-Host "Please make a selection"
            If ((($Selection|Where-Object{$_}) -ne $null) -and ((($Selection|Where-Object{$_}) -match "^\d+$") -or (($Selection|Where-Object{$_}) -eq 'q'))){
                    
                #AccountType is selected and validated, now select a domain.   
                Show-MenuDomain
                $Script:SelectionDomain = Read-Host "Please make a selection"
                If ((($SelectionDomain|Where-Object{$_}) -ne $null) -and ((($SelectionDomain|Where-Object{$_}) -match "^\d+$") -or (($SelectionDomain|Where-Object{$_}) -eq 'q'))){
            

                    If ($SelectionDomain -eq "1"){$Script:Address = "mbh.mhs.magellanhealth.com"}
                    If ($SelectionDomain -eq "2"){$Script:Address = "mbhdev.mhs.magellanhealth.com"}
                    If ($SelectionDomain -eq "3"){$Script:Address = "mea.mhs.magellanhealth.com"}
                    If ($SelectionDomain -eq "4"){$Script:Address = "mhs.magellanhealth.com"}
                    If ($SelectionDomain -eq "5"){$Script:Address = "vbr.magellanhealth.com"}
                    If ($SelectionDomain -eq "q"){Return}
                            

                   
                    cls
                    Write-Host ""
                    Write-Host -ForegroundColor Black -BackgroundColor Gray      " INFORMATIONAL                                                                                                  "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "                                                                                                                "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "Application Name is typically the Name defined after APP.  Do not include M365 in application name.             "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "                                                                                                                "
                    Write-Host -ForegroundColor Yellow -BackgroundColor DarkGray "Examples:                                                                                                       "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "MBH-APP-SQL [Application name = SQL]                                                                            "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "MHS-APP-SQL-MHC-180 [Application name = SQL-MHC]                                                                "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "MHS-APP-SQL-MHC-M365 [Application name = SQL-MHC]                                                               "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "MBH-APP-TRUCARE-BH [Application name = TRUCARE-BH]                                                              "
                    Write-Host -ForegroundColor Gray -BackgroundColor DarkGray   "                                                                                                                "
                    Write-Host ""
                            

    
                    $Script:Application = Read-Host "Enter Application Name"

                    Onboard

                    AddPAPMSafeAccessPermissions


                    Write-Host ""
                    Write-Host -BackgroundColor Gray -ForegroundColor Black      " INFORMATIONAL                                        "
                    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray   "Script completed execution.                           " 
                    Write-Host -BackgroundColor DarkGray -ForegroundColor Gray   "                                                      "                                                                         
                    pause
                    Exit 


                }

                Else {
                
                Write-Host -BackgroundColor Black -ForegroundColor Yellow "Value is not acceptable."
                Pause
        
                }

                    

           
            }

            Else {
                
                Write-Host -BackgroundColor Black -ForegroundColor Yellow "Value is not acceptable."
                Pause
        
                }

        
            
    }
    
    Else {Return}         


}
Function AddPAPMSafeAccessPermissions {

    $RoleVaultUser = [PSCustomObject]@{
            UseAccounts                            = $true
            RetrieveAccounts                       = $true
            ListAccounts                           = $true
            UpdateAccountContent                   = $false
            InitiateCPMAccountManagementOperations = $true
            ViewAuditLog                           = $true
            ViewSafeMembers                        = $true
            AccessWithoutConfirmation              = $true
            UnlockAccounts                         = $false

    }
    
    

    $CheckForExistingSafeAccessGroup = (Get-PASSafeMember -SafeName $SafeName -ErrorAction SilentlyContinue).Username

    ##Adding Safe Access Group
    If (!($PAPMSafeAccessGroup -in $CheckForExistingSafeAccessGroup)) {

        Try {
            
            $Error.clear()
            
            $RoleVaultUser | Add-PASSafeMember -SafeName $SafeName -memberType Group -MemberName $PAPMSafeAccessGroup -ErrorAction SilentlyContinue # -SearchIn "magellanhealth.com" -ErrorAction SilentlyContinue
          
                        
        }

        Catch {
                        
                        
            Write-Host "Trouble adding vault member: $($PAPMSafeAccessGroup) || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

            continue

            }

    }
    ##Setting Safe Access Group
    Else {
                
        Write-Host "$($PAPMSafeAccessGroup) already exists, Setting permissions"
    
        ##Updating Safe Access Group
        Try {
            
            $Error.clear()
            
            $RoleVaultUser | Set-PASSafeMember -SafeName $SafeName -MemberName $PAPMSafeAccessGroup -ErrorAction SilentlyContinue


        }

        Catch {

            Write-Host "Trouble setting vault member: $($PAPMSafeAccessGroup) || $($Error[0].ScriptStackTrace) || $($Error[0].Exception)"

            continue

            }

        }           

                
}
