<#
Single report including status + owners from extensionAttribute3/4.
- extensionAttribute3 => Primary owner (SAM expected)
- extensionAttribute4 => Secondary owner (SAM expected)
- Resolves each owner SAM to AD Name where possible.

Output: AccountReport.csv (in the same folder as the input CSV)
Requires: RSAT ActiveDirectory module.
#>

# ================================
# CONFIG — EDIT ME
# ================================
$InputCsvPath = "C:\Data\accounts.csv"   # Local path to your input CSV
# ================================

# ---------- Prep & validation ----------
if (-not (Test-Path $InputCsvPath)) { throw "Input CSV not found: $InputCsvPath" }

$OutDir = Split-Path -Path $InputCsvPath -Parent
if (-not $OutDir) { $OutDir = "." }
$OutFile = Join-Path $OutDir "AccountReport.csv"

# Ensure AD module
if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
  throw "ActiveDirectory module not found. Install RSAT or run on a domain-joined host with RSAT."
}

# ---------- Load input ----------
$rows = Import-Csv -Path $InputCsvPath
if (-not $rows -or $rows.Count -eq 0) { throw "Input CSV appears empty: $InputCsvPath" }

# Determine username column
$possibleCols = @('samAccountName','Account')
$samCol = $possibleCols | Where-Object { $_ -in $rows[0].PsObject.Properties.Name }
if (-not $samCol) { throw "Input CSV must contain a column named 'samAccountName' or 'Account'." }

# ---------- Helpers ----------
# Normalize a login value; often a plain SAM, but handle stray delimiters/whitespace.
function Normalize-Login([string]$val) {
  if ([string]::IsNullOrWhiteSpace($val)) { return "" }
  $t = $val.Trim()
  # If attributes contain multiple tokens, take the first non-empty token.
  $parts = ($t -split '[;,\|\s]+' | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
  if ($parts.Count -gt 0) { return $parts[0].Trim() }
  return $t
}

# Resolve a login (sam/upn) to AD user; returns PSCustomObject with Sam and Name
function Resolve-Owner([string]$login) {
  $loginNorm = Normalize-Login $login
  if ([string]::IsNullOrWhiteSpace($loginNorm)) {
    return [pscustomobject]@{ Sam = ""; Name = "" }
  }

  try {
    # Try by sAM first; also consider UPN.
    $u = Get-ADUser -LDAPFilter "(|(sAMAccountName=$loginNorm)(userPrincipalName=$loginNorm))" -Properties Name, displayName, sAMAccountName -ErrorAction Stop
    $name = if ($u.displayName) { $u.displayName } elseif ($u.Name) { $u.Name } else { "" }
    $sam  = if ($u.sAMAccountName) { $u.sAMAccountName } else { $loginNorm }
    return [pscustomobject]@{ Sam = $sam; Name = $name }
  } catch {
    # Not found; keep the original token in Sam so you still see what was stored
    return [pscustomobject]@{ Sam = $loginNorm; Name = "" }
  }
}

# ---------- Process ----------
$report = New-Object System.Collections.Generic.List[object]

foreach ($row in $rows) {
  $sam = ($row.$samCol).ToString().Trim()
  if ([string]::IsNullOrWhiteSpace($sam)) { continue }

  $user = $null
  try {
    # Pull status + owner attributes
    $user = Get-ADUser -LDAPFilter "(sAMAccountName=$sam)" -Properties Enabled, whenCreated, lastLogonDate, extensionAttribute3, extensionAttribute4
  } catch { }

  if ($null -eq $user) {
    $report.Add([pscustomobject]@{
      samAccountName        = $sam
      ADExists              = 'No'
      Enabled               = ''
      WhenCreated           = ''
      LastLogonDate         = ''
      OwnerPrimarySAM       = ''
      OwnerPrimaryName      = ''
      OwnerSecondarySAM     = ''
      OwnerSecondaryName    = ''
      OwnersCombined        = ''
    })
    continue
  }

  $enabled = if ($user.PSObject.Properties['Enabled']) { [bool]$user.Enabled } else { $false }

  # Read owners from extension attributes
  $rawPrim = $user.extensionAttribute3
  $rawSec  = $user.extensionAttribute4

  $prim = Resolve-Owner $rawPrim
  $sec  = Resolve-Owner $rawSec

  # Build a combined, human-readable string (omit missing parts cleanly)
  $ownersParts = @()
  if ($prim.Sam) { $ownersParts += ("Primary: {0}{1}" -f $prim.Sam, ($(if ($prim.Name) { " ($($prim.Name))" } else { "" }))) }
  if ($sec.Sam)  { $ownersParts += ("Secondary: {0}{1}" -f $sec.Sam,  ($(if ($sec.Name)  { " ($($sec.Name))" }  else { "" }))) }
  $ownersCombined = [string]::Join(" | ", $ownersParts)

  $report.Add([pscustomobject]@{
    samAccountName        = $sam
    ADExists              = 'Yes'
    Enabled               = $(if ($enabled) { 'Enabled' } else { 'Disabled' })
    WhenCreated           = $user.whenCreated
    LastLogonDate         = $user.lastLogonDate
    OwnerPrimarySAM       = $prim.Sam
    OwnerPrimaryName      = $prim.Name
    OwnerSecondarySAM     = $sec.Sam
    OwnerSecondaryName    = $sec.Name
    OwnersCombined        = $ownersCombined
  })
}

# ---------- Output ----------
$report | Export-Csv -Path $OutFile -NoTypeInformation -Encoding UTF8

Write-Host "✅ Done."
Write-Host " - Report: $OutFile"
