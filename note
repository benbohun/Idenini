<#
CNA_Create_Update_AssignPermission_UIDLookup.ps1

Purpose
- Prompt for regular CyberArk Identity credential
- Prompt for app Name
- Prompt for permission target and type
- Create app from GenericBrowserExtensionScript
- Re-auth for update
- Re-auth for permission assignment
- Resolve Identity UID for the group/user/role first
- Use strict SetApplicationPermissions schema
#>

[CmdletBinding()]
param(
    [string]$IdentityApiTenantURL      = 'https://aat4012.id.cyberark.cloud',

    [string]$RegularUserName           = '',
    [string]$RegularUserPassword       = '',

    [string]$TemplateId                = 'GenericBrowserExtensionScript',

    [string]$Name                      = 'g-test-pam1',
    [string]$DisplayName               = 'GCP - Okta Prod',
    [string]$Category                  = '_I18N_AppCategory_Other',
    [string]$DefaultAuthProfile        = 'AlwaysAllowed',
    [string]$DefaultAuthProfileUuid    = 'AlwaysAllowed',
    [bool]$OnPrem                      = $true,
    [bool]$IsSwsEnabled                = $true,
    [bool]$ShowRegistration            = $false,
    [string]$AdminTag                  = '_I18N_AppCategory_Other',
    [string]$UserNameStrategy          = 'SetByUser',
    [bool]$FormFillingEnabled          = $true,
    [bool]$Generic                     = $true,
    [string]$AppType                   = 'Web',
    [string]$Description               = '_I18N_AppDesc_Generic_BE_Script',
    [string]$IconUri                   = '/vfslow/lib/application/icons/GenericBrowserExtension.svg',
    [string]$WebAppType                = 'UsernamePassword',
    [string]$TemplateName              = 'GenericBrowserExtensionScript',
    [string]$Notes                     = '',
    [bool]$LocalizationEnabled         = $false,
    [string]$WebUPAppType              = 'BrowserExtensionScript',
    [bool]$NotSelfService              = $true,

    [string]$AdvancedScript            = @'
loginData.applicationUrl = "https://cna.okta.com/login/default";
loginData.addField("username", "input#input28", LoginUsername + "@cna.com");
loginData.addField("password", "input[name='credentials.passcode']", LoginPassword);
loginData.formPattern = "form";
loginData.globalSelectorTimeout = 10000;
loginData.order = [
  ["fill", "username"],
  ["fill", "password"],
  ["click", "input[type='submit'][value='Sign in']"]
];
'@,

    [string]$PermissionPrincipal       = '',
    [ValidateSet('Group','User','Role')]
    [string]$PermissionPrincipalType   = 'Group',

    # Scope exact group lookup when known
    [string]$DirectoryServiceFilter    = 'AdProxy_cnaroot.com',

    [int]$PreUpdateDelaySeconds        = 15,
    [int]$UpdateRetryWindowSeconds     = 300,
    [int]$PermissionRetryWindowSeconds = 180,
    [int]$RetryIntervalSeconds         = 20,
    [int]$MaxPhaseReauthAttempts       = 2,

    [string]$LogPath                   = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_Update_AssignPermission_UIDLookup.log',
    [string]$ReportCsvPath             = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_Update_AssignPermission_UIDLookup_Report.csv'
)

$script:IdentityAuthToken         = $null
$script:IdentityUser              = $null
$script:IdentityWebSession        = $null
$script:RegularCredential         = $null
$script:RegularUserPlainPassword  = $null
$script:ReportRows                = @()

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Add-ReportRow {
    param([string]$Step,[string]$Status,[string]$Detail)
    $script:ReportRows += [pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }
}

function Get-DirectField {
    param([Parameter(Mandatory)]$Object,[Parameter(Mandatory)][string]$FieldName)
    if ($null -eq $Object) { return $null }
    if ($Object -is [System.Collections.IDictionary]) {
        if ($Object.Contains($FieldName)) { return $Object[$FieldName] }
        return $null
    }
    if ($Object.PSObject -and $Object.PSObject.Properties.Name -contains $FieldName) {
        return $Object.$FieldName
    }
    return $null
}

function Convert-SecureStringToPlainText {
    param([Parameter(Mandatory)][SecureString]$SecureString)
    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecureString)
    try {
        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    } finally {
        if ($bstr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        }
    }
}

function Escape-SqlLiteral {
    param([Parameter(Mandatory)][string]$Value)
    return ($Value -replace "'", "''")
}

function ConvertTo-JsonSafe {
    param([Parameter()][object]$Object)
    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 100)
}

function Prompt-ForRegularCredential {
    if ([string]::IsNullOrWhiteSpace($RegularUserName)) {
        $script:RegularCredential = Get-Credential -Message 'Enter REGULAR user credential for CyberArk Identity'
        if ($null -eq $script:RegularCredential) { throw 'Credential prompt was cancelled.' }
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $script:RegularCredential.Password
        return
    }

    if ([string]::IsNullOrWhiteSpace($RegularUserPassword)) {
        $secure = Read-Host "Enter password for $RegularUserName" -AsSecureString
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $secure
    } else {
        $secure = ConvertTo-SecureString $RegularUserPassword -AsPlainText -Force
        $script:RegularUserPlainPassword = $RegularUserPassword
    }

    $script:RegularCredential = [pscredential]::new($RegularUserName, $secure)
}

function Get-ResolvedAppName {
    $entered = Read-Host ("Enter the app Name [{0}]" -f $Name)
    if ([string]::IsNullOrWhiteSpace($entered)) { return $Name }
    return $entered.Trim()
}

function Get-ResolvedPermissionPrincipal {
    while ($true) {
        $entered = if (-not [string]::IsNullOrWhiteSpace($PermissionPrincipal)) {
            $PermissionPrincipal.Trim()
        } else {
            (Read-Host 'Enter the permission target to add (user/group/role name exactly as it appears in Identity)').Trim()
        }

        if ([string]::IsNullOrWhiteSpace($entered)) {
            Write-Log 'Permission target cannot be empty.' 'Yellow'
            $PermissionPrincipal = ''
            continue
        }

        if ($entered -match '^(?i)(group|user|role)$') {
            Write-Log ("'{0}' looks like a type, not the actual principal name. Enter the real Identity group/user/role value." -f $entered) 'Yellow'
            $PermissionPrincipal = ''
            continue
        }

        return $entered
    }
}

function Get-ResolvedPermissionType {
    $entered = Read-Host ("Enter permission target type [default: {0}] (Group/User/Role)" -f $PermissionPrincipalType)
    if ([string]::IsNullOrWhiteSpace($entered)) { return $PermissionPrincipalType }
    switch -Regex ($entered.Trim()) {
        '^(?i)group$' { return 'Group' }
        '^(?i)user$'  { return 'User'  }
        '^(?i)role$'  { return 'Role'  }
        default { throw 'Permission target type must be Group, User, or Role.' }
    }
}

function Reset-IdentitySessionState {
    $script:IdentityAuthToken  = $null
    $script:IdentityUser       = $null
    $script:IdentityWebSession = $null
}

function Get-AuthPayload {
    param([Parameter(Mandatory)]$Response)
    if ($Response.PSObject -and $Response.PSObject.Properties.Name -contains 'Result' -and $null -ne $Response.Result) {
        return $Response.Result
    }
    return $Response
}

function Get-AuthSummaryValue { param([Parameter(Mandatory)]$Payload) return [string](Get-DirectField -Object $Payload -FieldName 'Summary') }
function Get-AuthSessionId   { param([Parameter(Mandatory)]$Payload) return [string](Get-DirectField -Object $Payload -FieldName 'SessionId') }
function Get-AuthTokenValue  { param([Parameter(Mandatory)]$Payload) return [string](Get-DirectField -Object $Payload -FieldName 'Auth') }
function Get-AuthUserValue   { param([Parameter(Mandatory)]$Payload) return [string](Get-DirectField -Object $Payload -FieldName 'User') }

function Get-FirstMechanism {
    param([Parameter(Mandatory)]$Payload)
    $challenges = @(Get-DirectField -Object $Payload -FieldName 'Challenges')
    foreach ($challenge in $challenges) {
        $mechs = @(Get-DirectField -Object $challenge -FieldName 'Mechanisms')
        foreach ($mech in $mechs) {
            $mechId = [string](Get-DirectField -Object $mech -FieldName 'MechanismId')
            if (-not [string]::IsNullOrWhiteSpace($mechId)) { return $mech }
        }
    }
    return $null
}

function Get-MechanismPrompt {
    param([Parameter(Mandatory)]$Mechanism)
    $name   = [string](Get-DirectField -Object $Mechanism -FieldName 'Name')
    $prompt = [string](Get-DirectField -Object $Mechanism -FieldName 'PromptSelectMech')
    $type   = [string](Get-DirectField -Object $Mechanism -FieldName 'AnswerType')

    if ($name -eq 'UP' -or $prompt -match 'Password') {
        return @{ Action = 'Answer'; Answer = $script:RegularUserPlainPassword }
    }

    $display = if (-not [string]::IsNullOrWhiteSpace($prompt)) { $prompt } else { $name }
    $answer = Read-Host ("Enter response for challenge [{0}] {1}" -f $type, $display)
    return @{ Action = 'Answer'; Answer = $answer }
}

function Start-IdentityRegularUserSession {
    if ($null -eq $script:RegularCredential) { throw 'Regular user credential is not initialized.' }

    $tenantUrl = $IdentityApiTenantURL
    $userName  = $script:RegularCredential.UserName
    $baseHeaders = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Content-Type'         = 'application/json'
        'Accept'               = 'application/json'
    }

    $startUri = ($tenantUrl.TrimEnd('/') + '/Security/StartAuthentication')
    $advUri   = ($tenantUrl.TrimEnd('/') + '/Security/AdvanceAuthentication')
    $script:IdentityWebSession = New-Object Microsoft.PowerShell.Commands.WebRequestSession

    Write-Log ("Starting interactive CyberArk Identity authentication for user '{0}'..." -f $userName) 'Cyan'

    $startBody = @{ User = $userName; Version = '1.0' }
    $startResp = Invoke-RestMethod -Method POST -Uri $startUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body ($startBody | ConvertTo-Json -Depth 20) -ErrorAction Stop
    $payload = Get-AuthPayload -Response $startResp

    for ($i = 0; $i -lt 10; $i++) {
        $summary = Get-AuthSummaryValue -Payload $payload
        $authVal = Get-AuthTokenValue -Payload $payload
        if ($summary -eq 'LoginSuccess' -or -not [string]::IsNullOrWhiteSpace($authVal)) {
            $script:IdentityAuthToken = $authVal
            $script:IdentityUser      = Get-AuthUserValue -Payload $payload
            $cookieCount = 0
            try { $cookieCount = $script:IdentityWebSession.Cookies.GetCookies($tenantUrl).Count } catch {}
            Write-Log ("Identity API authentication succeeded as '{0}'. CookieCount={1}" -f $script:IdentityUser, $cookieCount) 'Green'
            Add-ReportRow -Step 'Identity Login' -Status 'SUCCESS' -Detail ("Authenticated as {0}; CookieCount={1}" -f $script:IdentityUser, $cookieCount)
            return
        }

        $sessionId = Get-AuthSessionId -Payload $payload
        if ([string]::IsNullOrWhiteSpace($sessionId)) { throw 'Authentication package did not include SessionId.' }

        $mechanism = Get-FirstMechanism -Payload $payload
        if ($null -eq $mechanism) { throw 'No supported authentication mechanism was returned.' }

        $mechId = [string](Get-DirectField -Object $mechanism -FieldName 'MechanismId')
        $name   = [string](Get-DirectField -Object $mechanism -FieldName 'Name')
        $prompt = [string](Get-DirectField -Object $mechanism -FieldName 'PromptSelectMech')

        Write-Log ("Responding to Identity challenge. Mechanism='{0}' Prompt='{1}'." -f $name, $prompt) 'Gray'
        $response = Get-MechanismPrompt -Mechanism $mechanism

        $advBody = @{
            SessionId   = $sessionId
            MechanismId = $mechId
            Action      = $response.Action
            Answer      = $response.Answer
        }

        $advResp = Invoke-RestMethod -Method POST -Uri $advUri -Headers $baseHeaders -WebSession $script:IdentityWebSession -ContentType 'application/json' -Body ($advBody | ConvertTo-Json -Depth 20) -ErrorAction Stop
        $payload = Get-AuthPayload -Response $advResp
    }

    throw 'Interactive Identity authentication did not complete after multiple challenge rounds.'
}

function Invoke-IdentityRequestRaw {
    param(
        [Parameter(Mandatory)][string]$AbsoluteUri,
        [Parameter()][object]$Body,
        [ValidateSet('BearerCookie','CookieOnly','BearerOnly')][string]$AuthMode = 'BearerCookie'
    )

    $headers = @{
        'X-IDAP-NATIVE-CLIENT' = 'true'
        'Accept'               = 'application/json'
        'Content-Type'         = 'application/json'
    }

    if ($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'BearerOnly') {
        if ([string]::IsNullOrWhiteSpace($script:IdentityAuthToken)) { throw 'Identity auth token is not initialized.' }
        $headers['Authorization'] = ("Bearer {0}" -f $script:IdentityAuthToken)
    }

    $invokeParams = @{
        Method      = 'POST'
        Uri         = $AbsoluteUri
        Headers     = $headers
        ContentType = 'application/json'
        ErrorAction = 'Stop'
    }

    if ($null -ne $Body) { $invokeParams['Body'] = ($Body | ConvertTo-Json -Depth 100) }

    if (($AuthMode -eq 'BearerCookie' -or $AuthMode -eq 'CookieOnly') -and $null -ne $script:IdentityWebSession) {
        $invokeParams['WebSession'] = $script:IdentityWebSession
    }

    return Invoke-RestMethod @invokeParams
}

function Invoke-IdentityRequestWithRetry {
    param(
        [Parameter(Mandatory)][string[]]$AbsoluteUris,
        [Parameter()][object]$Body,
        [string]$LogicalName = 'Identity API call'
    )

    $authModes = @('BearerCookie','CookieOnly','BearerOnly')
    $errors = @()

    foreach ($uri in $AbsoluteUris) {
        foreach ($mode in $authModes) {
            try {
                Write-Log ("Trying {0} via URI '{1}' using auth mode '{2}'..." -f $LogicalName, $uri, $mode) 'Gray'
                $resp = Invoke-IdentityRequestRaw -AbsoluteUri $uri -Body $Body -AuthMode $mode
                Write-Log ("Succeeded: {0} via URI '{1}' using auth mode '{2}'." -f $LogicalName, $uri, $mode) 'Gray'
                return $resp
            } catch {
                $status = $null
                try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
                $msg = $_.Exception.Message
                $errors += ("URI={0}; Mode={1}; Status={2}; Error={3}" -f $uri, $mode, $status, $msg)
                if ($status -eq 401) {
                    Write-Log ("401 on {0} via URI '{1}' using auth mode '{2}'. Retrying..." -f $LogicalName, $uri, $mode) 'Yellow'
                    continue
                }
                throw
            }
        }
    }

    throw ("Unauthorized persisted for {0}. Details: {1}" -f $LogicalName, ($errors -join ' || '))
}

function Invoke-RedrockQuery {
    param([Parameter(Mandatory)][string]$Script)
    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/Redrock/query'
    $body = @{
        Script = $Script
        Args   = @{
            PageNumber = 1
            PageSize   = 10
            Limit      = 10
            SortBy     = ''
            direction  = $false
            Caching    = -1
        }
    }
    return Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'RedrockQuery'
}

function Get-RedrockItems {
    param([Parameter(Mandatory)]$Response)

    $items = @()
    $result = Get-DirectField -Object $Response -FieldName 'Result'
    if ($null -eq $result) { return @() }

    $results = Get-DirectField -Object $result -FieldName 'Results'
    if ($null -eq $results) { return @() }

    foreach ($item in @($results)) {
        if ($null -eq $item) { continue }

        $row = Get-DirectField -Object $item -FieldName 'Row'
        $entities = @(Get-DirectField -Object $item -FieldName 'Entities')
        $entityKey = $null
        if ($entities.Count -gt 0 -and $null -ne $entities[0]) {
            $entityKey = [string](Get-DirectField -Object $entities[0] -FieldName 'Key')
        }

        $items += [pscustomobject]@{
            Row       = $row
            EntityKey = $entityKey
        }
    }

    return ,$items
}

function Resolve-IdentityPrincipal {
    param(
        [Parameter(Mandatory)][string]$Principal,
        [Parameter(Mandatory)][ValidateSet('Group','User','Role')][string]$PrincipalType
    )

    if ($PrincipalType -eq 'Group') {
        $escaped = Escape-SqlLiteral -Value $Principal
        $scope = ''
        if (-not [string]::IsNullOrWhiteSpace($DirectoryServiceFilter)) {
            $escSvc = Escape-SqlLiteral -Value $DirectoryServiceFilter
            $scope = " AND ServiceInstance = '$escSvc'"
        }

        $query = @"
Select InternalName, SystemName, DisplayName, DirectoryServiceUuid, ServiceInstance
from DSGroups
WHERE SystemName = '$escaped'$scope
"@

        $items = @(Get-RedrockItems -Response (Invoke-RedrockQuery -Script $query))
        if ($items.Count -gt 0 -and $null -ne $items[0].Row) {
            $row = $items[0].Row
            $principalId = [string](Get-DirectField -Object $row -FieldName 'InternalName')
            if ([string]::IsNullOrWhiteSpace($principalId)) { $principalId = $items[0].EntityKey }

            $principalValue = [string](Get-DirectField -Object $row -FieldName 'SystemName')
            if ([string]::IsNullOrWhiteSpace($principalValue)) { $principalValue = $Principal }

            if (-not [string]::IsNullOrWhiteSpace($principalId)) {
                $resolved = [pscustomobject]@{
                    PrincipalType = 'Group'
                    Input         = $Principal
                    Principal     = $principalValue
                    PrincipalId   = $principalId
                    MatchedFrom   = 'DSGroups'
                }
                Write-Log ("Resolved Group principal '{0}' via DSGroups -> Principal='{1}' PrincipalId='{2}'." -f $Principal, $resolved.Principal, $resolved.PrincipalId) 'Green'
                Add-ReportRow -Step 'Resolve Principal' -Status 'SUCCESS' -Detail (ConvertTo-JsonSafe $resolved)
                return $resolved
            }
        }

        throw ("No usable DSGroups UID could be resolved for group '{0}'." -f $Principal)
    }

    if ($PrincipalType -eq 'User') {
        $escaped = Escape-SqlLiteral -Value $Principal
        $query = @"
Select InternalName, SystemName, DisplayName, DirectoryServiceUuid, Email
from DSUsers
WHERE SystemName = '$escaped' OR Email = '$escaped'
"@
        $items = @(Get-RedrockItems -Response (Invoke-RedrockQuery -Script $query))
        if ($items.Count -gt 0 -and $null -ne $items[0].Row) {
            $row = $items[0].Row
            $principalId = [string](Get-DirectField -Object $row -FieldName 'InternalName')
            if ([string]::IsNullOrWhiteSpace($principalId)) { $principalId = $items[0].EntityKey }
            $principalValue = [string](Get-DirectField -Object $row -FieldName 'SystemName')
            if ([string]::IsNullOrWhiteSpace($principalValue)) { $principalValue = $Principal }

            if (-not [string]::IsNullOrWhiteSpace($principalId)) {
                $resolved = [pscustomobject]@{
                    PrincipalType = 'User'
                    Input         = $Principal
                    Principal     = $principalValue
                    PrincipalId   = $principalId
                    MatchedFrom   = 'DSUsers'
                }
                Write-Log ("Resolved User principal '{0}' via DSUsers -> Principal='{1}' PrincipalId='{2}'." -f $Principal, $resolved.Principal, $resolved.PrincipalId) 'Green'
                Add-ReportRow -Step 'Resolve Principal' -Status 'SUCCESS' -Detail (ConvertTo-JsonSafe $resolved)
                return $resolved
            }
        }

        throw ("No usable DSUsers UID could be resolved for user '{0}'." -f $Principal)
    }

    $escaped = Escape-SqlLiteral -Value $Principal
    $query = @"
Select ID, Name, RoleType
from Role
WHERE Name = '$escaped' OR ID = '$escaped'
"@
    $items = @(Get-RedrockItems -Response (Invoke-RedrockQuery -Script $query))
    if ($items.Count -gt 0 -and $null -ne $items[0].Row) {
        $row = $items[0].Row
        $principalId = [string](Get-DirectField -Object $row -FieldName 'ID')
        $principalValue = [string](Get-DirectField -Object $row -FieldName 'Name')

        if (-not [string]::IsNullOrWhiteSpace($principalId) -and -not [string]::IsNullOrWhiteSpace($principalValue)) {
            $resolved = [pscustomobject]@{
                PrincipalType = 'Role'
                Input         = $Principal
                Principal     = $principalValue
                PrincipalId   = $principalId
                MatchedFrom   = 'Role'
            }
            Write-Log ("Resolved Role principal '{0}' -> Principal='{1}' PrincipalId='{2}'." -f $Principal, $resolved.Principal, $resolved.PrincipalId) 'Green'
            Add-ReportRow -Step 'Resolve Principal' -Status 'SUCCESS' -Detail (ConvertTo-JsonSafe $resolved)
            return $resolved
        }
    }

    throw ("No usable role UID could be resolved for '{0}'." -f $Principal)
}

function Import-AppFromTemplate {
    param([Parameter(Mandatory)][string]$ResolvedTemplateId)
    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/ImportAppFromTemplate'
    $body = @{ ID = @($ResolvedTemplateId) }
    $resp = Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'ImportAppFromTemplate'

    if (-not $resp.success) { throw ('ImportAppFromTemplate returned success=false: ' + ($resp.Message | Out-String)) }
    $resultItems = @($resp.Result)
    if ($resultItems.Count -lt 1) { throw 'ImportAppFromTemplate returned no result items.' }

    $first = $resultItems[0]
    if ((Get-DirectField -Object $first -FieldName 'success') -ne $true) {
        $idVal = [string](Get-DirectField -Object $first -FieldName 'ID')
        $msg = [string](Get-DirectField -Object $first -FieldName 'Message')
        throw ("ImportAppFromTemplate result item failed. ID={0}; Message={1}" -f $idVal, $msg)
    }

    $rowKey = [string](Get-DirectField -Object $first -FieldName '_RowKey')
    if ([string]::IsNullOrWhiteSpace($rowKey)) { $rowKey = [string](Get-DirectField -Object $first -FieldName '_Rowkey') }
    if ([string]::IsNullOrWhiteSpace($rowKey)) { throw 'ImportAppFromTemplate did not return _RowKey.' }

    Write-Log ("Imported new application from template '{0}'. New _RowKey='{1}'." -f $ResolvedTemplateId, $rowKey) 'Green'
    Add-ReportRow -Step 'Create Application' -Status 'SUCCESS' -Detail ("TemplateID={0}; RowKey={1}" -f $ResolvedTemplateId, $rowKey)
    return $rowKey
}

function New-BaseNonScriptFields {
    param([Parameter(Mandatory)][string]$ResolvedRowKey,[Parameter(Mandatory)][string]$ResolvedName)
    $authRules = @{ _UniqueKey = 'Condition'; _Value = @(); Enabled = $true; _Type = 'RowSet' }
    $defaultAuthProfileInfo = @{ Uuid = $DefaultAuthProfileUuid }

    return [ordered]@{
        _Rowkey                = $ResolvedRowKey
        Name                   = $ResolvedName
        DisplayName            = $DisplayName
        Category               = $Category
        DefaultAuthProfileInfo = $defaultAuthProfileInfo
        OnPrem                 = $OnPrem
        IsSwsEnabled           = $IsSwsEnabled
        ShowRegistration       = $ShowRegistration
        AdminTag               = $AdminTag
        UserNameStrategy       = $UserNameStrategy
        Description            = $Description
        FormFillingEnabled     = $FormFillingEnabled
        Generic                = $Generic
        AppType                = $AppType
        DefaultAuthProfile     = $DefaultAuthProfile
        IconUri                = $IconUri
        AuthRules              = $authRules
        WebAppType             = $WebAppType
        TemplateName           = $TemplateName
        Notes                  = $Notes
        LocalizationEnabled    = $LocalizationEnabled
        WebUPAppType           = $WebUPAppType
        NotSelfService         = $NotSelfService
    }
}

function New-AdvancedScriptPayloadVariants {
    param([Parameter(Mandatory)][string]$ResolvedRowKey,[Parameter(Mandatory)][string]$ResolvedName)
    $base = New-BaseNonScriptFields -ResolvedRowKey $ResolvedRowKey -ResolvedName $ResolvedName
    $variants = @()

    $v1 = [ordered]@{}
    foreach ($k in $base.Keys) { $v1[$k] = $base[$k] }
    $v1['Script'] = $AdvancedScript
    $variants += ,$v1

    $v2 = [ordered]@{}
    foreach ($k in $base.Keys) { $v2[$k] = $base[$k] }
    $v2['CBEScript'] = $AdvancedScript
    $variants += ,$v2

    return $variants
}

function Update-CurrentApplicationWithAdvancedScript {
    param([Parameter(Mandatory)][string]$ResolvedRowKey,[Parameter(Mandatory)][string]$ResolvedName)
    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/UpdateApplicationDE'
    $variants = New-AdvancedScriptPayloadVariants -ResolvedRowKey $ResolvedRowKey -ResolvedName $ResolvedName

    $variantNumber = 0
    foreach ($payload in $variants) {
        $variantNumber++
        try {
            Write-Log ("Trying UpdateApplicationDE advanced-script payload variant #{0}..." -f $variantNumber) 'Gray'
            $resp = Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $payload -LogicalName 'UpdateApplicationDE'
            if ((Get-DirectField -Object $resp -FieldName 'success') -ne $true) {
                $msg = [string](Get-DirectField -Object $resp -FieldName 'Message')
                throw ("UpdateApplicationDE returned success=false. Message={0}" -f $msg)
            }
            Write-Log ("UpdateApplicationDE succeeded on advanced-script payload variant #{0}." -f $variantNumber) 'Green'
            Add-ReportRow -Step 'Update Application' -Status 'SUCCESS' -Detail ("RowKey={0}; Variant={1}" -f $ResolvedRowKey, $variantNumber)
            return
        } catch {
            Write-Log ("Advanced-script payload variant #{0} failed: {1}" -f $variantNumber, $_.Exception.Message) 'Yellow'
        }
    }
    throw 'All UpdateApplicationDE advanced-script payload variants failed.'
}

function New-SetPermissionBodies {
    param([Parameter(Mandatory)][string]$ResolvedRowKey,[Parameter(Mandatory)]$ResolvedPrincipal)

    $rightsVariants = @(
        'View,Run,Automatically Deploy',
        'View,Run,AutomaticallyDeploy'
    )

    $bodies = @()
    foreach ($rights in $rightsVariants) {
        $grant = [ordered]@{
            Rights      = $rights
            Principal   = $ResolvedPrincipal.Principal
            Type        = $ResolvedPrincipal.PrincipalType
            PrincipalId = $ResolvedPrincipal.PrincipalId
            PType       = $ResolvedPrincipal.PrincipalType
        }

        $bodies += ,([ordered]@{
            RowKey = $ResolvedRowKey
            ID     = $ResolvedRowKey
            Grants = $grant
        })

        $bodies += ,([ordered]@{
            RowKey = $ResolvedRowKey
            ID     = $ResolvedRowKey
            Grants = @($grant)
        })
    }

    return $bodies
}

function Set-ApplicationPermissionsResolved {
    param([Parameter(Mandatory)][string]$ResolvedRowKey,[Parameter(Mandatory)]$ResolvedPrincipal)
    $uri = $IdentityApiTenantURL.TrimEnd('/') + '/SaasManage/SetApplicationPermissions'
    $bodies = New-SetPermissionBodies -ResolvedRowKey $ResolvedRowKey -ResolvedPrincipal $ResolvedPrincipal

    $variantNumber = 0
    foreach ($body in $bodies) {
        $variantNumber++
        try {
            Write-Log ("Trying SetApplicationPermissions payload variant #{0}..." -f $variantNumber) 'Gray'
            $resp = Invoke-IdentityRequestWithRetry -AbsoluteUris @($uri) -Body $body -LogicalName 'SetApplicationPermissions'
            $success = Get-DirectField -Object $resp -FieldName 'success'
            if ($success -eq $false) {
                $msg = [string](Get-DirectField -Object $resp -FieldName 'Message')
                throw ("SetApplicationPermissions returned success=false. Message={0}" -f $msg)
            }
            Write-Log ("SetApplicationPermissions succeeded on payload variant #{0}." -f $variantNumber) 'Green'
            Add-ReportRow -Step 'Assign Permissions' -Status 'SUCCESS' -Detail ("RowKey={0}; Principal={1}; PrincipalId={2}; Type={3}; Variant={4}" -f $ResolvedRowKey, $ResolvedPrincipal.Principal, $ResolvedPrincipal.PrincipalId, $ResolvedPrincipal.PrincipalType, $variantNumber)
            return
        } catch {
            Write-Log ("SetApplicationPermissions payload variant #{0} failed: {1}" -f $variantNumber, $_.Exception.Message) 'Yellow'
        }
    }
    throw 'All SetApplicationPermissions payload variants failed.'
}

function Invoke-EventuallyConsistentStep {
    param([Parameter(Mandatory)][scriptblock]$Operation,[Parameter(Mandatory)][string]$OperationName,[Parameter(Mandatory)][int]$MaxWaitSeconds,[int]$IntervalSeconds = 15)
    $deadline = (Get-Date).AddSeconds($MaxWaitSeconds)
    $attempt = 0
    $lastMessage = $null

    while ((Get-Date) -lt $deadline) {
        $attempt++
        try {
            Write-Log ("{0} attempt #{1}..." -f $OperationName, $attempt) 'Gray'
            & $Operation
            Write-Log ("{0} succeeded on attempt #{1}." -f $OperationName, $attempt) 'Green'
            return
        } catch {
            $lastMessage = $_.Exception.Message
            Write-Log ("{0} not ready yet on attempt #{1}. Retrying in {2}s. Remaining window: {3}s. Last error: {4}" -f $OperationName, $attempt, $IntervalSeconds, [int][Math]::Max(0, ($deadline - (Get-Date)).TotalSeconds), $lastMessage) 'Yellow'
            Start-Sleep -Seconds $IntervalSeconds
        }
    }

    throw ("{0} did not succeed within {1} seconds. Last error: {2}" -f $OperationName, $MaxWaitSeconds, $lastMessage)
}

function Invoke-CreatePhase {
    param([Parameter(Mandatory)][string]$ResolvedTemplateId)
    Start-IdentityRegularUserSession
    return (Import-AppFromTemplate -ResolvedTemplateId $ResolvedTemplateId)
}

function Invoke-UpdatePhase {
    param([Parameter(Mandatory)][string]$CreatedRowKey,[Parameter(Mandatory)][string]$ResolvedName)
    $attempt = 0
    while ($attempt -lt $MaxPhaseReauthAttempts) {
        $attempt++
        try {
            Write-Log ("Starting update phase with fresh Identity session (attempt {0}/{1})..." -f $attempt, $MaxPhaseReauthAttempts) 'Cyan'
            Reset-IdentitySessionState
            Start-IdentityRegularUserSession
            Invoke-EventuallyConsistentStep -Operation {
                Update-CurrentApplicationWithAdvancedScript -ResolvedRowKey $CreatedRowKey -ResolvedName $ResolvedName
            } -OperationName 'UpdateApplicationDE' -MaxWaitSeconds $UpdateRetryWindowSeconds -IntervalSeconds $RetryIntervalSeconds
            return
        } catch {
            $msg = $_.Exception.Message
            Write-Log ("Update phase attempt {0} failed: {1}" -f $attempt, $msg) 'Yellow'
            if ($attempt -ge $MaxPhaseReauthAttempts) { throw }
            Start-Sleep -Seconds $RetryIntervalSeconds
        }
    }
}

function Invoke-PermissionPhase {
    param([Parameter(Mandatory)][string]$CreatedRowKey,[Parameter(Mandatory)][string]$ResolvedPrincipalText,[Parameter(Mandatory)][string]$ResolvedPrincipalType)
    $attempt = 0
    while ($attempt -lt $MaxPhaseReauthAttempts) {
        $attempt++
        try {
            Write-Log ("Starting permission phase with fresh Identity session (attempt {0}/{1})..." -f $attempt, $MaxPhaseReauthAttempts) 'Cyan'
            Reset-IdentitySessionState
            Start-IdentityRegularUserSession

            $resolvedAgain = Resolve-IdentityPrincipal -Principal $ResolvedPrincipalText -PrincipalType $ResolvedPrincipalType

            Invoke-EventuallyConsistentStep -Operation {
                Set-ApplicationPermissionsResolved -ResolvedRowKey $CreatedRowKey -ResolvedPrincipal $resolvedAgain
            } -OperationName 'SetApplicationPermissions' -MaxWaitSeconds $PermissionRetryWindowSeconds -IntervalSeconds $RetryIntervalSeconds
            return
        } catch {
            $msg = $_.Exception.Message
            Write-Log ("Permission phase attempt {0} failed: {1}" -f $attempt, $msg) 'Yellow'
            if ($attempt -ge $MaxPhaseReauthAttempts) { throw }
            Start-Sleep -Seconds $RetryIntervalSeconds
        }
    }
}

$createdAppRowKey = $null
$resolvedName = $null
$resolvedPrincipalText = $null
$resolvedPrincipalType = $null

try {
    if ([string]::IsNullOrWhiteSpace($TemplateId)) { throw 'TemplateId cannot be empty.' }

    Prompt-ForRegularCredential
    $resolvedName = Get-ResolvedAppName
    $resolvedPrincipalText = Get-ResolvedPermissionPrincipal
    $resolvedPrincipalType = Get-ResolvedPermissionType

    Write-Log ("Using credential '{0}' for create + update + permission flow." -f $script:RegularCredential.UserName) 'Cyan'
    Write-Log ("Resolved app Name: '{0}'." -f $resolvedName) 'Cyan'
    Write-Log ("Resolved permission target text: '{0}' ({1})." -f $resolvedPrincipalText, $resolvedPrincipalType) 'Cyan'
    Add-ReportRow -Step 'Credential Source' -Status 'SUCCESS' -Detail ("Manual user {0}" -f $script:RegularCredential.UserName)
    Add-ReportRow -Step 'Resolved App Name' -Status 'INFO' -Detail ("Name={0}" -f $resolvedName)
    Add-ReportRow -Step 'Resolved Permission Target' -Status 'INFO' -Detail ("Principal={0}; Type={1}" -f $resolvedPrincipalText, $resolvedPrincipalType)

    $createdAppRowKey = Invoke-CreatePhase -ResolvedTemplateId $TemplateId

    Write-Log ("Waiting {0} second(s) before starting update phase..." -f $PreUpdateDelaySeconds) 'Yellow'
    Start-Sleep -Seconds $PreUpdateDelaySeconds

    Invoke-UpdatePhase -CreatedRowKey $createdAppRowKey -ResolvedName $resolvedName
    Invoke-PermissionPhase -CreatedRowKey $createdAppRowKey -ResolvedPrincipalText $resolvedPrincipalText -ResolvedPrincipalType $resolvedPrincipalType

    Write-Log ("Create + update + permission completed successfully. Created app row key is '{0}'." -f $createdAppRowKey) 'Green'
    Add-ReportRow -Step 'Overall' -Status 'SUCCESS' -Detail ("CreatedRowKey={0}; FinalName={1}; Principal={2}; Type={3}" -f $createdAppRowKey, $resolvedName, $resolvedPrincipalText, $resolvedPrincipalType)
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) 'Red'
    Add-ReportRow -Step 'Overall' -Status 'FAILED' -Detail $_.Exception.Message
}
finally {
    try {
        $csvDir = Split-Path -Path $ReportCsvPath -Parent
        if ($csvDir -and -not (Test-Path $csvDir)) {
            New-Item -Path $csvDir -ItemType Directory -Force | Out-Null
        }

        if ($script:ReportRows.Count -gt 0) {
            $script:ReportRows | Export-Csv -Path $ReportCsvPath -NoTypeInformation -Force
            Write-Log ("Report exported: {0}" -f $ReportCsvPath) 'Green'
        }
    } catch {
        Write-Log ("Could not export report CSV: {0}" -f $_.Exception.Message) 'Yellow'
    }
}
