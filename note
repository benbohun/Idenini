<#
.SYNOPSIS
  Test CyberArk Identity → Privilege Cloud authentication via psPAS

.DESCRIPTION
  - Prompts for Identity username/password
  - Uses New-PASSession with IdentityTenantURL + PrivilegeCloudURL
  - Prints whether authentication succeeded and dumps basic session info

.REQUIREMENTS
  - psPAS module installed (and IdentityCommand module as per psPAS docs)
  - Network access to Identity & Privilege Cloud endpoints
#>

Clear-Host

Write-Host "==============================================" -ForegroundColor Cyan
Write-Host "   CyberArk Identity → Privilege Cloud Login Test" -ForegroundColor Cyan
Write-Host "==============================================" -ForegroundColor Cyan
Write-Host ""

# ==========================
# CONFIG – EDIT THESE
# ==========================
# Your tenant URLs
$IdentityTenantURL = "https://aap4748.id.cyberark.cloud"             # Identity portal
$PrivilegeCloudURL = "https://alliant-test.privilegecloud.cyberark.cloud"  # Priv Cloud URL

Write-Host "[INFO] IdentityTenantURL  : $IdentityTenantURL"  -ForegroundColor DarkCyan
Write-Host "[INFO] PrivilegeCloudURL : $PrivilegeCloudURL"   -ForegroundColor DarkCyan
Write-Host ""

# ==========================
# PROMPT FOR CREDENTIALS
# ==========================
Write-Host "Enter CyberArk Identity user (UPN), e.g. user@company.com" -ForegroundColor Yellow
$cred = Get-Credential -Message "CyberArk Identity user credentials"

if (-not $cred -or [string]::IsNullOrWhiteSpace($cred.UserName)) {
    Write-Host "[ERROR] No credentials provided. Exiting." -ForegroundColor Red
    exit 1
}

# ==========================
# IMPORT MODULE(S)
# ==========================
try {
    Write-Host "`n[+] Importing psPAS module..." -ForegroundColor Yellow
    Import-Module psPAS -ErrorAction Stop
    Write-Host "[OK] psPAS module imported." -ForegroundColor Green
}
catch {
    Write-Host "[ERROR] Failed to import psPAS module: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}

# psPAS docs note that Privilege Cloud Shared Services auth flows
# require the IdentityCommand module as well. Install/Import if needed:
#   Install-Module IdentityCommand
#   Import-Module IdentityCommand

# ==========================
# AUTHENTICATE VIA IDENTITY
# ==========================
try {
    Write-Host "`n[+] Requesting session using Identity + Privilege Cloud..." -ForegroundColor Yellow
    Write-Host "    IdentityTenantURL : $IdentityTenantURL"  -ForegroundColor DarkGray
    Write-Host "    PrivilegeCloudURL: $PrivilegeCloudURL"   -ForegroundColor DarkGray
    Write-Host ""

    # Identity User flow (per psPAS docs)
    # https://pspas.pspete.dev/docs/authentication/#shared-services-authentication
    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $cred `
        -IdentityUser `
        -ErrorAction Stop | Out-Null

    # Validate session
    $session = Get-PASSession

    if ($session) {
        Write-Host "`n==============================================" -ForegroundColor Green
        Write-Host " ✅ Authentication SUCCESSFUL" -ForegroundColor Green
        Write-Host "==============================================" -ForegroundColor Green

        # Try to show logged-on user info (if supported)
        try {
            $user = Get-PASLoggedOnUser -ErrorAction SilentlyContinue
            if ($user) {
                Write-Host "`n[Session Info]" -ForegroundColor Cyan
                $user | Format-Table UserName, Source, UserTypeName, Expired, Disabled, Suspended -AutoSize
            } else {
                Write-Host "[INFO] Session established, but Get-PASLoggedOnUser returned no data (this can be normal in some Shared Services flows)." -ForegroundColor DarkYellow
            }
        }
        catch {
            Write-Host "[WARN] Session established, but failed to query Get-PASLoggedOnUser: $($_.Exception.Message)" -ForegroundColor DarkYellow
        }

        # Dump raw session object for deeper debugging if you like
        Write-Host "`n[Raw PASSession object]" -ForegroundColor DarkCyan
        $session | Format-List * | Out-String | Write-Host
    }
    else {
        Write-Host "`n==============================================" -ForegroundColor Red
        Write-Host " ❌ Authentication FAILED – Get-PASSession returned `$null." -ForegroundColor Red
        Write-Host "==============================================" -ForegroundColor Red
        exit 1
    }
}
catch {
    Write-Host "`n==============================================" -ForegroundColor Red
    Write-Host " ❌ Authentication FAILED with exception" -ForegroundColor Red
    Write-Host "----------------------------------------------" -ForegroundColor Red
    Write-Host ("Type   : {0}" -f $_.Exception.GetType().FullName) -ForegroundColor Red
    Write-Host ("Message: {0}" -f $_.Exception.Message)          -ForegroundColor Red
    Write-Host "==============================================" -ForegroundColor Red
    exit 1
}

Write-Host "`n[Done] Identity login test completed." -ForegroundColor Cyan
