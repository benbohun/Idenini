# -------------------------------
# CyberArk Safe Provision Script
# - Creates Safe via PVWA REST
# - Adds Target AD Group via psPAS (fallback to REST)
# - Adds Existing Admin Members via REST (unchanged)
# -------------------------------

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    Write-Host $LogEntry -ForegroundColor $Color
    try { Add-Content -Path $LogPath -Value $LogEntry -ErrorAction SilentlyContinue } catch {}
}

# --- Retrieve CyberArk API Credentials from CCP ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safe       = "CA_PCloud_Admins"
$object     = "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"

$headers = New-Object "System.Collections.Generic.Dictionary[[String],[String]]"
$headers.Add("Content-Type", "application/json")
$windowsAuth = $false

Write-Log "Retrieving CyberArk API credentials from CCP via Object method..." "Cyan"
$ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object"
try {
    $response = Invoke-RestMethod $ccpUrl -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response -or -not $response.Username -or -not $response.Content) {
        Write-Log "ERROR: Failed to retrieve API credentials from CCP." "Red"
        exit 1
    }
    Write-Log "Successfully retrieved credentials for user: $($response.Username)" "Green"
} catch {
    Write-Log "ERROR: CCP credential fetch failed - $_" "Red"
    exit 1
}

# --- Prompt for Safe Name & Description ---
$SafeName = Read-Host "Enter the Safe Name"
# single-line input up to ~200 chars as requested
$Description = Read-Host "Paste the Safe Description (single box, up to ~200 chars)"

if ([string]::IsNullOrWhiteSpace($SafeName)) {
    Write-Log "❌ ERROR: Safe Name cannot be empty. Exiting..." "Red"
    exit
}
if ([string]::IsNullOrWhiteSpace($Description)) {
    Write-Log "❌ ERROR: Safe Description cannot be empty. Exiting..." "Red"
    exit
}

# --- Authentication Variables (from CCP) ---
$IdentityTenantID = "aat4012"       # CyberArk Identity tenant ID
$PCloudSubdomain  = "cna-prod"      # CyberArk Privilege Cloud subdomain
$ClientID         = $response.Username
$ClientSecret     = $response.Content

if ([string]::IsNullOrEmpty($ClientID) -or [string]::IsNullOrEmpty($ClientSecret)) {
    Write-Log "ERROR: Client ID or Client Secret is missing. Exiting..." "Red"
    exit
}

# --- Request OAuth Token ---
Write-Log "Requesting initial CyberArk ISPSS token..." "Cyan"
$TokenURL = "https://$IdentityTenantID.id.cyberark.cloud/oauth2/platformtoken"
$TokenBody = @{
    grant_type    = "client_credentials"
    client_id     = $ClientID
    client_secret = $ClientSecret
}
$headers_token = @{
    "Content-Type" = "application/x-www-form-urlencoded"
}

try {
    $TokenResponse = Invoke-RestMethod -Uri $TokenURL -Method Post -Headers $headers_token -Body $TokenBody
    $BearerToken = [string]$TokenResponse.access_token
    if ([string]::IsNullOrEmpty($BearerToken) -or $BearerToken.Length -lt 100) {
        Write-Log "ERROR: Received an invalid token. Length: $($BearerToken.Length)" "Red"
        exit
    }
    Write-Log "✅ Authentication successful, token obtained." "Green"
} catch {
    Write-Log "ERROR: Failed to authenticate with CyberArk ISPSS. $_" "Red"
    exit
}

# --- Define Headers for PVWA REST ---
$headers_api = @{
    "Authorization" = "Bearer $BearerToken"
    "Content-Type"  = "application/json"
}

# --- Create Safe Using PVWA REST ---
$APIBase        = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault/API"
$SafesEndpoint  = "$APIBase/Safes/"
$MembersBase    = "$APIBase/Safes/$SafeName/Members"

Write-Log "🔹 Creating Safe: ${SafeName}..." "Cyan"

$SafePayload = @{
    "safeName"              = $SafeName
    "description"           = $Description
    "olacEnabled"           = $false
    "autoPurgeEnabled"      = $false
    "managingCPM"           = "CNA_PASS_MANG"
    "numberOfDaysRetention" = 180
} | ConvertTo-Json -Depth 5

Write-Log "Creating Safe: ${SafeName} with payload: $SafePayload" "DarkGray"

try {
    $null = Invoke-RestMethod -Uri $SafesEndpoint -Method Post -Headers $headers_api -Body $SafePayload -ErrorAction Stop
    Write-Log "✅ Successfully created Safe: ${SafeName}." "Green"
} catch {
    Write-Log "❌ ERROR: Failed to create Safe: ${SafeName} - $_" "Red"
    exit
}

# --- Permission Sets (REST expects camelCase; psPAS expects PascalCase) ---
$LimitedPermissions_REST = @{
    "useAccounts" = $false
    "retrieveAccounts" = $false
    "listAccounts" = $true
    "addAccounts" = $false
    "updateAccountContent" = $false
    "updateAccountProperties" = $false
    "initiateCPMAccountManagementOperations" = $true
    "specifyNextAccountContent" = $false
    "renameAccounts" = $false
    "deleteAccounts" = $false
    "unlockAccounts" = $true
    "manageSafe" = $false
    "manageSafeMembers" = $false
    "backupSafe" = $false
    "viewAuditLog" = $true
    "viewSafeMembers" = $true
    "accessWithoutConfirmation" = $true
    "createFolders" = $false
    "deleteFolders" = $false
    "moveAccountsAndFolders" = $false
    "requestsAuthorizationLevel1" = $true
    "requestsAuthorizationLevel2" = $false
}
$FullPermissions_REST = @{
    "useAccounts" = $true
    "retrieveAccounts" = $true
    "listAccounts" = $true
    "addAccounts" = $true
    "updateAccountContent" = $true
    "updateAccountProperties" = $true
    "initiateCPMAccountManagementOperations" = $true
    "specifyNextAccountContent" = $true
    "renameAccounts" = $true
    "deleteAccounts" = $true
    "unlockAccounts" = $true
    "manageSafe" = $true
    "manageSafeMembers" = $true
    "backupSafe" = $true
    "viewAuditLog" = $true
    "viewSafeMembers" = $true
    "accessWithoutConfirmation" = $true
    "createFolders" = $true
    "deleteFolders" = $true
    "moveAccountsAndFolders" = $true
    "requestsAuthorizationLevel1" = $true
    "requestsAuthorizationLevel2" = $false
}
# psPAS permission object (PascalCase keys)
$LimitedPermissions_psPAS = [PSCustomObject]@{
    UseAccounts                            = $false
    RetrieveAccounts                       = $false
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $false
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $false
    RenameAccounts                         = $false
    DeleteAccounts                         = $false
    UnlockAccounts                         = $true
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
}

# --- Prompt for Target AD Group (sAMAccountName only) ---
do {
    $GroupSam = Read-Host "Enter the AD Safe Group (sAMAccountName only, e.g., ca_bud_ecf_prod)"
    if ([string]::IsNullOrWhiteSpace($GroupSam)) {
        Write-Log "❌ Group sAMAccountName cannot be empty. Please re-enter." "Red"
    }
} until (-not [string]::IsNullOrWhiteSpace($GroupSam))

$TargetGroupUPN = "$GroupSam@cna.com"

# --- Try psPAS for Target AD Group (uses Directory Mapping; no SearchIn param) ---
$DidAddTargetGroup = $false
$PVWA_BaseUri = "https://$PCloudSubdomain.privilegecloud.cyberark.cloud/PasswordVault"

Write-Log "Adding AD Group '${TargetGroupUPN}' via psPAS Add-PASSafeMember..." "Cyan"
try {
    Import-Module psPAS -ErrorAction Stop
    # Try to establish a session. Some psPAS versions support bearer-style usage; if not, this will throw and we will fall back to REST.
    try {
        # Attempt to seed the base URL; if your psPAS supports token-based use, this will be enough for subsequent calls.
        Set-PASSessionOption -BaseURI $PVWA_BaseUri -ErrorAction SilentlyContinue | Out-Null
    } catch {}

    # Try calling Add-PASSafeMember directly; if session/base URI isn’t set, psPAS will throw the familiar “Invalid URI…” message.
    $LimitedPermissions_psPAS | Add-PASSafeMember -SafeName $SafeName -MemberType Group -MemberName $TargetGroupUPN -ErrorAction Stop | Out-Null

    # Verify
    $members = Get-PASSafeMember -SafeName $SafeName -ErrorAction SilentlyContinue
    if ($members -and ($members.Username -contains $TargetGroupUPN)) {
        Write-Log "✅ Added AD Group via psPAS: ${TargetGroupUPN}." "Green"
        $DidAddTargetGroup = $true
    } else {
        Write-Log "⚠️ psPAS did not confirm membership for ${TargetGroupUPN}; will fall back to REST." "Yellow"
    }
} catch {
    Write-Log "⚠️ psPAS add/set failed for '${TargetGroupUPN}' ($($_.Exception.Message)). Will fall back to REST." "Yellow"
}

# --- Fallback: PVWA REST for Target AD Group (Directory; no GUID) ---
if (-not $DidAddTargetGroup) {
    try {
        Write-Log "Attempting AD Group add via REST (MemberName='${TargetGroupUPN}', SearchIn='Directory')..." "Cyan"
        $bodyTarget = @{
            MemberName  = $TargetGroupUPN
            MemberType  = "Group"
            SearchIn    = "Directory"    # rely on PVWA Directory Mapping to OU=Groups,OU=CyberArk,DC=cna,DC=com
            Permissions = $LimitedPermissions_REST
        } | ConvertTo-Json -Depth 6

        $null = Invoke-RestMethod -Uri $MembersBase -Method Post -Headers $headers_api -Body $bodyTarget -ErrorAction Stop
        Write-Log "✅ Added AD Group via REST: ${TargetGroupUPN}." "Green"
        $DidAddTargetGroup = $true
    } catch {
        Write-Log "❌ Failed to add '${TargetGroupUPN}' via REST - $($_.Exception.Message)" "Red"
        Write-Log "This typically indicates PVWA Directory Mapping cannot resolve the group from OU=Groups,OU=CyberArk,DC=cna,DC=com." "Yellow"
    }
}

# --- Add Existing Admin Members (UNCHANGED) via REST ---
# 1) CA_PCloud_Admins@cna.com (Group) with FULL permissions, SearchIn Directory
try {
    Write-Log "Adding Group: CA_PCloud_Admins@cna.com to ${SafeName} (Directory)..." "Cyan"
    $adminGroupBody = @{
        MemberName  = "CA_PCloud_Admins@cna.com"
        MemberType  = "Group"
        SearchIn    = "Directory"
        Permissions = $FullPermissions_REST
    } | ConvertTo-Json -Depth 6
    $null = Invoke-RestMethod -Uri $MembersBase -Method Post -Headers $headers_api -Body $adminGroupBody -ErrorAction Stop
    Write-Log "✅ Added Group: CA_PCloud_Admins@cna.com." "Green"
} catch {
    Write-Log "❌ Failed to add 'CA_PCloud_Admins@cna.com' - $($_.Exception.Message)" "Red"
}

# 2) cna_pas_admin@cyberark.cloud.6679 (Vault user) with FULL permissions
try {
    Write-Log "Adding User: cna_pas_admin@cyberark.cloud.6679 to ${SafeName} (Vault)..." "Cyan"
    $adminUserBody = @{
        MemberName  = "cna_pas_admin@cyberark.cloud.6679"
        MemberType  = "User"
        SearchIn    = "Vault"
        Permissions = $FullPermissions_REST
    } | ConvertTo-Json -Depth 6
    $null = Invoke-RestMethod -Uri $MembersBase -Method Post -Headers $headers_api -Body $adminUserBody -ErrorAction Stop
    Write-Log "✅ Added User: cna_pas_admin@cyberark.cloud.6679." "Green"
} catch {
    Write-Log "❌ Failed to add 'cna_pas_admin@cyberark.cloud.6679' - $($_.Exception.Message)" "Red"
}

Write-Log "🔹 Safe member addition process completed." "Cyan"
