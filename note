<#
.SYNOPSIS
    Clears cached SSH host-key fingerprints on a CyberArk CPM for targets
    identified as MATCHED by Find-CyberArk-SSHFingerprintMismatch-v3.ps1.

.DESCRIPTION
    Run this script LOCALLY ON THE CPM SERVER, elevated as Administrator.

    It reads the discovery CSV and processes ONLY rows where:
        DetectionState = MATCHED

    For each unique target Address it searches all currently loaded user hives
    under HKEY_USERS for registry values whose NAME contains the exact SSH host
    key token used by CyberArk/Expect.NET, for example:

        ssh-rsa@22:10.128.6.104
        ecdsa-sha2-nistp256@22:10.128.6.101

    It also searches for any value name ending with:
        @22:<target IP>

    Before removing anything, the containing registry key is exported to a
    .reg backup file.

    It deletes ONLY the matching registry VALUE. It does not delete the parent
    registry key and does not clear unrelated SSH fingerprints.

    IMPORTANT:
      - Validate that the target firewalls legitimately changed SSH host keys.
      - This script does not disable fingerprint validation.
      - It does not restart the CPM service.
      - If no matching registry value is found, the result is NOT_FOUND and
        nothing is deleted.

.REQUIREMENTS
    Windows PowerShell 5.1
    Run as Administrator on the CPM server.

.EXAMPLE
    Edit $CsvPath below, then:

        .\Clear-CPM-PaloAltoFingerprintMismatch.ps1

    Dry run:

        .\Clear-CPM-PaloAltoFingerprintMismatch.ps1 -WhatIf
#>

[CmdletBinding(SupportsShouldProcess=$true, ConfirmImpact='High')]
param(
    # =====================================================================
    # EDIT THIS PATH
    # This is the CSV generated by Find-CyberArk-SSHFingerprintMismatch-v3.ps1
    # =====================================================================
    [string]$CsvPath = "C:\Temp\CyberArk-SSHFingerprintMismatch.csv",

    # SSH port used by the Palo Alto platform
    [int]$Port = 22,

    # Backup and result locations
    [string]$BackupRoot = "C:\Temp\CyberArk-SSH-Fingerprint-Backup",
    [string]$ReportPath = "C:\Temp\CyberArk-SSH-Fingerprint-Cleanup.csv"
)

$ErrorActionPreference = 'Stop'

function Write-Info { param([string]$m) Write-Host "[INFO] $m" -ForegroundColor Cyan }
function Write-Ok   { param([string]$m) Write-Host "[ OK ] $m" -ForegroundColor Green }
function Write-Warn { param([string]$m) Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Write-Err  { param([string]$m) Write-Host "[FAIL] $m" -ForegroundColor Red }

function Test-IsAdministrator {
    $identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)

    return $principal.IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator
    )
}

function Convert-ToRegExePath {
    param([Parameter(Mandatory)][string]$RegistryPath)

    $p = $RegistryPath
    $p = $p -replace '^Microsoft\.PowerShell\.Core\\Registry::', ''
    $p = $p -replace '^Registry::', ''

    if ($p -match '^HKEY_USERS\\') {
        return ($p -replace '^HKEY_USERS', 'HKU')
    }

    if ($p -match '^HKEY_LOCAL_MACHINE\\') {
        return ($p -replace '^HKEY_LOCAL_MACHINE', 'HKLM')
    }

    if ($p -match '^HKEY_CURRENT_USER\\') {
        return ($p -replace '^HKEY_CURRENT_USER', 'HKCU')
    }

    return $p
}

function Convert-ToSafeFileName {
    param([Parameter(Mandatory)][string]$Value)

    return ($Value -replace '[\\/:*?"<>|]', '_')
}

function Export-RegistryKeyBackup {
    param(
        [Parameter(Mandatory)][string]$RegistryPath,
        [Parameter(Mandatory)][string]$BackupDirectory
    )

    if (-not (Test-Path -LiteralPath $BackupDirectory)) {
        New-Item `
            -ItemType Directory `
            -Path $BackupDirectory `
            -Force | Out-Null
    }

    $regPath = Convert-ToRegExePath -RegistryPath $RegistryPath
    $name    = Convert-ToSafeFileName -Value $regPath
    $file    = Join-Path $BackupDirectory ($name + '.reg')

    if (-not (Test-Path -LiteralPath $file)) {
        & "$env:SystemRoot\System32\reg.exe" export `
            "$regPath" `
            "$file" `
            /y | Out-Null

        if ($LASTEXITCODE -ne 0 -or
            -not (Test-Path -LiteralPath $file)) {

            throw "Registry export failed for '$regPath'. ExitCode=$LASTEXITCODE"
        }
    }

    return $file
}

function Get-FingerprintAlgorithmFromEvidence {
    param([string]$Evidence)

    if ([string]::IsNullOrWhiteSpace($Evidence)) {
        return ''
    }

    # The CSV may contain escaped JSON text. These regexes still capture
    # the actual host-key algorithm.
    if ($Evidence -match "(?i)(ecdsa-sha2-[A-Za-z0-9_-]+)@(\d+):") {
        return $Matches[1]
    }

    if ($Evidence -match "(?i)(ssh-rsa)@(\d+):") {
        return $Matches[1]
    }

    if ($Evidence -match "(?i)(ssh-ed25519)@(\d+):") {
        return $Matches[1]
    }

    if ($Evidence -match "(?i)(rsa2)@(\d+):") {
        return $Matches[1]
    }

    return ''
}

function Get-LoadedRegistryProfiles {
    $profiles = New-Object System.Collections.Generic.List[object]

    foreach ($hive in @(Get-ChildItem Registry::HKEY_USERS -ErrorAction SilentlyContinue)) {

        $sid = [string]$hive.PSChildName

        # Skip SID *_Classes hives because their corresponding principal hive
        # is searched separately.
        if ($sid -like '*_Classes') {
            continue
        }

        $software = "Registry::HKEY_USERS\$sid\Software"

        if (Test-Path -LiteralPath $software) {
            $profiles.Add([pscustomobject]@{
                SID          = $sid
                SoftwarePath = $software
            }) | Out-Null
        }
    }

    return $profiles.ToArray()
}

function Get-CandidateRegistryRoots {
    param(
        [Parameter(Mandatory)][string]$SoftwarePath
    )

    # Search likely locations first.
    $preferred = @(
        "$SoftwarePath\SimonTatham\PuTTY\SshHostKeys",
        "$SoftwarePath\CyberArk",
        "$SoftwarePath\Expect.NET",
        "$SoftwarePath\Renci"
    )

    $found = New-Object System.Collections.Generic.List[string]

    foreach ($path in $preferred) {
        if (Test-Path -LiteralPath $path) {
            $found.Add($path) | Out-Null
        }
    }

    # CyberArk/Expect.NET registry layout can differ by release and execution
    # identity. If none of the preferred roots exist, scan that profile's
    # Software branch rather than assuming the value is absent.
    if ($found.Count -eq 0) {
        $found.Add($SoftwarePath) | Out-Null
    }

    return $found.ToArray()
}

function Find-FingerprintRegistryValues {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Address,
        [Parameter(Mandatory)][int]$Port,
        [string]$ExpectedAlgorithm = ''
    )

    $results = New-Object System.Collections.Generic.List[object]
    $escapedAddress = [regex]::Escape($Address)
    $escapedPort    = [regex]::Escape([string]$Port)

    # Matches any host-key algorithm for the exact target:
    #   ssh-rsa@22:10.128.6.104
    #   ecdsa-sha2-nistp256@22:10.128.6.101
    #   rsa2@22:10.128.6.104
    $targetPattern = "(?i)@${escapedPort}:${escapedAddress}$"

    foreach ($profile in @(Get-LoadedRegistryProfiles)) {

        $roots = @(Get-CandidateRegistryRoots `
            -SoftwarePath $profile.SoftwarePath)

        $visited = @{}

        foreach ($root in $roots) {

            $keys = @()

            try {
                $keys += @(Get-Item `
                    -LiteralPath $root `
                    -ErrorAction Stop)

                $keys += @(Get-ChildItem `
                    -LiteralPath $root `
                    -Recurse `
                    -ErrorAction SilentlyContinue)
            }
            catch {
                continue
            }

            foreach ($key in $keys) {

                if ($visited.ContainsKey($key.PSPath)) {
                    continue
                }

                $visited[$key.PSPath] = $true

                try {
                    $regKey = Get-Item `
                        -LiteralPath $key.PSPath `
                        -ErrorAction Stop

                    foreach ($valueName in $regKey.GetValueNames()) {

                        if ([string]::IsNullOrWhiteSpace($valueName)) {
                            continue
                        }

                        if ($valueName -notmatch $targetPattern) {
                            continue
                        }

                        $algorithm = ''

                        if ($valueName -match '^(?<alg>.+)@\d+:') {
                            $algorithm = $Matches['alg']
                        }

                        $results.Add([pscustomobject]@{
                            Address           = $Address
                            Port              = $Port
                            ExpectedAlgorithm = $ExpectedAlgorithm
                            FoundAlgorithm    = $algorithm
                            SID               = $profile.SID
                            RegistryPath      = $regKey.PSPath
                            ValueName         = $valueName
                        }) | Out-Null
                    }
                }
                catch {
                    # Some registry branches deny read access. Continue safely.
                }
            }
        }
    }

    return $results.ToArray()
}

# =========================================================================
# MAIN
# =========================================================================

if (-not (Test-IsAdministrator)) {
    throw "Run this script from an ELEVATED Windows PowerShell 5.1 session on the CPM server."
}

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "Discovery CSV not found: $CsvPath"
}

$rows = @(Import-Csv -LiteralPath $CsvPath)

if ($rows.Count -eq 0) {
    throw "Discovery CSV contains no rows."
}

foreach ($requiredColumn in @(
    'DetectionState',
    'Address'
)) {
    if (-not $rows[0].PSObject.Properties[$requiredColumn]) {
        throw "CSV is missing required column '$requiredColumn'."
    }
}

# Process ONLY positive fingerprint matches.
$matchedRows = @(
    $rows |
    Where-Object {
        ([string]$_.DetectionState).Trim() -ieq 'MATCHED' -and
        -not [string]::IsNullOrWhiteSpace(
            ([string]$_.Address).Trim()
        )
    }
)

if ($matchedRows.Count -eq 0) {
    Write-Warn "CSV contains no DetectionState=MATCHED rows. Nothing will be changed."
    return
}

# One fingerprint is stored per target/port/algorithm, not per CyberArk account.
# Collapse duplicate accounts sharing the same target.
$targets = @(
    $matchedRows |
    Group-Object Address |
    ForEach-Object {

        $address = ([string]$_.Name).Trim()

        $evidence = (
            $_.Group |
            ForEach-Object { [string]$_.ErrorEvidence }
        ) -join ' '

        [pscustomobject]@{
            Address           = $address
            ExpectedAlgorithm = Get-FingerprintAlgorithmFromEvidence `
                -Evidence $evidence
            AccountCount      = $_.Count
            AccountIDs        = (
                $_.Group |
                ForEach-Object { [string]$_.AccountID }
            ) -join ';'
            UserNames         = (
                $_.Group |
                ForEach-Object { [string]$_.UserName }
            ) -join ';'
        }
    } |
    Sort-Object Address
)

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " CyberArk CPM SSH Fingerprint Cleanup" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Discovery CSV : $CsvPath"
Write-Host "Unique targets: $($targets.Count)"
Write-Host ""

$targets | Format-Table `
    Address,
    ExpectedAlgorithm,
    AccountCount,
    UserNames `
    -AutoSize

$timestamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$backupDirectory = Join-Path $BackupRoot $timestamp

New-Item `
    -ItemType Directory `
    -Path $backupDirectory `
    -Force | Out-Null

$report = New-Object System.Collections.Generic.List[object]

foreach ($target in $targets) {

    Write-Host ""
    Write-Info (
        "Searching for cached fingerprint: {0}@{1}:{2}" -f `
        $(if ($target.ExpectedAlgorithm) {
            $target.ExpectedAlgorithm
        } else {
            '<any-algorithm>'
        }),
        $Port,
        $target.Address
    )

    $hits = @(
        Find-FingerprintRegistryValues `
            -Address $target.Address `
            -Port $Port `
            -ExpectedAlgorithm $target.ExpectedAlgorithm
    )

    if ($hits.Count -eq 0) {

        Write-Warn "No matching loaded registry value found for $($target.Address)."

        $report.Add([pscustomobject]@{
            Address           = $target.Address
            ExpectedAlgorithm = $target.ExpectedAlgorithm
            FoundAlgorithm    = ''
            SID               = ''
            RegistryPath      = ''
            ValueName         = ''
            BackupFile        = ''
            Status            = 'NOT_FOUND'
            Error             = 'No matching value found in currently loaded HKEY_USERS profiles.'
        }) | Out-Null

        continue
    }

    foreach ($hit in $hits) {

        $backupFile = ''
        $status     = 'FAILED'
        $errorText  = ''

        try {
            Write-Info "Found: $($hit.ValueName)"
            Write-Info "Hive : $($hit.SID)"
            Write-Info "Path : $($hit.RegistryPath)"

            $backupFile = Export-RegistryKeyBackup `
                -RegistryPath $hit.RegistryPath `
                -BackupDirectory $backupDirectory

            Write-Ok "Backup: $backupFile"

            if ($PSCmdlet.ShouldProcess(
                "$($hit.RegistryPath)\$($hit.ValueName)",
                "Remove cached SSH fingerprint for $($target.Address)"
            )) {

                Remove-ItemProperty `
                    -LiteralPath $hit.RegistryPath `
                    -Name $hit.ValueName `
                    -Force `
                    -ErrorAction Stop

                # Verify that the exact value is gone.
                $verifyKey = Get-Item `
                    -LiteralPath $hit.RegistryPath `
                    -ErrorAction Stop

                if ($verifyKey.GetValueNames() -contains $hit.ValueName) {
                    throw "Registry value still exists after Remove-ItemProperty."
                }

                $status = 'REMOVED'

                Write-Ok "Removed fingerprint '$($hit.ValueName)'."
            }
            else {
                $status = 'WHATIF'
            }
        }
        catch {
            $errorText = $_.Exception.Message
            Write-Err "Cleanup failed: $errorText"
        }

        $report.Add([pscustomobject]@{
            Address           = $target.Address
            ExpectedAlgorithm = $target.ExpectedAlgorithm
            FoundAlgorithm    = $hit.FoundAlgorithm
            SID               = $hit.SID
            RegistryPath      = $hit.RegistryPath
            ValueName         = $hit.ValueName
            BackupFile        = $backupFile
            Status            = $status
            Error             = $errorText
        }) | Out-Null
    }
}

$reportDirectory = Split-Path -Parent $ReportPath

if ($reportDirectory -and
    -not (Test-Path -LiteralPath $reportDirectory)) {

    New-Item `
        -ItemType Directory `
        -Path $reportDirectory `
        -Force | Out-Null
}

$report |
    Export-Csv `
        -LiteralPath $ReportPath `
        -NoTypeInformation `
        -Encoding UTF8

$removed  = @($report | Where-Object Status -eq 'REMOVED').Count
$notFound = @($report | Where-Object Status -eq 'NOT_FOUND').Count
$failed   = @($report | Where-Object Status -eq 'FAILED').Count
$whatIf   = @($report | Where-Object Status -eq 'WHATIF').Count

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " Cleanup Complete" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "Removed   : $removed" -ForegroundColor Green
Write-Host "Not Found : $notFound" -ForegroundColor Yellow
Write-Host "Failed    : $failed" -ForegroundColor Red
Write-Host "WhatIf    : $whatIf"
Write-Host ""
Write-Host "Backup : $backupDirectory"
Write-Host "Report : $ReportPath"
Write-Host ""

if ($removed -gt 0) {
    Write-Warn "Next step: run Verify/Reconcile against the affected CyberArk accounts."
    Write-Warn "If the same fingerprint mismatch returns immediately, do not keep deleting it; confirm the host key being presented by the firewall and the CPM execution-user profile."
}
