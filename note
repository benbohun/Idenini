$Cutoff = (Get-Date).AddDays(-90)

$OldUsers = Get-LocalUser |
Where-Object {
    $_.Name -like "PSM-*" -and
    $_.LastLogon -and
    $_.LastLogon -lt $Cutoff
}

$Profiles = Get-CimInstance Win32_UserProfile

$OldUsers | ForEach-Object {

    $User = $_
    $SID  = $_.SID.Value

    $Profile = $Profiles |
        Where-Object { $_.SID -eq $SID }

    [PSCustomObject]@{
        ShadowUser   = $User.Name
        Enabled      = $User.Enabled
        LastLogon    = $User.LastLogon
        AgeDays      = [math]::Round(
            ((Get-Date) - $User.LastLogon).TotalDays
        )
        SID          = $SID
        ProfileExists = [bool]$Profile
        ProfilePath   = $Profile.LocalPath
        ProfileLoaded = $Profile.Loaded
    }
} | Sort-Object AgeDays -Descending |
Format-Table -AutoSize
