<#
BUILD: CYBERARK-SYSTEM-TASK-INSTALLER-2026.07.15.2

Creates or replaces a daily Windows scheduled task under the CyberArk
Task Scheduler folder and runs the existing Move-DisabledAccount.ps1
script as NT AUTHORITY\SYSTEM.

Run this script from Windows PowerShell 5.1 as Administrator.
#>

[CmdletBinding()]
param(
    [string]$TaskFolder = "CyberArk",

    [string]$TaskName = "Move Disabled Accounts Daily",

    [string]$ScriptPath = "I:\Script\IDENTITY Script New\Onbarding Project\Move-DisabledAccount.ps1",

    [ValidatePattern("^(?:[01]\d|2[0-3]):[0-5]\d$")]
    [string]$DailyAt = "02:00",

    [switch]$RunNow
)

$ErrorActionPreference = "Stop"

function Assert-Administrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)

    if (-not $principal.IsInRole(
            [Security.Principal.WindowsBuiltInRole]::Administrator
        )) {
        throw "Run this installer from Windows PowerShell 5.1 as Administrator."
    }
}

function Ensure-TaskFolder {
    param(
        [Parameter(Mandatory)]
        [string]$FolderName
    )

    $service = New-Object -ComObject "Schedule.Service"
    $service.Connect()

    $rootFolder = $service.GetFolder("\")

    try {
        $null = $service.GetFolder("\$FolderName")
    }
    catch {
        $null = $rootFolder.CreateFolder($FolderName)
    }
}

Write-Host "============================================================"
Write-Host "CYBERARK-SYSTEM-TASK-INSTALLER-2026.07.15.2"
Write-Host "============================================================"

try {
    Assert-Administrator

    if (-not (Test-Path -LiteralPath $ScriptPath -PathType Leaf)) {
        throw "Working script was not found: $ScriptPath"
    }

    $powerShellExe = Join-Path `
        $env:SystemRoot `
        "System32\WindowsPowerShell\v1.0\powershell.exe"

    if (-not (Test-Path -LiteralPath $powerShellExe -PathType Leaf)) {
        throw "Windows PowerShell executable was not found: $powerShellExe"
    }

    $TaskFolder = $TaskFolder.Trim().Trim("\")
    $TaskName = $TaskName.Trim()

    if ([string]::IsNullOrWhiteSpace($TaskFolder)) {
        throw "TaskFolder cannot be empty."
    }

    if ([string]::IsNullOrWhiteSpace($TaskName)) {
        throw "TaskName cannot be empty."
    }

    Ensure-TaskFolder -FolderName $TaskFolder

    $fullTaskName = "\$TaskFolder\$TaskName"

    $taskCommand = (
        '"{0}" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{1}"' -f
        $powerShellExe,
        $ScriptPath
    )

    # Remove an existing task with the same folder and name.
    & "$env:SystemRoot\System32\schtasks.exe" `
        /Delete `
        /TN $fullTaskName `
        /F 2>$null | Out-Null

    # Create the task under \CyberArk and run it as SYSTEM.
    $createOutput = & "$env:SystemRoot\System32\schtasks.exe" `
        /Create `
        /TN $fullTaskName `
        /TR $taskCommand `
        /SC DAILY `
        /ST $DailyAt `
        /RU "SYSTEM" `
        /RL HIGHEST `
        /F 2>&1

    $createExitCode = $LASTEXITCODE

    if ($createExitCode -ne 0) {
        throw "schtasks.exe failed with exit code $createExitCode. Output: $($createOutput -join ' ')"
    }

    Write-Host ""
    Write-Host "Scheduled task created successfully." -ForegroundColor Green
    Write-Host "Task Folder : \$TaskFolder"
    Write-Host "Task Name   : $TaskName"
    Write-Host "Schedule    : Daily at $DailyAt"
    Write-Host "Run As      : NT AUTHORITY\SYSTEM"
    Write-Host "Script      : $ScriptPath"
    Write-Host ""

    & "$env:SystemRoot\System32\schtasks.exe" `
        /Query `
        /TN $fullTaskName `
        /V `
        /FO LIST

    if ($LASTEXITCODE -ne 0) {
        throw "The task was created, but verification with schtasks.exe /Query failed."
    }

    if ($RunNow) {
        Write-Host ""

        $runOutput = & "$env:SystemRoot\System32\schtasks.exe" `
            /Run `
            /TN $fullTaskName 2>&1

        $runExitCode = $LASTEXITCODE

        if ($runExitCode -ne 0) {
            throw "The task was created, but starting it failed. Output: $($runOutput -join ' ')"
        }

        Write-Host "Task start request submitted successfully." -ForegroundColor Green
    }

    exit 0
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
