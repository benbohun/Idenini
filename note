<# =====================================================================
WinRc1384_Accounts_FAST.ps1

- CCP -> Identity Header -> psPAS (same login approach)
- Finds accounts that experienced:
    During a logon attempt, the user's security context accumulated too many security IDs. (winRc=1384)

FAST / EFFECTIVE APPROACH
1) Pull full inventory once (cheap) and inspect only account-level fields
2) Pull failed saved filters (FailedVerify / FailedChange / FailedReconcile)
3) Only call Get-PASAccountActivity for:
   - accounts from failed saved filters
   - accounts whose secretManagement shows failure-like state
4) Optional -DeepHistory switch:
   - scans activities for ALL inventoried accounts (slowest but most exhaustive)

Exports ONLY:
  AccountID, Username, Address, Safe, Platform

Outputs:
  E:\Installation Media\Script\OnboardScript\data\WinRc1384_Accounts.csv
  E:\Installation Media\Script\OnboardScript\data\WinRc1384_Accounts.log
===================================================================== #>

[CmdletBinding()]
param(
    [ValidateRange(1,1000)]
    [int]$PageSize = 500,

    [ValidateRange(1,200000)]
    [int]$MaxAccountsToInspect = 50000,

    [ValidateRange(1,1000)]
    [int]$MaxActivitiesToInspect = 80,

    # When used, scan activities for all accounts in inventory.
    # Slower, but highest historical coverage.
    [switch]$DeepHistory
)

# =========================
# Baseline
# =========================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force

# =========================
# Output paths
# =========================
$OutDir = "E:\Installation Media\Script\OnboardScript\data"
if (-not (Test-Path $OutDir)) {
    New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
}

$LogFile = Join-Path $OutDir "WinRc1384_Accounts.log"
$CsvFile = Join-Path $OutDir "WinRc1384_Accounts.csv"
New-Item -ItemType File -Force -Path $LogFile | Out-Null

function Write-Log {
    param(
        [string]$Message,
        [ConsoleColor]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

# =========================
# CCP / Identity config
# =========================
$CCPAddress    = "https://vskau1p1231.cna.com"
$location      = "AIMWebService"
$application   = "PAMDiscovery"
$safeCCP       = "CA_PCloud_Admins"
$windowsAuth   = $false
$headers       = @{ 'Content-Type' = 'application/json' }

$IdentityTenantURL = "aat4012.id.cyberark.cloud"
$PCloudSubdomain   = "cna-prod"

# =========================
# Match logic
# =========================
$NeedleRegex = '(?i)winRc\s*=\s*1384|security\s+context\s+accumulated\s+too\s+many\s+security\s+ids|too\s+many\s+security\s+ids'

# =========================
# Login helper
# =========================
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)] [string]$ObjectName,
        [Parameter(Mandatory)] [string]$UPUser
    )

    $ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safeCCP&Object=$ObjectName"
    Write-Log "Retrieving CCP credential for '$UPUser' via Object..." 'Cyan'

    $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $resp -or -not $resp.Content -or -not $resp.Username) {
        throw "CCP response missing Content/Username."
    }

    Write-Log "CCP returned username for service principal." 'Green'

    $secPass = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    $upCred  = [PSCredential]::new($UPUser, $secPass)

    Write-Log "Requesting Identity header for '$IdentityTenantURL' (subdomain '$PCloudSubdomain')." 'Cyan'
    $hdr = Get-IdentityHeader -IdentityTenantURL $IdentityTenantURL -psPASFormat -PCloudSubdomain $PCloudSubdomain -UPCreds $upCred

    Use-PASSession $hdr
    if (-not (Get-PASSession)) {
        throw "psPAS session not established."
    }

    $resp.Content = $null
    Write-Log "PAS session established." 'Green'
}

function Cmd-HasParam {
    param(
        [string]$CommandName,
        [string]$ParamName
    )

    $c = Get-Command $CommandName -ErrorAction Stop
    return $c.Parameters.ContainsKey($ParamName)
}

function Get-AccountsPaged {
    param(
        [string]$SavedFilter,
        [int]$Limit = 200
    )

    $all = New-Object System.Collections.Generic.List[object]
    $offset = 0

    $hasSavedFilter = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "savedFilter"
    $hasOffset      = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "offset"
    $hasLimit       = Cmd-HasParam -CommandName "Get-PASAccount" -ParamName "limit"

    while ($true) {
        $params = @{}
        if ($SavedFilter -and $hasSavedFilter) { $params["savedFilter"] = $SavedFilter }
        if ($hasLimit)  { $params["limit"]  = $Limit }
        if ($hasOffset) { $params["offset"] = $offset }

        if (-not $hasOffset -and $offset -gt 0) { break }

        $page = @()
        try {
            $page = @(Get-PASAccount @params -ErrorAction Stop)
        }
        catch {
            if ($SavedFilter -and -not $hasSavedFilter) {
                $page = @(Get-PASAccount -ErrorAction Stop)
            }
            else {
                throw
            }
        }

        if ($page.Count -eq 0) { break }

        foreach ($a in $page) { $all.Add($a) | Out-Null }

        if (-not $hasOffset) { break }
        if ($page.Count -lt $Limit) { break }
        if ($all.Count -ge $MaxAccountsToInspect) { break }

        $offset += $Limit
    }

    return @(
        $all |
        Group-Object id |
        ForEach-Object { $_.Group | Select-Object -First 1 }
    )
}

function Get-ActivitiesSafe {
    param([string]$AccountId)

    try {
        return @(Get-PASAccountActivity -AccountID $AccountId -ErrorAction Stop)
    }
    catch {
        return @(Get-PASAccountActivity -AccountID $AccountId -useGen1API -ErrorAction Stop)
    }
}

function Join-Text {
    param([object[]]$Values)

    return (
        $Values |
        Where-Object { $null -ne $_ -and -not [string]::IsNullOrWhiteSpace([string]$_) } |
        ForEach-Object { [string]$_ } |
        Select-Object -Unique
    ) -join ' | '
}

function Get-AccountDiagnosticText {
    param([object]$Acct)

    $vals = @()

    try { $vals += $Acct.secretManagement.status } catch {}
    try { $vals += $Acct.secretManagement.automaticManagementEnabled } catch {}
    try { $vals += $Acct.secretManagement.lastTask.status } catch {}
    try { $vals += $Acct.secretManagement.lastTask.reason } catch {}
    try { $vals += $Acct.secretManagement.lastTask.details } catch {}
    try { $vals += $Acct.secretManagement.lastTask.error } catch {}
    try { $vals += $Acct.secretManagement.lastTask.moreInfo } catch {}
    try { $vals += $Acct.secretManagement.lastTask.message } catch {}

    try { $vals += $Acct.secretManagement.lastFailedTask.status } catch {}
    try { $vals += $Acct.secretManagement.lastFailedTask.reason } catch {}
    try { $vals += $Acct.secretManagement.lastFailedTask.details } catch {}
    try { $vals += $Acct.secretManagement.lastFailedTask.error } catch {}
    try { $vals += $Acct.secretManagement.lastFailedTask.moreInfo } catch {}
    try { $vals += $Acct.secretManagement.lastFailedTask.message } catch {}

    return (Join-Text -Values $vals)
}

function Get-ActivityDiagnosticText {
    param([object]$Activity)

    $vals = @()

    foreach ($n in @('Reason','MoreInfo','Message','Details','Action','Error','Status','Description')) {
        try { $vals += $Activity.$n } catch {}
    }

    return (Join-Text -Values $vals)
}

function AccountMatchesFast {
    param([object]$Acct)

    $txt = Get-AccountDiagnosticText -Acct $Acct
    if (-not $txt) { return $false }

    return ($txt -match $NeedleRegex)
}

function ShouldQueueActivityScan {
    param([object]$Acct)

    try {
        if ($Acct.secretManagement.status -and ([string]$Acct.secretManagement.status -match '(?i)fail|error')) {
            return $true
        }
    } catch {}

    try {
        if ($Acct.secretManagement.lastTask.status -and ([string]$Acct.secretManagement.lastTask.status -match '(?i)fail|error')) {
            return $true
        }
    } catch {}

    try {
        if ($Acct.secretManagement.lastFailedTask) {
            return $true
        }
    } catch {}

    try {
        $txt = Get-AccountDiagnosticText -Acct $Acct
        if ($txt -and ($txt -match $NeedleRegex)) {
            return $true
        }
    } catch {}

    return $false
}

function Add-ResultRow {
    param(
        [Parameter(Mandatory)] [object]$Acct,
        [Parameter(Mandatory)] [System.Collections.Generic.List[object]]$Bucket,
        [Parameter(Mandatory)] [System.Collections.Generic.HashSet[string]]$SeenIds
    )

    $id = [string]$Acct.id
    if ([string]::IsNullOrWhiteSpace($id)) { return $false }
    if (-not $SeenIds.Add($id)) { return $false }

    $row = [PSCustomObject]@{
        AccountID = [string]$Acct.id
        Username  = [string]$Acct.userName
        Address   = [string]$Acct.address
        Safe      = [string]$Acct.safeName
        Platform  = [string]$Acct.platformId
    }

    $Bucket.Add($row) | Out-Null
    return $true
}

# =========================
# MAIN
# =========================
try {
    Start-PASSessionFromCCP -ObjectName "cna.com-CA_PAMDiscovery_SVC" -UPUser "CA_PAMDiscovery_SVC"

    Write-Log "Searching for accounts that experienced winRc=1384..." 'Yellow'
    Write-Log "NeedleRegex: $NeedleRegex" 'DarkYellow'
    Write-Log "Mode: $([string]($(if($DeepHistory){'DeepHistory'}else{'FastOptimized'})))" 'DarkCyan'

    # -------------------------------------------------
    # 1) Pull full inventory once (cheap pass only)
    # -------------------------------------------------
    Write-Log "Pulling account inventory..." 'Cyan'
    $inventory = @(Get-AccountsPaged -SavedFilter $null -Limit $PageSize)
    Write-Log "Inventory returned $($inventory.Count) account(s)." 'Green'

    # -------------------------------------------------
    # 2) Pull likely-failure candidates from saved filters
    # -------------------------------------------------
    $filtersToTry = @("FailedVerify","FailedChange","FailedReconcile")
    $candidateIds = New-Object 'System.Collections.Generic.HashSet[string]'

    foreach ($sf in $filtersToTry) {
        Write-Log "Pulling candidates via savedFilter='$sf'..." 'Cyan'
        $page = @(Get-AccountsPaged -SavedFilter $sf -Limit $PageSize)
        Write-Log "savedFilter '$sf' returned $($page.Count) account(s)." 'Green'

        foreach ($a in $page) {
            if ($a.id) { [void]$candidateIds.Add([string]$a.id) }
        }
    }

    Write-Log "Unique failed-filter candidate count: $($candidateIds.Count)" 'Yellow'

    $results = New-Object System.Collections.Generic.List[object]
    $seenIds = New-Object 'System.Collections.Generic.HashSet[string]'
    $queuedIds = New-Object 'System.Collections.Generic.HashSet[string]'
    $activityQueue = New-Object System.Collections.Generic.List[object]

    $inspectedInventory = 0
    $fastHits = 0
    $queueCount = 0

    # -------------------------------------------------
    # 3) Fast pass across inventory
    # -------------------------------------------------
    foreach ($acct in $inventory) {
        $inspectedInventory++

        if ($inspectedInventory -gt $MaxAccountsToInspect) {
            Write-Log "Safety stop reached at $MaxAccountsToInspect accounts." 'Yellow'
            break
        }

        if ($inspectedInventory % 500 -eq 0) {
            Write-Log "Progress (inventory pass): inspected $inspectedInventory / $($inventory.Count). FastHits=$fastHits Queue=$queueCount" 'DarkGray'
        }

        $acctId = [string]$acct.id
        if ([string]::IsNullOrWhiteSpace($acctId)) { continue }

        # Fast account-level match
        if (AccountMatchesFast -Acct $acct) {
            if (Add-ResultRow -Acct $acct -Bucket $results -SeenIds $seenIds) {
                $fastHits++
                Write-Log ("FAST MATCH: AccountID={0} User={1} Address={2} Safe={3} Platform={4}" -f `
                    [string]$acct.id, [string]$acct.userName, [string]$acct.address, [string]$acct.safeName, [string]$acct.platformId) 'Green'
            }
            continue
        }

        # Queue rules for slower activity scan
        $queueThis = $false

        if ($DeepHistory) {
            $queueThis = $true
        }
        elseif ($candidateIds.Contains($acctId)) {
            $queueThis = $true
        }
        elseif (ShouldQueueActivityScan -Acct $acct) {
            $queueThis = $true
        }

        if ($queueThis -and $queuedIds.Add($acctId)) {
            $activityQueue.Add($acct) | Out-Null
            $queueCount++
        }
    }

    Write-Log "Inventory pass complete. FastHits=$fastHits. ActivityQueue=$($activityQueue.Count)." 'Yellow'

    # -------------------------------------------------
    # 4) Activity scan only for queued accounts
    # -------------------------------------------------
    $activityHits = 0
    $activityReadFailures = 0
    $scannedActivities = 0

    foreach ($acct in $activityQueue) {
        $scannedActivities++

        if ($scannedActivities % 250 -eq 0) {
            Write-Log "Progress (activity pass): scanned $scannedActivities / $($activityQueue.Count). TotalMatches=$($results.Count)" 'DarkGray'
        }

        if ($seenIds.Contains([string]$acct.id)) { continue }

        $acts = @()
        try {
            $acts = @(Get-ActivitiesSafe -AccountId $acct.id)
        }
        catch {
            $activityReadFailures++
            Write-Log ("Could not read activities for AccountID={0}: {1}" -f [string]$acct.id, $_.Exception.Message) 'DarkYellow'
            continue
        }

        $matched = $false
        foreach ($act in ($acts | Select-Object -First $MaxActivitiesToInspect)) {
            $txt = Get-ActivityDiagnosticText -Activity $act
            if ($txt -and ($txt -match $NeedleRegex)) {
                $matched = $true
                break
            }
        }

        if (-not $matched) { continue }

        if (Add-ResultRow -Acct $acct -Bucket $results -SeenIds $seenIds) {
            $activityHits++
            Write-Log ("ACTIVITY MATCH: AccountID={0} User={1} Address={2} Safe={3} Platform={4}" -f `
                [string]$acct.id, [string]$acct.userName, [string]$acct.address, [string]$acct.safeName, [string]$acct.platformId) 'Green'
        }
    }

    # -------------------------------------------------
    # 5) Export
    # -------------------------------------------------
    if ($results.Count -gt 0) {
        $results |
            Sort-Object Safe, Address, Username |
            Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8

        Write-Log "Exported $($results.Count) matching account(s) to: $CsvFile" 'Green'
    }
    else {
        Write-Log "No matching accounts found." 'Yellow'
        @(
            [PSCustomObject]@{
                AccountID = ""
                Username  = ""
                Address   = ""
                Safe      = ""
                Platform  = ""
            }
        ) | Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8
    }

    Write-Log "Summary: FastHits=$fastHits, ActivityHits=$activityHits, ActivityReadFailures=$activityReadFailures, Total=$($results.Count)" 'Cyan'
}
finally {
    try { Close-PASSession | Out-Null } catch {}
    Write-Log "Done." 'Green'
}
