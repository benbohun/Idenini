<#
.SYNOPSIS
  From a list of accounts (samAccountName), produce:
   - CSV #1: AD existence + Enabled/Disabled
   - CSV #2: Owners parsed from the 'info' attribute (Primary Owner, SecondaryOwner/approver)

.REQUIREMENTS
  RSAT ActiveDirectory module (Get-ADUser). Run in a context that can read AD.

.PARAMETERS
  -InputCsv: Path to input CSV. Must contain a column named 'samAccountName' or 'Account'.
  -OutDir:   Output directory for the 2 CSVs (created if missing).

.EXAMPLE
  .\Audit-AdAccounts.ps1 -InputCsv .\accounts.csv -OutDir .\out
#>

[CmdletBinding()]
param(
  [Parameter(Mandatory=$true)]
  [string]$InputCsv,

  [Parameter(Mandatory=$true)]
  [string]$OutDir
)

# --- Prep ---
if (-not (Test-Path $InputCsv)) { throw "Input CSV not found: $InputCsv" }
if (-not (Test-Path $OutDir))   { New-Item -ItemType Directory -Path $OutDir | Out-Null }

$StatusCsv    = Join-Path $OutDir 'AccountStatus.csv'
$OwnershipCsv = Join-Path $OutDir 'AccountOwnership.csv'

# Import data
$rows = Import-Csv -Path $InputCsv

# Determine which column has the samAccountName
$possibleCols = @('samAccountName','Account')
$samCol = $possibleCols | Where-Object { $_ -in $rows[0].PsObject.Properties.Name }
if (-not $samCol) {
  throw "Input CSV must contain a column named 'samAccountName' or 'Account'."
}

# Regex helpers for parsing 'info' attribute
# Accepts variations like "Primary Owner:", "Primary Owner  :", "SecondaryOwner/approver :" etc
# Captures text up to end, semicolon, or newline.
$rxPrimary   = [regex]'(?im)\bPrimary\s*Owner\s*:\s*(?<val>.+?)(?:;|$|\r|\n)'
$rxSecondary = [regex]'(?im)\bSecondary\s*Owner(?:/|\s*)approver\s*:\s*(?<val>.+?)(?:;|$|\r|\n)'

# If you want to enforce “starts with C” (e.g., CNA IDs), set this to $true
$EnforceStartsWithC = $false
$rxStartsWithC = [regex]'(?i)^\s*C'

# Results
$statusOut    = New-Object System.Collections.Generic.List[object]
$ownershipOut = New-Object System.Collections.Generic.List[object]

# Ensure AD module
if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
  throw "ActiveDirectory module not found. Install RSAT or run on a domain-joined admin host with RSAT."
}

foreach ($row in $rows) {
  $sam = ($row.$samCol).ToString().Trim()
  if ([string]::IsNullOrWhiteSpace($sam)) { continue }

  $user = $null
  try {
    $user = Get-ADUser -LDAPFilter "(sAMAccountName=$sam)" -Properties Enabled, info, whenCreated, whenChanged, lastLogonDate
  } catch {
    # ignore, will handle as not found
  }

  if ($null -eq $user) {
    # Not in AD
    $statusOut.Add([pscustomobject]@{
      samAccountName   = $sam
      ADExists         = 'No'
      Enabled          = ''
      DistinguishedName= ''
      WhenCreated      = ''
      LastLogonDate    = ''
    })

    # Ownership row (cannot parse info if not in AD)
    $ownershipOut.Add([pscustomobject]@{
      samAccountName            = $sam
      ADExists                  = 'No'
      PrimaryOwner              = ''
      SecondaryOwnerOrApprover  = ''
      InfoRaw                   = ''
      ParseNote                 = 'User not found in AD'
    })
    continue
  }

  # Exists in AD
  $enabled = $false
  if ($user.PSObject.Properties['Enabled']) { $enabled = [bool]$user.Enabled }

  $statusOut.Add([pscustomobject]@{
    samAccountName   = $sam
    ADExists         = 'Yes'
    Enabled          = $(if ($enabled) { 'Enabled' } else { 'Disabled' })
    DistinguishedName= $user.DistinguishedName
    WhenCreated      = $user.whenCreated
    LastLogonDate    = $user.lastLogonDate
  })

  # Parse ownership from info
  $infoText = ($user.info | Out-String).Trim()
  $primaryVal   = ''
  $secondaryVal = ''
  $parseNote    = ''

  if (-not [string]::IsNullOrWhiteSpace($infoText)) {
    $m1 = $rxPrimary.Match($infoText)
    if ($m1.Success) {
      $primaryVal = $m1.Groups['val'].Value.Trim()
    }
    $m2 = $rxSecondary.Match($infoText)
    if ($m2.Success) {
      $secondaryVal = $m2.Groups['val'].Value.Trim()
    }

    if ($EnforceStartsWithC) {
      if ($primaryVal -and -not $rxStartsWithC.IsMatch($primaryVal)) {
        $parseNote += 'Primary Owner does not start with C; '
      }
      if ($secondaryVal -and -not $rxStartsWithC.IsMatch($secondaryVal)) {
        $parseNote += 'SecondaryOwner/approver does not start with C; '
      }
      $parseNote = $parseNote.Trim()
    }

    if (-not $m1.Success -and -not $m2.Success) {
      if ($infoText) { $parseNote = 'Keywords not found in info; verify formatting.' }
    }
  } else {
    $parseNote = 'info attribute empty'
  }

  $ownershipOut.Add([pscustomobject]@{
    samAccountName            = $sam
    ADExists                  = 'Yes'
    PrimaryOwner              = $primaryVal
    SecondaryOwnerOrApprover  = $secondaryVal
    InfoRaw                   = $infoText
    ParseNote                 = $parseNote
  })
}

# Export both CSVs
$statusOut    | Export-Csv -Path $StatusCsv -NoTypeInformation -Encoding UTF8
$ownershipOut | Export-Csv -Path $OwnershipCsv -NoTypeInformation -Encoding UTF8

Write-Host "✅ Done."
Write-Host " - Status CSV:    $StatusCsv"
Write-Host " - Ownership CSV: $OwnershipCsv"
