#requires -Version 5.1
<#
Back up and clear TODAY's test Records and Evidence only.
Never deletes prior dates, archives, or audit.tsv.
Run from elevated PowerShell when no one is submitting checks.
Use -ResetToday to confirm destructive action (after backup).
#>
[CmdletBinding()]
param(
    [string]$DataRoot = 'C:\ProgramData\PAMDailyHealthCheck',
    [switch]$ResetToday
)
$ErrorActionPreference = 'Stop'
$today = Get-Date -Format 'yyyy-MM-dd'
$records = Join-Path (Join-Path $DataRoot 'Records') $today
$evidence = Join-Path (Join-Path $DataRoot 'Evidence') $today
$backupBase = Join-Path $DataRoot 'TestResetBackups'
$backupPath = Join-Path $backupBase ("$today-$(Get-Date -Format yyyyMMdd-HHmmss)-$([guid]::NewGuid().ToString('N').Substring(0,6))")
$items = @()
if (Test-Path -LiteralPath $records -PathType Container) { $items += @{Type='Records'; Path=$records} }
if (Test-Path -LiteralPath $evidence -PathType Container) { $items += @{Type='Evidence'; Path=$evidence} }
Write-Host "Date to reset (server-local): $today" -ForegroundColor Cyan
foreach($item in $items) {
    $count = @(Get-ChildItem -LiteralPath $item.Path -Recurse -File -ErrorAction Stop).Count
    Write-Host "$($item.Type): $count files at $($item.Path)"
}
if (-not $ResetToday) {
    Write-Host 'DRY RUN ONLY. To back up and clear today, re-run with -ResetToday.' -ForegroundColor Yellow
    exit 0
}
if ($items.Count -eq 0) { Write-Host 'Nothing to reset for today.'; exit 0 }
New-Item -ItemType Directory -Path $backupPath -Force | Out-Null
# Copy both directories and validate file counts and content hashes before any deletion.
foreach ($item in $items) {
    $target = Join-Path $backupPath $item.Type
    Copy-Item -LiteralPath $item.Path -Destination $target -Recurse -Force -ErrorAction Stop
}
foreach ($item in $items) {
    $target = Join-Path $backupPath $item.Type
    $sourceFiles = @(Get-ChildItem -LiteralPath $item.Path -Recurse -File -ErrorAction Stop)
    $destFiles = @(Get-ChildItem -LiteralPath $target -Recurse -File -ErrorAction Stop)
    if ($sourceFiles.Count -ne $destFiles.Count) { throw "Backup count mismatch for $($item.Type). No files deleted." }
    foreach ($original in $sourceFiles) {
        $relative = $original.FullName.Substring($item.Path.Length).TrimStart('\')
        $copy = Join-Path $target $relative
        if (-not (Test-Path -LiteralPath $copy -PathType Leaf)) { throw "Missing backup: $copy" }
        if ((Get-FileHash -LiteralPath $original.FullName -Algorithm SHA256).Hash -ne (Get-FileHash -LiteralPath $copy -Algorithm SHA256).Hash) {
            throw "Backup checksum mismatch: $copy. No files deleted."
        }
    }
}
# Rename directories to a quarantine location before removal to avoid partial checklist state.
foreach ($item in $items) {
    Remove-Item -LiteralPath $item.Path -Recurse -Force -ErrorAction Stop
}
$log = Join-Path $DataRoot 'test-resets.log'
$line = "$(Get-Date -Format o)`tRESET`t$today`t$env:USERDOMAIN\$env:USERNAME`tBackup=$backupPath"
Add-Content -LiteralPath $log -Value $line -Encoding UTF8
Write-Host "SUCCESS: Today ($today) reset to pending. Verified backup: $backupPath" -ForegroundColor Green
Write-Host 'Older dates, Archive, web.config, application source, and audit.tsv unchanged.'
Write-Warning 'Previous test submissions remain in audit.tsv; test reset activity is documented in test-resets.log.'
