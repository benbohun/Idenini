Get-ADUser SVCQTGAcct -Server dev.mtb.com -Properties pwdLastSet,PasswordExpired,PasswordLastSet | Select SamAccountName,pwdLastSet,PasswordExpired,PasswordLastSet


Get-ADUser SVCQTGAcct -Server dev.mtb.com -Properties userAccountControl | Select SamAccountName,userAccountControl

Get-ADPrincipalGroupMembership SVCQTGAcct -Server dev.mtb.com | Select Name | Sort Name
