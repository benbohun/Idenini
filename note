<#
UpdateSafes_NumberOfDaysRetention_FromCSV_CCP.ps1

AUTH (Automation)
- CCP -> Service User credential
- Auth to Privilege Cloud via Identity Shared Services
  1) Primary: New-PASSession -IdentityTenantURL -PrivilegeCloudURL -Credential -ServiceUser
  2) Fallback: Get-IdentityHeader (-psPASFormat) + Use-PASSession

ACTION
- Reads safes from CSV
- Updates NumberOfDaysRetention only for safes listed in the CSV
- After retention update succeeds, ensures the service identity user is a Safe member
  with the full permission set defined in $FullPermPAS
- If the member already exists, its permissions are updated to match $FullPermPAS
- If the member does not exist, it is added

OUTPUT
- Exports status rows to:
  I:\Script\IDENTITY Script New\csv\safeupdatestatus.csv
- Shows authentication success on screen
- Shows only failures during per-safe processing
- Returns failed rows to pipeline

CSV INPUT
I:\Script\IDENTITY Script New\csv\SafesToUpdate.csv

CSV EXAMPLE
safeName,NumberOfDaysRetention
Safe_A,60
Safe_B,90
Safe_C,

LOG
- I:\Script\IDENTITY Script New\logs\UpdateRetention_SelectedSafes.txt
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL   = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL   = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (Service User stored in Vault) =====
    [string]$CCPAddress          = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation         = "AIMWebService",
    [string]$CCPAppID            = "ACURestAPI",
    [string]$CCPSafe             = "ACU-VAULT-API",
    [string]$CCPObject           = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth      = $false,

    # ===== CSV input =====
    [string]$CsvPath             = "I:\Script\IDENTITY Script New\csv\SafesToUpdate.csv",

    # ===== Status export =====
    [string]$StatusCsvPath       = "I:\Script\IDENTITY Script New\csv\safeupdatestatus.csv",

    # ===== Default retention if CSV row does not provide one =====
    [ValidateRange(1,3650)]
    [int]$TargetRetentionDays    = 60,

    # ===== Safe member enforcement =====
    [string]$ServiceIdentityUser = "acurestapi_local@alliantcreditunion.admin",
    [string]$SafeMemberSearchIn  = "Vault",
    [ValidateSet("User","Group","Role")]
    [string]$SafeMemberType      = "User",

    # ===== Logging =====
    [string]$LogFilePath         = "I:\Script\IDENTITY Script New\logs\UpdateRetention_SelectedSafes.txt"
)

# --- Full Safe permissions for the enforced service identity member ---
$FullPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $true
    DeleteAccounts                         = $true
    UnlockAccounts                         = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
    BackupSafe                             = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $true
    DeleteFolders                          = $true
    MoveAccountsAndFolders                 = $true
    requestsAuthorizationLevel1            = $true
    requestsAuthorizationLevel2            = $false
}

# --- Modules & TLS ---
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

function Write-Err {
    param([string]$Message)
    Write-Host "❌ $Message" -ForegroundColor Red
}

function Write-Info {
    param([string]$Message)
    Write-Host "ℹ️  $Message" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Message)
    Write-Host "✅ $Message" -ForegroundColor Green
}

function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)
    if (-not [string]::IsNullOrWhiteSpace($Path) -and -not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Write-LogLine {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Add-Content -Path $LogFilePath -Value $line
}

function Get-HostFromUrl {
    param([Parameter(Mandatory)][string]$Url)
    try {
        return ([uri]$Url).Host
    }
    catch {
        return ($Url -replace '^https?://','' -replace '/.*$','').Trim()
    }
}

function Get-PCloudSubdomainFromUrl {
    param([Parameter(Mandatory)][string]$PrivilegeCloudURL)
    $pcloudHost = Get-HostFromUrl $PrivilegeCloudURL
    return ($pcloudHost.Split('.')[0]).Trim()
}

function Get-PropValueCI {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$PropName
    )
    if ($null -eq $Object) { return $null }
    $p = $Object.PSObject.Properties | Where-Object { $_.Name -ieq $PropName } | Select-Object -First 1
    if ($p) { return $p.Value }
    return $null
}

function Get-RowValueCI {
    param(
        [Parameter(Mandatory)]$Row,
        [Parameter(Mandatory)][string[]]$CandidateNames
    )

    foreach ($name in $CandidateNames) {
        $prop = $Row.PSObject.Properties | Where-Object { $_.Name -ieq $name } | Select-Object -First 1
        if ($prop) {
            return $prop.Value
        }
    }
    return $null
}

function Convert-ObjectToHashtable {
    param([Parameter(Mandatory)]$InputObject)

    $hash = @{}
    foreach ($prop in $InputObject.PSObject.Properties) {
        $hash[$prop.Name] = $prop.Value
    }
    return $hash
}

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-LogLine "Retrieving Service User credential from CCP: $url" "INFO"
    Write-Info "Retrieving service credential from CCP..."

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content."
    }

    Write-LogLine "CCP returned service user: $($resp.UserName)" "SUCCESS"
    Write-Ok "CCP credential retrieved successfully for: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

function Connect-PCloudWithServiceUser {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$PrivilegeCloudURL,
        [Parameter(Mandatory)][pscredential]$ServiceCred
    )

    $tenantHost = Get-HostFromUrl $IdentityTenantURL
    $subdomain  = Get-PCloudSubdomainFromUrl $PrivilegeCloudURL

    Write-LogLine "Attempting login (Primary): New-PASSession (ServiceUser)..." "INFO"
    Write-Info "Attempting Privilege Cloud login using primary authentication method..."

    try {
        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential        $ServiceCred `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        $sess = Get-PASSession
        if (-not $sess) { throw "Get-PASSession returned null after New-PASSession." }

        Write-LogLine "Authenticated (Primary) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Primary) as: $($ServiceCred.UserName)"
        return
    }
    catch {
        Write-LogLine "Primary login failed: $($_.Exception.Message)" "WARN"
        Write-Info "Primary login failed. Attempting fallback authentication..."

        $cmd = Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue
        if (-not $cmd) {
            throw "Fallback login not available (Get-IdentityHeader not found). Primary login failed."
        }

        $header = Get-IdentityHeader `
            -IdentityTenantURL $tenantHost `
            -psPASFormat `
            -PCloudSubdomain $subdomain `
            -UPCreds $ServiceCred

        Use-PASSession $header

        $sess2 = Get-PASSession
        if (-not $sess2) { throw "Get-PASSession returned null after Use-PASSession." }

        Write-LogLine "Authenticated (Fallback) to $PrivilegeCloudURL as $($ServiceCred.UserName)" "SUCCESS"
        Write-Ok "Privilege Cloud login successful (Fallback) as: $($ServiceCred.UserName)"
        return
    }
}

function Import-SafeTargetsFromCsv {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][int]$DefaultRetentionDays
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        throw "CSV file not found: $Path"
    }

    $rows = Import-Csv -LiteralPath $Path
    if (-not $rows -or $rows.Count -eq 0) {
        throw "CSV file is empty: $Path"
    }

    $targets = New-Object System.Collections.Generic.List[object]
    $seen    = @{}
    $rowNum = 1

    foreach ($row in $rows) {
        $rowNum++

        $safeNameRaw = Get-RowValueCI -Row $row -CandidateNames @('safeName','SafeName','safe','Safe')
        $retentionRaw = Get-RowValueCI -Row $row -CandidateNames @(
            'NumberOfDaysRetention',
            'numberOfDaysRetention',
            'RetentionDays',
            'retentionDays',
            'NumberOfDaysRetension',
            'numberOfDaysRetension'
        )

        if ([string]::IsNullOrWhiteSpace($safeNameRaw)) {
            Write-LogLine "Skipping CSV row $rowNum because safeName is blank." "WARN"
            continue
        }

        $safeName = ([string]$safeNameRaw).Trim()

        $retentionDays = $DefaultRetentionDays
        if (-not [string]::IsNullOrWhiteSpace([string]$retentionRaw)) {
            $tmp = 0
            if (-not [int]::TryParse(([string]$retentionRaw).Trim(), [ref]$tmp)) {
                throw "CSV row $rowNum for safe '$safeName' has invalid NumberOfDaysRetention value: '$retentionRaw'"
            }
            if ($tmp -lt 1 -or $tmp -gt 3650) {
                throw "CSV row $rowNum for safe '$safeName' has NumberOfDaysRetention outside valid range (1-3650): '$tmp'"
            }
            $retentionDays = $tmp
        }

        $key = $safeName.ToLowerInvariant()
        if ($seen.ContainsKey($key)) {
            Write-LogLine "Duplicate safe '$safeName' found in CSV. Last occurrence will be used." "WARN"
            $seen[$key].NumberOfDaysRetention = $retentionDays
            continue
        }

        $obj = [PSCustomObject]@{
            SafeName              = $safeName
            NumberOfDaysRetention = [int]$retentionDays
        }

        $seen[$key] = $obj
        $targets.Add($obj) | Out-Null
    }

    if ($targets.Count -eq 0) {
        throw "No valid safes found in CSV after parsing: $Path"
    }

    return $targets.ToArray()
}

function Get-ExistingSafeMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName
    )

    $members = @(Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop)

    foreach ($member in $members) {
        $candidateNames = @(
            (Get-PropValueCI -Object $member -PropName "memberName"),
            (Get-PropValueCI -Object $member -PropName "MemberName"),
            (Get-PropValueCI -Object $member -PropName "userName"),
            (Get-PropValueCI -Object $member -PropName "UserName"),
            (Get-PropValueCI -Object $member -PropName "username"),
            (Get-PropValueCI -Object $member -PropName "Username")
        ) | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) }

        foreach ($candidate in $candidateNames) {
            if (([string]$candidate).Trim() -ieq $MemberName) {
                return $member
            }
        }
    }

    return $null
}

function Ensure-ServiceIdentitySafeMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][string]$SearchIn,
        [Parameter(Mandatory)][string]$MemberType,
        [Parameter(Mandatory)]$PermissionObject
    )

    $permHash = Convert-ObjectToHashtable -InputObject $PermissionObject
    $existing = Get-ExistingSafeMember -SafeName $SafeName -MemberName $MemberName

    if ($null -ne $existing) {
        Set-PASSafeMember `
            -SafeName   $SafeName `
            -MemberName $MemberName `
            @permHash `
            -ErrorAction Stop | Out-Null

        Write-LogLine "Safe member '$MemberName' already existed on '$SafeName'. Permissions updated to target full permissions." "SUCCESS"
        return "UPDATED"
    }
    else {
        Add-PASSafeMember `
            -SafeName   $SafeName `
            -MemberName $MemberName `
            -SearchIn   $SearchIn `
            -memberType $MemberType `
            @permHash `
            -ErrorAction Stop | Out-Null

        Write-LogLine "Safe member '$MemberName' added to '$SafeName' with target full permissions." "SUCCESS"
        return "ADDED"
    }
}

$sessionCreated = $false
$failed     = New-Object System.Collections.Generic.List[object]
$statusRows = New-Object System.Collections.Generic.List[object]

try {
    Ensure-Directory -Path (Split-Path $LogFilePath -Parent)
    Ensure-Directory -Path (Split-Path $StatusCsvPath -Parent)

    New-Item -ItemType File -Path $LogFilePath -Force | Out-Null

    Write-LogLine "Starting retention update run (CSV selected safes). Default NumberOfDaysRetention=$TargetRetentionDays" "INFO"
    Write-LogLine "CSV Path: $CsvPath" "INFO"
    Write-LogLine "Status CSV Path: $StatusCsvPath" "INFO"
    Write-LogLine "Service identity member enforcement enabled for: $ServiceIdentityUser (SearchIn=$SafeMemberSearchIn, MemberType=$SafeMemberType)" "INFO"

    # 1) Parse CSV
    $safeTargets = @(Import-SafeTargetsFromCsv -Path $CsvPath -DefaultRetentionDays $TargetRetentionDays)
    Write-LogLine "CSV parsed successfully. Unique safes to process: $($safeTargets.Count)" "SUCCESS"
    Write-Info "CSV parsed successfully. Safes to process: $($safeTargets.Count)"

    # 2) Get service user from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 3) Login using service user automation
    Connect-PCloudWithServiceUser `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -ServiceCred $serviceCred

    $sessionCreated = $true
    Write-LogLine "Authenticated successfully." "SUCCESS"
    Write-Ok "Authentication stage completed successfully."
    Write-Info "Will enforce Safe member '$ServiceIdentityUser' with full permissions after each successful retention update."

    Write-Host ("Updating NumberOfDaysRetention for {0} safe(s) from CSV... (only failures will be shown)" -f $safeTargets.Count) -ForegroundColor Cyan

    # 4) Update retention, then ensure Safe member
    foreach ($t in $safeTargets) {
        $safeName = [string]$t.SafeName
        $days = 0

        if (-not [int]::TryParse(([string]$t.NumberOfDaysRetention), [ref]$days)) {
            throw "Invalid NumberOfDaysRetention value resolved for safe '$safeName': '$($t.NumberOfDaysRetention)'"
        }

        $retentionStatus   = "PENDING"
        $safeMemberStatus  = "PENDING"
        $overallStatus     = "SUCCESS"
        $rowError          = ""

        # Step 1: Update retention
        try {
            if ($PSCmdlet.ShouldProcess($safeName, "Set-PASSafe NumberOfDaysRetention=$days")) {
                Set-PASSafe -SafeName $safeName -NumberOfDaysRetention $days -ErrorAction Stop | Out-Null
            }

            $retentionStatus = "UPDATED"
            Write-LogLine "Safe '$safeName' updated. NumberOfDaysRetention=$days" "SUCCESS"
        }
        catch {
            $retentionStatus  = "FAILED"
            $safeMemberStatus = "SKIPPED"
            $overallStatus    = "FAILED"
            $rowError         = $_.Exception.Message

            $failObj = [PSCustomObject]@{
                SafeName              = $safeName
                NumberOfDaysRetention = $days
                RetentionStatus       = $retentionStatus
                SafeMemberName        = $ServiceIdentityUser
                SafeMemberSearchIn    = $SafeMemberSearchIn
                SafeMemberType        = $SafeMemberType
                SafeMemberStatus      = $safeMemberStatus
                OverallStatus         = $overallStatus
                Error                 = $rowError
            }

            $failed.Add($failObj) | Out-Null
            $statusRows.Add($failObj) | Out-Null

            Write-LogLine "Failed to update safe '$safeName'. NumberOfDaysRetention=$days. Error: $rowError" "ERROR"
            Write-Err "Failed to update safe '$safeName' retention -> $rowError"
            continue
        }

        # Step 2: Ensure service identity safe member
        try {
            if ($PSCmdlet.ShouldProcess($safeName, "Ensure Safe member '$ServiceIdentityUser' with full permissions")) {
                $safeMemberStatus = Ensure-ServiceIdentitySafeMember `
                    -SafeName       $safeName `
                    -MemberName     $ServiceIdentityUser `
                    -SearchIn       $SafeMemberSearchIn `
                    -MemberType     $SafeMemberType `
                    -PermissionObject $FullPermPAS
            }
            else {
                $safeMemberStatus = "SKIPPED"
            }
        }
        catch {
            $safeMemberStatus = "FAILED"
            $overallStatus    = "FAILED"
            $rowError         = $_.Exception.Message

            Write-LogLine "Failed to ensure safe member '$ServiceIdentityUser' on safe '$safeName'. Error: $rowError" "ERROR"
            Write-Err "Failed to ensure safe member '$ServiceIdentityUser' on safe '$safeName' -> $rowError"
        }

        $rowObj = [PSCustomObject]@{
            SafeName              = $safeName
            NumberOfDaysRetention = $days
            RetentionStatus       = $retentionStatus
            SafeMemberName        = $ServiceIdentityUser
            SafeMemberSearchIn    = $SafeMemberSearchIn
            SafeMemberType        = $SafeMemberType
            SafeMemberStatus      = $safeMemberStatus
            OverallStatus         = $overallStatus
            Error                 = $rowError
        }

        $statusRows.Add($rowObj) | Out-Null

        if ($overallStatus -eq "FAILED") {
            $failed.Add($rowObj) | Out-Null
        }
    }

    # 5) Export status CSV
    $statusRows |
        Sort-Object SafeName |
        Export-Csv -LiteralPath $StatusCsvPath -NoTypeInformation -Encoding UTF8

    Write-LogLine "Status CSV exported successfully: $StatusCsvPath (Rows=$($statusRows.Count))" "SUCCESS"
    Write-Ok "Status CSV exported successfully: $StatusCsvPath"

    if ($failed.Count -gt 0) {
        Write-Host ""
        Write-Host ("FAILED rows: {0}" -f $failed.Count) -ForegroundColor Yellow
        $failed | Sort-Object SafeName | Format-Table -AutoSize
    }
    else {
        Write-Host ""
        Write-Host "All selected safes updated successfully and service identity membership enforced." -ForegroundColor Green
    }

    Write-LogLine "Completed processing selected safes from CSV. Failures=$($failed.Count)" "SUCCESS"
}
catch {
    Write-LogLine "Fatal error: $($_.Exception.Message)" "ERROR"
    Write-Err $_.Exception.Message

    try {
        if ($statusRows.Count -gt 0) {
            Ensure-Directory -Path (Split-Path $StatusCsvPath -Parent)
            $statusRows |
                Sort-Object SafeName |
                Export-Csv -LiteralPath $StatusCsvPath -NoTypeInformation -Encoding UTF8
            Write-LogLine "Partial status CSV exported after fatal error: $StatusCsvPath (Rows=$($statusRows.Count))" "WARN"
        }
    }
    catch {
        Write-LogLine "Unable to export partial status CSV after fatal error: $($_.Exception.Message)" "WARN"
    }
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-LogLine "Logged off." "INFO"
            Write-Info "Logged off PAS session."
        }
        catch {
            Write-LogLine "Logoff warning: $($_.Exception.Message)" "WARN"
        }
    }
}

# Return failed rows as objects (pipeline-friendly)
$failed
