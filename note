<#
AutoOnboard_Safe_CNA.ps1

UPDATED FOR CNA:
- Authenticates with CNA Identity / Privilege Cloud using CCP object:
    cna-prod.cyberark.cloud-cnarestbot
- Uses Get-IdentityHeader + Use-PASSession
- Creates a Safe with 120-day retention
- Adds:
    1) Target AD safe group (limited perms)
    2) CA_PCloud_Admins@cna.com (full perms)
    3) cna_pas_admin@cyberark.cloud.6679 (full perms)
    4) identity-privilege-integration-user$@cyberark.cloud.6679 (full perms)
- Does NOT add cnarestbot@cyberark.cloud.6679 (default)
- Does NOT remove CA_PAMDiscovery_SVC@cna.com (no longer added)

NOTES:
- Requires psPAS
- ActiveDirectory module is optional but recommended for group validation
#>

[CmdletBinding()]
param(
    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = 'https://aat4012.id.cyberark.cloud',
    [string]$PCloudSubdomain   = 'cna-prod',
    [string]$PrivilegeCloudURL = 'https://cna-prod.privilegecloud.cyberark.cloud',

    # ===== CCP settings (CNA) =====
    [string]$CCPAddress        = 'https://vskau1p1231.cna.com',
    [string]$CCPLocation       = 'AIMWebService',
    [string]$CCPAppID          = 'PAMDiscovery',
    [string]$CCPSafe           = 'CA_PCloud_Admins',
    [string]$CCPObject         = 'cna-prod.cyberark.cloud-cnarestbot',
    [bool]$CCPWindowsAuth      = $false,

    # ===== Members to add =====
    [string]$AdminGroup        = 'CA_PCloud_Admins@cna.com',
    [string]$AdminMember       = 'cna_pas_admin@cyberark.cloud.6679',
    [string]$IdentityMember    = 'identity-privilege-integration-user$@cyberark.cloud.6679',

    # ===== Safe defaults =====
    [string]$ManagingCPM       = 'CNA_PASS_MANG',
    [int]$NumberOfDaysRetention = 120,

    # ===== AD validation =====
    [string]$SearchBaseOU      = 'OU=Groups,OU=CyberArk,DC=cna,DC=com',

    # ===== Logging =====
    [string]$LogPath           = 'E:\Installation Media\Script\OnboardScript\data\accountonboarding.txt'
)

# --- Allow this process to load unsigned modules & unblock psPAS files (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}

$psPASDirs = @(
    "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
    "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }

foreach ($dir in $psPASDirs) {
    try {
        Get-ChildItem -Path $dir -Recurse -File | Unblock-File -ErrorAction SilentlyContinue
    } catch {}
}

# --- Logging Utility ---
function Write-Log {
    param(
        [string]$Message,
        [string]$Color = 'White'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $logEntry  = "$timestamp - $Message"

    try { Write-Host $logEntry -ForegroundColor $Color } catch { Write-Host $logEntry }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $logEntry
    } catch {}
}

# --- Console "box" helper (for fallback dialog text) ---
function Show-Box {
    param(
        [string]$Title,
        [string]$BodyLine1 = '',
        [string]$BodyLine2 = ''
    )

    $line = ('=' * 72)
    Write-Host $line -ForegroundColor DarkGray
    if ($Title)     { Write-Host ("[ " + $Title + " ]") -ForegroundColor Gray }
    if ($BodyLine1) { Write-Host $BodyLine1 -ForegroundColor Gray }
    if ($BodyLine2) { Write-Host $BodyLine2 -ForegroundColor Gray }
    Write-Host $line -ForegroundColor DarkGray
}

# --- URL encode helper ---
function Encode-UrlValue {
    param([Parameter(Mandatory)][string]$Value)
    return [System.Uri]::EscapeDataString($Value)
}

# --- Load psPAS ---
try {
    Import-Module psPAS -Force -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log ("psPAS loaded ({0})." -f $mod.Version) 'Green'
} catch {
    Write-Log ("❌ psPAS module not found/loaded: {0}" -f $_.Exception.Message) 'Red'
    exit 1
}

# --- Try to import AD module for OU validation (non-fatal if missing) ---
$ADModuleLoaded = $false
try {
    Import-Module ActiveDirectory -ErrorAction Stop
    $ADModuleLoaded = $true
    Write-Log 'ActiveDirectory module loaded.' 'Green'
} catch {
    Write-Log '⚠️ ActiveDirectory module not available; will still try to add group by UPN.' 'Yellow'
}

# --- Shared REST headers ---
$headers = @{ 'Content-Type' = 'application/json' }

# --- Helper: build CCP URL ---
function Get-CCPAccountUrl {
    param(
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$ObjectName
    )

    $baseUrl = '{0}/{1}/api/Accounts' -f $CCPAddress.TrimEnd('/'), $CCPLocation.Trim('/')
    $query   = 'AppID={0}&Safe={1}&Object={2}' -f (Encode-UrlValue $AppID), (Encode-UrlValue $Safe), (Encode-UrlValue $ObjectName)

    return "$baseUrl?$query"
}

# --- Helper: start PAS session from CCP creds using psPAS Identity method ---
function Start-PASSessionFromCCP {
    param(
        [Parameter(Mandatory)][string]$ObjectName
    )

    $ccpUrl = Get-CCPAccountUrl -AppID $CCPAppID -Safe $CCPSafe -ObjectName $ObjectName
    Write-Log ("Retrieving CyberArk API credentials from CCP using Object='{0}'..." -f $ObjectName)

    try {
        $resp = Invoke-RestMethod -Uri $ccpUrl -Method GET -Headers $headers -UseDefaultCredentials:$CCPWindowsAuth -ErrorAction Stop
        if (-not $resp) { throw 'Empty CCP response.' }
        if (-not $resp.Content) { throw 'CCP response did not include password content.' }
    } catch {
        Write-Log ("❌ ERROR: CCP credential fetch failed - {0}" -f $_.Exception.Message) 'Red'
        throw
    }

    $resolvedUser = $null
    if ($resp.PSObject.Properties.Name -contains 'UserName') {
        $resolvedUser = [string]$resp.UserName
    } elseif ($resp.PSObject.Properties.Name -contains 'Username') {
        $resolvedUser = [string]$resp.Username
    }

    if ([string]::IsNullOrWhiteSpace($resolvedUser)) {
        Write-Log '❌ CCP response did not include Username/UserName.' 'Red'
        throw 'Username not returned by CCP.'
    }

    Write-Log ("✅ Successfully retrieved credentials for user: {0}" -f $resolvedUser) 'Green'

    try {
        Write-Log ("Requesting CyberArk PAS authentication (psPAS Identity header) as {0}..." -f $resolvedUser)

        $securePass = ConvertTo-SecureString $resp.Content -AsPlainText -Force
        $credential = [System.Management.Automation.PSCredential]::new($resolvedUser, $securePass)

        $identityHeader = Get-IdentityHeader `
            -IdentityTenantURL $IdentityTenantURL `
            -psPASFormat `
            -PCloudSubdomain $PCloudSubdomain `
            -UPCreds $credential

        Use-PASSession $identityHeader

        $session = Get-PASSession
        if (-not $session) {
            throw 'psPAS session not established.'
        }

        Write-Log ("✅ Authentication successful, PAS session established ({0})." -f $resolvedUser) 'Green'
        return $resp
    } catch {
        Write-Log ("❌ Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) 'Red'
        throw
    }
}

# --- Permissions (psPAS-friendly) ---
$LimitedPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $false
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $false
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $false
    DeleteAccounts                         = $false
    UnlockAccounts                         = $false
    ManageSafe                             = $false
    ManageSafeMembers                      = $false
    BackupSafe                             = $false
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $false
    DeleteFolders                          = $false
    MoveAccountsAndFolders                 = $false
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}

$FullPermPAS = [PSCustomObject]@{
    UseAccounts                            = $true
    RetrieveAccounts                       = $true
    ListAccounts                           = $true
    AddAccounts                            = $true
    UpdateAccountContent                   = $true
    UpdateAccountProperties                = $true
    InitiateCPMAccountManagementOperations = $true
    SpecifyNextAccountContent              = $true
    RenameAccounts                         = $true
    DeleteAccounts                         = $true
    UnlockAccounts                         = $true
    ManageSafe                             = $true
    ManageSafeMembers                      = $true
    BackupSafe                             = $true
    ViewAuditLog                           = $true
    ViewSafeMembers                        = $true
    AccessWithoutConfirmation              = $true
    CreateFolders                          = $true
    DeleteFolders                          = $true
    MoveAccountsAndFolders                 = $true
    RequestsAuthorizationLevel1            = $true
    RequestsAuthorizationLevel2            = $false
}

# --- AD Group validation helper ---
function Read-ValidGroup {
    while ($true) {
        $g = Read-Host 'Enter the AD Safe Group (sAMAccountName only, e.g., ca_xxx_xxx_prod)'

        if ([string]::IsNullOrWhiteSpace($g)) {
            Write-Log '❌ Group cannot be empty.' 'Red'
            continue
        }

        if ($g -notmatch '^[A-Za-z0-9_\-\.]+$') {
            Write-Log '❌ Invalid characters in group name. Try again.' 'Red'
            continue
        }

        if ($ADModuleLoaded) {
            try {
                $escapedGroup = $g.Replace('\','\5c').Replace('(','\28').Replace(')','\29').Replace('*','\2a')
                $ldapFilter = "(|(sAMAccountName=$escapedGroup)(userPrincipalName=$escapedGroup@cna.com))"

                $adGroup = Get-ADGroup -LDAPFilter $ldapFilter -SearchBase $SearchBaseOU -ErrorAction Stop

                if ($adGroup) {
                    Write-Log ("✅ Found AD Group in {0}: {1} (sAM={2})" -f $SearchBaseOU, $adGroup.Name, $adGroup.SamAccountName) 'Green'
                    return $adGroup.SamAccountName
                } else {
                    Write-Log ("❌ Group not found under {0}. Re-enter." -f $SearchBaseOU) 'Red'
                }
            } catch {
                Write-Log ("❌ Error searching AD for '{0}' in {1}: {2}" -f $g, $SearchBaseOU, $_.Exception.Message) 'Red'
            }
        } else {
            Write-Log '⚠️ AD module not loaded, proceeding with provided group name (will add as UPN).' 'Yellow'
            return $g
        }
    }
}

# --- Helper: get current safe members ---
function Get-SafeMemberNames {
    param(
        [Parameter(Mandatory)][string]$SafeName
    )

    $names = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)

    try {
        $members = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
        foreach ($m in $members) {
            $candidate = $null

            if ($m.PSObject.Properties.Name -contains 'MemberName') {
                $candidate = [string]$m.MemberName
            } elseif ($m.PSObject.Properties.Name -contains 'UserName') {
                $candidate = [string]$m.UserName
            } elseif ($m.PSObject.Properties.Name -contains 'Username') {
                $candidate = [string]$m.Username
            }

            if (-not [string]::IsNullOrWhiteSpace($candidate)) {
                [void]$names.Add($candidate)
            }
        }
    } catch {
        Write-Log ("⚠️ Could not pre-read existing members for safe '{0}': {1}" -f $SafeName, $_.Exception.Message) 'Yellow'
    }

    return $names
}

# --- Member add helper (psPAS) ---
function Add-MemberToSafe {
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,
        [Parameter(Mandatory)][ValidateSet('Group','User','Role')][string]$MemberType,
        [Parameter(Mandatory)][pscustomobject]$Permissions,
        [Parameter()][System.Collections.Generic.HashSet[string]]$ExistingMembers
    )

    try {
        if ($ExistingMembers -and $ExistingMembers.Contains($MemberName)) {
            Write-Log ("ℹ️ Skipping {0} '{1}' because it is already a member of {2}." -f $MemberType, $MemberName, $SafeName) 'Yellow'
            return $true
        }

        Write-Log ("Adding {0} '{1}' to {2}..." -f $MemberType, $MemberName, $SafeName)

        $Permissions | Add-PASSafeMember -SafeName $SafeName -MemberType $MemberType -MemberName $MemberName -ErrorAction Stop | Out-Null

        if ($ExistingMembers) {
            [void]$ExistingMembers.Add($MemberName)
        }

        Write-Log ("✅ Added {0}: {1}." -f $MemberType, $MemberName) 'Green'
        return $true
    } catch {
        Write-Log ("❌ Failed to add '{0}' - {1}" -f $MemberName, $_.Exception.Message) 'Red'
        return $false
    }
}

# =========================
# MAIN
# =========================
$response = $null
try {
    $response = Start-PASSessionFromCCP -ObjectName $CCPObject
} catch {
    exit 1
}

try {
    # Prompt for Safe Name
    $SafeName = Read-Host 'Enter the Safe Name'

    # GUI InputBox for description; fallback to Read-Host
    $DescriptionRaw = $null
    try {
        Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop
        $DescriptionRaw = [Microsoft.VisualBasic.Interaction]::InputBox(
            'Paste a single-line description for the Safe (max 200 chars).',
            'Safe Description',
            ''
        )
    } catch {
        Show-Box -Title 'Safe Description' `
            -BodyLine1 'Paste a single-line description for the Safe (max 200 characters).' `
            -BodyLine2 "Example: 'Service accounts for AppX PROD'."
        $DescriptionRaw = Read-Host 'Enter the Safe Description (single line, up to 200 chars)'
    }

    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        Write-Log '❌ ERROR: Safe Name cannot be empty. Exiting...' 'Red'
        exit 1
    }

    if ([string]::IsNullOrWhiteSpace($DescriptionRaw)) {
        Write-Log '❌ ERROR: Safe Description cannot be empty. Exiting...' 'Red'
        exit 1
    }

    $Description = $DescriptionRaw.Trim()
    if ($Description.Length -gt 200) {
        Write-Log 'ℹ️ Safe Description >200 chars, auto-truncating.' 'Yellow'
        $Description = $Description.Substring(0, 200)
    }

    # Create Safe
    try {
        Write-Log ("🔹 Creating Safe: {0}..." -f $SafeName)
        Add-PASSafe `
            -SafeName $SafeName `
            -ManagingCPM $ManagingCPM `
            -Description $Description `
            -NumberOfDaysRetention $NumberOfDaysRetention `
            -ErrorAction Stop | Out-Null

        Write-Log ("✅ Successfully created Safe: {0}." -f $SafeName) 'Green'
    } catch {
        Write-Log ("⚠️ Could not create Safe '{0}': {1}. Continuing to member add..." -f $SafeName, $_.Exception.Message) 'Yellow'
    }

    # Read target AD group
    $GroupSam       = Read-ValidGroup
    $TargetGroupUPN = "$GroupSam@cna.com"

    # Read existing members once to avoid duplicate add failures
    $existingMembers = Get-SafeMemberNames -SafeName $SafeName

    # Members to add
    $MembersToAdd = @(
        @{ Name = $TargetGroupUPN;  Type = 'Group'; Perm = $LimitedPermPAS }, # target AD group (Limited)
        @{ Name = $AdminGroup;      Type = 'Group'; Perm = $FullPermPAS    }, # Full
        @{ Name = $AdminMember;     Type = 'User';  Perm = $FullPermPAS    }, # Full
        @{ Name = $IdentityMember;  Type = 'User';  Perm = $FullPermPAS    }  # Full
    ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_.Name) }

    foreach ($m in $MembersToAdd) {
        [void](Add-MemberToSafe `
            -SafeName $SafeName `
            -MemberName $m.Name `
            -MemberType $m.Type `
            -Permissions $m.Perm `
            -ExistingMembers $existingMembers)
    }

    Write-Log '✅ Safe member addition process completed.' 'Green'
    Write-Log '✅ Completed Safe creation and member onboarding using cnarestbot CCP authentication.' 'Green'
}
finally {
    try {
        Close-PASSession | Out-Null
        Write-Log '✅ PAS session closed.' 'Green'
    } catch {}
}
