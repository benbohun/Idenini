#requires -Version 5.1
<#
.SYNOPSIS
    Compares Website accounts on GEN-E* platforms against Operating System
    accounts on WIN-DOMAIN* platforms by Username and Address.

.DESCRIPTION
    1. Prompts for the Website account inventory CSV.
    2. Prompts for the Operating System account inventory CSV.
    3. Filters the Website CSV to:
         - Platform ID beginning with GEN-E
         - Platform Type = Website, when a Platform Type column is present
    4. Filters the Operating System CSV to:
         - Platform Name or Platform ID beginning with WIN-DOMAIN
         - Platform Type = Operating System, when a Platform Type column is present
    5. Compares normalized Username + normalized Address.
    6. Prompts for the main output CSV and also produces separate matched,
       unmatched, and excluded-row reports.

    Uses only local CSV files. No API, CCP, vault, network, or authentication is used.
    Uses native PowerShell arrays to avoid Windows PowerShell 5.1 generic-list binder errors.

    Designed for Windows PowerShell 5.1.
#>

[CmdletBinding()]
param()

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

Add-Type -AssemblyName System.Windows.Forms

$WebsitePlatformPrefix = 'GEN-E'
$OperatingSystemPlatformPrefix = 'WIN-DOMAIN'

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [ValidateSet('INFO', 'SUCCESS', 'WARNING', 'ERROR')]
        [string]$Level,

        [Parameter(Mandatory = $true)]
        [string]$Message
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    Write-Host ('{0} | {1,-7} | {2}' -f $timestamp, $Level, $Message)
}

function Select-CsvFile {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Title
    )

    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Title = $Title
    $dialog.Filter = 'CSV files (*.csv)|*.csv|All files (*.*)|*.*'
    $dialog.Multiselect = $false
    $dialog.CheckFileExists = $true
    $dialog.CheckPathExists = $true
    $dialog.RestoreDirectory = $true

    try {
        $result = $dialog.ShowDialog()
        if ($result -ne [System.Windows.Forms.DialogResult]::OK) {
            throw "File selection was cancelled: $Title"
        }

        return $dialog.FileName
    }
    finally {
        $dialog.Dispose()
    }
}

function Select-OutputCsvFile {
    [CmdletBinding()]
    param()

    $dialog = New-Object System.Windows.Forms.SaveFileDialog
    $dialog.Title = 'Save the Website-to-Operating-System comparison result'
    $dialog.Filter = 'CSV files (*.csv)|*.csv'
    $dialog.DefaultExt = 'csv'
    $dialog.AddExtension = $true
    $dialog.OverwritePrompt = $true
    $dialog.RestoreDirectory = $true
    $dialog.FileName = 'Website_to_WIN-DOMAIN_Comparison_{0}.csv' -f (Get-Date -Format 'yyyyMMdd_HHmmss')

    try {
        $result = $dialog.ShowDialog()
        if ($result -ne [System.Windows.Forms.DialogResult]::OK) {
            throw 'Output file selection was cancelled.'
        }

        return $dialog.FileName
    }
    finally {
        $dialog.Dispose()
    }
}

function ConvertTo-NormalizedHeader {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value.Trim().ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function Resolve-CsvColumn {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Rows,

        [Parameter(Mandatory = $true)]
        [string[]]$Candidates,

        [Parameter(Mandatory = $true)]
        [string]$Description,

        [switch]$Required
    )

    if ($Rows.Count -eq 0) {
        if ($Required) {
            throw "Cannot resolve the $Description column because the CSV contains no data rows."
        }

        return $null
    }

    $headers = @($Rows[0].PSObject.Properties.Name)

    foreach ($candidate in $Candidates) {
        $exactMatch = $headers |
            Where-Object { $_ -ieq $candidate } |
            Select-Object -First 1

        if ($null -ne $exactMatch) {
            return [string]$exactMatch
        }
    }

    $normalizedCandidates = @{}
    foreach ($candidate in $Candidates) {
        $normalizedCandidates[(ConvertTo-NormalizedHeader -Value $candidate)] = $true
    }

    foreach ($header in $headers) {
        $normalizedHeader = ConvertTo-NormalizedHeader -Value $header
        if ($normalizedCandidates.ContainsKey($normalizedHeader)) {
            return [string]$header
        }
    }

    if ($Required) {
        throw (
            "Unable to locate the required $Description column. " +
            "Accepted column names: {0}. Available columns: {1}" -f
            ($Candidates -join ', '),
            ($headers -join ', ')
        )
    }

    return $null
}

function Get-RowValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object]$Row,

        [AllowNull()]
        [string]$ColumnName
    )

    if ([string]::IsNullOrWhiteSpace($ColumnName)) {
        return $null
    }

    $property = $Row.PSObject.Properties[$ColumnName]
    if ($null -eq $property -or $null -eq $property.Value) {
        return $null
    }

    return [string]$property.Value
}

function ConvertTo-ComparableText {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value.Trim().ToLowerInvariant()) -replace '[^a-z0-9]', '')
}

function ConvertTo-NormalizedUsername {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [string]$Username
    )

    if ([string]::IsNullOrWhiteSpace($Username)) {
        return ''
    }

    return $Username.Trim().Trim('"').Trim("'").ToLowerInvariant()
}

function ConvertTo-NormalizedAddress {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [string]$Address
    )

    if ([string]::IsNullOrWhiteSpace($Address)) {
        return ''
    }

    $workingValue = $Address.Trim().Trim('"').Trim("'")
    $parsedUri = $null

    # Website exports may contain a full URL while the OS export contains only
    # the host/FQDN. When possible, compare the URL host.
    if (
        [System.Uri]::TryCreate(
            $workingValue,
            [System.UriKind]::Absolute,
            [ref]$parsedUri
        ) -and
        -not [string]::IsNullOrWhiteSpace($parsedUri.Host)
    ) {
        $workingValue = $parsedUri.Host
    }
    else {
        $workingValue = $workingValue -replace '^[a-zA-Z][a-zA-Z0-9+\-.]*://', ''
        $workingValue = ($workingValue -split '[/?#]', 2)[0]

        # Remove a simple TCP port when one is present.
        if ($workingValue -match '^\[(.+)\](?::\d+)?$') {
            $workingValue = $Matches[1]
        }
        elseif ($workingValue -match '^([^:]+):\d+$') {
            $workingValue = $Matches[1]
        }
    }

    return $workingValue.Trim().TrimEnd('.').ToLowerInvariant()
}

function New-ComparisonKey {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$NormalizedUsername,

        [Parameter(Mandatory = $true)]
        [string]$NormalizedAddress
    )

    return '{0}|{1}' -f $NormalizedUsername, $NormalizedAddress
}

function Test-StartsWithPrefix {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [string]$Value,

        [Parameter(Mandatory = $true)]
        [string]$Prefix
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return $false
    }

    return $Value.Trim().StartsWith(
        $Prefix,
        [System.StringComparison]::OrdinalIgnoreCase
    )
}

function Export-Report {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [AllowEmptyCollection()]
        [object[]]$Data,

        [Parameter(Mandatory = $true)]
        [string]$Path,

        [Parameter(Mandatory = $true)]
        [string[]]$Headers
    )

    if ($Data.Count -gt 0) {
        $Data | Export-Csv -LiteralPath $Path -NoTypeInformation -Encoding UTF8
        return
    }

    # Create a valid header-only CSV even when there are no data rows.
    $headerLine = ($Headers | ForEach-Object {
        '"{0}"' -f ([string]$_ -replace '"', '""')
    }) -join ','

    Set-Content -LiteralPath $Path -Value $headerLine -Encoding UTF8
}

try {
    Write-Log -Level INFO -Message 'Local Website-to-Operating-System CSV comparison starting.'

    $websiteCsvPath = Select-CsvFile -Title 'STEP 1 OF 2 - Select the Website account CSV containing GEN-E platform accounts'
    $operatingSystemCsvPath = Select-CsvFile -Title 'STEP 2 OF 2 - Select the Operating System account CSV containing WIN-DOMAIN platform accounts'
    $outputCsvPath = Select-OutputCsvFile

    Write-Log -Level INFO -Message "Website CSV         : $websiteCsvPath"
    Write-Log -Level INFO -Message "Operating System CSV: $operatingSystemCsvPath"
    Write-Log -Level INFO -Message "Main output CSV      : $outputCsvPath"

    $websiteRows = @(Import-Csv -LiteralPath $websiteCsvPath)
    $operatingSystemRows = @(Import-Csv -LiteralPath $operatingSystemCsvPath)

    if ($websiteRows.Count -eq 0) {
        throw 'The selected Website CSV contains no data rows.'
    }

    if ($operatingSystemRows.Count -eq 0) {
        throw 'The selected Operating System CSV contains no data rows.'
    }

    Write-Log -Level INFO -Message "Website rows imported         : $($websiteRows.Count)"
    Write-Log -Level INFO -Message "Operating System rows imported: $($operatingSystemRows.Count)"

    # Website CSV column mapping
    $websiteUsernameColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Username', 'User Name', 'Account Username', 'AccountUsername') `
        -Description 'Website Username' -Required

    $websiteAddressColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Address', 'Account Address', 'AccountAddress', 'Host', 'Hostname', 'URL', 'Website Address') `
        -Description 'Website Address' -Required

    $websitePlatformIdColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Platform ID', 'PlatformID', 'Platform Id', 'PlatformId', 'Platform') `
        -Description 'Website Platform ID' -Required

    $websitePlatformTypeColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Platform Type', 'PlatformType', 'Device Type', 'DeviceType') `
        -Description 'Website Platform Type'

    $websiteAccountIdColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Account ID', 'AccountID', 'Account Id', 'AccountId') `
        -Description 'Website Account ID'

    $websiteAccountNameColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Account Name', 'AccountName', 'Name') `
        -Description 'Website Account Name'

    $websiteSafeColumn = Resolve-CsvColumn -Rows $websiteRows `
        -Candidates @('Safe', 'Safe Name', 'SafeName') `
        -Description 'Website Safe'

    # Operating System CSV column mapping
    $osUsernameColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Username', 'User Name', 'Account Username', 'AccountUsername') `
        -Description 'Operating System Username' -Required

    $osAddressColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Address', 'Account Address', 'AccountAddress', 'Host', 'Hostname', 'Machine Address') `
        -Description 'Operating System Address' -Required

    $osPlatformNameColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Platform Name', 'PlatformName', 'Platform ID', 'PlatformID', 'Platform Id', 'PlatformId', 'Platform') `
        -Description 'Operating System Platform Name or Platform ID' -Required

    $osPlatformTypeColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Platform Type', 'PlatformType', 'Device Type', 'DeviceType') `
        -Description 'Operating System Platform Type'

    $osAccountIdColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Account ID', 'AccountID', 'Account Id', 'AccountId') `
        -Description 'Operating System Account ID'

    $osAccountNameColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Account Name', 'AccountName', 'Name') `
        -Description 'Operating System Account Name'

    $osSafeColumn = Resolve-CsvColumn -Rows $operatingSystemRows `
        -Candidates @('Safe', 'Safe Name', 'SafeName') `
        -Description 'Operating System Safe'

    Write-Log -Level INFO -Message (
        "Website mapping: Username='$websiteUsernameColumn'; Address='$websiteAddressColumn'; " +
        "PlatformID='$websitePlatformIdColumn'; PlatformType='$websitePlatformTypeColumn'"
    )

    Write-Log -Level INFO -Message (
        "OS mapping     : Username='$osUsernameColumn'; Address='$osAddressColumn'; " +
        "PlatformName='$osPlatformNameColumn'; PlatformType='$osPlatformTypeColumn'"
    )

    $excludedRows = @()
    $websiteAccounts = @()
    $osAccounts = @()

    for ($index = 0; $index -lt $websiteRows.Count; $index++) {
        $row = $websiteRows[$index]
        $csvRowNumber = $index + 2
        $platformId = Get-RowValue -Row $row -ColumnName $websitePlatformIdColumn
        $platformType = Get-RowValue -Row $row -ColumnName $websitePlatformTypeColumn
        $username = Get-RowValue -Row $row -ColumnName $websiteUsernameColumn
        $address = Get-RowValue -Row $row -ColumnName $websiteAddressColumn

        if (-not (Test-StartsWithPrefix -Value $platformId -Prefix $WebsitePlatformPrefix)) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Website CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformId
                PlatformType = $platformType
                Reason       = "Platform ID does not start with '$WebsitePlatformPrefix'."
            }
            continue
        }

        if (
            -not [string]::IsNullOrWhiteSpace($websitePlatformTypeColumn) -and
            (ConvertTo-ComparableText -Value $platformType) -ne 'website'
        ) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Website CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformId
                PlatformType = $platformType
                Reason       = "Platform Type is not 'Website'."
            }
            continue
        }

        $normalizedUsername = ConvertTo-NormalizedUsername -Username $username
        $normalizedAddress = ConvertTo-NormalizedAddress -Address $address

        if ([string]::IsNullOrWhiteSpace($normalizedUsername) -or [string]::IsNullOrWhiteSpace($normalizedAddress)) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Website CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformId
                PlatformType = $platformType
                Reason       = 'Username or Address is blank after normalization.'
            }
            continue
        }

        $websiteAccounts += [pscustomobject]@{
            CsvRowNumber      = $csvRowNumber
            AccountID         = Get-RowValue -Row $row -ColumnName $websiteAccountIdColumn
            AccountName       = Get-RowValue -Row $row -ColumnName $websiteAccountNameColumn
            Safe              = Get-RowValue -Row $row -ColumnName $websiteSafeColumn
            Username          = $username
            Address           = $address
            PlatformID        = $platformId
            PlatformType      = $platformType
            NormalizedUsername = $normalizedUsername
            NormalizedAddress  = $normalizedAddress
        }
    }

    for ($index = 0; $index -lt $operatingSystemRows.Count; $index++) {
        $row = $operatingSystemRows[$index]
        $csvRowNumber = $index + 2
        $platformName = Get-RowValue -Row $row -ColumnName $osPlatformNameColumn
        $platformType = Get-RowValue -Row $row -ColumnName $osPlatformTypeColumn
        $username = Get-RowValue -Row $row -ColumnName $osUsernameColumn
        $address = Get-RowValue -Row $row -ColumnName $osAddressColumn

        if (-not (Test-StartsWithPrefix -Value $platformName -Prefix $OperatingSystemPlatformPrefix)) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Operating System CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformName
                PlatformType = $platformType
                Reason       = "Platform Name or ID does not start with '$OperatingSystemPlatformPrefix'."
            }
            continue
        }

        if (
            -not [string]::IsNullOrWhiteSpace($osPlatformTypeColumn) -and
            (ConvertTo-ComparableText -Value $platformType) -ne 'operatingsystem'
        ) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Operating System CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformName
                PlatformType = $platformType
                Reason       = "Platform Type is not 'Operating System'."
            }
            continue
        }

        $normalizedUsername = ConvertTo-NormalizedUsername -Username $username
        $normalizedAddress = ConvertTo-NormalizedAddress -Address $address

        if ([string]::IsNullOrWhiteSpace($normalizedUsername) -or [string]::IsNullOrWhiteSpace($normalizedAddress)) {
            $excludedRows += [pscustomobject]@{
                Source       = 'Operating System CSV'
                CsvRowNumber = $csvRowNumber
                Username     = $username
                Address      = $address
                Platform     = $platformName
                PlatformType = $platformType
                Reason       = 'Username or Address is blank after normalization.'
            }
            continue
        }

        $osAccounts += [pscustomobject]@{
            CsvRowNumber       = $csvRowNumber
            AccountID          = Get-RowValue -Row $row -ColumnName $osAccountIdColumn
            AccountName        = Get-RowValue -Row $row -ColumnName $osAccountNameColumn
            Safe               = Get-RowValue -Row $row -ColumnName $osSafeColumn
            Username           = $username
            Address            = $address
            PlatformName       = $platformName
            PlatformType       = $platformType
            NormalizedUsername = $normalizedUsername
            NormalizedAddress  = $normalizedAddress
        }
    }

    Write-Log -Level INFO -Message "Eligible GEN-E Website accounts : $($websiteAccounts.Count)"
    Write-Log -Level INFO -Message "Eligible WIN-DOMAIN OS accounts : $($osAccounts.Count)"
    Write-Log -Level INFO -Message "Excluded input rows             : $($excludedRows.Count)"

    if ($websiteAccounts.Count -eq 0) {
        throw "No eligible Website accounts were found with a Platform ID starting with '$WebsitePlatformPrefix'."
    }

    $osIndex = @{}

    foreach ($osAccount in $osAccounts) {
        $key = New-ComparisonKey `
            -NormalizedUsername $osAccount.NormalizedUsername `
            -NormalizedAddress $osAccount.NormalizedAddress

        if (-not $osIndex.ContainsKey($key)) {
            $osIndex[$key] = @()
        }

        $osIndex[$key] += $osAccount
    }

    $results = @()
    $matchedWebsiteAccountCount = 0
    $unmatchedWebsiteAccountCount = 0
    $multipleMatchWebsiteAccountCount = 0

    foreach ($websiteAccount in $websiteAccounts) {
        $key = New-ComparisonKey `
            -NormalizedUsername $websiteAccount.NormalizedUsername `
            -NormalizedAddress $websiteAccount.NormalizedAddress

        if ($osIndex.ContainsKey($key)) {
            $matches = $osIndex[$key]
            $matchedWebsiteAccountCount++

            if ($matches.Count -gt 1) {
                $multipleMatchWebsiteAccountCount++
            }

            foreach ($osMatch in $matches) {
                $status = if ($matches.Count -gt 1) {
                    'Matched-Multiple'
                }
                else {
                    'Matched'
                }

                $results += [pscustomobject]@{
                    MatchStatus                 = $status
                    MatchCount                  = $matches.Count
                    MatchMethod                 = 'Username + Address'
                    NormalizedUsername          = $websiteAccount.NormalizedUsername
                    NormalizedAddress           = $websiteAccount.NormalizedAddress
                    Website_CsvRowNumber        = $websiteAccount.CsvRowNumber
                    Website_AccountID           = $websiteAccount.AccountID
                    Website_AccountName         = $websiteAccount.AccountName
                    Website_Safe                = $websiteAccount.Safe
                    Website_Username            = $websiteAccount.Username
                    Website_Address             = $websiteAccount.Address
                    Website_PlatformID          = $websiteAccount.PlatformID
                    Website_PlatformType        = $websiteAccount.PlatformType
                    OS_CsvRowNumber             = $osMatch.CsvRowNumber
                    OS_AccountID                = $osMatch.AccountID
                    OS_AccountName              = $osMatch.AccountName
                    OS_Safe                     = $osMatch.Safe
                    OS_Username                 = $osMatch.Username
                    OS_Address                  = $osMatch.Address
                    OS_PlatformName             = $osMatch.PlatformName
                    OS_PlatformType             = $osMatch.PlatformType
                    ResultDetail                = 'A WIN-DOMAIN account matched both Username and Address.'
                }
            }
        }
        else {
            $unmatchedWebsiteAccountCount++

            $results += [pscustomobject]@{
                MatchStatus                 = 'Not Matched'
                MatchCount                  = 0
                MatchMethod                 = 'Username + Address'
                NormalizedUsername          = $websiteAccount.NormalizedUsername
                NormalizedAddress           = $websiteAccount.NormalizedAddress
                Website_CsvRowNumber        = $websiteAccount.CsvRowNumber
                Website_AccountID           = $websiteAccount.AccountID
                Website_AccountName         = $websiteAccount.AccountName
                Website_Safe                = $websiteAccount.Safe
                Website_Username            = $websiteAccount.Username
                Website_Address             = $websiteAccount.Address
                Website_PlatformID          = $websiteAccount.PlatformID
                Website_PlatformType        = $websiteAccount.PlatformType
                OS_CsvRowNumber             = $null
                OS_AccountID                = $null
                OS_AccountName              = $null
                OS_Safe                     = $null
                OS_Username                 = $null
                OS_Address                  = $null
                OS_PlatformName             = $null
                OS_PlatformType             = $null
                ResultDetail                = 'No WIN-DOMAIN account matched both Username and Address.'
            }
        }
    }

    $outputDirectory = Split-Path -Path $outputCsvPath -Parent
    $outputBaseName = [System.IO.Path]::GetFileNameWithoutExtension($outputCsvPath)

    $matchedCsvPath = Join-Path -Path $outputDirectory -ChildPath ($outputBaseName + '_Matched.csv')
    $unmatchedCsvPath = Join-Path -Path $outputDirectory -ChildPath ($outputBaseName + '_Unmatched.csv')
    $excludedCsvPath = Join-Path -Path $outputDirectory -ChildPath ($outputBaseName + '_ExcludedRows.csv')

    $resultHeaders = @(
        'MatchStatus',
        'MatchCount',
        'MatchMethod',
        'NormalizedUsername',
        'NormalizedAddress',
        'Website_CsvRowNumber',
        'Website_AccountID',
        'Website_AccountName',
        'Website_Safe',
        'Website_Username',
        'Website_Address',
        'Website_PlatformID',
        'Website_PlatformType',
        'OS_CsvRowNumber',
        'OS_AccountID',
        'OS_AccountName',
        'OS_Safe',
        'OS_Username',
        'OS_Address',
        'OS_PlatformName',
        'OS_PlatformType',
        'ResultDetail'
    )

    $excludedHeaders = @(
        'Source',
        'CsvRowNumber',
        'Username',
        'Address',
        'Platform',
        'PlatformType',
        'Reason'
    )

    $allResults = $results
    $matchedResults = @($allResults | Where-Object { $_.MatchStatus -like 'Matched*' })
    $unmatchedResults = @($allResults | Where-Object { $_.MatchStatus -eq 'Not Matched' })

    Export-Report -Data $allResults -Path $outputCsvPath -Headers $resultHeaders
    Export-Report -Data $matchedResults -Path $matchedCsvPath -Headers $resultHeaders
    Export-Report -Data $unmatchedResults -Path $unmatchedCsvPath -Headers $resultHeaders
    Export-Report -Data $excludedRows -Path $excludedCsvPath -Headers $excludedHeaders

    Write-Log -Level SUCCESS -Message 'Comparison completed successfully.'
    Write-Log -Level INFO -Message "Website accounts with a match    : $matchedWebsiteAccountCount"
    Write-Log -Level INFO -Message "Website accounts without a match : $unmatchedWebsiteAccountCount"
    Write-Log -Level INFO -Message "Website accounts with >1 OS match: $multipleMatchWebsiteAccountCount"
    Write-Log -Level INFO -Message "Total matched output rows         : $($matchedResults.Count)"
    Write-Log -Level INFO -Message "Main report                       : $outputCsvPath"
    Write-Log -Level INFO -Message "Matched report                    : $matchedCsvPath"
    Write-Log -Level INFO -Message "Unmatched report                  : $unmatchedCsvPath"
    Write-Log -Level INFO -Message "Excluded-row report               : $excludedCsvPath"

    [System.Windows.Forms.MessageBox]::Show(
        (
            "Comparison completed successfully.`r`n`r`n" +
            "Website accounts with a match: $matchedWebsiteAccountCount`r`n" +
            "Website accounts without a match: $unmatchedWebsiteAccountCount`r`n" +
            "Website accounts with multiple matches: $multipleMatchWebsiteAccountCount`r`n`r`n" +
            "Main report:`r`n$outputCsvPath"
        ),
        'Local CSV Account Comparison',
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Information
    ) | Out-Null
}
catch {
    $errorMessage = $_.Exception.Message
    $positionMessage = $_.InvocationInfo.PositionMessage
    $stackTrace = $_.ScriptStackTrace

    Write-Log -Level ERROR -Message $errorMessage

    if (-not [string]::IsNullOrWhiteSpace($positionMessage)) {
        Write-Log -Level ERROR -Message ($positionMessage -replace "`r?`n", ' ')
    }

    if (-not [string]::IsNullOrWhiteSpace($stackTrace)) {
        Write-Log -Level ERROR -Message ("Script stack: {0}" -f ($stackTrace -replace "`r?`n", ' | '))
    }

    [System.Windows.Forms.MessageBox]::Show(
        (
            "$errorMessage`r`n`r`n" +
            "$positionMessage`r`n`r`n" +
            "Script stack:`r`n$stackTrace"
        ),
        'Local CSV Account Comparison Failed',
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Error
    ) | Out-Null

    exit 1
}
