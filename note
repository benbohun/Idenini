& "I:\Script\Disabled User\Test-IdentityReportingToken_FromCCP.ps1" -TokenOnly
& "I:\Script\Disabled User\Test-IdentityReportingToken_FromCCP.ps1"

<#
Test-IdentityReportingToken_FromCCP.ps1

Purpose:
- Retrieve CyberArk Identity service user credential from CCP.
- Use that credential to request an Identity OAuth token.
- Test Redrock/query using the reporting scope.
- This script does not update Safes or change anything.

Expected CyberArk Identity OAuth setup:
- Access token URL:
    https://aak4521.my.idaptive.app/oauth2/token/identityapi
- Client ID:
    Service user username returned by CCP
- Client secret:
    Service user password returned by CCP
- Scope:
    reporting
- Grant type:
    client_credentials
- Client authentication:
    Send as Basic auth header
- REST Regex:
    Redrock/query
#>

[CmdletBinding()]
param(
    # ===== Identity tenant =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",

    # OAuth app alias. CyberArk doc uses identityapi.
    [string]$IdentityOAuthAppId = "identityapi",

    # OAuth scope for Redrock reporting.
    [string]$Scope              = "reporting",

    # ===== CCP settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Output =====
    [string]$OutputFolder       = "I:\Script\IDENTITY Script New\logs\IdentityOAuthTest",
    [string]$LogFile            = "",

    # Set this if you want to skip Redrock/query and only test token retrieval.
    [switch]$TokenOnly
)

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Stop"

if (-not (Test-Path -Path $OutputFolder)) {
    New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
}

$RunStamp = Get-Date -Format "yyyyMMdd_HHmmss"

if ([string]::IsNullOrWhiteSpace($LogFile)) {
    $LogFile = Join-Path $OutputFolder "IdentityOAuthTest_$RunStamp.log"
}

function Write-Log {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet("INFO", "WARN", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "$timestamp | $Level | $Message"

    Add-Content -Path $LogFile -Value $entry

    switch ($Level) {
        "SUCCESS" { Write-Host $entry -ForegroundColor Green }
        "WARN"    { Write-Host $entry -ForegroundColor Yellow }
        "ERROR"   { Write-Host $entry -ForegroundColor Red }
        default   { Write-Host $entry -ForegroundColor White }
    }
}

function Get-WebExceptionBody {
    param(
        [Parameter(Mandatory)]
        [System.Management.Automation.ErrorRecord]$ErrorRecord
    )

    try {
        $response = $ErrorRecord.Exception.Response

        if (-not $response) {
            return $ErrorRecord.Exception.Message
        }

        $statusCode = ""
        $statusDesc = ""

        try {
            $statusCode = [int]$response.StatusCode
            $statusDesc = [string]$response.StatusDescription
        }
        catch {
            $statusCode = ""
            $statusDesc = ""
        }

        $stream = $response.GetResponseStream()

        if (-not $stream) {
            return ("HTTP {0} {1}. {2}" -f $statusCode, $statusDesc, $ErrorRecord.Exception.Message)
        }

        $reader = New-Object System.IO.StreamReader($stream)
        $body = $reader.ReadToEnd()
        $reader.Close()

        if ([string]::IsNullOrWhiteSpace($body)) {
            return ("HTTP {0} {1}. {2}" -f $statusCode, $statusDesc, $ErrorRecord.Exception.Message)
        }

        return ("HTTP {0} {1}. Body: {2}" -f $statusCode, $statusDesc, $body)
    }
    catch {
        return $ErrorRecord.Exception.Message
    }
}

function ConvertTo-UrlEncodedValue {
    param(
        [Parameter(Mandatory)]
        [string]$Value
    )

    return [System.Uri]::EscapeDataString($Value)
}

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd("/")
    $loc  = $Location.Trim("/")

    $encodedAppID  = ConvertTo-UrlEncodedValue -Value $AppID
    $encodedSafe   = ConvertTo-UrlEncodedValue -Value $Safe
    $encodedObject = ConvertTo-UrlEncodedValue -Value $Object

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $base, `
        $loc, `
        $encodedAppID, `
        $encodedSafe, `
        $encodedObject

    Write-Log "Retrieving service user credential from CCP."
    Write-Log ("CCP URL: {0}" -f $url)

    try {
        $headers = @{
            "Content-Type" = "application/json"
        }

        $resp = Invoke-RestMethod `
            -Uri $url `
            -Method GET `
            -Headers $headers `
            -UseDefaultCredentials:$WindowsAuth `
            -ErrorAction Stop

        if (-not $resp.UserName -or -not $resp.Content) {
            throw "CCP response is missing UserName or Content."
        }

        Write-Log ("CCP returned service user username: {0}" -f $resp.UserName) "SUCCESS"

        return [PSCustomObject]@{
            UserName = [string]$resp.UserName
            Secret   = [string]$resp.Content
        }
    }
    catch {
        $details = Get-WebExceptionBody -ErrorRecord $_
        throw "CCP credential retrieval failed. $details"
    }
}

function New-BasicAuthHeader {
    param(
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret,
        [switch]$UrlEncodeBeforeBase64
    )

    if ($UrlEncodeBeforeBase64) {
        $pair = "{0}:{1}" -f `
            ([System.Uri]::EscapeDataString($ClientId)), `
            ([System.Uri]::EscapeDataString($ClientSecret))
    }
    else {
        $pair = "{0}:{1}" -f $ClientId, $ClientSecret
    }

    $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
    $basicToken = [Convert]::ToBase64String($bytes)

    return @{
        Authorization = "Basic $basicToken"
    }
}

function Get-IdentityReportingToken {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$IdentityOAuthAppId,
        [Parameter(Mandatory)][string]$ClientId,
        [Parameter(Mandatory)][string]$ClientSecret,
        [Parameter(Mandatory)][string]$Scope
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $appId  = $IdentityOAuthAppId.Trim("/")
    $tokenUri = "$tenant/oauth2/token/$appId"

    Write-Log ("Requesting Identity OAuth token from: {0}" -f $tokenUri)
    Write-Log ("OAuth Client ID from CCP: {0}" -f $ClientId)
    Write-Log ("OAuth Scope: {0}" -f $Scope)

    $body = "grant_type=client_credentials&scope=$([System.Uri]::EscapeDataString($Scope))"

    $attempts = @(
        [PSCustomObject]@{
            Name                 = "Basic auth header using URL-encoded client_id and secret before Base64"
            UrlEncodeBeforeBase64 = $true
        },
        [PSCustomObject]@{
            Name                 = "Basic auth header using raw client_id and secret before Base64"
            UrlEncodeBeforeBase64 = $false
        }
    )

    $lastError = ""

    foreach ($attempt in $attempts) {
        try {
            Write-Log ("Trying token request: {0}" -f $attempt.Name)

            $headers = New-BasicAuthHeader `
                -ClientId $ClientId `
                -ClientSecret $ClientSecret `
                -UrlEncodeBeforeBase64:([bool]$attempt.UrlEncodeBeforeBase64)

            $resp = Invoke-RestMethod `
                -Uri $tokenUri `
                -Method POST `
                -Headers $headers `
                -ContentType "application/x-www-form-urlencoded" `
                -Body $body `
                -ErrorAction Stop

            if (-not $resp.access_token) {
                throw "Token response did not contain access_token."
            }

            Write-Log ("Token request succeeded using: {0}" -f $attempt.Name) "SUCCESS"

            return [PSCustomObject]@{
                AccessToken = [string]$resp.access_token
                TokenType   = [string]$resp.token_type
                ExpiresIn   = $resp.expires_in
                Scope       = $resp.scope
                MethodUsed  = [string]$attempt.Name
            }
        }
        catch {
            $lastError = Get-WebExceptionBody -ErrorRecord $_
            Write-Log ("Token request failed using {0}. Response: {1}" -f $attempt.Name, $lastError) "WARN"
        }
    }

    $message = @"
Unable to retrieve Identity OAuth token.

Last response:
$lastError

Validate:
1. Service user is enabled.
2. Service user is configured as a Service User.
3. Service user is configured as OAuth confidential client.
4. OAuth app alias is correct: $IdentityOAuthAppId
5. Token endpoint is correct: $tokenUri
6. Scope exists exactly as: $Scope
7. Scope REST Regex is exactly: Redrock/query
8. Auth method includes Client Creds.
9. Service user is added under OAuth app Permissions.
10. Service user role has Report Management.
11. CCP password is current for the service user.
"@

    throw $message
}

function Invoke-RedrockQueryTest {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$IdentityTenantURL,
        [Parameter(Mandatory)][string]$AccessToken
    )

    $tenant = $IdentityTenantURL.TrimEnd("/")
    $queryUri = "$tenant/Redrock/query"

    Write-Log ("Testing Redrock query endpoint: {0}" -f $queryUri)

    $headers = @{
        Authorization = "Bearer $AccessToken"
        "Content-Type" = "application/json"
    }

    $payload = @{
        Script = "Select ID, UserName, DisplayName from User ORDER BY UserName COLLATE NOCASE"
        Args = @{
            PageNumber = 1
            PageSize   = 10
            Limit      = 10
            Caching    = -1
        }
    } | ConvertTo-Json -Depth 10

    try {
        $resp = Invoke-RestMethod `
            -Uri $queryUri `
            -Method POST `
            -Headers $headers `
            -Body $payload `
            -ErrorAction Stop

        if ($resp.success -eq $false) {
            throw ("Redrock returned success=false. Message: {0}" -f $resp.Message)
        }

        Write-Log "Redrock query succeeded." "SUCCESS"

        $rows = @()

        if ($resp.Result -and $resp.Result.Results) {
            $rows = @($resp.Result.Results | ForEach-Object { $_.Row })
        }

        Write-Log ("Redrock returned {0} row(s)." -f $rows.Count) "SUCCESS"

        if ($rows.Count -gt 0) {
            Write-Host ""
            Write-Host "Sample Redrock result:" -ForegroundColor Cyan
            $rows | Select-Object -First 10 | Format-Table -AutoSize
        }

        return $resp
    }
    catch {
        $details = Get-WebExceptionBody -ErrorRecord $_
        throw "Redrock query test failed. $details"
    }
}

try {
    Write-Log "CyberArk Identity OAuth token test from CCP starting."
    Write-Log ("IdentityTenantURL: {0}" -f $IdentityTenantURL)
    Write-Log ("IdentityOAuthAppId: {0}" -f $IdentityOAuthAppId)
    Write-Log ("TokenOnly: {0}" -f [bool]$TokenOnly)

    $ccpCredential = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    $tokenResult = Get-IdentityReportingToken `
        -IdentityTenantURL $IdentityTenantURL `
        -IdentityOAuthAppId $IdentityOAuthAppId `
        -ClientId $ccpCredential.UserName `
        -ClientSecret $ccpCredential.Secret `
        -Scope $Scope

    Write-Log ("Access token received. TokenType={0}; ExpiresIn={1}; MethodUsed={2}" -f `
        $tokenResult.TokenType, `
        $tokenResult.ExpiresIn, `
        $tokenResult.MethodUsed) "SUCCESS"

    if ($TokenOnly) {
        Write-Log "TokenOnly was used. Skipping Redrock/query test." "SUCCESS"
        return
    }

    Invoke-RedrockQueryTest `
        -IdentityTenantURL $IdentityTenantURL `
        -AccessToken $tokenResult.AccessToken | Out-Null

    Write-Log "CyberArk Identity OAuth token and Redrock query test completed successfully." "SUCCESS"
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) "ERROR"
}
finally {
    Write-Log ("Log file: {0}" -f $LogFile)
}
