<#
IND_AddNewIdentityUsersToSafe.ps1

RECENT LOGIN VERSION

Purpose:
- Retrieve CyberArk Identity / Privilege Cloud service-user credential from CCP.
- Authenticate to CyberArk Identity OAuth using OAuth2 Client App ID RestAPI.
- Query CyberArk Identity User table for users with recent LastLogin.
- Match each recently logged-in user to an IND Safe:
    IND_<samAccountName>
    IND_<samAccountName>_*
- Add samAccountName@alliantcreditunion.com to the matching IND Safe if missing.
- Apply default individual Safe permissions.
- Export audit results to CSV.

Why this version:
- Event table query failed in this tenant with:
    Argument types do not match
- Full DSUsers query is too slow in a large tenant.
- The business process requires Identity to be the source of truth because idle-user cleanup removes users from IND Safes.
- When a cleaned-up user logs in again, CyberArk Identity User.LastLogin is updated, allowing this script to detect the re-login and restore the user to the matching IND Safe.

Important:
- This script does NOT rename/remove old psPAS modules.
- This script does NOT permanently change server/global/user PSModulePath.
- It uses a private module folder only for this PowerShell process:
    I:\Script\IDENTITY Script New\Onbarding Project\Modules

Recommended:
- For a scheduled task that runs every 15-30 minutes, use -LookbackHours 2.
- For daily processing, use -LookbackDays 1 or omit both because LookbackDays defaults to 1.
- Test query only first:
    .\IND_AddNewIdentityUsersToSafe.ps1 -RecentLoginQueryOnly -LookbackHours 2

Safety:
- Bare execution is dry-run.
- Use -LiveRun to actually add/update Safe members.
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # Confirmed working OAuth Application ID.
    [string]$IdentityOAuthAppId = "RestAPI",

    # OAuth scope configured with REST Regex: Redrock/query
    [string]$OAuthScope         = "reporting",

    # ===== CCP settings =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== IND Safe matching =====
    [string]$IndSafePrefix      = "IND_",
    [string]$DefaultUserDomain  = "alliantcreditunion.com",
    [string]$PreferredSearchIn  = "alliantcreditunion.com",

    # ===== Recent login window =====
    # If LookbackHours is greater than 0, it takes priority.
    # Otherwise LookbackDays is used.
    [int]$LookbackHours         = 0,
    [int]$LookbackDays          = 1,

    # Fallback throttle if DateFunc query fails and script must query recently sorted users then filter locally.
    [int]$MaxRecentLoginRows    = 500,

    # Optional Safe filter for testing.
    # Example: -SafeNameFilter "IND_jdoe*"
    [string]$SafeNameFilter     = "",

    # Optional safety throttle for testing.
    # Example: -MaxUsersForTest 5
    [int]$MaxUsersForTest       = 0,

    # Include users that are not StatusEnum Active.
    [switch]$IncludeNonActive,

    # ===== Output =====
    [string]$OutputFolder       = "I:\Script\IDENTITY Script New\logs\INDSafeUserMembership",
    [string]$CsvFilePath        = "",
    [string]$LogFile            = "",

    # ===== Private module folder for this script only =====
    [string]$ScriptModuleRoot   = "I:\Script\IDENTITY Script New\Onbarding Project\Modules",
    [version]$MinimumPsPASVersion = "6.0.0",

    # ===== Run behavior =====
    [switch]$LiveRun,
    [switch]$UpdateExistingMember,

    # Only validates CCP + OAuth token.
    [switch]$TokenOnly,

    # Only queries recent Identity logins and exports CSV. No Privilege Cloud login or Safe changes.
    [switch]$RecentLoginQueryOnly
)

$DryRun = -not $LiveRun

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = "Stop"

