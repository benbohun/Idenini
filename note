<#
.SYNOPSIS
    Fast CyberArk OMNG-to-AMNG SVC duplicate validator and cleanup utility.

.DESCRIPTION
    Searches CyberArk directly using account search first, avoiding broad Safe search calls that can time out in large PROD tenants.

    Purpose:
      After discovered SVC service accounts have been remediated/moved/duplicated from OMNG
      to AMNG, this script validates which OMNG accounts have a true AMNG duplicate and can
      be cleaned up.

    Pairing model:
      AP-WBK-P-C1-OMNG  -> AP-WBK-P-C1-AMNG
      AP-WBK-OMNG-C1-X  -> AP-WBK-AMNG-C1-X

    Duplicate validation:
      OMNG and AMNG accounts must match on:
        - exact username, case-insensitive
        - exact address, case-insensitive

    Search strategy for speed:
      1. Search Accounts API globally for SVC accounts only.
      2. Locally classify returned account Safes that contain OMNG or AMNG.
      3. Build OMNG/AMNG Safe-pair keys in memory.
      4. Compare in memory by Safe-pair key + username + address.
      5. Export XLSX workbook with separate sheets.
      6. Delete only eligible OMNG accounts when -DeleteOmng -ConfirmDelete YES are supplied.

    This avoids the Safes?search=OMNG / Safes?search=AMNG calls that can return 504 Gateway Timeout in large PROD tenants.

.NOTES
    Designed for Windows PowerShell 5.1.
    Does not retrieve passwords or secrets.
    Does not log bearer tokens.
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    [ValidateSet('dev','prod')]
    [string]$Environment = 'prod',

    [string]$TenantId = '',

    [string]$PVWA = '',

    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    # SVC account search text used inside each OMNG/AMNG Safe.
    [string]$AccountSearchText = 'SVC',

    # Default supports app codes with letters and numbers: SVCF5A, SVCAE3, SVCSN0, etc.
    [string]$ServiceAccountRegex = '^SVC(?<AppCode>[A-Za-z0-9]{3})',

    # Token = OMNG/AMNG must be delimited by start/end, dash, or underscore.
    # Contains = OMNG/AMNG can appear anywhere in the Safe name.
    [ValidateSet('Token','Contains')]
    [string]$SafeMarkerMatchMode = 'Token',

    # Optional domain scoping. Off by default so the script validates every SVC account in paired Safes.
    [switch]$UseAddressDomainFilter,

    [string[]]$AddressDomains = @(
        'prod.mtb.com',
        'cert.mtb.com',
        'dev.mtb.com',
        'atmprod.mtb.com',
        'atmcert.mtb.com',
        'mgmt.local'
    ),

    [ValidateSet('Contains','Exact')]
    [string]$AddressDomainMatchMode = 'Contains',

    [int]$PageLimit = 1000,

    [int]$MaxSafesToProcess = 0,

    [int]$MaxAccountsPerSafe = 0,

    # Account-first mode prevents slow/timeout Safes?search calls.
    # The script queries Accounts?search=SVC first, then classifies OMNG/AMNG Safes locally.
    [switch]$UseLegacySafeSearch,

    # Optional cap for account-search pages. 0 means no cap.
    [int]$MaxAccountSearchPages = 0,

    # Delete only OMNG accounts that have AMNG duplicate validated by username + address.
    [switch]$DeleteOmng,

    [ValidateSet('NO','YES')]
    [string]$ConfirmDelete = 'NO',

    [switch]$ProxyUseDefaultCredentials,

    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    [string]$LogId = ''
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$script:LogFile = $null
$script:XlsxReportFile = $null
$script:PairsCsvFile = $null
$script:DeleteCandidatesCsvFile = $null
$script:Config = $null

function Test-BlankValue {
    param([object]$Value)
    if ($null -eq $Value) { return $true }
    $text = $Value.ToString().Trim()
    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }
    return $false
}

function Get-EnvironmentDefault {
    param([ValidateSet('TenantId','PVWA')][string]$Name)
    if ($Environment -eq 'dev') {
        if ($Name -eq 'TenantId') { return 'abq4291' }
        if ($Name -eq 'PVWA') { return 'https://mtbanktest.privilegecloud.cyberark.cloud' }
    }
    if ($Environment -eq 'prod') {
        if ($Name -eq 'TenantId') { return 'abq4289' }
        if ($Name -eq 'PVWA') { return 'https://mtbank.privilegecloud.cyberark.cloud' }
    }
    return $null
}

function New-RunLog {
    if (-not (Test-Path $LogFolder)) { New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null }
    if (-not (Test-Path $ReportFolder)) { New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null }
    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }
    $script:LogFile = Join-Path $LogFolder "Validate-Cleanup-OMNG-AMNG-SVC_$stamp$suffix.log"
    $script:XlsxReportFile = Join-Path $ReportFolder "OMNG_AMNG_SVC_Cleanup_$stamp$suffix.xlsx"
    $script:PairsCsvFile = Join-Path $ReportFolder "OMNG_AMNG_SVC_ExactPairs_$stamp$suffix.csv"
    $script:DeleteCandidatesCsvFile = Join-Path $ReportFolder "OMNG_AMNG_SVC_DeleteCandidates_$stamp$suffix.csv"
    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) source=New-RunLog [INFO] Starting fast OMNG/AMNG SVC cleanup validation"
}

function Write-RunLog {
    param(
        [string]$Source,
        [string]$Message,
        [ValidateSet('DEBUG','INFO','WARN','ERROR','SUCCESS')][string]$Level = 'INFO'
    )
    $line = "$(Get-Date -Format s) source=$Source [$Level] $Message"
    Add-Content -Path $script:LogFile -Value $line
    if ($Level -eq 'ERROR') { Write-Host $line -ForegroundColor Red }
    elseif ($Level -eq 'WARN') { Write-Host $line -ForegroundColor Yellow }
    elseif ($Level -eq 'SUCCESS') { Write-Host $line -ForegroundColor Green }
    else { Write-Host $line }
}

function Read-DotEnvFile {
    param([string]$Path)
    $result = @{}
    if (-not (Test-Path $Path)) { return $result }
    foreach ($line in (Get-Content -Path $Path -ErrorAction Stop)) {
        $trimmed = $line.Trim()
        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }
        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()
        if ($value.Length -ge 2) {
            if (($value.StartsWith('"') -and $value.EndsWith('"')) -or ($value.StartsWith("'") -and $value.EndsWith("'"))) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }
        if (-not (Test-BlankValue $key)) { $result[$key] = $value }
    }
    return $result
}

function Join-EnvValues {
    param([hashtable[]]$Maps)
    $merged = @{}
    foreach ($map in $Maps) {
        foreach ($key in $map.Keys) { $merged[$key] = $map[$key] }
    }
    return $merged
}

function Normalize-PvwaApiBase {
    param([string]$PvwaValue)
    $base = $PvwaValue.Trim().TrimEnd('/')
    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Accounts/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/.+$', '/PasswordVault/API'
    if ($base -match '/PasswordVault/API$') { return $base }
    if ($base -match '/PasswordVault$') { return "$base/API" }
    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    param([string]$TenantValue)
    $tenant = $TenantValue
    if (Test-BlankValue $tenant) { throw "TENANT_ID could not be resolved. Provide -TenantId, set TENANT_ID in .env/env file, or use -Environment dev/prod defaults." }
    $tenant = $tenant.Trim().TrimEnd('/')
    if ($tenant -match '^https?://') { return $tenant }
    if ($tenant -match '\.id\.cyberark\.cloud$') { return "https://$tenant" }
    if ($tenant -match '\.') { return "https://$tenant" }
    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    param([hashtable]$Settings)
    $proxy = $Settings['PROXY']
    if (-not (Test-BlankValue $proxy)) { return $proxy.Trim() }
    $proxyAddress = $Settings['PROXY_ADDRESS']
    if (Test-BlankValue $proxyAddress) { $proxyAddress = $Settings['ROXY_ADDRESS'] }
    $proxyPort = $Settings['PROXY_PORT']
    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) { return $null }
    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')
    if ($proxyAddress -notmatch '^https?://') { $proxyAddress = "http://$proxyAddress" }
    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"
    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}
    if (Test-Path $envFile1) { $envSpecific = Read-DotEnvFile -Path $envFile1 }
    elseif (Test-Path $envFile2) { $envSpecific = Read-DotEnvFile -Path $envFile2 }
    else { Write-RunLog 'Import-RunConfig' "No environment file found for '$Environment'. Checked '$envFile1' and '$envFile2'. Built-in defaults will be used unless direct parameters are supplied." 'WARN' }
    $settings = Join-EnvValues -Maps @($base, $envSpecific)
    if (-not (Test-BlankValue $TenantId)) { $settings['TENANT_ID'] = $TenantId }
    if (-not (Test-BlankValue $PVWA)) { $settings['PVWA'] = $PVWA }
    if (Test-BlankValue $settings['TENANT_ID']) {
        $settings['TENANT_ID'] = Get-EnvironmentDefault -Name TenantId
        Write-RunLog 'Import-RunConfig' "TENANT_ID was not found in env files. Using built-in $Environment default." 'WARN'
    }
    if (Test-BlankValue $settings['PVWA']) {
        if (-not (Test-BlankValue $settings['SUB_DOMAIN'])) { $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud" }
        else {
            $settings['PVWA'] = Get-EnvironmentDefault -Name PVWA
            Write-RunLog 'Import-RunConfig' "PVWA was not found in env files. Using built-in $Environment default." 'WARN'
        }
    }
    $identityBase = Resolve-IdentityBase -TenantValue $settings['TENANT_ID']
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings
    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)
        if ($ProxyUseDefaultCredentials) { $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials }
        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }
    $script:Config = [pscustomobject]@{
        Environment = $Environment
        IdentityBase = $identityBase
        TokenUrl = "$identityBase/oauth2/platformtoken"
        ApiBase = $apiBase
        Proxy = $proxyFromEnv
    }
    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    param([hashtable]$Body)
    $pairs = @()
    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }
    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    param([string]$Text)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)
        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally { $sha.Dispose() }
}

function Get-WebErrorText {
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)
    $parts = New-Object System.Collections.Generic.List[string]
    if ($null -ne $ErrorRecord.Exception -and -not (Test-BlankValue $ErrorRecord.Exception.Message)) { [void]$parts.Add($ErrorRecord.Exception.Message) }
    $response = $ErrorRecord.Exception.Response
    if ($null -ne $response) {
        try { [void]$parts.Add("HTTPStatus=$([int]$response.StatusCode) $($response.StatusDescription)") } catch {}
    }
    $body = $null
    if ($null -ne $ErrorRecord.ErrorDetails -and -not (Test-BlankValue $ErrorRecord.ErrorDetails.Message)) { $body = [string]$ErrorRecord.ErrorDetails.Message }
    if ((Test-BlankValue $body) -and $null -ne $response) {
        try {
            $stream = $response.GetResponseStream()
            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)
                try { $body = $reader.ReadToEnd() } finally { $reader.Dispose() }
            }
        } catch {}
    }
    if (-not (Test-BlankValue $body)) { [void]$parts.Add("Response=$body") }
    if ($parts.Count -eq 0) { return 'Unknown web request error.' }
    return ($parts -join ' | ')
}

function Get-IdentityBearerToken {
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'
    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'
    $body = ConvertTo-FormBody -Body @{
        grant_type = 'client_credentials'
        client_id = $credential.UserName
        client_secret = $credential.GetNetworkCredential().Password
    }
    $params = @{
        Method = 'Post'
        Uri = $script:Config.TokenUrl
        Body = $body
        ContentType = 'application/x-www-form-urlencoded'
        Headers = @{ Accept = 'application/json' }
        ErrorAction = 'Stop'
    }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { $response = Invoke-RestMethod @params }
    catch { throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)" }
    if ($null -eq $response.access_token) { throw 'Identity token response did not include access_token.' }
    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token
    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'INFO'
    return $token
}

function Invoke-CyberArkRest {
    param(
        [ValidateSet('GET','DELETE')][string]$Method,
        [string]$Path,
        [string]$Token
    )
    if ($Path -match '^https?://') { $uri = $Path }
    else { $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))" }
    $params = @{
        Method = $Method
        Uri = $uri
        Headers = @{ Authorization = "Bearer $Token" }
        ErrorAction = 'Stop'
    }
    if (-not (Test-BlankValue $script:Config.Proxy)) { $params['Proxy'] = $script:Config.Proxy }
    if ($ProxyUseDefaultCredentials) { $params['ProxyUseDefaultCredentials'] = $true }
    try { return Invoke-RestMethod @params }
    catch { throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)" }
}

function ConvertTo-ListFromResponse {
    param([object]$Response, [string[]]$PreferredProperties)
    if ($null -eq $Response) { return @() }
    if ($Response -is [System.Array]) { return @($Response) }
    foreach ($name in $PreferredProperties) {
        $p = $Response.PSObject.Properties[$name]
        if ($null -ne $p) { return @($p.Value) }
    }
    foreach ($name in @('value','Values','items','Items')) {
        $p = $Response.PSObject.Properties[$name]
        if ($null -ne $p) { return @($p.Value) }
    }
    return @($Response)
}

function Get-ObjectField {
    param([object]$Object, [string[]]$Names)
    if ($null -eq $Object) { return '' }
    foreach ($name in $Names) {
        $p = $Object.PSObject.Properties[$name]
        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) { return $p.Value.ToString() }
    }
    return ''
}

function Get-AccountField {
    param([object]$Account, [string[]]$Names)
    return Get-ObjectField -Object $Account -Names $Names
}

function Get-SafeField {
    param([object]$Safe, [string[]]$Names)
    return Get-ObjectField -Object $Safe -Names $Names
}

function Add-UniqueSafeName {
    param([hashtable]$Table, [string]$SafeName, [string]$Source)
    if (Test-BlankValue $SafeName) { return }
    $key = $SafeName.ToUpperInvariant()
    if (-not $Table.ContainsKey($key)) {
        $Table[$key] = [pscustomobject]@{ SafeName = $SafeName; DiscoverySource = $Source }
    }
}

function Get-SafesBySearchTerm {
    param([string]$SearchTerm, [string]$Token)
    $found = @{}
    $offset = 0
    $limit = [Math]::Min([Math]::Max($PageLimit, 1), 1000)
    do {
        $path = "Safes?offset=$offset&limit=$limit&search=$([System.Uri]::EscapeDataString($SearchTerm))"
        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-ListFromResponse -Response $response -PreferredProperties @('Safes','safes','value'))
        foreach ($safe in $items) {
            $name = Get-SafeField -Safe $safe -Names @('safeName','SafeName','safe','Safe','name','Name')
            if (Test-BlankValue $name) { continue }
            if ($name -match "(?i)$([regex]::Escape($SearchTerm))") { Add-UniqueSafeName -Table $found -SafeName $name -Source "SafesSearch:$SearchTerm" }
        }
        $offset += $limit
    } while ($items.Count -eq $limit)
    return @($found.Values)
}

function Get-AllSafesFallback {
    param([string]$Token)
    $found = @{}
    $offset = 0
    $limit = [Math]::Min([Math]::Max($PageLimit, 1), 1000)
    do {
        $path = "Safes?offset=$offset&limit=$limit"
        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-ListFromResponse -Response $response -PreferredProperties @('Safes','safes','value'))
        foreach ($safe in $items) {
            $name = Get-SafeField -Safe $safe -Names @('safeName','SafeName','safe','Safe','name','Name')
            if (Test-BlankValue $name) { continue }
            if ($name -match '(?i)(OMNG|AMNG)') { Add-UniqueSafeName -Table $found -SafeName $name -Source 'SafesFullFallback' }
        }
        $offset += $limit
    } while ($items.Count -eq $limit)
    return @($found.Values)
}

function Get-SafePairInfo {
    param([string]$SafeName)
    if (Test-BlankValue $SafeName) { return $null }
    if ($SafeMarkerMatchMode -eq 'Contains') {
        $match = [regex]::Match($SafeName, '(?i)(OMNG|AMNG)')
        if (-not $match.Success) { return $null }
        $kind = $match.Groups[1].Value.ToUpperInvariant()
        $kindIndex = $match.Groups[1].Index
        $kindLength = $match.Groups[1].Length
    }
    else {
        $match = [regex]::Match($SafeName, '(?i)(^|[-_])(?<Kind>OMNG|AMNG)(?=$|[-_])')
        if (-not $match.Success) { return $null }
        $kind = $match.Groups['Kind'].Value.ToUpperInvariant()
        $kindIndex = $match.Groups['Kind'].Index
        $kindLength = $match.Groups['Kind'].Length
    }
    $pairKind = if ($kind -eq 'OMNG') { 'AMNG' } else { 'OMNG' }
    $pairSafeName = $SafeName.Remove($kindIndex, $kindLength).Insert($kindIndex, $pairKind)
    $pairKey = $SafeName.Remove($kindIndex, $kindLength).Insert($kindIndex, '{PAIR}').ToUpperInvariant()
    return [pscustomobject]@{
        SafeName = $SafeName
        SafeKind = $kind
        ExpectedPairKind = $pairKind
        ExpectedPairSafeName = $pairSafeName
        SafePairKey = $pairKey
    }
}

function Get-RelevantSafePairs {
    param([string]$Token)
    $safeMap = @{}
    foreach ($term in @('OMNG','AMNG')) {
        try {
            $results = @(Get-SafesBySearchTerm -SearchTerm $term -Token $Token)
            foreach ($safe in $results) { Add-UniqueSafeName -Table $safeMap -SafeName $safe.SafeName -Source $safe.DiscoverySource }
            Write-RunLog 'Get-RelevantSafePairs' "Safe search '$term' returned $($results.Count) matching Safe(s)." 'INFO'
        }
        catch {
            Write-RunLog 'Get-RelevantSafePairs' "Safe search '$term' failed. Fallback safe inventory will be attempted. Error=$($_.Exception.Message)" 'WARN'
        }
    }
    if ($safeMap.Count -eq 0) {
        $fallback = @(Get-AllSafesFallback -Token $Token)
        foreach ($safe in $fallback) { Add-UniqueSafeName -Table $safeMap -SafeName $safe.SafeName -Source $safe.DiscoverySource }
        Write-RunLog 'Get-RelevantSafePairs' "Full Safe fallback returned $($fallback.Count) OMNG/AMNG Safe(s)." 'WARN'
    }
    $rows = @()
    foreach ($k in $safeMap.Keys) {
        $safeName = $safeMap[$k].SafeName
        $info = Get-SafePairInfo -SafeName $safeName
        if ($null -eq $info) { continue }
        $rows += [pscustomobject]@{
            SafeName = $safeName
            SafeKind = $info.SafeKind
            ExpectedPairSafeName = $info.ExpectedPairSafeName
            SafePairKey = $info.SafePairKey
            DiscoverySource = $safeMap[$k].DiscoverySource
        }
    }
    return @($rows | Sort-Object SafePairKey, SafeKind, SafeName)
}

function Test-ServiceAccountName {
    param([string]$UserName)
    if (Test-BlankValue $UserName) { return $false }
    return ([regex]::IsMatch($UserName.Trim(), $ServiceAccountRegex, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase))
}

function Test-AddressDomainAllowed {
    param([string]$Address)
    if (-not $UseAddressDomainFilter) { return $true }
    if (Test-BlankValue $Address) { return $false }
    $a = $Address.Trim().ToLowerInvariant()
    foreach ($domain in $AddressDomains) {
        if (Test-BlankValue $domain) { continue }
        $d = $domain.Trim().ToLowerInvariant()
        if ($AddressDomainMatchMode -eq 'Exact') {
            if ($a -eq $d) { return $true }
        }
        else {
            if ($a -like "*$d*") { return $true }
        }
    }
    return $false
}

function Get-MatchedAddressDomain {
    param([string]$Address)
    if (Test-BlankValue $Address) { return '' }
    $a = $Address.Trim().ToLowerInvariant()
    foreach ($domain in $AddressDomains) {
        if (Test-BlankValue $domain) { continue }
        $d = $domain.Trim().ToLowerInvariant()
        if ($AddressDomainMatchMode -eq 'Exact') {
            if ($a -eq $d) { return $d }
        }
        else {
            if ($a -like "*$d*") { return $d }
        }
    }
    return ''
}

function Add-UniqueAccount {
    param([hashtable]$Table, [object]$Account)
    $id = Get-AccountField -Account $Account -Names @('id','ID','accountId','AccountID')
    if (Test-BlankValue $id) { return }
    if (-not $Table.ContainsKey($id)) { $Table[$id] = $Account }
}

function Get-AccountsFromSafe {
    param([string]$SafeName, [string]$Token, [string]$SearchText = $null)
    $found = @{}
    $offset = 0
    $limit = [Math]::Min([Math]::Max($PageLimit, 1), 1000)
    $countForSafe = 0
    do {
        $filterText = "safeName eq $SafeName"
        $path = "Accounts?offset=$offset&limit=$limit&filter=$([System.Uri]::EscapeDataString($filterText))"
        if (-not (Test-BlankValue $SearchText)) { $path += "&search=$([System.Uri]::EscapeDataString($SearchText))&searchType=contains" }
        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-ListFromResponse -Response $response -PreferredProperties @('value','accounts','Accounts'))
        foreach ($item in $items) {
            Add-UniqueAccount -Table $found -Account $item
            $countForSafe++
            if ($MaxAccountsPerSafe -gt 0 -and $countForSafe -ge $MaxAccountsPerSafe) { break }
        }
        if ($MaxAccountsPerSafe -gt 0 -and $countForSafe -ge $MaxAccountsPerSafe) { break }
        $offset += $limit
    } while ($items.Count -eq $limit)
    return @($found.Values)
}


function Get-AccountsByGlobalSearch {
    <#
        Fast account-first search.

        This avoids Safes?search and Safes full inventory calls, which can time out
        in large PROD tenants. It asks CyberArk for accounts matching AccountSearchText
        and filters locally to SVC accounts in Safes containing OMNG/AMNG.
    #>
    param(
        [string]$SearchText,
        [string]$Token
    )

    $found = @{}
    $offset = 0
    $limit = [Math]::Min([Math]::Max($PageLimit, 1), 1000)
    $pageNumber = 0

    do {
        $pageNumber++

        if ($MaxAccountSearchPages -gt 0 -and $pageNumber -gt $MaxAccountSearchPages) {
            Write-RunLog 'Get-AccountsByGlobalSearch' "Stopped account search after MaxAccountSearchPages=$MaxAccountSearchPages." 'WARN'
            break
        }

        $path = "Accounts?offset=$offset&limit=$limit&search=$([System.Uri]::EscapeDataString($SearchText))&searchType=contains"
        Write-RunLog 'Get-AccountsByGlobalSearch' "Fetching Accounts search page $pageNumber offset=$offset limit=$limit search=$SearchText." 'INFO'

        $response = Invoke-CyberArkRest -Method GET -Path $path -Token $Token
        $items = @(ConvertTo-ListFromResponse -Response $response -PreferredProperties @('value','accounts','Accounts'))

        foreach ($item in $items) {
            Add-UniqueAccount -Table $found -Account $item
        }

        $offset += $limit
    } while ($items.Count -eq $limit)

    return @($found.Values)
}

function Convert-AccountToValidationRow {
    param([object]$Account, [pscustomobject]$SafeInfo)
    $userName = Get-AccountField -Account $Account -Names @('userName','username','UserName')
    $address = Get-AccountField -Account $Account -Names @('address','Address')
    $accountId = Get-AccountField -Account $Account -Names @('id','ID','accountId','AccountID')
    $name = Get-AccountField -Account $Account -Names @('name','Name')
    $platformId = Get-AccountField -Account $Account -Names @('platformId','platformID')
    $normalizedUser = if (Test-BlankValue $userName) { '' } else { $userName.Trim().ToUpperInvariant() }
    $normalizedAddress = if (Test-BlankValue $address) { '' } else { $address.Trim().ToUpperInvariant() }
    $matchKey = "$($SafeInfo.SafePairKey)|$normalizedUser|$normalizedAddress"
    return [pscustomobject]@{
        AccountID = $accountId
        AccountName = $name
        UserName = $userName
        Address = $address
        NormalizedUserName = $normalizedUser
        NormalizedAddress = $normalizedAddress
        MatchedDomain = Get-MatchedAddressDomain -Address $address
        SafeName = $SafeInfo.SafeName
        SafeKind = $SafeInfo.SafeKind
        ExpectedPairSafeName = $SafeInfo.ExpectedPairSafeName
        SafePairKey = $SafeInfo.SafePairKey
        UserAddressPairKey = $matchKey
        PlatformId = $platformId
        IsSvcAccount = [string](Test-ServiceAccountName -UserName $userName)
        AddressDomainAllowed = [string](Test-AddressDomainAllowed -Address $address)
    }
}

function Remove-AccountById {
    param([string]$AccountId, [string]$Token)
    $id = [System.Uri]::EscapeDataString($AccountId)
    Invoke-CyberArkRest -Method DELETE -Path "Accounts/$id/" -Token $Token | Out-Null
}

function Export-CsvSafe {
    param([object[]]$Rows, [string]$Path)
    if ($Rows.Count -eq 0) { [pscustomobject]@{ Note = 'No rows' } | Export-Csv -Path $Path -NoTypeInformation; return }
    $Rows | Export-Csv -Path $Path -NoTypeInformation
}

function ConvertTo-ExcelColumnName {
    param([int]$Index)
    $name = ''
    $n = $Index
    while ($n -gt 0) {
        $n--
        $name = [char](65 + ($n % 26)) + $name
        $n = [Math]::Floor($n / 26)
    }
    return $name
}

function Escape-XmlText {
    param([object]$Value)
    if ($null -eq $Value) { return '' }
    $text = [string]$Value
    $text = $text -replace '&', '&amp;'
    $text = $text -replace '<', '&lt;'
    $text = $text -replace '>', '&gt;'
    $text = $text -replace '"', '&quot;'
    $text = $text -replace "'", '&apos;'
    return $text
}

function Get-ObjectPropertyNames {
    param([object[]]$Rows)
    $names = New-Object System.Collections.Generic.List[string]
    foreach ($row in $Rows) {
        if ($null -eq $row) { continue }
        foreach ($p in $row.PSObject.Properties) {
            if (-not $names.Contains($p.Name)) { [void]$names.Add($p.Name) }
        }
    }
    if ($names.Count -eq 0) { [void]$names.Add('Note') }
    return @($names)
}

function New-WorksheetXml {
    param([object[]]$Rows)
    $dataRows = @($Rows)
    if ($dataRows.Count -eq 0) { $dataRows = @([pscustomobject]@{ Note = 'No rows' }) }
    $columns = Get-ObjectPropertyNames -Rows $dataRows
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.Append('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>')
    [void]$sb.Append('<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>')
    [void]$sb.Append('<row r="1">')
    for ($i = 0; $i -lt $columns.Count; $i++) {
        $cellRef = "$(ConvertTo-ExcelColumnName -Index ($i + 1))1"
        [void]$sb.Append(('<c r="{0}" t="inlineStr"><is><t>' -f $cellRef))
        [void]$sb.Append((Escape-XmlText $columns[$i]))
        [void]$sb.Append('</t></is></c>')
    }
    [void]$sb.Append('</row>')
    $rowIndex = 2
    foreach ($row in $dataRows) {
        [void]$sb.Append(('<row r="{0}">' -f $rowIndex))
        for ($i = 0; $i -lt $columns.Count; $i++) {
            $name = $columns[$i]
            $value = ''
            $p = $row.PSObject.Properties[$name]
            if ($null -ne $p -and $null -ne $p.Value) { $value = [string]$p.Value }
            $cellRef = "$(ConvertTo-ExcelColumnName -Index ($i + 1))$rowIndex"
            [void]$sb.Append(('<c r="{0}" t="inlineStr"><is><t>' -f $cellRef))
            [void]$sb.Append((Escape-XmlText $value))
            [void]$sb.Append('</t></is></c>')
        }
        [void]$sb.Append('</row>')
        $rowIndex++
    }
    [void]$sb.Append('</sheetData></worksheet>')
    return $sb.ToString()
}

function Add-ZipEntryText {
    param([System.IO.Compression.ZipArchive]$Zip, [string]$EntryName, [string]$Text)
    $entry = $Zip.CreateEntry($EntryName)
    $stream = $entry.Open()
    $writer = New-Object System.IO.StreamWriter($stream, (New-Object System.Text.UTF8Encoding($false)))
    try { $writer.Write($Text) }
    finally { $writer.Dispose(); $stream.Dispose() }
}

function Export-XlsxWorkbook {
    param([hashtable]$Sheets, [string]$Path)
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if (Test-Path $Path) { Remove-Item -Path $Path -Force }
    $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::CreateNew)
    $zip = New-Object System.IO.Compression.ZipArchive($fs, [System.IO.Compression.ZipArchiveMode]::Create)
    try {
        $sheetNames = @($Sheets.Keys | Sort-Object)
        $contentTypes = New-Object System.Text.StringBuilder
        [void]$contentTypes.Append('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>')
        [void]$contentTypes.Append('<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">')
        [void]$contentTypes.Append('<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>')
        [void]$contentTypes.Append('<Default Extension="xml" ContentType="application/xml"/>')
        [void]$contentTypes.Append('<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>')
        [void]$contentTypes.Append('<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>')
        for ($i = 1; $i -le $sheetNames.Count; $i++) {
            [void]$contentTypes.Append(('<Override PartName="/xl/worksheets/sheet{0}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>' -f $i))
        }
        [void]$contentTypes.Append('</Types>')
        Add-ZipEntryText -Zip $zip -EntryName '[Content_Types].xml' -Text $contentTypes.ToString()
        Add-ZipEntryText -Zip $zip -EntryName '_rels/.rels' -Text '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'
        $workbook = New-Object System.Text.StringBuilder
        [void]$workbook.Append('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>')
        [void]$workbook.Append('<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>')
        $rels = New-Object System.Text.StringBuilder
        [void]$rels.Append('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>')
        [void]$rels.Append('<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">')
        for ($i = 1; $i -le $sheetNames.Count; $i++) {
            $sheetName = $sheetNames[$i - 1]
            $safeName = $sheetName
            if ($safeName.Length -gt 31) { $safeName = $safeName.Substring(0, 31) }
            [void]$workbook.Append(('<sheet name="{0}" sheetId="{1}" r:id="rId{1}"/>' -f (Escape-XmlText $safeName), $i))
            [void]$rels.Append(('<Relationship Id="rId{0}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet{0}.xml"/>' -f $i))
            Add-ZipEntryText -Zip $zip -EntryName "xl/worksheets/sheet$i.xml" -Text (New-WorksheetXml -Rows @($Sheets[$sheetName]))
        }
        [void]$workbook.Append('</sheets></workbook>')
        [void]$rels.Append('</Relationships>')
        Add-ZipEntryText -Zip $zip -EntryName 'xl/workbook.xml' -Text $workbook.ToString()
        Add-ZipEntryText -Zip $zip -EntryName 'xl/_rels/workbook.xml.rels' -Text $rels.ToString()
        Add-ZipEntryText -Zip $zip -EntryName 'xl/styles.xml' -Text '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="1"><font><sz val="11"/><name val="Calibri"/></font></fonts><fills count="1"><fill><patternFill patternType="none"/></fill></fills><borders count="1"><border/></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/></cellXfs></styleSheet>'
    }
    finally { $zip.Dispose(); $fs.Dispose() }
}

function Start-FastSvcPairCleanup {
    New-RunLog
    Import-RunConfig

    if ($DeleteOmng -and $ConfirmDelete -ne 'YES') {
        Write-RunLog 'Start-FastSvcPairCleanup' 'DeleteOmng supplied without ConfirmDelete YES. No deletion will be performed.' 'WARN'
    }

    if ($UseLegacySafeSearch) {
        Write-RunLog 'Start-FastSvcPairCleanup' 'Legacy mode enabled: Safe search first, then SVC account lookup per paired Safe.' 'WARN'
    }
    else {
        Write-RunLog 'Start-FastSvcPairCleanup' 'Account-first fast mode enabled: searching Accounts API for SVC first, then classifying OMNG/AMNG Safes locally. No Safes?search call will be used.' 'INFO'
    }

    Write-RunLog 'Start-FastSvcPairCleanup' "SafeMarkerMatchMode=$SafeMarkerMatchMode AccountSearchText=$AccountSearchText ServiceAccountRegex=$ServiceAccountRegex UseAddressDomainFilter=$UseAddressDomainFilter" 'INFO'

    $token = Get-IdentityBearerToken

    $allAccountRows = @()
    $safeFetchRows = @()
    $safeRows = @()
    $requiredSafes = @()

    if ($UseLegacySafeSearch) {
        $safeRows = @(Get-RelevantSafePairs -Token $token)

        if ($safeRows.Count -eq 0) {
            throw 'No OMNG/AMNG Safes were found or the API user cannot list Safes.'
        }

        $safeRows = @($safeRows | Where-Object { $_.SafeKind -eq 'OMNG' -or $_.SafeKind -eq 'AMNG' })
        Write-RunLog 'Start-FastSvcPairCleanup' "Found $($safeRows.Count) OMNG/AMNG Safe marker row(s)." 'INFO'

        $safeNameMap = @{}
        foreach ($s in $safeRows) {
            $safeNameMap[$s.SafeName.ToUpperInvariant()] = $s
        }

        $requiredSafeMap = @{}
        foreach ($s in ($safeRows | Where-Object { $_.SafeKind -eq 'OMNG' })) {
            $requiredSafeMap[$s.SafeName.ToUpperInvariant()] = $s
            $pairKey = $s.ExpectedPairSafeName.ToUpperInvariant()

            if ($safeNameMap.ContainsKey($pairKey)) {
                $requiredSafeMap[$pairKey] = $safeNameMap[$pairKey]
            }
        }

        $requiredSafes = @($requiredSafeMap.Values | Sort-Object SafePairKey, SafeKind, SafeName)

        if ($MaxSafesToProcess -gt 0) {
            $requiredSafes = @($requiredSafes | Select-Object -First $MaxSafesToProcess)
        }

        Write-RunLog 'Start-FastSvcPairCleanup' "Fetching SVC accounts from $($requiredSafes.Count) relevant OMNG/AMNG Safe(s)." 'INFO'

        $safeIndex = 1

        foreach ($safe in $requiredSafes) {
            Write-RunLog 'Start-FastSvcPairCleanup' "[$safeIndex/$($requiredSafes.Count)] Fetching accounts from Safe=$($safe.SafeName) Kind=$($safe.SafeKind)." 'INFO'

            try {
                $accounts = @(Get-AccountsFromSafe -SafeName $safe.SafeName -Token $token -SearchText $AccountSearchText)
                $kept = 0

                foreach ($account in $accounts) {
                    $row = Convert-AccountToValidationRow -Account $account -SafeInfo $safe

                    if ($row.IsSvcAccount -ne 'True') { continue }
                    if ($row.AddressDomainAllowed -ne 'True') { continue }

                    $allAccountRows += $row
                    $kept++
                }

                $safeFetchRows += [pscustomobject]@{
                    SafeName = $safe.SafeName
                    SafeKind = $safe.SafeKind
                    RawAccountCount = $accounts.Count
                    KeptSvcCount = $kept
                    Result = 'SUCCESS'
                    Message = ''
                }
            }
            catch {
                $safeFetchRows += [pscustomobject]@{
                    SafeName = $safe.SafeName
                    SafeKind = $safe.SafeKind
                    RawAccountCount = 0
                    KeptSvcCount = 0
                    Result = 'FAILED'
                    Message = $_.Exception.Message
                }

                Write-RunLog 'Start-FastSvcPairCleanup' "Failed fetching Safe=$($safe.SafeName). $($_.Exception.Message)" 'ERROR'
            }

            $safeIndex++
        }
    }
    else {
        Write-RunLog 'Start-FastSvcPairCleanup' "Searching CyberArk Accounts API globally for '$AccountSearchText'." 'INFO'
        $accounts = @(Get-AccountsByGlobalSearch -SearchText $AccountSearchText -Token $token)
        Write-RunLog 'Start-FastSvcPairCleanup' "Global Accounts search returned $($accounts.Count) unique account record(s)." 'INFO'

        $safeMap = @{}
        $rawSvcCount = 0
        $keptSvcCount = 0
        $ignoredNoMarker = 0
        $ignoredNotSvc = 0
        $ignoredDomain = 0

        foreach ($account in $accounts) {
            $safeName = Get-AccountField -Account $account -Names @('safeName','SafeName','safe','Safe')
            $safeInfo = Get-SafePairInfo -SafeName $safeName
            $userName = Get-AccountField -Account $account -Names @('userName','username','UserName')

            if (-not (Test-ServiceAccountName -UserName $userName)) {
                $ignoredNotSvc++
                continue
            }

            $rawSvcCount++

            if ($null -eq $safeInfo) {
                $ignoredNoMarker++
                continue
            }

            $safeRow = [pscustomobject]@{
                SafeName = $safeInfo.SafeName
                SafeKind = $safeInfo.SafeKind
                ExpectedPairSafeName = $safeInfo.ExpectedPairSafeName
                SafePairKey = $safeInfo.SafePairKey
                DiscoverySource = 'AccountsGlobalSearch'
            }

            $row = Convert-AccountToValidationRow -Account $account -SafeInfo $safeRow

            if ($row.AddressDomainAllowed -ne 'True') {
                $ignoredDomain++
                continue
            }

            $allAccountRows += $row
            $keptSvcCount++

            $safeKey = $safeRow.SafeName.ToUpperInvariant()
            if (-not $safeMap.ContainsKey($safeKey)) {
                $safeMap[$safeKey] = $safeRow
            }
        }

        $safeRows = @($safeMap.Values | Sort-Object SafePairKey, SafeKind, SafeName)
        $requiredSafes = $safeRows

        $safeFetchRows += [pscustomobject]@{
            SafeName = 'GLOBAL_ACCOUNT_SEARCH'
            SafeKind = 'N/A'
            RawAccountCount = $accounts.Count
            KeptSvcCount = $keptSvcCount
            Result = 'SUCCESS'
            Message = "Account-first mode. SVCRecords=$rawSvcCount IgnoredNotSvc=$ignoredNotSvc IgnoredNoOmngAmngSafeMarker=$ignoredNoMarker IgnoredAddressDomain=$ignoredDomain"
        }

        Write-RunLog 'Start-FastSvcPairCleanup' "Account-first filter complete. SVCRecords=$rawSvcCount KeptOmngAmngSvc=$keptSvcCount IgnoredNotSvc=$ignoredNotSvc IgnoredNoOmngAmngSafeMarker=$ignoredNoMarker IgnoredAddressDomain=$ignoredDomain" 'INFO'
    }

    $omngRows = @($allAccountRows | Where-Object { $_.SafeKind -eq 'OMNG' })
    $amngRows = @($allAccountRows | Where-Object { $_.SafeKind -eq 'AMNG' })

    $amngByKey = @{}

    foreach ($row in $amngRows) {
        if (-not $amngByKey.ContainsKey($row.UserAddressPairKey)) {
            $amngByKey[$row.UserAddressPairKey] = New-Object System.Collections.Generic.List[object]
        }

        [void]$amngByKey[$row.UserAddressPairKey].Add($row)
    }

    $pairs = @()
    $deleteCandidates = @()
    $missingPairs = @()

    foreach ($omng in $omngRows) {
        $matches = @()

        if ($amngByKey.ContainsKey($omng.UserAddressPairKey)) {
            $matches = @($amngByKey[$omng.UserAddressPairKey] | Where-Object { $_.SafeName -ieq $omng.ExpectedPairSafeName })
        }

        if ($matches.Count -eq 0) {
            $missingPairs += [pscustomobject]@{
                OMNG_AccountID = $omng.AccountID
                OMNG_Name = $omng.AccountName
                UserName = $omng.UserName
                Address = $omng.Address
                OMNG_Safe = $omng.SafeName
                Expected_AMNG_Safe = $omng.ExpectedPairSafeName
                OMNG_PlatformId = $omng.PlatformId
                Result = 'KEEP_OMNG_NO_EXACT_AMNG_USERNAME_ADDRESS_MATCH'
            }

            continue
        }

        foreach ($amng in $matches) {
            $pair = [pscustomobject]@{
                PairStatus = 'EXACT_USERNAME_ADDRESS_MATCH'
                UserName = $omng.UserName
                Address = $omng.Address
                MatchedDomain = $omng.MatchedDomain
                OMNG_AccountID = $omng.AccountID
                OMNG_Name = $omng.AccountName
                OMNG_Safe = $omng.SafeName
                OMNG_PlatformId = $omng.PlatformId
                AMNG_AccountID = $amng.AccountID
                AMNG_Name = $amng.AccountName
                AMNG_Safe = $amng.SafeName
                AMNG_PlatformId = $amng.PlatformId
                SafePairKey = $omng.SafePairKey
                UserAddressPairKey = $omng.UserAddressPairKey
                DeleteEligible = 'Yes'
                DeleteResult = ''
                DeleteMessage = ''
            }

            $pairs += $pair
            $deleteCandidates += $pair
        }
    }

    $amngOnly = @()
    $omngKeySet = @{}

    foreach ($omng in $omngRows) {
        $omngKeySet[$omng.UserAddressPairKey + '|' + $omng.SafeName.ToUpperInvariant()] = $true
    }

    foreach ($amng in $amngRows) {
        $expectedOmngSafe = $amng.ExpectedPairSafeName.ToUpperInvariant()
        $expectedKey = $amng.UserAddressPairKey + '|' + $expectedOmngSafe

        if (-not $omngKeySet.ContainsKey($expectedKey)) {
            $amngOnly += [pscustomobject]@{
                AMNG_AccountID = $amng.AccountID
                AMNG_Name = $amng.AccountName
                UserName = $amng.UserName
                Address = $amng.Address
                AMNG_Safe = $amng.SafeName
                Expected_OMNG_Safe = $amng.ExpectedPairSafeName
                AMNG_PlatformId = $amng.PlatformId
                Note = 'AMNG SVC account found without an exact OMNG username/address pair.'
            }
        }
    }

    $deleteResults = @()

    if ($DeleteOmng -and $ConfirmDelete -eq 'YES') {
        $deleted = @{}

        foreach ($candidate in $deleteCandidates) {
            if ($deleted.ContainsKey($candidate.OMNG_AccountID)) { continue }

            try {
                Write-RunLog 'Start-FastSvcPairCleanup' "Deleting OMNG AccountID=$($candidate.OMNG_AccountID) Safe=$($candidate.OMNG_Safe) User=$($candidate.UserName) Address=$($candidate.Address)" 'WARN'
                Remove-AccountById -AccountId $candidate.OMNG_AccountID -Token $token
                $deleted[$candidate.OMNG_AccountID] = $true
                $candidate.DeleteResult = 'DELETED'
                $candidate.DeleteMessage = 'OMNG account deleted because exact AMNG username/address pair exists.'

                $deleteResults += [pscustomobject]@{
                    OMNG_AccountID = $candidate.OMNG_AccountID
                    UserName = $candidate.UserName
                    Address = $candidate.Address
                    OMNG_Safe = $candidate.OMNG_Safe
                    AMNG_AccountID = $candidate.AMNG_AccountID
                    AMNG_Safe = $candidate.AMNG_Safe
                    DeleteResult = 'DELETED'
                    Message = 'OMNG account deleted because exact AMNG username/address pair exists.'
                }
            }
            catch {
                $candidate.DeleteResult = 'FAILED'
                $candidate.DeleteMessage = $_.Exception.Message

                $deleteResults += [pscustomobject]@{
                    OMNG_AccountID = $candidate.OMNG_AccountID
                    UserName = $candidate.UserName
                    Address = $candidate.Address
                    OMNG_Safe = $candidate.OMNG_Safe
                    AMNG_AccountID = $candidate.AMNG_AccountID
                    AMNG_Safe = $candidate.AMNG_Safe
                    DeleteResult = 'FAILED'
                    Message = $_.Exception.Message
                }

                Write-RunLog 'Start-FastSvcPairCleanup' "Delete failed for OMNG AccountID=$($candidate.OMNG_AccountID). $($_.Exception.Message)" 'ERROR'
            }
        }
    }
    else {
        foreach ($candidate in $deleteCandidates) {
            $candidate.DeleteResult = 'NOT_RUN'
            $candidate.DeleteMessage = 'Report-only run. Use -DeleteOmng -ConfirmDelete YES to delete eligible OMNG accounts.'
        }
    }

    $searchStrategyText = if ($UseLegacySafeSearch) { 'Legacy safe-pair first, then SVC account lookup per paired Safe' } else { 'Account-first: Accounts?search=SVC, local OMNG/AMNG Safe classification, no Safes?search' }

    $summary = @(
        [pscustomobject]@{ Metric = 'Environment'; Value = $Environment },
        [pscustomobject]@{ Metric = 'SearchStrategy'; Value = $searchStrategyText },
        [pscustomobject]@{ Metric = 'SafeMarkerMatchMode'; Value = $SafeMarkerMatchMode },
        [pscustomobject]@{ Metric = 'AccountSearchText'; Value = $AccountSearchText },
        [pscustomobject]@{ Metric = 'ServiceAccountRegex'; Value = $ServiceAccountRegex },
        [pscustomobject]@{ Metric = 'UseAddressDomainFilter'; Value = [string]$UseAddressDomainFilter },
        [pscustomobject]@{ Metric = 'AddressDomains'; Value = ($AddressDomains -join ', ') },
        [pscustomobject]@{ Metric = 'SafesScanned'; Value = $requiredSafes.Count },
        [pscustomobject]@{ Metric = 'FetchFailures'; Value = (@($safeFetchRows | Where-Object { $_.Result -eq 'FAILED' })).Count },
        [pscustomobject]@{ Metric = 'OMNGSvcAccountsFound'; Value = $omngRows.Count },
        [pscustomobject]@{ Metric = 'AMNGSvcAccountsFound'; Value = $amngRows.Count },
        [pscustomobject]@{ Metric = 'ExactDuplicatePairsFound'; Value = $pairs.Count },
        [pscustomobject]@{ Metric = 'UniqueOMNGDeleteCandidates'; Value = (@($deleteCandidates | Select-Object -ExpandProperty OMNG_AccountID -Unique)).Count },
        [pscustomobject]@{ Metric = 'OMNGMissingExactAMNG'; Value = $missingPairs.Count },
        [pscustomobject]@{ Metric = 'AMNGOnly'; Value = $amngOnly.Count },
        [pscustomobject]@{ Metric = 'DeleteMode'; Value = [string]($DeleteOmng -and $ConfirmDelete -eq 'YES') },
        [pscustomobject]@{ Metric = 'DeletedCount'; Value = (@($deleteResults | Where-Object { $_.DeleteResult -eq 'DELETED' })).Count },
        [pscustomobject]@{ Metric = 'FailedDeleteCount'; Value = (@($deleteResults | Where-Object { $_.DeleteResult -eq 'FAILED' })).Count }
    )

    Export-CsvSafe -Rows @($pairs) -Path $script:PairsCsvFile
    Export-CsvSafe -Rows @($deleteCandidates) -Path $script:DeleteCandidatesCsvFile

    $sheets = [ordered]@{
        '00_Summary' = @($summary)
        '01_Delete_Eligible_OMNG' = @($deleteCandidates)
        '02_Exact_Pairs' = @($pairs)
        '03_OMNG_No_AMNG_Match' = @($missingPairs)
        '04_All_OMNG_SVC' = @($omngRows)
        '05_All_AMNG_SVC' = @($amngRows)
        '06_Safe_Pairs' = @($safeRows)
        '07_Fetch_Status' = @($safeFetchRows)
        '08_AMNG_Only' = @($amngOnly)
        '09_Delete_Results' = @($deleteResults)
    }

    Export-XlsxWorkbook -Sheets $sheets -Path $script:XlsxReportFile

    Write-RunLog 'Start-FastSvcPairCleanup' "Run completed. Workbook=$script:XlsxReportFile" 'SUCCESS'
    Write-RunLog 'Start-FastSvcPairCleanup' "PairsCsv=$script:PairsCsvFile" 'INFO'
    Write-RunLog 'Start-FastSvcPairCleanup' "DeleteCandidatesCsv=$script:DeleteCandidatesCsvFile" 'INFO'
    Write-RunLog 'Start-FastSvcPairCleanup' "Log=$script:LogFile" 'INFO'
}

Start-FastSvcPairCleanup
