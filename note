<# =========================================
   CyberArk Safe Create + Member Add (psPAS)
   - Auth via CCP -> psPAS Identity header (UPCred)
   - Safe creation first, then members
   - Target AD group validated in specific OU
   - No SearchIn used for member adds
   ========================================= #>

# --- Logging Utility ---
$LogPath = "E:\Installation Media\Script\OnboardScript\accountonboarding.txt"
Function Write-Log {
    param([string]$Message, [string]$Color = "White")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogEntry = "$Timestamp - $Message"
    try { Write-Host $LogEntry -ForegroundColor $Color } catch { Write-Host $LogEntry }
    try { Add-Content -Path $LogPath -Value $LogEntry } catch {}
}

# --- Ensure psPAS is available ---
try {
    Import-Module psPAS -ErrorAction Stop
    $mod = Get-Module psPAS
    Write-Log "psPAS loaded ($($mod.Version))."
} catch {
    Write-Log "❌ psPAS module not found/loaded: $($_.Exception.Message)" "Red"
    exit 1
}

# --- Retrieve CyberArk API Credentials from CCP ---
$CCPAddress = "https://vskau1p1231.cna.com"
$location   = "AIMWebService"
$application= "PAMDiscovery"
$safe       = "CA_PCloud_Admins"
$object     = "cna-prod.cyberark.cloud-cnarestbot@cyberark.cloud.6679"

$headers = New-Object "System.Collections.Generic.Dictionary[[String],[String]]"
$headers.Add("Content-Type", "application/json")
$windowsAuth = $false

Write-Log "Retrieving CyberArk API credentials from CCP via Object method..."
$ccpUrl = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object"
try {
    $response = Invoke-RestMethod $ccpUrl -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth
    if (-not $response -or -not $response.Content) {
        Write-Log "❌ ERROR: Failed to retrieve API credentials from CCP." "Red"
        exit 1
    }
    Write-Log "Successfully retrieved credentials for user: $($response.Username)"
} catch {
    Write-Log "❌ ERROR: CCP credential fetch failed - $_" "Red"
    exit 1
}

# --- psPAS Authentication using CCP secret + fixed username ---
try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header)..."
    $UPUser = 'CA_PAMDiscovery_SVC'  # per your instruction; use UPN if your tenant requires it
    $UPPass = ConvertTo-SecureString $response.Content -AsPlainText -Force
    $UPCred = [PSCredential]::new($UPUser, $UPPass)

    # Build Identity header for Privilege Cloud & register session
    $header = Get-IdentityHeader `
        -IdentityTenantURL "aat4012.id.cyberark.cloud" `
        -psPASFormat `
        -PCloudSubdomain "cna-prod" `
        -UPCreds $UPCred

    Use-PASSession $header

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established" }
    Write-Log "✅ Authentication successful, PAS session established."
} catch {
    Write-Log "❌ Failed to authenticate via psPAS Identity header: $($_.Exception.Message)" "Red"
    exit 1
}

# --- Prompt for Safe Name & Description (single line up to 200 chars) ---
$SafeName = Read-Host "Enter the Safe Name"
$DescriptionRaw = Read-Host "Enter the Safe Description (single line, up to 200 chars)"
if ([string]::IsNullOrWhiteSpace($SafeName)) {
    Write-Log "❌ ERROR: Safe Name cannot be empty. Exiting..." "Red"
    exit 1
}
if ([string]::IsNullOrWhiteSpace($DescriptionRaw)) {
    Write-Log "❌ ERROR: Safe Description cannot be empty. Exiting..." "Red"
    exit 1
}
$Description = $DescriptionRaw.Trim()
if ($Description.Length -gt 200) {
    Write-Log "ℹ️ Safe Description >200 chars, auto-truncating."
    $Description = $Description.Substring(0,200)
}

# --- Safe creation (psPAS first, then members) ---
$ManagingCPM = "CNA_PASS_MANG"
$NumVersionRetention = 180  # keeping prior default
try {
    # Check if safe exists
    $existing = Get-PASSafe -SafeName $SafeName -ErrorAction SilentlyContinue
    if ($existing) {
        Write-Log "ℹ️ Safe '$SafeName' already exists. Skipping create."
    } else {
        Write-Log "🔹 Creating Safe: ${SafeName}..."
        Add-PASSafe -SafeName $SafeName -ManagingCPM $ManagingCPM -NumberOfVersionsRetention $NumVersionRetention -Description $Description -ErrorAction Stop
        Write-Log "✅ Successfully created Safe: ${SafeName}."
    }
} catch {
    Write-Log "❌ ERROR: Failed to create or read Safe '${SafeName}' - $($_.Exception.Message)" "Red"
    exit 1
}

# --- Permissions (as provided) ---
$LimitedPermissions = @{
    "useAccounts" = $false
    "retrieveAccounts" = $false
    "listAccounts" = $true
    "addAccounts" = $false
    "updateAccountContent" = $false
    "updateAccountProperties" = $false
    "initiateCPMAccountManagementOperations" = $true
    "specifyNextAccountContent" = $false
    "renameAccounts" = $false
    "deleteAccounts" = $false
    "unlockAccounts" = $true
    "manageSafe" = $false
    "manageSafeMembers" = $false
    "backupSafe" = $false
    "viewAuditLog" = $true
    "viewSafeMembers" = $true
    "accessWithoutConfirmation" = $true
    "createFolders" = $false
    "deleteFolders" = $false
    "moveAccountsAndFolders" = $false
    "requestsAuthorizationLevel1" = $true
    "requestsAuthorizationLevel2" = $false
}
$FullPermissions = @{
    "useAccounts" = $true
    "retrieveAccounts" = $true
    "listAccounts" = $true
    "addAccounts" = $true
    "updateAccountContent" = $true
    "updateAccountProperties" = $true
    "initiateCPMAccountManagementOperations" = $true
    "specifyNextAccountContent" = $true
    "renameAccounts" = $true
    "deleteAccounts" = $true
    "unlockAccounts" = $true
    "manageSafe" = $true
    "manageSafeMembers" = $true
    "backupSafe" = $true
    "viewAuditLog" = $true
    "viewSafeMembers" = $true
    "accessWithoutConfirmation" = $true
    "createFolders" = $true
    "deleteFolders" = $true
    "moveAccountsAndFolders" = $true
    "requestsAuthorizationLevel1" = $true
    "requestsAuthorizationLevel2" = $false
}

# --- Target AD Group prompt & validation (sAM only; must exist in specific OU) ---
$SearchBaseOU = 'OU=Groups,OU=CyberArk,DC=cna,DC=com'  # per your mapping
Function Read-ValidGroup {
    while ($true) {
        $g = Read-Host "Enter the AD Safe Group (sAMAccountName only, e.g., ca_bud_ecf_prod)"
        if ([string]::IsNullOrWhiteSpace($g)) {
            Write-Log "❌ Group cannot be empty."
            continue
        }
        # Basic sanity: letters, numbers, underscore & hyphen ok
        if ($g -notmatch '^[A-Za-z0-9_\-\.]+$') {
            Write-Log "❌ Invalid characters in group name. Try again."
            continue
        }
        try {
            # Validate in exact OU
            $adGroup = Get-ADGroup -LDAPFilter "(|(sAMAccountName=$g)(userPrincipalName=$g@cna.com))" -SearchBase $SearchBaseOU -ErrorAction Stop
            if ($adGroup) {
                Write-Log ("Found AD Group in `${SearchBaseOU}: {0} (sAM={1})" -f $adGroup.Name, $adGroup.SamAccountName)
                return $g
            } else {
                Write-Log "❌ Group not found under ${SearchBaseOU}. Re-enter."
            }
        } catch {
            Write-Log "❌ Error searching AD for '$g' in ${SearchBaseOU}: $($_.Exception.Message)" "Red"
        }
    }
}
$GroupSam = Read-ValidGroup
$TargetGroupUPN = "$GroupSam@cna.com"

# --- Build member set (keep admins exactly as you wanted) ---
$Members = @(
    @{ "memberName" = $TargetGroupUPN;                  "memberType" = "Group"; "permissions" = $LimitedPermissions },
    @{ "memberName" = "CA_PCloud_Admins@cna.com";       "memberType" = "Group"; "permissions" = $FullPermissions  },
    @{ "memberName" = "cna_pas_admin@cyberark.cloud.6679"; "memberType" = "User";  "permissions" = $FullPermissions  }
)

# --- Function to add member via psPAS (no -SearchIn) ---
Function Add-MemberToSafe {
    param(
        [string]$SafeName,
        [string]$MemberName,
        [ValidateSet("Group","User","Role")]
        [string]$MemberType,
        [hashtable]$Permissions
    )
    try {
        Write-Log "Adding ${MemberType} '${MemberName}' to ${SafeName}..."
        $Permissions | Add-PASSafeMember -SafeName $SafeName -MemberType $MemberType -MemberName $MemberName -ErrorAction Stop | Out-Null
        Write-Log "✅ Added ${MemberType}: ${MemberName}."
        return $true
    } catch {
        Write-Log "❌ Failed to add '${MemberName}' - $($_.Exception.Message)" "Red"
        return $false
    }
}

# --- Add members in order: Target Group (Limited) -> CA_PCloud_Admins (Full) -> Vault User (Full) ---
foreach ($m in $Members) {
    [void](Add-MemberToSafe -SafeName $SafeName -MemberName $m.memberName -MemberType $m.memberType -Permissions $m.permissions)
}

Write-Log "🔹 Safe member addition process completed."
