remove the Automatic Password Management disabled until validation is complete after creating in new platform or move to new safe. everything else stays same

<#
.SYNOPSIS
    Updates or recreates CyberArk vaulted accounts from a CSV file.

.DESCRIPTION
    PAM Team - account update and migration helper.

    Line of action:
      1. Load shared .env and the selected env\<dev|prod>.env file.
      2. Apply proxy settings early, then again from the env file when loaded.
      3. Prompt for CyberArk Identity service-user credentials.
      4. Request an Identity OAuth bearer token from /oauth2/platformtoken.
      5. Keep the real token only in memory and log only a short SHA256 fingerprint.
      6. Import the CSV and validate the AccountID column.
      7. Load CyberArk regular platform inventory once.
      8. Read each current account before changing anything.
      9. For same-device updates, PATCH only changed fields.
     10. For Safe changes with the same device type, create the account in the target Safe only when explicitly approved.
     11. For platform device-type mismatch, automatically recreate the account using the target platform.
     12. Retrieve the current secret only for the detected recreate path because account creation requires a secret value.
     13. Keep the source account by default.
     14. Create duplicated/recreated target accounts with Automatic Password Management disabled by default.
     15. Optionally disable CPM on the source account after successful migration.
     16. Optionally delete the source account only when both delete switches are supplied.
     17. Include custom CSV fields credentialType and mtbAppCode as target platform account properties.
     18. Ignore CSV Prop:<name> values not defined on the selected target platform and log the skipped properties.
     19. Write normal results, recreated-account list, and delete-candidate list to CSV reports.

.NOTES
    Designed for Windows PowerShell 5.1.
    Do not store service-user passwords, bearer tokens, retrieved secrets, or production account data in Git.
    CSV Prop:<name> columns that are not defined on the target platform are ignored and logged.
    Required Address/Username platform values are satisfied from TargetAddress/TargetUserName when present.
    Direct CSV columns credentialType and mtbAppCode are sent as target platform account properties when supplied.
    Single-field PATCH requests are explicitly preserved as JSON arrays for Windows PowerShell 5.1 compatibility.
    Duplicated/recreated target accounts are created with Automatic Password Management disabled by default for validation.

.EXAMPLE
    .\Update-VaultedAccounts.ps1 -Environment dev

.EXAMPLE
    .\Update-VaultedAccounts.ps1 -Environment prod

.EXAMPLE
    .\Update-VaultedAccounts.ps1 -CsvFile .\input\device-migration.csv -Environment dev

.EXAMPLE
    .\Update-VaultedAccounts.ps1 -CsvFile .\input\device-migration.csv -Environment prod `
        -DisableSourceAfterMigration

.EXAMPLE
    .\Update-VaultedAccounts.ps1 -CsvFile .\input\device-migration.csv -Environment prod `
        -DisableSourceAfterMigration `
        -DeleteSourceAfterMigration `
        -ConfirmDeleteSourceAfterMigration YES
 .EXAMPLE
 Only use this override if you intentionally want the new duplicated account to inherit CPM behavior:
        .\Update-VaultedAccounts.ps1 `
  -CsvFile .\samples\account-update-template.csv `
  -Environment prod `
  -EnableCpmOnDuplicatedAccount
#>

#requires -Version 5.1
[CmdletBinding()]
param(
    # CSV file containing AccountID and the target values to update or migrate.
    # Defaults to the single supported project CSV.
    [string]$CsvFile = (Join-Path $PSScriptRoot 'samples\account-update-template.csv'),

    # Selects env\dev.env or env\prod.env.
    [ValidateSet('dev','prod')]
    [string]$Environment = 'dev',

    # Folder that contains dev.env and prod.env.
    [string]$EnvFolder = (Join-Path $PSScriptRoot 'env'),

    # Validates and reports what would happen without sending update/create/delete calls.
    [switch]$Preview,

    # Kept for backward compatibility. Safe changes are now auto-detected from the CSV.
    [switch]$AllowSafeMove,

    # Kept for backward compatibility. Secret retrieval is automatic only when a Safe-change recreate path is detected.
    [switch]$AllowSecretRetrievalForSafeMove,

    # Kept for backward compatibility. Device-type migration is now auto-detected by the script.
    [switch]$AllowDeviceTypeMigration,

    # Kept for backward compatibility. Secret retrieval is automatic only when a recreate path is detected.
    [switch]$AllowSecretRetrievalForDeviceTypeMigration,

    # Disables automatic CPM management on the source account after successful migration.
    [switch]$DisableSourceAfterMigration,

    # By default, duplicated/recreated target accounts are created with Automatic Password Management disabled.
    # Supply this switch only if the new target account should inherit CSV/source CPM behavior.
    [switch]$EnableCpmOnDuplicatedAccount,

    # Manual management reason applied to duplicated/recreated target accounts when Automatic Password Management is disabled.
    [string]$DuplicatedAccountManualManagementReason = 'Duplicated account created for validation. Automatic Password Management disabled until validation is complete.',

    # Deletes the source account after successful migration. Requires ConfirmDeleteSourceAfterMigration YES.
    [switch]$DeleteSourceAfterMigration,

    # Second confirmation gate for source deletion.
    [ValidateSet('NO','YES')]
    [string]$ConfirmDeleteSourceAfterMigration = 'NO',

    # Reason supplied during password retrieval and source CPM disablement.
    [string]$SafeMoveReason = 'Approved account migration',

    # Allows CSV Prop:<name> values that are not advertised in the platform definition.
    [switch]$AllowUnknownPlatformProperties,

    # Uses the logged-in Windows identity for proxy authentication.
    [switch]$ProxyUseDefaultCredentials,

    # Where CSV reports are written.
    [string]$ReportFolder = (Join-Path $PSScriptRoot 'reports'),

    # Where logs are written.
    [string]$LogFolder = (Join-Path $PSScriptRoot 'logs'),

    # Optional suffix for log/report file names.
    [string]$LogId = ''
)

# Stop immediately inside try/catch blocks so the script can log clean failures.
$ErrorActionPreference = 'Stop'

# Force TLS 1.2 for Windows PowerShell hosts that may otherwise negotiate weaker protocols.
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

<#
    Bootstrap proxy setup.
    This is intentionally near the top so token and REST calls can use the proxy immediately.
    You can leave this as Placehold and put the real proxy in env\dev.env or env\prod.env:
        PROXY="http://proxy.company.com:8080"
#>
$proxyUri = "Placehold"

if ($proxyUri -and $proxyUri.Trim() -notmatch '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') {
    $proxy = New-Object System.Net.WebProxy($proxyUri, $true)
    [System.Net.WebRequest]::DefaultWebProxy = $proxy
    [System.Net.WebRequest]::DefaultWebProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
    [System.Net.WebRequest]::DefaultWebProxy.Address | Out-Null
}

# Runtime state used by helper functions.
$script:LogFile = $null
$script:ReportFile = $null
$script:RecreatedReportFile = $null
$script:DeleteCandidateReportFile = $null
$script:Config = $null
$script:PlatformCache = @{}

function Test-BlankValue {
    <#
        Returns true when a value is empty or still contains a placeholder.
    #>
    param([object]$Value)

    if ($null -eq $Value) { return $true }

    $text = $Value.ToString().Trim()

    if ($text.Length -eq 0) { return $true }
    if ($text -match '^(Placehold|Placeholder|YOUR-|<.*>|CHANGEME)$') { return $true }

    return $false
}

function New-RunLog {
    <#
        Creates output folders and starts timestamped log/report files.
    #>
    if (-not (Test-Path $LogFolder)) {
        New-Item -Path $LogFolder -ItemType Directory -Force | Out-Null
    }

    if (-not (Test-Path $ReportFolder)) {
        New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
    }

    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $suffix = if (Test-BlankValue $LogId) { '' } else { "_$LogId" }

    $script:LogFile = Join-Path $LogFolder "Update-VaultedAccounts_$stamp$suffix.log"
    $script:ReportFile = Join-Path $ReportFolder "Update-VaultedAccounts_Report_$stamp$suffix.csv"
    $script:RecreatedReportFile = Join-Path $ReportFolder "Update-VaultedAccounts_Recreated_$stamp$suffix.csv"
    $script:DeleteCandidateReportFile = Join-Path $ReportFolder "Update-VaultedAccounts_DeleteCandidates_$stamp$suffix.csv"

    Set-Content -Path $script:LogFile -Value "$(Get-Date -Format s) source=New-RunLog [INFO] Starting run"
}

function Write-RunLog {
    <#
        Writes a log entry to file and console.
    #>
    param(
        [string]$Source,
        [string]$Message,

        [ValidateSet('DEBUG','INFO','WARN','ERROR')]
        [string]$Level = 'INFO'
    )

    $line = "$(Get-Date -Format s) source=$Source [$Level] $Message"

    Add-Content -Path $script:LogFile -Value $line

    if ($Level -eq 'ERROR') {
        Write-Host $line -ForegroundColor Red
    }
    elseif ($Level -eq 'WARN') {
        Write-Host $line -ForegroundColor Yellow
    }
    else {
        Write-Host $line
    }
}

function Read-DotEnvFile {
    <#
        Reads simple KEY=VALUE environment files.
        Blank lines and # comments are ignored.
    #>
    param([string]$Path)

    $result = @{}

    if (-not (Test-Path $Path)) {
        return $result
    }

    $lines = Get-Content -Path $Path -ErrorAction Stop

    foreach ($line in $lines) {
        $trimmed = $line.Trim()

        if ($trimmed.Length -eq 0) { continue }
        if ($trimmed.StartsWith('#')) { continue }
        if ($trimmed -notmatch '=') { continue }

        $parts = $trimmed.Split('=', 2)
        $key = $parts[0].Trim()
        $value = $parts[1].Trim()

        if ($value.Length -ge 2) {
            if (
                ($value.StartsWith('"') -and $value.EndsWith('"')) -or
                ($value.StartsWith("'") -and $value.EndsWith("'"))
            ) {
                $value = $value.Substring(1, $value.Length - 2)
            }
        }

        if (-not (Test-BlankValue $key)) {
            $result[$key] = $value
        }
    }

    return $result
}

function Join-EnvValues {
    <#
        Merges env file values. Later maps override earlier maps.
    #>
    param([hashtable[]]$Maps)

    $merged = @{}

    foreach ($map in $Maps) {
        foreach ($key in $map.Keys) {
            $merged[$key] = $map[$key]
        }
    }

    return $merged
}

function Normalize-PvwaApiBase {
    <#
        Accepts a tenant base URL, PasswordVault URL, PasswordVault/API URL,
        or a mistakenly deep URL like /PasswordVault/API/Accounts.
        Returns the correct /PasswordVault/API root.
    #>
    param([string]$PvwaValue)

    $base = $PvwaValue.Trim().TrimEnd('/')

    # Some users paste full endpoints. Trim these back to the API root.
    $base = $base -replace '/PrivilegeCloud$', ''
    $base = $base -replace '/PasswordVault/API/Accounts/?$', '/PasswordVault/API'
    $base = $base -replace '/PasswordVault/API/Accounts/.+$', '/PasswordVault/API'

    if ($base -match '/PasswordVault/API$') {
        return $base
    }

    if ($base -match '/PasswordVault$') {
        return "$base/API"
    }

    return "$base/PasswordVault/API"
}

function Resolve-IdentityBase {
    <#
        Builds the Identity tenant URL from TENANT_ID.
        TENANT_ID can be a short tenant name or a full URL.
    #>
    param([hashtable]$Settings)

    $tenant = $Settings['TENANT_ID']

    if (Test-BlankValue $tenant) {
        throw 'TENANT_ID is missing in .env. Example: TENANT_ID=abq4291 or TENANT_ID=https://abq4291.id.cyberark.cloud'
    }

    $tenant = $tenant.Trim().TrimEnd('/')

    if ($tenant -match '^https?://') {
        return $tenant
    }

    if ($tenant -match '\.id\.cyberark\.cloud$') {
        return "https://$tenant"
    }

    if ($tenant -match '\.') {
        return "https://$tenant"
    }

    return "https://$tenant.id.cyberark.cloud"
}

function Get-ProxyFromSettings {
    <#
        Builds a proxy URL from PROXY or PROXY_ADDRESS/PROXY_PORT.
        Also accepts ROXY_ADDRESS to tolerate the original typo.
    #>
    param([hashtable]$Settings)

    $proxy = $Settings['PROXY']

    if (-not (Test-BlankValue $proxy)) {
        return $proxy.Trim()
    }

    $proxyAddress = $Settings['PROXY_ADDRESS']

    if (Test-BlankValue $proxyAddress) {
        $proxyAddress = $Settings['ROXY_ADDRESS']
    }

    $proxyPort = $Settings['PROXY_PORT']

    if ((Test-BlankValue $proxyAddress) -or (Test-BlankValue $proxyPort)) {
        return $null
    }

    $proxyAddress = $proxyAddress.Trim().TrimEnd('/')

    if ($proxyAddress -notmatch '^https?://') {
        $proxyAddress = "http://$proxyAddress"
    }

    return "$proxyAddress`:$($proxyPort.Trim())"
}

function Import-RunConfig {
    <#
        Loads configuration, normalizes URLs, and applies env-file proxy settings.
    #>
    $baseFile = Join-Path $PSScriptRoot '.env'
    $envFile1 = Join-Path $EnvFolder "$Environment.env"
    $envFile2 = Join-Path $PSScriptRoot "$Environment.env"

    $base = Read-DotEnvFile -Path $baseFile
    $envSpecific = @{}

    if (Test-Path $envFile1) {
        $envSpecific = Read-DotEnvFile -Path $envFile1
    }
    elseif (Test-Path $envFile2) {
        $envSpecific = Read-DotEnvFile -Path $envFile2
    }
    else {
        throw "Could not find environment file for '$Environment'. Expected $envFile1 or $envFile2"
    }

    $settings = Join-EnvValues -Maps @($base, $envSpecific)

    if (Test-BlankValue $settings['PVWA']) {
        if (Test-BlankValue $settings['SUB_DOMAIN']) {
            throw 'PVWA is missing and SUB_DOMAIN is not set. Set PVWA in dev.env/prod.env or SUB_DOMAIN in .env.'
        }

        $settings['PVWA'] = "https://$($settings['SUB_DOMAIN']).privilegecloud.cyberark.cloud"
    }

    $identityBase = Resolve-IdentityBase -Settings $settings
    $apiBase = Normalize-PvwaApiBase -PvwaValue $settings['PVWA']
    $proxyFromEnv = Get-ProxyFromSettings -Settings $settings

    if (-not (Test-BlankValue $proxyFromEnv)) {
        $webProxy = New-Object System.Net.WebProxy($proxyFromEnv, $true)

        if ($ProxyUseDefaultCredentials) {
            $webProxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
        }

        [System.Net.WebRequest]::DefaultWebProxy = $webProxy
    }

    $script:Config = [pscustomobject]@{
        Environment = $Environment
        IdentityBase = $identityBase
        TokenUrl = "$identityBase/oauth2/platformtoken"
        ApiBase = $apiBase
        Proxy = $proxyFromEnv
    }

    Write-RunLog 'Import-RunConfig' "Environment=$Environment IdentityBase=$identityBase ApiBase=$apiBase ProxyConfigured=$([bool]$proxyFromEnv)" 'INFO'
}

function ConvertTo-FormBody {
    <#
        Converts a hashtable into application/x-www-form-urlencoded content.
    #>
    param([hashtable]$Body)

    $pairs = @()

    foreach ($key in $Body.Keys) {
        $k = [System.Uri]::EscapeDataString([string]$key)
        $v = [System.Uri]::EscapeDataString([string]$Body[$key])
        $pairs += "$k=$v"
    }

    return ($pairs -join '&')
}

function Get-Sha256Fingerprint {
    <#
        Creates a token fingerprint for logging without logging the actual token.
    #>
    param([string]$Text)

    $sha = [System.Security.Cryptography.SHA256]::Create()

    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash = $sha.ComputeHash($bytes)

        return (($hash | ForEach-Object { $_.ToString('x2') }) -join '')
    }
    finally {
        $sha.Dispose()
    }
}

function Get-WebErrorText {
    <#
        Extracts the HTTP status and CyberArk API response body when available.
        ErrorDetails.Message is checked first because Windows PowerShell may have
        already consumed the underlying response stream.
    #>
    param([System.Management.Automation.ErrorRecord]$ErrorRecord)

    $parts = New-Object System.Collections.Generic.List[string]

    if ($null -ne $ErrorRecord.Exception -and -not (Test-BlankValue $ErrorRecord.Exception.Message)) {
        [void]$parts.Add($ErrorRecord.Exception.Message)
    }

    $response = $ErrorRecord.Exception.Response

    if ($null -ne $response) {
        try {
            $statusCode = [int]$response.StatusCode
            $statusDescription = [string]$response.StatusDescription

            if (-not (Test-BlankValue $statusDescription)) {
                [void]$parts.Add("HTTPStatus=$statusCode $statusDescription")
            }
            else {
                [void]$parts.Add("HTTPStatus=$statusCode")
            }
        }
        catch {
            # Status details are optional. Preserve the original exception.
        }
    }

    $body = $null

    if ($null -ne $ErrorRecord.ErrorDetails -and -not (Test-BlankValue $ErrorRecord.ErrorDetails.Message)) {
        $body = [string]$ErrorRecord.ErrorDetails.Message
    }

    if ((Test-BlankValue $body) -and $null -ne $response) {
        try {
            $stream = $response.GetResponseStream()

            if ($null -ne $stream) {
                $reader = New-Object System.IO.StreamReader($stream)

                try {
                    $body = $reader.ReadToEnd()
                }
                finally {
                    $reader.Dispose()
                }
            }
        }
        catch {
            # Keep the original error if response-body extraction fails.
        }
    }

    if (-not (Test-BlankValue $body)) {
        [void]$parts.Add("Response=$body")
    }

    if ($parts.Count -eq 0) {
        return 'Unknown web request error.'
    }

    return ($parts -join ' | ')
}

function Get-IdentityBearerToken {
    <#
        Prompts for service-user credentials and requests an Identity bearer token.
    #>
    Write-RunLog 'Get-IdentityBearerToken' 'Prompting for CyberArk Identity service-user credentials' 'INFO'

    $credential = Get-Credential -Message 'Enter CyberArk Identity service-user credentials'

    $body = ConvertTo-FormBody -Body @{
        grant_type = 'client_credentials'
        client_id = $credential.UserName
        client_secret = $credential.GetNetworkCredential().Password
    }

    $params = @{
        Method = 'Post'
        Uri = $script:Config.TokenUrl
        Body = $body
        ContentType = 'application/x-www-form-urlencoded'
        Headers = @{ Accept = 'application/json' }
        ErrorAction = 'Stop'
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        $response = Invoke-RestMethod @params
    }
    catch {
        throw "Identity token request failed. $(Get-WebErrorText -ErrorRecord $_)"
    }

    if ($null -eq $response.access_token) {
        throw 'Identity token response did not include access_token.'
    }

    $token = [string]$response.access_token
    $fingerprint = Get-Sha256Fingerprint -Text $token

    Write-RunLog 'Get-IdentityBearerToken' "Token acquired. SHA256 fingerprint=$($fingerprint.Substring(0,16))... ExpiresIn=$($response.expires_in)" 'INFO'

    return $token
}

function Invoke-CyberArkRest {
    <#
        Common wrapper for CyberArk REST calls.
    #>
    param(
        [ValidateSet('GET','POST','PATCH','DELETE')]
        [string]$Method,

        [string]$Path,

        [string]$Token,

        [object]$Body = $null,

        [string]$ContentType = 'application/json'
    )

    if ($Path -match '^https?://') {
        $uri = $Path
    }
    else {
        $uri = "$($script:Config.ApiBase)/$($Path.TrimStart('/'))"
    }

    $params = @{
        Method = $Method
        Uri = $uri
        Headers = @{ Authorization = "Bearer $Token" }
        ErrorAction = 'Stop'
    }

    if ($Method -ne 'GET' -and $Method -ne 'DELETE') {
        $params['ContentType'] = $ContentType
    }

    if ($null -ne $Body) {
        if ($Body -is [string]) {
            $params['Body'] = $Body
        }
        else {
            # Do not pipe the object to ConvertTo-Json. In Windows PowerShell 5.1,
            # pipeline enumeration can unwrap a one-item JSON Patch array and turn
            # it into a JSON object, which CyberArk rejects with HTTP 400.
            $params['Body'] = ConvertTo-Json -InputObject $Body -Depth 30 -Compress
        }
    }

    if (-not (Test-BlankValue $script:Config.Proxy)) {
        $params['Proxy'] = $script:Config.Proxy
    }

    if ($ProxyUseDefaultCredentials) {
        $params['ProxyUseDefaultCredentials'] = $true
    }

    try {
        return Invoke-RestMethod @params
    }
    catch {
        throw "REST call failed. Method=$Method Uri=$uri $(Get-WebErrorText -ErrorRecord $_)"
    }
}

function Get-CsvRows {
    <#
        Imports and validates CSV input.
    #>
    if (-not (Test-Path $CsvFile)) {
        throw "CSV file not found: $CsvFile"
    }

    if ((Get-Item $CsvFile).Length -eq 0) {
        throw "CSV file is empty: $CsvFile"
    }

    $rows = Import-Csv -Path $CsvFile | Where-Object {
        ($_.PSObject.Properties.Value | Where-Object {
            $null -ne $_ -and $_.ToString().Trim().Length -gt 0
        }).Count -gt 0
    }

    if ($null -eq $rows -or @($rows).Count -eq 0) {
        throw "CSV contains no data rows: $CsvFile"
    }

    $first = @($rows)[0]
    $hasAccountId = $false

    foreach ($name in @('AccountID','Account ID','id','ID')) {
        if ($first.PSObject.Properties[$name]) {
            $hasAccountId = $true
        }
    }

    if (-not $hasAccountId) {
        throw 'CSV is missing required AccountID column. Accepted aliases: AccountID, Account ID, id, ID.'
    }

    Write-RunLog 'Get-CsvRows' "Imported $(@($rows).Count) row(s) from $CsvFile" 'INFO'

    return @($rows)
}

function Get-RowValue {
    <#
        Reads the first non-empty CSV value from a list of accepted column names.
    #>
    param(
        [pscustomobject]$Row,
        [string[]]$Names
    )

    foreach ($name in $Names) {
        $p = $Row.PSObject.Properties[$name]

        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) {
            return $p.Value.ToString().Trim()
        }
    }

    return $null
}

function ConvertTo-BooleanValue {
    <#
        Converts yes/no, true/false, and 1/0 to Boolean.
    #>
    param([string]$Value)

    if (Test-BlankValue $Value) {
        return $null
    }

    switch -Regex ($Value.Trim()) {
        '^(true|t|yes|y|1)$' { return $true }
        '^(false|f|no|n|0)$' { return $false }
        default { throw "Invalid boolean value '$Value'. Use true/false, yes/no, or 1/0." }
    }
}

function Add-CsvPlatformPropertyAlias {
    <#
        Adds a direct CSV column as a platform account property.

        This allows common custom platform properties to be supplied directly as:
            credentialType
            mtbAppCode

        They are sent to CyberArk as platformAccountProperties:
            credentialType
            mtbAppCode

        Explicit Prop:<name> columns are still supported.
    #>
    param(
        [pscustomobject]$Row,
        [hashtable]$Properties,
        [string]$PropertyName,
        [string[]]$Aliases
    )

    foreach ($alias in $Aliases) {
        $p = $Row.PSObject.Properties[$alias]

        if ($null -ne $p -and -not (Test-BlankValue $p.Value)) {
            $Properties[$PropertyName] = $p.Value.ToString().Trim()
            return
        }
    }
}

function Get-RowPlatformProperties {
    <#
        Reads platform account properties from CSV columns named:
            Prop:<name>
            Property:<name>
            PlatformProperty:<name>

        Also maps these direct CSV columns into platformAccountProperties:
            credentialType  -> credentialType
            mtbAppCode      -> mtbAppCode

        This is useful when the target platform contains these custom fields
        and the CSV should remain easy to maintain.
    #>
    param([pscustomobject]$Row)

    $props = @{}

    foreach ($p in $Row.PSObject.Properties) {
        if ($p.Name -match '^(Prop|Property|PlatformProperty):(.+)$') {
            $propName = $Matches[2].Trim()

            if (-not (Test-BlankValue $propName) -and -not (Test-BlankValue $p.Value)) {
                $props[$propName] = $p.Value.ToString().Trim()
            }
        }
    }

    Add-CsvPlatformPropertyAlias -Row $Row `
        -Properties $props `
        -PropertyName 'credentialType' `
        -Aliases @(
            'credentialType',
            'CredentialType',
            'Credential Type',
            'credential type',
            'TargetCredentialType',
            'Target Credential Type'
        )

    Add-CsvPlatformPropertyAlias -Row $Row `
        -Properties $props `
        -PropertyName 'mtbAppCode' `
        -Aliases @(
            'mtbAppCode',
            'MtbAppCode',
            'MTBAppCode',
            'MTB App Code',
            'M&T App Code',
            'AppCode',
            'App Code',
            'TargetAppCode',
            'Target App Code'
        )

    return $props
}

function Get-PlatformInventory {
    <#
        Loads all regular platform definitions once for validation.
    #>
    param([string]$Token)

    Write-RunLog 'Get-PlatformInventory' 'Loading platform inventory' 'INFO'

    $response = Invoke-CyberArkRest -Method GET -Path 'Platforms?PlatformType=Regular' -Token $Token

    $map = @{}

    foreach ($platform in @($response.Platforms)) {
        if ($null -eq $platform.general -or (Test-BlankValue $platform.general.id)) {
            continue
        }

        $map[$platform.general.id] = $platform
    }

    if ($map.Count -eq 0) {
        throw 'No regular platforms were returned. Check the API user permissions.'
    }

    $script:PlatformCache = $map

    Write-RunLog 'Get-PlatformInventory' "Loaded $($map.Count) regular platform(s)" 'INFO'
}

function Get-PlatformById {
    <#
        Looks up a platform by ID using exact or case-insensitive matching.
    #>
    param([string]$PlatformId)

    if (Test-BlankValue $PlatformId) {
        return $null
    }

    if ($script:PlatformCache.ContainsKey($PlatformId)) {
        return $script:PlatformCache[$PlatformId]
    }

    foreach ($key in $script:PlatformCache.Keys) {
        if ($key -ieq $PlatformId) {
            return $script:PlatformCache[$key]
        }
    }

    return $null
}

function Get-PlatformPropertyNames {
    <#
        Returns all required and optional platform-account property names advertised by a platform.
    #>
    param([object]$Platform)

    $names = @{}

    foreach ($item in @($Platform.properties.required)) {
        if (-not (Test-BlankValue $item.name)) {
            $names[$item.name] = $true
        }
    }

    foreach ($item in @($Platform.properties.optional)) {
        if (-not (Test-BlankValue $item.name)) {
            $names[$item.name] = $true
        }
    }

    return $names
}

function Test-HashtableHasKeyCi {
    <#
        Case-insensitive key lookup for hashtables.
    #>
    param(
        [hashtable]$Table,
        [string]$Key
    )

    foreach ($existing in $Table.Keys) {
        if ($existing -ieq $Key) {
            return $true
        }
    }

    return $false
}

function Get-HashtableValueCi {
    <#
        Case-insensitive value lookup for hashtables.
    #>
    param(
        [hashtable]$Table,
        [string]$Key
    )

    foreach ($existing in $Table.Keys) {
        if ($existing -ieq $Key) {
            return $Table[$existing]
        }
    }

    return $null
}

function Assert-PlatformPropertiesAllowed {
    <#
        Removes CSV Prop:<name> values that are not defined on the selected target platform.

        Previous behavior:
            Undefined properties caused the row to fail.

        Current behavior:
            Undefined properties are ignored, written to the log, and the row continues.

        Reason:
            Migration CSVs often contain properties for a different platform type.
            Example: Prop:LogonDomain may be valid for Windows but not valid for a Website platform.
            The script should not send properties that the target platform does not define.
    #>
    param(
        [hashtable]$Properties,
        [object]$Platform
    )

    if ($Properties.Count -eq 0) {
        return
    }

    # If this override is supplied, keep the old permissive behavior and send everything.
    # Normal recommended behavior is to remove unknown properties before create/patch.
    if ($AllowUnknownPlatformProperties) {
        Write-RunLog 'Assert-PlatformPropertiesAllowed' "AllowUnknownPlatformProperties supplied. Unknown Prop: values will not be removed for platform '$($Platform.general.id)'." 'WARN'
        return
    }

    $allowed = Get-PlatformPropertyNames -Platform $Platform
    $removeList = @()

    foreach ($key in @($Properties.Keys)) {
        if (-not (Test-HashtableHasKeyCi -Table $allowed -Key $key)) {
            $removeList += $key
        }
    }

    foreach ($key in $removeList) {
        $Properties.Remove($key)

        Write-RunLog 'Assert-PlatformPropertiesAllowed' "Ignoring CSV platform property '$key' because it is not defined on target platform '$($Platform.general.id)'." 'WARN'
    }

    if ($removeList.Count -gt 0) {
        Write-RunLog 'Assert-PlatformPropertiesAllowed' "Ignored $($removeList.Count) unsupported platform propert$(if($removeList.Count -eq 1){'y'}else{'ies'}) for platform '$($Platform.general.id)': $($removeList -join ', ')" 'WARN'
    }
}

function Get-RequiredPlatformPropertyValue {
    <#
        Resolves required platform property values.

        Some CyberArk platform definitions expose Address and Username as required
        platform properties even though they are account-level fields in the REST
        create body. In those cases, the script treats TargetAddress/TargetUserName
        as satisfying the required value instead of forcing duplicate Prop:Address
        or Prop:Username CSV columns.
    #>
    param(
        [string]$PropertyName,
        [hashtable]$Properties,
        [object]$CurrentAccount,
        [string]$TargetAddress,
        [string]$TargetUserName,
        [string]$TargetName,
        [string]$TargetSafe
    )

    $value = Get-HashtableValueCi -Table $Properties -Key $PropertyName

    if (-not (Test-BlankValue $value)) {
        return $value
    }

    switch -Regex ($PropertyName) {
        '^(Address|TargetAddress|Target system address)$' {
            if (-not (Test-BlankValue $TargetAddress)) { return $TargetAddress }
            if ($null -ne $CurrentAccount -and -not (Test-BlankValue $CurrentAccount.address)) { return $CurrentAccount.address }
            return $null
        }

        '^(Username|UserName|User Name|TargetUserName|Target system user name)$' {
            if (-not (Test-BlankValue $TargetUserName)) { return $TargetUserName }
            if ($null -ne $CurrentAccount -and -not (Test-BlankValue $CurrentAccount.userName)) { return $CurrentAccount.userName }
            return $null
        }

        '^(Name|AccountName|Account Name)$' {
            if (-not (Test-BlankValue $TargetName)) { return $TargetName }
            if ($null -ne $CurrentAccount -and -not (Test-BlankValue $CurrentAccount.name)) { return $CurrentAccount.name }
            return $null
        }

        '^(Safe|SafeName|Safe Name)$' {
            if (-not (Test-BlankValue $TargetSafe)) { return $TargetSafe }
            if ($null -ne $CurrentAccount -and -not (Test-BlankValue $CurrentAccount.safeName)) { return $CurrentAccount.safeName }
            return $null
        }

        default {
            return $null
        }
    }
}

function Assert-RequiredPlatformPropertiesPresent {
    <#
        For create/recreate paths, required target-platform values must be present.

        Important:
            If CyberArk lists Address, Username, Name, or SafeName as required
            platform properties, the script accepts the normal account fields
            already supplied in the CSV/current account:
                TargetAddress
                TargetUserName
                TargetName
                TargetSafeName

            This prevents false failures such as:
                requires target platform property value(s): Address, Username

            For real custom platform properties, continue to use:
                Prop:<PropertyName>
    #>
    param(
        [hashtable]$Properties,
        [object]$Platform,
        [string]$Context,
        [object]$CurrentAccount = $null,
        [string]$TargetAddress = $null,
        [string]$TargetUserName = $null,
        [string]$TargetName = $null,
        [string]$TargetSafe = $null
    )

    $missing = @()
    $satisfiedByAccountFields = @()

    foreach ($item in @($Platform.properties.required)) {
        if (Test-BlankValue $item.name) {
            continue
        }

        $value = Get-RequiredPlatformPropertyValue -PropertyName $item.name `
            -Properties $Properties `
            -CurrentAccount $CurrentAccount `
            -TargetAddress $TargetAddress `
            -TargetUserName $TargetUserName `
            -TargetName $TargetName `
            -TargetSafe $TargetSafe

        if (Test-BlankValue $value) {
            $missing += $item.name
        }
        else {
            if (
                $item.name -match '^(Address|TargetAddress|Target system address|Username|UserName|User Name|TargetUserName|Target system user name|Name|AccountName|Account Name|Safe|SafeName|Safe Name)$' -and
                -not (Test-HashtableHasKeyCi -Table $Properties -Key $item.name)
            ) {
                $satisfiedByAccountFields += $item.name
            }
        }
    }

    if ($satisfiedByAccountFields.Count -gt 0) {
        Write-RunLog 'Assert-RequiredPlatformPropertiesPresent' "$Context required value(s) satisfied from account-level CSV/current fields, not Prop: columns: $($satisfiedByAccountFields -join ', ')" 'INFO'
    }

    if ($missing.Count -gt 0) {
        throw "$Context requires target platform property value(s): $($missing -join ', '). Add CSV column(s) like Prop:<PropertyName> unless the value is already represented by TargetAddress, TargetUserName, TargetName, or TargetSafeName."
    }
}

function Test-SafeAllowedByPlatform {
    <#
        Checks platform AllowedSafes against the intended target Safe.
    #>
    param(
        [object]$Platform,
        [string]$SafeName
    )

    $allowedSafes = $null

    if ($null -ne $Platform.credentialsManagement) {
        $allowedSafes = $Platform.credentialsManagement.allowedSafes
    }

    if (Test-BlankValue $allowedSafes) {
        return $true
    }

    if ($allowedSafes.Trim() -eq '.*') {
        return $true
    }

    foreach ($raw in ($allowedSafes -split ',')) {
        $pattern = $raw.Trim()

        if (Test-BlankValue $pattern) {
            continue
        }

        try {
            if ($SafeName -match $pattern) {
                return $true
            }
        }
        catch {
            if ($SafeName -ieq $pattern) {
                return $true
            }
        }
    }

    return $false
}

function Test-SafeExists {
    <#
        Confirms the API user can see the target Safe.
    #>
    param(
        [string]$SafeName,
        [string]$Token
    )

    $safeUrlId = [System.Uri]::EscapeDataString($SafeName)

    try {
        Invoke-CyberArkRest -Method GET -Path "Safes/$safeUrlId" -Token $Token | Out-Null
        return $true
    }
    catch {
        return $false
    }
}

function Assert-BasePlatformTargetAllowed {
    <#
        Common validation for all target platform actions.
        This does not reject device-type mismatch. The caller decides whether mismatch is allowed.
    #>
    param(
        [object]$CurrentPlatform,
        [object]$TargetPlatform,
        [string]$TargetSafe
    )

    if ($null -eq $CurrentPlatform) {
        throw 'Current platform could not be found in platform inventory.'
    }

    if ($null -eq $TargetPlatform) {
        throw 'Target platform could not be found in platform inventory.'
    }

    if ($TargetPlatform.general.active -ne $true) {
        throw "Target platform '$($TargetPlatform.general.id)' is not active."
    }

    if ($TargetPlatform.general.platformType -and $TargetPlatform.general.platformType -ine 'regular') {
        throw "Target platform '$($TargetPlatform.general.id)' is not a regular account platform."
    }

    if (-not (Test-SafeAllowedByPlatform -Platform $TargetPlatform -SafeName $TargetSafe)) {
        throw "Target Safe '$TargetSafe' is not allowed by platform '$($TargetPlatform.general.id)' AllowedSafes='$($TargetPlatform.credentialsManagement.allowedSafes)'."
    }
}

function Get-PlatformSystemType {
    <#
        Returns the CyberArk platform system/device type as text.
    #>
    param([object]$Platform)

    if ($null -eq $Platform -or $null -eq $Platform.general) {
        return ''
    }

    return [string]$Platform.general.systemType
}

function Get-AccountById {
    <#
        Reads the current account from CyberArk.
    #>
    param(
        [string]$AccountId,
        [string]$Token
    )

    $id = [System.Uri]::EscapeDataString($AccountId)

    return Invoke-CyberArkRest -Method GET -Path "Accounts/$id/" -Token $Token
}

function Get-AccountSecretValue {
    <#
        Retrieves the current account secret when create/recreate has been explicitly approved.
    #>
    param(
        [string]$AccountId,
        [string]$Token
    )

    $id = [System.Uri]::EscapeDataString($AccountId)
    $body = @{ reason = $SafeMoveReason }

    $response = Invoke-CyberArkRest -Method POST -Path "Accounts/$id/Password/Retrieve/" -Token $Token -Body $body

    if ($response -is [string]) {
        return $response
    }

    if ($null -ne $response.Content) {
        return [string]$response.Content
    }

    if ($null -ne $response.Password) {
        return [string]$response.Password
    }

    if ($null -ne $response.Value) {
        return [string]$response.Value
    }

    return [string]$response
}

function Merge-PlatformProperties {
    <#
        Merges current account platform properties with CSV-supplied values.
        CSV values win.
    #>
    param(
        [object]$CurrentProperties,
        [hashtable]$CsvProperties
    )

    $merged = @{}

    if ($null -ne $CurrentProperties) {
        foreach ($p in $CurrentProperties.PSObject.Properties) {
            if (-not (Test-BlankValue $p.Name) -and $null -ne $p.Value) {
                $merged[$p.Name] = $p.Value
            }
        }
    }

    foreach ($key in $CsvProperties.Keys) {
        $merged[$key] = $CsvProperties[$key]
    }

    return $merged
}

function New-PatchBody {
    <#
        Creates JSON Patch operations for same-account updates.
    #>
    param(
        [object]$CurrentAccount,
        [string]$TargetName,
        [string]$TargetAddress,
        [string]$TargetUserName,
        [string]$TargetPlatformId,
        [Nullable[bool]]$AutomaticManagement,
        [string]$ManualManagementReason,
        [hashtable]$PlatformProperties
    )

    $ops = @()

    if (-not (Test-BlankValue $TargetName) -and $TargetName -ne $CurrentAccount.name) {
        $ops += @{ op = 'replace'; path = '/name'; value = $TargetName }
    }

    if (-not (Test-BlankValue $TargetAddress) -and $TargetAddress -ne $CurrentAccount.address) {
        $ops += @{ op = 'replace'; path = '/address'; value = $TargetAddress }
    }

    if (-not (Test-BlankValue $TargetUserName) -and $TargetUserName -ne $CurrentAccount.userName) {
        $ops += @{ op = 'replace'; path = '/userName'; value = $TargetUserName }
    }

    if (-not (Test-BlankValue $TargetPlatformId) -and $TargetPlatformId -ne $CurrentAccount.platformId) {
        $ops += @{ op = 'replace'; path = '/platformId'; value = $TargetPlatformId }
    }

    if ($PlatformProperties.Count -gt 0) {
        $ops += @{ op = 'add'; path = '/platformAccountProperties'; value = $PlatformProperties }
    }

    if ($null -ne $AutomaticManagement) {
        $ops += @{ op = 'replace'; path = '/secretManagement/automaticManagementEnabled'; value = [bool]$AutomaticManagement }
    }

    if (-not (Test-BlankValue $ManualManagementReason)) {
        $ops += @{ op = 'replace'; path = '/secretManagement/manualManagementReason'; value = $ManualManagementReason }
    }
    elseif ($null -ne $AutomaticManagement -and [bool]$AutomaticManagement -eq $true) {
        $ops += @{ op = 'replace'; path = '/secretManagement/manualManagementReason'; value = '' }
    }

    # Prevent Windows PowerShell from unrolling a one-operation array into
    # a scalar hashtable. CyberArk PATCH requires a JSON array even when only
    # one field, such as /userName, is being updated.
    Write-Output -NoEnumerate $ops
}


function Get-DuplicatedAccountSecretManagementChoice {
    <#
        Determines the CPM state for duplicated/recreated target accounts.

        Default behavior:
            New target account is created with Automatic Password Management disabled.

        Reason:
            This allows validation in the new Safe/platform before CPM can rotate the password.

        Override:
            Use -EnableCpmOnDuplicatedAccount only when the new account should inherit
            source/CSV automatic management behavior.
    #>
    param(
        [Nullable[bool]]$RequestedAutomaticManagement,
        [string]$RequestedManualManagementReason,
        [string]$Context
    )

    $autoMgmt = $RequestedAutomaticManagement
    $manualReason = $RequestedManualManagementReason

    if (-not $EnableCpmOnDuplicatedAccount) {
        $autoMgmt = $false

        if (Test-BlankValue $manualReason) {
            $manualReason = $DuplicatedAccountManualManagementReason
        }

        Write-RunLog $Context "Duplicated/recreated target account will be created with Automatic Password Management disabled. ManualManagementReason='$manualReason'" 'WARN'
    }
    else {
        Write-RunLog $Context 'EnableCpmOnDuplicatedAccount supplied. New target account will not be forced to Automatic Password Management disabled.' 'WARN'
    }

    return [pscustomobject]@{
        AutomaticManagement = $autoMgmt
        ManualManagementReason = $manualReason
    }
}

function New-AccountCreateBody {
    <#
        Creates the POST body for new account creation.
        For cross-device migration, pass -UseProvidedPlatformPropertiesOnly to avoid
        copying source platform properties into a different platform type.
    #>
    param(
        [object]$CurrentAccount,
        [string]$TargetSafe,
        [string]$TargetName,
        [string]$TargetAddress,
        [string]$TargetUserName,
        [string]$TargetPlatformId,
        [string]$Secret,
        [Nullable[bool]]$AutomaticManagement,
        [string]$ManualManagementReason,
        [hashtable]$PlatformProperties,
        [switch]$UseProvidedPlatformPropertiesOnly
    )

    $name = if (Test-BlankValue $TargetName) { $CurrentAccount.name } else { $TargetName }
    $address = if (Test-BlankValue $TargetAddress) { $CurrentAccount.address } else { $TargetAddress }
    $userName = if (Test-BlankValue $TargetUserName) { $CurrentAccount.userName } else { $TargetUserName }
    $platformId = if (Test-BlankValue $TargetPlatformId) { $CurrentAccount.platformId } else { $TargetPlatformId }
    $secretType = if (Test-BlankValue $CurrentAccount.secretType) { 'Password' } else { $CurrentAccount.secretType }

    if ($UseProvidedPlatformPropertiesOnly) {
        $finalProps = @{}

        foreach ($key in $PlatformProperties.Keys) {
            $finalProps[$key] = $PlatformProperties[$key]
        }
    }
    else {
        $finalProps = Merge-PlatformProperties -CurrentProperties $CurrentAccount.platformAccountProperties -CsvProperties $PlatformProperties
    }

    $autoMgmt = $true

    if ($null -ne $CurrentAccount.secretManagement -and $null -ne $CurrentAccount.secretManagement.automaticManagementEnabled) {
        $autoMgmt = [bool]$CurrentAccount.secretManagement.automaticManagementEnabled
    }

    if ($null -ne $AutomaticManagement) {
        $autoMgmt = [bool]$AutomaticManagement
    }

    $manualReason = $null

    if ($null -ne $CurrentAccount.secretManagement) {
        $manualReason = $CurrentAccount.secretManagement.manualManagementReason
    }

    if (-not (Test-BlankValue $ManualManagementReason)) {
        $manualReason = $ManualManagementReason
    }

    if ($autoMgmt -eq $true) {
        $manualReason = ''
    }

    $body = [ordered]@{
        name = $name
        address = $address
        userName = $userName
        platformId = $platformId
        safeName = $TargetSafe
        secretType = $secretType
        secret = $Secret
        platformAccountProperties = $finalProps
        secretManagement = @{
            automaticManagementEnabled = $autoMgmt
            manualManagementReason = $manualReason
        }
    }

    if ($null -ne $CurrentAccount.remoteMachinesAccess -and -not $UseProvidedPlatformPropertiesOnly) {
        $body['remoteMachinesAccess'] = $CurrentAccount.remoteMachinesAccess
    }

    return $body
}

function Add-CsvRow {
    <#
        Appends one row to a CSV file, creating the file when needed.
    #>
    param(
        [string]$Path,
        [pscustomobject]$Row
    )

    if (-not (Test-Path $Path)) {
        $Row | Export-Csv -Path $Path -NoTypeInformation
    }
    else {
        $Row | Export-Csv -Path $Path -NoTypeInformation -Append
    }
}

function Add-ReportRow {
    <#
        Writes the main per-row outcome.
    #>
    param([pscustomobject]$Row)

    Add-CsvRow -Path $script:ReportFile -Row $Row
}

function Add-RecreatedAccountRow {
    <#
        Writes the list of newly recreated accounts.
    #>
    param([pscustomobject]$Row)

    Add-CsvRow -Path $script:RecreatedReportFile -Row $Row
}

function Add-DeleteCandidateRow {
    <#
        Writes the list of old/source accounts that should be reviewed for deletion.
    #>
    param([pscustomobject]$Row)

    Add-CsvRow -Path $script:DeleteCandidateReportFile -Row $Row
}

function Invoke-AccountPatch {
    <#
        Sends JSON Patch operations to an account.

        The body is serialized here and passed to the common REST wrapper as a
        string. This guarantees that a username-only update is sent as:
            [{"op":"replace","path":"/userName","value":"..."}]
        rather than as a single JSON object.
    #>
    param(
        [string]$AccountId,
        [array]$PatchOps,
        [string]$Token
    )

    $normalizedOps = [object[]]@($PatchOps)

    if ($normalizedOps.Count -eq 0) {
        return $null
    }

    $id = [System.Uri]::EscapeDataString($AccountId)
    $jsonBody = ConvertTo-Json -InputObject $normalizedOps -Depth 30 -Compress

    Write-RunLog 'Invoke-AccountPatch' "AccountID=$AccountId OperationCount=$($normalizedOps.Count) Payload=$jsonBody" 'INFO'

    return Invoke-CyberArkRest `
        -Method PATCH `
        -Path "Accounts/$id/" `
        -Token $Token `
        -Body $jsonBody `
        -ContentType 'application/json'
}

function Invoke-SafeMoveCreate {
    <#
        Creates a same-device replacement account in a target Safe.
    #>
    param(
        [object]$CurrentAccount,
        [string]$TargetSafe,
        [string]$TargetName,
        [string]$TargetAddress,
        [string]$TargetUserName,
        [string]$TargetPlatformId,
        [Nullable[bool]]$AutomaticManagement,
        [string]$ManualManagementReason,
        [hashtable]$PlatformProperties,
        [string]$Token
    )

    # Account creation in a different Safe requires the existing secret.
    # This happens only after the script detects a Safe change and validates the target Safe/platform.
    # The secret is not written to console, log, or report.
    $secret = Get-AccountSecretValue -AccountId $CurrentAccount.id -Token $Token

    if (Test-BlankValue $secret) {
        throw 'Retrieved secret was empty. New account was not created.'
    }

    $newAccountSecretManagement = Get-DuplicatedAccountSecretManagementChoice `
        -RequestedAutomaticManagement $AutomaticManagement `
        -RequestedManualManagementReason $ManualManagementReason `
        -Context 'Invoke-SafeMoveCreate'

    $body = New-AccountCreateBody -CurrentAccount $CurrentAccount `
        -TargetSafe $TargetSafe `
        -TargetName $TargetName `
        -TargetAddress $TargetAddress `
        -TargetUserName $TargetUserName `
        -TargetPlatformId $TargetPlatformId `
        -Secret $secret `
        -AutomaticManagement $newAccountSecretManagement.AutomaticManagement `
        -ManualManagementReason $newAccountSecretManagement.ManualManagementReason `
        -PlatformProperties $PlatformProperties

    return Invoke-CyberArkRest -Method POST -Path 'Accounts?AllowAccountDuplications=false' -Token $Token -Body $body
}

function Invoke-DeviceTypeMigrationCreate {
    <#
        Creates a new account when the target platform device/system type differs from the current platform.
        The source account is kept by default.
    #>
    param(
        [object]$CurrentAccount,
        [object]$TargetPlatform,
        [string]$TargetSafe,
        [string]$TargetName,
        [string]$TargetAddress,
        [string]$TargetUserName,
        [string]$TargetPlatformId,
        [Nullable[bool]]$AutomaticManagement,
        [string]$ManualManagementReason,
        [hashtable]$PlatformProperties,
        [string]$Token
    )

    # Account creation requires a secret value. This retrieval happens only after the script
    # detects a platform device-type mismatch and validates the target platform/Safe.
    # The secret is not written to console, log, or report.
    # Cross-device migration should not carry source platform properties.
    Assert-RequiredPlatformPropertiesPresent -Properties $PlatformProperties `
        -Platform $TargetPlatform `
        -Context "Device-type migration to '$($TargetPlatform.general.id)'" `
        -CurrentAccount $CurrentAccount `
        -TargetAddress $TargetAddress `
        -TargetUserName $TargetUserName `
        -TargetName $TargetName `
        -TargetSafe $TargetSafe

    $effectiveName = if (Test-BlankValue $TargetName) { $CurrentAccount.name } else { $TargetName }

    if ($TargetSafe -eq $CurrentAccount.safeName -and $effectiveName -eq $CurrentAccount.name) {
        throw "Device-type migration in the same Safe requires TargetName/New Name to be different from the current account name '$($CurrentAccount.name)'."
    }

    $secret = Get-AccountSecretValue -AccountId $CurrentAccount.id -Token $Token

    if (Test-BlankValue $secret) {
        throw 'Retrieved secret was empty. New account was not created.'
    }

    $newAccountSecretManagement = Get-DuplicatedAccountSecretManagementChoice `
        -RequestedAutomaticManagement $AutomaticManagement `
        -RequestedManualManagementReason $ManualManagementReason `
        -Context 'Invoke-DeviceTypeMigrationCreate'

    $body = New-AccountCreateBody -CurrentAccount $CurrentAccount `
        -TargetSafe $TargetSafe `
        -TargetName $TargetName `
        -TargetAddress $TargetAddress `
        -TargetUserName $TargetUserName `
        -TargetPlatformId $TargetPlatformId `
        -Secret $secret `
        -AutomaticManagement $newAccountSecretManagement.AutomaticManagement `
        -ManualManagementReason $newAccountSecretManagement.ManualManagementReason `
        -PlatformProperties $PlatformProperties `
        -UseProvidedPlatformPropertiesOnly

    return Invoke-CyberArkRest -Method POST -Path 'Accounts?AllowAccountDuplications=false' -Token $Token -Body $body
}

function Disable-SourceAccountCpm {
    <#
        Disables automatic CPM management on the source account after a successful migration.
    #>
    param(
        [string]$AccountId,
        [string]$Token,
        [string]$Reason
    )

    $ops = @(
        @{ op = 'replace'; path = '/secretManagement/automaticManagementEnabled'; value = $false },
        @{ op = 'replace'; path = '/secretManagement/manualManagementReason'; value = $Reason }
    )

    Invoke-AccountPatch -AccountId $AccountId -PatchOps $ops -Token $Token | Out-Null
}

function Remove-SourceAccountAfterMigration {
    <#
        Deletes the source account only when both delete controls are supplied.
    #>
    param(
        [string]$AccountId,
        [string]$Token
    )

    if (-not $DeleteSourceAfterMigration) {
        return 'Source account kept. DeleteSourceAfterMigration was not supplied.'
    }

    if ($ConfirmDeleteSourceAfterMigration -ne 'YES') {
        return 'Source account kept. ConfirmDeleteSourceAfterMigration was not YES.'
    }

    $id = [System.Uri]::EscapeDataString($AccountId)

    Invoke-CyberArkRest -Method DELETE -Path "Accounts/$id/" -Token $Token | Out-Null

    return 'Source account deleted after migration.'
}

function Remove-SourceAccountAfterMove {
    <#
        Existing same-device Safe move cleanup.
        This uses the migration delete controls as the same safety gate.
    #>
    param(
        [string]$AccountId,
        [string]$Token
    )

    if (-not $DeleteSourceAfterMigration) {
        return 'Source account kept. DeleteSourceAfterMigration was not supplied.'
    }

    if ($ConfirmDeleteSourceAfterMigration -ne 'YES') {
        return 'Source account kept. ConfirmDeleteSourceAfterMigration was not YES.'
    }

    $id = [System.Uri]::EscapeDataString($AccountId)

    Invoke-CyberArkRest -Method DELETE -Path "Accounts/$id/" -Token $Token | Out-Null

    return 'Source account deleted after target account creation.'
}

function Invoke-RowUpdate {
    <#
        Processes one CSV row:
          - reads current account
          - validates platform and Safe
          - PATCHes same-device updates
          - recreates when device type changes and approval switches exist
    #>
    param(
        [pscustomobject]$CsvRow,
        [int]$RowNumber,
        [string]$Token
    )

    $accountId = Get-RowValue -Row $CsvRow -Names @('AccountID','Account ID','id','ID')
    $targetSafe = Get-RowValue -Row $CsvRow -Names @('TargetSafeName','Target Safe','Migrated Safe','New Safe','SafeName')
    $targetPlatformId = Get-RowValue -Row $CsvRow -Names @('TargetPlatformID','Target Platform ID','Migrated Platform ID','New Platform ID','PlatformID')
    $targetName = Get-RowValue -Row $CsvRow -Names @('TargetName','Target Name','Migrated Name','New Name','Name')
    $targetAddress = Get-RowValue -Row $CsvRow -Names @('TargetAddress','Target Address','Migrated Target system address','New Address','Address')
    $targetUserName = Get-RowValue -Row $CsvRow -Names @('TargetUserName','Target UserName','Target Username','Migrated Target system user name','New UserName','UserName','Username')

    $enableMgmtRaw = Get-RowValue -Row $CsvRow -Names @('AutomaticManagementEnabled','Automatic Management Enabled')
    $disableMgmtRaw = Get-RowValue -Row $CsvRow -Names @('DisableAutomaticManagement','Disable Automatic Management')
    $manualReason = Get-RowValue -Row $CsvRow -Names @('ManualManagementReason','Manual Management Reason')

    $csvProps = Get-RowPlatformProperties -Row $CsvRow

    $result = [ordered]@{
        Row = $RowNumber
        AccountID = $accountId
        SourceSafe = ''
        TargetSafe = ''
        SourcePlatform = ''
        TargetPlatform = ''
        SourceDeviceType = ''
        TargetDeviceType = ''
        Action = ''
        Result = ''
        NewAccountID = ''
        Message = ''
    }

    try {
        if (Test-BlankValue $accountId) {
            throw 'AccountID is blank.'
        }

        $current = Get-AccountById -AccountId $accountId -Token $Token

        $result.SourceSafe = $current.safeName
        $result.SourcePlatform = $current.platformId

        if (Test-BlankValue $targetSafe) {
            $targetSafe = $current.safeName
        }

        if (Test-BlankValue $targetPlatformId) {
            $targetPlatformId = $current.platformId
        }

        $result.TargetSafe = $targetSafe
        $result.TargetPlatform = $targetPlatformId

        $currentPlatform = Get-PlatformById -PlatformId $current.platformId
        $targetPlatform = Get-PlatformById -PlatformId $targetPlatformId

        Assert-BasePlatformTargetAllowed -CurrentPlatform $currentPlatform -TargetPlatform $targetPlatform -TargetSafe $targetSafe
        Assert-PlatformPropertiesAllowed -Properties $csvProps -Platform $targetPlatform

        $currentDeviceType = Get-PlatformSystemType -Platform $currentPlatform
        $targetDeviceType = Get-PlatformSystemType -Platform $targetPlatform
        $deviceTypeMismatch = ($currentDeviceType -ne $targetDeviceType)

        $result.SourceDeviceType = $currentDeviceType
        $result.TargetDeviceType = $targetDeviceType

        $automaticManagement = $null

        if (-not (Test-BlankValue $disableMgmtRaw)) {
            $automaticManagement = -not (ConvertTo-BooleanValue -Value $disableMgmtRaw)
        }
        elseif (-not (Test-BlankValue $enableMgmtRaw)) {
            $automaticManagement = ConvertTo-BooleanValue -Value $enableMgmtRaw
        }

        $isSafeChange = ($targetSafe -ne $current.safeName)

        if ($deviceTypeMismatch) {
            $result.Action = 'DeviceTypeMigrationCreate'

            Write-RunLog 'Invoke-RowUpdate' "Device-type mismatch detected. Auto-recreate path selected. Current '$($currentPlatform.general.id)'=$currentDeviceType, Target '$($targetPlatform.general.id)'=$targetDeviceType." 'WARN'

            if (-not (Test-SafeExists -SafeName $targetSafe -Token $Token)) {
                throw "Target Safe '$targetSafe' was not found or API user cannot access it."
            }

            # Validate required target platform properties early.
            Assert-RequiredPlatformPropertiesPresent -Properties $csvProps `
                -Platform $targetPlatform `
                -Context "Device-type migration to '$($targetPlatform.general.id)'" `
                -CurrentAccount $current `
                -TargetAddress $targetAddress `
                -TargetUserName $targetUserName `
                -TargetName $targetName `
                -TargetSafe $targetSafe

            if ($Preview) {
                $result.Result = 'PREVIEW'
                $result.Message = 'Device-type migration auto-detected and validated. No account created because -Preview was supplied.'

                Add-DeleteCandidateRow -Row ([pscustomobject]@{
                    Row = $RowNumber
                    SourceAccountID = $current.id
                    SourceSafe = $current.safeName
                    SourceName = $current.name
                    SourcePlatform = $current.platformId
                    SourceDeviceType = $currentDeviceType
                    TargetSafe = $targetSafe
                    TargetPlatform = $targetPlatformId
                    TargetDeviceType = $targetDeviceType
                    NewAccountID = ''
                    Status = 'PREVIEW_DELETE_CANDIDATE'
                    Note = 'Source would be reviewed for deletion after migration validation.'
                })

                Write-RunLog 'Invoke-RowUpdate' "PREVIEW migration candidate. SourceAccountID=$($current.id) SourcePlatform=$($current.platformId) TargetPlatform=$targetPlatformId" 'WARN'

                return [pscustomobject]$result
            }

            $newAccount = Invoke-DeviceTypeMigrationCreate -CurrentAccount $current `
                -TargetPlatform $targetPlatform `
                -TargetSafe $targetSafe `
                -TargetName $targetName `
                -TargetAddress $targetAddress `
                -TargetUserName $targetUserName `
                -TargetPlatformId $targetPlatformId `
                -AutomaticManagement $automaticManagement `
                -ManualManagementReason $manualReason `
                -PlatformProperties $csvProps `
                -Token $Token

            $result.NewAccountID = $newAccount.id

            Add-RecreatedAccountRow -Row ([pscustomobject]@{
                Row = $RowNumber
                SourceAccountID = $current.id
                NewAccountID = $newAccount.id
                SourceSafe = $current.safeName
                TargetSafe = $targetSafe
                SourceName = $current.name
                NewName = $newAccount.name
                SourcePlatform = $current.platformId
                TargetPlatform = $targetPlatformId
                SourceDeviceType = $currentDeviceType
                TargetDeviceType = $targetDeviceType
                NewAccountAutomaticManagement = if ($EnableCpmOnDuplicatedAccount) { 'NotForcedDisabled' } else { 'DisabledForValidation' }
                CreatedTime = (Get-Date -Format s)
            })

            Write-RunLog 'Invoke-RowUpdate' "RECREATED account. SourceAccountID=$($current.id) NewAccountID=$($newAccount.id) SourcePlatform=$($current.platformId) TargetPlatform=$targetPlatformId" 'WARN'

            $sourceNote = 'Source account kept by default.'

            if ($DisableSourceAfterMigration) {
                Disable-SourceAccountCpm -AccountId $current.id -Token $Token -Reason "Migration complete. NewAccountID=$($newAccount.id). $SafeMoveReason"
                $sourceNote = 'Source account kept and CPM automatic management disabled.'
            }

            try {
                $deleteNote = Remove-SourceAccountAfterMigration -AccountId $current.id -Token $Token
                $sourceNote = "$sourceNote $deleteNote"
            }
            catch {
                $result.Result = 'PARTIAL'
                $result.Message = "New account created, but source cleanup failed. NewAccountID=$($newAccount.id). $($_.Exception.Message)"

                Add-DeleteCandidateRow -Row ([pscustomobject]@{
                    Row = $RowNumber
                    SourceAccountID = $current.id
                    SourceSafe = $current.safeName
                    SourceName = $current.name
                    SourcePlatform = $current.platformId
                    SourceDeviceType = $currentDeviceType
                    TargetSafe = $targetSafe
                    TargetPlatform = $targetPlatformId
                    TargetDeviceType = $targetDeviceType
                    NewAccountID = $newAccount.id
                    Status = 'DELETE_REVIEW_REQUIRED'
                    Note = $result.Message
                })

                return [pscustomobject]$result
            }

            $deleteStatus = if ($DeleteSourceAfterMigration -and $ConfirmDeleteSourceAfterMigration -eq 'YES') { 'DELETED' } else { 'DELETE_CANDIDATE' }

            Add-DeleteCandidateRow -Row ([pscustomobject]@{
                Row = $RowNumber
                SourceAccountID = $current.id
                SourceSafe = $current.safeName
                SourceName = $current.name
                SourcePlatform = $current.platformId
                SourceDeviceType = $currentDeviceType
                TargetSafe = $targetSafe
                TargetPlatform = $targetPlatformId
                TargetDeviceType = $targetDeviceType
                NewAccountID = $newAccount.id
                Status = $deleteStatus
                Note = $sourceNote
            })

            Write-RunLog 'Invoke-RowUpdate' "SOURCE review. SourceAccountID=$($current.id) NewAccountID=$($newAccount.id) Status=$deleteStatus Note=$sourceNote" 'WARN'

            $result.Result = 'SUCCESS'
            $newAccountCpmNote = if ($EnableCpmOnDuplicatedAccount) { 'New account CPM state was not forced disabled.' } else { 'New account Automatic Password Management disabled for validation.' }
            $result.Message = "Device-type migration created new account. NewAccountID=$($newAccount.id). $newAccountCpmNote $sourceNote"

            return [pscustomobject]$result
        }

        if ($isSafeChange) {
            $result.Action = 'SafeMoveCreate'

            Write-RunLog 'Invoke-RowUpdate' "Safe change detected. Auto-create path selected. CurrentSafe='$($current.safeName)' TargetSafe='$targetSafe'." 'WARN'

            if (-not (Test-SafeExists -SafeName $targetSafe -Token $Token)) {
                throw "Target Safe '$targetSafe' was not found or API user cannot access it."
            }

            $mergedForCreate = Merge-PlatformProperties -CurrentProperties $current.platformAccountProperties -CsvProperties $csvProps
            Assert-RequiredPlatformPropertiesPresent -Properties $mergedForCreate `
                -Platform $targetPlatform `
                -Context "Safe move/create to '$($targetPlatform.general.id)'" `
                -CurrentAccount $current `
                -TargetAddress $targetAddress `
                -TargetUserName $targetUserName `
                -TargetName $targetName `
                -TargetSafe $targetSafe

            if ($Preview) {
                $result.Result = 'PREVIEW'
                $result.Message = 'Safe change validated. No account created because -Preview was supplied.'
                return [pscustomobject]$result
            }

            $newAccount = Invoke-SafeMoveCreate -CurrentAccount $current `
                -TargetSafe $targetSafe `
                -TargetName $targetName `
                -TargetAddress $targetAddress `
                -TargetUserName $targetUserName `
                -TargetPlatformId $targetPlatformId `
                -AutomaticManagement $automaticManagement `
                -ManualManagementReason $manualReason `
                -PlatformProperties $csvProps `
                -Token $Token

            $result.NewAccountID = $newAccount.id

            Add-RecreatedAccountRow -Row ([pscustomobject]@{
                Row = $RowNumber
                SourceAccountID = $current.id
                NewAccountID = $newAccount.id
                SourceSafe = $current.safeName
                TargetSafe = $targetSafe
                SourceName = $current.name
                NewName = $newAccount.name
                SourcePlatform = $current.platformId
                TargetPlatform = $targetPlatformId
                SourceDeviceType = $currentDeviceType
                TargetDeviceType = $targetDeviceType
                NewAccountAutomaticManagement = if ($EnableCpmOnDuplicatedAccount) { 'NotForcedDisabled' } else { 'DisabledForValidation' }
                CreatedTime = (Get-Date -Format s)
            })

            try {
                $deleteNote = Remove-SourceAccountAfterMove -AccountId $current.id -Token $Token
                $result.Result = 'SUCCESS'
                $newAccountCpmNote = if ($EnableCpmOnDuplicatedAccount) { 'New account CPM state was not forced disabled.' } else { 'New account Automatic Password Management disabled for validation.' }
                $result.Message = "Created target Safe account. NewAccountID=$($newAccount.id). $newAccountCpmNote $deleteNote"

                Add-DeleteCandidateRow -Row ([pscustomobject]@{
                    Row = $RowNumber
                    SourceAccountID = $current.id
                    SourceSafe = $current.safeName
                    SourceName = $current.name
                    SourcePlatform = $current.platformId
                    SourceDeviceType = $currentDeviceType
                    TargetSafe = $targetSafe
                    TargetPlatform = $targetPlatformId
                    TargetDeviceType = $targetDeviceType
                    NewAccountID = $newAccount.id
                    Status = if ($DeleteSourceAfterMigration -and $ConfirmDeleteSourceAfterMigration -eq 'YES') { 'DELETED' } else { 'DELETE_CANDIDATE' }
                    Note = $deleteNote
                })
            }
            catch {
                $result.Result = 'PARTIAL'
                $result.Message = "Created target Safe account, but source cleanup failed. NewAccountID=$($newAccount.id). $($_.Exception.Message)"
            }

            return [pscustomobject]$result
        }

        # Same-Safe and same-device updates use PATCH.
        $patchOps = New-PatchBody -CurrentAccount $current `
            -TargetName $targetName `
            -TargetAddress $targetAddress `
            -TargetUserName $targetUserName `
            -TargetPlatformId $targetPlatformId `
            -AutomaticManagement $automaticManagement `
            -ManualManagementReason $manualReason `
            -PlatformProperties $csvProps

        if ($patchOps.Count -eq 0) {
            $result.Action = 'NoChange'
            $result.Result = 'SKIPPED'
            $result.Message = 'No changed values were supplied in the CSV row.'
            return [pscustomobject]$result
        }

        $result.Action = 'PatchAccount'

        if ($Preview) {
            $result.Result = 'PREVIEW'
            $result.Message = "Patch validated. Operation count=$($patchOps.Count). No update sent because -Preview was supplied."
            return [pscustomobject]$result
        }

        Invoke-AccountPatch -AccountId $accountId -PatchOps $patchOps -Token $Token | Out-Null

        $result.Result = 'SUCCESS'
        $result.Message = "Patched account. Operation count=$($patchOps.Count)."

        return [pscustomobject]$result
    }
    catch {
        $result.Result = 'FAILED'
        $result.Message = $_.Exception.Message

        return [pscustomobject]$result
    }
}

function Start-AccountUpdateRun {
    <#
        Main workflow.
    #>
    New-RunLog
    Import-RunConfig

    if ($DeleteSourceAfterMigration -and $ConfirmDeleteSourceAfterMigration -ne 'YES') {
        Write-RunLog 'Start-AccountUpdateRun' 'DeleteSourceAfterMigration supplied without ConfirmDeleteSourceAfterMigration YES. Source accounts will be kept.' 'WARN'
    }

    if ($Preview) {
        Write-RunLog 'Start-AccountUpdateRun' 'Preview mode enabled. No account update/create/delete calls will be sent.' 'WARN'
    }

    Write-RunLog 'Start-AccountUpdateRun' 'Device-type migration auto-detection is enabled. Source accounts are kept unless delete confirmation is explicitly supplied.' 'INFO'

    if ($EnableCpmOnDuplicatedAccount) {
        Write-RunLog 'Start-AccountUpdateRun' 'EnableCpmOnDuplicatedAccount supplied. Duplicated/recreated target accounts will not be forced to Automatic Password Management disabled.' 'WARN'
    }
    else {
        Write-RunLog 'Start-AccountUpdateRun' 'Duplicated/recreated target accounts will be created with Automatic Password Management disabled for validation.' 'INFO'
    }

    Write-RunLog 'Start-AccountUpdateRun' "Using CSV file: $CsvFile" 'INFO'

    $rows = Get-CsvRows
    $token = Get-IdentityBearerToken
    Get-PlatformInventory -Token $token

    $rowNumber = 1

    foreach ($row in $rows) {
        Write-RunLog 'Start-AccountUpdateRun' "Processing CSV row $rowNumber" 'INFO'

        $outcome = Invoke-RowUpdate -CsvRow $row -RowNumber $rowNumber -Token $token

        Add-ReportRow -Row $outcome

        if ($outcome.Result -eq 'FAILED') {
            Write-RunLog 'Start-AccountUpdateRun' "Row $rowNumber failed. AccountID=$($outcome.AccountID) Message=$($outcome.Message)" 'ERROR'
        }
        else {
            Write-RunLog 'Start-AccountUpdateRun' "Row $rowNumber $($outcome.Result). AccountID=$($outcome.AccountID) Action=$($outcome.Action) NewAccountID=$($outcome.NewAccountID)" 'INFO'
        }

        $rowNumber++
    }

    Write-RunLog 'Start-AccountUpdateRun' "Run completed. MainReport=$script:ReportFile" 'INFO'
    Write-RunLog 'Start-AccountUpdateRun' "RecreatedAccountReport=$script:RecreatedReportFile" 'INFO'
    Write-RunLog 'Start-AccountUpdateRun' "DeleteCandidateReport=$script:DeleteCandidateReportFile" 'INFO'
    Write-RunLog 'Start-AccountUpdateRun' "Log=$script:LogFile" 'INFO'
}

Start-AccountUpdateRun
