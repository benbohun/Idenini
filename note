below is an example

<# 
  .SYNOPSIS
    script updates accounts using REST API based on csv input
  .DESCRIPTION
    PAM Team 2/25/2026
        - usages
            - used to migrate domain accounts from OMNG to AMNG safes 
            - update `$HEADER`, `$BACKOUT_HEADER`, and patch $fields to fit use case
        - dependencies
            - API user that has access to safes (svcmigrationapi)
            - authentication requires D:\scripts\wpa\automations\auth\Get-AuthToken.ps1
            - CSV file that contains both current values and new values, 
            where the new-value column name is prepended with `Migrated `
            - CSV file must also contain `Account ID`, used to determine api endpoint
        - known issues
            - cannot update device type, therefore cannot change platform that is different device type
                - use classic web ui for bulk ops
            - cannot move accounts to another safe
                - use classic web ui for bulk ops
                - accountid changes per safe
                - to get previous password versions, move back to old safe 
            - not an issue: replacing 1 platform prop only replaces that prop, and does not affect other props
  .EXAMPLE
    .\update-accounts -CSVFile <CSVFilePath> [-Backout] [-LogID <STRING>]
#>

param(
  [Parameter(mandatory=$true)]
  [string]$CSVFile,
  [switch]$Backout,
  [string]$LogID=""
)

$Global:proxy=""
$Global:pvwa=""
$Global:logger=""
$LOGS=".\logs"
$HEADER="Migrated Platform ID,Migrated Target system address,Migrated Target system user name,Account ID"
$BACKOUT_HEADER="Platform ID,Target system address,Target system user name,Account ID,Name"
$SCRIPT = [System.IO.Path]::GetFileNameWithoutExtension($PSCommandPath)
if ($Backout){$HEADER = $BACKOUT_HEADER}
$DebugPreference = "Continue" #TODO: turn off before production
#$DebugPreference = "SilentlyContinue"

<#
    setup and start new log file
#>
function New-Log() {
    try {
        $dt = (Get-Date).ToString("yyyyMMdd-HHmmss")
        $fd += "${SCRIPT}_$dt"
        if ($LogID -ne "") {$fd += "_$LogID"}
        if ($Backout) {$fd += "_Backout"}
        $Global:logger = "$LOGS\$fd.log"
        Set-Content -Path $Global:logger -Value "Starting new log..." -ErrorAction Stop
        $func = $MyInvocation.MyCommand.Name
        Write-Log "$func ($SCRIPT)" "Starting new log" "DEBUG"
    }
    catch {
        write-error $_
    }
}

<#
    writes standard log messages
#>
function Write-Log([string]$src, [string]$msg, [string]$level="INFO"){
    try {
        $dt = (Get-Date).ToString("yyyyMMdd-HHmmss")
        Add-Content -Path $Global:logger -Value "$dt source=$src [$level] $msg" -ErrorAction Stop
    }
    catch {
        Write-Error $_
    }
}

<#
    determines domain and uses appropriate <DOAMIN>.env file
#>
function Set-Env(){
    $func = $MyInvocation.MyCommand.Name
    try {
        $domain = ${env:USERDOMAIN}.ToLower()
        $fd = "$domain.env"
        $data = (Get-Content -Raw $fd -ErrorAction Stop).Trim() -split "`n" #XXX: .Split("`n") pwsh replaced `n with " "  
        $Global:proxy = $data[0].Trim().Split("=")[1]
        $Global:pvwa = $data[1].Trim().Split("=")[1]

        # set proxy
        [System.Net.WebRequest]::DefaultWebProxy = New-Object System.Net.WebProxy($Global:proxy) -ErrorAction Stop
        Write-Log "$func ($SCRIPT)" "$domain environment setup successful" "DEBUG"
    }
    catch {
        Write-Log "$func ($SCRIPT)" $_ "ERROR"        
        write-error $_
    }
}

<# 
    tests and gets CSV data
#>
function Get-CSV(){
    $func = $MyInvocation.MyCommand.Name    
    try {
        # test file exists
        if (-not (test-path $CSVFile)) {throw [System.IO.FileNotFoundException]::new("ERROR: File Not Found: $CSVFile", $CSVFile)}

        # test file is not empty
        if ((Get-Item $CSVFile).Length -eq 0) {throw "ERROR: File Is Empty: $CSVFile"}

        # test min required header
        $requiredHeader = $HEADER.Split(",")
        $fileHeader = (Get-Content -Path $CSVFile -First 1).TrimStart("`u{FEFF}") -split ','        
        $missingHeader = $requiredHeader | Where-Object { $_ -notin $fileheader }
        if ($missingHeader) {throw "ERROR: Missing Required Column(s): $($missingHeader -join ', ')"}

        # get data
        $rows = Import-Csv -Path $CSVFile | 
            Where-Object {
                # Keep the row if at least one field has non-whitespace content
                ($_.PSObject.Properties.Value | Where-Object {
                    $_ -ne $null -and $_.ToString().Trim().Length -gt 0
                }).Count -gt 0
            }
        # test data exists
        if ($rows.Length -eq 0) {throw "ERROR: No Data Rows to Process: $CSVFile"}
        Write-Log "$func ($SCRIPT)" "Captured $($rows.Length) data rows successful" "DEBUG"
        $rows = $rows | Select-Object $requiredHeader
        return $rows
    }
    catch {
        Write-Log "$func ($SCRIPT)" $_ "ERROR"        
        write-error $_        
    }
}

<#
    gets identity oauth token
    #TODO: get new token after x api calls
#>
function Get-Token() {
    $func = $MyInvocation.MyCommand.Name    
    try {
        $token = & $AUTHN
        $token = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto([System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($token.Password))
        Write-Log "$func ($SCRIPT)" "Acquired token successful" "DEBUG"
        return $token
    }
    catch {
        Write-Log "$func ($SCRIPT)" $_ "ERROR: Cannot aquire token using: $AUTHN"  
        Write-Error $_
    }
}

<# 
    call rest api to update accounts 
#>
function Invoke-API($token, [PSCustomObject]$obj){
    $func = $MyInvocation.MyCommand.Name    
    $id = $obj.PSObject.Properties['Account ID'].Value
    try {
        $fields = @(
            'Migrated Target system address',
            'Migrated Target system user name'#,
            #'Migrated Platform ID',
            )
        $secretMgmt = $true

        # test case for backout header
        if ($Backout) {
            for ($i=0; $i -lt $fields.Length; $i++){
                $fields[$i] = ($fields[$i]).Replace('Migrated ', "")
            }
            $secretMgmt = $false
        }

        # update account - patch body must be an array of objects
        $_name = $obj.PSObject.Properties[$fields[0]].Value + "-" + $obj.PSObject.Properties[$fields[1]].Value
        if ($Backout){$_name = $obj.PSObject.Properties['Name'].Value}
        $_address = $obj.PSObject.Properties[$fields[0]].Value
        $_username = $obj.PSObject.Properties[$fields[1]].Value
        #$_platform =  $obj.PSObject.Properties[$fields[2]].Value

        $PatchBody = @(
            @{ op = "replace"; path = "/name"; value = $_name},
            @{ op = "replace"; path = "/address"; value = $_address},
            @{ op = "replace"; path = "/userName"; value = $_username},
            #@{ op = "replace"; path = "/platformID"; value = $_platform},
            @{ op = "replace"; path = "/secretManagement/automaticManagementEnabled"; value = $secretMgmt }
            )

        # remove or add reason based on if cpm mgmt is enabled 
        if ($secretMgmt) {
            #$PatchBody += @{ op = "remove"; path = "/secretManagement/manualManagementReason"}
            $PatchBody += @{ op = "replace"; path = "/secretManagement/manualManagementReason"; value = ""}            
        }
        else {
            $PatchBody += @{ op = "replace"; path = "/secretManagement/manualManagementReason"; value = "Backout: AMNG=>OMNG"}
        }

        $PatchBody = $PatchBody | ConvertTo-Json
        write-debug $PatchBody

        $headers = @{Authorization = "Bearer $token"}        
        $Updated = Invoke-RestMethod -Method PATCH `
        -Uri "$PVWA/$id" `
        -Headers $headers -ContentType "application/json" -Body $PatchBody
        Write-Debug ($Updated | ConvertTo-Json)

        Write-Host "Processed ACCOUNT_ID=$id ($_name) successful"
        Write-Log "$func ($SCRIPT)" "Processed ACCOUNT_ID=$id ($_name) successfully"
    }
    catch {
        Write-Host "ERROR: Cannot process ACCOUNT_ID=$id ($_name)"          
        Write-Log "$func ($SCRIPT)" $_ "ERROR: Cannot process ACCOUNT_ID=$id ($_name)"  
        #continue to next account
    }
}

<#
    main
#>
function Start-Script() {
    New-Log
    Set-Env
    $dataRows = Get-CSV
    Write-Debug ( ($dataRows | Format-Table -AutoSize | Out-String).TrimEnd() )
    $token = Get-Token
    #process data rows by calling rest api for each row
    $dataRows | % {
                    Invoke-API $token $_
                    write-debug ($_ | ConvertTo-Json -Depth 5)
                    #$_.PSObject.Properties | Select-Object Name, value
                    #Start-Sleep 10
    }
}

Start-Script


