<#
CCP → Identity Service User → Privilege Cloud → Safe + Domain Group Membership

Fixes:
  - Handles "Member <group> has not been defined" by:
      * Searching Privilege Cloud Groups (Directory) first
      * Using -SearchIn with the correct LDAP directory name (if applicable)
      * Retrying with UPN (group@domain) when only sAM was supplied
      * Optional: LDAP lookup in on-prem AD to confirm the group exists there

Notes:
  - Parser error fixed by removing nested quotes inside a double-quoted string
  - PreferredLDAPDirectoryName should be the PVWA LDAP directory "name/id" (not the domain)
    Example values are often like: "alliantcreditunion" / "ACU" / "corp.local" depending on LDAP Integration config
#>

[CmdletBinding(SupportsShouldProcess=$true)]
param(
    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CPM / Safe settings =====
    [string]$ManagingCPM        = "HQVECYBARK101",
    [string]$Location           = "\",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Directory behavior =====
    [string]$DefaultUPNSuffix   = "alliantcreditunion.com",

    # OPTIONAL: If your PVWA LDAP Integration directory name/id is known, set it here.
    # If blank, the script will TRY to discover via Get-PASDirectory (requires Vault Admin rights).
    [string]$PreferredLDAPDirectoryName = "alliantcreditunion.com"
)

# --- Modules & TLS ---
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# --- Pretty log helpers ---
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

# --- GUI input helpers (fallback to Read-Host) ---
Add-Type -AssemblyName System.Windows.Forms | Out-Null
Add-Type -AssemblyName System.Drawing       | Out-Null

function Show-InputDialog {
    param(
        [Parameter(Mandatory)][string]$Title,
        [Parameter(Mandatory)][string]$Prompt,
        [Parameter()][string]$Default = '',
        [Parameter()][scriptblock]$ValidateScript = {$true},
        [Parameter()][string]$ValidationHint = ''
    )
    try {
        $form                 = New-Object System.Windows.Forms.Form
        $form.Text            = $Title
        $form.StartPosition   = 'CenterScreen'
        $form.TopMost         = $true
        $form.Size            = New-Object System.Drawing.Size(520,200)
        $form.FormBorderStyle = 'FixedDialog'
        $form.MaximizeBox     = $false

        $lbl                  = New-Object System.Windows.Forms.Label
        $lbl.Text             = $Prompt
        $lbl.AutoSize         = $true
        $lbl.Location         = '12,15'
        $lbl.Font             = New-Object System.Drawing.Font('Segoe UI',10)
        $form.Controls.Add($lbl)

        $tb                   = New-Object System.Windows.Forms.TextBox
        $tb.Location          = '16,48'
        $tb.Width             = 470
        $tb.Text              = $Default
        $tb.Font              = New-Object System.Drawing.Font('Consolas',11)
        $form.Controls.Add($tb)

        $hint                 = New-Object System.Windows.Forms.Label
        $hint.AutoSize        = $true
        $hint.ForeColor       = [System.Drawing.Color]::DarkGray
        $hint.Text            = $ValidationHint
        $hint.Location        = '16,80'
        $form.Controls.Add($hint)

        $ok                   = New-Object System.Windows.Forms.Button
        $ok.Text              = 'Continue'
        $ok.Location          = '312,120'
        $ok.Width             = 80
        $ok.DialogResult      = [System.Windows.Forms.DialogResult]::OK
        $form.AcceptButton    = $ok
        $form.Controls.Add($ok)

        $cancel               = New-Object System.Windows.Forms.Button
        $cancel.Text          = 'Cancel'
        $cancel.Location      = '406,120'
        $cancel.Width         = 80
        $cancel.DialogResult  = [System.Windows.Forms.DialogResult]::Cancel
        $form.CancelButton    = $cancel
        $form.Controls.Add($cancel)

        $tb.add_TextChanged({
            try {
                if (& $ValidateScript $tb.Text) { $tb.BackColor = [System.Drawing.Color]::White }
                else                            { $tb.BackColor = [System.Drawing.Color]::MistyRose }
            } catch {
                $tb.BackColor = [System.Drawing.Color]::MistyRose
            }
        })

        $dialog = $form.ShowDialog()
        if ($dialog -ne [System.Windows.Forms.DialogResult]::OK) { return $null }

        $val = $tb.Text.Trim()
        if (-not (& $ValidateScript $val)) {
            [System.Windows.Forms.MessageBox]::Show(
                "Value is invalid. Please try again.",
                "Validation",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null
            return Show-InputDialog @PSBoundParameters
        }
        return $val
    } catch {
        $val = Read-Host "$Title - $Prompt"
        if (-not (& $ValidateScript $val)) { throw "Input failed validation." }
        return $val
    }
}

# --- Permissions helpers ---
function Get-AdminPerms {
    @{
        UseAccounts                             = $true
        RetrieveAccounts                        = $true
        ListAccounts                            = $true
        AddAccounts                             = $true
        UpdateAccountContent                    = $true
        UpdateAccountProperties                 = $true
        InitiateCPMAccountManagementOperations  = $true
        SpecifyNextAccountContent               = $true
        RenameAccounts                          = $true
        DeleteAccounts                          = $true
        UnlockAccounts                          = $true
        ManageSafe                              = $true
        ManageSafeMembers                       = $true
        BackupSafe                              = $true
        ViewAuditLog                            = $true
        ViewSafeMembers                         = $true
        AccessWithoutConfirmation               = $true
        CreateFolders                           = $true
        DeleteFolders                           = $true
        MoveAccountsAndFolders                  = $true
    }
}

function Get-CarkPerms {
    @{
        UseAccounts                             = $true
        RetrieveAccounts                        = $true
        ListAccounts                            = $true
        AddAccounts                             = $false
        UpdateAccountContent                    = $true
        UpdateAccountProperties                 = $false
        InitiateCPMAccountManagementOperations  = $true
        SpecifyNextAccountContent               = $true
        RenameAccounts                          = $false
        DeleteAccounts                          = $false
        UnlockAccounts                          = $false
        ManageSafe                              = $false
        ManageSafeMembers                       = $false
        BackupSafe                              = $false
        ViewAuditLog                            = $true
        ViewSafeMembers                         = $true
        AccessWithoutConfirmation               = $true
        CreateFolders                           = $false
        DeleteFolders                           = $false
        MoveAccountsAndFolders                  = $false
    }
}

# --- CCP → PSCredential (API Service User) ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }

    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content. Raw: $($resp | ConvertTo-Json -Depth 5)"
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- Discover LDAP directory name (for -SearchIn) ---
function Get-EffectiveLDAPDirectoryName {
    param([string]$Preferred)

    if ($Preferred -and $Preferred.Trim()) {
        Write-Info "Using configured LDAP directory name for -SearchIn: '$Preferred'"
        return $Preferred.Trim()
    }

    try {
        $dirs = Get-PASDirectory -ErrorAction Stop
        if ($dirs) {
            $match = $dirs | Where-Object {
                ($_.DomainName -and $_.DomainName -like "*$DefaultUPNSuffix*") -or
                ($_.id -and $_.id -like "*$DefaultUPNSuffix*") -or
                ($_.DomainName -and $_.DomainName -like "*alliant*")
            } | Select-Object -First 1

            if (-not $match) { $match = $dirs | Select-Object -First 1 }

            if ($match) {
                $name = $match.id
                Write-Info "Auto-discovered LDAP directory name for -SearchIn: '$name'"
                return $name
            }
        }
    } catch {
        Write-Warn "Could not auto-discover LDAP directory name (Get-PASDirectory may require Vault Admin). We'll still try without -SearchIn."
    }

    return $null
}

# --- Search Privilege Cloud for a directory group (API-backed via Get-PASGroup) ---
function Find-DirectoryGroupInVault {
    param([Parameter(Mandatory)][string]$GroupNameNoDomain)

    try {
        $hits = Get-PASGroup -groupType Directory -search $GroupNameNoDomain -ErrorAction Stop
        if ($hits) {
            $exact = $hits | Where-Object { $_.groupName -eq $GroupNameNoDomain } | Select-Object -First 1
            if ($exact) { return $exact }
            return ($hits | Select-Object -First 1)
        }
    } catch { }
    return $null
}

# --- Optional: LDAP query to check group exists in on-prem AD (no RSAT needed) ---
function Test-GroupExistsInADViaLDAP {
    param([Parameter(Mandatory)][string]$GroupSam)

    try {
        Add-Type -AssemblyName System.DirectoryServices -ErrorAction Stop
        $root = New-Object System.DirectoryServices.DirectoryEntry("LDAP://RootDSE")
        $baseDN = $root.Properties["defaultNamingContext"][0]
        if (-not $baseDN) { return $false }

        $searchRoot = New-Object System.DirectoryServices.DirectoryEntry("LDAP://$baseDN")
        $ds = New-Object System.DirectoryServices.DirectorySearcher($searchRoot)
        $ds.Filter = "(&(objectCategory=group)(sAMAccountName=$GroupSam))"
        $ds.PageSize = 200
        $res = $ds.FindOne()
        return [bool]$res
    } catch {
        return $false
    }
}

# --- Safe member ensure helper (supports -SearchIn + retry logic) ---
function Ensure-SafeMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,   # sAM or UPN
        [Parameter(Mandatory)][ValidateSet('User','Group','Role')][string]$MemberType,
        [Parameter(Mandatory)][hashtable]$PermFlags,
        [Parameter()][string]$SearchIn
    )

    $cmdAdd = Get-Command Add-PASSafeMember -ErrorAction Stop
    $cmdSet = Get-Command Set-PASSafeMember -ErrorAction Stop
    $supportsMemberType = $cmdAdd.Parameters.ContainsKey('MemberType')
    $supportsSearchIn   = $cmdAdd.Parameters.ContainsKey('SearchIn')

    # ✅ FIX: avoid nested quotes inside a double-quoted string (prevents parser error)
    $searchMsg = if ($SearchIn) { "; SearchIn=$SearchIn" } else { "" }
    Write-Info ("Processing member '{0}' on '{1}' (Type={2}){3}..." -f $MemberName, $SafeName, $MemberType, $searchMsg)

    $existing = $null
    try {
        $existing = Get-PASSafeMember -SafeName $SafeName -Search $MemberName -ErrorAction SilentlyContinue |
                    Where-Object { $_.MemberName -eq $MemberName }
    } catch { }

    $permParams = @{}
    foreach ($k in $PermFlags.Keys) { $permParams[$k] = $PermFlags[$k] }

    $splat = @{
        SafeName   = $SafeName
        MemberName = $MemberName
    }
    if ($supportsMemberType) { $splat.MemberType = $MemberType }
    if ($supportsSearchIn -and $SearchIn) { $splat.SearchIn = $SearchIn }
    $splat += $permParams

    if ($existing) {
        Write-Info "Member exists; updating permissions via Set-PASSafeMember..."
        $setSplat = @{} + $splat
        if (-not $cmdSet.Parameters.ContainsKey('MemberType')) { $setSplat.Remove('MemberType') | Out-Null }
        if (-not $cmdSet.Parameters.ContainsKey('SearchIn'))   { $setSplat.Remove('SearchIn')   | Out-Null }

        Set-PASSafeMember @setSplat -ErrorAction Stop | Out-Null
        Write-Ok  "Updated '$MemberName' on '$SafeName'."
    }
    else {
        Write-Info "Member not found; adding via Add-PASSafeMember..."
        Add-PASSafeMember @splat -ErrorAction Stop | Out-Null
        Write-Ok  "Added '$MemberName' to '$SafeName'."
    }
}

# --- MAIN ---
$sessionCreated = $false

try {
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    $ldapDirName = Get-EffectiveLDAPDirectoryName -Preferred $PreferredLDAPDirectoryName

    $safeName = Show-InputDialog -Title "New Safe" `
        -Prompt "Enter the Safe name (must start with APP_ or AAM_):" `
        -Default "APP_" `
        -ValidationHint "Examples: APP_MyApp_Prod, AAM_MySvc_NonProd" `
        -ValidateScript {
            param($x)
            $t = $x.Trim()
            if ([string]::IsNullOrWhiteSpace($t)) { return $false }
            return ($t.StartsWith('APP_') -or $t.StartsWith('AAM_'))
        }

    if (-not $safeName) { Write-Warn "Safe name entry cancelled."; return }

    Write-Info "Provisioning Safe: $safeName"

    $exists = $null
    try { $exists = Get-PASSafe -SafeName $safeName -ErrorAction SilentlyContinue } catch {}

    if (-not $exists) {
        $splat = @{
            SafeName              = $safeName
            Description           = ""
            ManagingCPM           = $ManagingCPM
            NumberOfDaysRetention = 120
            location              = $Location
        }
        if ($PSCmdlet.ShouldProcess($safeName, "Add-PASSafe")) {
            Add-PASSafe @splat -ErrorAction Stop | Out-Null
            Write-Ok "Safe created: '$safeName' (Retention: 120 days)."
        }
    }
    else {
        Write-Warn "Safe '$safeName' already exists; enforcing retention=120."
        try {
            Set-PASSafe -SafeName $safeName -NumberOfDaysRetention 120 -ErrorAction Stop | Out-Null
            Write-Ok "Retention updated on existing Safe."
        } catch {
            Write-Warn "Could not update existing Safe retention: $($_.Exception.Message)"
        }
    }

    $permAdmin = Get-AdminPerms
    $permCark  = Get-CarkPerms

    $iamUpn = "IAM_ACU_CA_Admins@$DefaultUPNSuffix"
    $iamSam = "IAM_ACU_CA_Admins"

    Write-Info "Adding/updating IAM_ACU_CA_Admins on '$safeName'..."
    $iamDone = $false

    foreach ($try in @(
        @{ Name=$iamUpn; SearchIn=$ldapDirName },
        @{ Name=$iamUpn; SearchIn=$null      },
        @{ Name=$iamSam; SearchIn=$ldapDirName },
        @{ Name=$iamSam; SearchIn=$null      }
    )) {
        if ($iamDone) { break }
        try {
            Ensure-SafeMember -SafeName $safeName -MemberName $try.Name -MemberType Group -PermFlags $permAdmin -SearchIn $try.SearchIn
            $iamDone = $true
        } catch {
            $si = if ($try.SearchIn) { " (SearchIn=$($try.SearchIn))" } else { "" }
            Write-Warn ("IAM add attempt failed for '{0}'{1}: {2}" -f $try.Name, $si, $_.Exception.Message)
        }
    }

    if (-not $iamDone) { throw "Failed to add IAM_ACU_CA_Admins by all methods." }
    Write-Ok "IAM_ACU_CA_Admins membership ensured on '$safeName' (full classic rights)."

    $ownerGroup = Show-InputDialog -Title "Safe Owner (CARK_ Group)" `
        -Prompt "Enter the AD group that will own the Safe (sAM or UPN, must start with CARK_):" `
        -Default "CARK_" `
        -ValidationHint "Examples: CARK_AppTeam_Prod or CARK_AppTeam_Prod@alliantcreditunion.com" `
        -ValidateScript {
            param($x)
            $t = $x.Trim()
            if ([string]::IsNullOrWhiteSpace($t)) { return $false }
            return $t.StartsWith('CARK_')
        }

    if (-not $ownerGroup) {
        Write-Warn "Owner group entry cancelled; skipping owner assignment and description."
    }
    else {
        $ownerNoDomain = $ownerGroup.Split('@')[0]
        $ownerUpn = if ($ownerGroup -match '@') { $ownerGroup } else { "$ownerGroup@$DefaultUPNSuffix" }

        Write-Info "Adding/updating owner group '$ownerGroup' with CARK permissions…"

        $vaultHit = Find-DirectoryGroupInVault -GroupNameNoDomain $ownerNoDomain
        if ($vaultHit) {
            Write-Info ("Privilege Cloud directory search found a matching group: '{0}' (Directory={1})" -f $vaultHit.groupName, $vaultHit.directory)
        } else {
            Write-Warn "Privilege Cloud directory search did NOT find '$ownerNoDomain' as a directory group."
            $adExists = Test-GroupExistsInADViaLDAP -GroupSam $ownerNoDomain
            if ($adExists) {
                Write-Warn "AD LDAP lookup: group EXISTS in AD, but is NOT visible in Privilege Cloud. This usually means LDAP Integration / mapping / sync is missing for that group."
            } else {
                Write-Warn "AD LDAP lookup: group NOT found (or LDAP lookup not available on this host). Double-check the group name."
            }
        }

        $ownerDone = $false
        foreach ($try in @(
            @{ Name=$ownerGroup; SearchIn=$ldapDirName },
            @{ Name=$ownerUpn;   SearchIn=$ldapDirName },
            @{ Name=$ownerGroup; SearchIn=$null      },
            @{ Name=$ownerUpn;   SearchIn=$null      }
        )) {
            if ($ownerDone) { break }
            try {
                Ensure-SafeMember -SafeName $safeName -MemberName $try.Name -MemberType Group -PermFlags $permCark -SearchIn $try.SearchIn
                $ownerDone = $true
            } catch {
                $si = if ($try.SearchIn) { " (SearchIn=$($try.SearchIn))" } else { "" }
                Write-Warn ("Owner add attempt failed for '{0}'{1}: {2}" -f $try.Name, $si, $_.Exception.Message)
            }
        }

        if (-not $ownerDone) {
            throw "Owner group could not be added. Most likely it is not synced/defined in Privilege Cloud (LDAP Integration / directory mapping)."
        }

        try {
            $desc = "Safe Managed By $ownerNoDomain"
            Set-PASSafe -SafeName $safeName -Description $desc -ErrorAction Stop | Out-Null
            Write-Ok "Description set: '$desc'"
        } catch {
            Write-Warn "Could not set description: $($_.Exception.Message)"
        }
    }

    Write-Ok "Provisioning complete for '$safeName'."
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
