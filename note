$TargetHost = "dc16-dc21-mvd1.mandtbank.com"
$Port = 2389

$Protocols = @(
    @{Name="TLS 1.0"; Value=[System.Security.Authentication.SslProtocols]::Tls},
    @{Name="TLS 1.1"; Value=[System.Security.Authentication.SslProtocols]::Tls11},
    @{Name="TLS 1.2"; Value=[System.Security.Authentication.SslProtocols]::Tls12}
)

foreach ($p in $Protocols) {
    Write-Host ""
    Write-Host "Testing $($p.Name)"

    $tcp = $null
    $ssl = $null

    try {
        $tcp = New-Object System.Net.Sockets.TcpClient
        $tcp.Connect($TargetHost,$Port)

        Write-Host "TCP : SUCCESS" -ForegroundColor Green

        $ssl = New-Object System.Net.Security.SslStream(
            $tcp.GetStream(),
            $false,
            { param($sender,$certificate,$chain,$errors) return $true }
        )

        $ssl.AuthenticateAsClient(
            $TargetHost,
            $null,
            $p.Value,
            $false
        )

        Write-Host "TLS : SUCCESS" -ForegroundColor Green
        Write-Host "Negotiated Version : $($ssl.SslProtocol)"
        Write-Host "Cipher             : $($ssl.CipherAlgorithm)"
        Write-Host "Cipher Strength    : $($ssl.CipherStrength)"
    }
    catch {
        Write-Host "TLS : FAILED" -ForegroundColor Red
        Write-Host "Error: $($_.Exception.Message)"

        if ($_.Exception.InnerException) {
            Write-Host "Inner: $($_.Exception.InnerException.Message)"
        }
    }
    finally {
        if ($ssl) { try { $ssl.Dispose() } catch {} }
        if ($tcp) { try { $tcp.Close() } catch {} }
    }
}
