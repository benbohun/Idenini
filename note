#requires -Version 5.1
#requires -Modules psPAS

<#
.SYNOPSIS
    Finds CyberArk accounts with confirmed disabled-user activity (winRc=1331),
    replicates eligible IND_ accounts into the retirement Safe/platform, validates
    the replacement, and deletes the source only after successful validation.

.DESCRIPTION
    This script intentionally uses only exported/public psPAS commands for
    Privilege Cloud account operations. It does not call any private psPAS REST helper or use direct Privilege Cloud REST requests.

    CyberArk does not expose a public psPAS command that changes an account's
    Safe. The supported migration pattern implemented here is:

        Get-PASAccountPassword -> Add-PASAccount -> Get-PASAccount validation
        -> Remove-PASAccount

    Default mode is REPORT ONLY. Specify -Execute to perform the migration.

    Only accounts whose source Safe begins with IND_ are eligible to move by
    default. Confirmed winRc=1331 matches from other Safes are still included in
    the CSV report with a skipped status.

    RelationshipCheckMode defaults to Disabled because the prior implementation
    was blocking every account on an unsupported dependent-account fallback.
    Optional BestEffort and Strict modes use only exported psPAS commands:
    Get-PASLinkedAccount and Get-PASDependentAccount. No REST fallback is used.

.NOTES
    PowerShell      : Windows PowerShell 5.1
    Module          : psPAS
    Script version  : 2026.07.15.7
#>

[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [switch]$Execute,
    [switch]$ScheduledTaskMode,

    [string]$TargetSafeName = "Accounts to be deleted",
    [string]$TargetPlatformID = "WIN_Removed",
    [string]$AllowedSourceSafePrefix = "IND_",

    [string[]]$SourceSafeName = @(),

    [ValidateRange(0, 3650)]
    [int]$LookbackDays = 2,

    [ValidateRange(0, 1000000)]
    [int]$MaxAccounts = 0,

    [ValidateRange(1, 1000)]
    [int]$ProgressInterval = 50,

    [switch]$FullScan,

    [ValidateSet("Disabled", "BestEffort", "Strict")]
    [string]$RelationshipCheckMode = "Disabled",

    [switch]$PreservePlatformAccountProperties,

    [bool]$FinalizeExistingTarget = $true,

    [string]$PasswordRetrievalReason = "Retire disabled CyberArk account after confirmed winRc=1331 activity",

    [string]$ReportFolder = "I:\Script\IDENTITY Script New\logs\Disabled_Account_Migration",

    [ValidateRange(1, 3650)]
    [int]$LogRetentionDays = 90,

    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    [string]$CCPAddress = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation = "AIMWebService",
    [string]$CCPAppID = "ACURestAPI",
    [string]$CCPSafe = "ACU-VAULT-API",
    [string]$CCPObject = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]$CCPWindowsAuth = $false
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

$script:ScriptVersion = "2026.07.15.7"
$script:RunStart = Get-Date
$script:RunId = $script:RunStart.ToString("yyyyMMdd_HHmmss")
$script:LogPath = $null
$script:ReportPath = $null
$script:SummaryPath = $null
$script:PASSessionCreated = $false
$script:Mutex = $null
$script:MutexAcquired = $false
$script:ExitCode = 0
$script:ReportRows = @()
$script:TargetIndex = @{}

$script:DisabledWinRcRegex = '(?i)winRc\s*(?:=|:)\s*1331\b'
$script:DisabledTextRegex = '(?i)(account\s+is\s+currently\s+disabled|account\s+is\s+disabled|user.{0,40}disabled|disabled\s+state|currently\s+disabled)'

$script:FastSavedFilters = @(
    "PolicyFailures",
    "DisabledPasswordByCPM",
    "FailedVerify",
    "FailedChange",
    "FailedReconcile"
)

# ============================================================
# Logging and utility helpers
# ============================================================

function Initialize-OutputFiles {
    if (-not (Test-Path -LiteralPath $ReportFolder)) {
        New-Item -Path $ReportFolder -ItemType Directory -Force | Out-Null
    }

    $script:LogPath = Join-Path $ReportFolder ("Disabled1331_Migration_Log_{0}.log" -f $script:RunId)
    $script:ReportPath = Join-Path $ReportFolder ("Disabled1331_Migration_Report_{0}.csv" -f $script:RunId)
    $script:SummaryPath = Join-Path $ReportFolder "Disabled1331_LastRun.json"
}

function Write-Log {
    param(
        [Parameter(Mandatory)][ValidateSet("INFO", "OK", "WARN", "ERROR")][string]$Level,
        [Parameter(Mandatory)][string]$Message
    )

    $line = "{0} | {1,-5} | {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Write-Host $line

    if (-not [string]::IsNullOrWhiteSpace($script:LogPath)) {
        Add-Content -LiteralPath $script:LogPath -Value $line -Encoding UTF8
    }
}

function Write-Info {
    param([string]$Message)
    Write-Log -Level INFO -Message $Message
}
function Write-Ok {
    param([string]$Message)
    Write-Log -Level OK -Message $Message
}
function Write-Warn {
    param([string]$Message)
    Write-Log -Level WARN -Message $Message
}
function Write-Err {
    param([string]$Message)
    Write-Log -Level ERROR -Message $Message
}

function Get-ObjectPropertyValue {
    param(
        [Parameter()][AllowNull()][object]$InputObject,
        [Parameter(Mandatory)][string[]]$Names
    )

    if ($null -eq $InputObject) {
        return $null
    }

    foreach ($name in $Names) {
        if ($InputObject -is [System.Collections.IDictionary]) {
            foreach ($key in $InputObject.Keys) {
                if ([string]$key -ieq $name) {
                    return $InputObject[$key]
                }
            }
        }

        $property = $InputObject.PSObject.Properties |
            Where-Object { $_.Name -ieq $name } |
            Select-Object -First 1

        if ($null -ne $property) {
            return $property.Value
        }
    }

    return $null
}

function Get-AccountID {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("id", "AccountID", "accountId"))
}

function Get-AccountSafeName {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("safeName", "SafeName", "Safe"))
}

function Get-AccountPlatformID {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("platformId", "PlatformID", "PolicyID"))
}

function Get-AccountUserName {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("userName", "UserName", "username"))
}

function Get-AccountAddress {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("address", "Address"))
}

function Get-AccountName {
    param([AllowNull()][object]$Account)
    return [string](Get-ObjectPropertyValue -InputObject $Account -Names @("name", "Name", "accountName", "AccountName"))
}

function Get-AccountSecretType {
    param([AllowNull()][object]$Account)
    $value = [string](Get-ObjectPropertyValue -InputObject $Account -Names @("secretType", "SecretType"))
    if ([string]::IsNullOrWhiteSpace($value)) {
        return "Password"
    }
    return $value
}

function Get-ManualManagementReason {
    param([AllowNull()][object]$Account)

    $secretManagement = Get-ObjectPropertyValue -InputObject $Account -Names @("secretManagement", "SecretManagement")
    if ($null -eq $secretManagement) {
        return ""
    }

    return [string](Get-ObjectPropertyValue -InputObject $secretManagement -Names @("manualManagementReason", "ManualManagementReason"))
}

function Get-PlatformAccountProperties {
    param([AllowNull()][object]$Account)
    return Get-ObjectPropertyValue -InputObject $Account -Names @("platformAccountProperties", "PlatformAccountProperties")
}

function ConvertTo-Hashtable {
    param([AllowNull()][object]$InputObject)

    if ($null -eq $InputObject) {
        return $null
    }

    $result = @{}

    if ($InputObject -is [System.Collections.IDictionary]) {
        foreach ($key in $InputObject.Keys) {
            $result[[string]$key] = $InputObject[$key]
        }
        return $result
    }

    foreach ($property in $InputObject.PSObject.Properties) {
        $result[$property.Name] = $property.Value
    }

    return $result
}

function ConvertTo-SecureSecret {
    param([Parameter(Mandatory)][AllowNull()][object]$SecretResult)

    if ($null -eq $SecretResult) {
        throw "Get-PASAccountPassword returned no result."
    }

    if ($SecretResult -is [Security.SecureString]) {
        return $SecretResult
    }

    $passwordValue = Get-ObjectPropertyValue -InputObject $SecretResult -Names @("Password", "password", "Content", "content", "Secret", "secret")
    if ($null -eq $passwordValue) {
        $passwordValue = $SecretResult
    }

    if ($passwordValue -is [Security.SecureString]) {
        return $passwordValue
    }

    $passwordText = [string]$passwordValue
    if ([string]::IsNullOrEmpty($passwordText)) {
        throw "Get-PASAccountPassword returned an empty password."
    }

    return ConvertTo-SecureString -String $passwordText -AsPlainText -Force
}

function Test-SourceSafeEligible {
    param([AllowNull()][string]$SafeName)

    if ([string]::IsNullOrWhiteSpace($SafeName)) {
        return $false
    }

    return $SafeName.StartsWith($AllowedSourceSafePrefix, [System.StringComparison]::OrdinalIgnoreCase)
}

function Get-DuplicateKey {
    param(
        [AllowNull()][string]$UserName,
        [AllowNull()][string]$Address
    )

    return (([string]$UserName).Trim().ToLowerInvariant() + "|" + ([string]$Address).Trim().ToLowerInvariant())
}

function Convert-ActivityTime {
    param([AllowNull()][object]$Value)

    if ($null -eq $Value) {
        return $null
    }

    if ($Value -is [datetime]) {
        return [datetime]$Value
    }

    $text = [string]$Value
    if ([string]::IsNullOrWhiteSpace($text)) {
        return $null
    }

    $parsed = [datetime]::MinValue
    if ([datetime]::TryParse($text, [ref]$parsed)) {
        return $parsed
    }

    return $null
}

function Test-DisabledSignatureText {
    param([AllowNull()][string]$Text)

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return $false
    }

    return (($Text -match $script:DisabledWinRcRegex) -and ($Text -match $script:DisabledTextRegex))
}

function Limit-Text {
    param(
        [AllowNull()][string]$Text,
        [int]$MaximumLength = 1000
    )

    if ([string]::IsNullOrEmpty($Text)) {
        return ""
    }

    if ($Text.Length -le $MaximumLength) {
        return $Text
    }

    return $Text.Substring(0, $MaximumLength)
}

function Add-ReportRow {
    param([Parameter(Mandatory)][hashtable]$Values)

    $row = [ordered]@{
        RunId                 = $script:RunId
        ReviewTime            = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        SourceAccountID       = ""
        SourceSafeName        = ""
        SourcePlatformID      = ""
        AccountName           = ""
        UserName              = ""
        Address               = ""
        SourceSafeEligible    = $false
        EvidenceSource        = ""
        EvidenceTime          = ""
        EvidenceText          = ""
        RelationshipMode      = $RelationshipCheckMode
        RelationshipStatus    = "NOT_CHECKED"
        LinkedAccountCount    = 0
        DependentAccountCount = 0
        GroupDetected         = $false
        TargetSafeName        = $TargetSafeName
        TargetPlatformID      = $TargetPlatformID
        TargetAccountID       = ""
        ActionStatus          = ""
        Error                 = ""
    }

    foreach ($key in $Values.Keys) {
        if ($row.Contains($key)) {
            $row[$key] = $Values[$key]
        }
    }

    $script:ReportRows += [pscustomobject]$row
}

function Get-ScriptSHA256 {
    try {
        if (-not [string]::IsNullOrWhiteSpace($PSCommandPath) -and (Test-Path -LiteralPath $PSCommandPath)) {
            return (Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash
        }
    }
    catch {
    }

    return "Unavailable"
}

function Remove-OldOutputFiles {
    try {
        $cutoff = (Get-Date).AddDays(-1 * $LogRetentionDays)
        Get-ChildItem -LiteralPath $ReportFolder -File -ErrorAction SilentlyContinue |
            Where-Object {
                $_.LastWriteTime -lt $cutoff -and
                ($_.Name -like "Disabled1331_Migration_Log_*.log" -or $_.Name -like "Disabled1331_Migration_Report_*.csv")
            } |
            Remove-Item -Force -ErrorAction SilentlyContinue
    }
    catch {
        Write-Warn "Unable to complete old log cleanup: $($_.Exception.Message)"
    }
}

function Enter-SingleInstance {
    $mutexName = "Global\CyberArk_Move_Disabled_IND_Account"
    $createdNew = $false
    $script:Mutex = [System.Threading.Mutex]::new($false, $mutexName, [ref]$createdNew)

    try {
        $script:MutexAcquired = $script:Mutex.WaitOne(0, $false)
    }
    catch [System.Threading.AbandonedMutexException] {
        $script:MutexAcquired = $true
    }

    if (-not $script:MutexAcquired) {
        throw "Another instance of the disabled-account migration script is already running."
    }
}

# ============================================================
# Authentication
# ============================================================

function Get-ServiceUserCredentialFromCCP {
    $base = $CCPAddress.TrimEnd("/")
    $location = $CCPLocation.Trim("/")

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $base,
        $location,
        [uri]::EscapeDataString($CCPAppID),
        [uri]::EscapeDataString($CCPSafe),
        [uri]::EscapeDataString($CCPObject)

    Write-Info "Retrieving Privilege Cloud service credential from CCP."
    Write-Info "CCP endpoint: $url"

    $response = $null
    $securePassword = $null

    try {
        $response = Invoke-RestMethod `
            -Uri $url `
            -Method GET `
            -ContentType "application/json" `
            -UseDefaultCredentials:$CCPWindowsAuth `
            -ErrorAction Stop

        $userName = [string](Get-ObjectPropertyValue -InputObject $response -Names @("UserName", "username"))
        $content = [string](Get-ObjectPropertyValue -InputObject $response -Names @("Content", "content"))

        if ([string]::IsNullOrWhiteSpace($userName) -or [string]::IsNullOrWhiteSpace($content)) {
            throw "CCP response did not contain both UserName and Content."
        }

        Write-Ok "CCP returned service user '$userName'."

        $securePassword = ConvertTo-SecureString -String $content -AsPlainText -Force
        return [System.Management.Automation.PSCredential]::new($userName, $securePassword)
    }
    finally {
        if ($null -ne $response) {
            $contentProperty = $response.PSObject.Properties |
                Where-Object { $_.Name -ieq "Content" } |
                Select-Object -First 1
            if ($null -ne $contentProperty) {
                $contentProperty.Value = $null
            }
        }

        $securePassword = $null
    }
}

function Connect-PrivilegeCloud {
    $serviceCredential = Get-ServiceUserCredentialFromCCP

    try {
        Write-Info "Authenticating to Privilege Cloud through Identity Shared Services."

        New-PASSession `
            -IdentityTenantURL $IdentityTenantURL `
            -PrivilegeCloudURL $PrivilegeCloudURL `
            -Credential $serviceCredential `
            -ServiceUser `
            -ErrorAction Stop | Out-Null

        $script:PASSessionCreated = $true

        $session = Get-PASSession -ErrorAction SilentlyContinue
        $sessionUser = [string](Get-ObjectPropertyValue -InputObject $session -Names @("User", "user", "UserName", "username"))
        if ([string]::IsNullOrWhiteSpace($sessionUser)) {
            $sessionUser = $serviceCredential.UserName
        }

        Write-Ok "Authenticated to Privilege Cloud as '$sessionUser'."
    }
    finally {
        $serviceCredential = $null
    }
}

function Assert-PublicCommands {
    $requiredCommands = @(
        "Get-PASAccount",
        "Get-PASAccountActivity",
        "Get-PASAccountPassword",
        "Add-PASAccount",
        "Remove-PASAccount",
        "Get-PASSafe",
        "Get-PASSession",
        "Close-PASSession"
    )

    $missing = @()
    foreach ($commandName in $requiredCommands) {
        if (-not (Get-Command -Name $commandName -ErrorAction SilentlyContinue)) {
            $missing += $commandName
        }
    }

    if ($missing.Count -gt 0) {
        throw "Required exported psPAS command(s) missing: $($missing -join ', ')."
    }

    Write-Ok "All required exported psPAS commands are available."
}

function Assert-TargetConfiguration {
    $targetSafe = Get-PASSafe -SafeName $TargetSafeName -ErrorAction Stop
    if ($null -eq $targetSafe) {
        throw "Target Safe '$TargetSafeName' was not found."
    }
    Write-Ok "Target Safe '$TargetSafeName' exists."

    $platformCommand = Get-Command -Name Get-PASPlatform -ErrorAction SilentlyContinue
    if ($null -eq $platformCommand) {
        Write-Warn "Get-PASPlatform is not available. Platform existence will be validated by Add-PASAccount during creation."
        return
    }

    try {
        $targetPlatform = Get-PASPlatform -PlatformID $TargetPlatformID -ErrorAction Stop
        if ($null -eq $targetPlatform) {
            Write-Warn "Target platform '$TargetPlatformID' was not returned. Add-PASAccount will perform the authoritative validation."
        }
        else {
            Write-Ok "Target platform '$TargetPlatformID' exists."
        }
    }
    catch {
        Write-Warn "Unable to pre-validate target platform '$TargetPlatformID': $($_.Exception.Message). Add-PASAccount will perform the authoritative validation."
    }
}

# ============================================================
# Candidate discovery
# ============================================================

function Add-CandidateToMap {
    param(
        [Parameter(Mandatory)][hashtable]$Map,
        [Parameter(Mandatory)][object]$Account,
        [Parameter(Mandatory)][string]$DiscoverySource
    )

    $accountID = Get-AccountID -Account $Account
    if ([string]::IsNullOrWhiteSpace($accountID)) {
        return
    }

    $safeName = Get-AccountSafeName -Account $Account
    if (-not [string]::IsNullOrWhiteSpace($safeName) -and $safeName -ieq $TargetSafeName) {
        return
    }

    $key = $accountID.Trim().ToLowerInvariant()
    if (-not $Map.ContainsKey($key)) {
        $Map[$key] = [pscustomobject][ordered]@{
            Account         = $Account
            DiscoverySource = $DiscoverySource
        }
    }
}

function Get-AccountsBySafe {
    param([Parameter(Mandatory)][string]$SafeName)

    return @(
        Get-PASAccount `
            -SafeName $SafeName `
            -limit 1000 `
            -ErrorAction Stop
    )
}

function Get-CandidateAccounts {
    $candidateMap = @{}

    if ($SourceSafeName.Count -gt 0) {
        foreach ($safe in $SourceSafeName) {
            if ([string]::IsNullOrWhiteSpace($safe)) {
                continue
            }

            Write-Info "Retrieving accounts from source Safe '$safe'."
            $accounts = Get-AccountsBySafe -SafeName $safe
            foreach ($account in $accounts) {
                Add-CandidateToMap -Map $candidateMap -Account $account -DiscoverySource ("Safe:{0}" -f $safe)
            }
        }
    }
    elseif ($FullScan) {
        Write-Warn "FullScan was requested. Retrieving all accessible accounts."
        $accounts = @(Get-PASAccount -limit 1000 -ErrorAction Stop)
        foreach ($account in $accounts) {
            Add-CandidateToMap -Map $candidateMap -Account $account -DiscoverySource "FullScan"
        }
    }
    else {
        Write-Info "Fast discovery enabled. Querying CyberArk failure saved filters."

        $successfulFilterCount = 0
        foreach ($savedFilter in $script:FastSavedFilters) {
            try {
                $accounts = @(
                    Get-PASAccount `
                        -savedFilter $savedFilter `
                        -limit 1000 `
                        -ErrorAction Stop
                )

                $successfulFilterCount++
                Write-Info "Saved filter '$savedFilter' returned $($accounts.Count) account(s)."

                foreach ($account in $accounts) {
                    Add-CandidateToMap -Map $candidateMap -Account $account -DiscoverySource ("SavedFilter:{0}" -f $savedFilter)
                }
            }
            catch {
                Write-Warn "Saved filter '$savedFilter' failed: $($_.Exception.Message)"
            }
        }

        if ($successfulFilterCount -eq 0 -or $candidateMap.Count -eq 0) {
            Write-Warn "Fast saved-filter discovery produced no usable candidates. Falling back to all accessible accounts."
            $accounts = @(Get-PASAccount -limit 1000 -ErrorAction Stop)
            foreach ($account in $accounts) {
                Add-CandidateToMap -Map $candidateMap -Account $account -DiscoverySource "AutomaticFullScanFallback"
            }
        }
    }

    $candidates = @()
    foreach ($entry in $candidateMap.Values) {
        $candidates += $entry
    }

    $candidates = @(
        $candidates |
            Sort-Object {
                Get-AccountSafeName -Account $_.Account
            }, {
                Get-AccountUserName -Account $_.Account
            }
    )

    if ($MaxAccounts -gt 0 -and $candidates.Count -gt $MaxAccounts) {
        Write-Warn "MaxAccounts limits processing from $($candidates.Count) to $MaxAccounts candidate(s)."
        $candidates = @($candidates | Select-Object -First $MaxAccounts)
    }

    return $candidates
}

function Find-DisabledEvidence {
    param(
        [Parameter(Mandatory)][object]$AccountSummary,
        [Parameter(Mandatory)][string]$AccountID
    )

    $cutoff = $null
    if ($LookbackDays -gt 0) {
        $cutoff = (Get-Date).AddDays(-1 * $LookbackDays)
    }

    $manualReason = Get-ManualManagementReason -Account $AccountSummary
    if (Test-DisabledSignatureText -Text $manualReason) {
        return [pscustomobject][ordered]@{
            Matched = $true
            Source  = "ManualManagementReason"
            Time    = ""
            Text    = $manualReason
        }
    }

    $activities = @(
        Get-PASAccountActivity `
            -AccountID $AccountID `
            -ErrorAction Stop
    )

    foreach ($activity in $activities) {
        $activityTimeRaw = Get-ObjectPropertyValue -InputObject $activity -Names @("Time", "time", "Date", "date")
        $activityTime = Convert-ActivityTime -Value $activityTimeRaw

        if ($null -ne $cutoff -and $null -ne $activityTime -and $activityTime -lt $cutoff) {
            continue
        }

        $parts = @(
            [string](Get-ObjectPropertyValue -InputObject $activity -Names @("Activity", "activity")),
            [string](Get-ObjectPropertyValue -InputObject $activity -Names @("Reason", "reason")),
            [string](Get-ObjectPropertyValue -InputObject $activity -Names @("MoreInfo", "moreInfo")),
            [string](Get-ObjectPropertyValue -InputObject $activity -Names @("Description", "description"))
        )

        $combined = ($parts | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }) -join " | "
        if (Test-DisabledSignatureText -Text $combined) {
            $activityTimeText = [string]$activityTimeRaw
            if ($null -ne $activityTime) {
                $activityTimeText = $activityTime.ToString("yyyy-MM-dd HH:mm:ss")
            }

            return [pscustomobject][ordered]@{
                Matched = $true
                Source  = "AccountActivity"
                Time    = $activityTimeText
                Text    = $combined
            }
        }
    }

    return [pscustomobject][ordered]@{
        Matched = $false
        Source  = ""
        Time    = ""
        Text    = ""
    }
}

# ============================================================
# Optional public-cmdlet-only relationship checking
# ============================================================

function Test-AccountRelationships {
    param(
        [Parameter(Mandatory)][object]$AccountDetails,
        [Parameter(Mandatory)][string]$AccountID
    )

    $result = [ordered]@{
        Allowed        = $true
        Status         = "NOT_CHECKED"
        Error          = ""
        LinkedCount    = 0
        DependentCount = 0
        GroupDetected  = $false
    }

    if ($RelationshipCheckMode -eq "Disabled") {
        return [pscustomobject]$result
    }

    $groupValue = Get-ObjectPropertyValue -InputObject $AccountDetails -Names @(
        "groupName", "GroupName", "groupID", "GroupID", "accountGroup", "AccountGroup"
    )
    if ($null -ne $groupValue -and -not [string]::IsNullOrWhiteSpace([string]$groupValue)) {
        $result.GroupDetected = $true
    }

    $checkErrors = @()

    $linkedCommand = Get-Command -Name Get-PASLinkedAccount -ErrorAction SilentlyContinue
    if ($null -ne $linkedCommand) {
        try {
            $linkedAccounts = @(Get-PASLinkedAccount -id $AccountID -ErrorAction Stop)
            $result.LinkedCount = @($linkedAccounts | Where-Object { $null -ne $_ }).Count
        }
        catch {
            $checkErrors += "Linked-account check: $($_.Exception.Message)"
        }
    }
    else {
        $checkErrors += "Get-PASLinkedAccount is not available in the installed psPAS module."
    }

    $dependentCommand = Get-Command -Name Get-PASDependentAccount -ErrorAction SilentlyContinue
    if ($null -ne $dependentCommand) {
        try {
            $dependentAccounts = @(Get-PASDependentAccount -id $AccountID -ErrorAction Stop)
            $result.DependentCount = @($dependentAccounts | Where-Object { $null -ne $_ }).Count
        }
        catch {
            $checkErrors += "Dependent-account check: $($_.Exception.Message)"
        }
    }
    else {
        $checkErrors += "Get-PASDependentAccount is not available in the installed psPAS module."
    }

    if ($result.LinkedCount -gt 0 -or $result.DependentCount -gt 0 -or $result.GroupDetected) {
        $result.Allowed = $false
        $result.Status = "RELATIONSHIP_DETECTED"
        $result.Error = "Linked=$($result.LinkedCount); Dependent=$($result.DependentCount); Group=$($result.GroupDetected)."
        return [pscustomobject]$result
    }

    if ($checkErrors.Count -gt 0) {
        $result.Error = $checkErrors -join " | "

        if ($RelationshipCheckMode -eq "Strict") {
            $result.Allowed = $false
            $result.Status = "RELATIONSHIP_CHECK_FAILED"
        }
        else {
            $result.Allowed = $true
            $result.Status = "CHECK_ERROR_CONTINUED"
        }

        return [pscustomobject]$result
    }

    $result.Status = "NO_RELATIONSHIPS_FOUND"
    return [pscustomobject]$result
}

# ============================================================
# Target indexing, validation and migration
# ============================================================

function Initialize-TargetIndex {
    Write-Info "Loading target Safe accounts once for duplicate and recovery checks."

    $script:TargetIndex = @{}
    $targetAccounts = Get-AccountsBySafe -SafeName $TargetSafeName

    foreach ($targetAccount in $targetAccounts) {
        $key = Get-DuplicateKey `
            -UserName (Get-AccountUserName -Account $targetAccount) `
            -Address (Get-AccountAddress -Account $targetAccount)

        if (-not $script:TargetIndex.ContainsKey($key)) {
            $script:TargetIndex[$key] = $targetAccount
        }
    }

    Write-Ok "Loaded $($targetAccounts.Count) account(s) from target Safe '$TargetSafeName'."
}

function Test-TargetAccount {
    param(
        [Parameter(Mandatory)][object]$TargetAccount,
        [Parameter(Mandatory)][string]$ExpectedUserName,
        [Parameter(Mandatory)][string]$ExpectedAddress
    )

    $actualSafe = Get-AccountSafeName -Account $TargetAccount
    $actualPlatform = Get-AccountPlatformID -Account $TargetAccount
    $actualUserName = Get-AccountUserName -Account $TargetAccount
    $actualAddress = Get-AccountAddress -Account $TargetAccount
    $actualID = Get-AccountID -Account $TargetAccount

    $errors = @()

    if ([string]::IsNullOrWhiteSpace($actualID)) {
        $errors += "Target AccountID is missing."
    }
    if ($actualSafe -ine $TargetSafeName) {
        $errors += "Safe='$actualSafe' instead of '$TargetSafeName'."
    }
    if ($actualPlatform -ine $TargetPlatformID) {
        $errors += "Platform='$actualPlatform' instead of '$TargetPlatformID'."
    }
    if ($actualUserName -ine $ExpectedUserName) {
        $errors += "UserName='$actualUserName' instead of '$ExpectedUserName'."
    }
    if ($actualAddress -ine $ExpectedAddress) {
        $errors += "Address='$actualAddress' instead of '$ExpectedAddress'."
    }

    return [pscustomobject][ordered]@{
        Valid     = ($errors.Count -eq 0)
        AccountID = $actualID
        Error     = $errors -join " "
    }
}

function Find-TargetAccountAfterCreation {
    param(
        [Parameter(Mandatory)][string]$UserName,
        [Parameter(Mandatory)][string]$Address
    )

    $matches = @(
        Get-PASAccount `
            -SafeName $TargetSafeName `
            -search $UserName `
            -searchType contains `
            -limit 1000 `
            -ErrorAction Stop |
        Where-Object {
            (Get-AccountUserName -Account $_) -ieq $UserName -and
            (Get-AccountAddress -Account $_) -ieq $Address
        }
    )

    if ($matches.Count -eq 1) {
        return $matches[0]
    }

    if ($matches.Count -gt 1) {
        $platformMatches = @($matches | Where-Object { (Get-AccountPlatformID -Account $_) -ieq $TargetPlatformID })
        if ($platformMatches.Count -eq 1) {
            return $platformMatches[0]
        }
    }

    return $null
}

function New-RetirementAccount {
    param(
        [Parameter(Mandatory)][object]$SourceAccount,
        [Parameter(Mandatory)][Security.SecureString]$Secret
    )

    $sourceName = Get-AccountName -Account $SourceAccount
    $sourceAddress = Get-AccountAddress -Account $SourceAccount
    $sourceUserName = Get-AccountUserName -Account $SourceAccount

    $parameters = @{
        address                    = $sourceAddress
        userName                   = $sourceUserName
        platformID                 = $TargetPlatformID
        SafeName                   = $TargetSafeName
        secretType                 = "Password"
        secret                     = $Secret
        automaticManagementEnabled = $false
        manualManagementReason     = "Moved after confirmed disabled-user failure winRc=1331. Source account retired by automation."
        ErrorAction                = "Stop"
    }

    if (-not [string]::IsNullOrWhiteSpace($sourceName)) {
        $parameters["name"] = $sourceName
    }

    if ($PreservePlatformAccountProperties) {
        $properties = ConvertTo-Hashtable -InputObject (Get-PlatformAccountProperties -Account $SourceAccount)
        if ($null -ne $properties -and $properties.Count -gt 0) {
            $parameters["platformAccountProperties"] = $properties
        }
    }

    return Add-PASAccount @parameters
}

function Remove-SourceAccount {
    param([Parameter(Mandatory)][string]$SourceAccountID)

    Remove-PASAccount `
        -AccountID $SourceAccountID `
        -Confirm:$false `
        -ErrorAction Stop
}

function Process-MatchedAccount {
    param(
        [Parameter(Mandatory)][object]$AccountSummary,
        [Parameter(Mandatory)][object]$Evidence,
        [Parameter(Mandatory)][string]$DiscoverySource
    )

    $sourceID = Get-AccountID -Account $AccountSummary
    $sourceSafe = Get-AccountSafeName -Account $AccountSummary
    $sourcePlatform = Get-AccountPlatformID -Account $AccountSummary
    $sourceName = Get-AccountName -Account $AccountSummary
    $sourceUserName = Get-AccountUserName -Account $AccountSummary
    $sourceAddress = Get-AccountAddress -Account $AccountSummary
    $safeEligible = Test-SourceSafeEligible -SafeName $sourceSafe

    $reportValues = @{
        SourceAccountID    = $sourceID
        SourceSafeName     = $sourceSafe
        SourcePlatformID   = $sourcePlatform
        AccountName        = $sourceName
        UserName           = $sourceUserName
        Address            = $sourceAddress
        SourceSafeEligible = $safeEligible
        EvidenceSource     = ("{0}; {1}" -f $Evidence.Source, $DiscoverySource)
        EvidenceTime       = $Evidence.Time
        EvidenceText       = Limit-Text -Text $Evidence.Text -MaximumLength 1000
    }

    if (-not $safeEligible) {
        $reportValues["ActionStatus"] = "SKIPPED_SOURCE_SAFE_PREFIX_NOT_ALLOWED"
        $reportValues["Error"] = "Source Safe does not begin with '$AllowedSourceSafePrefix'."
        Add-ReportRow -Values $reportValues
        return
    }

    if ([string]::IsNullOrWhiteSpace($sourceID) -or
        [string]::IsNullOrWhiteSpace($sourceUserName) -or
        [string]::IsNullOrWhiteSpace($sourceAddress)) {
        $reportValues["ActionStatus"] = "FAILED_MISSING_REQUIRED_SOURCE_FIELD"
        $reportValues["Error"] = "Source AccountID, UserName, or Address is missing."
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        return
    }

    $sourceDetails = $null
    try {
        $sourceDetails = Get-PASAccount -id $sourceID -ErrorAction Stop
    }
    catch {
        $reportValues["ActionStatus"] = "FAILED_SOURCE_DETAIL_RETRIEVAL"
        $reportValues["Error"] = $_.Exception.Message
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        return
    }

    $secretType = Get-AccountSecretType -Account $sourceDetails
    if ($secretType -ine "Password") {
        $reportValues["ActionStatus"] = "SKIPPED_UNSUPPORTED_SECRET_TYPE"
        $reportValues["Error"] = "Secret type '$secretType' is not supported by this retirement workflow."
        Add-ReportRow -Values $reportValues
        return
    }

    $relationship = Test-AccountRelationships -AccountDetails $sourceDetails -AccountID $sourceID
    $reportValues["RelationshipStatus"] = $relationship.Status
    $reportValues["LinkedAccountCount"] = $relationship.LinkedCount
    $reportValues["DependentAccountCount"] = $relationship.DependentCount
    $reportValues["GroupDetected"] = $relationship.GroupDetected

    if (-not $relationship.Allowed) {
        $reportValues["ActionStatus"] = $relationship.Status
        $reportValues["Error"] = $relationship.Error
        Add-ReportRow -Values $reportValues
        if ($relationship.Status -eq "RELATIONSHIP_CHECK_FAILED") {
            $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        }
        return
    }

    if ($relationship.Status -eq "CHECK_ERROR_CONTINUED") {
        Write-Warn "AccountID '$sourceID' relationship check had an error but BestEffort mode allows processing: $($relationship.Error)"
    }

    $duplicateKey = Get-DuplicateKey -UserName $sourceUserName -Address $sourceAddress
    $existingTarget = $null
    if ($script:TargetIndex.ContainsKey($duplicateKey)) {
        $existingTarget = $script:TargetIndex[$duplicateKey]
    }

    if ($null -ne $existingTarget) {
        $existingValidation = Test-TargetAccount `
            -TargetAccount $existingTarget `
            -ExpectedUserName $sourceUserName `
            -ExpectedAddress $sourceAddress

        $reportValues["TargetAccountID"] = $existingValidation.AccountID

        if (-not $existingValidation.Valid) {
            $reportValues["ActionStatus"] = "SKIPPED_TARGET_DUPLICATE_INVALID"
            $reportValues["Error"] = $existingValidation.Error
            Add-ReportRow -Values $reportValues
            return
        }

        if (-not $Execute) {
            $reportValues["ActionStatus"] = "PREVIEW_TARGET_ALREADY_EXISTS"
            $reportValues["Error"] = "A valid target account already exists. Execute mode can finalize deletion of the source when FinalizeExistingTarget is enabled."
            Add-ReportRow -Values $reportValues
            return
        }

        if (-not $FinalizeExistingTarget) {
            $reportValues["ActionStatus"] = "SKIPPED_TARGET_ALREADY_EXISTS"
            $reportValues["Error"] = "Valid target exists, but FinalizeExistingTarget is disabled."
            Add-ReportRow -Values $reportValues
            return
        }

        try {
            Remove-SourceAccount -SourceAccountID $sourceID
            $reportValues["ActionStatus"] = "TARGET_ALREADY_EXISTS_SOURCE_DELETED"
            Add-ReportRow -Values $reportValues
            Write-Ok "Finalized prior migration for AccountID '$sourceID'; valid target '$($existingValidation.AccountID)' already existed."
        }
        catch {
            $reportValues["ActionStatus"] = "FAILED_DELETE_SOURCE_WITH_EXISTING_TARGET"
            $reportValues["Error"] = $_.Exception.Message
            Add-ReportRow -Values $reportValues
            $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        }

        return
    }

    if (-not $Execute) {
        $reportValues["ActionStatus"] = "PREVIEW_ELIGIBLE"
        Add-ReportRow -Values $reportValues
        return
    }

    $secretResult = $null
    $secureSecret = $null
    $createdAccount = $null
    $targetDetails = $null

    try {
        Write-Info "Retrieving source secret for AccountID '$sourceID'."
        $secretResult = Get-PASAccountPassword `
            -AccountID $sourceID `
            -Reason $PasswordRetrievalReason `
            -ActionType show `
            -ErrorAction Stop

        $secureSecret = ConvertTo-SecureSecret -SecretResult $secretResult
    }
    catch {
        $reportValues["ActionStatus"] = "FAILED_SECRET_RETRIEVAL"
        $reportValues["Error"] = $_.Exception.Message
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        return
    }

    try {
        Write-Info "Creating replacement for AccountID '$sourceID' in Safe '$TargetSafeName' on platform '$TargetPlatformID'."
        $createdAccount = New-RetirementAccount -SourceAccount $sourceDetails -Secret $secureSecret
    }
    catch {
        $reportValues["ActionStatus"] = "FAILED_TARGET_CREATE"
        $reportValues["Error"] = $_.Exception.Message
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        return
    }
    finally {
        $secretResult = $null
        $secureSecret = $null
    }

    $targetID = Get-AccountID -Account $createdAccount

    try {
        if (-not [string]::IsNullOrWhiteSpace($targetID)) {
            $targetDetails = Get-PASAccount -id $targetID -ErrorAction Stop
        }
        else {
            $targetDetails = Find-TargetAccountAfterCreation -UserName $sourceUserName -Address $sourceAddress
            $targetID = Get-AccountID -Account $targetDetails
        }

        if ($null -eq $targetDetails -or [string]::IsNullOrWhiteSpace($targetID)) {
            throw "Target account was created but its AccountID could not be resolved."
        }

        $targetValidation = Test-TargetAccount `
            -TargetAccount $targetDetails `
            -ExpectedUserName $sourceUserName `
            -ExpectedAddress $sourceAddress

        if (-not $targetValidation.Valid) {
            throw $targetValidation.Error
        }

        $reportValues["TargetAccountID"] = $targetValidation.AccountID
    }
    catch {
        $reportValues["ActionStatus"] = "TARGET_CREATED_VALIDATION_FAILED"
        $reportValues["Error"] = $_.Exception.Message
        $reportValues["TargetAccountID"] = $targetID
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        Write-Err "Target was created for source AccountID '$sourceID', but validation failed. Source was not deleted."
        return
    }

    try {
        Write-Info "Deleting source AccountID '$sourceID' after successful target validation."
        Remove-SourceAccount -SourceAccountID $sourceID

        $reportValues["ActionStatus"] = "MOVED_SUCCESSFULLY"
        Add-ReportRow -Values $reportValues

        $script:TargetIndex[$duplicateKey] = $targetDetails
        Write-Ok "Moved AccountID '$sourceID' to target AccountID '$targetID'."
    }
    catch {
        $reportValues["ActionStatus"] = "TARGET_CREATED_SOURCE_DELETE_FAILED"
        $reportValues["Error"] = $_.Exception.Message
        Add-ReportRow -Values $reportValues
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
        Write-Err "Target AccountID '$targetID' was created and validated, but source AccountID '$sourceID' could not be deleted."
    }
}

# ============================================================
# Main execution
# ============================================================

Initialize-OutputFiles

try {
    Enter-SingleInstance
    Remove-OldOutputFiles

    Write-Info "============================================================"
    Write-Info "Disabled account retirement review starting."
    Write-Info "Script version       : $script:ScriptVersion"
    Write-Info "Script path          : $PSCommandPath"
    Write-Info "Script SHA256        : $(Get-ScriptSHA256)"
    Write-Info "Execution mode       : $(if ($Execute) { 'EXECUTE' } else { 'REPORT ONLY' })"
    Write-Info "Scheduled task mode  : $($ScheduledTaskMode.IsPresent)"
    Write-Info "Target Safe          : $TargetSafeName"
    Write-Info "Target Platform      : $TargetPlatformID"
    Write-Info "Allowed Safe prefix  : $AllowedSourceSafePrefix"
    Write-Info "Relationship mode    : $RelationshipCheckMode"
    Write-Info "Lookback Days        : $LookbackDays"
    Write-Info "Discovery mode       : $(if ($FullScan) { 'FULL SCAN' } elseif ($SourceSafeName.Count -gt 0) { 'SOURCE SAFE LIST' } else { 'FAST SAVED FILTERS' })"
    Write-Info "============================================================"

    Import-Module psPAS -ErrorAction Stop
    $module = Get-Module psPAS | Sort-Object Version -Descending | Select-Object -First 1
    Write-Ok "Loaded psPAS version '$($module.Version)'."

    Assert-PublicCommands
    Connect-PrivilegeCloud
    Assert-TargetConfiguration
    Initialize-TargetIndex

    $candidates = @(Get-CandidateAccounts)
    Write-Ok "Retrieved $($candidates.Count) unique candidate account(s)."

    $reviewed = 0
    $signatureMatches = 0

    foreach ($candidate in $candidates) {
        $reviewed++
        $summary = $candidate.Account
        $accountID = Get-AccountID -Account $summary

        if ([string]::IsNullOrWhiteSpace($accountID)) {
            continue
        }

        try {
            $evidence = Find-DisabledEvidence -AccountSummary $summary -AccountID $accountID
        }
        catch {
            Write-Warn "Unable to review activity for AccountID '$accountID': $($_.Exception.Message)"
            $script:ExitCode = [Math]::Max($script:ExitCode, 2)
            continue
        }

        if ($evidence.Matched) {
            $signatureMatches++
            Write-Warn "Confirmed disabled-account signature winRc=1331 for AccountID '$accountID' in Safe '$(Get-AccountSafeName -Account $summary)'."
            Process-MatchedAccount `
                -AccountSummary $summary `
                -Evidence $evidence `
                -DiscoverySource $candidate.DiscoverySource
        }

        if (($reviewed % $ProgressInterval) -eq 0 -or $reviewed -eq $candidates.Count) {
            Write-Info "Progress: reviewed $reviewed of $($candidates.Count) candidate account(s)."
        }
    }

    if ($script:ReportRows.Count -gt 0) {
        $script:ReportRows | Export-Csv -LiteralPath $script:ReportPath -NoTypeInformation -Encoding UTF8
    }
    else {
        @([pscustomobject][ordered]@{
            RunId = $script:RunId
            ReviewTime = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            ActionStatus = "NO_DISABLED_SIGNATURE_MATCHES"
        }) | Export-Csv -LiteralPath $script:ReportPath -NoTypeInformation -Encoding UTF8
    }

    $movedCount = @($script:ReportRows | Where-Object { $_.ActionStatus -in @("MOVED_SUCCESSFULLY", "TARGET_ALREADY_EXISTS_SOURCE_DELETED") }).Count
    $previewCount = @($script:ReportRows | Where-Object { $_.ActionStatus -like "PREVIEW_*" }).Count
    $outOfScopeCount = @($script:ReportRows | Where-Object { $_.ActionStatus -eq "SKIPPED_SOURCE_SAFE_PREFIX_NOT_ALLOWED" }).Count
    $failedCount = @($script:ReportRows | Where-Object { $_.ActionStatus -like "FAILED_*" -or $_.ActionStatus -like "TARGET_CREATED_*FAILED" }).Count
    $skippedCount = @($script:ReportRows | Where-Object { $_.ActionStatus -like "SKIPPED_*" -or $_.ActionStatus -eq "RELATIONSHIP_DETECTED" -or $_.ActionStatus -eq "RELATIONSHIP_CHECK_FAILED" }).Count

    if ($failedCount -gt 0) {
        $script:ExitCode = [Math]::Max($script:ExitCode, 2)
    }

    $summaryObject = [ordered]@{
        ScriptVersion     = $script:ScriptVersion
        RunId             = $script:RunId
        Started           = $script:RunStart.ToString("o")
        Completed         = (Get-Date).ToString("o")
        Execute           = $Execute.IsPresent
        RelationshipMode  = $RelationshipCheckMode
        CandidatesReviewed = $reviewed
        SignatureMatches  = $signatureMatches
        Moved             = $movedCount
        PreviewEligible   = $previewCount
        Skipped           = $skippedCount
        OutOfScopeSafes   = $outOfScopeCount
        Failed            = $failedCount
        ExitCode          = $script:ExitCode
        ReportPath        = $script:ReportPath
        LogPath           = $script:LogPath
    }

    $summaryObject | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $script:SummaryPath -Encoding UTF8

    Write-Info "============================================================"
    Write-Ok "Review completed."
    Write-Ok "Candidates reviewed : $reviewed"
    Write-Ok "Signature matches   : $signatureMatches"
    Write-Ok "Moved               : $movedCount"
    Write-Info "Preview eligible    : $previewCount"
    Write-Warn "Skipped             : $skippedCount"
    Write-Info "Out-of-scope Safes  : $outOfScopeCount"
    if ($failedCount -gt 0) {
        Write-Err "Failed/partial      : $failedCount"
    }
    else {
        Write-Ok "Failed/partial      : 0"
    }
    Write-Ok "Report              : $script:ReportPath"
    Write-Ok "Log                 : $script:LogPath"
    Write-Info "Process exit code   : $script:ExitCode"
}
catch {
    $script:ExitCode = 1
    Write-Err "Fatal error: $($_.Exception.Message)"

    try {
        $fatalSummary = [ordered]@{
            ScriptVersion = $script:ScriptVersion
            RunId         = $script:RunId
            Started       = $script:RunStart.ToString("o")
            Completed     = (Get-Date).ToString("o")
            ExitCode      = 1
            FatalError    = $_.Exception.Message
            ReportPath    = $script:ReportPath
            LogPath       = $script:LogPath
        }
        $fatalSummary | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $script:SummaryPath -Encoding UTF8
    }
    catch {
    }
}
finally {
    if ($script:PASSessionCreated) {
        try {
            Close-PASSession -ErrorAction Stop
            Write-Ok "Logged off from Privilege Cloud."
        }
        catch {
            Write-Warn "Privilege Cloud logoff failed: $($_.Exception.Message)"
        }
    }

    if ($script:MutexAcquired -and $null -ne $script:Mutex) {
        try {
            $script:Mutex.ReleaseMutex()
        }
        catch {
        }
    }

    if ($null -ne $script:Mutex) {
        $script:Mutex.Dispose()
    }
}

if ($ScheduledTaskMode) {
    exit $script:ExitCode
}

$global:LASTEXITCODE = $script:ExitCode

[pscustomobject][ordered]@{
    ScriptVersion = $script:ScriptVersion
    ExitCode      = $script:ExitCode
    ReportPath    = $script:ReportPath
    LogPath       = $script:LogPath
}
