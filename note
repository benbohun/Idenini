<#
.SYNOPSIS
  Prompt-driven installer: imports a PFX into the local Windows cert store (no ACL changes).

.DESCRIPTION
  - Prompts for PFX path and passphrase.
  - Imports into Cert:\LocalMachine\My (or CurrentUser\My).
  - Idempotent: skips if same thumbprint already exists (unless -Force).
  - Optional FriendlyName & delete-after-import.
  - Logs to C:\ProgramData\CertDeploy\logs\

#>

[CmdletBinding(SupportsShouldProcess=$true)]
param(
  [ValidateSet('LocalMachine','CurrentUser')]
  [string]$StoreLocation = 'LocalMachine',

  [string]$StoreName = 'My',

  [string]$FriendlyName,

  [switch]$Exportable,   # default: not exportable
  [switch]$DeletePfx,
  [switch]$Force
)

# ----------------------------
# Prompt for inputs
# ----------------------------
function Prompt-ForPfxPath {
  for ($i=1; $i -le 5; $i++) {
    $path = Read-Host "Enter full path to the .pfx file (e.g., C:\Certs\site.pfx or \\server\share\site.pfx)"
    if ([string]::IsNullOrWhiteSpace($path)) { Write-Host "Path cannot be empty." -ForegroundColor Yellow; continue }
    try {
      $resolved = (Resolve-Path $path -ErrorAction Stop).Path
      if (Test-Path $resolved) { return $resolved }
    } catch { }
    Write-Host "File not found. Please try again." -ForegroundColor Yellow
  }
  throw "PFX path was not provided or not found after multiple attempts."
}

function Prompt-ForPfxPassphrase {
  $sec = Read-Host "Enter PFX passphrase" -AsSecureString
  if (-not $sec) { throw "Passphrase was not provided." }
  return $sec
}

$pfxPath = Prompt-ForPfxPath
$pfxPassword = Prompt-ForPfxPassphrase

# ----------------------------
# Logging
# ----------------------------
$logRoot = 'C:\ProgramData\CertDeploy\logs'
New-Item -ItemType Directory -Path $logRoot -Force | Out-Null
$Global:LogFile = Join-Path $logRoot ("Install-Pfx_{0}.log" -f (Get-Date -Format 'yyyyMMdd_HHmmss'))

function Write-Log {
  param([string]$Message, [ValidateSet('INFO','WARN','ERROR')] [string]$Level='INFO')
  $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
  $line = "$ts | $Level | $Message"
  Write-Host $line
  Add-Content -Path $Global:LogFile -Value $line
}

Write-Log "Starting PFX install"
Write-Log "PfxPath=$pfxPath | Store=$StoreLocation\$StoreName | Exportable=$($Exportable.IsPresent) | DeletePfx=$($DeletePfx.IsPresent)"

# Resolve store path
$storePath = "Cert:\{0}\{1}" -f $StoreLocation, $StoreName

# ----------------------------
# Inspect PFX to get thumbprint (for idempotence)
# ----------------------------
try {
  $pfxBytes = [System.IO.File]::ReadAllBytes($pfxPath)
  $tmpCert  = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2
  $flags = [System.Security.Cryptography.X509Certificates.X509KeyStorageFlags]::PersistKeySet
  if ($StoreLocation -eq 'LocalMachine') { $flags = $flags -bor [System.Security.Cryptography.X509Certificates.X509KeyStorageFlags]::MachineKeySet }
  if ($Exportable) { $flags = $flags -bor [System.Security.Cryptography.X509Certificates.X509KeyStorageFlags]::Exportable }
  $tmpCert.Import($pfxBytes, $pfxPassword, $flags)
  $incomingThumb = $tmpCert.Thumbprint.ToUpperInvariant()
  Write-Log "Incoming PFX Subject: $($tmpCert.Subject) | Thumbprint: $incomingThumb"
} catch {
  Write-Log "Unable to read/import PFX for inspection: $($_.Exception.Message)" "ERROR"
  throw
}

# ----------------------------
# Skip if already present (unless -Force)
# ----------------------------
$current = Get-ChildItem -Path $storePath -ErrorAction SilentlyContinue | Where-Object { $_.Thumbprint -eq $incomingThumb }
if ($current -and -not $Force) {
  Write-Log "Certificate already present in $storePath (Thumbprint=$incomingThumb). Skipping import."
  if ($FriendlyName -and $current.FriendlyName -ne $FriendlyName) {
    try { $current.FriendlyName = $FriendlyName; Write-Log "Updated FriendlyName to '$FriendlyName'." }
    catch { Write-Log "Failed to set FriendlyName: $($_.Exception.Message)" "WARN" }
  }
  if ($DeletePfx) {
    try { Remove-Item -Path $pfxPath -Force; Write-Log "Deleted PFX at $pfxPath" }
    catch { Write-Log "Failed to delete PFX: $($_.Exception.Message)" "WARN" }
  }
  Write-Log "Done."
  return
}

# ----------------------------
# Import the PFX
# ----------------------------
try {
  $importParams = @{
    FilePath          = $pfxPath
    CertStoreLocation = $storePath
    Password          = $pfxPassword
  }
  if ($Exportable) { $importParams['Exportable'] = $true }

  if ($PSCmdlet.ShouldProcess("$storePath","Import PFX $pfxPath")) {
    $imported = Import-PfxCertificate @importParams
    if (-not $imported) { throw "Import-PfxCertificate returned no object." }
    Write-Log "Imported certificate to $storePath : Thumbprint=$($imported.Thumbprint)"
  }
} catch {
  Write-Log "PFX import failed: $($_.Exception.Message)" "ERROR"
  throw
}

# Refresh handle to new cert
$cert = Get-ChildItem -Path $storePath | Where-Object { $_.Thumbprint -eq $incomingThumb } | Select-Object -First 1

# Set Friendly Name (optional)
if ($FriendlyName) {
  try { $cert.FriendlyName = $FriendlyName; Write-Log "Set FriendlyName='$FriendlyName'" }
  catch { Write-Log "Failed to set FriendlyName: $($_.Exception.Message)" "WARN" }
}

# Delete PFX after successful import (optional)
if ($DeletePfx) {
  try { Remove-Item -Path $pfxPath -Force; Write-Log "Deleted PFX at $pfxPath" }
  catch { Write-Log "Failed to delete PFX: $($_.Exception.Message)" "WARN" }
}

Write-Log "Completed successfully."
