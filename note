<#
.SYNOPSIS
    CyberArk SWS token-generation-only diagnostic.

.DESCRIPTION
    This script ONLY tests whether the CyberArk public API auth helper JAR can generate
    an SWS API access_token from an SWS service-account JSON file.

    It does NOT create Identity apps.
    It does NOT update Identity apps.
    It does NOT copy SWS policies.

    It will:
      1. Resolve java.exe
      2. Resolve public-api-auth-helper*.jar
      3. Resolve/select an SWS service-account JSON
      4. Run the CyberArk helper JAR with tenant ID candidates
      5. Confirm whether access_token was returned
      6. Mask token by default
      7. Optionally save/show token only if explicitly requested
      8. Optionally validate token against GET /sws/policies

.NOTES
    Default values are based on the environment/path shared in the current troubleshooting session.
#>

[CmdletBinding()]
param(
    [string]$SwsTenantId = 'eef31a0b-0e67-4024-a644-be08614190db',

    [string]$SwsJavaPath = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\jdk-25.0.3+9\bin\java.exe',

    [string]$SwsAuthHelperJarPath = '',

    [string]$SwsServiceAccountJsonPath = '',

    [string]$SwsApiBaseUrl = 'https://api.alero.io/v2-edge',

    [string]$LogPath = '',

    # By default, if multiple SWS JSON files are found, prompt to select the correct one.
    [switch]$AutoSelectNewestJson,

    # By default, the token is masked. Use only for local troubleshooting if you need to copy it.
    [switch]$ShowToken,

    # Saves raw token to .\sws_access_token.txt. Use carefully; delete after testing.
    [switch]$SaveTokenToFile,

    # Optional: after token generation, call GET /sws/policies to prove token works against SWS API.
    [switch]$ValidateAgainstSwsApi,

    # Optional proxy for the SWS API validation request. The helper JAR itself uses Java/network settings.
    [string]$ProxyAddress = '',
    [switch]$ProxyUseDefaultCredentials
)

$ErrorActionPreference = 'Stop'

$script:ScriptRoot = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Path }
if ([string]::IsNullOrWhiteSpace($script:ScriptRoot)) { $script:ScriptRoot = (Get-Location).Path }

if ([string]::IsNullOrWhiteSpace($LogPath)) {
    $LogPath = Join-Path $script:ScriptRoot 'SWS_TokenGeneration_Only.log'
}

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Parent $LogPath
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Protect-TokenForLog {
    param([string]$Token)
    if ([string]::IsNullOrWhiteSpace($Token)) { return '<empty>' }
    if ($Token.Length -le 20) { return ('*' * $Token.Length) }
    return ('{0}...{1}' -f $Token.Substring(0, 12), $Token.Substring($Token.Length - 8))
}

function Sanitize-OutputForLog {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return '' }

    $sanitized = $Text
    $sanitized = [regex]::Replace($sanitized, '"access_token"\s*:\s*"[^"]+"', '"access_token":"<masked>"', 'IgnoreCase')
    $sanitized = [regex]::Replace($sanitized, '(?i)(access_token\s*[:=]\s*)([^\s,;]+)', '$1<masked>')
    $sanitized = [regex]::Replace($sanitized, '(?i)(Authorization:\s*Bearer\s+)([^\s]+)', '$1<masked>')
    return $sanitized.Trim()
}

function Get-AccessTokenFromOutput {
    param([string]$OutputText)

    if ([string]::IsNullOrWhiteSpace($OutputText)) { return $null }

    # JSON-style output: { "access_token": "..." }
    $m = [regex]::Match($OutputText, '"access_token"\s*:\s*"(?<token>[^"]+)"', 'IgnoreCase')
    if ($m.Success) { return $m.Groups['token'].Value.Trim() }

    # Key/value output: access_token: eyJ... or access_token=eyJ...
    $m = [regex]::Match($OutputText, '(?im)^\s*access_token\s*[:=]\s*(?<token>[^\s,;]+)')
    if ($m.Success) { return $m.Groups['token'].Value.Trim() }

    # Some helper builds may print AccessToken=...
    $m = [regex]::Match($OutputText, '(?im)^\s*AccessToken\s*[:=]\s*(?<token>[^\s,;]+)')
    if ($m.Success) { return $m.Groups['token'].Value.Trim() }

    return $null
}

function ConvertFrom-Base64UrlString {
    param([Parameter(Mandatory)][string]$Base64Url)
    $s = $Base64Url.Replace('-', '+').Replace('_', '/')
    switch ($s.Length % 4) {
        2 { $s += '==' }
        3 { $s += '=' }
        0 { }
        default { throw 'Invalid base64url length.' }
    }
    return [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($s))
}

function Show-JwtSummary {
    param([Parameter(Mandatory)][string]$Token)

    $parts = $Token.Split('.')
    if ($parts.Count -lt 2) {
        Write-Log 'Token does not look like a JWT, so header/payload summary was skipped.' 'Yellow'
        return
    }

    try {
        $headerJson  = ConvertFrom-Base64UrlString -Base64Url $parts[0]
        $payloadJson = ConvertFrom-Base64UrlString -Base64Url $parts[1]
        $header  = $headerJson  | ConvertFrom-Json
        $payload = $payloadJson | ConvertFrom-Json

        Write-Log ("JWT header: alg={0}; typ={1}; kid={2}" -f $header.alg, $header.typ, $header.kid) 'Green'

        $expText = ''
        if ($payload.exp) {
            try {
                $exp = [DateTimeOffset]::FromUnixTimeSeconds([int64]$payload.exp).LocalDateTime
                $expText = $exp.ToString('yyyy-MM-dd HH:mm:ss')
            } catch { $expText = [string]$payload.exp }
        }

        $scopeText = ''
        if ($payload.scope) { $scopeText = [string]$payload.scope }
        elseif ($payload.scp) { $scopeText = (($payload.scp | ForEach-Object { [string]$_ }) -join ',') }

        Write-Log ("JWT payload summary: iss={0}; aud={1}; sub={2}; exp={3}; scope={4}" -f $payload.iss, ($payload.aud -join ','), $payload.sub, $expText, $scopeText) 'Green'
    } catch {
        Write-Log ("Could not decode JWT summary: {0}" -f $_.Exception.Message) 'Yellow'
    }
}

function Resolve-JavaExe {
    $candidates = New-Object System.Collections.Generic.List[string]

    if (-not [string]::IsNullOrWhiteSpace($SwsJavaPath)) { $candidates.Add($SwsJavaPath) }

    $localCandidates = @(
        (Join-Path $script:ScriptRoot 'java.exe'),
        (Join-Path $script:ScriptRoot 'java\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jre\bin\java.exe'),
        (Join-Path $script:ScriptRoot 'jdk\bin\java.exe')
    )
    foreach ($p in $localCandidates) { $candidates.Add($p) }

    try {
        Get-ChildItem -Path $script:ScriptRoot -Directory -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -match '^(jdk|jre|java)' } |
            ForEach-Object {
                $p = Join-Path $_.FullName 'bin\java.exe'
                $candidates.Add($p)
            }
    } catch {}

    foreach ($p in $candidates | Select-Object -Unique) {
        if (-not [string]::IsNullOrWhiteSpace($p) -and (Test-Path -LiteralPath $p)) {
            return (Resolve-Path -LiteralPath $p).Path
        }
    }

    $cmd = Get-Command java.exe -ErrorAction SilentlyContinue
    if ($cmd -and $cmd.Source) { return $cmd.Source }

    throw "java.exe was not found. Pass -SwsJavaPath or place JDK/JRE beside the script. Current configured path was: $SwsJavaPath"
}

function Resolve-HelperJar {
    if (-not [string]::IsNullOrWhiteSpace($SwsAuthHelperJarPath)) {
        if (-not (Test-Path -LiteralPath $SwsAuthHelperJarPath)) {
            throw "SWS auth helper JAR was not found at: $SwsAuthHelperJarPath"
        }
        return (Resolve-Path -LiteralPath $SwsAuthHelperJarPath).Path
    }

    $jars = @(Get-ChildItem -Path $script:ScriptRoot -Filter 'public-api-auth-helper*.jar' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if ($jars.Count -eq 0) {
        throw "No public-api-auth-helper*.jar was found in script folder: $script:ScriptRoot"
    }

    if ($jars.Count -gt 1) {
        Write-Log 'Multiple CyberArk helper JAR files were found. Using the newest one:' 'Yellow'
        foreach ($j in $jars) { Write-Log ("  {0}  LastWriteTime={1}" -f $j.Name, $j.LastWriteTime) 'Gray' }
    }

    return $jars[0].FullName
}

function Get-JsonMetadata {
    param([Parameter(Mandatory)][string]$Path)

    $metadata = [ordered]@{
        Path = $Path
        Name = [IO.Path]::GetFileName($Path)
        LastWriteTime = $null
        IsLikelySwsJson = $false
        ServiceAccountId = ''
        DiscoveryUri = ''
        HasPrivateKey = $false
        Error = ''
    }

    try {
        $item = Get-Item -LiteralPath $Path -ErrorAction Stop
        $metadata.LastWriteTime = $item.LastWriteTime
        $raw = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop
        $json = $raw | ConvertFrom-Json -ErrorAction Stop

        foreach ($name in @('serviceAccountId','service_account_id','clientId','client_id','id')) {
            if ($json.PSObject.Properties.Name -contains $name -and -not [string]::IsNullOrWhiteSpace([string]$json.$name)) {
                $metadata.ServiceAccountId = [string]$json.$name
                break
            }
        }

        foreach ($name in @('discoveryURI','discoveryUri','discovery_url','discoveryUrl')) {
            if ($json.PSObject.Properties.Name -contains $name -and -not [string]::IsNullOrWhiteSpace([string]$json.$name)) {
                $metadata.DiscoveryUri = [string]$json.$name
                break
            }
        }

        foreach ($name in @('privateKey','private_key')) {
            if ($json.PSObject.Properties.Name -contains $name -and -not [string]::IsNullOrWhiteSpace([string]$json.$name)) {
                $metadata.HasPrivateKey = $true
                break
            }
        }

        $metadata.IsLikelySwsJson = (-not [string]::IsNullOrWhiteSpace($metadata.ServiceAccountId)) -and $metadata.HasPrivateKey -and (-not [string]::IsNullOrWhiteSpace($metadata.DiscoveryUri))
    } catch {
        $metadata.Error = $_.Exception.Message
    }

    return [pscustomobject]$metadata
}

function Resolve-ServiceAccountJson {
    if (-not [string]::IsNullOrWhiteSpace($SwsServiceAccountJsonPath)) {
        if (-not (Test-Path -LiteralPath $SwsServiceAccountJsonPath)) {
            throw "SWS service-account JSON was not found at: $SwsServiceAccountJsonPath"
        }
        $resolved = (Resolve-Path -LiteralPath $SwsServiceAccountJsonPath).Path
        $meta = Get-JsonMetadata -Path $resolved
        Write-Log ("Using explicitly supplied JSON: {0}; ServiceAccountId={1}; DiscoveryURI={2}; HasPrivateKey={3}" -f $meta.Name, $meta.ServiceAccountId, $meta.DiscoveryUri, $meta.HasPrivateKey) 'Cyan'
        return $resolved
    }

    $allJson = @(Get-ChildItem -Path $script:ScriptRoot -Filter '*.json' -File -ErrorAction SilentlyContinue)
    if ($allJson.Count -eq 0) {
        throw "No .json files were found in script folder: $script:ScriptRoot"
    }

    $metas = @($allJson | ForEach-Object { Get-JsonMetadata -Path $_.FullName } | Where-Object { $_.IsLikelySwsJson } | Sort-Object LastWriteTime -Descending)
    if ($metas.Count -eq 0) {
        Write-Log 'JSON files were found, but none looked like an SWS service-account JSON with serviceAccountId/privateKey/discoveryURI.' 'Red'
        foreach ($j in $allJson) { Write-Log ("  Candidate: {0}" -f $j.Name) 'Gray' }
        throw 'No valid-looking SWS service-account JSON was found.'
    }

    if ($metas.Count -eq 1 -or $AutoSelectNewestJson) {
        $selected = $metas[0]
        Write-Log ("Selected SWS service-account JSON: {0}; LastWriteTime={1}; ServiceAccountId={2}; DiscoveryURI={3}" -f $selected.Name, $selected.LastWriteTime, $selected.ServiceAccountId, $selected.DiscoveryUri) 'Cyan'
        return $selected.Path
    }

    Write-Log 'Multiple SWS service-account JSON files were found. Select the correct/fresh one:' 'Yellow'
    for ($i = 0; $i -lt $metas.Count; $i++) {
        $m = $metas[$i]
        Write-Host ("[{0}] {1}  LastWriteTime={2}  ServiceAccountId={3}  DiscoveryURI={4}" -f ($i + 1), $m.Name, $m.LastWriteTime, $m.ServiceAccountId, $m.DiscoveryUri) -ForegroundColor Yellow
    }

    $answer = Read-Host 'Enter number to use [default 1/newest]'
    if ([string]::IsNullOrWhiteSpace($answer)) { $answer = '1' }

    [int]$choice = 0
    if (-not [int]::TryParse($answer, [ref]$choice) -or $choice -lt 1 -or $choice -gt $metas.Count) {
        throw "Invalid JSON selection: $answer"
    }

    $selected = $metas[$choice - 1]
    Write-Log ("Selected SWS service-account JSON: {0}; ServiceAccountId={1}" -f $selected.Name, $selected.ServiceAccountId) 'Cyan'
    return $selected.Path
}

function Get-TenantCandidates {
    param([Parameter(Mandatory)][string]$TenantId)

    $list = New-Object System.Collections.Generic.List[string]
    $raw = $TenantId.Trim()
    if (-not [string]::IsNullOrWhiteSpace($raw)) { $list.Add($raw) }

    $dashless = ($raw -replace '-', '')
    if (-not [string]::IsNullOrWhiteSpace($dashless) -and $dashless -ne $raw) { $list.Add($dashless) }

    return @($list | Select-Object -Unique)
}

function Invoke-CyberArkHelperForToken {
    param(
        [Parameter(Mandatory)][string]$JavaExe,
        [Parameter(Mandatory)][string]$HelperJar,
        [Parameter(Mandatory)][string]$JsonPath,
        [Parameter(Mandatory)][string[]]$TenantCandidates
    )

    $errors = New-Object System.Collections.Generic.List[string]

    for ($i = 0; $i -lt $TenantCandidates.Count; $i++) {
        $tenant = $TenantCandidates[$i]
        $attempt = $i + 1

        Write-Log ("SWS helper token attempt #{0}: TenantId={1}" -f $attempt, $tenant) 'Cyan'
        Write-Log ("Command: `"{0}`" -jar `"{1}`" -t `"{2}`" -p `"{3}`"" -f $JavaExe, $HelperJar, $tenant, $JsonPath) 'Gray'

        $outputLines = @()
        $exitCode = $null
        try {
            $outputLines = & $JavaExe -jar $HelperJar -t $tenant -p $JsonPath 2>&1
            $exitCode = $LASTEXITCODE
        } catch {
            $outputLines += $_.Exception.Message
            $exitCode = $LASTEXITCODE
            if ($null -eq $exitCode) { $exitCode = -1 }
        }

        $outputText = ($outputLines | ForEach-Object { $_.ToString() }) -join "`n"
        $token = Get-AccessTokenFromOutput -OutputText $outputText

        if (-not [string]::IsNullOrWhiteSpace($token)) {
            Write-Log ("SUCCESS: CyberArk helper returned an access_token. ExitCode={0}; Length={1}; Masked={2}" -f $exitCode, $token.Length, (Protect-TokenForLog -Token $token)) 'Green'
            return [pscustomobject]@{
                Success = $true
                Token = $token
                TenantIdUsed = $tenant
                ExitCode = $exitCode
                Output = $outputText
            }
        }

        $sanitized = Sanitize-OutputForLog -Text $outputText
        Write-Log ("FAILED: helper did not return access_token. ExitCode={0}; SanitizedOutput={1}" -f $exitCode, $sanitized) 'Red'
        $errors.Add(("Attempt={0}; TenantId={1}; ExitCode={2}; Output={3}" -f $attempt, $tenant, $exitCode, $sanitized))
    }

    return [pscustomobject]@{
        Success = $false
        Token = $null
        TenantIdUsed = $null
        ExitCode = $null
        Output = ($errors -join "`n---`n")
    }
}

function Test-SwsApiToken {
    param([Parameter(Mandatory)][string]$Token)

    $uri = $SwsApiBaseUrl.TrimEnd('/') + '/sws/policies'
    $headers = @{ Authorization = "Bearer $Token"; Accept = 'application/json' }

    $params = @{ Method = 'GET'; Uri = $uri; Headers = $headers; ErrorAction = 'Stop' }
    if (-not [string]::IsNullOrWhiteSpace($ProxyAddress)) {
        $params.Proxy = $ProxyAddress
        if ($ProxyUseDefaultCredentials) { $params.ProxyUseDefaultCredentials = $true }
    }

    Write-Log ("Optional API validation: GET {0}" -f $uri) 'Cyan'
    try {
        $resp = Invoke-RestMethod @params
        Write-Log 'Optional API validation succeeded. Token is usable against SWS API.' 'Green'
        return $true
    } catch {
        $status = $null
        try { $status = [int]$_.Exception.Response.StatusCode.value__ } catch {}
        Write-Log ("Optional API validation failed. Status={0}; Error={1}" -f $status, $_.Exception.Message) 'Red'
        return $false
    }
}

try {
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic Started =====' 'Cyan'
    Write-Log ("ScriptRoot={0}" -f $script:ScriptRoot) 'Gray'
    Write-Log ("LogPath={0}" -f $LogPath) 'Gray'

    $javaExe = Resolve-JavaExe
    $javaVersion = (& $javaExe -version 2>&1 | ForEach-Object { $_.ToString() }) -join ' | '
    Write-Log ("Using Java executable: {0}; Version={1}" -f $javaExe, $javaVersion) 'Cyan'

    $helperJar = Resolve-HelperJar
    Write-Log ("Using CyberArk helper JAR: {0}" -f $helperJar) 'Cyan'

    $jsonPath = Resolve-ServiceAccountJson
    $jsonMeta = Get-JsonMetadata -Path $jsonPath
    Write-Log ("Using SWS JSON: {0}; ServiceAccountId={1}; DiscoveryURI={2}; HasPrivateKey={3}" -f $jsonMeta.Name, $jsonMeta.ServiceAccountId, $jsonMeta.DiscoveryUri, $jsonMeta.HasPrivateKey) 'Cyan'

    $tenants = Get-TenantCandidates -TenantId $SwsTenantId
    Write-Log ("Tenant candidate count={0}; Values={1}" -f $tenants.Count, ($tenants -join ', ')) 'Cyan'

    $result = Invoke-CyberArkHelperForToken -JavaExe $javaExe -HelperJar $helperJar -JsonPath $jsonPath -TenantCandidates $tenants

    if (-not $result.Success) {
        Write-Log 'TOKEN GENERATION FAILED: CyberArk helper did not return an access_token.' 'Red'
        Write-Log 'Most likely causes: wrong JSON/private key, inactive service account, wrong tenant, wrong signing type, or service account key was rotated.' 'Yellow'
        Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic Finished: FAILED =====' 'Red'
        exit 1
    }

    $token = [string]$result.Token
    Write-Log ("TOKEN GENERATION SUCCESS. TenantIdUsed={0}; TokenLength={1}; MaskedToken={2}" -f $result.TenantIdUsed, $token.Length, (Protect-TokenForLog -Token $token)) 'Green'
    Show-JwtSummary -Token $token

    if ($ShowToken) {
        Write-Host ''
        Write-Host 'RAW ACCESS TOKEN BELOW. Keep it secure. Do not paste it into tickets/chat.' -ForegroundColor Yellow
        Write-Host $token -ForegroundColor Green
        Write-Host ''
    } else {
        Write-Log 'Raw token was not printed. Use -ShowToken only if you need to copy it locally.' 'Yellow'
    }

    if ($SaveTokenToFile) {
        $tokenFile = Join-Path $script:ScriptRoot 'sws_access_token.txt'
        Set-Content -Path $tokenFile -Value $token -NoNewline -Force
        Write-Log ("Raw token saved to: {0}. Delete this file after testing." -f $tokenFile) 'Yellow'
    }

    if ($ValidateAgainstSwsApi) {
        [void](Test-SwsApiToken -Token $token)
    } else {
        Write-Log 'SWS API validation was skipped. Add -ValidateAgainstSwsApi if you want to test GET /sws/policies after generation.' 'Gray'
    }

    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic Finished: SUCCESS =====' 'Green'
    exit 0
}
catch {
    Write-Log ("FATAL ERROR: {0}" -f $_.Exception.Message) 'Red'
    Write-Log '===== CyberArk SWS Token Generation ONLY Diagnostic Finished: FAILED =====' 'Red'
    exit 1
}
