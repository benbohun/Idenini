<#
Validate_Usernames_AcrossDomains.ps1

PURPOSE
  Take a bulk CSV containing "likely" (often poorly formatted) usernames and:
    1. Clean / normalize each value into a set of search candidates.
    2. Search a list of AD domain OUs (SearchBases) to find the real account.
    3. Report which usernames exist, in WHICH domain, the correct
       sAMAccountName / UPN, and which ones were not found at all.

HOW MATCHING WORKS (handles messy input)
  For every CSV value the script builds candidates by:
    - stripping a DOMAIN\ prefix and an @upn suffix
    - trimming whitespace / quotes / stray punctuation
    - producing space-removed, dotted, underscored, hyphenated variants
  Then per domain it runs:
    - PASS 1 (exact)  : sAMAccountName / UPN equals a candidate  -> high confidence
    - PASS 2 (fuzzy)  : wildcard contains across sAMAccountName,
                        userPrincipalName, displayName, cn, name   -> suggestions
                        (only runs when no exact match was found anywhere)

OUTPUT (written next to the input CSV, timestamped)
    *_Summary.csv   one row per input value (overall status + best match)
    *_Detail.csv    one row per individual account match found

REQUIREMENTS
  - RSAT ActiveDirectory PowerShell module (Get-ADUser).
  - Network/trust path + DNS resolution to each target domain.
  - Rights to read the target OUs (pass -Credential if needed).

EXAMPLES
  .\Validate_Usernames_AcrossDomains.ps1 -CsvPath "C:\temp\accounts.csv"
  .\Validate_Usernames_AcrossDomains.ps1 -CsvPath ".\accounts.csv" -UsernameColumn "LikelyUser" -Credential (Get-Credential)
  .\Validate_Usernames_AcrossDomains.ps1 -CsvPath ".\accounts.csv" -NoFuzzy
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory)]
    [string]$CsvPath,

    # If omitted, the script auto-detects the most likely username column.
    [string]$UsernameColumn,

    # Where reports are written. Defaults to the input CSV's folder.
    [string]$OutputDir,

    # Optional alternate credentials for AD queries (use if cross-domain auth is needed).
    [System.Management.Automation.PSCredential]$Credential,

    # Turn off fuzzy/wildcard fallback (exact matching only).
    [switch]$NoFuzzy,

    # Safety cap on how many hits a single fuzzy search may return per domain.
    [int]$MaxFuzzyPerSearch = 25,

    # ============================================================
    # DOMAIN SEARCH BASES  --  EDIT THESE PLACEHOLDERS
    # The DNS domain (and thus the -Server) is auto-derived from the
    # DC=... components of each DN unless you map an explicit server below.
    # ============================================================
    [string[]]$DomainSearchBases = @(
        'OU=Service,OU=Accounts,DC=prod,DC=domain1,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain2,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain3,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain4,DC=com',
        'OU=Service,OU=Accounts,DC=prod,DC=domain5,DC=com'
    ),

    # OPTIONAL: force a specific DC/server for a given DNS domain.
    #   e.g. @{ 'prod.domain1.com' = 'dc01.prod.domain1.com' }
    [hashtable]$ServerOverrides = @{}
)

$ErrorActionPreference = 'Continue'

# --- ASCII-only log helpers (PS 5.1 mangles emoji in BOM-less files) ---
function Write-Info($m){ Write-Host "[INFO]  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "[OK]    $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[WARN]  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "[ERROR] $m" -ForegroundColor Red }

# --- Module check ---
if (-not (Get-Module -ListAvailable -Name ActiveDirectory)) {
    Write-Err "ActiveDirectory module not found. Install RSAT AD PowerShell tools and re-run."
    return
}
Import-Module ActiveDirectory -ErrorAction Stop

# --- Helpers ---------------------------------------------------------------

function ConvertTo-DnsDomain {
    # OU=...,DC=prod,DC=domain1,DC=com  ->  prod.domain1.com
    param([Parameter(Mandatory)][string]$DistinguishedName)
    $dcs = [regex]::Matches($DistinguishedName, '(?i)DC=([^,]+)') | ForEach-Object { $_.Groups[1].Value }
    return ($dcs -join '.')
}

function Get-EscapedLdapValue {
    # Escape RFC 4515 special characters so messy input can't break the filter.
    param([Parameter(Mandatory)][string]$Value)
    $v = $Value
    $v = $v -replace '\\', '\5c'
    $v = $v -replace '\*',  '\2a'
    $v = $v -replace '\(',  '\28'
    $v = $v -replace '\)',  '\29'
    $v = $v -replace "`0",  '\00'
    return $v
}

function Get-SearchCandidates {
    <#
      Turn one raw CSV value into ordered, de-duplicated search candidates.
      Returns a hashtable:
        Exact = @(...)  values to try as an EXACT sAMAccountName/UPN match
        Fuzzy = @(...)  tokens to wildcard-search when nothing exact is found
    #>
    param([string]$Raw)

    $exact = New-Object System.Collections.Generic.List[string]
    $fuzzy = New-Object System.Collections.Generic.List[string]

    if ([string]::IsNullOrWhiteSpace($Raw)) {
        return @{ Exact = @(); Fuzzy = @() }
    }

    # 1. Trim and strip wrapping quotes / stray surrounding punctuation.
    $core = $Raw.Trim().Trim('"',"'").Trim()

    # 2. Strip DOMAIN\ prefix.
    if ($core -match '\\') { $core = ($core -split '\\')[-1] }

    # 3. Strip @upnsuffix.
    if ($core -match '@')  { $core = ($core -split '@')[0] }

    $core = $core.Trim()
    if ([string]::IsNullOrWhiteSpace($core)) {
        return @{ Exact = @(); Fuzzy = @() }
    }

    # Whitespace-normalized variants for EXACT attempts.
    $variants = New-Object System.Collections.Generic.List[string]
    [void]$variants.Add($core)
    [void]$variants.Add(($core -replace '\s+',''))    # remove spaces
    [void]$variants.Add(($core -replace '\s+','.'))   # spaces -> dot
    [void]$variants.Add(($core -replace '\s+','_'))   # spaces -> underscore
    [void]$variants.Add(($core -replace '\s+','-'))   # spaces -> hyphen

    foreach ($v in $variants) {
        $vv = $v.Trim()
        if ($vv -and -not $exact.Contains($vv)) { [void]$exact.Add($vv) }
    }

    # Fuzzy tokens: the space-removed core + each "word" >2 chars.
    $fuzzyRaw = New-Object System.Collections.Generic.List[string]
    [void]$fuzzyRaw.Add(($core -replace '\s+',''))
    foreach ($w in ($core -split '\s+')) {
        $wt = ($w -replace '[^A-Za-z0-9_\-\.]', '').Trim()
        if ($wt.Length -gt 2) { [void]$fuzzyRaw.Add($wt) }
    }
    foreach ($f in $fuzzyRaw) {
        $ff = $f.Trim()
        if ($ff -and -not $fuzzy.Contains($ff)) { [void]$fuzzy.Add($ff) }
    }

    return @{ Exact = $exact.ToArray(); Fuzzy = $fuzzy.ToArray() }
}

# --- Resolve paths ---------------------------------------------------------

if (-not (Test-Path $CsvPath)) { Write-Err "CSV not found: $CsvPath"; return }
$CsvPath = (Resolve-Path $CsvPath).Path

if (-not $OutputDir) { $OutputDir = Split-Path -Parent $CsvPath }
if (-not (Test-Path $OutputDir)) { New-Item -ItemType Directory -Path $OutputDir -Force | Out-Null }

$stamp        = Get-Date -Format 'yyyyMMdd_HHmmss'
$baseName     = [System.IO.Path]::GetFileNameWithoutExtension($CsvPath)
$summaryPath  = Join-Path $OutputDir ("{0}_Validation_Summary_{1}.csv" -f $baseName, $stamp)
$detailPath   = Join-Path $OutputDir ("{0}_Validation_Detail_{1}.csv"  -f $baseName, $stamp)

# --- Load CSV --------------------------------------------------------------

$rows = Import-Csv -Path $CsvPath
if (-not $rows -or $rows.Count -eq 0) { Write-Err "CSV '$CsvPath' has no data rows."; return }

$columns = $rows[0].PSObject.Properties.Name

if (-not $UsernameColumn) {
    $preferred = @('samaccountname','username','user name','user','login','logon','account','accountname','name','userid','id')
    foreach ($p in $preferred) {
        $hit = $columns | Where-Object { $_.Trim().ToLower() -eq $p } | Select-Object -First 1
        if ($hit) { $UsernameColumn = $hit; break }
    }
    if (-not $UsernameColumn) {
        # fall back to first column containing 'user' or 'account' or 'name'
        $UsernameColumn = $columns | Where-Object { $_ -match '(?i)user|account|name|login|logon' } | Select-Object -First 1
    }
    if (-not $UsernameColumn) {
        Write-Err "Could not auto-detect a username column. Available columns: $($columns -join ', ')"
        Write-Err "Re-run with -UsernameColumn '<columnName>'."
        return
    }
    Write-Info "Auto-detected username column: '$UsernameColumn'"
} elseif ($columns -notcontains $UsernameColumn) {
    Write-Err "Column '$UsernameColumn' not found. Available columns: $($columns -join ', ')"
    return
}

# --- Build domain target list & test reachability --------------------------

$adProps = @('SamAccountName','UserPrincipalName','DisplayName','Name','Enabled','DistinguishedName','Description','whenCreated')

$targets = New-Object System.Collections.Generic.List[object]
foreach ($sb in $DomainSearchBases) {
    if ([string]::IsNullOrWhiteSpace($sb)) { continue }
    $dns    = ConvertTo-DnsDomain -DistinguishedName $sb
    $server = if ($ServerOverrides.ContainsKey($dns)) { $ServerOverrides[$dns] } else { $dns }

    $common = @{ Server = $server }
    if ($Credential) { $common['Credential'] = $Credential }

    $reachable = $false
    try {
        # Cheap probe: confirm the search base resolves and we can read it.
        Get-ADObject -Identity $sb @common -ErrorAction Stop | Out-Null
        $reachable = $true
        Write-Ok "Reachable: $dns  (SearchBase OK)"
    } catch {
        Write-Warn "Skipping unreachable/unreadable target '$dns' [$sb]: $($_.Exception.Message)"
    }

    $targets.Add([pscustomobject]@{
        SearchBase = $sb
        Dns        = $dns
        Server     = $server
        Common     = $common
        Reachable  = $reachable
    }) | Out-Null
}

$liveTargets = @($targets | Where-Object { $_.Reachable })
if ($liveTargets.Count -eq 0) {
    Write-Err "No reachable domains. Check the SearchBase placeholders, DNS, trust, and credentials."
    return
}
Write-Info ("Searching {0} reachable domain(s) for {1} input value(s)." -f $liveTargets.Count, $rows.Count)

# --- Search routines -------------------------------------------------------

function Find-ExactMatches {
    param([string[]]$Candidates, [object]$Target)
    $found = New-Object System.Collections.Generic.List[object]
    $c = $Target.Common   # must splat from a plain variable, not a property expression
    foreach ($cand in $Candidates) {
        $esc = Get-EscapedLdapValue -Value $cand
        $filter = "(|(sAMAccountName=$esc)(userPrincipalName=$esc))"
        try {
            $res = Get-ADUser -LDAPFilter $filter -SearchBase $Target.SearchBase -Properties $adProps @c -ErrorAction Stop
            foreach ($u in $res) { $found.Add([pscustomobject]@{ User=$u; MatchedOn=$cand; MatchType='Exact' }) | Out-Null }
        } catch {
            Write-Warn "Exact search error in $($Target.Dns) for '$cand': $($_.Exception.Message)"
        }
    }
    return $found
}

function Find-FuzzyMatches {
    param([string[]]$Tokens, [object]$Target, [int]$Cap)
    $found = New-Object System.Collections.Generic.List[object]
    $c = $Target.Common   # must splat from a plain variable, not a property expression
    foreach ($tok in $Tokens) {
        if ($tok.Length -lt 3) { continue }
        $esc = Get-EscapedLdapValue -Value $tok
        $filter = "(|(sAMAccountName=*$esc*)(userPrincipalName=*$esc*)(displayName=*$esc*)(cn=*$esc*)(name=*$esc*))"
        try {
            $res = Get-ADUser -LDAPFilter $filter -SearchBase $Target.SearchBase -Properties $adProps -ResultSetSize $Cap @c -ErrorAction Stop
            foreach ($u in $res) { $found.Add([pscustomobject]@{ User=$u; MatchedOn=$tok; MatchType='Fuzzy' }) | Out-Null }
        } catch {
            Write-Warn "Fuzzy search error in $($Target.Dns) for '$tok': $($_.Exception.Message)"
        }
    }
    return $found
}

# --- Main loop -------------------------------------------------------------

$summary = New-Object System.Collections.Generic.List[object]
$detail  = New-Object System.Collections.Generic.List[object]
$rowNum  = 0

foreach ($row in $rows) {
    $rowNum++
    $raw = [string]$row.$UsernameColumn
    Write-Info ("[{0}/{1}] Validating: '{2}'" -f $rowNum, $rows.Count, $raw)

    $cand = Get-SearchCandidates -Raw $raw

    if ($cand.Exact.Count -eq 0) {
        $summary.Add([pscustomobject]@{
            InputValue       = $raw
            CleanedCandidate = ''
            OverallStatus    = 'BLANK_OR_INVALID'
            MatchType        = ''
            MatchCount       = 0
            FoundInDomains   = ''
            BestMatch_Sam    = ''
            BestMatch_UPN    = ''
            BestMatch_Domain = ''
            BestMatch_Enabled= ''
            BestMatch_DN     = ''
            CandidatesTried  = ''
            Notes            = 'Empty or unparseable value'
        }) | Out-Null
        continue
    }

    # Collect matches across all live domains, de-duped by DN.
    $allMatches = @{}   # DN -> match record
    $matchType  = 'Exact'

    foreach ($t in $liveTargets) {
        foreach ($m in (Find-ExactMatches -Candidates $cand.Exact -Target $t)) {
            $dn = $m.User.DistinguishedName
            if (-not $allMatches.ContainsKey($dn)) {
                $allMatches[$dn] = [pscustomobject]@{ Match=$m; Domain=$t.Dns }
            }
        }
    }

    # Fuzzy fallback only if nothing exact and fuzzy enabled.
    if ($allMatches.Count -eq 0 -and -not $NoFuzzy -and $cand.Fuzzy.Count -gt 0) {
        $matchType = 'Fuzzy'
        foreach ($t in $liveTargets) {
            foreach ($m in (Find-FuzzyMatches -Tokens $cand.Fuzzy -Target $t -Cap $MaxFuzzyPerSearch)) {
                $dn = $m.User.DistinguishedName
                if (-not $allMatches.ContainsKey($dn)) {
                    $allMatches[$dn] = [pscustomobject]@{ Match=$m; Domain=$t.Dns }
                }
            }
        }
    }

    $matchList = @($allMatches.Values)
    $count     = $matchList.Count

    # Per-match detail rows.
    foreach ($entry in $matchList) {
        $u = $entry.Match.User
        $detail.Add([pscustomobject]@{
            InputValue        = $raw
            Domain            = $entry.Domain
            MatchType         = $entry.Match.MatchType
            MatchedOn         = $entry.Match.MatchedOn
            SamAccountName    = $u.SamAccountName
            UserPrincipalName = $u.UserPrincipalName
            DisplayName       = $u.DisplayName
            Enabled           = $u.Enabled
            Description       = $u.Description
            WhenCreated       = $u.whenCreated
            DistinguishedName = $u.DistinguishedName
        }) | Out-Null
    }

    # Overall status + best match for the summary row.
    if ($count -eq 0) {
        $status = 'NOT_FOUND'
        $best   = $null
    } elseif ($count -eq 1) {
        $status = if ($matchType -eq 'Exact') { 'FOUND_UNIQUE' } else { 'FOUND_FUZZY_UNIQUE' }
        $best   = $matchList[0]
    } else {
        $status = if ($matchType -eq 'Exact') { 'FOUND_MULTIPLE' } else { 'FOUND_FUZZY_MULTIPLE' }
        # Prefer an enabled, exact match as "best".
        $best = $matchList |
                Sort-Object @{e={ if ($_.Match.MatchType -eq 'Exact'){0}else{1} }}, @{e={ if ($_.Match.User.Enabled){0}else{1} }} |
                Select-Object -First 1
    }

    $domains = ($matchList | ForEach-Object { $_.Domain } | Select-Object -Unique) -join '; '

    $summary.Add([pscustomobject]@{
        InputValue        = $raw
        CleanedCandidate  = $cand.Exact[0]
        OverallStatus     = $status
        MatchType         = if ($count -gt 0) { $matchType } else { '' }
        MatchCount        = $count
        FoundInDomains    = $domains
        BestMatch_Sam     = if ($best) { $best.Match.User.SamAccountName } else { '' }
        BestMatch_UPN     = if ($best) { $best.Match.User.UserPrincipalName } else { '' }
        BestMatch_Domain  = if ($best) { $best.Domain } else { '' }
        BestMatch_Enabled = if ($best) { $best.Match.User.Enabled } else { '' }
        BestMatch_DN      = if ($best) { $best.Match.User.DistinguishedName } else { '' }
        CandidatesTried   = ($cand.Exact -join ' | ')
        Notes             = if ($count -gt 1) { 'Multiple matches - review Detail report' } elseif ($matchType -eq 'Fuzzy' -and $count -ge 1) { 'Fuzzy suggestion - verify before use' } else { '' }
    }) | Out-Null
}

# --- Export ----------------------------------------------------------------

$summary | Export-Csv -Path $summaryPath -NoTypeInformation -Encoding UTF8
$detail  | Export-Csv -Path $detailPath  -NoTypeInformation -Encoding UTF8

# --- Console roll-up -------------------------------------------------------

$counts = $summary | Group-Object OverallStatus | Sort-Object Name
Write-Host ""
Write-Ok "Validation complete."
Write-Host "----------------------------------------"
foreach ($g in $counts) { Write-Host ("  {0,-22} {1}" -f $g.Name, $g.Count) }
Write-Host "----------------------------------------"
Write-Ok "Summary report: $summaryPath"
Write-Ok "Detail report:  $detailPath"
