#This plugin has been automatically generated by PGU. Version 1.0.0.0
[states]
# Initialize: managed account context (whose password we rotate)
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"

# Start session
RunCommand=(spawn)plink.exe <address> -<protocol> -P <port>
StoreKeyInCache=y

# PGU scaffolding
CheckInitAction=
CheckExtraPass=
LoginUser=$username
SendPassword=$curr_pass
CheckAction=

# Logon account (ExtraPass1)
LoginExtraUser=<extrapass1\username>
SendExtraPassword=<pmextrapass1>

# APC change-password variants
ChangeCmdPrimary=user -n <username> -pw "<pmnewpass>" -cp "<pmpass>"
ChangeCmdFallback=user -n <username> -pw "<pmnewpass>"
ChangeCmdLegacy=user -password <username> "<pmnewpass>"

# Wrap-up
FinalStep=
END=
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILNotSupported2=FAIL(Logon account is required, 8002)
FAILInvalidExtraPassword=FAIL(First login - Current assigned logon account password is invalid, 8006)
FAILAccountDisabled2=FAIL(First login - Current assigned logon account user is disabled, 8011)
FAILNotAllowedLogin2=FAIL(First login - Current assigned logon account is not allowed to log in, 8013)

# APC-specific change failures
FAILChangeUnknown=FAIL(Change password failed — command not recognized on this firmware, 8201)
FAILChangeRejected=FAIL(Change password rejected — policy/complexity or privilege issue, 8202)
FAILChangeAuth=FAIL(Change password failed — incorrect current password or insufficient privileges, 8203)

[transitions]
# Boot
Init,TRUE,RunCommand

# Session start & host key handling
RunCommand,UnableToConnect,FAILUnableToConnect
RunCommand,PlinkStoreKey,StoreKeyInCache
RunCommand,Login,CheckInitAction
StoreKeyInCache,Login,CheckInitAction

# Action gating (verify/logon are no-ops; change requires logon account)
CheckInitAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckInitAction,ActionIsNotRecOrPreRec,CheckExtraPass

# Require ExtraPass1 for logon account
CheckExtraPass,ExtraPassExists,LoginExtraUser
CheckExtraPass,ExtraPassNotExists,FAILNotSupported2

# Log in with logon account
LoginExtraUser,Password,SendExtraPassword

SendExtraPassword,InvalidLogin,FAILInvalidExtraPassword
SendExtraPassword,Password,FAILInvalidExtraPassword
SendExtraPassword,AccountDisabled,FAILAccountDisabled2
SendExtraPassword,NotAllowedLogin,FAILNotAllowedLogin2
SendExtraPassword,StandardPrompt,CheckAction

# Resolve requested action
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsChange,ChangeCmdPrimary

# CHANGE — Primary (NMC3: requires current password via -cp)
ChangeCmdPrimary,ChangeSuccess,FinalStep
ChangeCmdPrimary,AuthFailure,FAILChangeAuth
ChangeCmdPrimary,ComplexityFailure,FAILChangeRejected
ChangeCmdPrimary,CommandUnknown,ChangeCmdFallback
ChangeCmdPrimary,SyntaxError,ChangeCmdFallback
ChangeCmdPrimary,StandardPrompt,FinalStep

# CHANGE — Fallback (NMC2/NMC3 without -cp)
ChangeCmdFallback,ChangeSuccess,FinalStep
ChangeCmdFallback,AuthFailure,FAILChangeAuth
ChangeCmdFallback,ComplexityFailure,FAILChangeRejected
ChangeCmdFallback,CommandUnknown,ChangeCmdLegacy
ChangeCmdFallback,SyntaxError,ChangeCmdLegacy
ChangeCmdFallback,StandardPrompt,FinalStep

# CHANGE — Legacy (older NMC2 form)
ChangeCmdLegacy,ChangeSuccess,FinalStep
ChangeCmdLegacy,ComplexityFailure,FAILChangeRejected
ChangeCmdLegacy,AuthFailure,FAILChangeAuth
ChangeCmdLegacy,CommandUnknown,FAILChangeUnknown
ChangeCmdLegacy,SyntaxError,FAILChangeUnknown
ChangeCmdLegacy,StandardPrompt,FinalStep

# Done
FinalStep,TRUE,END

[CPM Parameters Validation]
address,                 source=FILE, Mandatory=yes
extrapass1\Username,     source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]
# Managed account fields come from the platform (username, pmpass, pmnewpass)

[Parameters]
PromptTimeout=30
SendHuman=.1 .3 1 .05 2

[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no


