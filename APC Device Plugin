Prompt

#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# general truth
TRUE=(expression)true

# transport / network
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host|No route to host|Network error|Connection timed out|Connection refused

# plink first contact
PlinkStoreKey=Store key in cache|The server's host key is not cached

# interactive login prompts (APC/NMC sometimes shows 'User Name :')
Login=(?i)^(login as:|login:|username:|user\s*name\s*:)$
Password=(?i)^\s*password\s*:\s*$

# action checks
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]

# extra credential presence
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# access and policy denials
InvalidLogin=(?i)access\s+denied|login\s+incorrect|authentication\s+failed|invalid\s+login\s+name|bad\s+password
AccountDisabled=(?i)account\s+is\s+disabled|account\s+has\s+been\s+locked
NotAllowedLogin=(?i)wrong\s+time\s+period|not\s+allowed\s+to\s+login\s+at\s+this\s+time|remote\s+logins\s+are\s+not\s+allowed

# normal operational prompt (primary 'apc>' plus safe fallbacks)
StandardPrompt=(?m)^apc>\s*$|(?m)^[^\r\n]*#\s*$|(?m)^[^\r\n]*>\s*$

# NOTE:
# - No Unicode characters are used in this file.
# - No config-mode prompts or commands are referenced; APC NMC shows 'E101: Command Not Found' for 'configure terminal'.
# - If the device presents the banner and 'apc>' immediately, we short-circuit to CheckAction to avoid duplicate logins.
