# APC NMC2/NMC3 CLI (ATS AP44xxA) - Logon via extrapass1, verify/logon/change supported
[states]
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"
RunCommand=(spawn)plink.exe <address> -<protocol> -P <port>
StoreKeyInCache=y

CheckInitAction=
CheckExtraPass=

LoginExtraUser=<extrapass1\username>
SendExtraPassword=<pmextrapass1>

CheckAction=

# --- CHANGE (non-interactive APC) ---
ChangeStep1=user -n <username> -pw <pmnewpass> -cp <pmpass>
ChangeStep1NoCP=user -n <username> -pw <pmnewpass>
ChangeVerify=user -l
ExitCmd=exit

FinalStep=
END=

# Failures
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin=FAIL(User is not allowed to log in, 8012)
FAILInvalidLogin=FAIL(Invalid username or bad password, 2114)
FAILLogonRequired=FAIL(Logon account is required, 8002)
FAILInvalidExtraPassword=FAIL(First login - Current assigned logon account password is invalid, 8006)
FAILChangeDenied=FAIL(Password change denied or not authorized, 8016)
FAILChangePolicy=FAIL(Password rejected by policy, 8017)
FAILChangeUserNotFound=FAIL(Target username not found on device, 8018)
FAILChangeInvalidParam=FAIL(Invalid parameter or command syntax on device, 8019)
FAILUnknownChangeError=FAIL(Password change failed - unknown device error, 8999)

[transitions]
# Connect and accept key
Init,TRUE,RunCommand
RunCommand,UnableToConnect,FAILUnableToConnect
RunCommand,PlinkStoreKey,StoreKeyInCache
StoreKeyInCache,Login,CheckInitAction

# Decide action and ensure we have a Logon Account
CheckInitAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckInitAction,ActionIsNotRecOrPreRec,CheckExtraPass
CheckExtraPass,ExtraPassExists,LoginExtraUser
CheckExtraPass,ExtraPassNotExists,FAILLogonRequired

# Logon with extrapass1
LoginExtraUser,Password,SendExtraPassword
SendExtraPassword,InvalidLogin,FAILInvalidExtraPassword
SendExtraPassword,AccountDisabled,FAILNotAllowedLogin
SendExtraPassword,NotAllowedLogin,FAILNotAllowedLogin
SendExtraPassword,StandardPrompt,CheckAction

# Action routing
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsChange,ChangeStep1

# Change with -cp (preferred)
ChangeStep1,ChangeOK,ExitCmd
ChangeStep1,ChangeInvalidParam,ChangeStep1NoCP
ChangeStep1,ChangeUserNotFound,FAILChangeUserNotFound
ChangeStep1,ChangeDenied,FAILChangeDenied
ChangeStep1,ChangePolicy,FAILChangePolicy
ChangeStep1,ChangeAnyError,FAILUnknownChangeError
ChangeStep1,StandardPrompt,ChangeVerify

# Fallback without -cp (older NMC2)
ChangeStep1NoCP,ChangeOK,ExitCmd
ChangeStep1NoCP,ChangeInvalidParam,FAILChangeInvalidParam
ChangeStep1NoCP,ChangeUserNotFound,FAILChangeUserNotFound
ChangeStep1NoCP,ChangeDenied,FAILChangeDenied
ChangeStep1NoCP,ChangePolicy,FAILChangePolicy
ChangeStep1NoCP,ChangeAnyError,FAILUnknownChangeError
ChangeStep1NoCP,StandardPrompt,ExitCmd

# Exit cleanly
ChangeVerify,StandardPrompt,ExitCmd
ExitCmd,TRUE,FinalStep
FinalStep,TRUE,END





:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


Prompt

[Conditions]
TRUE=(expression)true

UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login dialogue
Login=User\s*Name\s*:|login as:|login:
Password=Password\s*:

InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
AccountDisabled=Account is disabled .*|account has been locked
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.

# APC prompt (banner then apc>)
StandardPrompt=(?m)^apc>\s*$|(?m)^.*#\s*$|(?m)^.*>\s*$

# Action gates
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]

# Logon account presence
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# APC change outcomes
ChangeOK=^E000:\s*Success\b|(?i)\bsuccess(ful(ly)?)?\b
ChangeInvalidParam=^E004:\s*Invalid\s+parameter\b|^E101:\s*Command\s+Not\s+Found\b|(?i)\bunknown\s+option\b|(?i)\busage:\s*user\b
ChangeUserNotFound=^E005:.*(user|username).*(not\s+found|does\s+not\s+exist)
ChangeDenied=^E003:\s*Access\s+denied\b|^E006:.*not\s+authorized\b|(?i)\bpermission\s+denied\b
ChangePolicy=^E020:.*|(?i)\bpassword\s+policy\b|(?i)\bbad\s+password\b|(?i)\btoo\s+short\b|(?i)\btoo\s+similar\b|(?i)\bdictionary\s+word\b|(?i)\bnot\s+enough\s+different\s+characters\b
ChangeAnyError=^E0(?!00)\d{2}:.*
