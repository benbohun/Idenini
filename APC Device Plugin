#This plugin has been automatically generated by PGU. Version 1.0.0.0
#Prompt
[Conditions]
TRUE=(expression)true

########################
# Connectivity / plink #
########################
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host|Network error
PlinkStoreKey=Store key in cache

###############
# Login phase #
###############
# APC can show "User Name :" or "Username:"; keep "login:" for telnet-like flows.
Login=User\s*Name\s*:|Username\s*:|login as:|login:
Password=Password\s*:
InvalidLogin=Access denied|Authentication failed|Invalid user name or password|Login incorrect|authorization failed
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# Prompt: accept start-of-line OR newline, variable spacing, and common prompt chars
StandardPrompt=(?:^|\r?\n).*[^\n\r]*[>#\$]\s*$

#########################
# Action classification #
#########################
ActionIsVerify=(expression)[string equal -nocase "<action>" "verifypass"]
ActionIsLogon=(expression)[string equal -nocase "<action>" "logon"]
ActionIsChange=(expression)[string equal -nocase "<action>" "changepass"]

# Reconcile/pre-reconcile gating (corrected logic)
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"])

#########################
# ExtraPass1 availability
#########################
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

####################################
# Change password result detection #
####################################
# Treat explicit success OR quiet success (prompt return) as success.
ChangeSuccess=(?:password\s+(?:updated|changed)|User\s+parameters\s+modified|User\s+updated|OK|Success|completed)\.?|(?:(?:^|\r?\n).*[>#]\s*$)

# Common error buckets across NMC2/NMC3
AuthFailure=Permission\s+denied|Authentication\s+failure|authorization\s+failed|current\s+password\s+incorrect|invalid\s+credentials|insufficient\s+privilege
ComplexityFailure=complexity|too\s+short|min(?:imum)?\s+length|weak|invalid\s+value|policy\s+violation|does\s+not\s+meet
SyntaxError=syntax\s+error|usage:|invalid\s+parameter|bad\s+option|missing\s+argument
CommandUnknown=Unknown\s+command|Invalid\s+command|Command\s+not\s+found|Error:\s*Command\s+not\s+found|unrecognized\s+option
