Import-Module WebAdministration -ErrorAction Stop

$AppPoolName = "MyApplicationPool"
$ServiceUser = "DOMAIN\SVC_WebApplication"

# Securely prompt for the service-account password.
$Credential = Get-Credential `
    -UserName $ServiceUser `
    -Message "Enter the password for the IIS application-pool service account"

# Create the application pool if it does not already exist.
if (-not (Test-Path "IIS:\AppPools\$AppPoolName")) {
    New-WebAppPool -Name $AppPoolName
    Write-Host "Created application pool: $AppPoolName"
}
else {
    Write-Host "Application pool already exists: $AppPoolName"
}

# Stop it before changing the process identity.
Stop-WebAppPool -Name $AppPoolName -ErrorAction SilentlyContinue

# Configure the custom service-account identity.
Set-ItemProperty "IIS:\AppPools\$AppPoolName" `
    -Name processModel.identityType `
    -Value 3

Set-ItemProperty "IIS:\AppPools\$AppPoolName" `
    -Name processModel.userName `
    -Value $Credential.UserName

Set-ItemProperty "IIS:\AppPools\$AppPoolName" `
    -Name processModel.password `
    -Value $Credential.GetNetworkCredential().Password

# Recommended when the application requires the service account's user profile.
Set-ItemProperty "IIS:\AppPools\$AppPoolName" `
    -Name processModel.loadUserProfile `
    -Value $true

# Use "v4.0" for .NET Framework applications.
Set-ItemProperty "IIS:\AppPools\$AppPoolName" `
    -Name managedRuntimeVersion `
    -Value "v4.0"

Start-WebAppPool -Name $AppPoolName

Write-Host "Application pool '$AppPoolName' is configured to run as '$ServiceUser'."
