# --- Quick reachability check (no identifiers) ---
Function Test-IdentityPreflight {
  param([Parameter(Mandatory)][string]$TenantUrl)
  try {
    $url = $TenantUrl.TrimEnd('/') + "/.well-known/openid-configuration"
    $r = Invoke-WebRequest -Uri $url -Method Head -TimeoutSec 12 -ErrorAction Stop
    Write-Log "Identity endpoint reachable." "Green"
    if ($r.Headers.Date) {
      $srv = [DateTime]::Parse($r.Headers.Date).ToUniversalTime()
      $loc = (Get-Date).ToUniversalTime()
      $skew = [math]::Round(($loc - $srv).TotalSeconds,0)
      if ([math]::Abs($skew) -gt 300) { Write-Log "Clock skew > 5 min; sync time." "Yellow" }
    }
  } catch { Write-Log "Identity endpoint not reachable." "Red"; throw }
}

# --- CCP: pull secret -> secure PSCredential ($Cred) ---
Function Get-CCPCredentialByObject {
  param([Parameter(Mandatory)][string]$ObjectName,[Parameter(Mandatory)][string]$UPUser)
  try {
    $url  = "$CCPAddress/$Location/api/Accounts?AppID=$AppID&Safe=$SafeForCCP&Object=$ObjectName"
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $Headers -UseDefaultCredentials:$WindowsAuth
    if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
    $sec  = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $Cred = [PSCredential]::new($UPUser, $sec)
    $resp.Content = $null; Remove-Variable sec -ErrorAction SilentlyContinue
    Write-Log "Credential retrieved securely." "Green"
    return $Cred
  } catch { Write-Log "Credential retrieval failed." "Red"; throw }
}

# --- Establish PAS session via Identity (no Get-IdentityHeader needed) ---
Function Start-PASSession_IdentityUser {
  param([Parameter(Mandatory)][pscredential]$Cred)
  Test-IdentityPreflight -TenantUrl $IdentityTenantURL | Out-Null
  try {
    # psPAS handles Identity auth internally when -IdentityUser is supplied (requires IdentityCommand installed)
    New-PASSession -IdentityTenantURL $IdentityTenantURL -PrivilegeCloudURL $PrivilegeCloudURL -Credential $Cred -IdentityUser | Out-Null
    if (-not (Get-PASSession)) { throw "Session not established" }
    Write-Log "PAS session established (IdentityUser)." "Green"
  } catch {
    $msg = $_.Exception.Message
    switch -Regex ($msg) {
      '401|unauthori'                                    { Write-Log "Identity auth rejected (policy/creds/MFA)." "Red"; break }
      '404|not\s*found|tenant|subdomain'                 { Write-Log "Tenant/URL mismatch." "Red"; break }
      'TLS|certificate|SSL'                              { Write-Log "TLS/certificate issue." "Red"; break }
      'NameResolutionFailure|No such host|resolved'      { Write-Log "DNS/Network issue." "Red"; break }
      'timed out|timeout'                                { Write-Log "Timeout contacting Identity." "Red"; break }
      default                                            { Write-Log "Identity login failed." "Red" }
    }
    throw
  }
}

