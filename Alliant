#requires -version 5.1
<#
.SYNOPSIS
  Targeted IIS ASP.NET CS0016 remediation for PAMHealthCheck.
.DESCRIPTION
  Isolates app-pool TEMP/TMP and ASP.NET compilation directory; does not touch parent IIS site, AIMWebService,
  global Windows Temp permissions, machine environment or authentication.
  Run elevated PowerShell 5.1. No IIS PowerShell provider required.
#>
[CmdletBinding(SupportsShouldProcess=$true, ConfirmImpact='Medium')]
param(
  [string]$SiteName='Default Web Site',
  [string]$AppAlias='PAMHealthCheck',
  [string]$PoolName='PAMHealthCheckPool',
  [string]$WebRoot='C:\inetpub\PAMDailyHealthCheck',
  [string]$DataRoot='C:\ProgramData\PAMDailyHealthCheck'
)
$ErrorActionPreference='Stop'
function Fail([string]$m){throw $m}
function RunNative([string]$exe,[string[]]$args){
  Write-Host ('> '+$exe+' '+($args -join ' '))
  $output = & $exe @args 2>&1
  $rc=$LASTEXITCODE
  if ($rc -ne 0){Fail ("Command failed ($rc): $exe $($args -join ' ')`n$($output -join [Environment]::NewLine)")}
  return ($output -join [Environment]::NewLine)
}
if(-not [Environment]::Is64BitProcess){
  Fail 'Use elevated 64-bit Windows PowerShell: C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe (not SysWOW64/PowerShell_ISE.exe).'
}
$admin=[Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if(-not $admin.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)){Fail 'Start PowerShell as Administrator.'}
$appcmd=Join-Path $env:windir 'System32\inetsrv\appcmd.exe'
if(-not (Test-Path -LiteralPath $appcmd)){Fail "Missing $appcmd"}
if(-not (Test-Path -LiteralPath (Join-Path $WebRoot 'web.config'))){Fail 'Portal web.config not found.'}
$appId="$SiteName/$AppAlias"
$appInfo=RunNative $appcmd @('list','app',"$appId")
if($appInfo -notmatch [regex]::Escape("applicationPool:$PoolName")){Fail "Portal not running in expected $PoolName : $appInfo"}
$poolInfo=RunNative $appcmd @('list','apppool',"$PoolName",'/text:*')
if($poolInfo -notmatch 'identityType:"ApplicationPoolIdentity"'){Fail 'Pool identity is not ApplicationPoolIdentity; stop and review manually.'}
if($poolInfo -notmatch 'RuntimeVersion:"v4.0"'){Fail 'Pool does not use CLR v4.0; stop and review manually.'}
$identity="IIS APPPOOL\$PoolName"
$now=Get-Date -Format 'yyyyMMdd-HHmmss'
$backupRoot=Join-Path $DataRoot ("ConfigBackups\CompilerIsolation-$now")
$tempRoot=Join-Path $DataRoot 'CompilerWorkTemp'
$compRoot=Join-Path $DataRoot ('CompilerOutput-'+$now)
$webConfig=Join-Path $WebRoot 'web.config'

function GrantModify([string]$path){
  if(-not (Test-Path -LiteralPath $path)){[void](New-Item -ItemType Directory -Force -Path $path)}
  # No grant to IIS_IUSRS or Everyone. Explicit app-pool identity only.
  RunNative "$env:windir\System32\icacls.exe" @($path,'/grant',("$($identity):(OI)(CI)M"),'/T','/C') | Out-Host
}
function SetPoolEnv([string]$name,[string]$value){
  $existing=RunNative $appcmd @('list','apppool',"$PoolName",'/text:*')
  # Existing variables might be set already. AppCmd set via collection replacement, not duplicate entry.
  if($existing -match ('(?m)^\s*name:"'+[regex]::Escape($name)+'"')){
    RunNative $appcmd @('set','config','-section:system.applicationHost/applicationPools',("/[name='$PoolName'].environmentVariables.[name='$name'].value:$value"),'/commit:apphost') | Out-Host
  } else {
    RunNative $appcmd @('set','config','-section:system.applicationHost/applicationPools',("/+[name='$PoolName'].environmentVariables.[name='$name',value='$value']"),'/commit:apphost') | Out-Host
  }
}
if ($PSCmdlet.ShouldProcess($appId,'Back up app config, set isolated ASP.NET compiler TEMP/TMP, recycle only dedicated app pool')) {
  New-Item -ItemType Directory -Path $backupRoot -Force | Out-Null
  Copy-Item -LiteralPath $webConfig -Destination (Join-Path $backupRoot 'web.config') -Force
  $apphost=Join-Path $env:windir 'System32\inetsrv\config\applicationHost.config'
  Copy-Item -LiteralPath $apphost -Destination (Join-Path $backupRoot 'applicationHost.config.reference-only') -Force
  RunNative $appcmd @('add','backup',"PAMHealthCheck-$now") | Out-Host
  GrantModify $tempRoot
  GrantModify $compRoot

  # Load application-pool service identity profile and inject scoped TEMP/TMP.
  RunNative $appcmd @('set','apppool',"$PoolName",'/processModel.loadUserProfile:true') | Out-Host
  SetPoolEnv 'TEMP' $tempRoot
  SetPoolEnv 'TMP' $tempRoot

  # Change only the compilation tempDirectory in this app's web.config.
  [xml]$doc=Get-Content -LiteralPath $webConfig -Raw
  $root=$doc.DocumentElement
  $sysWeb=$root.SelectSingleNode('system.web')
  if($null -eq $sysWeb){$sysWeb=$doc.CreateElement('system.web');[void]$root.AppendChild($sysWeb)}
  $comp=$sysWeb.SelectSingleNode('compilation')
  if($null -eq $comp){$comp=$doc.CreateElement('compilation');[void]$sysWeb.AppendChild($comp)}
  $comp.SetAttribute('tempDirectory',$compRoot)
  $doc.Save($webConfig)

  RunNative $appcmd @('recycle','apppool',"$PoolName") | Out-Host
  Write-Host "`nTargeted repair completed." -ForegroundColor Green
  Write-Host "App pool: $PoolName"
  Write-Host "Identity: $identity"
  Write-Host "Pool TEMP/TMP: $tempRoot"
  Write-Host "ASP.NET compilation: $compRoot"
  Write-Host "Backup: $backupRoot"
  Write-Host "IIS native backup: PAMHealthCheck-$now"
  Write-Host "Refresh https://<ccp-host>/$AppAlias/Default.aspx and read the newest ASP.NET event if it fails."
  Write-Host "If CS0016 persists with these permissions, inspect application-control/AV events or ProcMon; do not broaden system ACLs."
