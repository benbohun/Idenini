#requires -version 5.1
<#
Targeted ASP.NET CS0016 repair for PAMHealthCheck on Windows Server.
Run in elevated 64-bit Windows PowerShell 5.1.
This file does not change the parent site, AIMWebService, global TEMP, or authentication.
#>
[CmdletBinding()]
param(
    [string]$PoolName = 'PAMHealthCheckPool',
    [string]$SiteName = 'Default Web Site',
    [string]$AppAlias = 'PAMHealthCheck',
    [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck',
    [string]$DataRoot = 'C:\ProgramData\PAMDailyHealthCheck'
)

$ErrorActionPreference = 'Stop'

function Invoke-Native {
    param([string]$Executable, [string[]]$Arguments)
    $results = & $Executable @Arguments 2>&1
    $exitCode = $LASTEXITCODE
    if ($exitCode -ne 0) {
        throw ('Native command failed (exit ' + $exitCode + '): ' + $Executable + ' ' + ($Arguments -join ' ') + [Environment]::NewLine + ($results | Out-String))
    }
    return ($results | Out-String)
}

function Grant-PoolModify {
    param([string]$Directory, [string]$Principal)
    if (-not (Test-Path -LiteralPath $Directory -PathType Container)) {
        New-Item -ItemType Directory -Path $Directory -Force | Out-Null
    }
    $aclSpec = '{0}:(OI)(CI)M' -f $Principal
    Invoke-Native -Executable "$env:windir\System32\icacls.exe" -Arguments @($Directory, '/grant', $aclSpec, '/T') | Out-Null
}

if (-not [Environment]::Is64BitProcess) {
    throw 'This must run in 64-bit PowerShell. Open C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe as Administrator. Do not use SysWOW64 ISE.'
}

$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw 'Run PowerShell as Administrator.'
}

$appCmd = Join-Path $env:windir 'System32\inetsrv\appcmd.exe'
$webConfig = Join-Path $WebRoot 'web.config'
$appId = $SiteName + '/' + $AppAlias
$poolPrincipal = 'IIS APPPOOL\' + $PoolName

if (-not (Test-Path -LiteralPath $appCmd)) { throw 'IIS appcmd.exe not found.' }
if (-not (Test-Path -LiteralPath $webConfig)) { throw ('Missing ' + $webConfig) }

$appInfo = Invoke-Native -Executable $appCmd -Arguments @('list', 'app', $appId)
if ($appInfo -notlike ('*applicationPool:' + $PoolName + '*')) {
    throw ('The expected application pool was not found on this app: ' + $appInfo)
}

$poolInfo = Invoke-Native -Executable $appCmd -Arguments @('list', 'apppool', $PoolName, '/text:*')
if ($poolInfo -notmatch 'identityType:"ApplicationPoolIdentity"') {
    throw 'The pool is not using ApplicationPoolIdentity. No changes made.'
}

$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$backupDir = Join-Path $DataRoot ('ConfigBackups\CompilerRepair-' + $stamp)
$tempDir = Join-Path $DataRoot 'CompilerWorkTemp'
$compileDir = Join-Path $DataRoot ('CompilerOutput-' + $stamp)

New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
Copy-Item -LiteralPath $webConfig -Destination (Join-Path $backupDir 'web.config') -Force
Invoke-Native -Executable $appCmd -Arguments @('add', 'backup', ('PAMHC-' + $stamp)) | Out-Host

try {
    Grant-PoolModify -Directory $tempDir -Principal $poolPrincipal
    Grant-PoolModify -Directory $compileDir -Principal $poolPrincipal

    # Profile loading gives ASP.NET access to an isolated user profile.
    Invoke-Native -Executable $appCmd -Arguments @('set', 'apppool', $PoolName, '/processModel.loadUserProfile:true') | Out-Host

    # Scope TEMP and TMP to only this application pool, not the system.
    # These are added to IIS applicationHost.config by appcmd.
    $tempArg = '/+"[name=' + "'" + $PoolName + "'" + '].environmentVariables.[name=' + "'TEMP'" + ',value=' + "'" + $tempDir + "'" + ']"'
    $tmpArg  = '/+"[name=' + "'" + $PoolName + "'" + '].environmentVariables.[name=' + "'TMP'" + ',value=' + "'" + $tempDir + "'" + ']"'

    # Avoid duplicate variable insertion when rerun: inspect pool config first.
    $latestPool = Invoke-Native -Executable $appCmd -Arguments @('list', 'apppool', $PoolName, '/text:*')
    if ($latestPool -notmatch 'name:"TEMP"') {
        Invoke-Native -Executable $appCmd -Arguments @('set', 'config', '-section:system.applicationHost/applicationPools', $tempArg, '/commit:apphost') | Out-Host
    }
    if ($latestPool -notmatch 'name:"TMP"') {
        Invoke-Native -Executable $appCmd -Arguments @('set', 'config', '-section:system.applicationHost/applicationPools', $tmpArg, '/commit:apphost') | Out-Host
    }

    [xml]$doc = Get-Content -LiteralPath $webConfig -Raw
    $root = $doc.DocumentElement
    $systemWeb = $root.SelectSingleNode('system.web')
    if ($null -eq $systemWeb) {
        $systemWeb = $doc.CreateElement('system.web')
        [void]$root.AppendChild($systemWeb)
    }
    $compilation = $systemWeb.SelectSingleNode('compilation')
    if ($null -eq $compilation) {
        $compilation = $doc.CreateElement('compilation')
        [void]$systemWeb.AppendChild($compilation)
    }
    $compilation.SetAttribute('tempDirectory', $compileDir)
    $doc.Save($webConfig)

    Invoke-Native -Executable $appCmd -Arguments @('recycle', 'apppool', $PoolName) | Out-Host
    Write-Host 'Completed targeted compilation repair.' -ForegroundColor Green
    Write-Host ('Pool: ' + $PoolName)
    Write-Host ('Work TEMP/TMP: ' + $tempDir)
    Write-Host ('Compilation output: ' + $compileDir)
    Write-Host ('Backup: ' + $backupDir)
    Write-Host ('IIS backup: PAMHC-' + $stamp)
}
catch {
    Write-Error ('Repair stopped: ' + $_.Exception.Message)
    Write-Warning ('Backup is at ' + $backupDir)
    Write-Warning ('IIS backup name: PAMHC-' + $stamp)
    throw
}
