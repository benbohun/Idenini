$ServiceName = "CyberArkDPAConnector"
$TempFolder  = "C:\Temp"
$ExportPath  = "$TempFolder\EffectiveRights.inf"

if (-not (Test-Path $TempFolder)) {
    New-Item -Path $TempFolder -ItemType Directory -Force | Out-Null
}

# Get service SID
$SidOutput = sc.exe showsid $ServiceName

$ServiceSid = $null

foreach ($Line in $SidOutput) {
    if ($Line -match '(S-1-5-80-[0-9-]+)') {
        $ServiceSid = $Matches[1]
        break
    }
}

if (-not $ServiceSid) {
    Write-Host "ERROR: Could not determine service SID." -ForegroundColor Red
    exit 1
}

Write-Host ""
Write-Host "CyberArk service SID: $ServiceSid" -ForegroundColor Cyan
Write-Host ""

# Remove stale export if present
if (Test-Path $ExportPath) {
    Remove-Item $ExportPath -Force
}

# Export effective local security policy
Write-Host "Exporting effective User Rights Assignment..." -ForegroundColor Yellow

$SeceditOutput = & secedit.exe /export /cfg $ExportPath /areas USER_RIGHTS 2>&1

$SeceditOutput | ForEach-Object {
    Write-Host $_
}

if (-not (Test-Path $ExportPath)) {
    Write-Host ""
    Write-Host "ERROR: secedit did not create:" -ForegroundColor Red
    Write-Host $ExportPath -ForegroundColor Red
    Write-Host ""
    Write-Host "Make sure PowerShell is running as Administrator." -ForegroundColor Yellow
    exit 1
}

Write-Host ""
Write-Host "Export created successfully:" -ForegroundColor Green
Write-Host $ExportPath
Write-Host ""

$Rights = [ordered]@{
    "SeChangeNotifyPrivilege"       = "Bypass traverse checking"
    "SeCreateGlobalPrivilege"       = "Create global objects"
    "SeIncreaseWorkingSetPrivilege" = "Increase a process working set"
    "SeServiceLogonRight"           = "Log on as a service"
}

$Policy = Get-Content $ExportPath

foreach ($Right in $Rights.Keys) {

    $FriendlyName = $Rights[$Right]

    $Line = $Policy |
        Where-Object { $_ -match "^\s*$([regex]::Escape($Right))\s*=" } |
        Select-Object -First 1

    Write-Host "============================================================"

    if (-not $Line) {
        Write-Host "[NOT CONFIGURED] $FriendlyName" -ForegroundColor Yellow
        Write-Host "                 $Right"
        continue
    }

    Write-Host "$FriendlyName"
    Write-Host "$Line"
    Write-Host ""

    if ($Line -match [regex]::Escape($ServiceSid)) {
        Write-Host "[PASS] CyberArk service SID is present." -ForegroundColor Green
    }
    else {
        Write-Host "[FAIL] CyberArk service SID is NOT present." -ForegroundColor Red
    }
}

Write-Host "============================================================"
Write-Host ""
