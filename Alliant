# --- Utilities ---
Function Test-IdentityPreflight {
  param([Parameter(Mandatory)][string]$IdentityTenantUrl)
  try {
    $u = $IdentityTenantUrl.TrimEnd('/') + '/.well-known/openid-configuration'
    $r = Invoke-WebRequest -Uri $u -Method Head -TimeoutSec 12 -ErrorAction Stop
    Write-Log "Identity endpoint reachable." "Green"
    if ($r.Headers.Date) {
      $srv = [DateTime]::Parse($r.Headers.Date).ToUniversalTime()
      $loc = (Get-Date).ToUniversalTime()
      $skew = [math]::Round(($loc - $srv).TotalSeconds,0)
      if ([math]::Abs($skew) -gt 300) { Write-Log "Clock skew > 5 min; sync time." "Yellow" }
    }
  } catch { Write-Log "Identity endpoint not reachable." "Red"; throw }
}

Function Get-CCPCredentialByObject {
  param([Parameter(Mandatory)][string]$ObjectName,[Parameter(Mandatory)][string]$UPUser)
  try {
    $url  = "$CCPAddress/$Location/api/Accounts?AppID=$AppID&Safe=$SafeForCCP&Object=$ObjectName"
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $Headers -UseDefaultCredentials:$WindowsAuth
    if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
    $sec  = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $Cred = [PSCredential]::new($UPUser, $sec)
    $resp.Content = $null; Remove-Variable sec -ErrorAction SilentlyContinue
    Write-Log "Credential retrieved securely." "Green"
    return $Cred
  } catch { Write-Log "Credential retrieval failed." "Red"; throw }
}

# --- Resolve/Get Get-IdentityHeader, dot-source if necessary ---
Function Resolve-IdentityHeader {
  # direct names
  $candidates = @(
    'Get-IdentityHeader',
    'CyberArk.IdentityCommand\Get-IdentityHeader'
  )
  foreach ($n in $candidates) {
    $cmd = Get-Command $n -ErrorAction SilentlyContinue
    if ($cmd) { return $cmd }
  }

  # try dot-sourcing the function from module files (Public/Functions)
  $roots = @()
  if ($identityBase) { $roots += $identityBase }
  $roots += "$env:ProgramFiles\WindowsPowerShell\Modules\IdentityCommand"
  $roots += "$HOME\Documents\WindowsPowerShell\Modules\IdentityCommand"
  $roots = $roots | Where-Object { Test-Path $_ } | Select-Object -Unique

  foreach ($root in $roots) {
    $files = @()
    $files += Get-ChildItem -Path $root -Recurse -Filter *.ps1 -ErrorAction SilentlyContinue
    foreach ($f in $files) {
      try {
        $txt = Get-Content -Path $f.FullName -Raw -ErrorAction Stop
        if ($txt -match '(?im)^\s*function\s+Get-IdentityHeader\b') {
          . $f.FullName  # dot-source
          $cmd = Get-Command Get-IdentityHeader -ErrorAction SilentlyContinue
          if ($cmd) { Write-Log "Sourced Get-IdentityHeader from module files." "Green"; return $cmd }
        }
      } catch {}
    }
  }
  return $null
}

# --- Adaptive call (supports minor param name variations) ---
Function Invoke-IdentityHeaderAdaptive {
  param([Parameter(Mandatory)][pscredential]$Cred,[Parameter(Mandatory)][string]$TenantUrl,[Parameter(Mandatory)][string]$Subdomain)
  $cmd = Resolve-IdentityHeader
  if (-not $cmd) { Write-Log "Get-IdentityHeader cmdlet not found." "Red"; throw "Missing IdentityHeader cmdlet" }
  $p = $cmd.Parameters.Keys
  $args = @{}
  if ($p -contains 'IdentityTenantURL') { $args['IdentityTenantURL'] = $TenantUrl }
  elseif ($p -contains 'TenantURL')     { $args['TenantURL']        = $TenantUrl }
  if ($p -contains 'PCloudSubdomain')   { $args['PCloudSubdomain']  = $Subdomain }
  elseif ($p -contains 'Subdomain')     { $args['Subdomain']        = $Subdomain }
  if     ($p -contains 'UPCreds')       { $args['UPCreds']          = $Cred }
  elseif ($p -contains 'Credential')    { $args['Credential']       = $Cred }
  elseif ($p -contains 'UserName' -and $p -contains 'Password') { $args['UserName'] = $Cred.UserName; $args['Password'] = $Cred.Password }
  if ($p -contains 'psPASFormat')       { $args['psPASFormat']      = $true }
  try { return ,(& $cmd @args) } catch { $safe = $_.Exception.Message; Write-Log ("Identity error: {0}" -f $safe) "Red"; throw }
}

# --- Establish PAS session (Identity only) ---
Function Start-PASIdentitySession {
  param([Parameter(Mandatory)][pscredential]$Cred,[Parameter(Mandatory)][string]$TenantUrl,[Parameter(Mandatory)][string]$Subdomain)
  Test-IdentityPreflight -IdentityTenantUrl $TenantUrl | Out-Null
  $TenantUrl = $TenantUrl.TrimEnd('/')  # ensure normalized
  try {
    $Header = Invoke-IdentityHeaderAdaptive -Cred $Cred -TenantUrl $TenantUrl -Subdomain $Subdomain
    Use-PASSession $Header
    if (-not (Get-PASSession)) { throw "Session not established" }
    Write-Log "PAS session established." "Green"
  } catch { Write-Log "PAS session establishment failed." "Red"; throw }
}

