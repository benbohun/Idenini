# --- Utilities ---
Function Test-IdentityPreflight {
  param([Parameter(Mandatory)][string]$IdentityTenantUrl)
  try {
    $u = $IdentityTenantUrl.TrimEnd('/') + '/.well-known/openid-configuration'
    $r = Invoke-WebRequest -Uri $u -Method Head -TimeoutSec 12 -ErrorAction Stop
    Write-Log "Identity endpoint reachable." "Green"
    if ($r.Headers.Date) {
      $srv = [DateTime]::Parse($r.Headers.Date).ToUniversalTime()
      $loc = (Get-Date).ToUniversalTime()
      $skew = [math]::Round(($loc - $srv).TotalSeconds,0)
      if ([math]::Abs($skew) -gt 300) { Write-Log "Clock skew > 5 min; sync time." "Yellow" }
    }
  } catch { Write-Log "Identity endpoint not reachable." "Red"; throw }
}

Function Get-CCPCredentialByObject {
  param([Parameter(Mandatory)][string]$ObjectName,[Parameter(Mandatory)][string]$UPUser)
  try {
    $url  = "$CCPAddress/$Location/api/Accounts?AppID=$AppID&Safe=$SafeForCCP&Object=$ObjectName"
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $Headers -UseDefaultCredentials:$WindowsAuth
    if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
    $sec  = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $Cred = [PSCredential]::new($UPUser, $sec)
    $resp.Content = $null; Remove-Variable sec -ErrorAction SilentlyContinue
    Write-Log "Credential retrieved securely." "Green"
    return $Cred
  } catch { Write-Log "Credential retrieval failed." "Red"; throw }
}

# --- Try to find any IdentityHeader cmdlet (optional path) ---
Function Resolve-IdentityHeader {
  $names = @(
    'Get-IdentityHeader',
    'CyberArk.IdentityCommand\Get-IdentityHeader',
    'Get-PASIdentityHeader',
    'New-IdentityHeader',
    'New-PASIdentityHeader'
  )
  foreach ($n in $names) { $c = Get-Command $n -ErrorAction SilentlyContinue; if ($c) { return $c } }
  $mods = @('psPAS','IdentityCommand')
  $cands = Get-Command -Module $mods -ErrorAction SilentlyContinue | Where-Object { $_.Name -match 'Identity' -and $_.Name -match 'Header' }
  if ($cands) { return $cands | Select-Object -First 1 }
  return $null
}

# --- Establish session: prefer IdentityHeader if available; otherwise PVWA direct login ---
Function Start-PASSession {
  param([Parameter(Mandatory)][pscredential]$Cred)

  Test-IdentityPreflight -IdentityTenantUrl $IdentityTenantUrl | Out-Null

  $idCmd = Resolve-IdentityHeader
  if ($idCmd) {
    try {
      Write-Log "Attempting Identity-based session..." "Gray"
      $p = $idCmd.Parameters.Keys
      $args = @{}
      if ($p -contains 'IdentityTenantURL') { $args['IdentityTenantURL'] = $IdentityTenantUrl } elseif ($p -contains 'TenantURL') { $args['TenantURL'] = $IdentityTenantUrl }
      if ($p -contains 'PCloudSubdomain')   { $args['PCloudSubdomain']   = $PCloudSubdomain }   elseif ($p -contains 'Subdomain') { $args['Subdomain'] = $PCloudSubdomain }
      if     ($p -contains 'UPCreds')       { $args['UPCreds']           = $Cred }
      elseif ($p -contains 'Credential')    { $args['Credential']        = $Cred }
      elseif ($p -contains 'UserName' -and $p -contains 'Password') { $args['UserName'] = $Cred.UserName; $args['Password'] = $Cred.Password }
      if ($p -contains 'psPASFormat')       { $args['psPASFormat']       = $true }

      $hdr = & $idCmd @args
      Use-PASSession $hdr
      if (-not (Get-PASSession)) { throw "Session not established" }
      Write-Log "PAS session established (Identity)." "Green"
      return
    } catch {
      Write-Log "Identity path failed; trying PVWA direct login..." "Yellow"
    }
  } else {
    Write-Log "Identity cmdlet not found; using PVWA direct login..." "Yellow"
  }

  try {
    # Direct PVWA (Privilege Cloud) login with psPAS
    # psPAS supports: New-PASSession -Credential $Cred -BaseURI $PVWAUrl
    New-PASSession -Credential $Cred -BaseURI $PVWAUrl | Out-Null
    if (-not (Get-PASSession)) { throw "Session not established" }
    Write-Log "PAS session established (PVWA direct)." "Green"
  } catch {
    $msg = $_.Exception.Message
    switch -Regex ($msg) {
      '401|unauthori'                                    { Write-Log "PVWA auth rejected." "Red"; break }
      '404|not\s*found|baseuri'                          { Write-Log "PVWA URL issue." "Red"; break }
      'TLS|certificate|SSL'                              { Write-Log "PVWA TLS/certificate issue." "Red"; break }
      'NameResolutionFailure|No such host|resolved'      { Write-Log "PVWA DNS/Network issue." "Red"; break }
      'timed out|timeout'                                { Write-Log "PVWA timeout." "Red"; break }
      default                                            { Write-Log "PVWA login failed." "Red" }
    }
    throw
  }
}

