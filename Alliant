{
  "artifact_type": "CyberArkIdentityWebAppDeployment",
  "schema_version": "1.0",
  "name": "PAM Hygiene Engine - WPM",
  "description": "Identity/WPM launcher for the IDIRA Privileged Account Hygiene Engine. Designed for a Web OpenID Connect + Provisioning application.",
  "deployment_order": 1,
  "identity_api": {
    "operation": "import_webapp_from_template",
    "template_name": "__WEB_OPENID_CONNECT_PROVISIONING_TEMPLATE_NAME__",
    "webapp_name": "PAM Privileged Account Hygiene",
    "service_name": "PAM Privileged Account Hygiene",
    "description": "Launch the report-only PAM Privileged Account Hygiene Engine from WPM.",
    "url": "__FLOW_BROWSER_LAUNCH_URL__",
    "mobile_url": "__FLOW_BROWSER_LAUNCH_URL__",
    "webapp_login_type": "OpenIDConnect",
    "bypass_login_mfa": false,
    "oauth_profile": {
      "token_type": "JwtRS256",
      "token_lifetime_string": "0.05:00:00",
      "allowed_auth": [
        "AuthorizationCode"
      ],
      "known_scopes": [
        {
          "scope": "openid",
          "description": "OpenID Connect"
        },
        {
          "scope": "profile",
          "description": "Basic profile"
        },
        {
          "scope": "email",
          "description": "Email"
        }
      ],
      "allow_refresh": false
    },
    "open_id_connect_script": "__USE_TARGET_TENANT_TEMPLATE_DEFAULT__"
  },
  "portal_assignment": {
    "publish_to": [
      {
        "principal": "__PAM_HYGIENE_USERS_OR_ROLE__",
        "principal_type": "Role",
        "rights": [
          "View",
          "Execute"
        ]
      }
    ],
    "note": "Replace with the intended WPM role/group before production."
  },
  "flow_linkage": {
    "flow_name": "PAM-Hygiene-Engine-v1",
    "flow_browser_oidc_field": "aapilets.apiconnection.run.browser.oidcid",
    "post_identity_import_action": "Capture the created Identity webapp row-key/app ID and replace __IDENTITY_WEBAPP_ID__ in PAM-Hygiene-Engine.flow.json before importing/saving the Flow.",
    "flow_launch_url_placeholder": "__FLOW_BROWSER_LAUNCH_URL__"
  },
  "security": {
    "contains_secrets": false,
    "embed_client_secret": false,
    "embed_access_token": false,
    "minimum_portal_right": "Execute",
    "flow_mode": "REPORT_ONLY"
  },
  "tenant_placeholders": {
    "identity_tenant_host": "__IDENTITY_TENANT_HOST__",
    "flows_host": "__FLOWS_HOST__",
    "privilege_cloud_host": "__PRIVILEGE_CLOUD_HOST__"
  },
  "important": [
    "This is an Identity web-app deployment payload, not a Flows export.",
    "CyberArk Identity creates the webapp ID during import/creation; map that ID into the Flow oidcid field.",
    "Resolve the exact Web OpenID Connect + Provisioning template name from the target tenant catalog/API before deployment.",
    "Do not place client secrets, service-user passwords, or bearer tokens in this file."
  ]
}
