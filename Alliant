      "dataStore-definition-2100999000": {
        "dataStore-map-values": {
          "data": [
            {
              "_id": "MID-HYGIENE-POLICY-DATA",
              "ref": "text",
              "value": "{\"schemaVersion\":\"1.0\",\"engine\":{\"name\":\"IDIRA Privileged Account Hygiene Engine\",\"version\":\"1.0.0\",\"mode\":\"REPORT_ONLY\",\"description\":\"Nightly read-only Privilege Cloud hygiene assessment. No password retrieval and no remediation operations.\",\"defaultSchedule\":{\"enabled\":false,\"cadence\":\"daily\",\"localTime\":\"01:00\",\"timezone\":\"CONFIGURE_IN_FLOWS_TENANT\"}},\"safety\":{\"allowedHttpMethods\":[\"GET\"],\"retrieveSecrets\":false,\"triggerCpmOperations\":false,\"modifyAccounts\":false,\"modifySafes\":false,\"modifySafeMemberships\":false},\"inventory\":{\"accountsPageSize\":1000,\"safesPageSize\":100,\"safeMembersPageSize\":1000,\"discoveredAccountsPageSize\":1000,\"paginationRequired\":true},\"executionStrategy\":{\"phaseA\":\"Inventory and low-cost checks\",\"phaseB\":\"Safe and membership governance checks\",\"phaseC\":\"Candidate-only account activity checks\",\"phaseD\":\"Aggregate findings and report\",\"notes\":[\"Do not call account activity for every account. Only query activity after an account becomes a stale/verification candidate.\",\"Account activities are not server-side filterable in the current IDSEC SDK implementation, so candidate reduction materially reduces API load.\"]},\"rules\":{\"HYG-001\":{\"name\":\"Stale account\",\"enabled\":true,\"severity\":\"Medium\",\"thresholdDays\":90,\"requires\":[\"accounts\",\"accountActivities\"],\"logic\":\"Account must be older than threshold and have no qualifying use/access activity within threshold.\",\"qualifyingActionContains\":[\"Show\",\"Retrieve\",\"Copy\",\"PSM\",\"Connect\"],\"caution\":\"Do not use secretManagement.lastModifiedTime as a proxy for account usage. Tune qualifying activities for human versus service accounts.\"},\"HYG-002\":{\"name\":\"CPM management disabled\",\"enabled\":true,\"severity\":\"High\",\"requires\":[\"accounts\"],\"logic\":\"secretManagement.automaticManagementEnabled == false and no approved exception matches.\",\"approvedManualManagementReasons\":[],\"approvedPlatformIds\":[],\"approvedSafeNames\":[]},\"HYG-003\":{\"name\":\"Overdue verification\",\"enabled\":true,\"severity\":\"High\",\"requires\":[\"accounts\",\"platforms\",\"accountActivities\"],\"logic\":\"Platform requires periodic verification and no successful qualifying verification activity is present within the platform verification interval.\",\"verificationActionContains\":[\"Verify\",\"verification\"],\"usePlatformInterval\":true},\"HYG-004\":{\"name\":\"Missing owner\",\"enabled\":false,\"severity\":\"High\",\"requires\":[\"safes\",\"safeMembers\",\"tenantOwnerPolicy\"],\"logic\":\"Safe has no qualifying owner member according to tenant owner policy.\",\"configurationRequired\":true,\"ownerMemberNameRegex\":\"CONFIGURE\",\"minimumQualifyingOwners\":1,\"notes\":\"Enable only after defining what constitutes an owner (group naming, explicit list, or permission-based policy).\"},\"HYG-005\":{\"name\":\"Account in inappropriate Safe\",\"enabled\":true,\"severity\":\"High\",\"requires\":[\"accounts\",\"platforms\"],\"logic\":\"Account Safe violates the assigned platform AllowedSafes policy; optional organization mapping may add stricter checks.\",\"organizationSafeMappingEnabled\":false},\"HYG-006\":{\"name\":\"Platform mismatch\",\"enabled\":true,\"severity\":\"High\",\"requires\":[\"accounts\",\"platforms\"],\"logic\":\"Platform does not exist, is inactive, Safe is not allowed, or required tenant platform/account constraints do not match.\",\"cmdbOsValidationEnabled\":false,\"notes\":\"Operating-system mismatch needs an external authoritative source such as CMDB.\"},\"HYG-007\":{\"name\":\"Duplicate account\",\"enabled\":true,\"severity\":\"Medium\",\"requires\":[\"accounts\"],\"logic\":\"Normalized username + normalized address appears more than once outside approved duplicate exceptions.\",\"normalization\":{\"username\":[\"trim\",\"lowercase\"],\"address\":[\"trim\",\"lowercase\",\"removeTrailingDot\"]},\"approvedDuplicateSafePairs\":[],\"approvedDuplicatePlatformPairs\":[]},\"HYG-008\":{\"name\":\"Discovery account awaiting onboarding\",\"enabled\":false,\"severity\":\"Medium\",\"thresholdDays\":7,\"requires\":[\"discoveredAccounts\"],\"logic\":\"Pending/discovered account remains awaiting onboarding beyond threshold.\",\"configurationRequired\":true,\"notes\":\"Enable after validating the discovered-accounts endpoint and the least-privilege identity/service account permitted to call it in this tenant.\"},\"HYG-009\":{\"name\":\"Invalid Safe naming\",\"enabled\":false,\"severity\":\"Medium\",\"requires\":[\"safes\",\"tenantSafeNamingPolicy\"],\"logic\":\"Safe name does not match approved tenant naming conventions.\",\"configurationRequired\":true,\"allowedRegex\":[],\"excludedExactNames\":[],\"excludedRegex\":[],\"notes\":\"Enable only after adding your production Safe naming standards.\"},\"HYG-010\":{\"name\":\"Invalid APP code\",\"enabled\":false,\"severity\":\"Medium\",\"requires\":[\"accounts\",\"safes\",\"authoritativeAppInventory\"],\"logic\":\"Extracted application code does not exist or is not active in the authoritative application inventory.\",\"configurationRequired\":true,\"appCodeExtractionRegex\":\"CONFIGURE\",\"source\":{\"type\":\"CONFIGURE\",\"uriOrConnector\":\"CONFIGURE\"}},\"HYG-011\":{\"name\":\"Expired Safe access\",\"enabled\":true,\"severity\":\"High\",\"requires\":[\"safeMembers\"],\"logic\":\"Safe member has expired membership enabled and membership expiration date is in the past.\"},\"HYG-012\":{\"name\":\"Orphaned Safe membership\",\"enabled\":false,\"severity\":\"High\",\"requires\":[\"safeMembers\",\"identityResolver\"],\"logic\":\"Non-predefined Safe member no longer resolves to an authoritative Identity user/group.\",\"configurationRequired\":true,\"ignorePredefinedUsers\":true,\"identityResolver\":\"CONFIGURE_IDIRA_IDENTITY_CONNECTOR\"}},\"reporting\":{\"formats\":[\"JSON\",\"CSV\"],\"includePassingEntities\":false,\"includeSecrets\":false,\"summaryFields\":[\"runId\",\"startedAt\",\"completedAt\",\"accountsEvaluated\",\"safesEvaluated\",\"membershipsEvaluated\",\"totalFindings\",\"findingsBySeverity\",\"findingsByRule\"]}}"
            }
