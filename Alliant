#Requires -Version 5.1
<#
.SYNOPSIS
  Diagnoses persistent CS0016 for PAMHealthCheck without changing AIMWebService.
.DESCRIPTION
  Default mode is read-only. -Apply creates a fresh private ASP.NET compilation
  directory, grants only the IIS application pool identity Modify to that directory,
  and changes only PAMHealthCheck/web.config. Backs up web.config and ACL report.
  Never edits Windows Temp ACLs, security products, IIS auth, or other app pools.
.EXAMPLE
  .\Repair-PAMHealthCheck-Deep-CS0016.ps1
.EXAMPLE
  .\Repair-PAMHealthCheck-Deep-CS0016.ps1 -Apply
#>
[CmdletBinding()]
param(
 [switch]$Apply,
 [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck',
 [string]$PoolName = 'PAMHealthCheckPool',
 [string]$DataRoot = 'C:\ProgramData\PAMDailyHealthCheck'
)
$ErrorActionPreference='Stop'
$logDir = Join-Path $DataRoot 'Diagnostics'
New-Item -ItemType Directory -Path $logDir -Force | Out-Null
$stamp=Get-Date -Format 'yyyyMMdd-HHmmss'
$report=Join-Path $logDir "Deep-CS0016-$stamp.txt"
Start-Transcript -Path $report -Force | Out-Null
function Section($name) { Write-Host "`n==== $name ====" -ForegroundColor Cyan }
function Show-Acls($path) {
 Write-Host "Path: $path"
 if (Test-Path -LiteralPath $path) {
  & "$env:WINDIR\System32\icacls.exe" $path 2>&1 | Out-Host
  try { $a=Get-Acl -LiteralPath $path; Write-Host "Owner: $($a.Owner) InheritanceProtected: $($a.AreAccessRulesProtected)";
    $a.Access | Where-Object {$_.AccessControlType -eq 'Deny'} | Format-Table IdentityReference,FileSystemRights,IsInherited -AutoSize | Out-Host
  } catch { Write-Warning $_.Exception.Message }
 } else { Write-Warning 'Path absent' }
}
function Get-ToolPath($name) {
 $native=Join-Path $env:WINDIR "System32\inetsrv\$name"
 if (Test-Path $native) { return $native }
 $sysnative=Join-Path $env:WINDIR "Sysnative\inetsrv\$name"
 if (Test-Path $sysnative) { return $sysnative }
 return $null
}
try {
 Section 'Environment'
 Write-Host "Computer=$env:COMPUTERNAME User=$env:USERNAME 64bit=$([Environment]::Is64BitProcess) PS=$($PSVersionTable.PSVersion)"
 $configPath=Join-Path $WebRoot 'web.config'
 if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) { throw "Missing $configPath" }
 [xml]$xml=Get-Content -LiteralPath $configPath -Raw
 $comp=$xml.SelectSingleNode('/configuration/system.web/compilation')
 $compilePath = if ($comp) {$comp.GetAttribute('tempDirectory')} else {''}
 Write-Host "WebRoot=$WebRoot"
 Write-Host "ConfiguredCompilationDir=$compilePath"
 Write-Host "Machine TEMP=$([Environment]::GetEnvironmentVariable('TEMP','Machine'))"
 Write-Host "Machine TMP=$([Environment]::GetEnvironmentVariable('TMP','Machine'))"
 Section 'IIS app pool settings'
 $appcmd=Get-ToolPath 'appcmd.exe'
 if ($appcmd) {
  & $appcmd list app "Default Web Site/PAMHealthCheck" 2>&1 | Out-Host
  & $appcmd list apppool "$PoolName" /text:* 2>&1 | Out-Host
 } else { Write-Warning 'appcmd unavailable; cannot verify pool identity.' }
 Section 'ACL inspection (read-only)'
 Show-Acls $WebRoot
 Show-Acls $DataRoot
 if ($compilePath) { Show-Acls $compilePath; Show-Acls (Join-Path $compilePath 'pamhealthcheck') }
 Show-Acls (Join-Path $env:WINDIR 'Temp')
 Show-Acls (Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\Temporary ASP.NET Files')
 Section 'ASP.NET impersonation'
 $identityNode=$xml.SelectSingleNode('/configuration/system.web/identity')
 if ($identityNode) {Write-Host "impersonate=$($identityNode.GetAttribute('impersonate'))"} else { Write-Host 'No explicit ASP.NET impersonation' }
 Section 'Current compilation failures'
 try {
  Get-WinEvent -FilterHashtable @{LogName='Application'; StartTime=(Get-Date).AddHours(-4)} -ErrorAction Stop |
    Where-Object {$_.ProviderName -eq 'ASP.NET 4.0.30319.0' -and $_.Id -eq 1310 -and $_.Message -match '/PAMHealthCheck'} |
    Select-Object -First 5 TimeCreated, @{N='Failure';E={if ($_.Message -match '(?s)Exception message: (.*?)(?:\s+at System\.Web|\s+Request information:)') {$matches[1]} else {$_.Message.Substring(0,[Math]::Min(800,$_.Message.Length))}}} |
    Format-List | Out-Host
 } catch {Write-Warning "Could not query events: $($_.Exception.Message)"}
 Section 'Security policy signals (read-only)'
 foreach ($reg in @('HKLM:\SOFTWARE\Policies\Microsoft\Windows\Safer\CodeIdentifiers','HKLM:\SYSTEM\CurrentControlSet\Control\CI\Policy')) {
  Write-Host "$reg present: $(Test-Path $reg)"
 }
 try { Get-MpPreference -ErrorAction Stop | Select-Object -ExpandProperty EnableControlledFolderAccess | Out-Host } catch {Write-Host 'Microsoft Defender configuration not available (other endpoint controls may still apply).'}
 if ($Apply) {
  Section 'Scoped remediation'
  $me=[Security.Principal.WindowsIdentity]::GetCurrent()
  $wp=New-Object Security.Principal.WindowsPrincipal($me)
  if (-not $wp.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {throw 'Apply requires elevated PowerShell.'}
  if (-not $appcmd) {throw 'Cannot safely verify IIS application and pool without appcmd.'}
  $appText=(& $appcmd list app 'Default Web Site/PAMHealthCheck' 2>&1 | Out-String)
  $poolText=(& $appcmd list apppool "$PoolName" /text:* 2>&1 | Out-String)
  if ($LASTEXITCODE -ne 0 -or $appText -notmatch [regex]::Escape('Default Web Site/PAMHealthCheck') -or $appText -notmatch [regex]::Escape("applicationPool:$PoolName")) {throw 'Application/pool mismatch; refusing to change settings.'}
  if ($poolText -notmatch '(?im)^\s*processModel\.identityType:\s*ApplicationPoolIdentity\s*$') {
   throw 'Pool identity is not confirmed as ApplicationPoolIdentity. Review diagnostic output; no changes made.'
  }
  $base=Join-Path $DataRoot 'ASPNetCompile-Isolated'
  $fresh=Join-Path $base "compile-$stamp"
  $backup=Join-Path $logDir "web.config-$stamp.bak"
  Copy-Item -LiteralPath $configPath -Destination $backup -ErrorAction Stop
  Write-Host "web.config backup=$backup"
  New-Item -ItemType Directory -Path $fresh -Force -ErrorAction Stop | Out-Null
  $principal="IIS APPPOOL\$PoolName"
  & "$env:WINDIR\System32\icacls.exe" $fresh /grant "${principal}:(OI)(CI)M" 2>&1 | Out-Host
  if ($LASTEXITCODE -ne 0) {throw 'icacls grant failed; web.config unchanged.'}
  # Parent must be traversable; existing inherited denies are reported above and not removed.
  Show-Acls $fresh
  if (-not $comp) {
    $sw=$xml.SelectSingleNode('/configuration/system.web')
    if (-not $sw) {throw 'system.web missing; refuse to rewrite config.'}
    $comp=$xml.CreateElement('compilation')
    [void]$sw.AppendChild($comp)
  }
  $comp.SetAttribute('tempDirectory',$fresh)
  try {$xml.Save($configPath)} catch {Copy-Item $backup $configPath -Force; throw}
  Write-Host "Compilation redirected to $fresh" -ForegroundColor Green
  Write-Host 'Only web.config and private compilation folder were changed. No IISRESET performed.'
  Write-Host 'If CS0016 persists, investigate C:\Windows\Temp or endpoint/application-control denials using ProcMon with security team.' -ForegroundColor Yellow
 }
 Section 'Result'
 Write-Host "Report=$report"
 if (-not $Apply) { Write-Host 'Read-only check complete. Re-run with -Apply only after reviewing findings.' }
} catch {
 Write-Host "FAILED: $($_.Exception.Message)" -ForegroundColor Red
 throw
} finally {
 Stop-Transcript | Out-Null
 Write-Host "Saved diagnostic transcript: $report"
}
