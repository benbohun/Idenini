<#
.SYNOPSIS
  Non-interactive CyberArk Identity → Privilege Cloud Login Test (psPAS)

.DESCRIPTION
  - Imports psPAS and IdentityCommand first
  - Loads credentials with NO prompts:
      1) Preferred: encrypted PSCredential file (Export-Clixml)
      2) Fallback: environment variable password
  - Uses New-PASSession IdentityUser flow
  - Prints SUCCESS/FAIL and basic session details

.REQUIREMENTS
  - psPAS and IdentityCommand modules installed
  - Network access to Identity & Privilege Cloud endpoints
  - Credential file created OR environment variable set
#>

Clear-Host

Write-Host "==================================================" -ForegroundColor Cyan
Write-Host " CyberArk Identity → Privilege Cloud Login Test" -ForegroundColor Cyan
Write-Host " (Non-Interactive / No Prompt)" -ForegroundColor Cyan
Write-Host "==================================================" -ForegroundColor Cyan
Write-Host ""

# ==========================
# CONFIG – EDIT THESE
# ==========================
$IdentityTenantURL = "https://aak4521.my.idaptive.app"
$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud"

# Preferred encrypted credential file path
$CredFilePath = "C:\Secure\CyberArkIdentity.cred.xml"

# Fallback Identity username + env var password name
# Used only if the cred file is missing/unreadable
$FallbackIdentityUser = "bakinbohun@alliantcreditunion.com"
$FallbackPasswordEnv  = "CYB_ID_PWD"

Write-Host "[INFO] IdentityTenantURL   : $IdentityTenantURL"  -ForegroundColor DarkCyan
Write-Host "[INFO] PrivilegeCloudURL  : $PrivilegeCloudURL"   -ForegroundColor DarkCyan
Write-Host "[INFO] Cred File Path     : $CredFilePath"        -ForegroundColor DarkCyan
Write-Host "[INFO] Fallback User      : $FallbackIdentityUser" -ForegroundColor DarkCyan
Write-Host "[INFO] Fallback Env Var   : $FallbackPasswordEnv" -ForegroundColor DarkCyan
Write-Host ""

# ==========================
# IMPORT MODULES FIRST
# ==========================
try {
    Write-Host "[+] Importing psPAS module..." -ForegroundColor Yellow
    Import-Module psPAS -ErrorAction Stop
    Write-Host "[OK] psPAS module imported." -ForegroundColor Green
}
catch {
    Write-Host "[ERROR] Failed to import psPAS module: $($_.Exception.Message)" -ForegroundColor Red
    Write-Host "       Install with: Install-Module psPAS" -ForegroundColor Red
    exit 1
}

try {
    Write-Host "[+] Importing IdentityCommand module..." -ForegroundColor Yellow
    Import-Module IdentityCommand -ErrorAction Stop
    Write-Host "[OK] IdentityCommand module imported." -ForegroundColor Green
}
catch {
    Write-Host "[ERROR] Failed to import IdentityCommand module: $($_.Exception.Message)" -ForegroundColor Red
    Write-Host "       Install with: Install-Module IdentityCommand" -ForegroundColor Red
    exit 1
}

# ==========================
# LOAD CREDENTIALS (NO PROMPTS)
# ==========================
$cred = $null

# 1) Preferred: encrypted credential file
if (Test-Path $CredFilePath) {
    try {
        Write-Host "`n[+] Loading encrypted credential file..." -ForegroundColor Yellow
        $cred = Import-Clixml $CredFilePath

        if (-not $cred -or [string]::IsNullOrWhiteSpace($cred.UserName)) {
            throw "Credential file loaded but appears invalid."
        }

        Write-Host "[OK] Credential file loaded for user: $($cred.UserName)" -ForegroundColor Green
    }
    catch {
        Write-Host "[WARN] Failed to load credential file: $($_.Exception.Message)" -ForegroundColor DarkYellow
        $cred = $null
    }
}
else {
    Write-Host "`n[WARN] Credential file not found: $CredFilePath" -ForegroundColor DarkYellow
}

# 2) Fallback: environment variable password (FIXED)
if (-not $cred) {
    try {
        Write-Host "[+] Attempting fallback credential method (env var)..." -ForegroundColor Yellow

        # Try Machine scope then User scope
        $plain = [Environment]::GetEnvironmentVariable($FallbackPasswordEnv, "Machine")
        if ([string]::IsNullOrWhiteSpace($plain)) {
            $plain = [Environment]::GetEnvironmentVariable($FallbackPasswordEnv, "User")
        }

        if ([string]::IsNullOrWhiteSpace($plain)) {
            throw "Environment variable '$FallbackPasswordEnv' is not set (Machine/User)."
        }

        $sec  = ConvertTo-SecureString $plain -AsPlainText -Force
        $cred = [PSCredential]::new($FallbackIdentityUser, $sec)

        Write-Host "[OK] Fallback credential loaded for user: $FallbackIdentityUser" -ForegroundColor Green
    }
    catch {
        Write-Host "`n[ERROR] Could not load credentials from file or env var." -ForegroundColor Red
        Write-Host "        $($_.Exception.Message)" -ForegroundColor Red
        Write-Host ""
        Write-Host "Fix options:" -ForegroundColor Yellow
        Write-Host "  A) Create credential file (recommended) as the SAME run account:" -ForegroundColor Yellow
        Write-Host "     New-Item -ItemType Directory -Path 'C:\Secure' -Force | Out-Null" -ForegroundColor Yellow
        Write-Host "     Get-Credential | Export-Clixml '$CredFilePath'" -ForegroundColor Yellow
        Write-Host ""
        Write-Host "  B) Set fallback env var (Machine scope):" -ForegroundColor Yellow
        Write-Host "     [Environment]::SetEnvironmentVariable('$FallbackPasswordEnv','<password>','Machine')" -ForegroundColor Yellow
        exit 1
    }
}

# ==========================
# AUTHENTICATE VIA IDENTITY
# ==========================
try {
    Write-Host "`n[+] Requesting session using Identity + Privilege Cloud..." -ForegroundColor Yellow
    Write-Host "    IdentityTenantURL : $IdentityTenantURL"  -ForegroundColor DarkGray
    Write-Host "    PrivilegeCloudURL: $PrivilegeCloudURL"   -ForegroundColor DarkGray
    Write-Host "    Identity User    : $($cred.UserName)"    -ForegroundColor DarkGray
    Write-Host ""

    New-PASSession `
        -IdentityTenantURL  $IdentityTenantURL `
        -PrivilegeCloudURL  $PrivilegeCloudURL `
        -Credential         $cred `
        -IdentityUser `
        -ErrorAction Stop | Out-Null

    # Validate session
    $session = Get-PASSession

    if ($session) {
        Write-Host "==================================================" -ForegroundColor Green
        Write-Host " ✅ Authentication SUCCESSFUL" -ForegroundColor Green
        Write-Host "==================================================" -ForegroundColor Green

        # Optional: attempt to show logged-on user
        try {
            $user = Get-PASLoggedOnUser -ErrorAction SilentlyContinue
            if ($user) {
                Write-Host "`n[Session Info]" -ForegroundColor Cyan
                $user | Format-Table UserName, Source, UserTypeName, Expired, Disabled, Suspended -AutoSize
            }
            else {
                Write-Host "[INFO] Session established. Get-PASLoggedOnUser returned no data (can be normal in some Identity flows)." -ForegroundColor DarkYellow
            }
        }
        catch {
            Write-Host "[WARN] Session established but could not query Get-PASLoggedOnUser: $($_.Exception.Message)" -ForegroundColor DarkYellow
        }

        Write-Host "`n[Raw PASSession object]" -ForegroundColor DarkCyan
        $session | Format-List * | Out-String | Write-Host
    }
    else {
        Write-Host "==================================================" -ForegroundColor Red
        Write-Host " ❌ Authentication FAILED – Get-PASSession returned `$null." -ForegroundColor Red
        Write-Host "==================================================" -ForegroundColor Red
        exit 1
    }
}
catch {
    Write-Host "==================================================" -ForegroundColor Red
    Write-Host " ❌ Authentication FAILED with exception" -ForegroundColor Red
    Write-Host "--------------------------------------------------" -ForegroundColor Red
    Write-Host ("Type   : {0}" -f $_.Exception.GetType().FullName) -ForegroundColor Red
    Write-Host ("Message: {0}" -f $_.Exception.Message)          -ForegroundColor Red
    Write-Host "==================================================" -ForegroundColor Red
    exit 1
}

Write-Host "`n[Done] Identity login test completed (non-interactive)." -ForegroundColor Cyan
