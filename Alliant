# =====================================================================
# SailPoint → CyberArk Privilege Cloud (via CyberArk Identity)
# Safe creation, membership, and admin account provisioning
# Auth: CyberArk Identity header → psPAS session
# =====================================================================

# --- SailPoint / Exchange prerequisites ---
Add-Type -Path utils.dll
Add-PSSnapin Microsoft.Exchange.Management.PowerShell.SnapIn

$logFile = "C:\ConnectorAfterCreate.CreateCASafe.log"

function writeToLog($level, $msg) {
    $now = Get-Date -format "yyyy-MM-dd HH:mm:ss"
    Add-Content -Path $logFile "$now : $level : $msg"
}

# Optional wrapper so you can still use Write-Log if you like
function Write-Log {
    param(
        [string]$Message,
        [string]$Level = "INFO"
    )
    writeToLog $Level $Message
}

writeToLog "INFO"  "::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::"
writeToLog "INFO"  "Starting SailPoint → CyberArk provisioning flow..."

# ---------------------------------------------------------------------
# Read environment variables from SailPoint
# ---------------------------------------------------------------------
$sReader         = New-Object System.IO.StringReader([string]$env:Request)
$sResult         = New-Object System.IO.StringReader([string]$env:Result)

$xmlReader       = [System.Xml.XmlTextReader]([sailpoint.utils.xml.XmlUtil]::getReader($sReader))
$xmlReaderResult = [System.Xml.XmlTextReader]([sailpoint.utils.xml.XmlUtil]::getReader($sResult))

$requestObject   = New-Object Sailpoint.Utils.objects.AccountRequest($xmlReader)
$resultObject    = New-Object Sailpoint.Utils.objects.ServiceResult($xmlReaderResult)

# ---------------------------------------------------------------------
# Init variables from requestObject (you likely already have this part
# in your real script – keep your existing logic that fills these)
# ---------------------------------------------------------------------
$username  = ""   # to be populated from $requestObject
$empID     = ""   # to be populated from $requestObject
$adminacct = ""
$uID       = ""   # if still needed elsewhere (Exchange, etc.)
$pwd       = ""

writeToLog "INFO" "Getting variables from requestObject"

# If you still need these for something else:
$pass = ConvertTo-SecureString $pwd -AsPlainText -Force 

# =====================================================================
# CyberArk Identity + Privilege Cloud configuration
# =====================================================================

# Identity tenant + Privilege Cloud subdomain (TEST EXAMPLE – adjust!)
$IdentityTenantURL = "https://aap4748.id.cyberark.cloud"
$PCloudSubdomain   = "alliant-test"  # from alliant-test.privilegecloud.cyberark.cloud

# API User in CyberArk Identity (example you provided)
$UPUser = "alliantcredit-test_Sailpoint@cyberark.cloud.4176"

# ⚠️ Recommended: store password in an environment variable or external vault
# e.g. set CYBERARK_IDENTITY_UPPWD on the server and read it here:
$UPPlainPassword = $env:CYBERARK_IDENTITY_UPPWD

if ([string]::IsNullOrWhiteSpace($UPPlainPassword)) {
    writeToLog "ERROR" "CYBERARK_IDENTITY_UPPWD environment variable is not set. Cannot authenticate to CyberArk Identity."
    throw "Missing CyberArk Identity password (CYBERARK_IDENTITY_UPPWD)."
}

$UPPass = ConvertTo-SecureString $UPPlainPassword -AsPlainText -Force
$UPCred = [System.Management.Automation.PSCredential]::new($UPUser, $UPPass)

# =====================================================================
# Platform / Safe / CPM / Groups configuration
# =====================================================================

# ACU platform-specific details
$logondomain = "acu"
$address     = "alliantcreditunion.com"

$platform    = "*********"   # your CyberArk platform ID
$CPM         = "******"      # managing CPM name

# Safe naming convention
$safename    = "IND_{0}_{1}" -f $username, $empID
writeToLog "INFO" "Calculated Safe name: $safename"

# Groups / users for permissions
$admingroup   = "*********"
$adminUserName = "*******"
$apiuser      = "**********"

# Platform account properties
$platformAccountProperties = @{
    LogonDomain = $logondomain
}

# Rights objects
$adminrights = [PSCustomObject]@{
    useAccounts                            = $true
    retrieveAccounts                       = $true
    listAccounts                           = $true
    addAccounts                            = $true
    updateAccountContent                   = $true
    updateAccountProperties                = $true
    initiateCPMAccountManagementOperations = $true
    specifyNextAccountContent              = $true
    renameAccounts                         = $true
    deleteAccounts                         = $true
    unlockAccounts                         = $true
    manageSafe                             = $true
    manageSafeMembers                      = $true
    backupSafe                             = $true
    viewAuditLog                           = $true
    viewSafeMembers                        = $true
    accessWithoutConfirmation              = $true
    createFolders                          = $true
    deleteFolders                          = $true
    moveAccountsAndFolders                 = $true
    requestsAuthorizationLevel1            = $true
    requestsAuthorizationLevel2            = $false
}

$userrights = [PSCustomObject]@{
    useAccounts                            = $true
    retrieveAccounts                       = $true
    listAccounts                           = $true
    addAccounts                            = $false
    updateAccountContent                   = $false
    updateAccountProperties                = $false
    initiateCPMAccountManagementOperations = $false
    specifyNextAccountContent              = $false
    renameAccounts                         = $false
    deleteAccounts                         = $false
    unlockAccounts                         = $false
    manageSafe                             = $false
    manageSafeMembers                      = $false
    backupSafe                             = $false
    viewAuditLog                           = $true
    viewSafeMembers                        = $true
    accessWithoutConfirmation              = $false
    createFolders                          = $false
    deleteFolders                          = $false
    moveAccountsAndFolders                 = $false
    requestsAuthorizationLevel1            = $false
    requestsAuthorizationLevel2            = $false
}

$apiuserrights = [PSCustomObject]@{
    useAccounts                            = $true
    retrieveAccounts                       = $true
    listAccounts                           = $true
    addAccounts                            = $true
    updateAccountContent                   = $true
    updateAccountProperties                = $true
    initiateCPMAccountManagementOperations = $true
    specifyNextAccountContent              = $true
    renameAccounts                         = $true
    deleteAccounts                         = $true
    unlockAccounts                         = $true
    manageSafe                             = $true
    manageSafeMembers                      = $true
    backupSafe                             = $true
    viewAuditLog                           = $true
    viewSafeMembers                        = $true
    accessWithoutConfirmation              = $true
    createFolders                          = $true
    deleteFolders                          = $true
    moveAccountsAndFolders                 = $false
    requestsAuthorizationLevel1            = $false
    requestsAuthorizationLevel2            = $false
}

# =====================================================================
# Main block: Authenticate via Identity header + perform provisioning
# =====================================================================

try {
    Import-Module -Name psPAS -Force
    writeToLog "INFO" "psPAS module loaded."

    # --- CyberArk Identity header based authentication ---
    writeToLog "INFO" "Requesting CyberArk PAS authentication via Identity header..."

    $header = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred

    Use-PASSession $header

    $session = Get-PASSession
    if (-not $session) {
        writeToLog "ERROR" "Authentication failed – psPAS session not established."
        throw "CyberArk PAS session not established via Identity header."
    }

    writeToLog "INFO" "Authentication successful – PAS session established via Identity."

    # --- Safe creation ---
    writeToLog "INFO" "Creating safe: $safename (CPM: $CPM)"
    Add-PASSafe -SafeName $safename -Description "Personal Safe" -ManagingCPM $CPM -NumberOfVersionsRetention 7

    # --- Admin rights ---
    writeToLog "INFO" "Assigning admin rights to $admingroup, $adminUserName, and $apiuser"
    $adminrights  | Add-PASSafeMember -SafeName $safename -MemberName $admingroup
    $adminrights  | Add-PASSafeMember -SafeName $safename -MemberName $adminUserName -SearchIn Vault
    $apiuserrights | Add-PASSafeMember -SafeName $safename -MemberName $apiuser

    # --- User rights ---
    writeToLog "INFO" "Assigning user rights to $username"
    $userrights | Add-PASSafeMember -SafeName $safename -MemberName $username -SearchIn "hqvacudc101.alliantcreditunion.com"

    writeToLog "INFO" "Safe creation and permissions setup completed for $safename."

    # --- Add admin account & trigger CPM reconcile ---
    writeToLog "INFO" "Adding admin account $adminacct to safe $safename"
    $account = Add-PASAccount `
        -SafeName $safename `
        -PlatformID $platform `
        -Address $address `
        -UserName $adminacct `
        -PlatformAccountProperties $platformAccountProperties

    writeToLog "INFO" "Triggering CPM ReconcileTask for account ID $($account.ID)"
    Invoke-PASCPMOperation -AccountID $account.ID -ReconcileTask

    writeToLog "INFO" "Cmdlet execution completed for new safe management."

    $resultObject.Messages.Add("Success") | Out-Null
}
catch {
    $errMsg = "Failed to create new safe $safename for: $username. Error: $($_.FullyQualifiedErrorId) $($_.Exception.Message)"
    writeToLog "ERROR" $errMsg
    $resultObject.Errors.Add($errMsg) | Out-Null
}
finally {
    $resultObject.ToXml() | Out-File $args[0]
}
