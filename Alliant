<#
.SYNOPSIS
  CyberArk Platform Report (with NF* Notification Settings)

.DESCRIPTION
  - Authenticates to Privilege Cloud via Identity using a **service user** from CCP
  - Uses psPAS Get-PASPlatform to retrieve platform info
  - For each platform, pulls .Details (or refetches by PlatformID if needed)
  - Exports a CSV including NF* notification parameters

.REQUIREMENTS
  - psPAS and IdentityCommand modules installed
  - CCP configured & reachable for the ACURestAPI service user
  - Identity service user has rights to query platforms
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud (Shared Services) =====
    [string]$IdentityTenantURL  = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL  = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings (for API Service User stored in Vault) =====
    [string]$CCPAddress         = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation        = "AIMWebService",
    [string]$CCPAppID           = "ACURestAPI",
    [string]$CCPSafe            = "ACU-VAULT-API",
    [string]$CCPObject          = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]  $CCPWindowsAuth     = $false,

    # ===== Output =====
    [string]$CsvFilePath        = "I:\Script\REPORTS\CyberArk_FullPlatformReport_WithNF.csv"
)

# --- TLS & Modules ---
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Import-Module psPAS           -ErrorAction Stop
Import-Module IdentityCommand -ErrorAction Stop

# --- Pretty log helpers ---
function Write-Info($m){ Write-Host "🛠  $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "✅ $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "⚠️  $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "❌ $m" -ForegroundColor Red }

# --- CCP → PSCredential (API Service User) ---
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }

    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content. Raw: $($resp | ConvertTo-Json -Depth 5)"
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- MAIN ---
$sessionCreated = $false

try {
    # 1) Get Shared Services API Service User creds from CCP
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    # 2) Authenticate via Identity Shared Services using SERVICE USER
    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    if (-not (Get-PASSession)) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    # 3) Retrieve platforms via psPAS (includes .Details property)
    Write-Info "Retrieving platforms via Get-PASPlatform..."
    # You can tweak filters if you want (Active only, type, etc.)
    $platforms = Get-PASPlatform -ErrorAction Stop

    if (-not $platforms) {
        Write-Warn "No platforms returned from Get-PASPlatform."
        return
    }

    # 4) Build report rows, including NF* values from .Details
    $report = @()

    foreach ($p in $platforms) {

        # Handle different object shapes between API versions
        $general = if ($p.PSObject.Properties.Name -contains 'General') { $p.General } else { $p }

        # Basic high-level props (defensive null checks)
        $platformId     = $general.PlatformID
        $platformName   = $general.Name
        $active         = $general.Active
        $description    = $general.Description
        $platformBaseID = $general.PlatformBaseID
        $platformType   = $general.PlatformType
        $systemType     = $general.SystemType

        # Required / Optional account properties
        $requiredProps = $null
        $optionalProps = $null
        if ($p.PSObject.Properties.Name -contains 'Properties') {
            if ($p.Properties.required) {
                $requiredProps = ($p.Properties.required | ForEach-Object { $_.name }) -join '; '
            }
            if ($p.Properties.optional) {
                $optionalProps = ($p.Properties.optional | ForEach-Object { $_.name }) -join '; '
            }
        }

        # Linked accounts (if available)
        $linkedAccounts = $null
        if ($p.PSObject.Properties.Name -contains 'LinkedAccounts' -and $p.LinkedAccounts) {
            $linkedAccounts = ($p.LinkedAccounts | ForEach-Object { $_.name }) -join '; '
        }

        # Credential management block
        $cm = if ($p.PSObject.Properties.Name -contains 'CredentialsManagement') { $p.CredentialsManagement } else { $null }

        # Session management block
        $sm = if ($p.PSObject.Properties.Name -contains 'SessionManagement') { $p.SessionManagement } else { $null }

        # Workflows
        $wf = if ($p.PSObject.Properties.Name -contains 'PrivilegedAccessWorkflows') { $p.PrivilegedAccessWorkflows } else { $null }

        # --- NF* notification settings come from .Details ---
        $details = $null

        # Try details straight off the object
        if ($p.PSObject.Properties.Name -contains 'Details' -and $p.Details) {
            $details = $p.Details
        }

        # If Details missing or doesn't expose NF* yet, refetch by PlatformID
        if (-not $details -or -not ($details.PSObject.Properties.Name -contains 'NFNotifyPriorExpiration')) {
            if ($platformId) {
                try {
                    $full = Get-PASPlatform -PlatformID $platformId -ErrorAction Stop
                    if ($full -and $full.Details) {
                        $details = $full.Details
                    }
                } catch {
                    Write-Warn "Could not retrieve full details for PlatformID '$platformId': $($_.Exception.Message)"
                }
            }
        }

        # Map NF* safely (details may still be $null)
        $NFNotifyPriorExpiration          = $details.NFNotifyPriorExpiration
        $NFPriorExpirationRecipients      = $details.NFPriorExpirationRecipients
        $NFNotifyOnPasswordDisable        = $details.NFNotifyOnPasswordDisable
        $NFOnPasswordDisableRecipients    = $details.NFOnPasswordDisableRecipients
        $NFNotifyOnVerificationErrors     = $details.NFNotifyOnVerificationErrors
        $NFOnVerificationErrorsRecipients = $details.NFOnVerificationErrorsRecipients
        $NFNotifyOnPasswordUsed           = $details.NFNotifyOnPasswordUsed
        $NFOnPasswordUsedRecipients       = $details.NFOnPasswordUsedRecipients

        # Build a row
        $report += [PSCustomObject]@{
            PlatformID    = $platformId
            PlatformName  = $platformName
            Active        = $active
            Description   = $description
            PlatformBaseID= $platformBaseID
            PlatformType  = $platformType
            SystemType    = $systemType

            RequiredProperties = $requiredProps
            OptionalProperties = $optionalProps
            LinkedAccounts     = $linkedAccounts

            # Credential Management (common fields)
            AllowedSafes                          = $cm.AllowedSafes
            AllowManualChange                     = ($cm.AllowManualChange                     -as [string])
            PerformPeriodicChange                 = ($cm.PerformPeriodicChange                 -as [string])
            RequirePasswordChangeEveryXDays       = ($cm.RequirePasswordChangeEveryXDays       -as [string])
            AllowManualVerification               = ($cm.AllowManualVerification               -as [string])
            PerformPeriodicVerification           = ($cm.PerformPeriodicVerification           -as [string])
            RequirePasswordVerificationEveryXDays = ($cm.RequirePasswordVerificationEveryXDays -as [string])
            AllowManualReconciliation             = ($cm.AllowManualReconciliation             -as [string])
            AutomaticReconcileWhenUnsynched       = ($cm.AutomaticReconcileWhenUnsynched       -as [string])

            # Session Management (common fields)
            RequirePrivilegedSessionMonitoringAndIsolation = ($sm.RequirePrivilegedSessionMonitoringAndIsolation -as [string])
            RecordAndSaveSessionActivity                   = ($sm.RecordAndSaveSessionActivity                   -as [string])
            PSMServerID                                    = ($sm.PSMServerID                                    -as [string])

            # Privileged Access Workflows
            RequireDualControlPasswordAccessApproval       = ($wf.RequireDualControlPasswordAccessApproval       -as [string])
            EnforceCheckinCheckoutExclusiveAccess          = ($wf.EnforceCheckinCheckoutExclusiveAccess          -as [string])
            EnforceOnetimePasswordAccess                   = ($wf.EnforceOnetimePasswordAccess                   -as [string])

            # NF* notification settings (from platform details)
            NFNotifyPriorExpiration           = $NFNotifyPriorExpiration
            NFPriorExpirationRecipients       = $NFPriorExpirationRecipients
            NFNotifyOnPasswordDisable         = $NFNotifyOnPasswordDisable
            NFOnPasswordDisableRecipients     = $NFOnPasswordDisableRecipients
            NFNotifyOnVerificationErrors      = $NFNotifyOnVerificationErrors
            NFOnVerificationErrorsRecipients  = $NFOnVerificationErrorsRecipients
            NFNotifyOnPasswordUsed            = $NFNotifyOnPasswordUsed
            NFOnPasswordUsedRecipients        = $NFOnPasswordUsedRecipients
        }
    }

    # 5) Export to CSV
    Write-Info "Exporting platform report to CSV:"
    Write-Info "  $CsvFilePath"
    $report | Export-Csv -Path $CsvFilePath -NoTypeInformation -Encoding UTF8
    Write-Ok "CyberArk platform report exported successfully."
}
catch {
    Write-Err $_
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
