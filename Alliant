#requires -Version 5.1
[CmdletBinding()]
param(
    [Parameter(Mandatory=$true)]
    [string[]]$AllowedIPs,
    [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck'
)
$ErrorActionPreference = 'Stop'

function Assert-IPv4([string]$IP) {
    $parsed = $null
    if (-not [System.Net.IPAddress]::TryParse($IP, [ref]$parsed)) { throw "Invalid IP address: $IP" }
    if ($parsed.AddressFamily -ne [System.Net.Sockets.AddressFamily]::InterNetwork) { throw "IPv4 address required: $IP" }
    if ($IP -notmatch '^(?:\d{1,3}\.){3}\d{1,3}$') { throw "Use dotted-decimal IPv4 only: $IP" }
    return $parsed.ToString()
}

$webConfig = Join-Path $WebRoot 'web.config'
$aspx = Join-Path $WebRoot 'Default.aspx'
if (-not (Test-Path -LiteralPath $webConfig -PathType Leaf)) { throw "Missing $webConfig" }
if (-not (Test-Path -LiteralPath $aspx -PathType Leaf)) { throw "Missing $aspx" }

$normalized = @($AllowedIPs | ForEach-Object { $_ -split '[,;]' } | ForEach-Object { $_.Trim() } | Where-Object { $_ } | ForEach-Object { Assert-IPv4 $_ } | Select-Object -Unique)
if ($normalized.Count -eq 0) { throw 'Provide at least one allowed IPv4 address.' }

$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$backupDir = Join-Path 'C:\ProgramData\PAMDailyHealthCheck\ConfigBackups' ("UIAndIPs-$stamp")
New-Item -Path $backupDir -ItemType Directory -ErrorAction Stop | Out-Null
Copy-Item -LiteralPath $webConfig -Destination $backupDir -ErrorAction Stop
Copy-Item -LiteralPath $aspx -Destination $backupDir -ErrorAction Stop

# Update only this app's setting. No IIS site-wide authentication changes.
[xml]$config = Get-Content -LiteralPath $webConfig -Raw -ErrorAction Stop
$settings = $config.configuration.appSettings
if ($null -eq $settings) { throw 'web.config has no appSettings section.' }
$nodes = @($settings.SelectNodes("add[@key='DevAllowedClientIPs']"))
if ($nodes.Count -gt 1) { throw 'Duplicate DevAllowedClientIPs keys found; correct manually.' }
if ($nodes.Count -eq 0) {
    $newItem = $config.CreateElement('add')
    $newItem.SetAttribute('key','DevAllowedClientIPs')
    $newItem.SetAttribute('value',($normalized -join ','))
    [void]$settings.AppendChild($newItem)
} else {
    $nodes[0].SetAttribute('value',($normalized -join ','))
}

# Replace only the completion button's inner text; preserve its behavior.
$aspxText = [System.IO.File]::ReadAllText($aspx)
$pattern = '(?s)(<button\b[^>]*\bvalue\s*=\s*[\x27\x22]Completed[\x27\x22][^>]*>).*?(</button>)'
$matches = [regex]::Matches($aspxText, $pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
if ($matches.Count -ne 1) { throw "Expected exactly one Completed button, found $($matches.Count). No changes made." }
$updated = [regex]::Replace($aspxText, $pattern, '$1Complete &amp; Upload Evidence$2', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)

# UTF-8 BOM helps legacy ASP.NET/Notepad consistently recognize encoding.
$utf8 = New-Object System.Text.UTF8Encoding($true)
try {
    $config.Save($webConfig)
    [System.IO.File]::WriteAllText($aspx, $updated, $utf8)
} catch {
    Copy-Item -LiteralPath (Join-Path $backupDir 'web.config') -Destination $webConfig -Force
    Copy-Item -LiteralPath (Join-Path $backupDir 'Default.aspx') -Destination $aspx -Force
    throw
}
Write-Host 'Updated PAM Health Check settings successfully.' -ForegroundColor Green
Write-Host ('Allowed IPs: ' + ($normalized -join ', '))
Write-Host 'Button text: Complete & Upload Evidence'
Write-Host ('Backup: ' + $backupDir)
Write-Host 'Refresh the portal. Saving web.config normally restarts only this ASP.NET application.'
Write-Warning 'DEV anonymous IP restriction is not an authentication substitute. Apply matching firewall/VIP restrictions.'
