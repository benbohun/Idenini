
# PAM Health Check - Temporary DEV Anonymous Access
# Run as Administrator on the IIS server

Import-Module WebAdministration -ErrorAction Stop

$SiteName = "Default Web Site"
$AppAlias = "PAMHealthCheck"
$Location = "$SiteName/$AppAlias"

# Locate installed application
$App = Get-WebApplication -Site $SiteName |
    Where-Object { $_.Path -eq "/$AppAlias" }

if (-not $App) {
    throw "PAMHealthCheck IIS application not found."
}

$PhysicalPath = [Environment]::ExpandEnvironmentVariables(
    $App.PhysicalPath
)

$WebConfig = Join-Path $PhysicalPath "web.config"

if (-not (Test-Path $WebConfig)) {
    throw "web.config not found: $WebConfig"
}

# Backup application configuration
$Backup = "$WebConfig.bak-$(Get-Date -Format 'yyyyMMdd-HHmmss')"
Copy-Item $WebConfig $Backup -ErrorAction Stop

Write-Host "Backup saved: $Backup"

# Change ASP.NET authentication configuration
[xml]$Config = Get-Content $WebConfig

$SystemWeb = $Config.configuration.'system.web'

if ($null -eq $SystemWeb) {
    $SystemWeb = $Config.CreateElement("system.web")
    [void]$Config.configuration.AppendChild($SystemWeb)
}

$Authentication = $SystemWeb.authentication

if ($null -eq $Authentication) {
    $Authentication = $Config.CreateElement("authentication")
    [void]$SystemWeb.AppendChild($Authentication)
}

$Authentication.SetAttribute("mode", "None")

# Remove existing application authorization rules
$Authorization = $SystemWeb.authorization

if ($null -ne $Authorization) {
    $SystemWeb.RemoveChild($Authorization) | Out-Null
}

$Config.Save($WebConfig)

# Change IIS authentication for this application ONLY
Set-WebConfigurationProperty `
    -PSPath "MACHINE/WEBROOT/APPHOST" `
    -Location $Location `
    -Filter "system.webServer/security/authentication/windowsAuthentication" `
    -Name enabled `
    -Value $false

Set-WebConfigurationProperty `
    -PSPath "MACHINE/WEBROOT/APPHOST" `
    -Location $Location `
    -Filter "system.webServer/security/authentication/anonymousAuthentication" `
    -Name enabled `
    -Value $true

Write-Host ""
Write-Host "Temporary anonymous access enabled."
Write-Host "Application: $Location"
Write-Host "Existing AIMWebService configuration not intentionally changed."
Write-Host "Restore authentication before production deployment."
