Use the same login session to fetch platform report.
Also see if you can fetch addtional attributes like below

NFNotifyPriorExpiration=
NFPriorExpirationRecipients=
NFNotifyOnPasswordDisable=
NFOnPasswordDisableRecipients=
NFNotifyOnVerificationErrors=
NFOnVerificationErrorsRecipients=
NFNotifyOnPasswordUsed=
NFOnPasswordUsedRecipients=


# Force PowerShell to use TLS 1.2 for secure connections
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# Prompt user for CyberArk credentials
$cred = Get-Credential
$Username = $cred.UserName
$Password = $cred.GetNetworkCredential().Password

# Define CyberArk Privilege Cloud API URLs (Using alliantcredit subdomain)
$Subdomain = "alliantcredit"
$BaseURL = "https://$Subdomain.privilegecloud.cyberark.com/PasswordVault/API"

# Authentication URL
$AuthURL = "$BaseURL/auth/Cyberark/Logon/"

# Authenticate and get session token
try {
    $AuthResponse = Invoke-RestMethod -Uri $AuthURL -Method POST -Body (@{ username=$Username; password=$Password } | ConvertTo-Json) -ContentType "application/json"
    $AuthToken = $AuthResponse
    Write-Host "Authentication successful!" -ForegroundColor Green
} catch {
    Write-Host "Authentication failed: $_" -ForegroundColor Red
    exit
}

# Set Authorization Header
$Headers = @{
    Authorization = $AuthToken
    "Content-Type" = "application/json"
}

# Define Platform API URL and output CSV file path
$GetPlatformsURL = "$BaseURL/Platforms"
$CsvFilePath = "CyberArk_FullPlatformReport.csv"

try {
    $PlatformsResponse = Invoke-RestMethod -Uri $GetPlatformsURL -Method GET -Headers $Headers
    Write-Host "Platforms data retrieved." -ForegroundColor Green
} catch {
    Write-Host "Failed to retrieve platform data: $_" -ForegroundColor Red
    exit
}

# Process Data with Correct JSON Structure
$ProcessedPlatforms = $PlatformsResponse.Platforms | ForEach-Object {
    [PSCustomObject]@{
        PlatformID    = $_.general.id
        PlatformName  = $_.general.name
        Active        = $_.general.active
        Description   = $_.general.description
        PlatformBaseID = $_.general.platformBaseID
        PlatformType  = $_.general.platformType
        SystemType    = $_.general.systemType

        # Required and Optional Properties
        RequiredProperties = ($_.properties.required.name -join "; ")
        OptionalProperties = ($_.properties.optional.name -join "; ")

        # Linked Accounts
        LinkedAccounts = ($_.linkedAccounts.name -join "; ")

        # Credentials Management
        AllowedSafes                            = $_.credentialsManagement.allowedSafes
        AllowManualChange                       = $_.credentialsManagement.allowManualChange -as [string]
        PerformPeriodicChange                   = $_.credentialsManagement.performPeriodicChange -as [string]
        RequirePasswordChangeEveryXDays         = $_.credentialsManagement.requirePasswordChangeEveryXDays -as [string]
        AllowManualVerification                 = $_.credentialsManagement.allowManualVerification -as [string]
        PerformPeriodicVerification             = $_.credentialsManagement.performPeriodicVerification -as [string]
        RequirePasswordVerificationEveryXDays   = $_.credentialsManagement.requirePasswordVerificationEveryXDays -as [string]
        AllowManualReconciliation               = $_.credentialsManagement.allowManualReconciliation -as [string]
        AutomaticReconcileWhenUnsynched         = $_.credentialsManagement.automaticReconcileWhenUnsynched -as [string]

        # Session Management
        RequirePrivilegedSessionMonitoringAndIsolation = $_.sessionManagement.requirePrivilegedSessionMonitoringAndIsolation -as [string]
        RecordAndSaveSessionActivity           = $_.sessionManagement.recordAndSaveSessionActivity -as [string]
        PSMServerID                            = $_.sessionManagement.PSMServerID -as [string]

        # Privileged Access Workflows
        RequireDualControlPasswordAccessApproval = $_.privilegedAccessWorkflows.requireDualControlPasswordAccessApproval -as [string]
        EnforceCheckinCheckoutExclusiveAccess    = $_.privilegedAccessWorkflows.enforceCheckinCheckoutExclusiveAccess -as [string]
        EnforceOnetimePasswordAccess             = $_.privilegedAccessWorkflows.enforceOnetimePasswordAccess -as [string]
    }
}

# Export to CSV
$ProcessedPlatforms | Export-Csv -Path $CsvFilePath -NoTypeInformation
Write-Host "✅ CyberArk platform report has been successfully exported to: $CsvFilePath" -ForegroundColor Yellow

# Log off session
$LogoffURL = "$BaseURL/auth/Logoff"
Invoke-RestMethod -Uri $LogoffURL -Method POST -Headers $Headers | Out-Null
Write-Host "Logged out successfully." -ForegroundColor Cyan
