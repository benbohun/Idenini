#requires -Version 5.1
[CmdletBinding()]
param([string]$SiteName='Default Web Site',[string]$AppAlias='PAMHealthCheck',[int]$Minutes=45)
$ErrorActionPreference='Continue'
$dest=Join-Path $env:ProgramData ('PAMDailyHealthCheck\Diagnostics\PAM-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'.txt')
New-Item -ItemType Directory -Path (Split-Path $dest) -Force | Out-Null
function Section([string]$name,[scriptblock]$body){"`r`n==== $name ====" | Out-File $dest -Append -Encoding UTF8; try {& $body 2>&1 | Out-String -Width 280 | Out-File $dest -Append -Encoding UTF8}catch{($_|Out-String)|Out-File $dest -Append}}
$appcmd=Join-Path $env:windir 'System32\inetsrv\appcmd.exe'
if(-not (Test-Path $appcmd)){ $appcmd=Join-Path $env:windir 'Sysnative\inetsrv\appcmd.exe' }
$loc="$SiteName/$AppAlias"
Section 'System' { "Computer=$env:COMPUTERNAME"; "Time=$(Get-Date -Format o)"; "64bit=$([Environment]::Is64BitProcess)"; "PowerShell=$($PSVersionTable.PSVersion)" }
Section 'IIS application' {& $appcmd list app "$loc/"}
Section 'IIS AppPool' {& $appcmd list app "$loc/" /text:applicationPool; & $appcmd list apppool}
Section 'Authentication (effective)' {& $appcmd list config "$loc" /section:system.webServer/security/authentication/windowsAuthentication; & $appcmd list config "$loc" /section:system.webServer/security/authentication/anonymousAuthentication }
Section 'Application errors (recent)' {Get-WinEvent -FilterHashtable @{LogName='Application';StartTime=(Get-Date).AddMinutes(-$Minutes)} -ErrorAction Stop | Where-Object {$_.ProviderName -match 'ASP.NET|\.NET Runtime|Application Error|IIS|WAS' -or $_.Message -match 'PAMHealthCheck|Default\.aspx'} | Select-Object -First 25 TimeCreated,ProviderName,Id,LevelDisplayName,Message | Format-List}
Section 'ASP.NET/IIS installed features' {try { Import-Module ServerManager -ErrorAction Stop;Get-WindowsFeature Web-Asp-Net45,Web-Net-Ext45,Web-ISAPI-Ext,Web-ISAPI-Filter,Web-Windows-Auth,Web-Scripting-Tools | Format-Table -AutoSize }catch{ $_.Exception.Message }}
Section 'Site app configuration location and existence' { $line=(& $appcmd list vdir "$loc/" 2>&1 | Out-String);$line; if ($line -match 'physicalPath:([^\)]*)'){ $p=$Matches[1].Trim();"Physical=$p";"ConfigExists=$(Test-Path (Join-Path $p 'web.config'))";"AspxExists=$(Test-Path (Join-Path $p 'Default.aspx'))"} }
Section 'ASP.NET event log sources' { Get-EventLog -LogName Application -Newest 15 -ErrorAction SilentlyContinue | Where-Object {$_.Source -like 'ASP.NET*'} | Select-Object TimeGenerated,EntryType,Message | Format-List }
Write-Host "Diagnostics saved to: $dest" -ForegroundColor Green
Write-Host 'Review/redact user names, hostnames and paths before sharing.'
