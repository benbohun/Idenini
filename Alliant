# Confirm DNS resolution
getent hosts vault-<subdomain>.privilegecloud.cyberark.com

# Test the required Privilege Cloud Vault port
nc -vz vault-<subdomain>.privilegecloud.cyberark.com 1858

# If nc is unavailable
timeout 5 bash -c '</dev/tcp/vault-<subdomain>.privilegecloud.cyberark.com/1858' && echo 'TCP 1858 reachable'

# Confirm the server FQDN and time
hostname -f
date
