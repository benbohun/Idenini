[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$ClientID = Read-Host "Alero Client ID"
$Secret = Read-Host "Alero Client Secret" -AsSecureString

$Ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($Secret)

try {
    $ClientSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($Ptr)

    $Body = @{
        grant_type    = "client_credentials"
        client_id     = $ClientID
        client_secret = $ClientSecret
    }

    $Response = Invoke-RestMethod `
        -Uri "https://auth.alero.io/auth/realms/serviceaccounts/protocol/openid-connect/token" `
        -Method POST `
        -ContentType "application/x-www-form-urlencoded" `
        -Body $Body `
        -ErrorAction Stop

    if ($Response.access_token) {
        Write-Host "SUCCESS: Token generated." -ForegroundColor Green
        Write-Host "Token length: $($Response.access_token.Length)"
    }
    else {
        Write-Host "No access token returned." -ForegroundColor Yellow
    }
}
catch {
    Write-Host "AUTHENTICATION FAILED" -ForegroundColor Red
    Write-Host "Error type: $($_.Exception.GetType().Name)"

    if ($_.Exception.Response) {
        Write-Host "HTTP status: $([int]$_.Exception.Response.StatusCode)"
    }

    Write-Host "Error: $($_.Exception.Message)"
}
finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($Ptr)
    Remove-Variable ClientSecret, Body -ErrorAction SilentlyContinue
}
