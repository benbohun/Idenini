#Requires -Version 5.1
<#
.SYNOPSIS
Repairs ASP.NET CS0016 compilation 'Access denied' for the PAMHealthCheck application.
.DESCRIPTION
Sets an application-specific ASP.NET compilation temp directory and grants only
IIS APPPOOL\PAMHealthCheckPool Modify rights to it. Does NOT touch global
Temporary ASP.NET Files ACLs, IIS authentication, other app pools, or AIMWebService.
Run as administrator in Windows PowerShell 5.1.
#>
[CmdletBinding()]
param(
    [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck',
    [string]$AppPool = 'PAMHealthCheckPool',
    [string]$DataRoot = 'C:\ProgramData\PAMDailyHealthCheck'
)
$ErrorActionPreference = 'Stop'
function Step([string]$Text) { Write-Host "[PAM] $Text" -ForegroundColor Cyan }
function Assert-True($Condition, $Message) { if (-not $Condition) { throw $Message } }
try {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)
    Assert-True ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) 'Run from an elevated PowerShell window.'
    $webConfig = Join-Path $WebRoot 'web.config'
    Assert-True (Test-Path -LiteralPath $webConfig -PathType Leaf) "Missing web.config: $webConfig"
    Assert-True (Test-Path -LiteralPath (Join-Path $WebRoot 'Default.aspx') -PathType Leaf) "Missing Default.aspx in $WebRoot"
    $tempDir = Join-Path $DataRoot 'AspNetCompilationTemp'
    $backupDir = Join-Path $DataRoot 'ConfigBackups'
    New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $backup = Join-Path $backupDir "web.config.before-CS0016-$stamp.bak"
    Copy-Item -LiteralPath $webConfig -Destination $backup -ErrorAction Stop
    Step "Backed up web.config to $backup"
    New-Item -ItemType Directory -Path $tempDir -Force | Out-Null
    $appPoolIdentity = "IIS APPPOOL\$AppPool"
    $rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
        $appPoolIdentity,
        [System.Security.AccessControl.FileSystemRights]::Modify,
        [System.Security.AccessControl.InheritanceFlags]'ContainerInherit, ObjectInherit',
        [System.Security.AccessControl.PropagationFlags]::None,
        [System.Security.AccessControl.AccessControlType]::Allow
    )
    $acl = Get-Acl -LiteralPath $tempDir
    $acl.SetAccessRule($rule)
    Set-Acl -LiteralPath $tempDir -AclObject $acl
    Step "Granted Modify on $tempDir to $appPoolIdentity"

    [xml]$config = Get-Content -LiteralPath $webConfig -Raw
    Assert-True ($null -ne $config.configuration) 'Invalid web.config: no configuration element.'
    $sysWeb = $config.configuration.SelectSingleNode('system.web')
    if ($null -eq $sysWeb) {
        $sysWeb = $config.CreateElement('system.web')
        [void]$config.configuration.AppendChild($sysWeb)
    }
    $compilation = $sysWeb.SelectSingleNode('compilation')
    if ($null -eq $compilation) {
        $compilation = $config.CreateElement('compilation')
        [void]$sysWeb.AppendChild($compilation)
    }
    $compilation.SetAttribute('tempDirectory', $tempDir)
    try {
        $config.Save($webConfig)
    } catch {
        Copy-Item -LiteralPath $backup -Destination $webConfig -Force
        throw
    }
    Step "Configured ASP.NET compilation tempDirectory: $tempDir"
    Write-Host ''
    Write-Host 'SUCCESS: Application-specific compilation directory configured.' -ForegroundColor Green
    Write-Host "Backup: $backup"
    Write-Host "App: $WebRoot"
    Write-Host "Temp: $tempDir"
    Write-Host "ACL: $appPoolIdentity - Modify"
    Write-Host 'web.config update triggers ASP.NET application restart; no iisreset required.'
    Write-Host 'Now retry /PAMHealthCheck/Default.aspx over HTTPS.'
    Write-Host 'If a different error occurs, collect the newest ASP.NET event ID 1310.'
} catch {
    Write-Error "Repair FAILED: $($_.Exception.Message)"
    exit 1
}
