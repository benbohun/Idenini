#Requires -Version 5.1
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# --- Allow unsigned modules & unblock psPAS (silent) ---
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force -ErrorAction Stop } catch {}
$psPASDirs = @(
  "$env:ProgramFiles\WindowsPowerShell\Modules\psPAS\6.4.85",
  "$HOME\Documents\WindowsPowerShell\Modules\psPAS\6.4.85"
) | Where-Object { Test-Path $_ }
foreach ($d in $psPASDirs) { try { Get-ChildItem $d -Recurse -File | Unblock-File -ErrorAction SilentlyContinue } catch {} }

# --- Minimal logging (no secrets/identifiers) ---
$LogPath = "G:\Script\logon.txt"
Function Write-Log {
    param([string]$Message,[string]$Color="White")
    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "$ts - $Message"
    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }
    try { Add-Content -Path $LogPath -Value $line } catch {}
}

# --- Load psPAS (+ optional AD) ---
try { Import-Module psPAS -Force -ErrorAction Stop; Write-Log "psPAS loaded." "Green" }
catch { Write-Log "psPAS not found/loaded." "Red"; exit 1 }
$ADModuleLoaded = $false
try { Import-Module ActiveDirectory -ErrorAction Stop; $ADModuleLoaded = $true }
catch { Write-Log "AD module not available (non-fatal)." "Yellow" }

# --- TLS 1.2 ---
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}

