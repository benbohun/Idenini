function Test-WindowsServiceComponent {
    try {
        $services = @(Get-CimInstance -ClassName Win32_Service -CimSession $script:CimSession -ErrorAction Stop)
        Add-Result -Component 'WindowsService' -Category 'Access' -Check 'Remote service enumeration' -Status 'PASS' `
            -Details ("Enumerated {0} Windows service(s). This end-to-end DCOM/WMI result also confirms the RPC dynamic-port path used for service enumeration." -f $services.Count)

        if ($ServiceName) {
            $service = @($services | Where-Object Name -ieq $ServiceName)
            if ($service.Count -eq 0) {
                Add-Result -Component 'WindowsService' -Category 'Resource' -Check 'Specified service' -Status 'FAIL' `
                    -Details ("Service short name '{0}' was not found." -f $ServiceName) `
                    -Recommendation 'Use the Windows service short name, not only the display name, in the CyberArk dependency.'
            }
            else {
                foreach ($item in $service) {
                    Add-Result -Component 'WindowsService' -Category 'Resource' -Check 'Specified service' -Status 'PASS' `
                        -Details ("Found '{0}' ({1}); state: {2}; startup: {3}; Log On As: '{4}'." -f $item.Name, $item.DisplayName, $item.State, $item.StartMode, $item.StartName)

                    if ($ManagedAccount) {
                        $status = if (Test-AccountMatch -Expected $ManagedAccount -Actual $item.StartName) { 'PASS' } else { 'FAIL' }
                        Add-Result -Component 'WindowsService' -Category 'Identity' -Check 'Managed account match' -Status $status `
                            -Details ("Expected '{0}'; service uses '{1}'." -f $ManagedAccount, $item.StartName) `
                            -Recommendation $(if ($status -eq 'FAIL') { 'Correct the CyberArk dependency or service Log On As identity before rotation.' } else { '' })
                    }
                }
            }
        }

        $servicesForDependencyReview = @()
        if ($ServiceName) {
            $servicesForDependencyReview = @($services | Where-Object Name -ieq $ServiceName)
        }
        elseif ($ManagedAccount) {
            $servicesForDependencyReview = @($services | Where-Object { Test-AccountMatch -Expected $ManagedAccount -Actual $_.StartName })
        }

        if ($servicesForDependencyReview.Count -gt 0) {
            try {
                $relationships = @(Get-CimInstance -ClassName Win32_DependentService -CimSession $script:CimSession -ErrorAction Stop)
                foreach ($reviewService in $servicesForDependencyReview) {
                    $dependentNames = New-Object System.Collections.Generic.List[string]
                    foreach ($relationship in $relationships) {
                        $antecedentName = $null
                        $dependentName = $null
                        try { $antecedentName = [string]$relationship.Antecedent.Name } catch {}
                        try { $dependentName = [string]$relationship.Dependent.Name } catch {}
                        if ($antecedentName -ieq $reviewService.Name -and $dependentName) { $dependentNames.Add($dependentName) }
                    }

                    if ($dependentNames.Count -gt 0) {
                        $dependentDetails = @($services | Where-Object { $dependentNames -contains $_.Name } | ForEach-Object { "{0} [Log On As: {1}]" -f $_.Name, $_.StartName })
                        Add-Result -Component 'WindowsService' -Category 'Service dependencies' -Check $reviewService.Name -Status 'WARN' `
                            -Details ("Dependent service(s) detected: {0}." -f ($dependentDetails -join '; ')) `
                            -Recommendation 'CyberArk requires all service accounts participating in service dependencies on the remote machine to be managed by CPM. Confirm these accounts in Privilege Cloud or use service-account auto-detection.'
                    }
                    else {
                        Add-Result -Component 'WindowsService' -Category 'Service dependencies' -Check $reviewService.Name -Status 'PASS' `
                            -Details 'No Windows services were returned as dependent on this service.'
                    }
                }
            }
            catch {
                Add-Result -Component 'WindowsService' -Category 'Service dependencies' -Check 'Dependency enumeration' -Status 'WARN' `
                    -Details ("Unable to inspect Win32_DependentService relationships: {0}" -f $_.Exception.Message) `
                    -Recommendation 'Review the service Dependencies tab and confirm all related service accounts are managed by CPM.'
            }
        }

        if ($ManagedAccount) {
            $matching = @($services | Where-Object { Test-AccountMatch -Expected $ManagedAccount -Actual $_.StartName })
            Add-Result -Component 'WindowsService' -Category 'Discovery' -Check 'Services using managed account' -Status 'INFO' `
                -Details ("Found {0} service(s) using an identity matching '{1}': {2}" -f $matching.Count, $ManagedAccount, (($matching | ForEach-Object { $_.Name }) -join '; '))
        }

        if ($PerformWriteTest) {
            $name = 'CyberArkPrereqSvc_{0}' -f ([guid]::NewGuid().ToString('N').Substring(0, 10))
            try {
                $arguments = @{
                    Name            = $name
                    DisplayName     = $name
                    PathName        = "$script:TargetWindowsDirectory\System32\cmd.exe /d /c exit 0"
                    ServiceType     = [uint32]16
                    ErrorControl    = [uint32]1
                    StartMode       = 'Disabled'
                    DesktopInteract = $false
                    StartName       = 'LocalSystem'
                    StartPassword   = $null
                }
                $create = Invoke-CimMethod -ClassName Win32_Service -MethodName Create -Arguments $arguments -CimSession $script:CimSession
                if ($create.ReturnValue -ne 0) {
                    throw "Win32_Service.Create returned $($create.ReturnValue)."
                }

                $createdService = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $name) -CimSession $script:CimSession -ErrorAction Stop
                $delete = Invoke-CimMethod -InputObject $createdService -MethodName Delete
                if ($delete.ReturnValue -ne 0) {
                    throw "Temporary service was created, but Delete returned $($delete.ReturnValue). Remove service '$name' manually."
                }

                Add-Result -Component 'WindowsService' -Category 'Write test' -Check 'Create/delete temporary service' -Status 'PASS' `
                    -Details ("Created and removed disabled temporary service '{0}'. It was never started." -f $name)
            }
            catch {
                try {
                    $leftover = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $name) -CimSession $script:CimSession -ErrorAction SilentlyContinue
                    if ($leftover) { Invoke-CimMethod -InputObject $leftover -MethodName Delete -ErrorAction SilentlyContinue | Out-Null }
                }
                catch {}

                Add-Result -Component 'WindowsService' -Category 'Write test' -Check 'Create/delete temporary service' -Status 'FAIL' `
                    -Details ("Windows Service write test failed: {0}" -f $_.Exception.Message) `
                    -Recommendation 'Verify effective local Administrators access and Remote Service Management RPC/firewall policy.'
            }
        }
        else {
            Add-Result -Component 'WindowsService' -Category 'Write test' -Check 'Create/delete temporary service' -Status 'SKIP' `
                -Details 'Write test was not requested. Supply -PerformWriteTest for a non-production effective-permission test.'
        }
    }
    catch {
        Add-Result -Component 'WindowsService' -Category 'Access' -Check 'Remote service enumeration' -Status 'FAIL' `
            -Details ("Unable to enumerate Windows services: {0}" -f $_.Exception.Message) `
            -Recommendation 'Enable Client/File Sharing bindings, Remote Service Management rules, RPC services, and local Administrators access.'
    }
}

function Test-AndFixCpmWindowsScriptHost {
    $cscript = Join-Path $env:SystemRoot 'System32\cscript.exe'
    if (Test-Path -LiteralPath $cscript) {
        $versionText = (Get-Item -LiteralPath $cscript).VersionInfo.FileVersion
        Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Cscript' -Status 'PASS' `
            -Details ("Cscript exists on source/CPM '{0}'; file version: {1}." -f $script:SourceFqdn, $versionText)
    }
    else {
        Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Cscript' -Status 'FAIL' `
            -Details ("Cscript was not found at '{0}'." -f $cscript) `
            -Recommendation 'Install or repair Windows Script Host on the CPM.'
    }

    $paths = @(
        'Registry::HKEY_USERS\.DEFAULT\Software\Microsoft\Windows Script Host\Settings',
        'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows Script Host\Settings',
        'Registry::HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Windows Script Host\Settings'
    )

    $disabledPaths = New-Object System.Collections.Generic.List[string]
    foreach ($path in $paths) {
        if (Test-Path -LiteralPath $path) {
            try {
                $enabled = (Get-ItemProperty -LiteralPath $path -Name Enabled -ErrorAction SilentlyContinue).Enabled
                if ($null -ne $enabled -and [int]$enabled -eq 0) {
                    $disabledPaths.Add($path)
                }
            }
            catch {}
        }
    }

    if ($disabledPaths.Count -gt 0 -and $Fix) {
        foreach ($path in $disabledPaths) {
            try {
                if (-not (Test-Path -LiteralPath $path)) { New-Item -Path $path -Force | Out-Null }
                New-ItemProperty -LiteralPath $path -Name Enabled -PropertyType DWord -Value 1 -Force | Out-Null
                Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Windows Script Host enabled' -Status 'FIXED' `
                    -Details ("Windows Script Host was disabled at '{0}'." -f $path) `
                    -ActionTaken 'Set Enabled=1 on the source/CPM registry path.'
            }
            catch {
                Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Windows Script Host enabled' -Status 'FAIL' `
                    -Details ("Unable to update '{0}': {1}" -f $path, $_.Exception.Message) `
                    -Recommendation 'Run PowerShell as Administrator on the CPM or update the controlling security policy.'
            }
        }
        $disabledPaths.Clear()
    }

    if ($disabledPaths.Count -eq 0) {
        Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Windows Script Host enabled' -Status 'PASS' `
            -Details 'No local registry policy disabling Windows Script Host was detected on the source/CPM.'
    }
    else {
        Add-Result -Component 'IISAppPool' -Category 'CPM prerequisite' -Check 'Windows Script Host enabled' -Status 'FAIL' `
            -Details ("Windows Script Host is disabled at: {0}." -f ($disabledPaths -join '; ')) `
            -Recommendation 'Enable Windows Script Host on the CPM. Review local or domain policy before changing the registry.'
    }
}

