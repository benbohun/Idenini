#Requires -Version 5.1
<#[.SYNOPSIS]
Fixes ACLs within only the PAMHealthCheck ASP.NET compilation cache.
No global IIS ACL changes, no auth changes, no IISRESET.
Run as local administrator in Windows PowerShell 5.1.
#>
[CmdletBinding()]
param(
 [string]$TempDir = 'C:\ProgramData\PAMDailyHealthCheck\AspNetCompilationTemp',
 [string]$AppPool = 'PAMHealthCheckPool',
 [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck',
 [switch]$SkipRecycle
)
$ErrorActionPreference='Stop'
function Invoke-Native([string]$Exe,[string[]]$Arguments) {
 & $Exe @Arguments
 if ($LASTEXITCODE -ne 0) { throw "$Exe exited $LASTEXITCODE" }
}
$me=[Security.Principal.WindowsIdentity]::GetCurrent()
$p=New-Object Security.Principal.WindowsPrincipal($me)
if (-not $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Run elevated (Run as administrator).' }
if (-not (Test-Path -LiteralPath (Join-Path $WebRoot 'web.config') -PathType Leaf)) { throw "web.config absent: $WebRoot" }
if (-not (Test-Path -LiteralPath $TempDir -PathType Container)) { throw "Compilation folder absent: $TempDir. Run the earlier CS0016 script first." }
$expected='C:\ProgramData\PAMDailyHealthCheck\AspNetCompilationTemp'
if ($TempDir.TrimEnd('\') -ne $expected.TrimEnd('\')) { throw "Safety guard: this repair only supports $expected" }
$account="IIS APPPOOL\$AppPool"
$backupDir='C:\ProgramData\PAMDailyHealthCheck\ConfigBackups'
New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
$stamp=Get-Date -Format 'yyyyMMdd-HHmmss'
$aclBackup=Join-Path $backupDir "CompileACL-$stamp.txt"
$log=Join-Path $backupDir "CompileACL-Repair-$stamp.log"
Start-Transcript -Path $log -Force | Out-Null
try {
 Write-Host "Compilation folder: $TempDir"
 Write-Host "Application pool identity: $account"
 Write-Host 'Backing up folder ACLs...'
 Push-Location (Split-Path -Parent $TempDir)
 try { Invoke-Native "$env:windir\System32\icacls.exe" @((Split-Path -Leaf $TempDir),'/save',$aclBackup,'/T','/C') }
 finally { Pop-Location }
 Write-Host "ACL backup: $aclBackup"
 # Do not reset, remove, or replace existing ACLs; grant only this app pool on its private directory and children.
 Invoke-Native "$env:windir\System32\icacls.exe" @($TempDir,'/grant',"${account}:(OI)(CI)M",'/T','/C')
 Write-Host 'Resulting ACLs at compilation root:'
 Invoke-Native "$env:windir\System32\icacls.exe" @($TempDir)
 $deny=(Get-Acl -LiteralPath $TempDir).Access | Where-Object { $_.AccessControlType -eq 'Deny' }
 if ($deny) { Write-Warning 'Explicit deny ACLs exist at the compilation root; they may override the allow. Review the log.'; $deny | Format-Table -AutoSize | Out-Host }
 [xml]$cfg=Get-Content -LiteralPath (Join-Path $WebRoot 'web.config') -Raw
 $node=$cfg.SelectSingleNode('/configuration/system.web/compilation')
 if (-not $node -or $node.GetAttribute('tempDirectory').TrimEnd('\') -ne $TempDir.TrimEnd('\')) {
  Write-Warning 'web.config compilation tempDirectory does not match this path. Check the previous repair and physical application path.'
 }
 if (-not $SkipRecycle) {
  $appcmd=Join-Path $env:windir 'System32\inetsrv\appcmd.exe'
  if (Test-Path $appcmd) { Invoke-Native $appcmd @('recycle','apppool',"/apppool.name:$AppPool") }
  else { Write-Warning 'appcmd.exe was not found; recycle only PAMHealthCheckPool through IIS Manager.' }
 }
 Write-Host 'Complete. Refresh the page once, then read the newest ASP.NET event 1310.' -ForegroundColor Green
 Write-Host 'If CS0016 persists in this same directory, check endpoint protection, application control, and effective NTFS denies rather than granting Everyone rights.'
}
finally { Stop-Transcript | Out-Null; Write-Host "Log: $log" }
