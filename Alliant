# ---------- Ensure PSGallery works ----------
Function Ensure-PSGallery {
  try {
    $repo = Get-PSRepository -Name PSGallery -ErrorAction Stop
    if ($repo.InstallationPolicy -ne 'Trusted') {
      try { Set-PSRepository -Name PSGallery -InstallationPolicy Trusted -ErrorAction Stop } catch {}
    }
    Write-Log "PSGallery available." "Green"
  } catch {
    try {
      Register-PSRepository -Name PSGallery -SourceLocation "https://www.powershellgallery.com/api/v2" `
        -InstallationPolicy Trusted -ErrorAction Stop
      Write-Log "PSGallery registered." "Green"
    } catch {
      Write-Log "PSGallery not available; module auto-install may fail." "Yellow"
    }
  }
}

# ---------- Install/Import helpers ----------
Function Ensure-Module {
  param(
    [Parameter(Mandatory)][string]$Name,
    [string]$MinVersion = "0.0.0"
  )
  $mod = Get-Module -ListAvailable -Name $Name | Sort-Object Version -Descending | Select-Object -First 1
  $needInstall = $true
  if ($mod) {
    try {
      if ([Version]$mod.Version -ge [Version]$MinVersion) { $needInstall = $false }
    } catch { }
  }

  if ($needInstall) {
    Write-Log ("Installing/Updating module: {0}" -f $Name) "Gray"
    try {
      Install-Module -Name $Name -Scope CurrentUser -Force -AllowClobber -MinimumVersion $MinVersion -ErrorAction Stop
    } catch {
      # Fallback: try AllUsers if allowed
      try { Install-Module -Name $Name -Scope AllUsers -Force -AllowClobber -MinimumVersion $MinVersion -ErrorAction Stop } catch { }
    }
  }

  # Import from the newest available
  $mod = Get-Module -ListAvailable -Name $Name | Sort-Object Version -Descending | Select-Object -First 1
  if (-not $mod) { throw "Module $Name not found after install attempt." }
  Import-Module $mod.Path -Force -ErrorAction Stop
  Write-Log ("{0} loaded." -f $Name) "Green"
  return $true
}

