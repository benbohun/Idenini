# ============================================================
# Verify CyberArkDPAConnector SID in Required User Rights
# PowerShell 5.1 compatible
# ============================================================

$ServiceName = "CyberArkDPAConnector"
$ExportPath  = "$env:TEMP\CyberArk_Effective_UserRights.inf"

Write-Host ""
Write-Host "============================================================"
Write-Host " CyberArk DPA Connector - User Rights Verification"
Write-Host "============================================================"
Write-Host ""

# ------------------------------------------------------------
# Get the Service SID
# ------------------------------------------------------------

Write-Host "[INFO] Retrieving SID for service: $ServiceName"

$SidOutput = & sc.exe showsid $ServiceName 2>&1

if ($LASTEXITCODE -ne 0) {
    Write-Host "[ERROR] Unable to retrieve service SID." -ForegroundColor Red
    $SidOutput
    exit 1
}

$ServiceSid = $null

foreach ($Line in $SidOutput) {
    if ($Line -match '(S-1-5-80-(?:\d+-){4}\d+)') {
        $ServiceSid = $Matches[1]
        break
    }
}

if (-not $ServiceSid) {
    Write-Host "[ERROR] Could not parse CyberArkDPAConnector SID." -ForegroundColor Red
    $SidOutput
    exit 1
}

Write-Host "[OK] Service SID: $ServiceSid" -ForegroundColor Green
Write-Host ""

# ------------------------------------------------------------
# Export effective security policy
# ------------------------------------------------------------

Write-Host "[INFO] Exporting effective Windows User Rights Assignment..."

& secedit.exe /export /cfg $ExportPath /quiet

if (-not (Test-Path $ExportPath)) {
    Write-Host "[ERROR] Failed to export security policy." -ForegroundColor Red
    exit 1
}

Write-Host "[OK] Security policy exported to:"
Write-Host "     $ExportPath"
Write-Host ""

# ------------------------------------------------------------
# Required CyberArk privileges
# ------------------------------------------------------------

$RequiredRights = [ordered]@{
    "SeChangeNotifyPrivilege"      = "Bypass traverse checking"
    "SeCreateGlobalPrivilege"      = "Create global objects"
    "SeIncreaseWorkingSetPrivilege" = "Increase a process working set"
    "SeServiceLogonRight"          = "Log on as a service"
}

$PolicyContent = Get-Content $ExportPath

$Results = @()

foreach ($Right in $RequiredRights.Keys) {

    $FriendlyName = $RequiredRights[$Right]

    $PolicyLine = $PolicyContent |
        Where-Object { $_ -match "^\s*$([regex]::Escape($Right))\s*=" } |
        Select-Object -First 1

    $Found = $false

    if ($PolicyLine) {

        if ($PolicyLine -match [regex]::Escape($ServiceSid)) {
            $Found = $true
        }

    }

    $Results += [PSCustomObject]@{
        Privilege    = $Right
        WindowsRight = $FriendlyName
        SIDPresent   = $Found
        Status       = if ($Found) { "PASS" } else { "FAIL" }
    }

    if ($Found) {
        Write-Host "[PASS] $FriendlyName" -ForegroundColor Green
        Write-Host "       $Right"
        Write-Host "       SID found: $ServiceSid"
    }
    else {
        Write-Host "[FAIL] $FriendlyName" -ForegroundColor Red
        Write-Host "       $Right"
        Write-Host "       SID NOT found: $ServiceSid"

        if ($PolicyLine) {
            Write-Host "       Current assignment:"
            Write-Host "       $PolicyLine"
        }
        else {
            Write-Host "       Policy entry was not found in effective security policy."
        }
    }

    Write-Host ""
}

# ------------------------------------------------------------
# Summary
# ------------------------------------------------------------

Write-Host "============================================================"
Write-Host " SUMMARY"
Write-Host "============================================================"

$Results | Format-Table -AutoSize

$Failures = @($Results | Where-Object { -not $_.SIDPresent })

Write-Host ""

if ($Failures.Count -eq 0) {

    Write-Host "SUCCESS: CyberArkDPAConnector SID is present in all 4 required rights." -ForegroundColor Green

}
else {

    Write-Host "FAILED: CyberArkDPAConnector SID is missing from $($Failures.Count) required right(s)." -ForegroundColor Red

    Write-Host ""
    Write-Host "Missing:"
    
    foreach ($Failure in $Failures) {
        Write-Host " - $($Failure.WindowsRight) [$($Failure.Privilege)]" -ForegroundColor Yellow
    }
}

Write-Host ""
Write-Host "Service SID:"
Write-Host $ServiceSid

Write-Host ""
Write-Host "Effective policy file:"
Write-Host $ExportPath

Write-Host ""
