#Requires -Version 5.1
<#
.SYNOPSIS
  Obtain a CyberArk Remote Access (Alero) OAuth access token.
.DESCRIPTION
  Authenticates with an Alero ExternalServiceAccount Client ID and secret.
  Prompts securely for the secret. Does not log or save credentials or tokens.
  Optionally tests GET https://api.alero.io/v2-edge/users/.
.EXAMPLE
  .\Get-AleroAccessToken.ps1
.EXAMPLE
  .\Get-AleroAccessToken.ps1 -TestUsers
.EXAMPLE
  .\Get-AleroAccessToken.ps1 -ShowToken
.NOTES
  Rotate any previously exposed Client Secret before use.
#>
[CmdletBinding()]
param(
    [string]$ClientId = '11eca6ccdea0506089786ddebb283ff5.11f1cd6a52bc8553a1c147917628de2e.ExternalServiceAccount',
    [string]$TokenEndpoint = 'https://auth.alero.io/auth/realms/serviceaccounts/protocol/openid-connect/token',
    [string]$UsersEndpoint = 'https://api.alero.io/v2-edge/users/',
    [switch]$TestUsers,
    [switch]$ShowToken
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
$bstr = [IntPtr]::Zero
$body = $null
$plainSecret = $null
try {
    Write-Host 'CyberArk Remote Access (Alero) Service Account Authentication' -ForegroundColor Cyan
    Write-Host "Token endpoint: $TokenEndpoint"
    Write-Host "Client ID: $ClientId"
    $secureSecret = Read-Host 'Enter Alero Client Secret (input hidden)' -AsSecureString
    if ($secureSecret.Length -eq 0) { throw 'No Client Secret entered.' }

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureSecret)
    $plainSecret = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    $body = @{
        grant_type = 'client_credentials'
        client_assertion_type = 'urn:ietf:params:oauth:client-assertion-type:jwt-bearer'
        client_id = $ClientId
        client_secret = $plainSecret
    }
    Write-Host 'Requesting OAuth access token...' -ForegroundColor Cyan
    $tokenResponse = Invoke-RestMethod -Method Post -Uri $TokenEndpoint -Body $body -ContentType 'application/x-www-form-urlencoded' -ErrorAction Stop
    if ([string]::IsNullOrWhiteSpace($tokenResponse.access_token)) {
        throw 'Token endpoint responded but did not provide access_token.'
    }
    Write-Host 'SUCCESS: Alero access token generated.' -ForegroundColor Green
    if ($tokenResponse.expires_in) { Write-Host "Expires in: $($tokenResponse.expires_in) seconds" }
    Write-Host "Token length: $($tokenResponse.access_token.Length) characters"

    if ($ShowToken) {
        Write-Warning 'The token is sensitive. Avoid copying it to logs, tickets, screenshots or chat.'
        Write-Output "Bearer $($tokenResponse.access_token)"
    }
    if ($TestUsers) {
        Write-Host "Testing GET $UsersEndpoint" -ForegroundColor Cyan
        $headers = @{ Authorization = 'Bearer ' + $tokenResponse.access_token; Accept = 'application/json' }
        $users = Invoke-RestMethod -Method Get -Uri $UsersEndpoint -Headers $headers -ErrorAction Stop
        Write-Host 'SUCCESS: Users API request completed.' -ForegroundColor Green
        Write-Host 'Top-level JSON property names (if object):' -ForegroundColor Cyan
        if ($users -is [array]) {
            Write-Host "Response is an array with $($users.Count) entries."
            if ($users.Count -gt 0) { $users[0].PSObject.Properties.Name | ForEach-Object { Write-Host " - $_" } }
        } else {
            $users.PSObject.Properties.Name | ForEach-Object { Write-Host " - $_" }
        }
        Write-Host 'User values are deliberately not printed to avoid revealing personal information.'
    }
}
catch {
    Write-Host "FAILED: $($_.Exception.Message)" -ForegroundColor Red
    if ($_.Exception.Response) {
        try { Write-Host "HTTP status: $([int]$_.Exception.Response.StatusCode)" -ForegroundColor Red } catch {}
    }
    Write-Host 'Check the account secret, service-account permissions, and matching Alero region.' -ForegroundColor Yellow
    exit 1
}
finally {
    if ($bstr -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr) }
    $plainSecret = $null
    $body = $null
    $secureSecret = $null
}
