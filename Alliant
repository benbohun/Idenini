function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $AppID, $Safe, $Object

    Write-Info "Retrieving **Service User** credential from CCP:"
    Write-Info "  $url"

    $headers = @{ "Content-Type" = "application/json" }
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop

    if (-not $resp.UserName -or -not $resp.Content) {
        throw "CCP response missing UserName/Content. Raw: $($resp | ConvertTo-Json -Depth 5)"
    }

    Write-Ok "CCP returned service user: $($resp.UserName)"

    $sec = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    return [PSCredential]::new($resp.UserName, $sec)
}

# --- NEW: parameter introspection (psPAS version-safe) ---
function Test-CommandHasParameter {
    param(
        [Parameter(Mandatory)][string]$CommandName,
        [Parameter(Mandatory)][string]$ParameterName
    )
    try {
        $cmd = Get-Command $CommandName -ErrorAction Stop
        return ($cmd.Parameters.Keys | Where-Object { $_ -ieq $ParameterName } | Measure-Object).Count -gt 0
    } catch {
        return $false
    }
}

# --- UPDATED: Safe member ensure helper (no more MemberType passed to Set-PASSafeMember) ---
function Ensure-SafeMember {
    [CmdletBinding(SupportsShouldProcess=$true)]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberName,      # sAM or UPN
        [Parameter()][ValidateSet('User','Group','Role')][string]$MemberType = $null,
        [Parameter(Mandatory)][hashtable]$PermFlags,
        [Parameter()][string]$SearchIn = $null
    )

    Write-Info "Processing member '$MemberName' on '$SafeName'..."

    # Build perm params splat
    $permParams = @{}
    foreach ($k in $PermFlags.Keys) { $permParams[$k] = $PermFlags[$k] }

    # 1) Detect existing membership (works across psPAS versions)
    $existing = $null
    try {
        # Try direct MemberName query if supported, else list + filter
        if (Test-CommandHasParameter -CommandName 'Get-PASSafeMember' -ParameterName 'MemberName') {
            try { $existing = Get-PASSafeMember -SafeName $SafeName -MemberName $MemberName -ErrorAction Stop } catch {}
        }
        if (-not $existing) {
            $all = Get-PASSafeMember -SafeName $SafeName -ErrorAction Stop
            $existing = $all | Where-Object {
                ($_.MemberName -eq $MemberName) -or ($_.memberName -eq $MemberName) -or ($_.UserName -eq $MemberName)
            } | Select-Object -First 1
        }
    } catch {
        # If we cannot list members (permissions), we still try add/update blindly.
        $existing = $null
    }

    if ($existing) {
        # UPDATE PATH (NO MemberType HERE)
        $setSplat = @{
            SafeName   = $SafeName
            MemberName = $MemberName
        }
        $setSplat += $permParams

        if ($PSCmdlet.ShouldProcess("$SafeName/$MemberName", "Set-PASSafeMember (update perms)")) {
            try {
                Set-PASSafeMember @setSplat -ErrorAction Stop | Out-Null
                Write-Ok "Updated '$MemberName' on '$SafeName'."
                return $true
            } catch {
                Write-Err "Update failed for '$MemberName' on '$SafeName': $($_.Exception.Message)"
                return $false
            }
        }
        return $true
    }

    # ADD PATH (SearchIn and memberType are OPTIONAL and version-dependent)
    $addSupportsSearchIn  = Test-CommandHasParameter -CommandName 'Add-PASSafeMember' -ParameterName 'SearchIn'
    $addSupportsMemberType = (Test-CommandHasParameter -CommandName 'Add-PASSafeMember' -ParameterName 'memberType') -or
                             (Test-CommandHasParameter -CommandName 'Add-PASSafeMember' -ParameterName 'MemberType')

    $searchCandidates = New-Object System.Collections.Generic.List[string]
    if ($SearchIn) {
        $searchCandidates.Add($SearchIn)
    } else {
        $searchCandidates.Add('Vault')
        if ($MemberName -like '*@*') {
            $domainPart = ($MemberName.Split('@')[-1]).Trim()
            if ($domainPart) { $searchCandidates.Add($domainPart) }
        }
        $searchCandidates.Add($null)  # final fallback: no SearchIn
    }

    $lastErr = $null
    foreach ($cand in $searchCandidates) {
        $addSplat = @{
            SafeName   = $SafeName
            MemberName = $MemberName
        }
        $addSplat += $permParams

        if ($addSupportsSearchIn -and $cand) {
            $addSplat['SearchIn'] = $cand
        }

        if ($addSupportsMemberType -and $MemberType) {
            # psPAS uses "memberType" in newer versions; PowerShell is case-insensitive
            $addSplat['memberType'] = $MemberType
        }

        $hint = if ($cand) { "SearchIn=$cand" } else { "SearchIn=<none>" }
        Write-Info "Adding member '$MemberName' to '$SafeName' ($hint)..."

        if ($PSCmdlet.ShouldProcess("$SafeName/$MemberName", "Add-PASSafeMember")) {
            try {
                Add-PASSafeMember @addSplat -ErrorAction Stop | Out-Null
                Write-Ok "Added '$MemberName' to '$SafeName' ($hint)."
                return $true
            } catch {
                $lastErr = $_.Exception.Message
                Write-Warn "Add attempt failed for '$MemberName' ($hint): $lastErr"
                continue
            }
        } else {
            return $true
        }
    }

    Write-Err "Failed to add '$MemberName' to '$SafeName'. Last error: $lastErr"
    return $false
}

function Onboard-AdminAccount {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][string]$OwnerEmail,
        [Parameter(Mandatory)][string]$AdminAddressDomain
    )

    $sam   = $SamAccountName.Trim()
    $email = $OwnerEmail.Trim()
    $addr  = $AdminAddressDomain.Trim()

    if (-not $sam -or -not $email -or -not $addr) {
        Write-Warn "Admin onboarding skipped: missing Sam, email, or address domain."
        return
    }

    $platformId  = $null
    $logonDomain = $null
    $emailLower = $email.ToLower()

    if ($emailLower.EndsWith("@alliantcreditunion.com")) {
        $platformId  = "WIN_P_DM_ACU_ADM_OTP_CICO_30D"
        $logonDomain = "ACU"
    }
    elseif ($emailLower.EndsWith("@extacu.local")) {
        $platformId  = "WIN_P_DM_GDE_ADM_OTP_CICO_30D"
        $logonDomain = "extacu.local"
    }
    elseif ($emailLower.EndsWith("@gdeacu.com")) {
        $platformId  = "WIN_P_DM_GDE_ADM_OTP_CICO_30D"
        $logonDomain = "gdeacu.com"
    }
    else {
        Write-Warn ("Owner email '{0}' does not match any known domain mapping; admin account not onboarded." -f $email)
        return
    }

    $adminUser = "A_{0}" -f $sam
    Write-Info ("Preparing to onboard Admin account '{0}' to Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})..." -f $adminUser, $SafeName, $platformId, $addr, $logonDomain)

    $existingAcct = $null
    try {
        $existingAcct = Get-PASAccount -SafeName $SafeName -Search $adminUser -ErrorAction SilentlyContinue |
                        Where-Object { $_.UserName -eq $adminUser -and $_.Address -eq $addr }
    } catch {}

    if ($existingAcct) {
        Write-Warn ("Admin account '{0}' already exists in Safe '{1}' with Address '{2}' – skipping onboard." -f $adminUser, $SafeName, $addr)
        return
    }

    $platformProps = @{
        LogonDomain  = $logonDomain
        LogonAccount = $logonDomain
    }

    $acctSplat = @{
        SafeName                  = $SafeName
        PlatformID                = $platformId
        Address                   = $addr
        UserName                  = $adminUser
        PlatformAccountProperties = $platformProps
    }

    if ($PSCmdlet.ShouldProcess(("{0}/{1}" -f $SafeName, $adminUser), "Add-PASAccount")) {
        try {
            Add-PASAccount @acctSplat -ErrorAction Stop | Out-Null
            Write-Ok ("Onboarded admin account '{0}' in Safe '{1}' (Platform={2}, Address={3}, LogonDomain={4})." -f $adminUser, $SafeName, $platformId, $addr, $logonDomain)
        }
        catch {
            Write-Err ("Failed to onboard admin account '{0}' in Safe '{1}': {2}" -f $adminUser, $SafeName, $_.Exception.Message)
        }
    }
}

function Process-INDRow {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SamAccountName,
        [Parameter(Mandatory)][string]$EmployeeID,
        [Parameter(Mandatory)][string]$OwnerEmail,
        [Parameter(Mandatory)][string]$AdminAddressDomain
    )

    $sam  = $SamAccountName.Trim()
    $eid  = $EmployeeID.Trim()
    $mail = $OwnerEmail.Trim()

    if ([string]::IsNullOrWhiteSpace($sam) -or
        [string]::IsNullOrWhiteSpace($eid) -or
        [string]::IsNullOrWhiteSpace($mail)) {
        Write-Warn "Skipping row with missing fields: Sam='$sam' EmployeeID='$eid' Email='$mail'"
        return
    }

    $safeName = "IND_{0}_{1}" -f $sam, $eid
    Write-Info "Processing Safe: $safeName (Owner=$mail)"

    # Safe create/ensure
    $exists = $null
    try { $exists = Get-PASSafe -SafeName $safeName -ErrorAction SilentlyContinue } catch {}

    if (-not $exists) {
        $splat = @{
            SafeName              = $safeName
            Description           = "Individual safe for $sam ($eid)"
            ManagingCPM           = $ManagingCPM
            NumberOfDaysRetention = 7
            Location              = $Location
        }
        if ($PSCmdlet.ShouldProcess($safeName, "Add-PASSafe")) {
            try {
                Add-PASSafe @splat -ErrorAction Stop | Out-Null
                Write-Ok "Created Safe '$safeName'."
            } catch {
                Write-Err "Failed to create Safe '$safeName' : $($_.Exception.Message)"
                return
            }
        }
    }
    else {
        Write-Warn "Safe '$safeName' already exists; ensuring retention & members."
        try {
            Set-PASSafe -SafeName $safeName -NumberOfDaysRetention 7 -ErrorAction SilentlyContinue | Out-Null
            Write-Ok "Ensured 7-day retention on '$safeName'."
        } catch {
            Write-Warn "Could not set retention on existing '$safeName': $($_.Exception.Message)"
        }
    }

    $permAdmin = Get-AdminPerms
    $permOwner = Get-OwnerPerms

    # IAM group
    $iamUpn = 'IAM_ACU_CA_Admins@alliantcreditunion.com'
    $iamSam = 'IAM_ACU_CA_Admins'

    Write-Info "Ensuring IAM_ACU_CA_Admins membership on '$safeName'..."
    $okIam = $false

    # Try UPN then sAM; do NOT throw—log and continue
    $okIam = Ensure-SafeMember -SafeName $safeName -MemberName $iamUpn -MemberType Group -PermFlags $permAdmin
    if (-not $okIam) {
        Write-Warn "Retrying IAM group with sAMAccountName '$iamSam'..."
        $okIam = Ensure-SafeMember -SafeName $safeName -MemberName $iamSam -MemberType Group -PermFlags $permAdmin
    }
    if ($okIam) { Write-Ok "IAM_ACU_CA_Admins membership ensured on '$safeName'." }
    else        { Write-Warn "IAM_ACU_CA_Admins could not be ensured on '$safeName' (continuing...)." }

    # Owner user
    Write-Info "Ensuring Owner '$mail' membership on '$safeName'..."
    $okOwner = Ensure-SafeMember -SafeName $safeName -MemberName $mail -MemberType User -PermFlags $permOwner

    if (-not $okOwner -and $mail -like '*@*') {
        $ownerSam = $mail.Split('@')[0]
        Write-Warn "Retrying Owner with sAM '$ownerSam'..."
        $okOwner = Ensure-SafeMember -SafeName $safeName -MemberName $ownerSam -MemberType User -PermFlags $permOwner
    }

    if ($okOwner) {
        $ownerNoDomain = $mail.Split('@')[0]
        try {
            $desc = "Individual safe for $sam ($eid) – Managed By $ownerNoDomain"
            Set-PASSafe -SafeName $safeName -Description $desc -ErrorAction Stop | Out-Null
            Write-Ok "Description set on '$safeName': '$desc'"
        } catch {
            Write-Warn "Could not set description on '$safeName': $($_.Exception.Message)"
        }
    } else {
        Write-Warn "Owner membership could not be ensured on '$safeName' (continuing...)."
    }

    # Admin onboarding
    Onboard-AdminAccount -SafeName $safeName -SamAccountName $sam -OwnerEmail $mail -AdminAddressDomain $AdminAddressDomain
    Write-Ok "Completed processing '$safeName'."
}

# --- MAIN ---
$sessionCreated     = $false
$AdminAddressDomain = $null
$runSummary         = New-Object System.Collections.Generic.List[object]

try {
    $serviceCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location   $CCPLocation `
        -AppID      $CCPAppID `
        -Safe       $CCPSafe `
        -Object     $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Info "Authenticating to Privilege Cloud via Identity (Service User)..."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential        $serviceCred `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    $session = Get-PASSession
    if (-not $session) { throw "psPAS session not established via ServiceUser." }

    $sessionCreated = $true
    Write-Ok "Authenticated to $PrivilegeCloudURL as service user: $($serviceCred.UserName)"

    $AdminAddressDomain = Get-AdminAddressDomain
    Write-Ok "Admin Address domain set to: $AdminAddressDomain"

    if ($Mode -eq 'CSV') {
        Write-Info "Mode = CSV. Loading: $CsvPath"
        if (-not (Test-Path $CsvPath)) { throw "CSV not found: $CsvPath" }

        $rows = Import-Csv -Path $CsvPath
        if (-not $rows -or $rows.Count -eq 0) { throw "CSV '$CsvPath' has no rows." }

        foreach ($row in $rows) {
            $sam  = ($row.Samaccountname).ToString()
            $eid  = ($row.employeeID).ToString()
            $mail = ($row.email).ToString()

            try {
                Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail -AdminAddressDomain $AdminAddressDomain
                $runSummary.Add([pscustomobject]@{ Sam=$sam; EmployeeID=$eid; Email=$mail; Status='OK'; Error='' })
            }
            catch {
                # Row-level catch: do not terminate session, keep going
                $err = $_.Exception.Message
                Write-Err "Row failed (Sam='$sam', EmployeeID='$eid', Email='$mail'): $err"
                $runSummary.Add([pscustomobject]@{ Sam=$sam; EmployeeID=$eid; Email=$mail; Status='FAILED'; Error=$err })
                continue
            }
        }

        $okCount = ($runSummary | Where-Object Status -eq 'OK').Count
        $badCount = ($runSummary | Where-Object Status -eq 'FAILED').Count
        Write-Ok "CSV processing completed. OK=$okCount FAILED=$badCount Total=$($runSummary.Count)"
    }
    else {
        Write-Info "Mode = Single. Prompting for one IND_ Safe owner..."

        $sam = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter SamAccountName (e.g. jdoe)" `
            -Default "" `
            -ValidationHint "SamAccountName only" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }
        if (-not $sam) { Write-Warn "Cancelled (SamAccountName)."; return }

        $eid = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter employeeID" `
            -Default "" `
            -ValidationHint "HR/AD employeeID" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }
        if (-not $eid) { Write-Warn "Cancelled (employeeID)."; return }

        $mail = Show-InputDialog -Title "IND Safe Owner" `
            -Prompt "Enter owner email (UPN)" `
            -Default "" `
            -ValidationHint "Example: user@alliantcreditunion.com" `
            -ValidateScript { param($x) -not [string]::IsNullOrWhiteSpace($x.Trim()) }
        if (-not $mail) { Write-Warn "Cancelled (email)."; return }

        Process-INDRow -SamAccountName $sam -EmployeeID $eid -OwnerEmail $mail -AdminAddressDomain $AdminAddressDomain
    }
}
catch {
    Write-Err $_.Exception.Message
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Ok "Logged off."
        } catch {
            Write-Warn "Logoff warning: $($_.Exception.Message)"
        }
    }
}
