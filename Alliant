#requires -Version 5.1
#requires -RunAsAdministrator
<#
.SYNOPSIS
  Fixes the PAM Daily Health Check DEV allowlist to support one- or two-octet
  IPv4 prefixes such as 10.* and 10.21.*. No IIS or CCP changes.
.NOTES
  10.* covers the entire 10.0.0.0/8 private network. This is NOT authentication.
  Use only within an independently restricted DEV network.
#>
[CmdletBinding()]
param([string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck')

$ErrorActionPreference = 'Stop'
$page = Join-Path $WebRoot 'Default.aspx'
$config = Join-Path $WebRoot 'web.config'
if (-not (Test-Path -LiteralPath $page -PathType Leaf)) { throw "Missing file: $page" }
if (-not (Test-Path -LiteralPath $config -PathType Leaf)) { throw "Missing file: $config" }

$bytes = [System.IO.File]::ReadAllBytes($page)
$enc = New-Object System.Text.UTF8Encoding($false)
if ($bytes.Length -ge 2 -and $bytes[0] -eq 255 -and $bytes[1] -eq 254) {
    $enc = [System.Text.Encoding]::Unicode
} elseif ($bytes.Length -ge 3 -and $bytes[0] -eq 239 -and $bytes[1] -eq 187 -and $bytes[2] -eq 191) {
    $enc = New-Object System.Text.UTF8Encoding($true)
}
$source = $enc.GetString($bytes)
if ($source.Length -gt 0 -and [int]$source[0] -eq 0xFEFF) { $source = $source.Substring(1) }

if (-not $source.Contains('PAM_DEV_ANON_GUARD_V1')) {
    throw 'Expected DEV IP guard not found. No change made.'
}
if (-not $source.Contains('PAM_DEV_IP_WILDCARD_V1')) {
    throw 'Expected prior two-octet wildcard patch not found. No change made.'
}

$original = @'
              string[] octets = prefix.Split('.');
              if (octets.Length != 2) return false;
              byte a, b;
              if (!Byte.TryParse(octets[0], out a) || !Byte.TryParse(octets[1], out b)) return false;
              System.Net.IPAddress parsed;
              if (!System.Net.IPAddress.TryParse(remoteIp, out parsed) ||
                  parsed.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork) return false;
              byte[] ipBytes = parsed.GetAddressBytes();
              return ipBytes[0] == a && ipBytes[1] == b;
'@
$replacement = @'
              string[] octets = prefix.Split('.');
              // Support 10.* and 10.21.* while rejecting a bare *.
              if (octets.Length != 1 && octets.Length != 2) return false;
              byte a, b = 0;
              if (!Byte.TryParse(octets[0], out a)) return false;
              if (octets.Length == 2 && !Byte.TryParse(octets[1], out b)) return false;
              System.Net.IPAddress parsed;
              if (!System.Net.IPAddress.TryParse(remoteIp, out parsed) ||
                  parsed.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork) return false;
              byte[] ipBytes = parsed.GetAddressBytes();
              return ipBytes[0] == a && (octets.Length == 1 || ipBytes[1] == b);
'@

# Normalize only newlines for matching; preserve original line-ending convention.
$unixSource = $source.Replace("`r`n", "`n")
$oldUnix = $original.Replace("`r`n", "`n")
$newUnix = $replacement.Replace("`r`n", "`n")
if ($unixSource.Contains('Support 10.* and 10.21.* while rejecting a bare *')) {
    Write-Host 'One-octet wildcard support is already installed. No files changed.' -ForegroundColor Yellow
    exit 0
}
$matchCount = ([regex]::Matches($unixSource, [regex]::Escape($oldUnix))).Count
if ($matchCount -ne 1) {
    throw "Expected old wildcard code exactly once; found $matchCount. No files changed."
}

$backup = Join-Path $env:ProgramData ('PAMDailyHealthCheck\ConfigBackups\Wildcard10-' + (Get-Date -Format 'yyyyMMdd-HHmmss'))
New-Item -ItemType Directory -Path $backup -Force -ErrorAction Stop | Out-Null
Copy-Item -LiteralPath $page -Destination (Join-Path $backup 'Default.aspx') -ErrorAction Stop
Copy-Item -LiteralPath $config -Destination (Join-Path $backup 'web.config') -ErrorAction Stop

try {
    $updated = $unixSource.Replace($oldUnix, $newUnix)
    if ($source.Contains("`r`n")) { $updated = $updated.Replace("`n", "`r`n") }
    [System.IO.File]::WriteAllText($page, $updated, $enc)
    Write-Host 'SUCCESS: Added support for 10.* and 10.21.* in Default.aspx' -ForegroundColor Green
    Write-Host "Backup: $backup"
    Write-Host 'Your existing DevAllowedClientIPs entry in web.config was NOT changed.'
    Write-Host 'A bare * remains unsupported.'
    Write-Warning '10.* covers all of 10.0.0.0/8; use independent network restrictions and restore authenticated sign-in before production.'
} catch {
    Copy-Item -LiteralPath (Join-Path $backup 'Default.aspx') -Destination $page -Force
    throw
}
