
$AuthorizedGroup = "YOURDOMAIN\PAM-Ops-Admins"
$ConfigPath = "C:\inetpub\PAMDailyHealthCheck\web.config"

# Preserve current configuration.
$BackupPath = "$ConfigPath.bak-$(Get-Date -Format 'yyyyMMdd-HHmmss')"
Copy-Item $ConfigPath $BackupPath -ErrorAction Stop

# Update ASP.NET Windows authorization.
[xml]$Config = Get-Content $ConfigPath -ErrorAction Stop
$Auth = $Config.configuration.'system.web'.authorization

$Auth.RemoveAll()

$Allow = $Config.CreateElement("allow")
$Allow.SetAttribute("roles", $AuthorizedGroup)
[void]$Auth.AppendChild($Allow)

$Deny = $Config.CreateElement("deny")
$Deny.SetAttribute("users", "*")
[void]$Auth.AppendChild($Deny)

$Config.Save($ConfigPath)

# Configure authentication only for PAMHealthCheck.
Import-Module WebAdministration

$Location = "Default Web Site/PAMHealthCheck"

Set-WebConfigurationProperty `
    -PSPath "MACHINE/WEBROOT/APPHOST" `
    -Location $Location `
    -Filter "system.webServer/security/authentication/windowsAuthentication" `
    -Name enabled -Value $true

Set-WebConfigurationProperty `
    -PSPath "MACHINE/WEBROOT/APPHOST" `
    -Location $Location `
    -Filter "system.webServer/security/authentication/anonymousAuthentication" `
    -Name enabled -Value $false

Write-Host "PAM Health Check group updated to $AuthorizedGroup"
Write-Host "Configuration backup: $BackupPath"
