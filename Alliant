#requires -Version 5.1
<#
.SYNOPSIS
Updates only two visible labels in the existing PAM Daily Health Check dashboard.
Does not read/change web.config, IIS authentication, allowed IPs, audit attribution,
or the evidence upload behavior.
#>
[CmdletBinding()]
param(
    [string]$WebRoot = 'C:\inetpub\PAMDailyHealthCheck'
)

$ErrorActionPreference = 'Stop'
$aspx = Join-Path $WebRoot 'Default.aspx'
if (-not [System.IO.File]::Exists($aspx)) { throw "Default.aspx not found: $aspx" }

# Read with BOM-aware UTF-8. The deployed page is a UTF-8 source file.
$encoding = New-Object System.Text.UTF8Encoding($true)
$original = [System.IO.File]::ReadAllText($aspx, [System.Text.Encoding]::UTF8)
$updated = $original

# The header remains informational only; the actual anonymous/IP audit value is unchanged.
$oldHeader = 'Signed in: <strong>"+H(Context.User.Identity.Name)+"</strong> | Server-local time:'
$newHeader = 'Signed in as <strong>CNA PAM Admin</strong> | Server-local time:'
if ($updated.Contains($oldHeader)) {
    $updated = $updated.Replace($oldHeader, $newHeader)
} elseif (-not $updated.Contains($newHeader)) {
    throw 'Cannot locate expected dashboard header. File has not been changed.'
}

# Change only the text within the Completed submit button, not its tag/attributes.
$pattern = '(?is)(<button\b[^>]*\bname\s*=\s*["'']outcome["''][^>]*\bvalue\s*=\s*["'']Completed["''][^>]*>)(.*?)(</button>)'
$matches = [System.Text.RegularExpressions.Regex]::Matches($updated, $pattern)
if ($matches.Count -ne 1) {
    throw "Expected one Completed button; found $($matches.Count). File has not been changed."
}
$updated = [System.Text.RegularExpressions.Regex]::Replace(
    $updated, $pattern,
    [System.Text.RegularExpressions.MatchEvaluator]{ param($m)
        $m.Groups[1].Value + 'Complete &amp; Upload Evidence' + $m.Groups[3].Value
    }
)

if ($updated -eq $original) {
    Write-Host 'The UI labels are already current. No changes made.' -ForegroundColor Green
    return
}

$backupDir = Join-Path $WebRoot 'UIBackups'
if (-not (Test-Path -LiteralPath $backupDir)) {
    [void](New-Item -ItemType Directory -Path $backupDir -Force)
}
$backup = Join-Path $backupDir ('Default.aspx.' + (Get-Date -Format 'yyyyMMdd-HHmmss-fff') + '.bak')
[System.IO.File]::Copy($aspx, $backup, $false)
try {
    [System.IO.File]::WriteAllText($aspx, $updated, $encoding)
} catch {
    [System.IO.File]::Copy($backup, $aspx, $true)
    throw
}

Write-Host 'PAM Health Check UI labels updated.' -ForegroundColor Green
Write-Host 'Header: Signed in as CNA PAM Admin | Server-local time: [live server time]'
Write-Host 'Button: Complete & Upload Evidence'
Write-Host "Backup: $backup"
Write-Host 'IP allowlist, web.config, IIS settings, evidence handling, and audit attribution were not changed.'
Write-Warning 'CNA PAM Admin is a display label, not an authenticated user. DEV anonymous/IP-restricted mode remains in effect.'
Write-Host 'Refresh your browser with Ctrl+F5.'
