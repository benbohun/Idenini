$Sid = (
    sc.exe showsid CyberArkDPAConnector |
    Select-String 'S-1-5-80-' |
    ForEach-Object {
        if ($_.Line -match '(S-1-5-80-[0-9-]+)') {
            $Matches[1]
        }
    }
)

Write-Host "CyberArk service SID: $Sid" -ForegroundColor Cyan
Write-Host ""

$Rights = @(
    "SeChangeNotifyPrivilege",
    "SeCreateGlobalPrivilege",
    "SeIncreaseWorkingSetPrivilege",
    "SeServiceLogonRight"
)

$Policy = Get-Content C:\Temp\EffectiveRights.inf

foreach ($Right in $Rights) {

    $Line = $Policy |
        Where-Object { $_ -match "^$Right\s*=" } |
        Select-Object -First 1

    Write-Host "===================================================="

    if (-not $Line) {
        Write-Host "$Right : POLICY NOT PRESENT" -ForegroundColor Red
        continue
    }

    Write-Host "$Line"
    Write-Host ""

    if ($Line -match [regex]::Escape($Sid)) {
        Write-Host "$Right : SID PRESENT" -ForegroundColor Green
    }
    elseif ($Line -match "CyberArkDPAConnector") {
        Write-Host "$Right : Service account name PRESENT" -ForegroundColor Green
    }
    else {
        Write-Host "$Right : SID MISSING FROM EFFECTIVE POLICY" -ForegroundColor Red
    }
}

Write-Host "===================================================="
