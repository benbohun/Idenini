# --- Quick reachability check (no identifiers in output) ---
Function Test-IdentityPreflight {
  param([Parameter(Mandatory)][string]$Tenant)
  try {
    $url = ("https://" + $Tenant.TrimEnd('/')).TrimEnd('/') + "/.well-known/openid-configuration"
    $r = Invoke-WebRequest -Uri $url -Method Head -TimeoutSec 12 -ErrorAction Stop
    Write-Log "Identity endpoint reachable." "Green"
    if ($r.Headers.Date) {
      $srv = [DateTime]::Parse($r.Headers.Date).ToUniversalTime()
      $loc = (Get-Date).ToUniversalTime()
      $skew = [math]::Round(($loc - $srv).TotalSeconds,0)
      if ([math]::Abs($skew) -gt 300) { Write-Log "Clock skew > 5 min; sync time." "Yellow" }
    }
  } catch { Write-Log "Identity endpoint not reachable." "Red"; throw }
}

# --- CCP: pull secret -> secure PSCredential ($Cred) ---
Function Get-CCPCredentialByObject {
  param([Parameter(Mandatory)][string]$ObjectName,[Parameter(Mandatory)][string]$UPUser)
  try {
    $url  = "$CCPAddress/$Location/api/Accounts?AppID=$AppID&Safe=$SafeForCCP&Object=$ObjectName"
    $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $Headers -UseDefaultCredentials:$WindowsAuth
    if (-not $resp -or -not $resp.Content) { throw "Empty CCP response" }
    $sec  = ConvertTo-SecureString $resp.Content -AsPlainText -Force
    $Cred = [PSCredential]::new($UPUser, $sec)
    $resp.Content = $null; Remove-Variable sec -ErrorAction SilentlyContinue
    Write-Log "Credential retrieved securely." "Green"
    return $Cred
  } catch { Write-Log "Credential retrieval failed." "Red"; throw }
}

