# ---------- Resolve a callable Identity Header cmdlet ----------
Function Resolve-IdentityHeader {
  $names = @(
    'Get-IdentityHeader',
    'CyberArk.IdentityCommand\Get-IdentityHeader',
    'Get-PASIdentityHeader',
    'New-IdentityHeader',
    'New-PASIdentityHeader'
  )
  foreach ($n in $names) {
    $c = Get-Command $n -ErrorAction SilentlyContinue
    if ($c) { return $c }
  }
  $mods = @('psPAS','IdentityCommand')
  $cands = Get-Command -Module $mods -ErrorAction SilentlyContinue | Where-Object { $_.Name -match 'Identity' -and $_.Name -match 'Header' }
  if ($cands) { return $cands | Select-Object -First 1 }
  return $null
}

# ---------- Identity error sanitizer ----------
Function Get-SafeIdentityErrorText {
  param([object]$Exception)
  $status = $null; $body = $null
  if ($Exception.PSObject.Properties.Name -contains 'Response' -and $Exception.Response) {
    try { $status = [int]$Exception.Response.StatusCode } catch {}
    try {
      $stream = $Exception.Response.GetResponseStream()
      if ($stream) {
        $reader = New-Object System.IO.StreamReader($stream)
        $raw = $reader.ReadToEnd()
        if ($raw) {
          try { $json = $raw | ConvertFrom-Json -ErrorAction Stop } catch { $json = $null }
          if ($json) {
            $err  = $json.error
            $desc = $json.error_description
            if (-not $desc -and $json.message) { $desc = $json.message }
            $body = ($err, $desc) -join ' | '
          } else { $body = $raw }
        }
      }
    } catch {}
  }
  if (-not $body) { $body = $Exception.Message }
  $body = $body -replace '(?i)https?://\S+','[redacted-url]'
  $body = $body -replace '(?i)[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}','[redacted-email]'
  $body = $body -replace '(?i)([A-Z0-9-]+\.)+(com|net|org|cloud|local|io)\b','[redacted-host]'
  $body = $body -replace '(?i)\b[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}\b','[redacted-guid]'
  $body = $body -replace '(?i)access_token|id_token|refresh_token','[redacted-token]'
  $body = $body -replace '\s{2,}',' '
  $prefix = if ($status) { "HTTP $status - " } else { "" }
  return ($prefix + $body)
}

