function Add-CyberArkPortalManualChecks {
    [CmdletBinding()]
    param([string]$Component)

    $platformName = switch ($Component) {
        'ScheduledTask' { 'Scheduled Task' }
        'WindowsService' { 'Windows Service' }
        'IISAppPool' { 'IIS Application Pool' }
    }

    Add-Result -Component $Component -Category 'CyberArk configuration' -Check 'Dependent platform available' -Status 'SKIP' `
        -Details ("Target-side validation cannot confirm that the '{0}' dependent platform is displayed and active in Platform Management." -f $platformName) `
        -Recommendation ("Confirm the '{0}' platform in Privilege Cloud Platform Management." -f $platformName)

    $logonType = if ($ManagedAccount -and (Test-AccountMatch -Expected $ManagingAccount -Actual $ManagedAccount)) {
        'No separate linked Logon Account is indicated; CyberArk will normally use the primary managed Windows account to access the dependency server.'
    }
    elseif ($ManagedAccount) {
        "The intended managing account '$ManagingAccount' differs from managed account '$ManagedAccount', which indicates a linked Logon Account design."
    }
    else {
        "The intended managing account is '$ManagingAccount'. Supply -ManagedAccount to distinguish a linked Logon Account from the primary account."
    }

    Add-Result -Component $Component -Category 'CyberArk configuration' -Check 'Primary versus linked Logon Account' -Status 'INFO' `
        -Details $logonType `
        -Recommendation 'Confirm the dependency Account Details and linked Logon Account configuration in Privilege Cloud. The connecting account requires remote access and password-reset capability as documented by CyberArk.'
}

function Test-ScheduledTaskComponent {
    try {
        Import-Module ScheduledTasks -ErrorAction Stop
        $tasks = @(Get-ScheduledTask -CimSession $script:CimSession -ErrorAction Stop)
        Add-Result -Component 'ScheduledTask' -Category 'Access' -Check 'Remote task enumeration' -Status 'PASS' `
            -Details ("Enumerated {0} Scheduled Task(s)." -f $tasks.Count)

        $specificTasks = @()
        if ($ScheduledTaskName) {
            $specificTasks = @($tasks | Where-Object {
                $_.TaskName -ieq $ScheduledTaskName -and $_.TaskPath -ieq $ScheduledTaskPath
            })

            if ($specificTasks.Count -eq 0) {
                Add-Result -Component 'ScheduledTask' -Category 'Resource' -Check 'Specified task' -Status 'FAIL' `
                    -Details ("Task '{0}{1}' was not found." -f $ScheduledTaskPath, $ScheduledTaskName) `
                    -Recommendation 'Confirm the exact TaskName and TaskPath configured on the CyberArk dependent account.'
            }
            else {
                foreach ($task in $specificTasks) {
                    $runAs = [string]$task.Principal.UserId
                    $logonType = [string]$task.Principal.LogonType
                    Add-Result -Component 'ScheduledTask' -Category 'Resource' -Check 'Specified task' -Status 'PASS' `
                        -Details ("Found '{0}{1}'; state: {2}; Run As: '{3}'; logon type: {4}." -f $task.TaskPath, $task.TaskName, $task.State, $runAs, $logonType)

                    if ($ManagedAccount) {
                        $status = if (Test-AccountMatch -Expected $ManagedAccount -Actual $runAs) { 'PASS' } else { 'FAIL' }
                        Add-Result -Component 'ScheduledTask' -Category 'Identity' -Check 'Managed account match' -Status $status `
                            -Details ("Expected '{0}'; task uses '{1}'." -f $ManagedAccount, $runAs) `
                            -Recommendation $(if ($status -eq 'FAIL') { 'Correct the CyberArk dependency or the task Run As identity before rotation.' } else { '' })
                    }

                    if ($logonType -match 'Password|InteractiveOrPassword') {
                        Add-Result -Component 'ScheduledTask' -Category 'Password storage' -Check 'Task logon type' -Status 'PASS' `
                            -Details ("Logon type '{0}' supports a password stored with the task." -f $logonType)
                    }
                    else {
                        Add-Result -Component 'ScheduledTask' -Category 'Password storage' -Check 'Task logon type' -Status 'WARN' `
                            -Details ("Logon type is '{0}'. CyberArk cannot update a password that is stored separately from the task or not stored by the task." -f $logonType) `
                            -Recommendation 'Confirm the task is configured to run whether the user is logged on or not and stores the managed account password in Task Scheduler.'
                    }
                }
            }
        }

        if ($ManagedAccount) {
            $matching = @($tasks | Where-Object { Test-AccountMatch -Expected $ManagedAccount -Actual ([string]$_.Principal.UserId) })
            Add-Result -Component 'ScheduledTask' -Category 'Discovery' -Check 'Tasks using managed account' -Status 'INFO' `
                -Details ("Found {0} task(s) using an identity matching '{1}': {2}" -f $matching.Count, $ManagedAccount, (($matching | ForEach-Object { $_.TaskPath + $_.TaskName }) -join '; '))
        }

        if ($PerformWriteTest) {
            $name = 'CyberArkPrereqTask_{0}' -f ([guid]::NewGuid().ToString('N').Substring(0, 10))
            try {
                $action = New-ScheduledTaskAction -Execute 'cmd.exe' -Argument '/d /c exit 0'
                $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddDays(7)
                $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
                Register-ScheduledTask -CimSession $script:CimSession -TaskName $name -TaskPath '\' -Action $action -Trigger $trigger -Principal $principal -Description 'Temporary CyberArk prerequisite write test. Do not run.' -Force | Out-Null

                $created = Get-ScheduledTask -CimSession $script:CimSession -TaskName $name -TaskPath '\' -ErrorAction Stop
                Unregister-ScheduledTask -CimSession $script:CimSession -TaskName $name -TaskPath '\' -Confirm:$false -ErrorAction Stop

                if ($created) {
                    Add-Result -Component 'ScheduledTask' -Category 'Write test' -Check 'Create/delete temporary task' -Status 'PASS' `
                        -Details ("Created and removed temporary task '\{0}'. It was never started." -f $name)
                }
            }
            catch {
                try { Unregister-ScheduledTask -CimSession $script:CimSession -TaskName $name -TaskPath '\' -Confirm:$false -ErrorAction SilentlyContinue } catch {}
                Add-Result -Component 'ScheduledTask' -Category 'Write test' -Check 'Create/delete temporary task' -Status 'FAIL' `
                    -Details ("Scheduled Task write test failed: {0}" -f $_.Exception.Message) `
                    -Recommendation 'Verify effective local Administrators access and Remote Scheduled Tasks Management RPC/firewall policy.'
            }
        }
    }
    catch {
        Add-Result -Component 'ScheduledTask' -Category 'Access' -Check 'Remote task enumeration' -Status 'FAIL' `
            -Details ("Unable to enumerate Scheduled Tasks: {0}" -f $_.Exception.Message) `
            -Recommendation 'Enable Client/File Sharing bindings, Remote Scheduled Tasks Management rules, Task Scheduler/RPC services, and local Administrators access.'
    }
}

