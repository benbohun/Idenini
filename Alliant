#requires -Version 5.1
<#
.SYNOPSIS
    Validates and optionally fixes CyberArk CPM prerequisites for Windows Scheduled Tasks,
    Windows Services, and IIS Application Pool dependent accounts.

.DESCRIPTION
    Run this script from the CyberArk CPM server for the most representative validation.
    When started without account or target parameters, the script prompts for the target FQDN
    and service account, then securely prompts for that account's password.
    Validation is read-only by default. Use -Fix to apply supported remediations.

    Supported validations:
      - Target FQDN and DNS resolution
      - TCP 135 and TCP 445 reachability
      - Domain membership and supported Windows version
      - DCOM/CIM authentication using the primary or linked Logon Account
      - Local Administrators membership visibility
      - Client for Microsoft Networks and File and Printer Sharing bindings
      - Required Windows services
      - Component-specific Windows Firewall rules
      - Scheduled Task enumeration, task identity, and optional temporary write test
      - Windows Service enumeration, service identity, and optional temporary write test
      - IIS installation, IIS 6 Management Compatibility/WMI provider, WMI namespace access,
        App Pool enumeration, identity validation, and CPM Windows Script Host readiness

    -Fix can:
      - Enable required network adapter bindings
      - Enable existing component-specific firewall rules
      - Start and enable required services where supported
      - Enable Windows Script Host on the local CPM/source server
      - Install IIS 6 Management Compatibility on a supported Windows Server target when missing
      - Optionally add the managing account to the target local Administrators group only when
        -AddManagingAccountToLocalAdministrators is explicitly supplied

    The script does NOT:
      - Disable UAC
      - Change a service, Scheduled Task, or App Pool production password
      - Change the Run As identity of an existing production dependency
      - Restart a production service or recycle an application pool

.PARAMETER TargetComputer
    FQDN of the Windows target server. A short name is accepted but flagged.

.PARAMETER Credential
    Credential CyberArk will use to access the dependency server. This is normally the primary
    managed account or its linked Logon Account. The password is never written to logs/reports.

.PARAMETER ServiceAccount
    Interactive/default service account. When ManagingAccount and ManagedAccount are not supplied,
    this account is used for both roles. If omitted, the script prompts for DOMAIN\username or UPN.

.PARAMETER Components
    One or more components: ScheduledTask, WindowsService, IISAppPool, or All.

.PARAMETER ManagingAccount
    Optional explicit account expected to connect from CPM. Defaults to Credential.UserName.

.PARAMETER ManagedAccount
    Optional account whose password is stored in the dependent resource. When supplied, the
    script finds resources using that identity and compares specific resources against it.

.PARAMETER ScheduledTaskName
    Optional exact Scheduled Task name.

.PARAMETER ScheduledTaskPath
    Optional Scheduled Task folder. Default: \

.PARAMETER ServiceName
    Optional exact Windows service short name.

.PARAMETER AppPoolName
    Optional exact IIS Application Pool name.

.PARAMETER Fix
    Applies supported prerequisite fixes. Use an administrative account.

.PARAMETER AddManagingAccountToLocalAdministrators
    With -Fix, explicitly adds ManagingAccount to the target built-in Administrators group.
    This is a privileged change and is not performed by -Fix alone.

.PARAMETER PerformWriteTest
    Creates and removes a disabled temporary Scheduled Task and/or Windows Service. Nothing is
    started. IIS App Pool access is validated through the CyberArk-required MicrosoftIISv2 WMI
    namespace; no temporary App Pool is created.

.PARAMETER OutputFolder
    Output folder for CSV, HTML, and log reports.

.EXAMPLE
    .\Test-Fix-CyberArkDependencyPrerequisites.ps1 `
        -TargetComputer app01.corp.example.com `
        -Components All

.EXAMPLE
    .\Test-Fix-CyberArkDependencyPrerequisites.ps1 `
        -TargetComputer app01.corp.example.com `
        -Components ScheduledTask,WindowsService,IISAppPool `
        -ManagedAccount 'CORP\SVC_APP' `
        -ScheduledTaskName 'Nightly Processing' `
        -ServiceName 'AppProcessingService' `
        -AppPoolName 'AppPool-Production'

.EXAMPLE
    .\Test-Fix-CyberArkDependencyPrerequisites.ps1 `
        -TargetComputer app01.corp.example.com `
        -Components All `
        -Fix `
        -PerformWriteTest

.EXAMPLE
    .\Test-Fix-CyberArkDependencyPrerequisites.ps1 `
        -TargetComputer app01.corp.example.com `
        -Components All `
        -Fix `
        -AddManagingAccountToLocalAdministrators

.NOTES
    Compatible with 64-bit Windows PowerShell 5.1.
    Version 4 adds interactive prompts for the target FQDN and service account while preserving
    PowerShell 5.1-safe reporting, bounded validation, same-host credential reporting, and
    documentation-aligned checks.
    Recommended execution location: CyberArk CPM server.
#>

[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [ValidateNotNullOrEmpty()]
    [string]$TargetComputer,

    [Parameter()]
    [System.Management.Automation.PSCredential]$Credential,

    [Parameter()]
    [string]$ServiceAccount,

    [Parameter()]
    [ValidateSet('All', 'ScheduledTask', 'WindowsService', 'IISAppPool')]
    [string[]]$Components = @('All'),

    [Parameter()]
    [string]$ManagingAccount,

    [Parameter()]
    [string]$ManagedAccount,

    [Parameter()]
    [string]$ScheduledTaskName,

    [Parameter()]
    [string]$ScheduledTaskPath = '\',

    [Parameter()]
    [string]$ServiceName,

    [Parameter()]
    [string]$AppPoolName,

    [Parameter()]
    [switch]$Fix,

    [Parameter()]
    [switch]$AddManagingAccountToLocalAdministrators,

    [Parameter()]
    [switch]$PerformWriteTest,

    [Parameter()]
    [ValidateRange(5, 120)]
    [int]$OperationTimeoutSeconds = 25,

    [Parameter()]
    [ValidateNotNullOrEmpty()]
    [string]$OutputFolder = $(
        if ($PSScriptRoot) { Join-Path $PSScriptRoot 'Reports' }
        else { Join-Path (Get-Location) 'Reports' }
    )
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$script:Results = New-Object System.Collections.Generic.List[object]
$script:CimSession = $null
$script:ResolvedFqdn = $null
$script:LogFile = $null
$script:SourceFqdn = $null
$script:IsTargetLocal = $false
$script:SelectedComponents = @()
$script:TargetWindowsDirectory = $null

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet('INFO', 'PASS', 'WARN', 'FAIL', 'FIXED', 'SKIP')]
        [string]$Level = 'INFO'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = '{0} | {1,-5} | {2}' -f $timestamp, $Level, $Message

    $color = switch ($Level) {
        'PASS'  { 'Green' }
        'FIXED' { 'Green' }
        'WARN'  { 'Yellow' }
        'FAIL'  { 'Red' }
        'SKIP'  { 'DarkGray' }
        default { 'Cyan' }
    }

    Write-Host $line -ForegroundColor $color
    if ($script:LogFile) {
        Add-Content -LiteralPath $script:LogFile -Value $line -Encoding UTF8
    }
}

function Write-Stage {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Name
    )

    Write-Log -Message ("-------------------- {0} --------------------" -f $Name) -Level 'INFO'
}

function Add-Result {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Component,

        [Parameter(Mandatory)]
        [string]$Category,

        [Parameter(Mandatory)]
        [string]$Check,

        [Parameter(Mandatory)]
        [ValidateSet('INFO', 'PASS', 'WARN', 'FAIL', 'FIXED', 'SKIP')]
        [string]$Status,

        [Parameter(Mandatory)]
        [string]$Details,

        [string]$ActionTaken = '',

        [string]$Recommendation = ''
    )

    $target = if ($script:ResolvedFqdn) { $script:ResolvedFqdn } else { $TargetComputer }

    $script:Results.Add([pscustomobject]@{
        Time           = Get-Date
        Target         = $target
        Component      = $Component
        Category       = $Category
        Check          = $Check
        Status         = $Status
        Details        = $Details
        ActionTaken    = $ActionTaken
        Recommendation = $Recommendation
    })

    $message = '[{0}][{1}] {2}: {3}' -f $Component, $Category, $Check, $Details
    Write-Log -Message $message -Level $Status
}

function Normalize-TaskPath {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) { return '\' }
    $value = $Path.Trim()
    if (-not $value.StartsWith('\')) { $value = '\' + $value }
    if (-not $value.EndsWith('\')) { $value += '\' }
    return $value
}

function Get-AccountLeafName {
    param([string]$AccountName)

    if ([string]::IsNullOrWhiteSpace($AccountName)) { return $null }
    $value = $AccountName.Trim()
    if ($value -match '\\') { return ($value -split '\\')[-1].ToLowerInvariant() }
    if ($value -match '@') { return ($value -split '@')[0].ToLowerInvariant() }
    return $value.ToLowerInvariant()
}

function Test-AccountMatch {
    param(
        [string]$Expected,
        [string]$Actual
    )

    if ([string]::IsNullOrWhiteSpace($Expected) -or [string]::IsNullOrWhiteSpace($Actual)) {
        return $false
    }

    if ($Expected.Trim().Equals($Actual.Trim(), [System.StringComparison]::OrdinalIgnoreCase)) {
        return $true
    }

    return (Get-AccountLeafName $Expected) -eq (Get-AccountLeafName $Actual)
}

function Test-TcpPort {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ComputerName,

        [Parameter(Mandatory)]
        [ValidateRange(1, 65535)]
        [int]$Port,

        [ValidateRange(500, 30000)]
        [int]$TimeoutMilliseconds = 4000
    )

    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $async = $client.BeginConnect($ComputerName, $Port, $null, $null)
        if (-not $async.AsyncWaitHandle.WaitOne($TimeoutMilliseconds, $false)) {
            return $false
        }
        $client.EndConnect($async)
        return $true
    }
    catch {
        return $false
    }
    finally {
        $client.Close()
        $client.Dispose()
    }
}

function Get-SourceFqdn {
    try {
        return ([System.Net.Dns]::GetHostEntry($env:COMPUTERNAME)).HostName.TrimEnd('.')
    }
    catch {
        return $env:COMPUTERNAME
    }
}

function Resolve-TargetFqdn {
    param([string]$ComputerName)

    try {
        $entry = [System.Net.Dns]::GetHostEntry($ComputerName)
        $script:ResolvedFqdn = $entry.HostName.TrimEnd('.')
        $addresses = @($entry.AddressList | ForEach-Object { $_.IPAddressToString } | Sort-Object -Unique)

        Add-Result -Component 'Common' -Category 'DNS' -Check 'Forward resolution' -Status 'PASS' `
            -Details ("Resolved '{0}' to '{1}' and {2}." -f $ComputerName, $script:ResolvedFqdn, ($addresses -join ', '))

        if ($script:ResolvedFqdn -notmatch '\.') {
            Add-Result -Component 'Common' -Category 'DNS' -Check 'FQDN' -Status 'FAIL' `
                -Details ("Resolved name '{0}' is not an FQDN." -f $script:ResolvedFqdn) `
                -Recommendation 'Correct DNS/search suffixes and configure the CyberArk dependent account Address as the server FQDN.'
        }
        elseif ($ComputerName -notmatch '\.') {
            Add-Result -Component 'Common' -Category 'DNS' -Check 'FQDN' -Status 'WARN' `
                -Details ("A short name was provided. Use '{0}' in CyberArk." -f $script:ResolvedFqdn) `
                -Recommendation 'Use the target FQDN to support Kerberos and avoid NTLM fallback.'
        }
        else {
            Add-Result -Component 'Common' -Category 'DNS' -Check 'FQDN' -Status 'PASS' `
                -Details ("The target was supplied as FQDN '{0}'." -f $script:ResolvedFqdn)
        }
    }
    catch {
        $script:ResolvedFqdn = $ComputerName
        Add-Result -Component 'Common' -Category 'DNS' -Check 'Forward resolution' -Status 'FAIL' `
            -Details ("Unable to resolve '{0}': {1}" -f $ComputerName, $_.Exception.Message) `
            -Recommendation 'Correct DNS and confirm the CPM can resolve the target FQDN.'
    }
}

function New-TargetCimSession {
    try {
        $option = New-CimSessionOption -Protocol Dcom
        $currentIdentity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
        $authenticationIdentity = $ManagingAccount

        if ($script:IsTargetLocal) {
            # Windows WMI/CIM does not provide a reliable alternate-credential validation path
            # to the same local computer. Use the current process token and report this clearly.
            $script:CimSession = New-CimSession -ComputerName $script:ResolvedFqdn -SessionOption $option
            $authenticationIdentity = $currentIdentity

            if ($Credential) {
                Add-Result -Component 'Common' -Category 'Topology' -Check 'Credential self-test limitation' -Status 'WARN' `
                    -Details ("Source/CPM and target are the same computer. The local DCOM/CIM session is running as '{0}', not as supplied account '{1}'." -f $currentIdentity, $ManagingAccount) `
                    -Recommendation 'For a true CPM-path credential test, run this script from a different CPM/Connector or a separate Windows management server that reaches this target remotely.'
            }
        }
        else {
            $script:CimSession = New-CimSession -ComputerName $script:ResolvedFqdn -Credential $Credential -SessionOption $option
        }

        Add-Result -Component 'Common' -Category 'Authentication' -Check 'DCOM/CIM session' -Status 'PASS' `
            -Details ("Established DCOM/CIM access to '{0}'. Effective session identity context: '{1}'. Intended CyberArk managing account: '{2}'." -f $script:ResolvedFqdn, $authenticationIdentity, $ManagingAccount)
        return $true
    }
    catch {
        Add-Result -Component 'Common' -Category 'Authentication' -Check 'DCOM/CIM session' -Status 'FAIL' `
            -Details ("Unable to establish the DCOM/CIM session for intended account '{0}': {1}" -f $ManagingAccount, $_.Exception.Message) `
            -Recommendation 'Verify the credential, local Administrators access, Remote Service Management/RPC firewall rules, DNS, domain trust, and UAC policy.'
        return $false
    }
}

function Get-RequiredServiceDefinition {
    param([string[]]$Selected)

    $definitions = @{
        'Schedule'     = [pscustomobject]@{ Name = 'Schedule'; Display = 'Task Scheduler'; Components = @('ScheduledTask') }
        'RpcSs'        = [pscustomobject]@{ Name = 'RpcSs'; Display = 'Remote Procedure Call (RPC)'; Components = @('ScheduledTask','WindowsService','IISAppPool') }
        'DcomLaunch'   = [pscustomobject]@{ Name = 'DcomLaunch'; Display = 'DCOM Server Process Launcher'; Components = @('ScheduledTask','WindowsService','IISAppPool') }
        'LanmanServer' = [pscustomobject]@{ Name = 'LanmanServer'; Display = 'Server'; Components = @('ScheduledTask','WindowsService','IISAppPool') }
        'Winmgmt'      = [pscustomobject]@{ Name = 'Winmgmt'; Display = 'Windows Management Instrumentation'; Components = @('IISAppPool') }
        'WAS'          = [pscustomobject]@{ Name = 'WAS'; Display = 'Windows Process Activation Service'; Components = @('IISAppPool') }
        'W3SVC'        = [pscustomobject]@{ Name = 'W3SVC'; Display = 'World Wide Web Publishing Service'; Components = @('IISAppPool') }
    }

    $required = New-Object System.Collections.Generic.List[object]
    foreach ($item in $definitions.Values) {
        if (@($item.Components | Where-Object { $Selected -contains $_ }).Count -gt 0) {
            $required.Add($item)
        }
    }
    return @($required | Sort-Object Name -Unique)
}

function Test-AndFixRequiredServices {
    param([string[]]$Selected)

    foreach ($definition in (Get-RequiredServiceDefinition -Selected $Selected)) {
        $componentLabel = ($definition.Components | Where-Object { $Selected -contains $_ }) -join ','
        try {
            $service = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $definition.Name) -CimSession $script:CimSession
            if (-not $service) {
                Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                    -Details ("Service '{0}' is not installed." -f $definition.Name)
                continue
            }

            if ($service.StartMode -eq 'Disabled' -and $Fix) {
                try {
                    $change = Invoke-CimMethod -InputObject $service -MethodName ChangeStartMode -Arguments @{ StartMode = 'Automatic' }
                    if ($change.ReturnValue -eq 0) {
                        $service = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $definition.Name) -CimSession $script:CimSession
                        Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FIXED' `
                            -Details 'The service was disabled.' -ActionTaken 'Changed startup type to Automatic.'
                    }
                    else {
                        Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                            -Details ("Unable to change startup type. Win32 return code: {0}." -f $change.ReturnValue)
                    }
                }
                catch {
                    Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                        -Details ("Failed to change startup type: {0}" -f $_.Exception.Message)
                }
            }

            $service = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $definition.Name) -CimSession $script:CimSession
            if ($service.State -ne 'Running' -and $Fix) {
                try {
                    $start = Invoke-CimMethod -InputObject $service -MethodName StartService
                    Start-Sleep -Seconds 2
                    $service = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $definition.Name) -CimSession $script:CimSession
                    if ($service.State -eq 'Running') {
                        Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FIXED' `
                            -Details 'The service was stopped.' -ActionTaken 'Started the service.'
                    }
                    else {
                        Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                            -Details ("The service did not start. Win32 return code: {0}; state: {1}." -f $start.ReturnValue, $service.State)
                    }
                }
                catch {
                    Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                        -Details ("Failed to start the service: {0}" -f $_.Exception.Message)
                }
            }

            $service = Get-CimInstance -ClassName Win32_Service -Filter ("Name='{0}'" -f $definition.Name) -CimSession $script:CimSession
            if ($service.State -eq 'Running' -and $service.StartMode -ne 'Disabled') {
                Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'PASS' `
                    -Details ("State: {0}; startup type: {1}." -f $service.State, $service.StartMode)
            }
            else {
                Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'FAIL' `
                    -Details ("State: {0}; startup type: {1}." -f $service.State, $service.StartMode) `
                    -Recommendation ("Start and enable the '{0}' service in accordance with your server baseline." -f $definition.Display)
            }
        }
        catch {
            Add-Result -Component $componentLabel -Category 'Required service' -Check $definition.Display -Status 'WARN' `
                -Details ("Unable to query the service: {0}" -f $_.Exception.Message)
        }
    }
}

function Test-AndFixNetworkBindings {
    try {
        Import-Module NetAdapter -ErrorAction Stop
        $adapters = @(Get-NetAdapter -CimSession $script:CimSession -ErrorAction Stop | Where-Object Status -eq 'Up')
        if ($adapters.Count -eq 0) {
            Add-Result -Component 'Common' -Category 'Network binding' -Check 'Active adapters' -Status 'FAIL' `
                -Details 'No active network adapter was returned.'
            return
        }

        foreach ($bindingDefinition in @(
            [pscustomobject]@{ Id = 'ms_msclient'; Name = 'Client for Microsoft Networks' },
            [pscustomobject]@{ Id = 'ms_server'; Name = 'File and Printer Sharing for Microsoft Networks' }
        )) {
            $bindings = @(Get-NetAdapterBinding -CimSession $script:CimSession -ComponentID $bindingDefinition.Id -ErrorAction Stop)
            $activeBindings = @($bindings | Where-Object { $adapters.Name -contains $_.Name })
            $disabled = @($activeBindings | Where-Object { -not $_.Enabled })

            if ($disabled.Count -gt 0 -and $Fix) {
                foreach ($binding in $disabled) {
                    try {
                        Enable-NetAdapterBinding -CimSession $script:CimSession -Name $binding.Name -ComponentID $bindingDefinition.Id -Confirm:$false -ErrorAction Stop | Out-Null
                        Add-Result -Component 'Common' -Category 'Network binding' -Check $bindingDefinition.Name -Status 'FIXED' `
                            -Details ("Binding was disabled on adapter '{0}'." -f $binding.Name) `
                            -ActionTaken ("Enabled '{0}' on '{1}'." -f $bindingDefinition.Name, $binding.Name)
                    }
                    catch {
                        Add-Result -Component 'Common' -Category 'Network binding' -Check $bindingDefinition.Name -Status 'FAIL' `
                            -Details ("Unable to enable the binding on '{0}': {1}" -f $binding.Name, $_.Exception.Message)
                    }
                }
            }

            $bindings = @(Get-NetAdapterBinding -CimSession $script:CimSession -ComponentID $bindingDefinition.Id -ErrorAction Stop)
            $enabledAdapters = @($bindings | Where-Object { $_.Enabled -and ($adapters.Name -contains $_.Name) } | Select-Object -ExpandProperty Name)
            if ($enabledAdapters.Count -gt 0) {
                Add-Result -Component 'Common' -Category 'Network binding' -Check $bindingDefinition.Name -Status 'PASS' `
                    -Details ("Enabled on active adapter(s): {0}." -f ($enabledAdapters -join ', '))
            }
            else {
                Add-Result -Component 'Common' -Category 'Network binding' -Check $bindingDefinition.Name -Status 'FAIL' `
                    -Details 'Not enabled on any active network adapter.' `
                    -Recommendation ("Enable '{0}' on the target's active adapter." -f $bindingDefinition.Name)
            }
        }
    }
    catch {
        Add-Result -Component 'Common' -Category 'Network binding' -Check 'Required bindings' -Status 'WARN' `
            -Details ("Unable to inspect or modify adapter bindings remotely: {0}" -f $_.Exception.Message) `
            -Recommendation 'Validate Client for Microsoft Networks and File and Printer Sharing manually on the target.'
    }
}

function Get-ComponentFirewallRules {
    param([string]$Component)

    $allRules = @(Get-NetFirewallRule -CimSession $script:CimSession -PolicyStore ActiveStore -ErrorAction Stop | Where-Object { $_.Direction -eq 'Inbound' -and $_.Action -eq 'Allow' })
    switch ($Component) {
        'ScheduledTask' {
            return @($allRules | Where-Object {
                $_.Name -match '^RemoteTask' -or $_.DisplayGroup -match 'Remote Scheduled Tasks Management'
            })
        }
        'WindowsService' {
            return @($allRules | Where-Object {
                $_.Name -match '^RemoteSvcAdmin' -or $_.DisplayGroup -match 'Remote Service Management'
            })
        }
        'IISAppPool' {
            return @($allRules | Where-Object {
                $_.Name -match '^WMI-' -or $_.DisplayGroup -match 'Windows Management Instrumentation'
            })
        }
    }
}

function Test-AndFixFirewall {
    param([string[]]$Selected)

    try {
        Import-Module NetSecurity -ErrorAction Stop
        foreach ($component in $Selected) {
            $rules = @(Get-ComponentFirewallRules -Component $component)
            if ($rules.Count -eq 0) {
                Add-Result -Component $component -Category 'Firewall' -Check 'Required inbound rules' -Status 'WARN' `
                    -Details 'No matching built-in firewall rules were found. Rule names may be localized, removed, or controlled by GPO.' `
                    -Recommendation 'Enable the component-specific firewall rule group and scope it to the CPM source addresses.'
                continue
            }

            $disabledRules = @($rules | Where-Object { ("$($_.Enabled)") -ne 'True' })
            if ($disabledRules.Count -gt 0 -and $Fix) {
                foreach ($rule in $disabledRules) {
                    try {
                        Enable-NetFirewallRule -CimSession $script:CimSession -Name $rule.Name -ErrorAction Stop | Out-Null
                        Add-Result -Component $component -Category 'Firewall' -Check $rule.DisplayName -Status 'FIXED' `
                            -Details 'The firewall rule was disabled.' -ActionTaken 'Enabled the existing firewall rule.'
                    }
                    catch {
                        Add-Result -Component $component -Category 'Firewall' -Check $rule.DisplayName -Status 'FAIL' `
                            -Details ("Unable to enable rule '{0}': {1}" -f $rule.Name, $_.Exception.Message) `
                            -Recommendation 'A domain GPO may control this rule. Update the authoritative GPO rather than the local policy.'
                    }
                }
            }

            $rules = @(Get-ComponentFirewallRules -Component $component)
            $enabledRules = @($rules | Where-Object { ("$($_.Enabled)") -eq 'True' })
            $disabledRulesAfterFix = @($rules | Where-Object { ("$($_.Enabled)") -ne 'True' })
            if ($enabledRules.Count -eq $rules.Count -and $rules.Count -gt 0) {
                Add-Result -Component $component -Category 'Firewall' -Check 'Required inbound rules' -Status 'PASS' `
                    -Details ("All {0} matching inbound Allow rule(s) are enabled: {1}." -f $rules.Count, (($enabledRules | Select-Object -ExpandProperty DisplayName) -join '; '))
            }
            elseif ($enabledRules.Count -gt 0) {
                Add-Result -Component $component -Category 'Firewall' -Check 'Required inbound rules' -Status 'WARN' `
                    -Details ("Only {0} of {1} matching inbound Allow rule(s) are enabled. Disabled: {2}." -f $enabledRules.Count, $rules.Count, (($disabledRulesAfterFix | Select-Object -ExpandProperty DisplayName) -join '; ')) `
                    -Recommendation 'Enable the complete built-in firewall rule group and scope it to the CPM source addresses.'
            }
            else {
                Add-Result -Component $component -Category 'Firewall' -Check 'Required inbound rules' -Status 'FAIL' `
                    -Details ("Found {0} matching inbound Allow rules, but none are enabled." -f $rules.Count) `
                    -Recommendation 'Enable the applicable inbound firewall rule group and allow the CPM source IPs.'
            }
        }
    }
    catch {
        Add-Result -Component 'Common' -Category 'Firewall' -Check 'Windows Firewall inspection' -Status 'WARN' `
            -Details ("Unable to inspect firewall rules: {0}" -f $_.Exception.Message) `
            -Recommendation 'Validate the required rule groups manually or through the authoritative GPO.'
    }
}

function Resolve-ManagingAccountForLocalGroup {
    param([string]$AccountName)

    try {
        $nt = New-Object System.Security.Principal.NTAccount($AccountName)
        $sid = $nt.Translate([System.Security.Principal.SecurityIdentifier])
        return $sid.Translate([System.Security.Principal.NTAccount]).Value
    }
    catch {
        return $AccountName
    }
}

function Invoke-RemoteProcess {
    param(
        [Parameter(Mandatory)]
        [string]$CommandLine
    )

    $result = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $CommandLine } -CimSession $script:CimSession
    return $result
}

function Get-LocalAdministratorsMembersWithTimeout {
    [CmdletBinding()]
    param()

    $computerName = $script:ResolvedFqdn
    $useCredential = (-not $script:IsTargetLocal -and $null -ne $Credential)
    $credentialForJob = if ($useCredential) { $Credential } else { $null }

    $job = Start-Job -ArgumentList $computerName, $credentialForJob, $useCredential -ScriptBlock {
        param($ComputerName, $JobCredential, $UseCredential)

        $session = $null
        try {
            $option = New-CimSessionOption -Protocol Dcom
            if ($UseCredential) {
                $session = New-CimSession -ComputerName $ComputerName -Credential $JobCredential -SessionOption $option -ErrorAction Stop
            }
            else {
                $session = New-CimSession -ComputerName $ComputerName -SessionOption $option -ErrorAction Stop
            }

            $group = Get-CimInstance -ClassName Win32_Group -Filter "LocalAccount=True AND SID='S-1-5-32-544'" -CimSession $session -ErrorAction Stop
            if (-not $group) { throw 'Built-in Administrators group was not found by SID.' }

            $members = @(Get-CimAssociatedInstance -InputObject $group -Association Win32_GroupUser -ResultClassName Win32_Account -CimSession $session -ErrorAction Stop)
            foreach ($member in $members) {
                [pscustomobject]@{
                    Name   = [string]$member.Name
                    Domain = [string]$member.Domain
                    SID    = [string]$member.SID
                }
            }
        }
        finally {
            if ($session) { Remove-CimSession -CimSession $session -ErrorAction SilentlyContinue }
        }
    }

    try {
        $completed = Wait-Job -Job $job -Timeout $OperationTimeoutSeconds
        if (-not $completed) {
            Stop-Job -Job $job -ErrorAction SilentlyContinue
            throw ("Local Administrators membership query exceeded {0} seconds." -f $OperationTimeoutSeconds)
        }

        $errors = @($job.ChildJobs[0].Error)
        if ($job.State -eq 'Failed' -or $errors.Count -gt 0) {
            $message = if ($errors.Count -gt 0) { ($errors | ForEach-Object { $_.ToString() }) -join '; ' } else { 'Background membership query failed.' }
            throw $message
        }

        return @(Receive-Job -Job $job -ErrorAction Stop)
    }
    finally {
        Remove-Job -Job $job -Force -ErrorAction SilentlyContinue
    }
}

function Test-AndOptionallyAddLocalAdmin {
    Write-Stage 'CyberArk authorization: local Administrators membership'

    $adminGroup = $null
    try {
        $adminGroup = Get-CimInstance -ClassName Win32_Group -Filter "LocalAccount=True AND SID='S-1-5-32-544'" -CimSession $script:CimSession -ErrorAction Stop
        if (-not $adminGroup) { throw 'Built-in Administrators group was not found.' }

        $members = @(Get-LocalAdministratorsMembersWithTimeout)
        $leaf = Get-AccountLeafName $ManagingAccount
        $matches = @($members | Where-Object { $_.Name -and $_.Name.ToLowerInvariant() -eq $leaf })

        if ($matches.Count -gt 0) {
            $matchedNames = ($matches | ForEach-Object { "{0}\{1}" -f $_.Domain, $_.Name }) -join ', '
            Add-Result -Component 'Common' -Category 'Authorization' -Check 'Direct local Administrators membership' -Status 'PASS' `
                -Details ("'{0}' is visible as a direct member of the target built-in Administrators group: {1}." -f $ManagingAccount, $matchedNames)
            return
        }

        Add-Result -Component 'Common' -Category 'Authorization' -Check 'Direct local Administrators membership' -Status 'WARN' `
            -Details ("'{0}' is not visible as a direct member. It may have access through a nested domain group, which this check does not expand." -f $ManagingAccount) `
            -Recommendation 'CyberArk requires the primary or linked account used to connect to have effective membership in the target Administrators group.'

        if ($Fix -and $AddManagingAccountToLocalAdministrators) {
            $resolvedAccount = Resolve-ManagingAccountForLocalGroup -AccountName $ManagingAccount
            if ($resolvedAccount -match '["&|<>^]') {
                Add-Result -Component 'Common' -Category 'Authorization' -Check 'Add local administrator' -Status 'FAIL' `
                    -Details 'The account name contains an unsupported command character. No change was attempted.'
                return
            }

            $localGroupName = $adminGroup.Name
            $command = 'cmd.exe /d /c net localgroup "{0}" "{1}" /add' -f $localGroupName.Replace('"',''), $resolvedAccount.Replace('"','')
            $create = Invoke-RemoteProcess -CommandLine $command
            if ($create.ReturnValue -eq 0) {
                Start-Sleep -Seconds 3
                Add-Result -Component 'Common' -Category 'Authorization' -Check 'Add local administrator' -Status 'FIXED' `
                    -Details ("'{0}' was not a confirmed direct member." -f $resolvedAccount) `
                    -ActionTaken ("Launched addition of '{0}' to local group '{1}'. Validate the final membership in the generated report or manually." -f $resolvedAccount, $localGroupName)
            }
            else {
                Add-Result -Component 'Common' -Category 'Authorization' -Check 'Add local administrator' -Status 'FAIL' `
                    -Details ("Win32_Process.Create returned code {0}." -f $create.ReturnValue)
            }
        }
        elseif ($Fix -and -not $AddManagingAccountToLocalAdministrators) {
            Add-Result -Component 'Common' -Category 'Authorization' -Check 'Add local administrator' -Status 'SKIP' `
                -Details 'No membership change was made because -AddManagingAccountToLocalAdministrators was not supplied.'
        }
    }
    catch {
        Add-Result -Component 'Common' -Category 'Authorization' -Check 'Local Administrators membership' -Status 'WARN' `
            -Details ("Membership validation did not complete: {0}" -f $_.Exception.Message) `
            -Recommendation 'The script will continue. Use -PerformWriteTest for a stronger effective-permission test, or validate the target Administrators group manually.'
    }
}

