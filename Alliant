#Requires -Version 5.1
Set-StrictMode -Version Latest

<#
  Purpose:
    - Retrieve credentials from CyberArk CCP WITHOUT displaying any account properties.
    - Convert plaintext password to SecureString and build PSCredential.
    - Avoid printing or logging ANY sensitive identifiers or values.
    - Provide only generic status messages.

  Behavior:
    - No URLs, usernames, addresses, object names, safes, or passwords are written to output.
    - Errors are generalized to avoid accidental data leaks.
#>

# ----------------------- Safety & Runtime Controls -----------------------
$ErrorActionPreference = 'Stop'                    # [Comment] Fail fast so we can handle in try/catch without noisy partial output
$ProgressPreference   = 'SilentlyContinue'         # [Comment] Suppress any progress UI that could include hints

# ----------------------- Config (EDIT AS NEEDED) -----------------------
# [Comment] These variables are used internally; they are NEVER printed.
$responseViaObject = $null
$responseViaAddressAndUsername = $null

$CCPAddress  = "https://ccp-test.cna.com"          # [Comment] CCP base URL (not printed)
$location    = "AIMWebService"                     # [Comment] CCP path (not printed)
$application = "SECRETS_DEMO_APPID"                # [Comment] AppID (not printed)
$safe        = "CyberArkCCPTest"                   # [Comment] Safe (not printed)
$object      = "10.10.10.1-SVC_demoaccount"        # [Comment] Object name (not printed)
$address     = "10.10.10.1"                        # [Comment] Address (not printed)
$username    = "SVC_demoaccount"                   # [Comment] Username (not printed)

$windowsAuth = $false                               # [Comment] Integrated auth toggle (value not sensitive)

# [Comment] Encourage modern TLS; no output
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}

# [Comment] Standard JSON header for CCP; not printed
$headers = New-Object "System.Collections.Generic.Dictionary[[String],[String]]"
$headers.Add("Content-Type", "application/json")

# ----------------------- Helper: Secure handling -----------------------
function Convert-CcpResponseToCredential {
    <#
      .SYNOPSIS
        Convert CCP response to PSCredential and scrub plaintext.
      .DESCRIPTION
        - Builds SecureString from CCP Content.
        - Creates PSCredential.
        - Clears plaintext from the response object.
        - Returns PSCredential only; sanitized response is NOT printed.
    #>
    param(
        [Parameter(Mandatory)] [pscustomobject] $CcpResponse
    )

    # [Comment] Convert to SecureString in-memory; never printed
    $SecurePassword = ConvertTo-SecureString -String $CcpResponse.Content -AsPlainText -Force

    # [Comment] Produce PSCredential for downstream use; never printed
    $Cred = New-Object System.Management.Automation.PSCredential ($CcpResponse.Username, $SecurePassword)

    # [Comment] Immediately scrub plaintext to minimize exposure window
    $CcpResponse.Content = $null
    Remove-Variable SecurePassword -ErrorAction SilentlyContinue

    # [Comment] Return only the PSCredential (safe object)
    return $Cred
}

# ----------------------- Lookup by Object (no display) -----------------------
if (![string]::IsNullOrWhiteSpace($object)) {
    # [Comment] Build URL internally; never echoed to screen
    $url = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&Object=$object"

    try {
        # [Comment] Perform request silently
        $responseViaObject = Invoke-RestMethod -Uri $url -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth

        # [Comment] Build credential securely and keep for use; do not print
        $CredFromObject = Convert-CcpResponseToCredential -CcpResponse $responseViaObject

        # [Comment] Generic success note (no properties)
        Write-Host "[OK] Credential retrieved (method: object)." -ForegroundColor Green
    }
    catch {
        # [Comment] Generic error note that reveals nothing sensitive
        Write-Host "[ERR] Credential retrieval failed (method: object). Check connectivity, authorization, and CCP configuration." -ForegroundColor Red
    }
}

# ----------------------- Lookup by Address + Username (no display) -----------------------
if (![string]::IsNullOrWhiteSpace($address) -and ![string]::IsNullOrWhiteSpace($username)) {
    # [Comment] Build URL internally; never echoed to screen
    $url2 = "$CCPAddress/$location/api/Accounts?AppID=$application&Safe=$safe&address=$address&username=$username"

    try {
        # [Comment] Perform request silently
        $responseViaAddressAndUsername = Invoke-RestMethod -Uri $url2 -Method 'GET' -Headers $headers -UseDefaultCredentials:$windowsAuth

        # [Comment] Build credential securely and keep for use; do not print
        $CredFromAddrUser = Convert-CcpResponseToCredential -CcpResponse $responseViaAddressAndUsername

        # [Comment] Generic success note (no properties)
        Write-Host "[OK] Credential retrieved (method: address+username)." -ForegroundColor Green
    }
    catch {
        # [Comment] Generic error note that reveals nothing sensitive
        Write-Host "[ERR] Credential retrieval failed (method: address+username). Check connectivity, authorization, and CCP configuration." -ForegroundColor Red
    }
}

# ----------------------- Example (SAFE) Usage Patterns -----------------------
# [Comment] Use the credentials in downstream commands WITHOUT printing them.
#   Example (commented; remove comments to use):
#   Invoke-Command -ComputerName someHost -Credential $CredFromObject -ScriptBlock { whoami }
#   Connect-DbaInstance -SqlInstance 'server\instance' -SqlCredential $CredFromAddrUser

# ----------------------- Cleanup -----------------------
# [Comment] Drop references to objects that once held secrets
$responseViaObject = $null
$responseViaAddressAndUsername = $null

# [Comment] Final neutral completion note
Write-Host "[DONE] Completed CCP retrieval flow without displaying account properties." -ForegroundColor Green
