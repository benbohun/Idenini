  # 1) CCP -> $Cred
  $Cred = Get-CCPCredentialByObject -ObjectName $ObjectName -UPUser $UPUser

  # 2) Preflight Identity
  Test-IdentityPreflight -Tenant "aap4748.id.cyberark.cloud" | Out-Null

  # 3) Identity header -> psPAS session (EXACT parameters you requested)
  try {
    Write-Log "Requesting CyberArk PAS authentication (psPAS Identity header)..." "Gray"

    # Build a temporary PSCredential with the same secure password
    $UPCred = [PSCredential]::new($UPUser, $Cred.Password)

    $header = Get-IdentityHeader `
      -IdentityTenantURL "aap4748.id.cyberark.cloud" `
      -psPASFormat `
      -PCloudSubdomain "alliant-test" `
      -UPCreds $UPCred

    Use-PASSession $header
    if (-not (Get-PASSession)) { throw "psPAS session not established" }
    Write-Log "Authentication successful, PAS session established." "Green"
  } catch {
    Write-Log ("Failed to authenticate via psPAS Identity header: {0}" -f $_.Exception.Message) "Red"
    throw
  }

  return $Cred
}

