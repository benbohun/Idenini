<#
UpdateSafes_NumberOfDaysRetention.ps1

- Uses YOUR existing login pattern:
    Get-IdentityHeader -> Use-PASSession
- Reads safes from CSV and updates NumberOfDaysRetention (and optionally Location/ManagingCPM/OLACEnabled if present)
- Logs success/errors to a text log file

CSV notes:
- Only SafeName is required.
- If NumberOfDaysRetention is blank/missing, script uses -DefaultRetentionDays (default 180)
- Location / ManagingCPM / OLACEnabled are optional. If blank, they are not changed.
#>

[CmdletBinding()]
param(
    # Identity / Privilege Cloud (adjust if needed)
    [string]$IdentityTenantURL = "https://aat4012.id.cyberark.cloud",
    [string]$PCloudSubdomain   = "cna-prod",

    # Files
    [string]$CsvFilePath = "E:\Installation Media\RemovePendingAccount\UpdateSafesParameters.csv",
    [string]$LogFilePath = "E:\Installation Media\RemovePendingAccount\UpdateLog.txt",

    # Defaults
    [int]$DefaultRetentionDays = 180
)

# ------------------------
# Helpers
# ------------------------
function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','ERROR','WARN')][string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Write-Output $line
    Add-Content -Path $LogFilePath -Value $line
}

function Convert-ToBoolOrNull {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
    if ($Value -match '^(?i:true|yes|y|1)$')  { return $true }
    if ($Value -match '^(?i:false|no|n|0)$') { return $false }
    return $null
}

function Convert-ToIntOrNull {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
    $trim = $Value.Trim()
    $out  = 0
    if ([int]::TryParse($trim, [ref]$out)) { return $out }
    return $null
}

# ------------------------
# Start
# ------------------------
try {
    Import-Module psPAS -ErrorAction Stop

    # Create/clear log file
    New-Item -ItemType File -Path $LogFilePath -Force | Out-Null
    Write-Log "Starting safe retention update run."

    # Validate CSV path
    if (-not (Test-Path $CsvFilePath)) {
        throw "CSV not found: $CsvFilePath"
    }

    # Prompt user for CyberArk credentials
    $UPCred = Get-Credential

    # Get header authentication (PCLOUD Admins Only)
    $header = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $UPCred

    # Register to use header credentials for PAS session
    Use-PASSession $header
    Write-Log "Authenticated using Identity header. Tenant='$IdentityTenantURL' Subdomain='$PCloudSubdomain'." "SUCCESS"

    # Import CSV
    $rows = Import-Csv -Path $CsvFilePath
    if (-not $rows -or $rows.Count -eq 0) {
        throw "CSV '$CsvFilePath' has no rows."
    }

    Write-Log "Loaded $($rows.Count) row(s) from CSV."

    foreach ($safe in $rows) {
        # Row-level protection: never terminate run for a single bad safe
        try {
            # ---- Required field ----
            if ([string]::IsNullOrWhiteSpace($safe.safeName)) {
                throw "SafeName cannot be empty."
            }
            $safeName = $safe.safeName.Trim()

            # ---- Optional inputs (only apply if provided) ----
            $retention = $null
            if ($safe.PSObject.Properties.Name -contains 'NumberOfDaysRetention') {
                $retention = Convert-ToIntOrNull $safe.NumberOfDaysRetention
            } elseif ($safe.PSObject.Properties.Name -contains 'retentionDays') {
                $retention = Convert-ToIntOrNull $safe.retentionDays
            }
            if (-not $retention) { $retention = $DefaultRetentionDays }

            $olac = $null
            if ($safe.PSObject.Properties.Name -contains 'olacEnabled') {
                $olac = Convert-ToBoolOrNull $safe.olacEnabled
            }

            $location = $null
            if ($safe.PSObject.Properties.Name -contains 'location' -and -not [string]::IsNullOrWhiteSpace($safe.location)) {
                $location = $safe.location.Trim()
            }

            $managingCPM = $null
            if ($safe.PSObject.Properties.Name -contains 'managingCPM' -and -not [string]::IsNullOrWhiteSpace($safe.managingCPM)) {
                $managingCPM = $safe.managingCPM.Trim()
            }

            # ---- Build params: always set retention; others only if present ----
            $params = @{
                SafeName             = $safeName
                NumberOfDaysRetention = $retention
                ErrorAction          = 'Stop'
            }

            if ($location)    { $params['Location']    = $location }
            if ($managingCPM) { $params['ManagingCPM'] = $managingCPM }
            if ($null -ne $olac) { $params['OLACEnabled'] = $olac }

            # ---- Update ----
            Set-PASSafe @params | Out-Null

            $msg = "Safe '$safeName' updated. NumberOfDaysRetention=$retention" +
                   ($(if ($location) { ", Location='$location'" } else { "" })) +
                   ($(if ($managingCPM) { ", ManagingCPM='$managingCPM'" } else { "" })) +
                   ($(if ($null -ne $olac) { ", OLACEnabled=$olac" } else { "" }))

            Write-Log $msg "SUCCESS"
        }
        catch {
            Write-Log "Failed to update safe '$($safe.safeName)'. Error: $($_.Exception.Message)" "ERROR"
            continue
        }
    }

    Write-Log "Completed processing all rows." "SUCCESS"
}
catch {
    Write-Log "Fatal error: $($_.Exception.Message)" "ERROR"
}
finally {
    try {
        Close-PASSession | Out-Null
        Write-Log "Logged off." "INFO"
    } catch {
        Write-Log "Logoff warning: $($_.Exception.Message)" "WARN"
    }
}
