}

function Install-IIS6ManagementCompatibility {
    $command = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Import-Module ServerManager; Install-WindowsFeature Web-Mgmt-Compat -IncludeAllSubFeature | Out-File -FilePath C:\Windows\Temp\CyberArk_IIS6Compat_Install.log -Force"'
    try {
        $create = Invoke-RemoteProcess -CommandLine $command
        if ($create.ReturnValue -ne 0) {
            Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'FAIL' `
                -Details ("Unable to launch feature installation. Win32_Process.Create returned {0}." -f $create.ReturnValue)
            return $false
        }

        Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'INFO' `
            -Details ("Feature installation launched as process ID {0}. Waiting for the MicrosoftIISv2 namespace." -f $create.ProcessId) `
            -ActionTaken 'Launched Install-WindowsFeature Web-Mgmt-Compat -IncludeAllSubFeature on the target.'

        $deadline = (Get-Date).AddMinutes(5)
        do {
            Start-Sleep -Seconds 5
            if (Test-IISNamespace) {
                Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'FIXED' `
                    -Details 'The MicrosoftIISv2 namespace is now available.' `
                    -ActionTaken 'Installed or repaired IIS 6 Management Compatibility.'
                return $true
            }
        } while ((Get-Date) -lt $deadline)

        Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'WARN' `
            -Details 'The installation was launched, but the namespace was not available within five minutes.' `
            -Recommendation 'Review C:\Windows\Temp\CyberArk_IIS6Compat_Install.log on the target and restart if Windows reports that one is required.'
        return $false
    }
    catch {
        Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'FAIL' `
            -Details ("Feature installation failed: {0}" -f $_.Exception.Message) `
            -Recommendation 'Install the Web-Mgmt-Compat role service locally or through the server build/GPO process.'
        return $false
    }
}

function Test-IISAppPoolComponent {
    Test-AndFixCpmWindowsScriptHost

    if ($script:IsTargetLocal) {
        Add-Result -Component 'IISAppPool' -Category 'Topology' -Check 'CPM and IIS separation' -Status 'WARN' `
            -Details 'The target resolves to the source computer. CyberArk cannot update an IIS App Pool located on the CPM itself.' `
            -Recommendation 'Use a separate CPM/Connector to manage App Pools on this server, or run this script locally only for prerequisite remediation.'
    }
    else {
        Add-Result -Component 'IISAppPool' -Category 'Topology' -Check 'CPM and IIS separation' -Status 'PASS' `
            -Details 'The IIS target is not the source/CPM computer.'
    }

    $namespaceAvailable = Test-IISNamespace
    if (-not $namespaceAvailable -and $Fix) {
        $targetOs = Get-CimInstance -ClassName Win32_OperatingSystem -CimSession $script:CimSession
        if ($targetOs.ProductType -ne 1 -and $targetOs.Version -ge '10.0') {
            $namespaceAvailable = Install-IIS6ManagementCompatibility
        }
        else {
            Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'IIS 6 Management Compatibility' -Status 'FAIL' `
                -Details 'Automatic installation is implemented only for supported Windows Server targets.' `
                -Recommendation 'Install IIS 6 Management Compatibility, including the IIS WMI compatibility provider, through Windows Features.'
        }
    }

    if ($namespaceAvailable) {
        Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'MicrosoftIISv2 namespace' -Status 'PASS' `
            -Details 'The CyberArk-required root\MicrosoftIISv2 WMI namespace is available through the supplied credential.'
    }
    else {
        Add-Result -Component 'IISAppPool' -Category 'IIS feature' -Check 'MicrosoftIISv2 namespace' -Status 'FAIL' `
            -Details 'The root\MicrosoftIISv2 namespace or IIsApplicationPoolSetting class is unavailable or access was denied.' `
            -Recommendation 'Install IIS 6 Management Compatibility, enable WMI firewall rules, and grant the Administrators group access to root\MicrosoftIISv2.'
        return
    }

    try {
        $pools = @(Get-CimInstance -Namespace 'root\MicrosoftIISv2' -ClassName 'IIsApplicationPoolSetting' -CimSession $script:CimSession -ErrorAction Stop)
        Add-Result -Component 'IISAppPool' -Category 'Access' -Check 'Application Pool enumeration' -Status 'PASS' `
            -Details ("Enumerated {0} IIS Application Pool setting instance(s) through root\MicrosoftIISv2." -f $pools.Count)

        if ($AppPoolName) {
            $expectedName = 'W3SVC/AppPools/{0}' -f $AppPoolName
            $pool = @($pools | Where-Object { $_.Name -ieq $expectedName -or $_.Name -match ('/AppPools/' + [regex]::Escape($AppPoolName) + '$') })
            if ($pool.Count -eq 0) {
                Add-Result -Component 'IISAppPool' -Category 'Resource' -Check 'Specified App Pool' -Status 'FAIL' `
                    -Details ("Application Pool '{0}' was not found through MicrosoftIISv2." -f $AppPoolName) `
                    -Recommendation 'Confirm the exact application pool name and that IIS 6 metabase compatibility is synchronized.'
            }
            else {
                foreach ($item in $pool) {
                    $identityType = $null
                    $wamUser = $null
                    if ($item.PSObject.Properties['AppPoolIdentityType']) { $identityType = [int]$item.AppPoolIdentityType }
                    if ($item.PSObject.Properties['WAMUserName']) { $wamUser = [string]$item.WAMUserName }
                    $identityMap = @{ 0 = 'LocalSystem'; 1 = 'LocalService'; 2 = 'NetworkService'; 3 = 'SpecificUser' }
                    $identityText = if ($null -ne $identityType -and $identityMap.ContainsKey($identityType)) { $identityMap[$identityType] } else { "Value $identityType" }

                    Add-Result -Component 'IISAppPool' -Category 'Resource' -Check 'Specified App Pool' -Status 'PASS' `
                        -Details ("Found '{0}'; identity type: {1}; configured user: '{2}'." -f $AppPoolName, $identityText, $wamUser)

                    if ($ManagedAccount) {
                        if ($identityType -ne 3) {
                            Add-Result -Component 'IISAppPool' -Category 'Identity' -Check 'SpecificUser identity' -Status 'FAIL' `
                                -Details ("App Pool identity type is '{0}', not SpecificUser." -f $identityText) `
                                -Recommendation 'CyberArk password synchronization applies when the App Pool uses the managed account as a specific user identity.'
                        }
                        else {
                            $status = if (Test-AccountMatch -Expected $ManagedAccount -Actual $wamUser) { 'PASS' } else { 'FAIL' }
                            Add-Result -Component 'IISAppPool' -Category 'Identity' -Check 'Managed account match' -Status $status `
                                -Details ("Expected '{0}'; App Pool uses '{1}'." -f $ManagedAccount, $wamUser) `
                                -Recommendation $(if ($status -eq 'FAIL') { 'Correct the CyberArk dependency or App Pool identity before rotation.' } else { '' })
                        }
                    }
                }
            }
        }

        if ($ManagedAccount) {
            $matching = @($pools | Where-Object {
                $_.PSObject.Properties['WAMUserName'] -and (Test-AccountMatch -Expected $ManagedAccount -Actual ([string]$_.WAMUserName))
            })
            Add-Result -Component 'IISAppPool' -Category 'Discovery' -Check 'App Pools using managed account' -Status 'INFO' `
                -Details ("Found {0} App Pool(s) using an identity matching '{1}': {2}" -f $matching.Count, $ManagedAccount, (($matching | ForEach-Object { ($_.Name -replace '^W3SVC/AppPools/','') }) -join '; '))
        }

        if ($PerformWriteTest) {
            if ($AppPoolName -and $pool.Count -gt 0) {
                try {
                    $testPool = $pool[0]
                    if ($testPool.PSObject.Properties['AppPoolAutoStart']) {
                        $currentAutoStart = [bool]$testPool.AppPoolAutoStart
                        Set-CimInstance -InputObject $testPool -Property @{ AppPoolAutoStart = $currentAutoStart } -ErrorAction Stop | Out-Null
                        Add-Result -Component 'IISAppPool' -Category 'Write test' -Check 'Same-value App Pool WMI update' -Status 'PASS' `
                            -Details ("Successfully wrote the existing AppPoolAutoStart value back to '{0}' through root\MicrosoftIISv2. No effective configuration change was made." -f $AppPoolName)
                    }
                    else {
                        Add-Result -Component 'IISAppPool' -Category 'Write test' -Check 'Same-value App Pool WMI update' -Status 'WARN' `
                            -Details 'AppPoolAutoStart was not exposed by the compatibility provider, so the non-changing write test could not be performed.'
                    }
                }
                catch {
                    Add-Result -Component 'IISAppPool' -Category 'Write test' -Check 'Same-value App Pool WMI update' -Status 'FAIL' `
                        -Details ("The read succeeded, but the same-value WMI write failed: {0}" -f $_.Exception.Message) `
                        -Recommendation 'Grant the managing account, normally through local Administrators, the required permissions on root\MicrosoftIISv2.'
                }
            }
            else {
                Add-Result -Component 'IISAppPool' -Category 'Write test' -Check 'MicrosoftIISv2 write access' -Status 'SKIP' `
                    -Details 'Specify -AppPoolName to perform a same-value, non-changing WMI write test against an existing App Pool.'
            }
        }
    }
    catch {
        Add-Result -Component 'IISAppPool' -Category 'Access' -Check 'Application Pool enumeration' -Status 'FAIL' `
            -Details ("Unable to enumerate IIS Application Pools: {0}" -f $_.Exception.Message) `
            -Recommendation 'Confirm local Administrators membership and WMI namespace permissions for root\MicrosoftIISv2.'
    }
}

function Export-HtmlReport {
    param(
        [string]$Path,
        [object[]]$Data
    )

    $counts = @{}
    foreach ($status in @('PASS','FIXED','WARN','FAIL','INFO','SKIP')) {
        $counts[$status] = @($Data | Where-Object Status -eq $status).Count
    }

    $rows = foreach ($item in $Data) {
        $class = $item.Status.ToLowerInvariant()
        '<tr class="{0}"><td>{1}</td><td>{2}</td><td>{3}</td><td>{4}</td><td>{5}</td><td>{6}</td><td>{7}</td><td>{8}</td></tr>' -f `
            $class,
            [System.Net.WebUtility]::HtmlEncode($item.Time.ToString('yyyy-MM-dd HH:mm:ss')),
            [System.Net.WebUtility]::HtmlEncode($item.Target),
            [System.Net.WebUtility]::HtmlEncode($item.Component),
            [System.Net.WebUtility]::HtmlEncode($item.Category),
            [System.Net.WebUtility]::HtmlEncode($item.Check),
            [System.Net.WebUtility]::HtmlEncode($item.Status),
            [System.Net.WebUtility]::HtmlEncode($item.Details),
            [System.Net.WebUtility]::HtmlEncode(($item.ActionTaken + $(if ($item.Recommendation) { ' Recommendation: ' + $item.Recommendation } else { '' })))
    }

    $html = @"
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>CyberArk Dependency Prerequisite Validation</title>
<style>
body { font-family: Segoe UI, Arial, sans-serif; margin: 24px; background: #f6f8fa; color: #1f2328; }
h1 { margin-bottom: 4px; }
.meta { color: #57606a; margin-bottom: 18px; }
.summary { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0 22px; }
.card { background: white; border: 1px solid #d0d7de; border-radius: 8px; padding: 10px 16px; min-width: 85px; }
.card strong { display: block; font-size: 22px; }
table { border-collapse: collapse; width: 100%; background: white; font-size: 13px; }
th, td { border: 1px solid #d0d7de; padding: 7px; text-align: left; vertical-align: top; }
th { background: #24292f; color: white; }
tr.pass td:nth-child(6), tr.fixed td:nth-child(6) { color: #1a7f37; font-weight: bold; }
tr.warn td:nth-child(6) { color: #9a6700; font-weight: bold; }
tr.fail td:nth-child(6) { color: #cf222e; font-weight: bold; }
tr.info td:nth-child(6) { color: #0969da; font-weight: bold; }
tr.skip td:nth-child(6) { color: #57606a; font-weight: bold; }
</style>
</head>
<body>
<h1>CyberArk Dependency Prerequisite Validation and Fix</h1>
<div class="meta">Source/CPM: $([System.Net.WebUtility]::HtmlEncode($script:SourceFqdn)) | Target: $([System.Net.WebUtility]::HtmlEncode($script:ResolvedFqdn)) | Generated: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')</div>
<div class="summary">
<div class="card"><strong>$($counts['PASS'])</strong>Pass</div>
<div class="card"><strong>$($counts['FIXED'])</strong>Fixed</div>
<div class="card"><strong>$($counts['WARN'])</strong>Warning</div>
<div class="card"><strong>$($counts['FAIL'])</strong>Failure</div>
<div class="card"><strong>$($counts['INFO'])</strong>Information</div>
<div class="card"><strong>$($counts['SKIP'])</strong>Skipped</div>
</div>
<table>
<thead><tr><th>Time</th><th>Target</th><th>Component</th><th>Category</th><th>Check</th><th>Status</th><th>Details</th><th>Action / Recommendation</th></tr></thead>
<tbody>
$($rows -join [Environment]::NewLine)
</tbody>
</table>
</body>
</html>
"@

    Set-Content -LiteralPath $Path -Value $html -Encoding UTF8
}

try {
    if ([string]::IsNullOrWhiteSpace($TargetComputer)) {
        $TargetComputer = Read-Host 'Enter the target Windows server FQDN'
    }
    if ([string]::IsNullOrWhiteSpace($TargetComputer)) {
        throw 'TargetComputer cannot be blank.'
    }
    $TargetComputer = $TargetComputer.Trim()

    # Interactive account resolution. For the standard CyberArk dependency design, the same
    # service account is both the managed account and the account used to access the dependency.
    # A separate linked Logon Account can still be supplied through -ManagingAccount.
    if ([string]::IsNullOrWhiteSpace($ServiceAccount)) {
        if (-not [string]::IsNullOrWhiteSpace($ManagedAccount)) {
            $ServiceAccount = $ManagedAccount
        }
        elseif (-not [string]::IsNullOrWhiteSpace($ManagingAccount)) {
            $ServiceAccount = $ManagingAccount
        }
        else {
            $ServiceAccount = Read-Host 'Enter the service account (DOMAIN\username or user@domain)'
        }
    }
    if ([string]::IsNullOrWhiteSpace($ServiceAccount)) {
        throw 'ServiceAccount cannot be blank.'
    }
    $ServiceAccount = $ServiceAccount.Trim()

    if ([string]::IsNullOrWhiteSpace($ManagedAccount)) {
        $ManagedAccount = $ServiceAccount
    }
    if ([string]::IsNullOrWhiteSpace($ManagingAccount)) {
        $ManagingAccount = $ServiceAccount
    }

    if (-not $Credential) {
        $Credential = Get-Credential -UserName $ManagingAccount `
            -Message ("Enter the password for CyberArk managing account '{0}'" -f $ManagingAccount)
    }
    if (-not $Credential) {
        throw 'Credential entry was cancelled or no credential was supplied.'
    }

    if ($Components -contains 'All') {
        $script:SelectedComponents = @('ScheduledTask','WindowsService','IISAppPool')
    }
    else {
        $script:SelectedComponents = @($Components | Sort-Object -Unique)
    }

    $ScheduledTaskPath = Normalize-TaskPath -Path $ScheduledTaskPath
    $script:SourceFqdn = Get-SourceFqdn

    if (-not (Test-Path -LiteralPath $OutputFolder)) {
        New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
    }

    $runStamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $safeTarget = $TargetComputer -replace '[^a-zA-Z0-9._-]', '_'
    $script:LogFile = Join-Path $OutputFolder ("CyberArk_Dependency_Prereq_{0}_{1}.log" -f $safeTarget, $runStamp)

    Write-Log '============================================================'
    Write-Log 'CyberArk dependency prerequisite validation starting.'
    Write-Log ("Source/CPM          : {0}" -f $script:SourceFqdn)
    Write-Log ("Requested target    : {0}" -f $TargetComputer)
    Write-Log ("Service account     : {0}" -f $ServiceAccount)
    Write-Log ("Managing account    : {0}" -f $ManagingAccount)
    Write-Log ("Managed account     : {0}" -f $ManagedAccount)
    Write-Log ("Components          : {0}" -f ($script:SelectedComponents -join ', '))
    Write-Log ("Fix enabled         : {0}" -f $Fix.IsPresent)
    Write-Log ("Write tests enabled : {0}" -f $PerformWriteTest.IsPresent)
    Write-Log ("Operation timeout   : {0} seconds" -f $OperationTimeoutSeconds)
    Write-Log ("Output folder       : {0}" -f $OutputFolder)
    Write-Log '============================================================'

    if ($AddManagingAccountToLocalAdministrators -and -not $Fix) {
        Add-Result -Component 'Common' -Category 'Parameters' -Check 'Administrative membership change' -Status 'WARN' `
            -Details '-AddManagingAccountToLocalAdministrators was supplied without -Fix. No membership change will be made.'
    }

    Add-Result -Component 'Common' -Category 'Source' -Check 'PowerShell version' `
        -Status $(if ($PSVersionTable.PSEdition -eq 'Desktop' -and $PSVersionTable.PSVersion.Major -eq 5) { 'PASS' } else { 'WARN' }) `
        -Details ("PowerShell {0}; edition: {1}; process architecture: {2}-bit." -f $PSVersionTable.PSVersion, $PSVersionTable.PSEdition, ([IntPtr]::Size * 8)) `
        -Recommendation 'Use 64-bit Windows PowerShell 5.1 on the CPM for the closest production-equivalent result.'

    Resolve-TargetFqdn -ComputerName $TargetComputer
    $script:IsTargetLocal = @($script:ResolvedFqdn, ($script:ResolvedFqdn -split '\.')[0]) -contains $script:SourceFqdn -or `
                            @($script:ResolvedFqdn, ($script:ResolvedFqdn -split '\.')[0]) -contains $env:COMPUTERNAME

    if ($script:IsTargetLocal) {
        Add-Result -Component 'Common' -Category 'Topology' -Check 'CPM-to-target path' -Status 'WARN' `
            -Details 'The target is the same computer as the source/CPM. DNS and TCP tests are loopback-local and do not validate an actual CPM-to-remote-target path.' `
            -Recommendation 'For representative network and credential validation, run from another CPM/Connector or test a separate target server.'
    }
    else {
        Add-Result -Component 'Common' -Category 'Topology' -Check 'CPM-to-target path' -Status 'PASS' `
            -Details ("The target '{0}' is remote from source/CPM '{1}'." -f $script:ResolvedFqdn, $script:SourceFqdn)
    }

    foreach ($test in @(
        [pscustomobject]@{ Port = 135; Name = 'RPC Endpoint Mapper' },
        [pscustomobject]@{ Port = 445; Name = 'SMB / File and Printer Sharing' }
    )) {
        $open = Test-TcpPort -ComputerName $script:ResolvedFqdn -Port $test.Port
        Add-Result -Component 'Common' -Category 'Network' -Check ("TCP {0} - {1}" -f $test.Port, $test.Name) `
            -Status $(if ($open) { 'PASS' } else { 'FAIL' }) `
            -Details $(if ($open) { "Reachable from '$($script:SourceFqdn)'." } else { "Not reachable from '$($script:SourceFqdn)'." }) `
            -Recommendation $(if ($open) { '' } else { 'Allow the traffic from the CPM and confirm the target firewall/profile and upstream ACLs.' })
    }

    if ($script:IsTargetLocal -and -not $Credential) {
        $currentIdentity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
        $ManagingAccount = if ($ManagingAccount) { $ManagingAccount } else { $currentIdentity }
    }
    else {
        if (-not $Credential) { throw 'A credential is required for a remote target.' }
        if ([string]::IsNullOrWhiteSpace($ManagingAccount)) { $ManagingAccount = $Credential.UserName }
    }

    if ([string]::IsNullOrWhiteSpace($ManagingAccount)) {
        throw 'ManagingAccount could not be determined.'
    }

    if ($ManagingAccount -match '@' -or $ManagingAccount -match '\\') {
        Add-Result -Component 'Common' -Category 'Authentication' -Check 'Domain-qualified account' -Status 'PASS' `
            -Details ("Managing account: '{0}'." -f $ManagingAccount)
    }
    else {
        Add-Result -Component 'Common' -Category 'Authentication' -Check 'Domain-qualified account' -Status 'FAIL' `
            -Details ("Managing account '{0}' is not domain-qualified." -f $ManagingAccount) `
            -Recommendation 'Use a domain account in UPN or DOMAIN\username format to support Kerberos.'
    }

    if (-not (New-TargetCimSession)) {
        throw 'Remote authentication failed; no target changes were attempted.'
    }

    $targetOs = Get-CimInstance -ClassName Win32_OperatingSystem -CimSession $script:CimSession
    $targetCs = Get-CimInstance -ClassName Win32_ComputerSystem -CimSession $script:CimSession
    $script:TargetWindowsDirectory = [string]$targetOs.WindowsDirectory
    $supportedServer = ($targetOs.Caption -match 'Windows Server 2019|Windows Server 2022|Windows Server 2025')
    $supportedClient = ($targetOs.Caption -match 'Windows 10|Windows 11')

    Add-Result -Component 'Common' -Category 'Target' -Check 'Operating system' `
        -Status $(if ($supportedServer -or $supportedClient) { 'PASS' } else { 'WARN' }) `
        -Details ("{0}; version {1}; build {2}." -f $targetOs.Caption, $targetOs.Version, $targetOs.BuildNumber) `
        -Recommendation $(if ($supportedServer -or $supportedClient) { '' } else { 'Confirm support for this target OS with the CyberArk release used by your tenant/connector.' })

    Add-Result -Component 'Common' -Category 'Target' -Check 'Active Directory domain membership' `
        -Status $(if ($targetCs.PartOfDomain) { 'PASS' } else { 'FAIL' }) `
        -Details $(if ($targetCs.PartOfDomain) { "Joined to '$($targetCs.Domain)'." } else { 'The target is not joined to an Active Directory domain.' }) `
        -Recommendation $(if ($targetCs.PartOfDomain) { '' } else { 'Domain membership is required for the documented Kerberos configuration.' })

    Test-AndOptionallyAddLocalAdmin
    Test-CyberArkUacRequirement

    Write-Stage 'Common prerequisite: network adapter bindings'
    Test-AndFixNetworkBindings

    Write-Stage 'Common prerequisite: required Windows services'
    Test-AndFixRequiredServices -Selected $script:SelectedComponents

    Write-Stage 'Component prerequisite: Windows Firewall rule groups'
    Test-AndFixFirewall -Selected $script:SelectedComponents

    if ($script:SelectedComponents -contains 'ScheduledTask') {
        Write-Stage 'Scheduled Task validation'
        Add-CyberArkPortalManualChecks -Component 'ScheduledTask'
        Test-ScheduledTaskComponent
    }
    if ($script:SelectedComponents -contains 'WindowsService') {
        Test-WindowsServiceDocumentationRequirements
        Write-Stage 'Windows Service validation'
        Test-WindowsServiceComponent
    }
    if ($script:SelectedComponents -contains 'IISAppPool') {
        Write-Stage 'IIS Application Pool validation'
        Add-CyberArkPortalManualChecks -Component 'IISAppPool'
        Test-IISAppPoolComponent
    }
}
catch {
    Add-Result -Component 'Common' -Category 'Execution' -Check 'Fatal error' -Status 'FAIL' `
        -Details $_.Exception.Message `
        -Recommendation 'Review the preceding results and log. No credential password is written to the output.'
}
finally {
    if ($script:CimSession) {
        try { Remove-CimSession -CimSession $script:CimSession -ErrorAction SilentlyContinue } catch {}
    }

    if (-not (Test-Path -LiteralPath $OutputFolder)) {
        New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
    }

    $finalStamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $safeFinalTarget = if ($TargetComputer) { $TargetComputer -replace '[^a-zA-Z0-9._-]', '_' } else { 'UnknownTarget' }
    $csvPath = Join-Path $OutputFolder ("CyberArk_Dependency_Prereq_{0}_{1}.csv" -f $safeFinalTarget, $finalStamp)
    $htmlPath = Join-Path $OutputFolder ("CyberArk_Dependency_Prereq_{0}_{1}.html" -f $safeFinalTarget, $finalStamp)

    # PowerShell 5.1 can throw 'Argument types do not match' when an array
    # subexpression directly wraps System.Collections.Generic.List[object].
    # Enumerate the list through the pipeline to create a normal Object[] safely.
    [object[]]$data = @($script:Results | ForEach-Object { $_ })
    if ($data.Count -gt 0) {
        $data | Export-Csv -LiteralPath $csvPath -NoTypeInformation -Encoding UTF8
        Export-HtmlReport -Path $htmlPath -Data $data
    }

    $passCount = @($data | Where-Object Status -eq 'PASS').Count
    $fixedCount = @($data | Where-Object Status -eq 'FIXED').Count
    $warnCount = @($data | Where-Object Status -eq 'WARN').Count
    $failCount = @($data | Where-Object Status -eq 'FAIL').Count
    $skipCount = @($data | Where-Object Status -eq 'SKIP').Count

    Write-Log '============================================================'
    Write-Log ("Completed. PASS={0}; FIXED={1}; WARN={2}; FAIL={3}; SKIP={4}" -f $passCount, $fixedCount, $warnCount, $failCount, $skipCount)
    Write-Log ("CSV report  : {0}" -f $csvPath)
    Write-Log ("HTML report : {0}" -f $htmlPath)
    Write-Log ("Log file    : {0}" -f $script:LogFile)
    Write-Log '============================================================'

    [pscustomobject]@{
        Target     = $script:ResolvedFqdn
        Components = $script:SelectedComponents -join ', '
        Pass       = $passCount
        Fixed      = $fixedCount
        Warning    = $warnCount
        Failed     = $failCount
        Skipped    = $skipCount
        CsvReport  = $csvPath
        HtmlReport = $htmlPath
        LogFile    = $script:LogFile
    }
}
