[states]
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"
RunCommand=(spawn)plink.exe <address> -<protocol> -P <port>
StoreKeyInCache=y
CheckInitAction=
CheckExtraPass=
LoginUser=$username
SendPassword=$curr_pass
CheckAction=
LoginExtraUser=<extrapass1\username>
SendExtraPassword=<pmextrapass1>
# --- AsyncOS password change flow ---
ChangeStep1=password
ChangeStepOld=<$curr_pass>
ChangeStepNew=<pmnewpass>
ChangeStepRetype=<pmnewpass>
ChangeStepCommit=commit
ChangeStepCommitComment=
FinalStep=
END=
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILNotSupported2=FAIL(Logon account is required, 8002)
FAILInvalidExtraPassword=FAIL(First login - Current assigned logon account password is invalid, 8006)
FAILAccountDisabled2=FAIL(First login - Current assigned logon account user is disabled, 8011)
FAILNotAllowedLogin2=FAIL(First login - Current assigned logon account is not allowed to log in, 8013)
# AsyncOS-specific failures
FAILPassMismatch=FAIL(New password and confirmation do not match, 2102)
FAILPassRejected=FAIL(New password rejected by device policy (complexity/invalid char), 2103)
FAILCommitFailed=FAIL(Commit failed or not at top-level prompt, 2104)

[transitions]
Init,TRUE,RunCommand

RunCommand,UnableToConnect,FAILUnableToConnect
RunCommand,PlinkStoreKey,StoreKeyInCache
# handle standard SSH login path
RunCommand,Login,LoginUser
LoginUser,Password,SendPassword

# after sending password, branch by outcome
SendPassword,InvalidLogin,FAILTARGETInvalidUsernameOrPassword
SendPassword,AccountDisabled,FAILAccountDisabled1
SendPassword,NotAllowedLogin,FAILNotAllowedLogin1
SendPassword,StandardPrompt,CheckInitAction

StoreKeyInCache,Login,LoginUser

CheckInitAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckInitAction,ActionIsNotRecOrPreRec,CheckExtraPass

CheckExtraPass,ExtraPassExists,LoginExtraUser
CheckExtraPass,ExtraPassNotExists,FAILNotSupported2

LoginExtraUser,Password,SendExtraPassword
SendExtraPassword,InvalidLogin,FAILInvalidExtraPassword
SendExtraPassword,Password,FAILInvalidExtraPassword
SendExtraPassword,AccountDisabled,FAILAccountDisabled2
SendExtraPassword,NotAllowedLogin,FAILNotAllowedLogin2
SendExtraPassword,StandardPrompt,CheckAction

# main action router
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsChange,ChangeStep1

# --- AsyncOS password change conversation ---
ChangeStep1,PasswdOldPrompt,ChangeStepOld
ChangeStepOld,PasswdNewPrompt,ChangeStepNew
ChangeStepNew,PasswdRetypePrompt,ChangeStepRetype

# handle retype errors before we ever get the prompt again
ChangeStepRetype,PassMismatch,FAILPassMismatch
ChangeStepRetype,PassRejected,FAILPassRejected

# after successful retype, we should be back at top-level '>' prompt
ChangeStepRetype,StandardPrompt,ChangeStepCommit

# commit sequence
ChangeStepCommit,CommitPrompt,ChangeStepCommitComment
ChangeStepCommit,CommitSucceeded,FinalStep
ChangeStepCommitComment,CommitSucceeded,FinalStep
ChangeStepCommit,CommitFailed,FAILCommitFailed
ChangeStepCommitComment,CommitFailed,FAILCommitFailed

# safety fallbacks
FinalStep,TRUE,END

[CPM Parameters Validation]
address, source=FILE, Mandatory=yes
extrapass1\Username, source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]
[Parameters]
PromptTimeout=30
SendHuman=.1 .3 1 .05 2
[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no

