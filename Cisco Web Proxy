Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# Basics
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# --- AsyncOS SSH login banners & prompts ---
# Devices often show "login as:" or "Username:"; include both
Login=login as:|login:|Username:
Password=Password:|Passphrase:

# --- Generic auth failures visible before shell prompt ---
InvalidLogin=Access denied|Login incorrect|Authentication failed
PermissionDenied=(?i)Permission denied
AccountDisabled=(?i)account has been locked|account disabled
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.

# --- We consider we've reached the shell when it ends with typical AsyncOS symbols (> or #) ---
# Avoid any unicode/ANSI escapes in this pattern to prevent "unicode format" errors
StandardPrompt=.*[>#] ?$

# --- Actions ---
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])

# --- ExtraPass presence checks ---
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# --- AsyncOS 'passwd' dialogue variations (Email/Secure Web share the AsyncOS base) ---
OldPassPrompt=(?i)Old (password|passphrase):|(?i)Please enter the old (password|passphrase):
NewPassPrompt=(?i)New (password|passphrase):|(?i)Enter new (password|passphrase):
RetypePassPrompt=(?i)Retype new (password|passphrase):|(?i)Re-enter new (password|passphrase):
PassChangeSuccess=(?i)(password|passphrase) (updated|changed|success)
OldPassRejected=(?i)incorrect (password|passphrase)|(?i)authentication token manipulation error
PassChangeDenied=(?i)not authorized|permission denied|policy.*reject|meets the minimum.*no

# --- Common CLI error lines (just in case) ---
InvalidCommand=(?i)^% ?Invalid (input|command).*$
IncompleteCommand=(?i)^% ?Incomplete command\.$
AmbiguousCommand=(?i)^% ?Ambiguous command\.$
CommandRejected=(?i)^% ?(Error in|Command (rejected|failed)|Invalid input detected).*

# --- Pager prompts (rare on passwd, present on some 'show' outputs) ---
MorePrompt=--More--|<--- More --->
