Process

#This plugin has been automatically generated by PGU. Version 1.0.0.0
[states]
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"
RunCommand=(spawn)plink.exe <address> -<protocol> -P <port>
StoreKeyInCache=y

# Prefer logging in with LOGON account (extrapass1) when present
CheckInitAction=
CheckExtraPass=
LoginExtraUser=<extrapass1\username>
SendExtraPassword=<pmextrapass1>

# Fallback if no LOGON account provided
LoginUser=$username
SendPassword=$curr_pass

WaitForPrompt=
CheckAction=

# --- Password change via AsyncOS userconfig -> Local Users ---
# Enter userconfig
ChangeStep1=userconfig
# Enter Local Users menu (accept either "local", "users" or "1")
ChangeStep2=local
# Select the target username (managed account)
ChangeStep3=<username>
# Choose change password action (accept "change", "password", or "2")
ChangeStep4=change
# Enter new password
ChangeStep5=<pmnewpass>
# Re-enter new password
ChangeStep6=<pmnewpass>
# Commit changes (some changes require commit to persist)
ChangeStep7=commit
# Confirm commit if prompted
ChangeStep8=y
# Exit to end session
ChangeStep9=exit

FinalStep=
END=

# --- Failures ---
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILNotSupported2=FAIL(Logon account is required, 8002)
FAILInvalidExtraPassword=FAIL(First login - Current assigned logon account password is invalid, 8006)
FAILAccountDisabled2=FAIL(First login - Current assigned logon account user is disabled, 8011)
FAILNotAllowedLogin2=FAIL(First login - Current assigned logon account is not allowed to log in, 8013)
FAILPermissionDenied=FAIL(Permission denied during authentication, 2114)
FAILOldPasswordRejected=FAIL(Current password rejected by device, 2114)
FAILPasswordChangeDenied=FAIL(Device denied password change (policy/role), 2114)
FAILNoLocalUser=FAIL(Target user is not a local AsyncOS user (cannot change via CLI), 2114)
FAILMenuNavigation=FAIL(Unexpected AsyncOS menu flow while changing password, 2114)

[transitions]
# Start
Init,TRUE,RunCommand

# Spawn & key cache
RunCommand,UnableToConnect,FAILUnableToConnect
RunCommand,PlinkStoreKey,StoreKeyInCache
RunCommand,Login,CheckInitAction

StoreKeyInCache,Login,CheckInitAction

# Decide whether to use logon account
CheckInitAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckInitAction,ActionIsNotRecOrPreRec,CheckExtraPass

# If we have a logon account, use it; else use managed account directly
CheckExtraPass,ExtraPassExists,LoginExtraUser
CheckExtraPass,ExtraPassNotExists,LoginUser

# --- Logon account path ---
LoginExtraUser,Password,SendExtraPassword
SendExtraPassword,InvalidLogin,FAILInvalidExtraPassword
SendExtraPassword,PermissionDenied,FAILPermissionDenied
SendExtraPassword,AccountDisabled,FAILAccountDisabled2
SendExtraPassword,NotAllowedLogin,FAILNotAllowedLogin2
SendExtraPassword,StandardPrompt,WaitForPrompt

# --- Managed account fallback path ---
LoginUser,Password,SendPassword
SendPassword,InvalidLogin,FAILTARGETInvalidUsernameOrPassword
SendPassword,PermissionDenied,FAILPermissionDenied
SendPassword,AccountDisabled,FAILAccountDisabled1
SendPassword,NotAllowedLogin,FAILNotAllowedLogin1
SendPassword,StandardPrompt,WaitForPrompt

# Common post-login
WaitForPrompt,StandardPrompt,CheckAction

# What are we doing?
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsChange,ChangeStep1

# --- AsyncOS userconfig flow ---
ChangeStep1,UserConfigMain,ChangeStep2
ChangeStep1,NoLocalUserMsg,FAILNoLocalUser
ChangeStep1,StandardPrompt,FAILMenuNavigation

ChangeStep2,LocalUsersMenu,ChangeStep3
ChangeStep2,UserConfigMain,ChangeStep2
ChangeStep2,StandardPrompt,FAILMenuNavigation

# Select target user (by name)
ChangeStep3,SelectUserPrompt,ChangeStep3
ChangeStep3,UserActionsMenu,ChangeStep4
ChangeStep3,UserNotLocalMsg,FAILNoLocalUser
ChangeStep3,StandardPrompt,FAILMenuNavigation

# Choose "change password" action
ChangeStep4,NewPassPrompt,ChangeStep5
ChangeStep4,UserActionsMenu,ChangeStep4
ChangeStep4,StandardPrompt,FAILMenuNavigation

# Provide new password
ChangeStep5,RetypePassPrompt,ChangeStep6
ChangeStep5,PasswordPolicyDenied,FAILPasswordChangeDenied
ChangeStep5,StandardPrompt,FAILMenuNavigation

# Confirm new password
ChangeStep6,ChangeSucceeded,ChangeStep7
ChangeStep6,PasswordPolicyDenied,FAILPasswordChangeDenied
ChangeStep6,StandardPrompt,ChangeStep7

# Commit and exit
ChangeStep7,CommitConfirm,ChangeStep8
ChangeStep7,CommitSucceeded,ChangeStep9
ChangeStep7,StandardPrompt,ChangeStep9

ChangeStep8,CommitSucceeded,ChangeStep9
ChangeStep8,StandardPrompt,ChangeStep9

ChangeStep9,TRUE,FinalStep
FinalStep,TRUE,END

[CPM Parameters Validation]
address, source=FILE, Mandatory=yes
extrapass1\Username, source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]

[Parameters]
PromptTimeout=60
SendHuman=.1 .3 1 .05 2

[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no





