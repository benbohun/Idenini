Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# --- SSH login prompts ---
Login=login as:|login:|Username:
Password=Password:

InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd|Authentication failed
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# --- AsyncOS top-level prompt (typical is hostname ending in '>')
StandardPrompt=.*> ?$|.*\# ?$|.*\] ?$|.*\$\u001b\[.*m ?$|.*\> ?\u001b\[.*m ?$

# --- Action selectors ---
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]

ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])

ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# --- AsyncOS password change prompts ---
PasswdOldPrompt=(?i)^(Old|Enter old|Current)\s+password:\s*$
PasswdNewPrompt=(?i)^(Enter\s+new\s+password|New\s+password)\s*:\s*$
PasswdRetypePrompt=(?i)^(Re-?enter\s+new\s+password|Retype\s+new\s+password)\s*:\s*$

# Errors commonly seen during password set
PassMismatch=(?i)passwords?\s+do(es)?\s+not\s+match
PassRejected=(?i)password\s+(rejected|invalid)|too\s+short|complexity|not\s+meet|illegal|invalid\s+character

# --- Commit prompts/results ---
CommitPrompt=(?i)Please\s+enter\s+some\s+comments\s+describing\s+your\s+changes:
CommitSucceeded=(?i)Changes\s+committed|Configuration\s+committed
CommitFailed=(?i)commit\s+(failed|error)|You\s+must\s+be\s+at\s+the\s+top-level

# --- Pager prompt (rare on WSA, safe to include) ---
MorePrompt=--More--|<--- More --->

