Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# AsyncOS login banners and prompts
Login=login as:|login:|Username:
Password=Password:
PermissionDenied=(?i)Permission denied

# Actions
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]

# General prompts
StandardPrompt=.*[>#] ?$

InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# --- AsyncOS userconfig flow (WSA/S300V) ---
UserConfigMain=(?i)User (Account|Access) Configuration|(?i)^userconfig\b|(?i)Choose.*operation|(?i)Enter choice
LocalUsersMenu=(?i)(Local Users|Add/Edit Local Users|Manage Local Users|List of local users)
SelectUserPrompt=(?i)(Select user|Which user|Enter the name of the user|Enter user name)
UserActionsMenu=(?i)(Change password|Edit user|Delete user|Add user|User Actions|Enter choice)
NewPassPrompt=(?i)(Enter new (password|passphrase)|New (password|passphrase):)
RetypePassPrompt=(?i)(Re-enter new (password|passphrase)|Retype (password|passphrase):)
ChangeSucceeded=(?i)(Password (changed|updated)|Success|completed successfully)
PasswordPolicyDenied=(?i)(does not meet|too short|too simple|forbidden|not allowed|policy)
CommitConfirm=(?i)Commit changes.*\[Y/N\]|\(y/n\)|Apply changes.*\[Y/N\]
CommitSucceeded=(?i)Changes committed|commit complete|Configuration committed
NoLocalUserMsg=(?i)There is no user configured locally.*|(?i)No local users configured
UserNotLocalMsg=(?i)User .* is not a local user|(?i)External authentication.*cannot change

# Extra-pass presence checks
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]
