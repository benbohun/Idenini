Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# core
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# login & state
Login=login as:|login:|Username:
PasswordPrompt=Password:
InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
AccountDisabled=Account is disabled .*|account has been locked
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
StandardPrompt=.*[>#] ?$

# action select
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]

# extra pass (LOGON account) presence – expression prompts MUST be defined
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# --- AsyncOS menus (as seen in your transcript) ---
# main userconfig landing (shows users + "Choose the operation..." and ends with []>)
UserConfigMain=(?is)(Users:.*?Choose the operation.*?\[\]>\s*)$

# PASSWORD menu (shows ASSIGN/FORCE and ends with []>)
PasswordMenu=(?is)Choose the operation you want to perform:.*?- +ASSIGN - Manually assign a new account password\..*?\[\]>\s*$

# after typing ASSIGN, expect prompt asking which user
PasswordAssignMenu=(?i)^\s*Enter the username or number to edit\.\s*\[\]>\s*$

# type the username (admin)
SelectUserPrompt=(?i)^\s*Enter the username or number to edit\.\s*\[\]>\s*$

# enter secret twice
NewPassPrompt=(?i)^\s*Enter the new passphrase for .*?\.\s*\[\]>\s*$
RetypePassPrompt=(?i)^\s*Please enter the new passphrase again:\s*$

# commit flow (documented AsyncOS behavior asks for a comment then rollback save)
CommitCommentPrompt=(?i)^\s*Please enter some comments describing your changes:\s*\[\]>\s*$
CommitRollbackPrompt=(?i)^\s*Do you want to save the current configuration for rollback\?\s*\[Y\]>\s*$
CommitDone=(?i)^\s*Changes committed:.*$\s*

# misc
OptionError=(?i)^\s*Unknown option\..*$
MorePrompt=--More--|<--- More --->
