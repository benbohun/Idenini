Process

#This plugin has been automatically generated by PGU. Version 1.0.0.0
[states]
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"
RunCommand=(spawn)plink.exe <address> -<protocol> -P <port>
StoreKeyInCache=y

# Use LOGON account (required); no reconcile in this flow
CheckExtraPass=
LoginExtraUser=<extrapass1\username>
SendExtraPassword=<pmextrapass1>

# Post-login
WaitForPrompt=
CheckAction=

# ---- Change admin password via AsyncOS menus ----
ChangeStep1=userconfig
ChangeStep2=PASSWORD
ChangeStep3=ASSIGN
ChangeStep4=admin
ChangeStep5=<pmnewpass>
ChangeStep6=<pmnewpass>
# Leave menu (just Enter at []>)
ChangeStep7=(nocrlf)\r

# Commit changes from '>'
ChangeStep8=commit
ChangeStep9=password change for admin
ChangeStep10=Y
# Exit
ChangeStep11=exit

FinalStep=
END=

# ---- Failures ----
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILNotSupported2=FAIL(Logon account is required, 8002)
FAILInvalidExtraPassword=FAIL(First login - Current assigned logon account password is invalid, 8006)
FAILAccountDisabled2=FAIL(First login - Current assigned logon account user is disabled, 8011)
FAILNotAllowedLogin2=FAIL(First login - Current assigned logon account is not allowed to log in, 8013)
FAILPermissionDenied=FAIL(Permission denied during authentication, 2114)

[transitions]
# Start
Init,TRUE,RunCommand

# Spawn & trust-on-first-use
RunCommand,UnableToConnect,FAILUnableToConnect
RunCommand,PlinkStoreKey,StoreKeyInCache
RunCommand,TRUE,CheckExtraPass

StoreKeyInCache,TRUE,CheckExtraPass

# Require a LOGON account
CheckExtraPass,ExtraPassExists,LoginExtraUser
CheckExtraPass,ExtraPassNotExists,FAILNotSupported2

# Logon account path
LoginExtraUser,Password,SendExtraPassword
SendExtraPassword,InvalidLogin,FAILInvalidExtraPassword
SendExtraPassword,AccountDisabled,FAILAccountDisabled2
SendExtraPassword,NotAllowedLogin,FAILNotAllowedLogin2
SendExtraPassword,StandardPrompt,WaitForPrompt

# Post-login
WaitForPrompt,StandardPrompt,CheckAction

# Actions
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsChange,ChangeStep1

# ---- Menu flow ----
ChangeStep1,UserConfigMain,ChangeStep2
ChangeStep2,MenuPrompt,ChangeStep3
ChangeStep3,UsernamePrompt,ChangeStep4
ChangeStep4,NewPassPrompt1,ChangeStep5
ChangeStep5,NewPassPrompt2,ChangeStep6
ChangeStep6,UserConfigMain,ChangeStep7           # back to top, then Enter to exit
ChangeStep7,StandardPrompt,ChangeStep8

# ---- Commit flow ----
ChangeStep8,CommentPrompt,ChangeStep9
ChangeStep9,CommitRollbackPrompt,ChangeStep10
# Some versions ask rollback twice; loop until we see commit done or prompt
ChangeStep10,CommitRollbackPrompt,ChangeStep10
ChangeStep10,CommitDone,ChangeStep11
ChangeStep10,StandardPrompt,ChangeStep11

# Exit
ChangeStep11,TRUE,FinalStep
FinalStep,TRUE,END

[CPM Parameters Validation]
address, source=FILE, Mandatory=yes
extrapass1\Username, source=FILE, Mandatory=![string equal -nocase "<pmextrapass1>" ""]

[Parameters]
PromptTimeout=60
SendHuman=.1 .3 1 .05 2

[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no













