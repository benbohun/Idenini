Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# Basics
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login
Login=login as:|login:|Username:
Password=Password:
InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
PermissionDenied=(?i)Permission denied

# Generic device prompt (works on any hostname)
StandardPrompt=.*[>#] ?$

# Action selection (no reconcile)
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]
ActionIsLogonOrChange=(expression)[string equal -nocase "<action>" logon]||[string equal -nocase "<action>" changepass]

# LOGON account presence
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# --- AsyncOS userconfig menus ---

# Top menu (long block) OR bare []> line
UserConfigMain=Choose the operation you want to perform:[\s\S]*?\[\]> ?$|^\[\]> ?$

# After "PASSWORD"
PasswordMenu=Choose the operation you want to perform:[\s\S]*?- ASSIGN - Manually assign a new account password\.[\s\S]*?- FORCE - Force a user to change the account password\.[\s\S]*?\[\]> ?$|^\[\]> ?$

# "Enter the username or number to edit."
UsernamePrompt=Enter the username or number to edit\.[\s\S]*?\[\]> ?$

# First passphrase prompt
NewPassPrompt1=Enter the new passphrase(?: for [^\r\n]+)?\.[\s\S]*?\[\]> ?$

# Policy failure immediately after first passphrase
PolicyFail=Following criteria for passphrase are not met:[\s\S]*?Enter the new passphrase(?: for [^\r\n]+)?\.[\s\S]*?\[\]> ?$

# Confirmation prompt (line ends with colon; nothing else)
NewPassPrompt2=Please enter the new passphrase again:\s*$

# Commit prompts (lenient, multiline-safe)
CommitCommentPrompt=Please enter some comments describing your changes:[\s\S]*?\[\]> ?$
CommitRollbackPrompt=Do you want to save the current configuration for rollback\?\s*\[Y\]> ?$
CommitDone=Changes committed:\s*.*$
