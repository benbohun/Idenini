Prompt


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# Basics
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login dialog
Login=login as:|login:|Username:
Password=Password:
InvalidLogin=Access denied|Login incorrect|You entered an invalid login name or passwd
PermissionDenied=(?i)Permission denied

# Device prompt (AsyncOS shows '>')
StandardPrompt=.*[>#] ?$

# Actions allowed (no reconcile)
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]
ActionIsLogonOrChange=(expression)[string equal -nocase "<action>" logon]||[string equal -nocase "<action>" changepass]

# Decide whether a LOGON account exists
ExtraPassExists=(expression)![string equal -nocase "<pmextrapass1>" ""]
ExtraPassNotExists=(expression)[string equal -nocase "<pmextrapass1>" ""]

# --- AsyncOS userconfig menus (as seen in your session) ---

# Top userconfig menu OR the bare []> line
UserConfigMain=(?is)Choose the operation you want to perform:.*?\[\]> ?$|^\[\]> ?$

# After selecting PASSWORD
PasswordMenu=(?is)Choose the operation you want to perform:.*?- ASSIGN - Manually assign a new account password\..*?- FORCE - Force a user to change the account password\..*?\[\]> ?$|^\[\]> ?$

# "Enter the username or number to edit." line (with next []> prompt)
UsernamePrompt=(?is)Enter the username or number to edit\.\s*\[\]> ?$

# First new passphrase prompt (accepts optional "for admin")
NewPassPrompt1=(?is)Enter the new passphrase(?: for .*?)?\.\s*\[\]> ?$

# Policy failure immediately after first passphrase
PolicyFail=(?is)Following criteria for passphrase are not met:.*?Enter the new passphrase(?: for .*?)?\.\s*\[\]> ?$

# Confirmation prompt
NewPassPrompt2=(?i)^Please enter the new passphrase again:\s*$

# Commit prompts
CommitCommentPrompt=(?is)^Please enter some comments describing your changes:\s*\[\]> ?$
CommitRollbackPrompt=(?i)^Do you want to save the current configuration for rollback\?\s*\[Y\]> ?$
CommitDone=(?i)^Changes committed: .*

