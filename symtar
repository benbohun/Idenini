To Change
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:user="http://www.symxchange.generated.symitar.com/noncrud/usermanagement" xmlns:cmn="http://www.symxchange.generated.symitar.com/symxcommon">
  <soapenv:Header/>
  <soapenv:Body>
    <user:setUserPassword>
      <Request cmn:MessageId="{{messageId}}">
        <Credentials cmn:ProcessorUser="{{resetProcessorUser}}">
          <AdministrativeCredentials>
            <Password>{{adminPassword}}</Password>
            <Version_1/>
          </AdministrativeCredentials>
        </Credentials>
        <DeviceInformation DeviceType="{{deviceType}}" DeviceNumber="{{deviceNumber}}"/>
        <UserNumber>{{userNumber}}</UserNumber>
        <Password>{{newPassword}}</Password>
        <Version_1/>
      </Request>
    </user:setUserPassword>
  </soapenv:Body>
</soapenv:Envelope>
