<#
.SYNOPSIS
    Compares an Active Directory service-account CSV against CyberArk Privilege Cloud
    and reports which accounts are vaulted or not vaulted.

.DESCRIPTION
    Authentication:
      CCP -> CyberArk Identity Shared Services -> Privilege Cloud ServiceUser session.

    Matching behavior:
      - Case-insensitive.
      - Trims leading/trailing whitespace.
      - Treats DOMAIN\username, username@domain, and username as possible equivalents.
      - Optionally validates the AD Address/Domain against the CyberArk account Address.
      - Preserves all source CSV columns in the summary report with an "AD_" prefix.
      - Does not retrieve passwords or modify any CyberArk account.

    Output:
      1. *_Summary.csv     - One row per AD source record.
      2. *_Matches.csv     - One row per CyberArk account match.
      3. *_NotVaulted.csv  - AD records with no visible CyberArk match.
      4. *.log             - Execution log.

    IMPORTANT:
      "NotVaulted" means the API service user could not see a matching account.
      The service user must have List Accounts permission in every relevant Safe.

.NOTES
    Compatible with Windows PowerShell 5.1.

    Version 1.1:
      - Removes PowerShell 5.1 generic-list array conversion that can produce:
        "Argument types do not match".
      - Adds paged bulk retrieval when Get-PASAccount supports -limit and -offset.
#>

[CmdletBinding()]
param(
    # ===== Identity / Privilege Cloud =====
    [string]$IdentityTenantURL = "https://aak4521.my.idaptive.app",
    [string]$PrivilegeCloudURL = "https://alliantcredit.privilegecloud.cyberark.cloud",

    # ===== CCP settings =====
    [string]$CCPAddress     = "https://aam.alliantcreditunion.com",
    [string]$CCPLocation    = "AIMWebService",
    [string]$CCPAppID       = "ACURestAPI",
    [string]$CCPSafe        = "ACU-VAULT-API",
    [string]$CCPObject      = "Application-CyberArkVaultRestAPI-alliantcredit.cyberark.cloud",
    [bool]$CCPWindowsAuth   = $false,

    # ===== Input =====
    [string]$InputCsvPath,

    # Leave blank to auto-detect.
    [string]$UsernameColumn,
    [string]$AddressColumn,

    # Bulk retrieves the visible CyberArk inventory once.
    # Search queries CyberArk once per unique AD username.
    [ValidateSet("Bulk", "Search")]
    [string]$LookupMode = "Bulk",

    # When enabled, a username match with a different address is not classified as Vaulted.
    [switch]$RequireAddressMatch,

    # ===== Output =====
    [string]$OutputDirectory,
    [string]$OutputBaseName = "AD_ServiceAccount_CyberArk_Comparison"
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = "Stop"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# =====================================================================
# General helpers
# =====================================================================

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [ValidateSet("INFO", "WARN", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $entry = "{0} | {1,-7} | {2}" -f $timestamp, $Level, $Message

    if ($script:LogFile) {
        Add-Content -LiteralPath $script:LogFile -Value $entry -Encoding UTF8
    }

    switch ($Level) {
        "SUCCESS" { Write-Host $entry -ForegroundColor Green }
        "WARN"    { Write-Host $entry -ForegroundColor Yellow }
        "ERROR"   { Write-Host $entry -ForegroundColor Red }
        default   { Write-Host $entry -ForegroundColor Cyan }
    }
}

function Select-InputCsvFile {
    [CmdletBinding()]
    param()

    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop

        $dialog = New-Object System.Windows.Forms.OpenFileDialog
        $dialog.Title = "Select the Active Directory service-account CSV"
        $dialog.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*"
        $dialog.Multiselect = $false
        $dialog.CheckFileExists = $true
        $dialog.CheckPathExists = $true

        if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            return $dialog.FileName
        }

        throw "No input CSV was selected."
    }
    catch {
        $path = Read-Host "Enter the full path to the AD service-account CSV"
        if ([string]::IsNullOrWhiteSpace($path)) {
            throw "No input CSV path was provided."
        }

        return $path.Trim('"')
    }
}

function Get-PropertyNameCaseInsensitive {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object]$InputObject,

        [Parameter(Mandatory = $true)]
        [string[]]$CandidateNames
    )

    $availableNames = @($InputObject.PSObject.Properties.Name)

    foreach ($candidate in $CandidateNames) {
        foreach ($availableName in $availableNames) {
            if ([string]::Equals(
                    [string]$availableName,
                    [string]$candidate,
                    [System.StringComparison]::OrdinalIgnoreCase
                )) {
                return [string]$availableName
            }
        }
    }

    return $null
}

function Get-ObjectPropertyValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object]$InputObject,

        [Parameter(Mandatory = $true)]
        [string]$PropertyName
    )

    foreach ($property in $InputObject.PSObject.Properties) {
        if ([string]::Equals(
                [string]$property.Name,
                [string]$PropertyName,
                [System.StringComparison]::OrdinalIgnoreCase
            )) {
            return $property.Value
        }
    }

    return $null
}

function ConvertTo-NormalizedText {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($null -eq $Value) {
        return ""
    }

    return ([string]$Value).Trim().ToUpperInvariant()
}

function Get-UsernameKeys {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$Username
    )

    $value = ConvertTo-NormalizedText -Value $Username
    $keyMap = @{}

    if ([string]::IsNullOrWhiteSpace($value)) {
        return
    }

    $keyMap[$value] = $true

    # DOMAIN\username -> username
    if ($value.Contains("\")) {
        $samValue = $value.Substring($value.LastIndexOf("\") + 1).Trim()

        if (-not [string]::IsNullOrWhiteSpace($samValue)) {
            $keyMap[$samValue] = $true
        }
    }

    # username@domain -> username
    if ($value.Contains("@")) {
        $upnSamValue = $value.Substring(0, $value.IndexOf("@")).Trim()

        if (-not [string]::IsNullOrWhiteSpace($upnSamValue)) {
            $keyMap[$upnSamValue] = $true
        }
    }

    foreach ($key in $keyMap.Keys) {
        Write-Output ([string]$key)
    }
}

function ConvertTo-NormalizedAddress {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($null -eq $Value) {
        return ""
    }

    $text = ([string]$Value).Trim()

    if ([string]::IsNullOrWhiteSpace($text)) {
        return ""
    }

    # Distinguished name, for example:
    # CN=svcAccount,OU=Service Accounts,DC=prod,DC=example,DC=com
    if ($text -match "(?i)(^|,)DC=") {
        $dcParts = @()

        foreach ($part in ($text -split ",")) {
            $trimmedPart = $part.Trim()

            if ($trimmedPart -match "^(?i)DC=(.+)$") {
                $dcParts += $Matches[1].Trim()
            }
        }

        if ($dcParts.Count -gt 0) {
            return (($dcParts -join ".").Trim(".")).ToUpperInvariant()
        }
    }

    # UPN or email address -> domain portion.
    if ($text.Contains("@")) {
        $domainPart = $text.Substring($text.LastIndexOf("@") + 1).Trim()
        if (-not [string]::IsNullOrWhiteSpace($domainPart)) {
            return $domainPart.Trim(".").ToUpperInvariant()
        }
    }

    # Normalize common URL forms without changing ordinary DNS names.
    $text = $text -replace "^(?i)https?://", ""
    $text = $text.Trim().TrimEnd("/").TrimEnd(".")

    return $text.ToUpperInvariant()
}

function Get-FirstNonEmptySourceValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object]$Row,

        [Parameter(Mandatory = $true)]
        [string[]]$CandidateColumns
    )

    foreach ($candidate in $CandidateColumns) {
        $propertyName = Get-PropertyNameCaseInsensitive -InputObject $Row -CandidateNames @($candidate)

        if ($propertyName) {
            $value = Get-ObjectPropertyValue -InputObject $Row -PropertyName $propertyName

            if ($null -ne $value -and -not [string]::IsNullOrWhiteSpace([string]$value)) {
                return [PSCustomObject]@{
                    Column = $propertyName
                    Value  = $value
                }
            }
        }
    }

    return $null
}

function Get-CyberArkAccountUniqueKey {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object]$Account
    )

    $id = Get-ObjectPropertyValue -InputObject $Account -PropertyName "id"

    if (-not [string]::IsNullOrWhiteSpace([string]$id)) {
        return "ID::{0}" -f ([string]$id).Trim().ToUpperInvariant()
    }

    $safeName = Get-ObjectPropertyValue -InputObject $Account -PropertyName "safeName"
    $platform = Get-ObjectPropertyValue -InputObject $Account -PropertyName "platformId"
    $username = Get-ObjectPropertyValue -InputObject $Account -PropertyName "userName"
    $address  = Get-ObjectPropertyValue -InputObject $Account -PropertyName "address"
    $name     = Get-ObjectPropertyValue -InputObject $Account -PropertyName "name"

    return "OBJECT::{0}|{1}|{2}|{3}|{4}" -f `
        (ConvertTo-NormalizedText $safeName),
        (ConvertTo-NormalizedText $platform),
        (ConvertTo-NormalizedText $username),
        (ConvertTo-NormalizedAddress $address),
        (ConvertTo-NormalizedText $name)
}

function Join-UniqueValues {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object[]]$Values
    )

    $uniqueValues = @{}

    foreach ($value in @($Values)) {
        if ($null -eq $value) {
            continue
        }

        $textValue = ([string]$value).Trim()

        if (-not [string]::IsNullOrWhiteSpace($textValue)) {
            $uniqueValues[$textValue.ToUpperInvariant()] = $textValue
        }
    }

    return (($uniqueValues.Values | Sort-Object) -join "; ")
}

