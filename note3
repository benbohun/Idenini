{
  "info": {
    "name": "SymXchange - UserManagement (Verify + Reset)",
    "_postman_id": "2f6e4c9e-8e7a-4c8f-9d6d-7b7b0e9a6c11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "symHost", "value": "symdev" },
    { "key": "symPort", "value": "8088" },
    { "key": "symPath", "value": "SymXchange/usermanagement" },

    { "key": "messageId", "value": "msg" },

    { "key": "verifyProcessorUser", "value": "1540" },
    { "key": "resetProcessorUser", "value": "840" },

    { "key": "adminPassword", "value": "aaaa1111" },

    { "key": "deviceType", "value": "CYBERARK" },
    { "key": "deviceNumber", "value": "6767" },

    { "key": "userNumber", "value": "1534" },
    { "key": "userPassword", "value": "aaaa1111" },
    { "key": "newPassword", "value": "NewPass123!" }
  ],
  "item": [
    {
      "name": "UserManagement",
      "item": [
        {
          "name": "verifyUser",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
              { "key": "Accept", "value": "text/xml" },
              { "key": "SOAPAction", "value": "verifyUser" }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:user=\"http://www.symxchange.generated.symitar.com/noncrud/usermanagement\" xmlns:cmn=\"http://www.symxchange.generated.symitar.com/symxcommon\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <user:verifyUser>\n      <Request cmn:MessageId=\"{{messageId}}\">\n        <Credentials cmn:ProcessorUser=\"{{verifyProcessorUser}}\">\n          <AdministrativeCredentials>\n            <Password>{{adminPassword}}</Password>\n            <Version_1/>\n          </AdministrativeCredentials>\n        </Credentials>\n        <DeviceInformation DeviceType=\"{{deviceType}}\" DeviceNumber=\"{{deviceNumber}}\"/>\n        <UserToVerify>\n          <UserNumber>{{userNumber}}</UserNumber>\n          <Password>{{userPassword}}</Password>\n          <Version_1/>\n        </UserToVerify>\n        <Version_1/>\n      </Request>\n    </user:verifyUser>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": {
              "raw": "http://{{symHost}}:{{symPort}}/{{symPath}}",
              "protocol": "http",
              "host": ["{{symHost}}"],
              "port": "{{symPort}}",
              "path": ["{{symPath}}"]
            }
          },
          "response": []
        },
        {
          "name": "setUserPassword (Reset)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
              { "key": "Accept", "value": "text/xml" },
              { "key": "SOAPAction", "value": "setUserPassword" }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:user=\"http://www.symxchange.generated.symitar.com/noncrud/usermanagement\" xmlns:cmn=\"http://www.symxchange.generated.symitar.com/symxcommon\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <user:setUserPassword>\n      <Request cmn:MessageId=\"{{messageId}}\">\n        <Credentials cmn:ProcessorUser=\"{{resetProcessorUser}}\">\n          <AdministrativeCredentials>\n            <Password>{{adminPassword}}</Password>\n            <Version_1/>\n          </AdministrativeCredentials>\n        </Credentials>\n        <DeviceInformation DeviceType=\"{{deviceType}}\" DeviceNumber=\"{{deviceNumber}}\"/>\n        <UserNumber>{{userNumber}}</UserNumber>\n        <Password>{{newPassword}}</Password>\n        <Version_1/>\n      </Request>\n    </user:setUserPassword>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": {
              "raw": "http://{{symHost}}:{{symPort}}/{{symPath}}",
              "protocol": "http",
              "host": ["{{symHost}}"],
              "port": "{{symPort}}",
              "path": ["{{symPath}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
