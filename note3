<# =====================================================================
Get-DormantEmptySafes.ps1

Purpose
-------
Uses the existing CCP -> CyberArk Identity Header -> psPAS login method to:
  1. Retrieve every Safe visible to the API identity.
  2. Retrieve the visible CyberArk account inventory once using paging.
  3. Count accounts by Safe.
  4. Export Safes that contain zero visible accounts.

Outputs
-------
E:\Installation Media\Script\OnboardScript\data\Dormant_Safes_Without_Accounts.csv
E:\Installation Media\Script\OnboardScript\data\Dormant_Safes_Without_Accounts.log

Important
---------
The result is limited to Safes and accounts visible to CA_PAMDiscovery_SVC.
For authoritative tenant-wide results, this identity must be able to list all
required Safes and list accounts in those Safes.
===================================================================== #>

[CmdletBinding()]
param(
    [ValidateRange(1, 1000)]
    [int]$PageSize = 500,

    # Safety limit. The script stops instead of producing a potentially
    # inaccurate empty-Safe report if this limit is exceeded.
    [ValidateRange(1, 500000)]
    [int]$MaxAccountsToInspect = 200000,

    # Optional Safe-name filter. Examples:
    #   *                  = all visible Safes
    #   AP-*-P-C1-AMNG     = only AMNG application Safes
    [ValidateNotNullOrEmpty()]
    [string]$SafeNameLike = '*',

    # Optional regular expression for Safe names to exclude.
    # Example: '^(System|VaultInternal|PSM)'
    [string]$ExcludeSafeNameRegex = ''
)

# =========================
# Baseline
# =========================
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

Import-Module psPAS -Force -ErrorAction Stop

# =========================
# Output paths
# =========================
$OutDir = 'E:\Installation Media\Script\OnboardScript\data'
if (-not (Test-Path -LiteralPath $OutDir)) {
    New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
}

$LogFile = Join-Path $OutDir 'Dormant_Safes_Without_Accounts.log'
$CsvFile = Join-Path $OutDir 'Dormant_Safes_Without_Accounts.csv'
New-Item -ItemType File -Path $LogFile -Force | Out-Null

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ConsoleColor]$Color = 'White'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$timestamp - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -LiteralPath $LogFile -Value $line
}

