function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR','DEBUG')][string]$Level = 'INFO'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = '{0} | {1,-7} | {2}' -f $timestamp, $Level, $Message

    $color = switch ($Level) {
        'SUCCESS' { 'Green' }
        'WARN'    { 'Yellow' }
        'ERROR'   { 'Red' }
        'DEBUG'   { 'Gray' }
        default   { 'Cyan' }
    }

    try { Write-Host $line -ForegroundColor $color } catch { Write-Host $line }
    try { Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8 } catch {}
}

function Add-SummaryRow {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail,
        [Nullable[int]]$RowNumber = $null,
        [string]$TargetApplicationName = $null,
        [string]$TargetIdentityAppKey = $null
    )

    if ($null -eq $RowNumber -and $null -ne $script:CurrentTargetRowNumber) {
        $RowNumber = [int]$script:CurrentTargetRowNumber
    }
    if ([string]::IsNullOrWhiteSpace($TargetApplicationName) -and -not [string]::IsNullOrWhiteSpace($script:CurrentTargetApplicationName)) {
        $TargetApplicationName = $script:CurrentTargetApplicationName
    }
    if ([string]::IsNullOrWhiteSpace($TargetIdentityAppKey) -and -not [string]::IsNullOrWhiteSpace($script:CurrentTargetIdentityAppKey)) {
        $TargetIdentityAppKey = $script:CurrentTargetIdentityAppKey
    }

    $script:SummaryRows += [pscustomobject]@{
        Timestamp             = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
        RowNumber             = $RowNumber
        TargetApplicationName = $TargetApplicationName
        TargetIdentityAppKey  = $TargetIdentityAppKey
        Step                  = $Step
        Status                = $Status
        Detail                = $Detail
    }
}

function Get-CsvValue {
    param(
        [Parameter(Mandatory)][object]$Row,
        [Parameter(Mandatory)][string[]]$ColumnNames
    )

    foreach ($columnName in $ColumnNames) {
        if ($Row.PSObject -and $Row.PSObject.Properties.Name -contains $columnName) {
            $value = [string]$Row.$columnName
            if (-not [string]::IsNullOrWhiteSpace($value)) {
                return $value.Trim()
            }
        }
    }

    return $null
}

function New-SampleTargetCsv {
    param([Parameter(Mandatory)][string]$Path)

    $parent = Split-Path -Path $Path -Parent
    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -Path $parent -ItemType Directory -Force | Out-Null
    }

    @(
        [pscustomobject]@{ ApplicationName = 'svc-gcp-app-001'; IdentityAppKey = '' }
        [pscustomobject]@{ ApplicationName = 'svc-gcp-app-002'; IdentityAppKey = '' }
    ) | Export-Csv -LiteralPath $Path -NoTypeInformation -Force

    Write-Log ("Sample target CSV created: {0}" -f $Path) 'SUCCESS'
}

function Import-TargetApplicationCsv {
    param([Parameter(Mandatory)][string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        throw ("Target CSV was not found: {0}" -f $Path)
    }

    $rows = @(Import-Csv -LiteralPath $Path)
    if ($rows.Count -eq 0) {
        throw ("Target CSV contains no rows: {0}" -f $Path)
    }

    $targets = @()
    $rowNumber = 1

    foreach ($row in $rows) {
        $targetName = Get-CsvValue -Row $row -ColumnNames @('ApplicationName','TargetApplicationName','Name','AppName')
        $targetKey = Get-CsvValue -Row $row -ColumnNames @('IdentityAppKey','TargetIdentityAppKey','AppKey')

        if ([string]::IsNullOrWhiteSpace($targetName) -and [string]::IsNullOrWhiteSpace($targetKey)) {
            Write-Log ("CSV row {0} skipped because neither an application name nor Identity app key was supplied." -f $rowNumber) 'WARN'
            Add-SummaryRow -Step 'Import CSV Row' -Status 'SKIPPED' -Detail 'Missing target application name and Identity app key.' -RowNumber $rowNumber
            $rowNumber++
            continue
        }

        $targets += [pscustomobject]@{
            RowNumber             = $rowNumber
            TargetApplicationName = $targetName
            TargetIdentityAppKey  = $targetKey
        }
        $rowNumber++
    }

    if ($targets.Count -eq 0) {
        throw 'No valid target applications were found in the CSV.'
    }

    return $targets
}

function Get-TargetRows {
    if (-not [string]::IsNullOrWhiteSpace($CsvPath)) {
        if (-not [string]::IsNullOrWhiteSpace($TargetApplicationName) -or -not [string]::IsNullOrWhiteSpace($TargetIdentityAppKey)) {
            Write-Log 'CsvPath was supplied. The single-target parameters will be ignored.' 'WARN'
        }
        return @(Import-TargetApplicationCsv -Path $CsvPath)
    }

    if ([string]::IsNullOrWhiteSpace($TargetApplicationName) -and [string]::IsNullOrWhiteSpace($TargetIdentityAppKey)) {
        throw 'Provide -CsvPath, -TargetApplicationName, or -TargetIdentityAppKey.'
    }

    return @([pscustomobject]@{
        RowNumber             = 1
        TargetApplicationName = $TargetApplicationName
        TargetIdentityAppKey  = $TargetIdentityAppKey
    })
}

function Get-SafeFolderName {
    param([Parameter(Mandatory)][string]$Value)

    $safe = [regex]::Replace($Value.Trim(), '[^A-Za-z0-9._-]+', '_')
    $safe = $safe.Trim('_','.')
    if ([string]::IsNullOrWhiteSpace($safe)) { return 'Target' }
    if ($safe.Length -gt 80) { return $safe.Substring(0, 80) }
    return $safe
}

function Convert-SecureStringToPlainText {
    param([Parameter(Mandatory)][SecureString]$SecureString)

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecureString)
    try {
        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    }
    finally {
        if ($bstr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        }
    }
}

function Select-InputFile {
    param(
        [Parameter(Mandatory)][string]$Title,
        [Parameter(Mandatory)][string]$Filter,
        [string]$InitialDirectory = ''
    )

    try {
        Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop
        $dialog = New-Object System.Windows.Forms.OpenFileDialog
        $dialog.Title = $Title
        $dialog.Filter = $Filter
        $dialog.Multiselect = $false
        $dialog.CheckFileExists = $true
        if (-not [string]::IsNullOrWhiteSpace($InitialDirectory) -and (Test-Path -LiteralPath $InitialDirectory)) {
            $dialog.InitialDirectory = $InitialDirectory
        }

        $result = $dialog.ShowDialog()
        if ($result -eq [System.Windows.Forms.DialogResult]::OK) {
            return $dialog.FileName
        }
    }
    catch {
        Write-Log ("File-selection dialog was unavailable: {0}" -f $_.Exception.Message) 'WARN'
    }

    return (Read-Host $Title)
}

function Resolve-TargetCsvPath {
    if (-not [string]::IsNullOrWhiteSpace($CsvPath) -and (Test-Path -LiteralPath $CsvPath)) {
        return
    }

    if (-not [string]::IsNullOrWhiteSpace($CsvPath)) {
        Write-Log ("Configured CSV file was not found: {0}" -f $CsvPath) 'WARN'
    }

    $initialDirectory = 'E:\Installation Media\Script\OnboardScript\SWS_Application_Script\data'
    $selected = Select-InputFile `
        -Title 'Select the CSV containing the already provisioned Identity applications' `
        -Filter 'CSV files (*.csv)|*.csv|All files (*.*)|*.*' `
        -InitialDirectory $initialDirectory

    if ([string]::IsNullOrWhiteSpace($selected) -or -not (Test-Path -LiteralPath $selected)) {
        throw 'A valid target application CSV file is required.'
    }

    $script:CsvPath = $selected
}

function Initialize-SwsAuthenticationPrompt {
    if (-not [string]::IsNullOrWhiteSpace($SwsAccessToken)) {
        return
    }

    $helperReady = -not [string]::IsNullOrWhiteSpace($SwsTenantId) -and
                   -not [string]::IsNullOrWhiteSpace($TokenHelperJarPath) -and
                   -not [string]::IsNullOrWhiteSpace($SwsServiceAccountSecretPath)
    if ($helperReady) {
        return
    }

    Write-Host ''
    Write-Host 'SWS API authentication' -ForegroundColor Cyan
    Write-Host 'The regular Identity username/password login used by the provisioning script cannot authenticate the SWS public API.' -ForegroundColor Yellow
    Write-Host 'Choose how this test should authenticate to SWS:' -ForegroundColor White
    Write-Host '  [1] Paste a current SWS service-account access token' -ForegroundColor White
    Write-Host '  [2] Generate a token with the CyberArk public API token-helper JAR' -ForegroundColor White

    $choice = Read-Host 'Selection [1]'
    if ([string]::IsNullOrWhiteSpace($choice)) { $choice = '1' }

    switch ($choice.Trim()) {
        '2' {
            if ([string]::IsNullOrWhiteSpace($SwsTenantId)) {
                $script:SwsTenantId = Read-Host 'Enter the SWS tenant ID (the hexadecimal tenant ID, not aat4012.id.cyberark.cloud)'
            }
            if ([string]::IsNullOrWhiteSpace($SwsTenantId)) {
                throw 'SwsTenantId is required when using the CyberArk token helper.'
            }

            if ([string]::IsNullOrWhiteSpace($TokenHelperJarPath) -or -not (Test-Path -LiteralPath $TokenHelperJarPath)) {
                $selectedJar = Select-InputFile `
                    -Title 'Select public-api-auth-helper-0.0.1-SNAPSHOT-application.jar' `
                    -Filter 'Java archive (*.jar)|*.jar|All files (*.*)|*.*'
                if ([string]::IsNullOrWhiteSpace($selectedJar) -or -not (Test-Path -LiteralPath $selectedJar)) {
                    throw 'A valid CyberArk public API token-helper JAR is required.'
                }
                $script:TokenHelperJarPath = $selectedJar
            }

            if ([string]::IsNullOrWhiteSpace($SwsServiceAccountSecretPath) -or -not (Test-Path -LiteralPath $SwsServiceAccountSecretPath)) {
                $selectedSecret = Select-InputFile `
                    -Title 'Select the SWS service-account JSON secret file' `
                    -Filter 'JSON files (*.json)|*.json|All files (*.*)|*.*'
                if ([string]::IsNullOrWhiteSpace($selectedSecret) -or -not (Test-Path -LiteralPath $selectedSecret)) {
                    throw 'A valid SWS service-account JSON secret file is required.'
                }
                $script:SwsServiceAccountSecretPath = $selectedSecret
            }
        }
        '1' { }
        default {
            throw ("Unsupported authentication selection '{0}'. Choose 1 or 2." -f $choice)
        }
    }
}

function ConvertTo-JsonDeep {
    param([Parameter()][object]$InputObject)
