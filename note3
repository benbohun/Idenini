    # Authentication option 1: supply an access token directly.
    [string]$SwsAccessToken = '',

    # Authentication option 2: run CyberArk's public API token helper.
    [string]$SwsTenantId = '',
    [string]$TokenHelperJarPath = '',
    [string]$SwsServiceAccountSecretPath = '',
