
<#
CNA_Create_And_Update_Identity_WebApp_Reauth_CsvBatch.ps1

Purpose
- Prompt for regular CyberArk Identity credential once
- Read applications to create from a CSV file
- Create each app from GenericBrowserExtensionScript
- Dynamically set app Description to:
  This GCP Application is managed by Service Account ("ApplicationName")
- Wait 15 seconds by default after each app create before the update phase
- Re-establish CyberArk Identity session for each app update phase
- Update the newly created app using the returned _RowKey
- Apply non-script settings and the Browser Extension (advanced) login workflow
- Finish create + wait + reauth + update for the current app before starting the next app
- No PAS validation
- No psPAS dependency

CSV format
- Required column: ApplicationName
- Also accepted for the name column: Name or AppName
- Optional columns: DisplayName, Description
- If DisplayName is blank, it defaults to ApplicationName
- If Description is blank, it defaults to:
  This GCP Application is managed by Service Account ("ApplicationName")

Sample CSV
ApplicationName
svc-gcp-app-001
svc-gcp-app-002
#>

[CmdletBinding()]
param(
    [string]$IdentityApiTenantURL      = 'https://aat4012.id.cyberark.cloud',

    [string]$RegularUserName           = '',
    [string]$RegularUserPassword       = '',

    # CSV input
    [string]$CsvPath                   = 'E:\Installation Media\Script\OnboardScript\data\GCPAccountSample.csv',
    [switch]$CreateSampleCsv,
    [switch]$StopOnFirstFailure,

    # Create
    [string]$TemplateId                = 'GenericBrowserExtensionScript',

    # App settings
    [string]$Name                      = 'g-test-pam1',
    [string]$DisplayName               = 'GCP - Okta Prod',
    [string]$Category                  = '_I18N_AppCategory_Other',
    [string]$DefaultAuthProfile        = 'AlwaysAllowed',
    [string]$DefaultAuthProfileUuid    = 'AlwaysAllowed',
    [bool]$OnPrem                      = $true,
    [bool]$IsSwsEnabled                = $true,
    [bool]$ShowRegistration            = $false,
    [string]$AdminTag                  = '_I18N_AppCategory_Other',
    [string]$UserNameStrategy          = 'SetByUser',
    [bool]$FormFillingEnabled          = $true,
    [bool]$Generic                     = $true,
    [string]$AppType                   = 'Web',
    [string]$Description               = '_I18N_AppDesc_Generic_BE_Script',
    [string]$IconUri                   = '/vfslow/lib/application/icons/GenericBrowserExtension.svg',
    [string]$WebAppType                = 'UsernamePassword',
    [string]$TemplateName              = 'GenericBrowserExtensionScript',
    [string]$Notes                     = '',
    [bool]$LocalizationEnabled         = $false,
    [string]$WebUPAppType              = 'BrowserExtensionScript',
    [bool]$NotSelfService              = $true,

    # Advanced Browser Extension workflow
    [string]$AdvancedScript            = @'
loginData.applicationUrl = "https://cna.okta.com/login/default";
loginData.addField("username", "input#input44", LoginUsername + "@cna.com");
loginData.addField("password", "input#input77", LoginPassword);
loginData.formPattern = "form";
loginData.globalSelectorTimeout = 10000;
loginData.order = [
  ["fill", "username"],
  ["click", "input[type='submit'][value='Next']"],
  ["waitForNewPage"],
  ["sleep", 1000],
  ["fill", "password"],
  ["click", "input[type='submit'][value='Verify']"]
];
'@,

    # Timing / retries
    [int]$PreUpdateDelaySeconds        = 15,
    [int]$UpdateRetryWindowSeconds     = 300,
    [int]$RetryIntervalSeconds         = 20,
    [int]$MaxUpdateReauthAttempts      = 2,

    # Logging
    [string]$LogPath                   = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_And_Update_Reauth.log',
    [string]$ReportCsvPath             = 'E:\Installation Media\Script\OnboardScript\data\Identity_Create_And_Update_Reauth_Report.csv'
)

$script:IdentityAuthToken         = $null
$script:IdentityUser              = $null
$script:IdentityWebSession        = $null
$script:RegularCredential         = $null
$script:RegularUserPlainPassword  = $null
$script:ReportRows                = @()
$script:CurrentCsvRowNumber       = $null
$script:CurrentAppName            = $null
$script:CurrentDisplayName        = $null
$script:CurrentAppRowKey          = $null
$script:HadApplicationFailures    = $false

function Write-Log {
    param(
        [Parameter(Mandatory)][string]$Message,
        [ValidateSet('White','Gray','Green','Yellow','Red','Cyan')][string]$Color = 'White'
    )

    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"

    try { Write-Host $line -ForegroundColor $Color } catch { Write-Host $line }

    try {
        $parent = Split-Path -Path $LogPath -Parent
        if ($parent -and -not (Test-Path $parent)) {
            New-Item -Path $parent -ItemType Directory -Force | Out-Null
        }
        Add-Content -Path $LogPath -Value $line
    } catch {}
}

function Add-ReportRow {
    param(
        [string]$Step,
        [string]$Status,
        [string]$Detail,
        [Nullable[int]]$RowNumber = $null,
        [string]$AppName = $null,
        [string]$RowKey = $null
    )

    if ($null -eq $RowNumber -and $null -ne $script:CurrentCsvRowNumber) {
        $RowNumber = [int]$script:CurrentCsvRowNumber
    }
    if ([string]::IsNullOrWhiteSpace($AppName) -and -not [string]::IsNullOrWhiteSpace($script:CurrentAppName)) {
        $AppName = $script:CurrentAppName
    }
    if ([string]::IsNullOrWhiteSpace($RowKey) -and -not [string]::IsNullOrWhiteSpace($script:CurrentAppRowKey)) {
        $RowKey = $script:CurrentAppRowKey
    }

    $script:ReportRows += [pscustomobject]@{
        Timestamp = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
        RowNumber = $RowNumber
        AppName   = $AppName
        RowKey    = $RowKey
        Step      = $Step
        Status    = $Status
        Detail    = $Detail
    }
}

function ConvertTo-JsonSafe {
    param([Parameter()][object]$Object)
    if ($null -eq $Object) { return $null }
    return ($Object | ConvertTo-Json -Depth 100)
}

function Get-DirectField {
    param(
        [Parameter(Mandatory)]$Object,
        [Parameter(Mandatory)][string]$FieldName
    )

    if ($null -eq $Object) { return $null }

    if ($Object -is [System.Collections.IDictionary]) {
        if ($Object.Contains($FieldName)) { return $Object[$FieldName] }
        return $null
    }

    if ($Object.PSObject -and $Object.PSObject.Properties.Name -contains $FieldName) {
        return $Object.$FieldName
    }

    return $null
}

function Convert-SecureStringToPlainText {
    param([Parameter(Mandatory)][SecureString]$SecureString)

    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecureString)
    try {
        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
    } finally {
        if ($bstr -ne [IntPtr]::Zero) {
            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
        }
    }
}

function Get-RegularCredential {
    if ([string]::IsNullOrWhiteSpace($RegularUserName)) {
        $script:RegularCredential = Get-Credential -Message 'Enter REGULAR user credential for CyberArk Identity'
        if ($null -eq $script:RegularCredential) {
            throw 'Credential prompt was cancelled.'
        }
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $script:RegularCredential.Password
        return
    }

    if ([string]::IsNullOrWhiteSpace($RegularUserPassword)) {
        $secure = Read-Host "Enter password for $RegularUserName" -AsSecureString
        $script:RegularUserPlainPassword = Convert-SecureStringToPlainText -SecureString $secure
    } else {
        $secure = ConvertTo-SecureString $RegularUserPassword -AsPlainText -Force
        $script:RegularUserPlainPassword = $RegularUserPassword
    }

    $script:RegularCredential = [pscredential]::new($RegularUserName, $secure)
}

function Get-PreferredCsvValue {
    param(
        [Parameter(Mandatory)]$Row,
        [Parameter(Mandatory)][string[]]$ColumnNames
    )

    foreach ($columnName in $ColumnNames) {
        if ($Row.PSObject -and $Row.PSObject.Properties.Name -contains $columnName) {
            $value = [string]$Row.$columnName
            if (-not [string]::IsNullOrWhiteSpace($value)) {
                return $value.Trim()
            }
        }
    }

    return $null
}

