##########################################################################
###			CiscoUCSlocaladmin PROCESS FILE
#			v9.20170404.1
#			v9.20170524.2 - Fixed CheckChangePass to run "show user"
##########################################################################


[states]

#States contain all commands sent to the remote device, as well as commands executed locally on the password manager
#States names can contain only alphabet and numeric characters

#######################
#Initialization States#
#######################
#Set variables for use during the execution of the plugin
Init=(script)set VerifyLogon 0; set username "<username>"; set curr_pass "<pmpass>";
SetVerifyLogon=(script)set VerifyLogon 1; set username "<username>"; set curr_pass "<pmnewpass>"



#########################
#Login password sequence#
#########################
StartSessionSSH=(spawn)bin\\plink.exe <address> -<protocol> -P <port>
StartSessionTelnet=(spawn)bin\\plink.exe <address> -telnet -P <port>
StoreKeyInCache=y
LoginUser=<username>
LoginPass=$curr_pass


##########################
#Change password sequence#
##########################

#CheckChangePass=show user
ScopeSecurity=scope security

ScopeUser=scope local-user <username>
ChangePass=set password
ChangePassOldPass=<pmpass>
ChangePassNewPass=<pmnewpass>
ChangePassVerifyNewPass=<pmnewpass>

StartCommit=(startsync)pmterminal-<policyId>-<address>
commit=commit
EndCommit=(endsync)pmterminal-<policyId>-<address>
ExitSecurity=end



#################
#Logoff sequence#
#################

close=(script)close




#####################
#Check Action States#
#####################
#Empty placeholder states to check for certain conditions before executing a command
CheckUser
CheckAction
CheckProtocol
#WaitForPromptBeforeScope



#############
#Final State#
#############
#END is a special state that ends the plugin successfully
END



################
#Failure States#
################
#List of failure states and their error messages and codes.
#Error codes below 8100 are standard codes. Error codes above 8101 are unique to the device.
#Add error states in the following format:
#FAILStateName=FAIL(Failure message, error code)
FailUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILInvalidCurrPassword1=FAIL(First login - Bad username or password while logging to the machine, 8001)
FAILInvalidCurrPassword2=FAIL(Current password is invalid while trying to change password, 8002)
FAILInvalidNewPassword2=FAIL(Invalid new password while sending new password verification, 8005)
FAILPasswordIsExpired=FAIL(Password is expired. Logon not allowed, 8010)
FailUnrecognizedKey=FAIL(SSH Fingerprint is unrecognized. See solution #1205 in the web support portal for more information, 8089)

FAILUnsupportedUser=FAIL(Unsupported user. This platform only manages the localadmin account, 8100)
FAILScopeUser=FAIL(scope user command failed - please check logs for details, 8101)
FailChangePass=FAIL(set password command failed - no changes to commit, 8102)
FailCommit=FAIL(commit failed - check password generation policy as it may be too weak for the target device, 8103)
FAILBadfIDConfig=FAIL(policy configuration localAdminID is not set to the correct value for localadmin account, 8104)

[transitions]

#
#CurrentState		        Condition		   	             NextState
#------------		        ----------------	   	       -------------- 
#############################################################################
#                           INITIALIZATIONS
#The Init state is always the first state executed. It is responsible for 
#defining variable values.
#############################################################################
Init,					TRUE,					CheckUser

#CheckUser,				UserNotLocaladmin,		FAILUnsupportedUser
CheckUser,				TRUE,					CheckProtocol


#############################################################################
#                           CHECK ACTIONS
#This section is for logic that determines what operation the plugin is executing.
#The CheckAction states are place holders that do not perform actual commands.
#############################################################################

#After regular logon, check if we are done, or if we are changing a password
CheckAction,			IsVerifyLogon,			END
CheckAction,			ActionIsLogon,			END
CheckAction,			ActionIsVerify,			END
CheckAction,			ActionIsChange,			ScopeSecurity


#############################################################################
#						START SESSION PHASE
#Starts plink session.
#############################################################################

#Check if using SSH or telnet
CheckProtocol,			ProtocolIsSSH,			StartSessionSSH
CheckProtocol,			ProtocolIsTelnet,		StartSessionTelnet

#Start PLink process
StartSessionSSH,		ConnectionFailed,		FailUnableToConnect
StartSessionSSH,		PlinkStoreKey,			StoreKeyInCache
StartSessionSSH,		KeyChanged,				FailUnrecognizedKey
StartSessionSSH,		Login,					LoginUser
StartSessionTelnet,		ConnectionFailed,		FailUnableToConnect
StartSessionTelnet,		Login,					LoginUser

#If key is new, add key to cache. If the key is changed, plugin will error out.
StoreKeyInCache,		Login,					LoginUser


#############################################################################
#						LOGON PHASE
#############################################################################
			
#Logon sequence for target user
LoginUser,				Password,				LoginPass			
LoginPass,				InvalidLogin,			FAILInvalidCurrPassword1
LoginPass,				PasswordExpired,		FAILPasswordIsExpired
LoginPass,				StandardPrompt,			CheckAction

#############################################################################
#					CHANGE PASSWORD PHASE
#############################################################################
ScopeSecurity,		LineMatchId,			ScopeUser
ScopeSecurity,		StandardPrompt,			FAILBadfIDConfig

#WaitForPromptBeforeScope,StandardPrompt,	ScopeUser

#Execute change password command
ScopeUser,			UserPrompt,				ChangePass
ScopeUser,			StandardPrompt,			FAILScopeUser

ChangePass,				OldPassword,			ChangePassOldPass
ChangePass,				NewPassword,			ChangePassNewPass

#If necessary, send current password
ChangePassOldPass,		BadCurrentPassword,		FAILInvalidCurrPassword2
ChangePassOldPass,		NewPassword,			ChangePassNewPass			

#Send new password
ChangePassNewPass,		VerifyNewPassword,		ChangePassVerifyNewPass

#Send verification of new password
ChangePassVerifyNewPass,BadNewPassword,			FAILInvalidNewPassword2
ChangePassVerifyNewPass,CommitChangesPrompt,	StartCommit
ChangePassVerifyNewPass,StandardPrompt,			FailChangePass

StartCommit,			TRUE,					commit
commit,					CommitError,			FailCommit
commit,					UserPrompt,				EndCommit
EndCommit,				TRUE,					ExitSecurity	
ExitSecurity,				StandardPrompt,				close	
#############################################################################
#					INITIALIZE POST-CHANGE VERIFICATION PHASE
#############################################################################

#Close connection process, and initialize verification of new password
close,						TRUE,					SetVerifyLogon
SetVerifyLogon,				TRUE,					CheckProtocol	



[CPM Parameters Validation]
#Validations that determine what arguments are required for proper plugin execution

# account
username, 		source=FILE, Mandatory=yes
address, 		source=FILE, Mandatory=yes

# policy
protocol, 		source=FILE, Mandatory=yes
port, 			source=FILE, Mandatory=yes
localAdminID, 	source=FILE, Mandatory=yes
policyId, 		source=FILE, Mandatory=yes

[parameters]
#Parameters that determine how the plugin sends information to the device. For example, how long to wait for a response, and how quickly to send characters

PromptTimeout=30
#SendSlow=1 .01
SendHuman=.1 .1 10 .05 .05


[Debug Information]
#When troubleshooting a plugin, set all debug flags to 'yes'
#When troubleshooting is finished, set all debug flags back to 'no' to avoid run-away debug logs

DebugLogFullParsingInfo=yes
DebugLogFullExecutionInfo=yes
DebugLogDetailBuiltInActions=yes
ExpectLog=yes
ConsoleOutput=yes

