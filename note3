##########################################################################
###                CiscoUCSlocaladmin PROMPTS FILE
#                 v9.20170404.1 - hardened 2025-09-25
##########################################################################

# Conditions names can contain only alphabet and numeric characters
# Conditions values are case-insensitive, regular expressions
[conditions]

##################
# Standard Prompts
##################
# Accepts start-of-line OR newline, variable spacing, common prompt enders.
StandardPrompt=(?:^|\r?\n).*(\$|#|>|%|\])\s?$

# In "scope local-user" without pending changes
UserPrompt=(?:^|\r?\n).*/local-user\s*#\s?$

# In "scope local-user" WITH pending changes (note the star).
# Covers: "/security/local-user* #", "/security/local-user *#", "/security/local-user*#"
# Allows either '#' or '>' as the final prompt char.
CommitChangesPrompt=(?:^|\r?\n).*/local-user\s*\*\s*[#>]\s?$


###############
# Logon Prompts
###############
Login=login as:|login:
Password=Password:|Enter the password for .*
PasswordExpired=Password expired\.|Choose a new password
InvalidLogin=Access Denied|You entered an invalid login name or password|password:
PlinkStoreKey=Store key in cache
ConnectionFailed=Connect failed|FATAL ERROR:|Unable to open connection:|Could not open connection to the host
KeyChanged=Update cached key\?


####################################
# Change / Reset Password Prompts
####################################
# Allow start-of-line or newline, variable spacing
LineMatchId=(?:^|\r?\n).*/security\s*#\s?$

# Old/current password variants
OldPassword=Enter current password:|Enter old password:

# Common bad-current messages
BadCurrentPassword=Sorry, wrong passwd|Authentication failed|Current password is incorrect

# New password prompts across NX-OS/UCS/FXOS
NewPassword=Please enter password:|Enter a password:|Enter new password:|New password:

# Invalid-new messages (broadened for multiple devices)
BadNewPassword=New passwords do not match\.|Password is invalid\.|Invalid value|Password contains invalid characters|Password too short|Password complexity.*failed

# Confirmation variants
VerifyNewPassword=Please confirm password:|Confirm the password:|Retype new password:|Confirm new password:

# Generic commit error line
CommitError=Error:.*\r?\n


########################
# Logic / Condition Checks
########################
# Check protocol
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]

# Check which action chosen
ActionIsLogon=(expression)[string equal -nocase <action> logon]
ActionIsVerify=(expression)[string equal -nocase <action> verifypass]
ActionIsChange=(expression)[string equal -nocase <action> changepass]

IsVerifyLogon=(expression)$VerifyLogon == 1

# Always true
TRUE=(expression)true



