    # When blank, the current official collection is downloaded automatically.
    [string]$PostmanCollectionPath = '',
    [string]$PostmanCollectionDownloadUrl = 'https://docs.cyberark.com/find-sws-docs/latest/en/content/resources/downloads/secure_web_session.postman_collection.zip',

    [int]$TargetPolicyWaitSeconds = 900,
    [int]$PollIntervalSeconds = 30,
    [int]$MaximumPoliciesToInspect = 500,

    [switch]$Execute,

    [string]$OutputFolder = '',
    [string]$LogPath = '',

    [string]$Proxy = '',
    [System.Management.Automation.PSCredential]$ProxyCredential
