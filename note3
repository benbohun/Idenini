#requires -Version 5.1
<#
.SYNOPSIS
    Rebuilds a missing or broken local Windows profile for a domain or local account.

.DESCRIPTION
    Designed for the condition where the account resolves to a SID, but no usable
    Win32_UserProfile/ProfileList entry exists and Windows signs the user in with
    a temporary profile (Events 1511/1515).

    The script:
      - Resolves the account and SID.
      - Ensures the affected user is signed out.
      - Backs up ProfileList and ProfileGUID.
      - Preserves stale profile folders instead of deleting them.
      - Removes stale SID, SID.bak, and ProfileGUID registrations.
      - Validates the Default profile hive.
      - Builds a fresh profile from C:\Users\Default.
      - Registers the profile directly under ProfileList.
      - Applies profile ACLs for the affected SID.
      - Optionally restarts the server.

    Run from a DIFFERENT administrator account.

.EXAMPLE
    .\Repair-TemporaryUserProfile-v3.ps1 -UserName 'CNAW2K\CAF9456'

.EXAMPLE
    .\Repair-TemporaryUserProfile-v3.ps1 -UserName 'CNAW2K\CAF9456' -RestartServer
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $false)]
    [ValidateNotNullOrEmpty()]
    [string]$UserName = 'CNAW2K\CAF9456',

    [Parameter(Mandatory = $false)]
    [switch]$RestartServer
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$TimeStamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$SafeUserName = $UserName -replace '[\\/:*?"<>|]', '_'
$WorkRoot = Join-Path $env:ProgramData 'WindowsProfileRepair'
$RunFolder = Join-Path $WorkRoot ("{0}_{1}" -f $SafeUserName, $TimeStamp)
$LogFile = Join-Path $RunFolder 'Repair-TemporaryUserProfile.log'

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,

        [ValidateSet('INFO', 'SUCCESS', 'WARNING', 'ERROR')]
        [string]$Level = 'INFO'
    )

    $Line = '{0} | {1,-7} | {2}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Level, $Message
    Write-Host $Line
    Add-Content -LiteralPath $LogFile -Value $Line -Encoding UTF8
}

function Test-IsAdministrator {
    $Identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $Principal = New-Object Security.Principal.WindowsPrincipal($Identity)
    return $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Export-RegistryKey {
    param(
        [Parameter(Mandatory = $true)]
        [string]$RegistryPath,

        [Parameter(Mandatory = $true)]
        [string]$Destination
    )

    $Output = & reg.exe export $RegistryPath $Destination /y 2>&1
    if ($LASTEXITCODE -eq 0) {
        Write-Log "Registry backup created: $Destination" 'SUCCESS'
    }
    else {
        throw "Registry export failed for '$RegistryPath'. Output: $($Output -join ' ')"
    }
}

function Get-TargetSessions {
    param([string]$SamAccountName)

    $Sessions = @()
    $CmdPath = Join-Path $env:SystemRoot 'System32\cmd.exe'
    $RawOutput = @(& $CmdPath /D /C 'quser.exe 2>NUL')
    $QUserExitCode = $LASTEXITCODE

    if ($QUserExitCode -ne 0 -or $RawOutput.Count -eq 0) {
        return @()
    }

    foreach ($Line in @($RawOutput | Select-Object -Skip 1)) {
        $LineText = [string]$Line
        if ($LineText -match '^\s*>?\s*(?<User>\S+)\s+(?:(?<Session>\S+)\s+)?(?<Id>\d+)\s+(?<State>Active|Disc|Disconnected|Idle|Listen)\b') {
            if ($Matches.User -ieq $SamAccountName) {
                $Sessions += [pscustomobject]@{
                    UserName    = $Matches.User
                    SessionName = $Matches.Session
                    SessionId   = [int]$Matches.Id
                    State       = $Matches.State
                    Raw         = $LineText.Trim()
                }
            }
        }
    }

    return @($Sessions)
}

function Get-FolderOwnerSid {
    param([string]$Path)

    try {
        $Acl = Get-Acl -LiteralPath $Path
        $OwnerAccount = New-Object System.Security.Principal.NTAccount($Acl.Owner)
        return $OwnerAccount.Translate([System.Security.Principal.SecurityIdentifier]).Value
    }
    catch {
        return $null
    }
}

function Rename-PreservedFolder {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path,

        [Parameter(Mandatory = $true)]
        [string]$Suffix
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return $null
    }

    $Parent = Split-Path -Path $Path -Parent
    $Leaf = Split-Path -Path $Path -Leaf
    $Destination = Join-Path $Parent ("{0}.old_{1}" -f $Leaf, $Suffix)
    $Counter = 1

    while (Test-Path -LiteralPath $Destination) {
        $Destination = Join-Path $Parent ("{0}.old_{1}_{2}" -f $Leaf, $Suffix, $Counter)
        $Counter++
    }

    Rename-Item -LiteralPath $Path -NewName (Split-Path -Path $Destination -Leaf) -Force
    Write-Log "Preserved existing folder by renaming '$Path' to '$Destination'." 'SUCCESS'
    return $Destination
}

function Clear-ReadOnlyAttribute {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    $Item = Get-Item -LiteralPath $Path -Force
    if (($Item.Attributes -band [IO.FileAttributes]::ReadOnly) -ne 0) {
        $NewAttributes = $Item.Attributes -band (-bnot [IO.FileAttributes]::ReadOnly)
        Set-ItemProperty -LiteralPath $Path -Name Attributes -Value $NewAttributes
        Write-Log "Cleared the read-only attribute from '$Path'." 'SUCCESS'
    }
}

function Test-RegistryHiveFile {
    param(
        [Parameter(Mandatory = $true)]
        [string]$HiveFile,

        [Parameter(Mandatory = $true)]
        [string]$Label
    )

    $TemporaryHiveName = 'ProfileRepairTest_{0}_{1}' -f $PID, ([guid]::NewGuid().ToString('N'))
    $TemporaryHivePath = "HKU\$TemporaryHiveName"
    $Loaded = $false

    try {
        $LoadOutput = & reg.exe load $TemporaryHivePath $HiveFile 2>&1
        if ($LASTEXITCODE -ne 0) {
            throw "$Label registry hive could not be loaded. Output: $($LoadOutput -join ' ')"
        }

        $Loaded = $true
        Write-Log "Successfully validated $Label registry hive '$HiveFile'." 'SUCCESS'
    }
    finally {
        if ($Loaded) {
            & reg.exe unload $TemporaryHivePath *> $null
        }
    }
}

function Write-RecentProfileEvents {
    param([datetime]$Since)

    $EventFile = Join-Path $RunFolder 'Recent-UserProfileService-Events.txt'
    $Collected = $false

    foreach ($LogName in @(
        'Application',
        'Microsoft-Windows-User Profile Service/Operational'
    )) {
        try {
            if ($LogName -eq 'Application') {
                $Events = Get-WinEvent -FilterHashtable @{
                    LogName      = $LogName
                    ProviderName = 'Microsoft-Windows-User Profiles Service'
                    StartTime    = $Since
                } -ErrorAction SilentlyContinue
            }
            else {
                $Events = Get-WinEvent -FilterHashtable @{
                    LogName   = $LogName
                    StartTime = $Since
                } -ErrorAction SilentlyContinue
            }

            $Events = @($Events | Select-Object -First 100 TimeCreated, Id, LevelDisplayName, Message)
            if ($Events.Count -gt 0) {
                Add-Content -LiteralPath $EventFile -Value "`r`n===== $LogName =====" -Encoding UTF8
                foreach ($Event in $Events) {
                    Add-Content -LiteralPath $EventFile -Value ("[{0}] Event {1} {2}`r`n{3}`r`n" -f $Event.TimeCreated, $Event.Id, $Event.LevelDisplayName, $Event.Message) -Encoding UTF8
                }
                $Collected = $true
            }
        }
        catch {
            Add-Content -LiteralPath $EventFile -Value "Could not read '$LogName': $($_.Exception.Message)" -Encoding UTF8
        }
    }

    if ($Collected) {
        Write-Log "Recent User Profile Service events saved to: $EventFile" 'INFO'
    }
}

function Get-DomainProfilePath {
    param(
        [string]$ResolvedAccount,
        [string]$SamAccountName
    )

    if ($ResolvedAccount -notmatch '\\') {
        return $null
    }

    try {
        $Searcher = New-Object System.DirectoryServices.DirectorySearcher
        $EscapedSam = $SamAccountName.Replace('\\', '\5c').Replace('*', '\2a').Replace('(', '\28').Replace(')', '\29').Replace([char]0, '\00')
        $Searcher.Filter = "(&(objectCategory=person)(objectClass=user)(sAMAccountName=$EscapedSam))"
        [void]$Searcher.PropertiesToLoad.Add('profilePath')
        $Result = $Searcher.FindOne()

        if ($null -ne $Result -and $Result.Properties['profilepath'].Count -gt 0) {
            return [string]$Result.Properties['profilepath'][0]
        }
    }
    catch {
        Write-Log "Could not query the account's AD profilePath attribute: $($_.Exception.Message)" 'WARNING'
    }

    return $null
}

try {
    New-Item -Path $RunFolder -ItemType Directory -Force | Out-Null
    New-Item -Path $LogFile -ItemType File -Force | Out-Null

    Write-Log '============================================================'
    Write-Log 'Windows temporary profile rebuild starting.'
    Write-Log "Requested account : $UserName"
    Write-Log "Log folder        : $RunFolder"

    if (-not (Test-IsAdministrator)) {
        throw 'Run this script from 64-bit Windows PowerShell 5.1 using Run as administrator.'
    }

    if ([Environment]::Is64BitOperatingSystem -and -not [Environment]::Is64BitProcess) {
        throw 'Run the 64-bit version of Windows PowerShell, not Windows PowerShell (x86).'
    }

    $RequestedAccount = New-Object System.Security.Principal.NTAccount($UserName)
    $SidObject = $RequestedAccount.Translate([System.Security.Principal.SecurityIdentifier])
    $Sid = $SidObject.Value
    $ResolvedAccount = $SidObject.Translate([System.Security.Principal.NTAccount]).Value
    $SamAccountName = ($ResolvedAccount -split '\\')[-1]

    Write-Log "Resolved account   : $ResolvedAccount" 'SUCCESS'
    Write-Log "Resolved SID       : $Sid" 'SUCCESS'

    $CurrentSid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    if ($CurrentSid -eq $Sid) {
        throw 'The script is running as the affected user. Sign that user out and run the script using a different administrator account.'
    }

    $FsLogixPath = 'HKLM:\SOFTWARE\FSLogix\Profiles'
    if (Test-Path -LiteralPath $FsLogixPath) {
        $FsLogix = Get-ItemProperty -LiteralPath $FsLogixPath -ErrorAction SilentlyContinue
        if ($null -ne $FsLogix -and $FsLogix.PSObject.Properties.Name -contains 'Enabled' -and [int]$FsLogix.Enabled -eq 1) {
            throw 'FSLogix Profiles is enabled. Repair or unlock the profile container instead of creating a local profile.'
        }
    }

    $SystemDrive = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='$($env:SystemDrive)'"
    if ($null -eq $SystemDrive) {
        throw "Could not determine free space for $($env:SystemDrive)."
    }

    $FreeGB = [math]::Round(($SystemDrive.FreeSpace / 1GB), 2)
    Write-Log "System drive free : $FreeGB GB"
    if ($FreeGB -lt 2) {
        throw "Only $FreeGB GB is free on $($env:SystemDrive). Free at least 2 GB and rerun the script."
    }

    $TargetSessions = @(Get-TargetSessions -SamAccountName $SamAccountName)
    if ($TargetSessions.Count -eq 0) {
        Write-Log "No active or disconnected Windows session was found for '$ResolvedAccount'."
    }

    foreach ($Session in $TargetSessions) {
        Write-Log "Logging off session $($Session.SessionId): $($Session.Raw)" 'WARNING'
        $LogoffOutput = & logoff.exe $Session.SessionId 2>&1
        if ($LASTEXITCODE -ne 0) {
            throw "Failed to log off session ID $($Session.SessionId). Output: $($LogoffOutput -join ' ')"
        }
    }

    if ($TargetSessions.Count -gt 0) {
        Start-Sleep -Seconds 5
    }

    $LoadedProfile = Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue |
        Where-Object { $_.SID -eq $Sid -and $_.Loaded } |
        Select-Object -First 1
    if ($null -ne $LoadedProfile) {
        throw "The affected profile is still loaded at '$($LoadedProfile.LocalPath)'. Restart the server or fully log off the session, then rerun the script."
    }

    $ProfileListPath = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
    $ProfileListNative = 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'
    $ProfileGuidPath = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileGUID'
    $ProfileGuidNative = 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileGUID'

    Export-RegistryKey -RegistryPath $ProfileListNative -Destination (Join-Path $RunFolder 'ProfileList-Before.reg')
    if (Test-Path -LiteralPath $ProfileGuidPath) {
        Export-RegistryKey -RegistryPath $ProfileGuidNative -Destination (Join-Path $RunFolder 'ProfileGUID-Before.reg')
    }

    $ProfileListProperties = Get-ItemProperty -LiteralPath $ProfileListPath
    $ProfilesDirectory = [Environment]::ExpandEnvironmentVariables([string]$ProfileListProperties.ProfilesDirectory)
    $DefaultProfile = if ($ProfileListProperties.PSObject.Properties.Name -contains 'Default') {
        [Environment]::ExpandEnvironmentVariables([string]$ProfileListProperties.Default)
    }
    else {
        Join-Path $ProfilesDirectory 'Default'
    }

    $DefaultNtUser = Join-Path $DefaultProfile 'NTUSER.DAT'
    $DefaultUsrClass = Join-Path $DefaultProfile 'AppData\Local\Microsoft\Windows\UsrClass.dat'
    $TargetProfilePath = Join-Path $ProfilesDirectory $SamAccountName

    Write-Log "Profiles directory : $ProfilesDirectory"
    Write-Log "Default profile    : $DefaultProfile"
    Write-Log "New profile path   : $TargetProfilePath"

    foreach ($RequiredPath in @($ProfilesDirectory, $DefaultProfile, $DefaultNtUser, $DefaultUsrClass)) {
        if (-not (Test-Path -LiteralPath $RequiredPath)) {
            throw "Required profile component is missing: $RequiredPath"
        }
    }

    Clear-ReadOnlyAttribute -Path $DefaultNtUser
    Clear-ReadOnlyAttribute -Path $DefaultUsrClass
    Test-RegistryHiveFile -HiveFile $DefaultNtUser -Label 'Default profile'

    $RoamingProfilePath = Get-DomainProfilePath -ResolvedAccount $ResolvedAccount -SamAccountName $SamAccountName
    if (-not [string]::IsNullOrWhiteSpace($RoamingProfilePath)) {
        Write-Log "AD roaming profile path is configured: $RoamingProfilePath" 'WARNING'
        if (-not (Test-Path -LiteralPath $RoamingProfilePath -ErrorAction SilentlyContinue)) {
            Write-Log 'The configured roaming profile path is not currently reachable from this server. The new local cached profile may still be removed or overridden by domain policy.' 'WARNING'
        }
    }

    $ExactProfileKey = Join-Path $ProfileListPath $Sid
    $BakProfileKey = Join-Path $ProfileListPath ($Sid + '.bak')

    foreach ($ProfileKey in @($ExactProfileKey, $BakProfileKey)) {
        if (Test-Path -LiteralPath $ProfileKey) {
            $OldProperties = Get-ItemProperty -LiteralPath $ProfileKey -ErrorAction SilentlyContinue
            if ($null -ne $OldProperties -and $OldProperties.PSObject.Properties.Name -contains 'ProfileImagePath') {
                $OldPath = [Environment]::ExpandEnvironmentVariables([string]$OldProperties.ProfileImagePath)
                Write-Log "Removing stale profile registration '$ProfileKey' pointing to '$OldPath'." 'WARNING'
            }
            else {
                Write-Log "Removing stale profile registration '$ProfileKey'." 'WARNING'
            }
            Remove-Item -LiteralPath $ProfileKey -Recurse -Force
        }
    }

    if (Test-Path -LiteralPath $ProfileGuidPath) {
        foreach ($GuidKey in Get-ChildItem -LiteralPath $ProfileGuidPath -ErrorAction SilentlyContinue) {
            $GuidProperties = Get-ItemProperty -LiteralPath $GuidKey.PSPath -ErrorAction SilentlyContinue
            if ($null -ne $GuidProperties -and
                $GuidProperties.PSObject.Properties.Name -contains 'SidString' -and
                [string]$GuidProperties.SidString -eq $Sid) {
                Remove-Item -LiteralPath $GuidKey.PSPath -Recurse -Force
                Write-Log "Removed stale ProfileGUID entry '$($GuidKey.PSChildName)'." 'SUCCESS'
            }
        }
    }

    $CandidateFolders = @(Get-ChildItem -LiteralPath $ProfilesDirectory -Directory -Force -ErrorAction SilentlyContinue |
        Where-Object {
            $_.Name -ieq $SamAccountName -or
            $_.Name -ilike ($SamAccountName + '.*')
        })

    foreach ($Folder in $CandidateFolders) {
        Rename-PreservedFolder -Path $Folder.FullName -Suffix $TimeStamp | Out-Null
    }

    $OwnedTempFolders = @(Get-ChildItem -LiteralPath $ProfilesDirectory -Directory -Force -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -ilike 'TEMP*' } |
        Where-Object { (Get-FolderOwnerSid -Path $_.FullName) -eq $Sid })

    foreach ($Folder in $OwnedTempFolders) {
        Rename-PreservedFolder -Path $Folder.FullName -Suffix $TimeStamp | Out-Null
    }

    Write-Log "Copying the Default profile to '$TargetProfilePath'."
    New-Item -Path $TargetProfilePath -ItemType Directory -Force | Out-Null

    $RobocopyLog = Join-Path $RunFolder 'Robocopy-DefaultProfile.log'
    $RobocopyArguments = @(
        $DefaultProfile,
        $TargetProfilePath,
        '/E',
        '/COPY:DAT',
        '/DCOPY:DAT',
        '/XJ',
        '/R:2',
        '/W:1',
        '/NP',
        '/TEE',
        "/LOG:$RobocopyLog"
    )

    & robocopy.exe @RobocopyArguments | Out-Null
    $RobocopyExitCode = $LASTEXITCODE
    if ($RobocopyExitCode -ge 8) {
        throw "Robocopy failed with exit code $RobocopyExitCode. Review '$RobocopyLog'."
    }
    Write-Log "Default profile copied successfully. Robocopy exit code: $RobocopyExitCode" 'SUCCESS'

    $TargetNtUser = Join-Path $TargetProfilePath 'NTUSER.DAT'
    $TargetUsrClass = Join-Path $TargetProfilePath 'AppData\Local\Microsoft\Windows\UsrClass.dat'
    foreach ($RequiredTargetPath in @($TargetNtUser, $TargetUsrClass)) {
        if (-not (Test-Path -LiteralPath $RequiredTargetPath)) {
            throw "The profile copy is incomplete. Missing: $RequiredTargetPath"
        }
        Clear-ReadOnlyAttribute -Path $RequiredTargetPath
    }

    Write-Log 'Applying profile folder permissions.'

    $InheritanceArguments = @('/inheritance:e', '/T', '/C', '/Q')
    $AclOutput = & icacls.exe $TargetProfilePath @InheritanceArguments 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "icacls failed while enabling inheritance on '$TargetProfilePath'. Output: $($AclOutput -join ' ')"
    }

    $GrantArguments = @(
        '/grant:r',
        "*$Sid`:(OI)(CI)(F)",
        '*S-1-5-18:(OI)(CI)(F)',
        '*S-1-5-32-544:(OI)(CI)(F)',
        '/T',
        '/C',
        '/Q'
    )
    $AclOutput = & icacls.exe $TargetProfilePath @GrantArguments 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "icacls failed while granting permissions on '$TargetProfilePath'. Output: $($AclOutput -join ' ')"
    }

    $OwnerArguments = @('/setowner', "*$Sid", '/T', '/C', '/Q')
    $AclOutput = & icacls.exe $TargetProfilePath @OwnerArguments 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "icacls failed while setting ownership on '$TargetProfilePath'. Output: $($AclOutput -join ' ')"
    }

    Write-Log "Applied Full Control for '$ResolvedAccount', SYSTEM, and local Administrators on the new profile." 'SUCCESS'

    Test-RegistryHiveFile -HiveFile $TargetNtUser -Label 'new user profile'

    Write-Log 'Creating the ProfileList registration.'
    New-Item -Path $ExactProfileKey -Force | Out-Null

    $SidBytes = New-Object byte[] $SidObject.BinaryLength
    $SidObject.GetBinaryForm($SidBytes, 0)
    $ProfileGuid = [guid]::NewGuid().ToString('B')

    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'ProfileImagePath' -PropertyType ExpandString -Value $TargetProfilePath -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'Flags' -PropertyType DWord -Value 0 -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'State' -PropertyType DWord -Value 0 -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'RefCount' -PropertyType DWord -Value 0 -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'FullProfile' -PropertyType DWord -Value 1 -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'Sid' -PropertyType Binary -Value $SidBytes -Force | Out-Null
    New-ItemProperty -LiteralPath $ExactProfileKey -Name 'Guid' -PropertyType String -Value $ProfileGuid -Force | Out-Null

    New-Item -Path $ProfileGuidPath -Force | Out-Null
    $NewProfileGuidKey = Join-Path $ProfileGuidPath $ProfileGuid
    New-Item -Path $NewProfileGuidKey -Force | Out-Null
    New-ItemProperty -LiteralPath $NewProfileGuidKey -Name 'SidString' -PropertyType String -Value $Sid -Force | Out-Null

    Write-Log "Registered SID '$Sid' to '$TargetProfilePath'." 'SUCCESS'

    $FinalRegistry = Get-ItemProperty -LiteralPath $ExactProfileKey
    $FinalPath = [Environment]::ExpandEnvironmentVariables([string]$FinalRegistry.ProfileImagePath)
    if ($FinalPath -ne $TargetProfilePath -or -not (Test-Path -LiteralPath $FinalPath)) {
        throw 'Final profile registration validation failed.'
    }

    $FinalCimProfile = Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue |
        Where-Object { $_.SID -eq $Sid } |
        Select-Object -First 1

    if ($null -ne $FinalCimProfile) {
        Write-Log "Win32_UserProfile now reports: LocalPath='$($FinalCimProfile.LocalPath)', Loaded='$($FinalCimProfile.Loaded)', Status='$($FinalCimProfile.Status)'." 'SUCCESS'
    }
    else {
        Write-Log 'Win32_UserProfile has not refreshed yet; the registry and profile folder are valid. A server restart will refresh the User Profile Service state.' 'WARNING'
    }

    Export-RegistryKey -RegistryPath $ProfileListNative -Destination (Join-Path $RunFolder 'ProfileList-After.reg')
    if (Test-Path -LiteralPath $ProfileGuidPath) {
        Export-RegistryKey -RegistryPath $ProfileGuidNative -Destination (Join-Path $RunFolder 'ProfileGUID-After.reg')
    }

    Write-Log '============================================================'
    Write-Log 'PROFILE REBUILD COMPLETED SUCCESSFULLY.' 'SUCCESS'
    Write-Log "Profile path: $TargetProfilePath" 'SUCCESS'

    if ($RestartServer) {
        Write-Log 'Restarting the server in 15 seconds. The affected user must wait until the restart completes.' 'WARNING'
        shutdown.exe /r /t 15 /c "Restart after repairing the Windows profile for $ResolvedAccount" | Out-Null
    }
    else {
        Write-Log 'Restart the server before the affected user signs in again. This is strongly recommended after the RPC 0x800706F7 failure.' 'WARNING'
    }
}
catch {
    try {
        Write-Log "FATAL: $($_.Exception.Message)" 'ERROR'
        Write-RecentProfileEvents -Since (Get-Date).AddHours(-2)
        Write-Log "Review the log: $LogFile" 'ERROR'
    }
    catch {
        Write-Error $_.Exception.Message
    }
    throw
}
