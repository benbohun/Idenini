        foreach ($name in $Names) {
            if ($property.Name -ieq $name) {
                return $property.Name
            }
        }
    }

    return $null
}

function Test-IsComplexObject {
    param([Parameter()][object]$Object)

    if ($null -eq $Object) { return $false }
    if ($Object -is [string]) { return $false }
    if ($Object.GetType().IsValueType) { return $false }
    return $true
}

function Get-ObjectNodes {
    param(
        [Parameter()][object]$Object,
        [string]$Path = '$'
    )

    $results = New-Object System.Collections.ArrayList

    function Visit-Node {
        param([object]$Node, [string]$CurrentPath)

        if ($null -eq $Node) { return }
        if ($Node -is [string] -or $Node.GetType().IsValueType) { return }

        [void]$results.Add([pscustomobject]@{
            Path   = $CurrentPath
            Object = $Node
        })

        if ($Node -is [System.Collections.IEnumerable] -and -not ($Node -is [System.Collections.IDictionary]) -and -not ($Node -is [pscustomobject])) {
            $index = 0
            foreach ($item in $Node) {
                Visit-Node -Node $item -CurrentPath ("{0}[{1}]" -f $CurrentPath, $index)
                $index++
            }
            return
        }

        foreach ($property in @($Node.PSObject.Properties)) {
            $value = $property.Value
            if (Test-IsComplexObject -Object $value) {
                Visit-Node -Node $value -CurrentPath ("{0}.{1}" -f $CurrentPath, $property.Name)
            }
        }
    }

    Visit-Node -Node $Object -CurrentPath $Path
    return @($results)
}

function Get-FirstRecursivePropertyValue {
    param(
        [Parameter()][object]$Object,
        [Parameter(Mandatory)][string]$PropertyName
    )

    foreach ($node in @(Get-ObjectNodes -Object $Object)) {
        foreach ($property in @($node.Object.PSObject.Properties)) {
            if ($property.Name -ieq $PropertyName) {
                return $property.Value
            }
        }
    }

    return $null
}

function Set-DirectPropertyValue {
    param(
        [Parameter(Mandatory)][object]$Object,
        [Parameter(Mandatory)][string]$PropertyName,
        [Parameter()][object]$Value
    )

    $actualName = Get-DirectPropertyName -Object $Object -Names @($PropertyName)
    if (-not [string]::IsNullOrWhiteSpace($actualName)) {
        $Object.$actualName = $Value
        return
    }

    $Object | Add-Member -MemberType NoteProperty -Name $PropertyName -Value $Value -Force
}

function Get-SwsTokenValue {
    if (-not [string]::IsNullOrWhiteSpace($SwsAccessToken)) {
        Write-Log 'Using SWS access token supplied through -SwsAccessToken.' 'INFO'
        return $SwsAccessToken.Trim()
    }

    $canUseHelper = -not [string]::IsNullOrWhiteSpace($SwsTenantId) -and
                    -not [string]::IsNullOrWhiteSpace($TokenHelperJarPath) -and
                    -not [string]::IsNullOrWhiteSpace($SwsServiceAccountSecretPath)

    if ($canUseHelper) {
        if (-not (Test-Path -LiteralPath $TokenHelperJarPath)) {
            throw "Token helper JAR was not found: $TokenHelperJarPath"
        }
        if (-not (Test-Path -LiteralPath $SwsServiceAccountSecretPath)) {
            throw "SWS service-account secret file was not found: $SwsServiceAccountSecretPath"
        }

        $javaCommand = Get-Command $JavaPath -ErrorAction Stop
        Write-Log 'Generating SWS API access token with CyberArk public API token helper.' 'INFO'

        $helperOutput = & $javaCommand.Source -jar $TokenHelperJarPath -t $SwsTenantId -p $SwsServiceAccountSecretPath 2>&1 | Out-String
        if ($LASTEXITCODE -ne 0) {
            throw ("CyberArk token helper failed. Output: {0}" -f $helperOutput.Trim())
        }

        $tokenMatches = [regex]::Matches($helperOutput, 'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+')
        if ($tokenMatches.Count -lt 1) {
            throw 'The token helper completed, but a JWT access token could not be parsed from its output.'
        }

        $token = @($tokenMatches | ForEach-Object { $_.Value } | Sort-Object Length -Descending)[0]
        Write-Log 'SWS access token generated successfully.' 'SUCCESS'
        return $token
    }

    Write-Host ''
    Write-Host 'Paste a current SWS service-account access token.' -ForegroundColor Yellow
    Write-Host 'The token is read securely and is never written to the log or report.' -ForegroundColor Gray
    $secureToken = Read-Host 'SWS access token' -AsSecureString
    $plainToken = Convert-SecureStringToPlainText -SecureString $secureToken

    if ([string]::IsNullOrWhiteSpace($plainToken)) {
        throw 'An SWS access token is required.'
    }

    return $plainToken.Trim()
}

