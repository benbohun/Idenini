Prompt

##########################################################################
###				CiscoUCSlocaladmin PROMPTS FILE
###				Hardened for mixed NX-OS/UCS variants
##########################################################################

# Conditions names can contain only alphabet and numeric characters
# Values are case-insensitive, regular expressions
[conditions]

##################
# Standard Prompts
##################
# Accept start-of-line OR newline, variable spaces, and # or > etc.
StandardPrompt=(?:^|\r?\n).*(?:\$|#|>|%|\])\s*$

# In local-user context; allow optional '*' (pending changes) and # or >
UserPrompt=(?:^|\r?\n).*/local-user\s*\*?\s*(?:#|>)\s*$

# Commit-needed indicator often shows '*' in local-user scope
CommitChangesPrompt=(?:^|\r?\n).*/local-user\s*\*\s*(?:#|>)\s*$

###############
# Logon Prompts
###############
Login=login as:|login:
Password=Password:|Enter the password for .*
PasswordExpired=Password expired\.|Choose a new password|Your password has expired
InvalidLogin=Access Denied|Access denied|You entered an invalid login name or password|password:
PlinkStoreKey=Store key in cache
ConnectionFailed=Connect failed|FATAL ERROR:|Unable to open connection:|Could not open connection to the host
KeyChanged=Update cached key\?

################################
# Change/Reset Password Prompts
################################
# Entering the /security scope; allow variable spacing and # or >
LineMatchId=(?:^|\r?\n).*/security\s*(?:#|>)\s*$

# Old/current password variants
OldPassword=Enter current password:|Current password:|Old [Pp]assword:|Enter old password:

# A few platforms return these on bad current password
BadCurrentPassword=Sorry, wrong passwd|Authentication failed|Incorrect password

# New password prompts across platforms
NewPassword=Please enter password:|Enter a password:|Enter new password:|New [Pp]assword:

# Confirm/verify prompts across platforms
VerifyNewPassword=Please confirm password:|Confirm the password:|Re-?enter new password:|Re-?type new password:|Verify [Pp]assword:

# Weak or invalid new password variants
BadNewPassword=New passwords do not match\.|Password is invalid\.|Invalid value|Password must be at least.*|Password complexity.*failed|The password you entered is not valid

# Generic commit errors
CommitError=Error:.*\n|Commit failed|Aborted

########################
# Logic/Condition Checks
########################
#UserNotLocaladmin=(expression)![string equal -nocase "<username>" "localadmin"]

# Protocol
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]

# Operation
ActionIsLogon=(expression)[string equal -nocase <action> logon]
ActionIsVerify=(expression)[string equal -nocase <action> verifypass]
ActionIsChange=(expression)[string equal -nocase <action> changepass]

IsVerifyLogon=(expression)$VerifyLogon == 1

# Always true
TRUE=(expression)true

