function Get-OfficialPostmanCollectionJsonPath {
    param([string]$RequestedPath)

    $workingPath = $RequestedPath

    if ([string]::IsNullOrWhiteSpace($workingPath)) {
        $zipPath = Join-Path $OutputFolder 'secure_web_session.postman_collection.zip'
        Write-Log 'Downloading CyberArk official SWS Postman collection.' 'INFO'

        $downloadParameters = Get-WebRequestCommonParameters
        $downloadParameters['Uri'] = $PostmanCollectionDownloadUrl
        $downloadParameters['OutFile'] = $zipPath
        Invoke-WebRequest @downloadParameters | Out-Null

        $workingPath = $zipPath
        Write-Log ("Downloaded Postman collection: {0}" -f $zipPath) 'SUCCESS'
    }

    if (-not (Test-Path -LiteralPath $workingPath)) {
        throw "Postman collection file was not found: $workingPath"
    }

    $extension = [IO.Path]::GetExtension($workingPath)
    if ($extension -ieq '.json') {
        return (Resolve-Path -LiteralPath $workingPath).Path
    }

    if ($extension -notin @('.zip','.ZIP')) {
        throw 'PostmanCollectionPath must reference a .json or .zip file.'
    }

    $extractFolder = Join-Path $OutputFolder 'PostmanCollection'
    if (Test-Path -LiteralPath $extractFolder) {
        Remove-Item -LiteralPath $extractFolder -Recurse -Force
    }
    New-Item -Path $extractFolder -ItemType Directory -Force | Out-Null

    try {
        Expand-Archive -LiteralPath $workingPath -DestinationPath $extractFolder -Force
    }
    catch {
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [System.IO.Compression.ZipFile]::ExtractToDirectory($workingPath, $extractFolder)
    }

    $jsonFiles = @(Get-ChildItem -LiteralPath $extractFolder -Filter '*.json' -File -Recurse)
    if ($jsonFiles.Count -lt 1) {
        throw 'No JSON file was found inside the SWS Postman collection archive.'
    }

    foreach ($file in $jsonFiles) {
        $text = Get-Content -LiteralPath $file.FullName -Raw
        if ($text -match '(?i)SWS policies' -and $text -match '(?i)application configuration') {
            return $file.FullName
        }
    }

    return ($jsonFiles | Sort-Object Length -Descending | Select-Object -First 1).FullName
}

function Get-PostmanRequestRows {
    param([Parameter()][object[]]$Items)

    $results = New-Object System.Collections.ArrayList

    function Visit-PostmanItems {
        param([object[]]$CurrentItems, [string]$FolderPath)

        foreach ($item in @($CurrentItems)) {
            $itemName = [string](Get-DirectProperty -Object $item -Names @('name'))
            $currentName = if ([string]::IsNullOrWhiteSpace($FolderPath)) { $itemName } else { "$FolderPath / $itemName" }
            $request = Get-DirectProperty -Object $item -Names @('request')

            if ($null -ne $request) {
                $method = [string](Get-DirectProperty -Object $request -Names @('method'))
                $urlObject = Get-DirectProperty -Object $request -Names @('url')
                $rawUrl = ''

                if ($urlObject -is [string]) {
                    $rawUrl = [string]$urlObject
                }
                elseif ($null -ne $urlObject) {
                    $rawUrl = [string](Get-DirectProperty -Object $urlObject -Names @('raw'))
                    if ([string]::IsNullOrWhiteSpace($rawUrl)) {
                        $host = @((Get-DirectProperty -Object $urlObject -Names @('host'))) -join '.'
                        $path = @((Get-DirectProperty -Object $urlObject -Names @('path'))) -join '/'
                        $rawUrl = ('https://{0}/{1}' -f $host, $path)
                    }
                }

                $body = Get-DirectProperty -Object $request -Names @('body')
                $bodyRaw = if ($null -ne $body) { [string](Get-DirectProperty -Object $body -Names @('raw')) } else { '' }

                [void]$results.Add([pscustomobject]@{
                    Name    = $currentName
                    Method  = $method.ToUpperInvariant()
                    RawUrl  = $rawUrl
                    BodyRaw = $bodyRaw
                    Request = $request
                })
            }

            $children = Get-DirectProperty -Object $item -Names @('item')
            if ($null -ne $children) {
                Visit-PostmanItems -CurrentItems @($children) -FolderPath $currentName
            }
        }
    }

    Visit-PostmanItems -CurrentItems @($Items) -FolderPath ''
    return @($results)
}

function Expand-CollectionVariables {
    param([Parameter(Mandatory)][string]$Text)

    $expanded = $Text
    for ($round = 0; $round -lt 10; $round++) {
        $changed = $false
        foreach ($key in @($script:CollectionVariables.Keys)) {
            $token = '{{' + $key + '}}'
            if ($expanded.IndexOf($token, [StringComparison]::OrdinalIgnoreCase) -ge 0) {
                $expanded = [regex]::Replace(
                    $expanded,
                    [regex]::Escape($token),
                    [System.Text.RegularExpressions.MatchEvaluator]{ param($m) [string]$script:CollectionVariables[$key] },
                    [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
                )
                $changed = $true
            }
        }
        if (-not $changed) { break }
    }
    return $expanded
}

function Select-SwsPostmanRequests {
    param([Parameter(Mandatory)][object[]]$Requests)

    $listScored = foreach ($request in $Requests) {
        if ($request.Method -ne 'GET') { continue }
        $text = "{0} {1}" -f $request.Name, $request.RawUrl
        if ($text -notmatch '(?i)polic') { continue }
        if ($text -match '(?i)member|user|recording|session|activit|security.layer|default') { continue }

        $score = 0
        if ($request.Name -match '(?i)GET SWS policies') { $score += 30 }
        if ($request.Name -match '(?i)policies') { $score += 10 }
        if ($request.RawUrl -match '(?i)/policies') { $score += 10 }
        if ($request.RawUrl -notmatch '(?i)(policy.?id|\{.*id.*\}|\{\{.*id.*\}\}|:.*id)') { $score += 15 }
        [pscustomobject]@{ Request = $request; Score = $score }
    }

    $detailScored = foreach ($request in $Requests) {
        if ($request.Method -ne 'GET') { continue }
        $text = "{0} {1}" -f $request.Name, $request.RawUrl
        if ($text -notmatch '(?i)polic') { continue }
        if ($text -match '(?i)member|user|recording|session|activit|security.layer|default') { continue }

        $score = 0
        if ($request.Name -match '(?i)policy ID|policy by ID|policies \(policy ID\)') { $score += 30 }
        if ($request.RawUrl -match '(?i)(policy.?id|\{.*id.*\}|\{\{.*id.*\}\}|:.*id)') { $score += 25 }
        if ($request.RawUrl -match '(?i)/policies') { $score += 10 }
        [pscustomobject]@{ Request = $request; Score = $score }
    }

    $putScored = foreach ($request in $Requests) {
        if ($request.Method -ne 'PUT') { continue }
        $text = "{0} {1}" -f $request.Name, $request.RawUrl
        if ($text -notmatch '(?i)polic') { continue }

        $score = 0
        if ($request.Name -match '(?i)Policy application configuration') { $score += 50 }
        if ($text -match '(?i)application.*config|config.*application') { $score += 30 }
        if ($request.RawUrl -match '(?i)/policies') { $score += 10 }
        if ($text -match '(?i)member|security.layer|default|status') { $score -= 30 }
        [pscustomobject]@{ Request = $request; Score = $score }
    }

    $script:ListPoliciesRequest = ($listScored | Sort-Object Score -Descending | Select-Object -First 1).Request
    $script:GetPolicyRequest = ($detailScored | Sort-Object Score -Descending | Select-Object -First 1).Request
    $script:PutApplicationConfigurationRequest = ($putScored | Sort-Object Score -Descending | Select-Object -First 1).Request

    if ($null -eq $script:ListPoliciesRequest) {
        throw 'Could not identify the GET SWS policies request in the CyberArk Postman collection.'
    }
    if ($null -eq $script:GetPolicyRequest) {
        throw 'Could not identify the GET policy-by-ID request in the CyberArk Postman collection.'
    }
    if ($null -eq $script:PutApplicationConfigurationRequest) {
        throw 'Could not identify the PUT Policy application configuration request in the CyberArk Postman collection.'
    }

    Write-Log ("Postman GET list request : {0} -> {1}" -f $script:ListPoliciesRequest.Name, $script:ListPoliciesRequest.RawUrl) 'DEBUG'
    Write-Log ("Postman GET detail request: {0} -> {1}" -f $script:GetPolicyRequest.Name, $script:GetPolicyRequest.RawUrl) 'DEBUG'
    Write-Log ("Postman PUT config request: {0} -> {1}" -f $script:PutApplicationConfigurationRequest.Name, $script:PutApplicationConfigurationRequest.RawUrl) 'DEBUG'
}

function Remove-UnresolvedQueryParameters {
    param([Parameter(Mandatory)][string]$Url)

    $questionIndex = $Url.IndexOf('?')
    if ($questionIndex -lt 0) { return $Url }

    $base = $Url.Substring(0, $questionIndex)
    $query = $Url.Substring($questionIndex + 1)
    $kept = @()

    foreach ($part in @($query -split '&')) {
        if ($part -notmatch '\{\{' -and $part -notmatch '\{[^}]+\}' -and $part -notmatch ':[A-Za-z][A-Za-z0-9_]*') {
            $kept += $part
        }
    }

    if ($kept.Count -eq 0) { return $base }
    return $base + '?' + ($kept -join '&')
}

function Resolve-SwsRequestUrl {
    param(
        [Parameter(Mandatory)][string]$RawUrl,
        [string]$PolicyId = ''
    )

    $url = Expand-CollectionVariables -Text $RawUrl

    if (-not [string]::IsNullOrWhiteSpace($PolicyId)) {
        $escapedId = [uri]::EscapeDataString($PolicyId)
        $patterns = @(
            '\{\{policyId\}\}', '\{\{policyID\}\}', '\{\{id\}\}',
            '\{policyId\}', '\{policyID\}', '\{id\}',
            ':policyId', ':policyID', ':id'
        )
        foreach ($pattern in $patterns) {
            $url = [regex]::Replace($url, $pattern, $escapedId, [Text.RegularExpressions.RegexOptions]::IgnoreCase)
        }
    }

    $url = Remove-UnresolvedQueryParameters -Url $url

    $apiRootResolved = $SwsApiRoot.TrimEnd('/')
    if ([string]::IsNullOrWhiteSpace($apiRootResolved)) {
        $apiRootResolved = (Get-DataCenterApiRoot -Code $DataCenter).TrimEnd('/')
    }

    $versionPathMatch = [regex]::Match($url, '(?i)/(v[0-9]+(?:-edge)?)/')
    if ($versionPathMatch.Success) {
        $pathStart = $versionPathMatch.Index
        return $apiRootResolved + $url.Substring($pathStart)
    }

    if ($url -match '^https?://') {
        $uri = [uri]$url
        $pathAndQuery = $uri.PathAndQuery
        if ($pathAndQuery -notmatch '(?i)^/v[0-9]+(?:-edge)?/') {
            $normalizedPathAndQuery = if ($pathAndQuery.StartsWith('/')) { $pathAndQuery } else { '/' + $pathAndQuery }
            $pathAndQuery = '/v2-edge' + $normalizedPathAndQuery
        }
        return $apiRootResolved + $pathAndQuery
    }

    $relative = $url
    $relative = [regex]::Replace($relative, '^\{\{[^}]+\}\}', '')
    if (-not $relative.StartsWith('/')) { $relative = '/' + $relative }
    if ($relative -notmatch '(?i)^/v[0-9]+(?:-edge)?/') {
        $relative = '/v2-edge' + $relative
    }

    if ($relative -match '\{\{' -or $relative -match '\{[^}]+\}') {
        throw "The Postman request URL still contains an unresolved path variable: $relative"
    }

    return $apiRootResolved + $relative
}

function Get-HttpErrorDetail {
    param([Parameter(Mandatory)]$ErrorRecord)

    $status = $null
    $body = $null

    try { $status = [int]$ErrorRecord.Exception.Response.StatusCode.value__ } catch {}
    try {
        $stream = $ErrorRecord.Exception.Response.GetResponseStream()
        if ($null -ne $stream) {
            $reader = New-Object IO.StreamReader($stream)
            $body = $reader.ReadToEnd()
            $reader.Dispose()
        }
    } catch {}

    return [pscustomobject]@{
        StatusCode = $status
        Body       = $body
        Message    = $ErrorRecord.Exception.Message
    }
}

function Invoke-SwsApi {
    param(
        [Parameter(Mandatory)][ValidateSet('GET','PUT','POST','DELETE','OPTIONS')][string]$Method,
        [Parameter(Mandatory)][string]$Uri,
        [Parameter()][object]$Body
    )

    $headers = @{
        Authorization = 'Bearer ' + $script:SwsToken
        Accept        = 'application/json'
    }

    $parameters = @{
        Method      = $Method
        Uri         = $Uri
        Headers     = $headers
        ErrorAction = 'Stop'
    }

    if (-not [string]::IsNullOrWhiteSpace($Proxy)) {
        $parameters['Proxy'] = $Proxy
    }
    if ($null -ne $ProxyCredential) {
        $parameters['ProxyCredential'] = $ProxyCredential
    }

    if ($null -ne $Body) {
        $parameters['ContentType'] = 'application/json'
        $parameters['Body'] = ConvertTo-JsonDeep -InputObject $Body
    }

    Write-Log ("SWS API {0} {1}" -f $Method, $Uri) 'DEBUG'

    try {
        return Invoke-RestMethod @parameters
    }
    catch {
        $detail = Get-HttpErrorDetail -ErrorRecord $_
        throw ("SWS API call failed. Method={0}; URI={1}; Status={2}; Error={3}; Response={4}" -f $Method, $Uri, $detail.StatusCode, $detail.Message, $detail.Body)
    }
}

function Get-PolicyIdentifier {
    param([Parameter()][object]$Object)

    $value = Get-DirectProperty -Object $Object -Names @('policyId','policyID','PolicyId','id','Id','uuid','Uuid')
    if ($null -eq $value) { return $null }

    $text = [string]$value
    if ([string]::IsNullOrWhiteSpace($text)) { return $null }
    return $text.Trim()
}

function Get-PolicyDisplayValue {
    param([Parameter()][object]$Object)

    $value = Get-DirectProperty -Object $Object -Names @('policyName','applicationName','displayName','name','Name','title')
    if ($null -eq $value) { return '' }
    return [string]$value
}

function Get-PolicyCandidates {
    param([Parameter(Mandatory)][object]$ListResponse)

    $groups = @()

    foreach ($node in @(Get-ObjectNodes -Object $ListResponse)) {
        $value = $node.Object
        $isEnumerable = $value -is [System.Collections.IEnumerable] -and
                        -not ($value -is [string]) -and
                        -not ($value -is [System.Collections.IDictionary]) -and
                        -not ($value -is [pscustomobject])

        if (-not $isEnumerable) { continue }

        $items = @($value)
        if ($items.Count -eq 0) { continue }

        $recognizedItems = @()
        $groupScore = 0

        if ($node.Path -match '(?i)(^|\.)(policies|applicationPolicies|items|content|results?)$') {
            $groupScore += 30
        }

        foreach ($item in $items) {
            if (-not (Test-IsComplexObject -Object $item)) { continue }

            $id = Get-PolicyIdentifier -Object $item
            if ([string]::IsNullOrWhiteSpace($id)) { continue }

            $propertyNames = @(Get-DirectPropertyNames -Object $item)
            $itemScore = 2

            foreach ($propertyName in $propertyNames) {
                if ($propertyName -match '(?i)policy') { $itemScore += 8 }
                if ($propertyName -match '(?i)application|appKey|identityApp') { $itemScore += 7 }
                if ($propertyName -match '(?i)securityLayer|defaultLayer') { $itemScore += 4 }
                if ($propertyName -match '(?i)status|active') { $itemScore += 1 }
            }

            $display = Get-PolicyDisplayValue -Object $item
            if (-not [string]::IsNullOrWhiteSpace($display)) { $itemScore += 2 }

            $recognizedItems += [pscustomobject]@{
                PolicyId = $id
                Name     = $display
                Object   = $item
                Path     = $node.Path
                ItemScore = $itemScore
            }
            $groupScore += $itemScore
        }

        if ($recognizedItems.Count -gt 0) {
            $groups += [pscustomobject]@{
                Path       = $node.Path
                Score      = $groupScore
                Candidates = $recognizedItems
            }
        }
    }

    if ($groups.Count -eq 0) {
        # Fallback for an unusual response that contains policy objects but no array.
        $fallback = @{}
        foreach ($node in @(Get-ObjectNodes -Object $ListResponse)) {
            $id = Get-PolicyIdentifier -Object $node.Object
            if ([string]::IsNullOrWhiteSpace($id)) { continue }

            $propertyNames = @(Get-DirectPropertyNames -Object $node.Object)
            $hasPolicySignal = @($propertyNames | Where-Object { $_ -match '(?i)policy|application|appKey|identityApp' }).Count -gt 0
            if (-not $hasPolicySignal) { continue }

            if (-not $fallback.ContainsKey($id)) {
                $fallback[$id] = [pscustomobject]@{
                    PolicyId = $id
                    Name     = Get-PolicyDisplayValue -Object $node.Object
                    Object   = $node.Object
                    Path     = $node.Path
                }
            }
        }
        return @($fallback.Values)
    }

    $winningGroup = $groups | Sort-Object Score -Descending | Select-Object -First 1
    Write-Log ("Selected policy collection at path '{0}' with {1} candidate(s)." -f $winningGroup.Path, $winningGroup.Candidates.Count) 'DEBUG'

    $deduplicated = @{}
    foreach ($candidate in @($winningGroup.Candidates)) {
        if (-not $deduplicated.ContainsKey($candidate.PolicyId)) {
            $deduplicated[$candidate.PolicyId] = [pscustomobject]@{
                PolicyId = $candidate.PolicyId
                Name     = $candidate.Name
                Object   = $candidate.Object
                Path     = $candidate.Path
            }
        }
    }

    return @($deduplicated.Values)
}

function Set-PolicyListQueryForLargePage {
    param([Parameter(Mandatory)][string]$Url)

    $questionIndex = $Url.IndexOf('?')
    if ($questionIndex -lt 0) { return $Url }

    $base = $Url.Substring(0, $questionIndex)
    $query = $Url.Substring($questionIndex + 1)
    $updated = @()

    foreach ($part in @($query -split '&')) {
        if ([string]::IsNullOrWhiteSpace($part)) { continue }
        $pair = $part -split '=', 2
        $name = $pair[0]
        $value = if ($pair.Count -gt 1) { $pair[1] } else { '' }
        $decodedName = [uri]::UnescapeDataString($name)

        if ($decodedName -match '(?i)^(limit|size|pageSize|take|top|maxResults)$') {
            $value = '1000'
        }
        elseif ($decodedName -match '(?i)^(offset|skip|page|pageNumber)$') {
            $value = '0'
        }

        $updated += ($name + '=' + $value)
    }

    if ($updated.Count -eq 0) { return $base }
    return $base + '?' + ($updated -join '&')
}

function Get-PolicyListResponse {
    $url = Resolve-SwsRequestUrl -RawUrl $script:ListPoliciesRequest.RawUrl
    $url = Set-PolicyListQueryForLargePage -Url $url
    return Invoke-SwsApi -Method GET -Uri $url
}

function Get-PolicyDetailResponse {
    param([Parameter(Mandatory)][string]$PolicyId, [switch]$Refresh)

    if (-not $Refresh -and $script:PolicyDetailCache.ContainsKey($PolicyId)) {
        return $script:PolicyDetailCache[$PolicyId]
    }

    $url = Resolve-SwsRequestUrl -RawUrl $script:GetPolicyRequest.RawUrl -PolicyId $PolicyId
    $detail = Invoke-SwsApi -Method GET -Uri $url
    $script:PolicyDetailCache[$PolicyId] = $detail
    return $detail
}

function Get-PolicyMatchScore {
    param(
        [Parameter(Mandatory)][object]$CandidateObject,
        [Parameter(Mandatory)][string]$Selector
    )

    $score = 0
    $json = ConvertTo-JsonDeep -InputObject $CandidateObject
    if ($json.IndexOf($Selector, [StringComparison]::OrdinalIgnoreCase) -ge 0) { $score += 20 }

    foreach ($propertyName in @('identityAppKey','applicationKey','appKey','policyName','applicationName','displayName','name')) {
        $value = Get-DirectProperty -Object $CandidateObject -Names @($propertyName)
        if ($null -eq $value) { continue }

        if ($value -is [System.Collections.IEnumerable] -and -not ($value -is [string])) {
            foreach ($item in $value) {
                if ([string]$item -ieq $Selector) { $score += 50 }
            }
        }
        elseif ([string]$value -ieq $Selector) {
            $score += 50
        }
        elseif ([string]$value -like "*$Selector*") {
            $score += 15
        }
    }

    return $score
}

function Find-SwsPolicy {
    param(
        [Parameter(Mandatory)][string]$Selector,
        [Parameter(Mandatory)][string]$SelectorDescription,
        [Parameter(Mandatory)][object]$ListResponse
    )

    $candidates = @(Get-PolicyCandidates -ListResponse $ListResponse)
    if ($candidates.Count -eq 0) {
        throw 'The GET SWS policies response did not contain recognizable policy IDs.'
    }

    if ($candidates.Count -gt $MaximumPoliciesToInspect) {
        throw ("The policy list contained {0} candidates, exceeding MaximumPoliciesToInspect={1}. Increase the limit if appropriate." -f $candidates.Count, $MaximumPoliciesToInspect)
    }

    $matches = @()
    foreach ($candidate in $candidates) {
        $listScore = Get-PolicyMatchScore -CandidateObject $candidate.Object -Selector $Selector
        if ($listScore -gt 0) {
            $matches += [pscustomobject]@{
                Candidate = $candidate
                Score     = $listScore
                Detail    = $null
            }
        }
    }

    if ($matches.Count -eq 1 -and $matches[0].Score -ge 50) {
        $detail = Get-PolicyDetailResponse -PolicyId $matches[0].Candidate.PolicyId
        return [pscustomobject]@{
            PolicyId = $matches[0].Candidate.PolicyId
            Name     = $matches[0].Candidate.Name
            Detail   = $detail
        }
    }

    $detailMatches = @()
    foreach ($candidate in $candidates) {
        try {
            $detail = Get-PolicyDetailResponse -PolicyId $candidate.PolicyId
        }
        catch {
            Write-Log ("Skipping candidate PolicyId={0} because policy detail retrieval failed: {1}" -f $candidate.PolicyId, $_.Exception.Message) 'WARN'
            continue
        }

        $score = Get-PolicyMatchScore -CandidateObject $detail -Selector $Selector
        if ($score -gt 0) {
            $detailMatches += [pscustomobject]@{
                PolicyId = $candidate.PolicyId
                Name     = if (-not [string]::IsNullOrWhiteSpace($candidate.Name)) { $candidate.Name } else { Get-PolicyDisplayValue -Object $detail }
                Score    = $score
                Detail   = $detail
            }
        }
    }

    if ($detailMatches.Count -eq 0) {
        return $null
    }

    $ordered = @($detailMatches | Sort-Object Score -Descending)
    if ($ordered.Count -gt 1 -and $ordered[0].Score -eq $ordered[1].Score) {
        $text = ($ordered | ForEach-Object { "PolicyId=$($_.PolicyId); Name=$($_.Name); Score=$($_.Score)" }) -join ' || '
        throw ("Multiple SWS policies matched {0} '{1}'. Matches: {2}" -f $SelectorDescription, $Selector, $text)
    }

    return $ordered[0]
}

function Wait-ForTargetPolicy {
    param(
        [Parameter(Mandatory)][string]$Selector,
        [Parameter(Mandatory)][string]$SelectorDescription
    )

    $deadline = (Get-Date).AddSeconds($TargetPolicyWaitSeconds)
    $attempt = 0

    do {
        $attempt++
        $script:PolicyDetailCache = @{}
        Write-Log ("Searching for target SWS policy by {0} '{1}' (attempt {2})." -f $SelectorDescription, $Selector, $attempt) 'INFO'

        $list = Get-PolicyListResponse
        $match = Find-SwsPolicy -Selector $Selector -SelectorDescription $SelectorDescription -ListResponse $list
        if ($null -ne $match) {
            Write-Log ("Target SWS policy found. PolicyId={0}; Name='{1}'." -f $match.PolicyId, $match.Name) 'SUCCESS'
            return $match
        }

        if ((Get-Date) -ge $deadline) { break }
        Write-Log ("Target policy is not available yet. Retrying in {0} second(s)." -f $PollIntervalSeconds) 'WARN'
        Start-Sleep -Seconds $PollIntervalSeconds
    }
    while ((Get-Date) -lt $deadline)

    throw ("Target SWS policy was not found within {0} seconds using {1} '{2}'." -f $TargetPolicyWaitSeconds, $SelectorDescription, $Selector)
}

function Get-SwsConfigurationNode {
    param([Parameter(Mandatory)][object]$PolicyDetail)

    $scoredNodes = @()
    foreach ($node in @(Get-ObjectNodes -Object $PolicyDetail)) {
        $score = 0
        if ($node.Path -match '(?i)application.*config|config.*application|general.*setting|policy.*setting') { $score += 30 }

        foreach ($property in @($node.Object.PSObject.Properties)) {
            $name = $property.Name
            if ($name -match '(?i)detect') { $score += 20 }
            if ($name -match '(?i)exclud') { $score += 20 }
            if ($name -match '(?i)includ') { $score += 8 }
            if ($name -match '(?i)domain') { $score += 8 }
            if ($name -match '(?i)url') { $score += 8 }
            if ($name -match '(?i)automatic|manual') { $score += 8 }
            if ($name -match '(?i)app.*key|identity.*key') { $score += 2 }
        }

        if ($score -gt 0) {
            $jsonLength = (ConvertTo-JsonDeep -InputObject $node.Object).Length
            $scoredNodes += [pscustomobject]@{
                Node       = $node
                Score      = $score
                JsonLength = $jsonLength
            }
        }
    }

    if ($scoredNodes.Count -eq 0) {
        throw 'Could not locate an SWS application-configuration object in the policy detail response.'
    }

    $winner = $scoredNodes | Sort-Object @{Expression='Score';Descending=$true}, @{Expression='JsonLength';Descending=$false} | Select-Object -First 1
    Write-Log ("Selected SWS configuration node at path '{0}' with score {1}." -f $winner.Node.Path, $winner.Score) 'DEBUG'
    return $winner.Node.Object
}

function Test-IsCopyFieldName {
    param([Parameter(Mandatory)][string]$Name)

    if ($Name -match '(?i)(^|_)(id|uuid|key|name)$|policy.?id|identity.*key|app.*key|application.*id|tenant|member|security.layer|status') {
        return $false
    }

    return ($Name -match '(?i)detect|exclud|includ|domain|url|pattern|automatic|manual|monitor|match')
}

function Merge-SwsDetectionConfiguration {
    param(
        [Parameter(Mandatory)][object]$Source,
        [Parameter(Mandatory)][object]$Target
    )

    $copiedPaths = New-Object System.Collections.ArrayList

    function Merge-Node {
        param([object]$SourceNode, [object]$TargetNode, [string]$CurrentPath)

        if ($null -eq $SourceNode -or $null -eq $TargetNode) { return }

        foreach ($sourceProperty in @($SourceNode.PSObject.Properties)) {
            $name = $sourceProperty.Name
            $sourceValue = $sourceProperty.Value
            $targetPropertyName = Get-DirectPropertyName -Object $TargetNode -Names @($name)

            if (Test-IsCopyFieldName -Name $name) {
                Set-DirectPropertyValue -Object $TargetNode -PropertyName $name -Value (Copy-DeepObject -InputObject $sourceValue)
                [void]$copiedPaths.Add(("{0}.{1}" -f $CurrentPath, $name))
                continue
            }

            if (-not [string]::IsNullOrWhiteSpace($targetPropertyName)) {
                $targetValue = $TargetNode.$targetPropertyName
                if (Test-IsComplexObject -Object $sourceValue -and Test-IsComplexObject -Object $targetValue) {
                    Merge-Node -SourceNode $sourceValue -TargetNode $targetValue -CurrentPath ("{0}.{1}" -f $CurrentPath, $name)
                }
            }
        }
    }

    $merged = Copy-DeepObject -InputObject $Target
    Merge-Node -SourceNode $Source -TargetNode $merged -CurrentPath '$'

    if ($copiedPaths.Count -eq 0) {
        throw 'No SWS detection, URL, domain, include, or exclusion fields were recognized for copying. No update was attempted.'
    }

    return [pscustomobject]@{
        Configuration = $merged
        CopiedPaths   = @($copiedPaths | Sort-Object -Unique)
    }
}

function ConvertFrom-PostmanBodyJson {
    param([string]$BodyRaw)

    if ([string]::IsNullOrWhiteSpace($BodyRaw)) { return $null }

    $expanded = Expand-CollectionVariables -Text $BodyRaw
    $expanded = [regex]::Replace($expanded, '"\{\{[^}]+\}\}"', '"POSTMAN_VARIABLE"')
    $expanded = [regex]::Replace($expanded, '\{\{[^}]+\}\}', 'null')

    try {
        return ($expanded | ConvertFrom-Json)
    }
    catch {
        Write-Log ("Could not parse the Postman PUT request body as JSON: {0}" -f $_.Exception.Message) 'WARN'
        return $null
    }
}

function Get-DirectPropertyNames {
    param([Parameter()][object]$Object)
    if ($null -eq $Object) { return @() }
    return @($Object.PSObject.Properties | ForEach-Object { $_.Name })
}

function Get-NameOverlapCount {
    param([Parameter()][object]$First, [Parameter()][object]$Second)

    $firstNames = @(Get-DirectPropertyNames -Object $First)
    $secondNames = @(Get-DirectPropertyNames -Object $Second)
    $count = 0

    foreach ($name in $firstNames) {
        if ($secondNames -icontains $name) { $count++ }
    }
    return $count
}

function Project-ConfigurationToTemplate {
    param(
        [Parameter(Mandatory)][object]$Template,
        [Parameter(Mandatory)][object]$MergedConfiguration,
        [Parameter(Mandatory)][object]$TargetPolicyDetail
    )

    function Project-Node {
        param([object]$TemplateNode, [object]$PreferredNode, [object]$FallbackRoot)

        if ($null -eq $TemplateNode) { return $null }
        if ($TemplateNode -is [string] -or $TemplateNode.GetType().IsValueType) { return $TemplateNode }

        if ($TemplateNode -is [System.Collections.IEnumerable] -and -not ($TemplateNode -is [pscustomobject])) {
            return Copy-DeepObject -InputObject $TemplateNode
        }

        $output = [ordered]@{}
        foreach ($property in @($TemplateNode.PSObject.Properties)) {
            $name = $property.Name
            $templateValue = $property.Value

            $preferredValue = Get-DirectProperty -Object $PreferredNode -Names @($name)
            if ($null -eq $preferredValue) {
                $preferredValue = Get-FirstRecursivePropertyValue -Object $FallbackRoot -PropertyName $name
            }

            if ($null -ne $preferredValue) {
                $output[$name] = Copy-DeepObject -InputObject $preferredValue
                continue
            }

            if (Test-IsComplexObject -Object $templateValue) {
                $output[$name] = Project-Node -TemplateNode $templateValue -PreferredNode $PreferredNode -FallbackRoot $FallbackRoot
            }
            else {
                $output[$name] = $templateValue
            }
        }

        return [pscustomobject]$output
    }

    $topNames = @(Get-DirectPropertyNames -Object $Template)
    if ($topNames.Count -eq 1) {
        $wrapperName = $topNames[0]
        $wrapperValue = Get-DirectProperty -Object $Template -Names @($wrapperName)
        if (Test-IsComplexObject -Object $wrapperValue) {
            $overlap = Get-NameOverlapCount -First $wrapperValue -Second $MergedConfiguration
            if ($overlap -gt 0 -or $wrapperName -match '(?i)config|policy|application') {
                $inner = Project-Node -TemplateNode $wrapperValue -PreferredNode $MergedConfiguration -FallbackRoot $TargetPolicyDetail
                $wrapped = [ordered]@{}
                $wrapped[$wrapperName] = $inner
                return [pscustomobject]$wrapped
            }
        }
    }

    return Project-Node -TemplateNode $Template -PreferredNode $MergedConfiguration -FallbackRoot $TargetPolicyDetail
}

function New-SwsPutPayload {
    param(
        [Parameter(Mandatory)][object]$MergedConfiguration,
        [Parameter(Mandatory)][object]$TargetPolicyDetail
    )

    $template = ConvertFrom-PostmanBodyJson -BodyRaw $script:PutApplicationConfigurationRequest.BodyRaw
    if ($null -eq $template) {
        Write-Log 'The Postman request did not provide a usable JSON body. Using the target configuration object as the PUT body.' 'WARN'
        return Copy-DeepObject -InputObject $MergedConfiguration
    }

    Save-JsonArtifact -FileName '00_Postman_Put_Body_Template.json' -Object $template | Out-Null
    return Project-ConfigurationToTemplate -Template $template -MergedConfiguration $MergedConfiguration -TargetPolicyDetail $TargetPolicyDetail
}

function Test-PayloadForUnresolvedValues {
    param([Parameter(Mandatory)][object]$Payload)

    $json = ConvertTo-JsonDeep -InputObject $Payload
    $issues = @()

    if ($json -match '\{\{[^}]+\}\}') { $issues += 'unresolved Postman variable' }
    if ($json -match '"POSTMAN_VARIABLE"') { $issues += 'unresolved Postman variable placeholder' }

    return @($issues | Sort-Object -Unique)
}

function Get-ValueBySimplePath {
    param([Parameter()][object]$Root, [Parameter(Mandatory)][string]$Path)

    $segments = @($Path.TrimStart('$').TrimStart('.') -split '\.')
    $current = $Root

    foreach ($segment in $segments) {
        if ([string]::IsNullOrWhiteSpace($segment)) { continue }
        if ($null -eq $current) { return $null }
        $current = Get-DirectProperty -Object $current -Names @($segment)
    }

    return $current
}

function Compare-CopiedConfiguration {
    param(
        [Parameter(Mandatory)][object]$ExpectedConfiguration,
        [Parameter(Mandatory)][object]$ActualConfiguration,
        [Parameter(Mandatory)][string[]]$CopiedPaths
    )

    $results = @()
    foreach ($path in $CopiedPaths) {
        $expected = Get-ValueBySimplePath -Root $ExpectedConfiguration -Path $path
        $actual = Get-ValueBySimplePath -Root $ActualConfiguration -Path $path
        $expectedJson = ConvertTo-JsonDeep -InputObject $expected
        $actualJson = ConvertTo-JsonDeep -InputObject $actual

        $results += [pscustomobject]@{
            Path         = $path
            Match        = ($expectedJson -ceq $actualJson)
            ExpectedJson = $expectedJson
            ActualJson   = $actualJson
        }
    }

    return $results
}


function Invoke-SwsCloneForTarget {
    param(
        [Parameter(Mandatory)][object]$TargetRow,
        [Parameter(Mandatory)][object]$SourcePolicy,
        [Parameter(Mandatory)][object]$SourceConfiguration
    )

    $script:CurrentTargetRowNumber = [int]$TargetRow.RowNumber
    $script:CurrentTargetApplicationName = [string]$TargetRow.TargetApplicationName
    $script:CurrentTargetIdentityAppKey = [string]$TargetRow.TargetIdentityAppKey

    $targetLabel = if (-not [string]::IsNullOrWhiteSpace($script:CurrentTargetApplicationName)) {
        $script:CurrentTargetApplicationName
    }
    else {
        $script:CurrentTargetIdentityAppKey
    }

    $folderName = 'Row_{0:D4}_{1}' -f $script:CurrentTargetRowNumber, (Get-SafeFolderName -Value $targetLabel)
    $targetOutputFolder = Join-Path $script:BatchRootOutputFolder $folderName
    $script:OutputFolder = $targetOutputFolder
    if (-not (Test-Path -LiteralPath $targetOutputFolder)) {
        New-Item -Path $targetOutputFolder -ItemType Directory -Force | Out-Null
    }

    Write-Log '------------------------------------------------------------' 'INFO'
    Write-Log ("Processing CSV row {0}. TargetApplicationName='{1}'; TargetIdentityAppKey='{2}'." -f $script:CurrentTargetRowNumber, $script:CurrentTargetApplicationName, $script:CurrentTargetIdentityAppKey) 'INFO'
    Write-Log ("Target artifact folder: {0}" -f $targetOutputFolder) 'INFO'
    Add-SummaryRow -Step 'Target Start' -Status 'INFO' -Detail ("ArtifactFolder={0}" -f $targetOutputFolder)

    Save-JsonArtifact -FileName '02_Source_Policy_Detail.json' -Object $SourcePolicy.Detail | Out-Null
    Save-JsonArtifact -FileName '04_Source_Application_Configuration.json' -Object $SourceConfiguration | Out-Null

    $targetSelector = if (-not [string]::IsNullOrWhiteSpace($script:CurrentTargetIdentityAppKey)) {
        $script:CurrentTargetIdentityAppKey
    }
    else {
        $script:CurrentTargetApplicationName
    }
    $targetDescription = if (-not [string]::IsNullOrWhiteSpace($script:CurrentTargetIdentityAppKey)) {
        'target Identity app key'
    }
    else {
        'target application name'
    }

    $targetPolicy = Wait-ForTargetPolicy -Selector $targetSelector -SelectorDescription $targetDescription
    Add-SummaryRow -Step 'Find Target Policy' -Status 'SUCCESS' -Detail ("PolicyId={0}; Name={1}" -f $targetPolicy.PolicyId, $targetPolicy.Name)
    Save-JsonArtifact -FileName '03_Target_Policy_Detail_Before.json' -Object $targetPolicy.Detail | Out-Null

    if ($SourcePolicy.PolicyId -ieq $targetPolicy.PolicyId) {
        Write-Log 'Source and target resolve to the same SWS policy. SWS has already consolidated the applications; no PUT is required.' 'SUCCESS'
        Add-SummaryRow -Step 'Clone Configuration' -Status 'NO_ACTION' -Detail 'Source and target are the same SWS policy.'
        return
    }

    $targetConfiguration = Get-SwsConfigurationNode -PolicyDetail $targetPolicy.Detail
    Save-JsonArtifact -FileName '05_Target_Application_Configuration_Before.json' -Object $targetConfiguration | Out-Null

    $mergeResult = Merge-SwsDetectionConfiguration -Source $SourceConfiguration -Target $targetConfiguration
    $mergedConfiguration = $mergeResult.Configuration
    $copiedPaths = @($mergeResult.CopiedPaths)

    Save-JsonArtifact -FileName '06_Target_Application_Configuration_Proposed.json' -Object $mergedConfiguration | Out-Null
    $copiedPaths | Set-Content -LiteralPath (Join-Path $targetOutputFolder '07_Copied_Configuration_Paths.txt') -Encoding UTF8

    Write-Log ("Prepared SWS detection/URL clone. Copied field paths: {0}" -f ($copiedPaths -join ', ')) 'SUCCESS'
    Add-SummaryRow -Step 'Build Configuration' -Status 'SUCCESS' -Detail ("CopiedPaths={0}" -f ($copiedPaths -join ';'))

    $putPayload = New-SwsPutPayload -MergedConfiguration $mergedConfiguration -TargetPolicyDetail $targetPolicy.Detail
    $payloadPath = Save-JsonArtifact -FileName '08_Proposed_Put_Payload.json' -Object $putPayload

    $payloadIssues = @(Test-PayloadForUnresolvedValues -Payload $putPayload)
    if ($payloadIssues.Count -gt 0) {
        throw ("The proposed PUT payload contains unsafe unresolved values: {0}. Review {1}." -f ($payloadIssues -join ', '), $payloadPath)
    }

    $putUrl = Resolve-SwsRequestUrl -RawUrl $script:PutApplicationConfigurationRequest.RawUrl -PolicyId $targetPolicy.PolicyId
    Write-Log ("Resolved PUT endpoint: {0}" -f $putUrl) 'INFO'
    Add-SummaryRow -Step 'Resolve PUT Endpoint' -Status 'SUCCESS' -Detail $putUrl

    if (-not $Execute) {
        Write-Log 'REPORT ONLY completed for this target. No SWS configuration was changed.' 'WARN'
        Write-Log ("Review the proposed payload: {0}" -f $payloadPath) 'WARN'
        Add-SummaryRow -Step 'Clone Configuration' -Status 'REPORT_ONLY' -Detail ("ProposedPayload={0}" -f $payloadPath)
        return
    }

    Write-Log 'Sending SWS application-configuration PUT request.' 'INFO'
    $putResponse = Invoke-SwsApi -Method PUT -Uri $putUrl -Body $putPayload
    Save-JsonArtifact -FileName '09_Put_Response.json' -Object $putResponse | Out-Null
    Write-Log 'SWS application-configuration PUT request completed.' 'SUCCESS'
    Add-SummaryRow -Step 'Clone Configuration' -Status 'SUCCESS' -Detail ("TargetPolicyId={0}" -f $targetPolicy.PolicyId)

    Start-Sleep -Seconds 5
    $targetAfter = Get-PolicyDetailResponse -PolicyId $targetPolicy.PolicyId -Refresh
    Save-JsonArtifact -FileName '10_Target_Policy_Detail_After.json' -Object $targetAfter | Out-Null

    $actualConfiguration = Get-SwsConfigurationNode -PolicyDetail $targetAfter
    Save-JsonArtifact -FileName '11_Target_Application_Configuration_After.json' -Object $actualConfiguration | Out-Null

    $verification = @(Compare-CopiedConfiguration -ExpectedConfiguration $mergedConfiguration -ActualConfiguration $actualConfiguration -CopiedPaths $copiedPaths)
    $verificationPath = Join-Path $targetOutputFolder '12_Verification.csv'
    $verification | Export-Csv -LiteralPath $verificationPath -NoTypeInformation -Force

    $failures = @($verification | Where-Object { -not $_.Match })
    if ($failures.Count -gt 0) {
        throw ("The PUT completed, but {0} copied configuration path(s) did not verify. Review {1}." -f $failures.Count, $verificationPath)
    }

    Write-Log ("Verification succeeded for all {0} copied configuration path(s)." -f $verification.Count) 'SUCCESS'
    Add-SummaryRow -Step 'Verification' -Status 'SUCCESS' -Detail ("VerifiedPaths={0}; Report={1}" -f $verification.Count, $verificationPath)
}


try {
    Write-Log '============================================================' 'INFO'
    Write-Log 'CyberArk SWS application-configuration clone test starting.' 'INFO'
    Write-Log ("Execution mode       : {0}" -f $(if ($Execute) { 'EXECUTE' } else { 'REPORT ONLY' })) 'INFO'
    Write-Log ("Source Identity key  : {0}" -f $SourceIdentityAppKey) 'INFO'
    Write-Log ("Identity tenant URL   : {0}" -f $IdentityApiTenantURL) 'INFO'
    Write-Log ("CSV path             : {0}" -f $(if ([string]::IsNullOrWhiteSpace($CsvPath)) { '<not supplied>' } else { $CsvPath })) 'INFO'
    Write-Log ("Single target key    : {0}" -f $(if ([string]::IsNullOrWhiteSpace($TargetIdentityAppKey)) { '<not supplied>' } else { $TargetIdentityAppKey })) 'INFO'
    Write-Log ("Single target name   : {0}" -f $(if ([string]::IsNullOrWhiteSpace($TargetApplicationName)) { '<not supplied>' } else { $TargetApplicationName })) 'INFO'
    Write-Log ("Output folder        : {0}" -f $script:BatchRootOutputFolder) 'INFO'

    if ([string]::IsNullOrWhiteSpace($SourceIdentityAppKey)) {
        throw 'SourceIdentityAppKey cannot be blank.'
    }
    if ($TargetPolicyWaitSeconds -lt 0) { throw 'TargetPolicyWaitSeconds cannot be negative.' }
    if ($PollIntervalSeconds -lt 1) { throw 'PollIntervalSeconds must be at least 1.' }

    if ($CreateSampleCsv) {
        if ([string]::IsNullOrWhiteSpace($CsvPath)) {
            $CsvPath = Join-Path $script:BatchRootOutputFolder 'SWS_Target_Applications_Sample.csv'
        }
        New-SampleTargetCsv -Path $CsvPath
        Add-SummaryRow -Step 'Create Sample CSV' -Status 'SUCCESS' -Detail ("CsvPath={0}" -f $CsvPath)
        return
    }

    Resolve-TargetCsvPath
    $targetRows = @(Get-TargetRows)
    Write-Log ("Resolved {0} target application row(s)." -f $targetRows.Count) 'SUCCESS'
    Add-SummaryRow -Step 'Resolve Targets' -Status 'SUCCESS' -Detail ("TargetCount={0}; CsvPath={1}" -f $targetRows.Count, $CsvPath)

    if ([string]::IsNullOrWhiteSpace($SwsApiRoot)) {
        $SwsApiRoot = Get-DataCenterApiRoot -Code $DataCenter
    }
    Write-Log ("SWS API root         : {0}" -f $SwsApiRoot) 'INFO'

    Initialize-SwsAuthenticationPrompt
    $script:SwsToken = Get-SwsTokenValue
    Add-SummaryRow -Step 'SWS Authentication' -Status 'SUCCESS' -Detail 'Access token initialized. Token value was not logged.'

    $postmanJsonPath = Get-OfficialPostmanCollectionJsonPath -RequestedPath $PostmanCollectionPath
    Write-Log ("Using Postman JSON   : {0}" -f $postmanJsonPath) 'SUCCESS'

    $collection = Get-Content -LiteralPath $postmanJsonPath -Raw | ConvertFrom-Json
    foreach ($variable in @((Get-DirectProperty -Object $collection -Names @('variable')))) {
        $key = [string](Get-DirectProperty -Object $variable -Names @('key','name'))
        $value = Get-DirectProperty -Object $variable -Names @('value','current','initial')
        if (-not [string]::IsNullOrWhiteSpace($key) -and $null -ne $value) {
            $script:CollectionVariables[$key] = [string]$value
        }
    }

    $collectionItems = Get-DirectProperty -Object $collection -Names @('item')
    $script:PostmanRequests = @(Get-PostmanRequestRows -Items @($collectionItems))
    Select-SwsPostmanRequests -Requests $script:PostmanRequests
    Add-SummaryRow -Step 'Postman Collection' -Status 'SUCCESS' -Detail ("List={0}; Detail={1}; PutConfig={2}" -f $script:ListPoliciesRequest.Name, $script:GetPolicyRequest.Name, $script:PutApplicationConfigurationRequest.Name)

    Write-Log 'Retrieving SWS policies and locating source policy.' 'INFO'
    $initialList = Get-PolicyListResponse
    Save-JsonArtifact -FileName '01_Sws_Policy_List.json' -Object $initialList | Out-Null

    $sourcePolicy = Find-SwsPolicy -Selector $SourceIdentityAppKey -SelectorDescription 'source Identity app key' -ListResponse $initialList
    if ($null -eq $sourcePolicy) {
        throw ("No SWS policy was found for source Identity app key '{0}'." -f $SourceIdentityAppKey)
    }

    Write-Log ("Source SWS policy found. PolicyId={0}; Name='{1}'." -f $sourcePolicy.PolicyId, $sourcePolicy.Name) 'SUCCESS'
    Add-SummaryRow -Step 'Find Source Policy' -Status 'SUCCESS' -Detail ("PolicyId={0}; Name={1}" -f $sourcePolicy.PolicyId, $sourcePolicy.Name)
    Save-JsonArtifact -FileName '02_Source_Policy_Detail.json' -Object $sourcePolicy.Detail | Out-Null

    $sourceConfiguration = Get-SwsConfigurationNode -PolicyDetail $sourcePolicy.Detail
    Save-JsonArtifact -FileName '04_Source_Application_Configuration.json' -Object $sourceConfiguration | Out-Null

    foreach ($targetRow in $targetRows) {
        try {
            Invoke-SwsCloneForTarget -TargetRow $targetRow -SourcePolicy $sourcePolicy -SourceConfiguration $sourceConfiguration
            Add-SummaryRow -Step 'Target Overall' -Status 'SUCCESS' -Detail 'Target processing completed.' -RowNumber $targetRow.RowNumber -TargetApplicationName $targetRow.TargetApplicationName -TargetIdentityAppKey $targetRow.TargetIdentityAppKey
        }
        catch {
            $script:HadTargetFailures = $true
            Write-Log ("FAILED target row {0}, application '{1}', key '{2}': {3}" -f $targetRow.RowNumber, $targetRow.TargetApplicationName, $targetRow.TargetIdentityAppKey, $_.Exception.Message) 'ERROR'
            Add-SummaryRow -Step 'Target Overall' -Status 'FAILED' -Detail $_.Exception.Message -RowNumber $targetRow.RowNumber -TargetApplicationName $targetRow.TargetApplicationName -TargetIdentityAppKey $targetRow.TargetIdentityAppKey

            if ($StopOnFirstFailure) {
                throw
            }
        }
        finally {
            $script:CurrentTargetRowNumber = $null
            $script:CurrentTargetApplicationName = $null
            $script:CurrentTargetIdentityAppKey = $null
            $script:OutputFolder = $script:BatchRootOutputFolder
        }
    }

    if ($script:HadTargetFailures) {
        throw 'CSV batch completed with one or more target failures. Review SWS_Clone_Test_Summary.csv and the per-target folders.'
    }

    Write-Log ("Completed successfully for all {0} target application(s)." -f $targetRows.Count) 'SUCCESS'
    Add-SummaryRow -Step 'Overall Batch' -Status 'SUCCESS' -Detail ("TargetCount={0}" -f $targetRows.Count)
}
catch {
    Write-Log ("FAILED: {0}" -f $_.Exception.Message) 'ERROR'
    Add-SummaryRow -Step 'Overall Batch' -Status 'FAILED' -Detail $_.Exception.Message
    throw
}
finally {
    try {
        if ($script:SummaryRows.Count -gt 0) {
            $summaryPath = Join-Path $script:BatchRootOutputFolder 'SWS_Clone_Test_Summary.csv'
            $script:SummaryRows | Export-Csv -LiteralPath $summaryPath -NoTypeInformation -Force
            Write-Log ("Summary report exported: {0}" -f $summaryPath) 'INFO'
        }
    }
    catch {
        Write-Host ("Could not export summary report: {0}" -f $_.Exception.Message) -ForegroundColor Yellow
    }

    $script:SwsToken = $null
}
