# Authentication helpers
# =====================================================================

function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$CCPAddress,

        [Parameter(Mandatory = $true)]
        [string]$Location,

        [Parameter(Mandatory = $true)]
        [string]$AppID,

        [Parameter(Mandatory = $true)]
        [string]$Safe,

        [Parameter(Mandatory = $true)]
        [string]$Object,

        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd("/")
    $locationValue = $Location.Trim("/")

    $url = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f `
        $base,
        $locationValue,
        [uri]::EscapeDataString($AppID),
        [uri]::EscapeDataString($Safe),
        [uri]::EscapeDataString($Object)

    Write-Log -Message "Retrieving the Privilege Cloud service-user credential from CCP."

    $response = Invoke-RestMethod `
        -Uri $url `
        -Method Get `
        -Headers @{ "Content-Type" = "application/json" } `
        -UseDefaultCredentials:$WindowsAuth `
        -ErrorAction Stop

    if (-not $response.UserName -or -not $response.Content) {
        throw "The CCP response did not include UserName and Content."
    }

    Write-Log -Message ("CCP returned service user '{0}'." -f $response.UserName) -Level "SUCCESS"

    $securePassword = ConvertTo-SecureString $response.Content -AsPlainText -Force
    return New-Object System.Management.Automation.PSCredential($response.UserName, $securePassword)
}

# =====================================================================
# CyberArk account retrieval
# =====================================================================

function ConvertTo-FlatAccountCollection {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$InputCollection
    )

    if ($null -eq $InputCollection) {
        return
    }

    foreach ($item in $InputCollection) {
        if ($null -eq $item) {
            continue
        }

        $valueProperty = $item.PSObject.Properties["value"]
        $accountsProperty = $item.PSObject.Properties["Accounts"]

        if ($valueProperty -and $null -ne $valueProperty.Value) {
            foreach ($account in $valueProperty.Value) {
                if ($null -ne $account) {
                    Write-Output $account
                }
            }
        }
        elseif ($accountsProperty -and $null -ne $accountsProperty.Value) {
            foreach ($account in $accountsProperty.Value) {
                if ($null -ne $account) {
                    Write-Output $account
                }
            }
        }
        else {
            Write-Output $item
        }
    }
}

function Get-AllVisibleCyberArkAccounts {
    [CmdletBinding()]
    param(
        [ValidateRange(1, 1000)]
        [int]$PageSize = 1000
    )

    Write-Log -Message "Retrieving the visible CyberArk account inventory using Get-PASAccount."

    $command = Get-Command Get-PASAccount -ErrorAction Stop
    $supportsLimit = $command.Parameters.ContainsKey("limit")
    $supportsOffset = $command.Parameters.ContainsKey("offset")

    $accountsByKey = @{}
    $offset = 0
    $pageNumber = 0

    do {
        $pageNumber++

        $parameters = @{
            ErrorAction = "Stop"
        }

        if ($supportsLimit) {
            $parameters["limit"] = $PageSize
        }

        if ($supportsOffset) {
            $parameters["offset"] = $offset
        }

        if ($supportsLimit -and $supportsOffset) {
            Write-Log -Message ("Retrieving CyberArk account page {0}; offset={1}; limit={2}." -f $pageNumber, $offset, $PageSize)
        }
        elseif ($pageNumber -eq 1) {
            Write-Log -Message "This psPAS version does not expose both -limit and -offset; retrieving the default result set."
        }

        $rawPage = Get-PASAccount @parameters
        $pageAccounts = @(ConvertTo-FlatAccountCollection -InputCollection $rawPage)
        $uniqueCountBeforePage = $accountsByKey.Count

        foreach ($account in $pageAccounts) {
            $uniqueKey = Get-CyberArkAccountUniqueKey -Account $account
            $accountsByKey[$uniqueKey] = $account
        }

        $newUniqueCount = $accountsByKey.Count - $uniqueCountBeforePage

        Write-Log -Message (
            "CyberArk page {0} returned {1} account(s); {2} new; {3} unique account(s) collected." -f
            $pageNumber,
            $pageAccounts.Count,
            $newUniqueCount,
            $accountsByKey.Count
        )

        if (-not ($supportsLimit -and $supportsOffset)) {
            break
        }

        if ($pageAccounts.Count -lt $PageSize) {
            break
        }

        if ($pageNumber -gt 1 -and $newUniqueCount -eq 0) {
            Write-Log -Message "Paging returned no new accounts. The API may be ignoring the offset; stopping to prevent a repeated-page loop." -Level "WARN"
            break
        }

        $offset += $pageAccounts.Count

        if ($pageNumber -ge 10000) {
            throw "CyberArk account paging exceeded 10,000 pages. Paging was stopped to prevent an infinite loop."
        }
    }
    while ($true)

    $finalAccounts = @(
        foreach ($account in $accountsByKey.Values) {
            Write-Output $account
        }
    )

    Write-Log -Message ("Retrieved {0} unique visible CyberArk account(s)." -f $finalAccounts.Count) -Level "SUCCESS"
    return $finalAccounts
}

function Search-VisibleCyberArkAccounts {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string[]]$SearchTerms
    )

    $command = Get-Command Get-PASAccount -ErrorAction Stop
    $supportsSearchType = $command.Parameters.ContainsKey("searchType")
    $supportsLimit = $command.Parameters.ContainsKey("limit")

    $cache = @{}
    $globalUnique = @{}

    $terms = @(
        $SearchTerms |
            Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
            Sort-Object -Unique
    )

    $current = 0

    foreach ($term in $terms) {
        $current++
        $normalizedTerm = ConvertTo-NormalizedText $term

        if ($cache.ContainsKey($normalizedTerm)) {
            $searchResults = @($cache[$normalizedTerm])
        }
        else {
            Write-Log -Message ("Searching CyberArk [{0}/{1}] for username '{2}'." -f $current, $terms.Count, $term)

            $parameters = @{
                search      = $term
                ErrorAction = "Stop"
            }

            if ($supportsSearchType) {
                $parameters["searchType"] = "contains"
            }

            if ($supportsLimit) {
                $parameters["limit"] = 1000
            }

            $rawResults = Get-PASAccount @parameters
            $searchResults = @(ConvertTo-FlatAccountCollection -InputCollection $rawResults)
            $cache[$normalizedTerm] = $searchResults
        }

        foreach ($account in $searchResults) {
            $uniqueKey = Get-CyberArkAccountUniqueKey -Account $account
            $globalUnique[$uniqueKey] = $account
        }
    }

    $finalAccounts = @(
        foreach ($account in $globalUnique.Values) {
            Write-Output $account
        }
    )

    Write-Log -Message ("Search mode returned {0} unique visible CyberArk account(s)." -f $finalAccounts.Count) -Level "SUCCESS"
    return $finalAccounts
}

function New-CyberArkUsernameLookup {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Accounts
    )

    $lookup = @{}

    foreach ($account in $Accounts) {
        $cyberUsername = Get-ObjectPropertyValue -InputObject $account -PropertyName "userName"
        $keys = @(Get-UsernameKeys -Username $cyberUsername)

        foreach ($key in $keys) {
            if (-not $lookup.ContainsKey($key)) {
                $lookup[$key] = New-Object System.Collections.ArrayList
            }

            [void]$lookup[$key].Add($account)
        }
    }

    return $lookup
}

# =====================================================================
# Main
# =====================================================================

$sessionCreated = $false
$script:LogFile = $null

try {
    Import-Module psPAS -ErrorAction Stop
    Import-Module IdentityCommand -ErrorAction Stop

    $psPASModule = Get-Module psPAS
    Write-Host ("Loaded psPAS version: {0}" -f $psPASModule.Version) -ForegroundColor Cyan

    if ([string]::IsNullOrWhiteSpace($InputCsvPath)) {
        $InputCsvPath = Select-InputCsvFile
    }

    $InputCsvPath = [Environment]::ExpandEnvironmentVariables($InputCsvPath.Trim('"'))

    if (-not (Test-Path -LiteralPath $InputCsvPath -PathType Leaf)) {
        throw "Input CSV not found: $InputCsvPath"
    }

    if ([string]::IsNullOrWhiteSpace($OutputDirectory)) {
        $OutputDirectory = Split-Path -Path $InputCsvPath -Parent
    }

    if ([string]::IsNullOrWhiteSpace($OutputDirectory)) {
        $OutputDirectory = (Get-Location).Path
    }

    if (-not (Test-Path -LiteralPath $OutputDirectory -PathType Container)) {
        New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
    }

    $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $summaryCsv = Join-Path $OutputDirectory ("{0}_Summary_{1}.csv" -f $OutputBaseName, $timestamp)
    $matchesCsv = Join-Path $OutputDirectory ("{0}_Matches_{1}.csv" -f $OutputBaseName, $timestamp)
    $notVaultedCsv = Join-Path $OutputDirectory ("{0}_NotVaulted_{1}.csv" -f $OutputBaseName, $timestamp)
    $script:LogFile = Join-Path $OutputDirectory ("{0}_{1}.log" -f $OutputBaseName, $timestamp)

    Write-Log -Message "============================================================"
    Write-Log -Message "AD service-account to CyberArk comparison starting."
    Write-Log -Message ("Input CSV           : {0}" -f $InputCsvPath)
    Write-Log -Message ("Output directory     : {0}" -f $OutputDirectory)
    Write-Log -Message ("Lookup mode          : {0}" -f $LookupMode)
    Write-Log -Message ("Require address match: {0}" -f [bool]$RequireAddressMatch)

    $adRows = @(Import-Csv -LiteralPath $InputCsvPath -ErrorAction Stop)

    if ($adRows.Count -eq 0) {
        throw "The input CSV contains no data rows."
    }

    Write-Log -Message ("Imported {0} AD source row(s)." -f $adRows.Count) -Level "SUCCESS"

    $firstRow = $adRows[0]

    if ([string]::IsNullOrWhiteSpace($UsernameColumn)) {
        $usernameCandidates = @(
            "Username",
            "SamAccountName",
            "sAMAccountName",
            "AccountName",
            "Account Name",
            "ServiceAccount",
            "Service Account",
            "User",
            "Name"
        )

        $UsernameColumn = Get-PropertyNameCaseInsensitive `
            -InputObject $firstRow `
            -CandidateNames $usernameCandidates
    }
    else {
        $UsernameColumn = Get-PropertyNameCaseInsensitive `
            -InputObject $firstRow `
            -CandidateNames @($UsernameColumn)
    }

    if ([string]::IsNullOrWhiteSpace($UsernameColumn)) {
        $availableColumns = @($firstRow.PSObject.Properties.Name) -join ", "
        throw "Could not identify the username column. Available columns: $availableColumns"
    }

    if ([string]::IsNullOrWhiteSpace($AddressColumn)) {
        $addressCandidates = @(
            "Address",
            "Domain",
            "DNSDomain",
            "DNS Domain",
            "FQDN",
            "UserPrincipalName",
            "UPN",
            "DistinguishedName",
            "Distinguished Name"
        )

        $AddressColumn = Get-PropertyNameCaseInsensitive `
            -InputObject $firstRow `
            -CandidateNames $addressCandidates
    }
    else {
        $AddressColumn = Get-PropertyNameCaseInsensitive `
            -InputObject $firstRow `
            -CandidateNames @($AddressColumn)

        if ([string]::IsNullOrWhiteSpace($AddressColumn)) {
            throw "The specified address column was not found in the CSV."
        }
    }

    Write-Log -Message ("Username column      : {0}" -f $UsernameColumn)
    Write-Log -Message ("Address column       : {0}" -f $(if ($AddressColumn) { $AddressColumn } else { "<not detected>" }))

    $serviceCredential = Get-ServiceUserCredentialFromCCP `
        -CCPAddress $CCPAddress `
        -Location $CCPLocation `
        -AppID $CCPAppID `
        -Safe $CCPSafe `
        -Object $CCPObject `
        -WindowsAuth:$CCPWindowsAuth

    Write-Log -Message "Authenticating to Privilege Cloud through Identity Shared Services."

    New-PASSession `
        -IdentityTenantURL $IdentityTenantURL `
        -PrivilegeCloudURL $PrivilegeCloudURL `
        -Credential $serviceCredential `
        -ServiceUser `
        -ErrorAction Stop | Out-Null

    if (-not (Get-PASSession)) {
        throw "The psPAS Privilege Cloud session was not established."
    }

    $sessionCreated = $true
    Write-Log -Message ("Authenticated to {0} as {1}." -f $PrivilegeCloudURL, $serviceCredential.UserName) -Level "SUCCESS"

    $cyberAccounts = @()

    if ($LookupMode -eq "Bulk") {
        $cyberAccounts = @(Get-AllVisibleCyberArkAccounts)
    }
    else {
        $searchTermMap = @{}

        foreach ($row in $adRows) {
            $sourceUsername = Get-ObjectPropertyValue -InputObject $row -PropertyName $UsernameColumn

            foreach ($key in @(Get-UsernameKeys -Username $sourceUsername)) {
                $searchTermMap[$key.ToUpperInvariant()] = $key
            }
        }

        $searchTermArray = [string[]]@(
            foreach ($term in $searchTermMap.Values) {
                Write-Output ([string]$term)
            }
        )

        $cyberAccounts = @(Search-VisibleCyberArkAccounts -SearchTerms $searchTermArray)
    }

    $usernameLookup = New-CyberArkUsernameLookup -Accounts $cyberAccounts

    $summaryResults = New-Object System.Collections.ArrayList
    $matchDetails = New-Object System.Collections.ArrayList

    $rowNumber = 0

    foreach ($adRow in $adRows) {
        $rowNumber++

        $sourceUsername = Get-ObjectPropertyValue -InputObject $adRow -PropertyName $UsernameColumn
        $sourceAddress = $null

        if ($AddressColumn) {
            $sourceAddress = Get-ObjectPropertyValue -InputObject $adRow -PropertyName $AddressColumn
        }

        $usernameKeys = @(Get-UsernameKeys -Username $sourceUsername)
        $normalizedAddress = ConvertTo-NormalizedAddress -Value $sourceAddress

        $matchedById = @{}

        foreach ($key in $usernameKeys) {
            if ($usernameLookup.ContainsKey($key)) {
                foreach ($account in $usernameLookup[$key]) {
                    $accountKey = Get-CyberArkAccountUniqueKey -Account $account
                    $matchedById[$accountKey] = $account
                }
            }
        }

        $usernameMatches = @($matchedById.Values)
        $addressMatches = @()
        $addressMismatches = @()

        if (-not [string]::IsNullOrWhiteSpace($normalizedAddress)) {
            foreach ($account in $usernameMatches) {
                $cyberAddress = Get-ObjectPropertyValue -InputObject $account -PropertyName "address"
                $normalizedCyberAddress = ConvertTo-NormalizedAddress -Value $cyberAddress

                if ([string]::Equals(
                        $normalizedAddress,
                        $normalizedCyberAddress,
                        [System.StringComparison]::OrdinalIgnoreCase
                    )) {
                    $addressMatches += $account
                }
                else {
                    $addressMismatches += $account
                }
            }
        }

        $selectedMatches = @()
        $vaultStatus = ""
        $addressValidation = ""
        $matchBasis = ""

        if ($usernameKeys.Count -eq 0) {
            $vaultStatus = "InvalidInput"
            $addressValidation = "NotEvaluated"
            $matchBasis = "UsernameMissing"
        }
        elseif ($usernameMatches.Count -eq 0) {
            $vaultStatus = "NotVaulted"
            $addressValidation = $(if ($normalizedAddress) { "NoUsernameMatch" } else { "NotProvided" })
            $matchBasis = "NoMatch"
        }
        elseif ($RequireAddressMatch -and -not [string]::IsNullOrWhiteSpace($normalizedAddress)) {
            if ($addressMatches.Count -gt 0) {
                $selectedMatches = @($addressMatches)
                $vaultStatus = $(if ($selectedMatches.Count -gt 1) { "VaultedMultiple" } else { "Vaulted" })
                $addressValidation = "Matched"
                $matchBasis = "UsernameAndAddress"
            }
            else {
                $selectedMatches = @($usernameMatches)
                $vaultStatus = "UsernameFoundAddressMismatch"
                $addressValidation = "Mismatch"
                $matchBasis = "UsernameOnly"
            }
        }
        else {
            $selectedMatches = @($usernameMatches)
            $vaultStatus = $(if ($selectedMatches.Count -gt 1) { "VaultedMultiple" } else { "Vaulted" })

            if ([string]::IsNullOrWhiteSpace($normalizedAddress)) {
                $addressValidation = "NotProvided"
                $matchBasis = "Username"
            }
            elseif ($addressMatches.Count -gt 0) {
                $addressValidation = "Matched"
                $matchBasis = "UsernameAndAddress"
            }
            else {
                $addressValidation = "Mismatch"
                $matchBasis = "Username"
            }
        }

        $summary = [ordered]@{
            SourceRow                    = $rowNumber
            ADUsername                   = [string]$sourceUsername
            ADAddress                    = [string]$sourceAddress
            NormalizedUsernameKeys       = ($usernameKeys -join "; ")
            NormalizedAddress            = $normalizedAddress
            VaultStatus                  = $vaultStatus
            MatchBasis                   = $matchBasis
            AddressValidation            = $addressValidation
            CyberArkMatchCount           = $selectedMatches.Count
            CyberArkAccountIDs           = Join-UniqueValues -Values @($selectedMatches | ForEach-Object { Get-ObjectPropertyValue $_ "id" })
            CyberArkUsernames            = Join-UniqueValues -Values @($selectedMatches | ForEach-Object { Get-ObjectPropertyValue $_ "userName" })
            CyberArkAddresses            = Join-UniqueValues -Values @($selectedMatches | ForEach-Object { Get-ObjectPropertyValue $_ "address" })
            CyberArkSafeNames            = Join-UniqueValues -Values @($selectedMatches | ForEach-Object { Get-ObjectPropertyValue $_ "safeName" })
            CyberArkPlatformIDs          = Join-UniqueValues -Values @($selectedMatches | ForEach-Object { Get-ObjectPropertyValue $_ "platformId" })
            AutomaticManagementEnabled   = Join-UniqueValues -Values @(
                $selectedMatches | ForEach-Object {
                    $secretManagement = Get-ObjectPropertyValue $_ "secretManagement"
                    if ($secretManagement) {
                        Get-ObjectPropertyValue $secretManagement "automaticManagementEnabled"
                    }
                }
            )
            ManualManagementReason       = Join-UniqueValues -Values @(
                $selectedMatches | ForEach-Object {
                    $secretManagement = Get-ObjectPropertyValue $_ "secretManagement"
                    if ($secretManagement) {
                        Get-ObjectPropertyValue $secretManagement "manualManagementReason"
                    }
                }
            )
        }

        # Preserve all original AD columns.
        foreach ($sourceProperty in $adRow.PSObject.Properties) {
            $outputPropertyName = "AD_{0}" -f $sourceProperty.Name

            if (-not $summary.Contains($outputPropertyName)) {
                $summary[$outputPropertyName] = $sourceProperty.Value
            }
        }

        [void]$summaryResults.Add([PSCustomObject]$summary)

        foreach ($account in $selectedMatches) {
            $cyberAddress = Get-ObjectPropertyValue -InputObject $account -PropertyName "address"
            $secretManagement = Get-ObjectPropertyValue -InputObject $account -PropertyName "secretManagement"
            $thisAddressMatch = $false

            if (-not [string]::IsNullOrWhiteSpace($normalizedAddress)) {
                $thisAddressMatch = [string]::Equals(
                    $normalizedAddress,
                    (ConvertTo-NormalizedAddress -Value $cyberAddress),
                    [System.StringComparison]::OrdinalIgnoreCase
                )
            }

            $detail = [ordered]@{
                SourceRow                   = $rowNumber
                ADUsername                  = [string]$sourceUsername
                ADAddress                   = [string]$sourceAddress
                VaultStatus                 = $vaultStatus
                MatchBasis                  = $matchBasis
                AddressMatches              = $thisAddressMatch
                CyberArkAccountID           = Get-ObjectPropertyValue $account "id"
                CyberArkAccountName         = Get-ObjectPropertyValue $account "name"
                CyberArkUsername            = Get-ObjectPropertyValue $account "userName"
                CyberArkAddress             = $cyberAddress
                CyberArkSafeName            = Get-ObjectPropertyValue $account "safeName"
                CyberArkPlatformID          = Get-ObjectPropertyValue $account "platformId"
                CyberArkSecretType          = Get-ObjectPropertyValue $account "secretType"
                AutomaticManagementEnabled  = $(if ($secretManagement) { Get-ObjectPropertyValue $secretManagement "automaticManagementEnabled" } else { $null })
                ManualManagementReason      = $(if ($secretManagement) { Get-ObjectPropertyValue $secretManagement "manualManagementReason" } else { $null })
                ManagementStatus            = $(if ($secretManagement) { Get-ObjectPropertyValue $secretManagement "status" } else { $null })
            }

            [void]$matchDetails.Add([PSCustomObject]$detail)
        }

        if (($rowNumber % 100) -eq 0 -or $rowNumber -eq $adRows.Count) {
            Write-Log -Message ("Compared {0}/{1} AD row(s)." -f $rowNumber, $adRows.Count)
        }
    }

    $summaryResults |
        Export-Csv -LiteralPath $summaryCsv -NoTypeInformation -Encoding UTF8

    if ($matchDetails.Count -gt 0) {
        $matchDetails |
            Export-Csv -LiteralPath $matchesCsv -NoTypeInformation -Encoding UTF8
    }
    else {
        "SourceRow,ADUsername,ADAddress,VaultStatus" |
            Set-Content -LiteralPath $matchesCsv -Encoding UTF8
    }

    $notVaultedResults = @(
        $summaryResults |
            Where-Object {
                $_.VaultStatus -eq "NotVaulted" -or
                $_.VaultStatus -eq "InvalidInput" -or
                $_.VaultStatus -eq "UsernameFoundAddressMismatch"
            }
    )

    if ($notVaultedResults.Count -gt 0) {
        $notVaultedResults |
            Export-Csv -LiteralPath $notVaultedCsv -NoTypeInformation -Encoding UTF8
    }
    else {
        "No not-vaulted records were found." |
            Set-Content -LiteralPath $notVaultedCsv -Encoding UTF8
    }

    $vaultedCount = @(
        $summaryResults |
            Where-Object {
                $_.VaultStatus -eq "Vaulted" -or
                $_.VaultStatus -eq "VaultedMultiple"
            }
    ).Count

    $notVaultedCount = @(
        $summaryResults |
            Where-Object { $_.VaultStatus -eq "NotVaulted" }
    ).Count

    $multipleCount = @(
        $summaryResults |
            Where-Object { $_.VaultStatus -eq "VaultedMultiple" }
    ).Count

    $addressMismatchCount = @(
        $summaryResults |
            Where-Object {
                $_.AddressValidation -eq "Mismatch" -or
                $_.VaultStatus -eq "UsernameFoundAddressMismatch"
            }
    ).Count

    Write-Log -Message "============================================================"
    Write-Log -Message ("Total AD rows         : {0}" -f $summaryResults.Count) -Level "SUCCESS"
    Write-Log -Message ("Vaulted               : {0}" -f $vaultedCount) -Level "SUCCESS"
    Write-Log -Message ("Not vaulted           : {0}" -f $notVaultedCount) -Level $(if ($notVaultedCount -gt 0) { "WARN" } else { "SUCCESS" })
    Write-Log -Message ("Multiple matches       : {0}" -f $multipleCount) -Level $(if ($multipleCount -gt 0) { "WARN" } else { "SUCCESS" })
    Write-Log -Message ("Address mismatches     : {0}" -f $addressMismatchCount) -Level $(if ($addressMismatchCount -gt 0) { "WARN" } else { "SUCCESS" })
    Write-Log -Message ("Summary report         : {0}" -f $summaryCsv)
    Write-Log -Message ("Match details          : {0}" -f $matchesCsv)
    Write-Log -Message ("Not-vaulted report     : {0}" -f $notVaultedCsv)
    Write-Log -Message ("Log file               : {0}" -f $script:LogFile)
    Write-Log -Message "Comparison completed." -Level "SUCCESS"
}
catch {
    $errorMessage = $_.Exception.Message

    if ($script:LogFile) {
        Write-Log -Message ("FATAL: {0}" -f $errorMessage) -Level "ERROR"
    }
    else {
        Write-Host ("FATAL: {0}" -f $errorMessage) -ForegroundColor Red
    }

    throw
}
finally {
    if ($sessionCreated) {
        try {
            Close-PASSession | Out-Null
            Write-Log -Message "Logged off from Privilege Cloud." -Level "SUCCESS"
        }
        catch {
            if ($script:LogFile) {
                Write-Log -Message ("Logoff warning: {0}" -f $_.Exception.Message) -Level "WARN"
            }
        }
    }
}
