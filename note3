<#
Find-Missing-Accounts-ByAddress.ps1  (PS 5.1; discovery + export only)

Now prompts with a popup (OpenFileDialog) to select the INPUT CSV.
The CSV can contain ANY address/domain values.

Accepted input headers (case-insensitive):
 - Username: Username | UserName | SamAccountName | samaccountname | SAM
 - Address : Address  | address  | Domain         | domain | Host | host | Hostname | hostname

Default output: I:\Script\REPORTS\NotFound_Accounts.csv
Output columns: Username, Address
#>

[CmdletBinding()]
param(
  # --- Alliant login pattern ---
  [string]$BaseURI   = "https://alliantcredit.privilegecloud.cyberark.com",
  [ValidateSet('CyberArk','LDAP','RADIUS','Windows','SAML','Shared')]
  [string]$AuthType  = 'CyberArk',

  # --- Output path (input is chosen via popup) ---
  [string]$OutputCsv = "I:\Script\REPORTS\NotFound_Accounts.csv"
)

# ===== Prep & helpers =====
Import-Module psPAS -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Continue'

function Write-Info($m){ Write-Host "[*] $m" -ForegroundColor Cyan }
function Write-Ok($m){   Write-Host "[OK] $m" -ForegroundColor Green }
function Write-Warn($m){ Write-Host "[!] $m" -ForegroundColor Yellow }
function Write-Err($m){  Write-Host "[X] $m" -ForegroundColor Red }

# Fancy popup to select the input CSV (tries Windows Forms; safe fallback to Read-Host)
function Get-InputCsvPath {
  try {
    if ([Threading.Thread]::CurrentThread.ApartmentState -ne 'STA') {
      Write-Warn "Current PowerShell not in STA; falling back to text prompt for file path."
      throw "Not STA"
    }

    Add-Type -AssemblyName System.Windows.Forms | Out-Null
    $dlg = New-Object System.Windows.Forms.OpenFileDialog
    $dlg.Title = "Select the Accounts CSV (Username + Address)"
    $dlg.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*"
    $dlg.CheckFileExists = $true
    $dlg.RestoreDirectory = $true
    $dlg.Multiselect = $false
    $dlg.InitialDirectory = Split-Path -Path "I:\Script\REPORTS" -ErrorAction SilentlyContinue

    $null = $dlg.ShowDialog()
    if ([string]::IsNullOrWhiteSpace($dlg.FileName)) {
      Write-Err "No file selected. Exiting."
      return $null
    }
    return $dlg.FileName
  } catch {
    # Fallback: simple input box (works anywhere)
    try {
      Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop | Out-Null
      $path = [Microsoft.VisualBasic.Interaction]::InputBox(
        "Enter full path to the Accounts CSV (Username, Address).",
        "Accounts CSV Path",
        "I:\Script\REPORTS\AccountsToCheck.csv"
      )
      if ([string]::IsNullOrWhiteSpace($path)) {
        Write-Err "No file path entered. Exiting."
        return $null
      }
      return $path
    } catch {
      # Last resort: Read-Host
      $path = Read-Host "Enter full path to the Accounts CSV (Username, Address)"
      if ([string]::IsNullOrWhiteSpace($path)) {
        Write-Err "No file path entered. Exiting."
        return $null
      }
      return $path
    }
  }
}

# First non-empty scalar; arrays -> first non-empty element
function First-NotNullOrEmpty {
  param([Parameter(ValueFromRemainingArguments=$true)] $Values)
  foreach ($v in $Values) {
    if ($null -eq $v) { continue }
    if ($v -is [array]) {
      foreach ($e in $v) {
        if ($null -ne $e -and ($e.ToString()).Trim().Length -gt 0) { return ($e.ToString()).Trim() }
      }
    } else {
      $s = ($v.ToString()).Trim()
      if ($s.Length -gt 0) { return $s }
    }
  }
  return ""
}

# Generic property getter across shapes
function Get-Prop {
  param($obj, [string]$name)
  if ($null -eq $obj) { return $null }
  if ($obj.PSObject.Properties[$name]) { return $obj.$name }
  if ($obj.properties -and $obj.properties.PSObject.Properties[$name]) { return $obj.properties.$name }
  if ($obj.platformAccountProperties -and $obj.platformAccountProperties.PSObject.Properties[$name]) { return $obj.platformAccountProperties.$name }
  if ($obj.additionalProperties -and $obj.additionalProperties.PSObject.Properties[$name]) { return $obj.additionalProperties.$name }
  return $null
}

# ---- PVWA REST (reuse psPAS session cookie) ----
function Get-PVWAApiPrefix {
  param([Parameter(Mandatory)][string]$BaseUri, [Parameter(Mandatory)]$WebSession)
  $candidates = @("/api","/PasswordVault/api")
  foreach ($p in $candidates) {
    try {
      $u = ($BaseUri.TrimEnd('/')) + $p + "/version"
      Invoke-RestMethod -Method GET -Uri $u -WebSession $WebSession -ErrorAction Stop | Out-Null
      return $p
    } catch { continue }
  }
  "/api"
}

function Invoke-PVWA {
  [CmdletBinding()]
  param(
    [Parameter(Mandatory)][ValidateSet('GET','POST','PUT','PATCH','DELETE')] [string]$Method,
    [Parameter(Mandatory)][string]$Path,   # e.g., "/accounts?search=jdoe"
    [Parameter()][object]$Body = $null
  )
  if (-not $script:PVWA_Base)   { throw "PVWA not initialized." }
  if (-not $script:PVWA_Session){ throw "PVWA WebSession not set." }
  $uri = ($script:PVWA_Base.TrimEnd('/')) + $script:PVWA_Prefix + $Path
  $splat = @{ Method=$Method; Uri=$uri; WebSession=$script:PVWA_Session; ErrorAction='Stop' }
  if ($null -ne $Body) { $splat['ContentType'] = 'application/json'; $splat['Body'] = ($Body | ConvertTo-Json -Depth 8) }
  Invoke-RestMethod @splat
}

# Check if an account with exact Username + Address exists in PVWA
function Test-AccountExists {
  [CmdletBinding()]
  param(
    [Parameter(Mandatory)][string]$Username,
    [Parameter(Mandatory)][string]$Address
  )

  # Pull accounts by username (broad), then filter locally for exact username/address match (case-insensitive).
  $encUser = [uri]::EscapeDataString($Username)
  $page    = 1
  $limit   = 200

  while ($true) {
    $path = "/accounts?search=$encUser&limit=$limit&offset=$([int](($page-1)*$limit))"
    try {
      $resp = Invoke-PVWA -Method GET -Path $path
    } catch {
      Write-Warn ("  -> Search error for '{0}': {1}" -f $Username, $_.Exception.Message)
      return $false
    }

    $candidates = @()
    if ($resp) {
      if     ($resp.value)        { $candidates = $resp.value }
      elseif ($resp.accounts)     { $candidates = $resp.accounts }
      elseif ($resp -is [array])  { $candidates = $resp }
    }

    foreach ($a in $candidates) {
      $u = (Get-Prop $a 'username'); if (-not $u) { $u = (Get-Prop $a 'userName') }
      $ad= (Get-Prop $a 'address')
      if ($u -and $ad) {
        if ($u.ToString().Trim().ToLower() -eq $Username.ToLower() -and $ad.ToString().Trim().ToLower() -eq $Address.ToLower()) {
          return $true
        }
      }
    }

    if ($candidates.Count -lt $limit) { break }  # no more pages
    $page++
    if ($page -gt 50) { break } # hard safety stop
  }

  return $false
}

# ===== Prompt for INPUT CSV =====
$InputCsv = Get-InputCsvPath
if (-not $InputCsv) { return }
if (-not (Test-Path $InputCsv)) { Write-Err "Input CSV not found: $InputCsv"; return }

# ===== Authenticate =====
$cred = Get-Credential -Message "Enter your CyberArk ($AuthType) credential"
try {
  New-PASSession -Credential $cred -BaseURI $BaseURI -Type $AuthType | Out-Null
  Write-Ok "Authenticated to $BaseURI."
} catch { Write-Err "Authentication failed: $($_.Exception.Message)"; return }

# Grab psPAS WebSession and detect API prefix
try {
  $ses = Get-PASSession
  $script:PVWA_Base    = if ($ses.BaseURI) { $ses.BaseURI } else { $BaseURI }
  $script:PVWA_Session = $ses.WebSession
  if (-not $script:PVWA_Session) { throw "psPAS WebSession not found after login." }
  $script:PVWA_Prefix  = Get-PVWAApiPrefix -BaseUri $script:PVWA_Base -WebSession $script:PVWA_Session
  Write-Info ("Detected API prefix: {0}" -f $script:PVWA_Prefix)
} catch { Write-Err ("Could not initialize PVWA REST access: {0}" -f $_.Exception.Message); Close-PASSession | Out-Null; return }

# ===== Load & normalize CSV =====
try { $rows = Import-Csv -Path $InputCsv } catch { Write-Err "Failed reading CSV '$InputCsv': $($_.Exception.Message)"; Close-PASSession | Out-Null; return }
if (-not $rows -or $rows.Count -eq 0) { Write-Err "CSV is empty. Needs Username + Address columns."; Close-PASSession | Out-Null; return }

$norm = @()
foreach ($r in $rows) {
  $user = First-NotNullOrEmpty $r.Username, $r.UserName, $r.SamAccountName, $r.samaccountname, $r.SAM
  $addr = First-NotNullOrEmpty $r.Address, $r.address, $r.Domain, $r.domain, $r.Host, $r.host, $r.Hostname, $r.hostname
  if ($user -and $addr) {
    $norm += [PSCustomObject]@{ Username = $user; Address = $addr }
  }
}
$valid   = $norm
$skipped = $rows.Count - $valid.Count
if ($skipped -gt 0) { Write-Warn "$skipped row(s) missing Username or Address were skipped." }

# ===== Discovery =====
$missing = New-Object System.Collections.Generic.List[object]
Write-Info "===== Checking accounts exist (Username + Address) and building export for MISSING only ====="

foreach ($row in $valid) {
  $user = $row.Username
  $addr = $row.Address

  Write-Info ("Checking Username='{0}' Address='{1}' …" -f $user, $addr)
  $exists = Test-AccountExists -Username $user -Address $addr
  if (-not $exists) {
    $missing.Add([PSCustomObject]@{ Username = $user; Address = $addr })
    Write-Ok "  -> NOT FOUND. Queued for export."
  } else {
    Write-Info "  -> Found in CyberArk. OK."
  }
}

# ===== Write export (Username,Address) =====
Write-Info "===== Writing export (Username,Address) of NOT FOUND ====="
try {
  $dir = Split-Path -Path $OutputCsv -Parent
  if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
  $missing | Select-Object Username,Address | Export-Csv -Path $OutputCsv -NoTypeInformation -Encoding UTF8
  Write-Ok "Exported $($missing.Count) row(s) to: $OutputCsv"
} catch { Write-Err "Failed to export results: $($_.Exception.Message)" }

# ===== Cleanup =====
try { Close-PASSession | Out-Null; Write-Ok "Logged off." } catch { }
