$IdentityUser  = 'CA_PAMDiscovery_SVC'

# =========================
# General helpers
# =========================
function Test-CommandParameter {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$CommandName,

        [Parameter(Mandatory)]
        [string]$ParameterName
    )

    $command = Get-Command -Name $CommandName -ErrorAction Stop
    return $command.Parameters.ContainsKey($ParameterName)
}

function ConvertTo-FlatCollection {
    [CmdletBinding()]
    param(
        [Parameter(ValueFromPipeline = $true)]
        $InputObject,

        [string[]]$CollectionPropertyNames = @('value')
    )

    if ($null -eq $InputObject) {
        return @()
    }

    $items = @($InputObject)

    # Some cmdlet/API versions return a wrapper object containing value,
    # Accounts, or Safes. Other versions return the objects directly.
    if ($items.Count -eq 1 -and $null -ne $items[0]) {
        $single = $items[0]

        foreach ($propertyName in $CollectionPropertyNames) {
            $property = $single.PSObject.Properties[$propertyName]
            if ($property -and $null -ne $property.Value) {
                return @($property.Value)
            }
        }
    }

    return @($items)
}

function Get-ObjectPropertyValue {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        $InputObject,

        [Parameter(Mandatory)]
        [string[]]$PropertyNames
    )

    foreach ($propertyName in $PropertyNames) {
        $property = $InputObject.PSObject.Properties[$propertyName]
        if ($property -and $null -ne $property.Value) {
            return $property.Value
        }
    }

    return $null
}

function Convert-CyberArkDateTime {
    [CmdletBinding()]
    param(
        $Value,

        [string]$SafeName = '',

        [string]$FieldName = 'DateTime'
    )

    if ($null -eq $Value) {
        return $null
    }

    # Safe creation and modification values should not be in the distant
    # future. This also filters common API sentinel values such as Int64.MaxValue.
    $minimumReasonableUtc = [DateTime]::SpecifyKind(
        [DateTime]::ParseExact('1970-01-01', 'yyyy-MM-dd', [Globalization.CultureInfo]::InvariantCulture),
        [DateTimeKind]::Utc
    )
    $maximumReasonableUtc = (Get-Date).ToUniversalTime().AddDays(2)

    $testAndReturnLocal = {
        param([DateTime]$Candidate)

        $candidateUtc = if ($Candidate.Kind -eq [DateTimeKind]::Utc) {
            $Candidate
        }
        elseif ($Candidate.Kind -eq [DateTimeKind]::Local) {
            $Candidate.ToUniversalTime()
        }
        else {
            [DateTime]::SpecifyKind($Candidate, [DateTimeKind]::Utc)
        }

        if ($candidateUtc -lt $minimumReasonableUtc -or $candidateUtc -gt $maximumReasonableUtc) {
            return $null
        }

        return $candidateUtc.ToLocalTime()
    }

    try {
        if ($Value -is [DateTime]) {
            return (& $testAndReturnLocal ([DateTime]$Value))
        }

        if ($Value -is [DateTimeOffset]) {
            $dateTimeOffsetValue = [DateTimeOffset]$Value
            return (& $testAndReturnLocal $dateTimeOffsetValue.UtcDateTime)
        }

        $text = ([string]$Value).Trim()
        if ([string]::IsNullOrWhiteSpace($text)) {
            return $null
        }

        # Handle Microsoft JSON dates such as /Date(1774828800000)/.
        if ($text -match '^/Date\((?<number>-?\d+)(?:[+-]\d{4})?\)/$') {
            $text = $Matches['number']
        }

        [long]$numericValue = 0
        if ([long]::TryParse(
            $text,
            [Globalization.NumberStyles]::Integer,
            [Globalization.CultureInfo]::InvariantCulture,
            [ref]$numericValue
        )) {
            $absoluteValue = [math]::Abs([double]$numericValue)
            $candidateUtc = $null

            # CyberArk/psPAS responses can expose dates in different numeric
            # representations depending on API generation and module version.
            if ($absoluteValue -lt 100000000000) {
                # Unix seconds (normally 10 digits).
                $candidateUtc = $minimumReasonableUtc.AddSeconds([double]$numericValue)
            }
            elseif ($absoluteValue -lt 100000000000000) {
                # Unix milliseconds (normally 13 digits).
                $candidateUtc = $minimumReasonableUtc.AddMilliseconds([double]$numericValue)
            }
            elseif ($absoluteValue -lt 100000000000000000) {
                # Unix microseconds (normally 16 digits).
                $candidateUtc = $minimumReasonableUtc.AddMilliseconds(([double]$numericValue / 1000.0))
            }
            elseif ($absoluteValue -lt 500000000000000000) {
                # Windows FILETIME: 100-nanosecond intervals since 1601-01-01.
                $candidateUtc = [DateTime]::FromFileTimeUtc($numericValue)
            }
            elseif ($absoluteValue -lt 1000000000000000000) {
                # .NET ticks: 100-nanosecond intervals since 0001-01-01.
                $candidateUtc = [DateTime]::new($numericValue, [DateTimeKind]::Utc)
            }
            else {
                # Unix nanoseconds (normally 19 digits). Very large sentinel
                # values will be rejected by the reasonable-date validation.
                $candidateUtc = $minimumReasonableUtc.AddMilliseconds(([double]$numericValue / 1000000.0))
            }

            $converted = & $testAndReturnLocal $candidateUtc
            if ($null -ne $converted) {
                return $converted
            }

            Write-Log ("Ignored invalid or unreasonable {0} for Safe='{1}'. RawValue='{2}'." -f `
                $FieldName, $SafeName, $text) 'DarkYellow'
            return $null
        }

        [DateTimeOffset]$parsedOffset = [DateTimeOffset]::MinValue
        if ([DateTimeOffset]::TryParse(
            $text,
            [Globalization.CultureInfo]::InvariantCulture,
            [Globalization.DateTimeStyles]::AllowWhiteSpaces,
            [ref]$parsedOffset
        )) {
            $converted = & $testAndReturnLocal $parsedOffset.UtcDateTime
            if ($null -ne $converted) {
                return $converted
            }
        }

        [DateTime]$parsedDate = [DateTime]::MinValue
        if ([DateTime]::TryParse(
            $text,
            [Globalization.CultureInfo]::InvariantCulture,
            [Globalization.DateTimeStyles]::AllowWhiteSpaces,
            [ref]$parsedDate
        )) {
            $converted = & $testAndReturnLocal $parsedDate
            if ($null -ne $converted) {
                return $converted
            }
        }

        Write-Log ("Could not convert {0} for Safe='{1}'. RawValue='{2}'. The report will leave this date blank." -f `
            $FieldName, $SafeName, $text) 'DarkYellow'
        return $null
    }
    catch {
        # Date metadata is informational only. A malformed timestamp must never
        # prevent the empty-Safe inventory from being exported.
        Write-Log ("Date conversion warning for Safe='{0}', Field='{1}', RawValue='{2}': {3}. The report will leave this date blank." -f `
            $SafeName, $FieldName, ([string]$Value), $_.Exception.Message) 'DarkYellow'
        return $null
    }
}

# =========================
# Login helper: CCP -> Identity header -> psPAS
# =========================
function Start-PASSessionFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ObjectName,

        [Parameter(Mandatory)]
        [string]$UPUser
    )

    $encodedObject = [Uri]::EscapeDataString($ObjectName)
    $encodedAppId  = [Uri]::EscapeDataString($Application)
    $encodedSafe   = [Uri]::EscapeDataString($SafeCCP)
    $ccpUrl = "$CCPAddress/$Location/api/Accounts?AppID=$encodedAppId&Safe=$encodedSafe&Object=$encodedObject"

    Write-Log "Retrieving CCP credential for '$UPUser' through Object='$ObjectName'." 'Cyan'

    $response = Invoke-RestMethod `
        -Uri $ccpUrl `
        -Method Get `
        -Headers $Headers `
        -UseDefaultCredentials:$WindowsAuth `
        -ErrorAction Stop

    if (-not $response -or
        [string]::IsNullOrWhiteSpace([string]$response.Content) -or
        [string]::IsNullOrWhiteSpace([string]$response.Username)) {
        throw 'CCP response is missing Content or Username.'
    }

    Write-Log "CCP returned credential material for username '$($response.Username)'." 'Green'

    $securePassword = ConvertTo-SecureString -String ([string]$response.Content) -AsPlainText -Force
    $identityCredential = [System.Management.Automation.PSCredential]::new($UPUser, $securePassword)

    Write-Log "Requesting CyberArk Identity header for '$IdentityTenantURL' and Privilege Cloud subdomain '$PCloudSubdomain'." 'Cyan'

    $identityHeader = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $identityCredential `
        -ErrorAction Stop

    Use-PASSession $identityHeader

    if (-not (Get-PASSession)) {
        throw 'psPAS session was not established.'
    }

    # Remove the clear-text CCP secret from the response object as soon as login completes.
    try { $response.Content = $null } catch { }
    $identityCredential = $null
    $securePassword = $null

    Write-Log 'PAS session established successfully without an interactive prompt.' 'Green'
}

# =========================
# Safe retrieval
# =========================
function Get-AllVisibleSafes {
    [CmdletBinding()]
    param()

    $parameters = @{}

    # Avoid returning account arrays inside every Safe because the account
    # inventory is retrieved separately and counted once.
    if (Test-CommandParameter -CommandName 'Get-PASSafe' -ParameterName 'includeAccounts') {
        $parameters['includeAccounts'] = $false
    }

    if (Test-CommandParameter -CommandName 'Get-PASSafe' -ParameterName 'extendedDetails') {
        $parameters['extendedDetails'] = $true
    }

    Write-Log 'Calling Get-PASSafe once to retrieve all Safes visible to the session.' 'DarkCyan'

    $rawSafes = Get-PASSafe @parameters -ErrorAction Stop
    $safeObjects = @(ConvertTo-FlatCollection -InputObject $rawSafes -CollectionPropertyNames @('value', 'Safes'))

    $allSafes = New-Object System.Collections.ArrayList
    $seenSafeNames = @{}

    foreach ($safe in $safeObjects) {
        if ($null -eq $safe) { continue }

        $safeName = [string](Get-ObjectPropertyValue -InputObject $safe -PropertyNames @('SafeName', 'safeName', 'Name'))
        $safeName = $safeName.Trim()

        if ([string]::IsNullOrWhiteSpace($safeName)) {
            Write-Log 'Skipped a Safe response object because it did not contain SafeName.' 'DarkYellow'
            continue
        }

        if (-not $seenSafeNames.ContainsKey($safeName)) {
            $seenSafeNames[$safeName] = $true
            [void]$allSafes.Add($safe)
        }
    }

    return @($allSafes)
}

# =========================
# Account inventory retrieval and Safe counting
# =========================
function Get-VisibleAccountSafeCounts {
    [CmdletBinding()]
    param(
        [ValidateRange(1, 1000)]
        [int]$Limit = 500,

        [ValidateRange(1, 500000)]
        [int]$MaximumAccounts = 200000
    )

    $allAccounts = New-Object System.Collections.ArrayList
    $hasOffset = Test-CommandParameter -CommandName 'Get-PASAccount' -ParameterName 'offset'
    $hasLimit  = Test-CommandParameter -CommandName 'Get-PASAccount' -ParameterName 'limit'
    $pagingMode = 'SingleCallUnknown'

    if ($hasLimit -and -not $hasOffset) {
        # Current psPAS behavior: -limit controls the per-request page size,
        # and the cmdlet follows the API nextLink until all results are returned.
        $pagingMode = 'AutomaticNextLink'
        Write-Log "Calling Get-PASAccount -limit $Limit. psPAS will retrieve all result pages." 'DarkCyan'

        $rawAccounts = Get-PASAccount -limit $Limit -ErrorAction Stop
        $accountObjects = @(ConvertTo-FlatCollection -InputObject $rawAccounts -CollectionPropertyNames @('value', 'Accounts'))

        foreach ($account in $accountObjects) {
            [void]$allAccounts.Add($account)
        }
    }
    elseif ($hasLimit -and $hasOffset) {
        # Compatibility path for older psPAS builds that expose explicit offset.
        $pagingMode = 'ManualOffset'
        $offset = 0

        do {
            Write-Log "Retrieving account inventory page at offset=$offset, limit=$Limit." 'DarkCyan'

            $rawPage = Get-PASAccount -limit $Limit -offset $offset -ErrorAction Stop
            $page = @(ConvertTo-FlatCollection -InputObject $rawPage -CollectionPropertyNames @('value', 'Accounts'))

            if ($page.Count -eq 0) {
                break
            }

            foreach ($account in $page) {
                [void]$allAccounts.Add($account)
            }

            Write-Log "Account page returned $($page.Count) object(s); raw account objects collected=$($allAccounts.Count)." 'DarkGray'

            if ($allAccounts.Count -gt $MaximumAccounts) {
                throw "Raw account inventory exceeded MaxAccountsToInspect=$MaximumAccounts. Increase -MaxAccountsToInspect and run again."
            }

            if ($page.Count -lt $Limit) {
                break
            }

            $offset += $Limit
        }
        while ($true)
    }
    else {
        Write-Log 'Get-PASAccount does not expose -limit. Calling it once using the module default behavior.' 'DarkYellow'

        $rawAccounts = Get-PASAccount -ErrorAction Stop
        $accountObjects = @(ConvertTo-FlatCollection -InputObject $rawAccounts -CollectionPropertyNames @('value', 'Accounts'))

        foreach ($account in $accountObjects) {
            [void]$allAccounts.Add($account)
        }
    }

    Write-Log "Raw account objects returned by Get-PASAccount: $($allAccounts.Count)." 'DarkGray'

    $safeCounts = @{}
    $seenAccountIds = @{}
    $totalUniqueAccounts = 0
    $missingSafeNameCount = 0

    foreach ($account in $allAccounts) {
        if ($null -eq $account) { continue }

        $accountId = [string](Get-ObjectPropertyValue -InputObject $account -PropertyNames @('id', 'ID', 'AccountID'))
        $safeName  = [string](Get-ObjectPropertyValue -InputObject $account -PropertyNames @('safeName', 'SafeName'))

        $accountId = $accountId.Trim()
        $safeName  = $safeName.Trim()

        # Use AccountID when present to guard against duplicate objects.
        # If no AccountID is returned, build a stable fallback key for this run.
        if ([string]::IsNullOrWhiteSpace($accountId)) {
            $accountName = [string](Get-ObjectPropertyValue -InputObject $account -PropertyNames @('name', 'Name'))
            $userName    = [string](Get-ObjectPropertyValue -InputObject $account -PropertyNames @('userName', 'UserName', 'username'))
            $address     = [string](Get-ObjectPropertyValue -InputObject $account -PropertyNames @('address', 'Address'))
            $accountId   = "NOID|$safeName|$accountName|$userName|$address"
        }

        if ($seenAccountIds.ContainsKey($accountId)) {
            continue
        }

        $seenAccountIds[$accountId] = $true
        $totalUniqueAccounts++

        if ($totalUniqueAccounts -gt $MaximumAccounts) {
            throw "Account inventory exceeded MaxAccountsToInspect=$MaximumAccounts. Increase -MaxAccountsToInspect and run again. No empty-Safe report was produced because an incomplete account inventory could create false results."
        }

        if ([string]::IsNullOrWhiteSpace($safeName)) {
            $missingSafeNameCount++
            continue
        }

        if ($safeCounts.ContainsKey($safeName)) {
            $safeCounts[$safeName] = [int]$safeCounts[$safeName] + 1
        }
        else {
            $safeCounts[$safeName] = 1
        }
    }

    return [PSCustomObject]@{
        SafeCounts           = $safeCounts
        TotalUniqueAccounts  = $totalUniqueAccounts
        MissingSafeNameCount = $missingSafeNameCount
        PagingMode           = $pagingMode
    }
}

# =========================
# Build report row
# =========================
function New-EmptySafeReportRow {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        $Safe
    )

    $safeName = [string](Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('SafeName', 'safeName', 'Name'))
    $creationRaw = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('CreationTime', 'creationTime', 'CreatedTime')
    $modifiedRaw = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('LastModificationTime', 'lastModificationTime', 'LastModifiedTime')

    $createdOn = Convert-CyberArkDateTime -Value $creationRaw -SafeName $safeName -FieldName 'CreationTime'
    $lastModifiedOn = Convert-CyberArkDateTime -Value $modifiedRaw -SafeName $safeName -FieldName 'LastModificationTime'

    $daysSinceLastModified = $null
    if ($null -ne $lastModifiedOn) {
        $daysSinceLastModified = [math]::Floor(((Get-Date) - $lastModifiedOn).TotalDays)
        if ($daysSinceLastModified -lt 0) {
            $daysSinceLastModified = 0
        }
    }

    return [PSCustomObject][ordered]@{
        SafeName                  = $safeName.Trim()
        VisibleAccountCount       = 0
        Status                    = 'EMPTY - No visible accounts assigned'
        Description               = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('Description', 'description')
        ManagingCPM               = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('ManagingCPM', 'managingCPM')
        Location                  = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('Location', 'location')
        CreatedOn                 = if ($null -ne $createdOn) { $createdOn.ToString('yyyy-MM-dd HH:mm:ss') } else { $null }
        LastModifiedOn            = if ($null -ne $lastModifiedOn) { $lastModifiedOn.ToString('yyyy-MM-dd HH:mm:ss') } else { $null }
        DaysSinceLastModified     = $daysSinceLastModified
        NumberOfDaysRetention     = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('NumberOfDaysRetention', 'numberOfDaysRetention')
        NumberOfVersionsRetention = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('NumberOfVersionsRetention', 'numberOfVersionsRetention')
        AutoPurgeEnabled          = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('AutoPurgeEnabled', 'autoPurgeEnabled')
        OLACEnabled               = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('OLACEnabled', 'olacEnabled')
        ExpiredMembership         = Get-ObjectPropertyValue -InputObject $Safe -PropertyNames @('isExpiredMember', 'IsExpiredMember')
    }
}

# =========================
# Main
# =========================
try {
    Write-Log '============================================================' 'Cyan'
    Write-Log 'Dormant/empty CyberArk Safe report starting.' 'Cyan'
    Write-Log "Safe name filter       : $SafeNameLike" 'White'
    Write-Log "Excluded name regex    : $(if ([string]::IsNullOrWhiteSpace($ExcludeSafeNameRegex)) { '<none>' } else { $ExcludeSafeNameRegex })" 'White'
    Write-Log "Page size              : $PageSize" 'White'
    Write-Log "Maximum account count  : $MaxAccountsToInspect" 'White'
    Write-Log "CSV output             : $CsvFile" 'White'
    Write-Log "Log output             : $LogFile" 'White'

    Start-PASSessionFromCCP -ObjectName $CCPObjectName -UPUser $IdentityUser

    Write-Log 'Retrieving all visible Safes.' 'Yellow'
    $allSafes = @(Get-AllVisibleSafes)

    if ($allSafes.Count -eq 0) {
        throw 'No Safes were returned. Confirm the API identity has permission to list Safes.'
    }

    Write-Log "Visible unique Safes retrieved: $($allSafes.Count)." 'Green'

    Write-Log 'Retrieving the visible account inventory once and counting accounts by Safe.' 'Yellow'
    $accountInventory = Get-VisibleAccountSafeCounts -Limit $PageSize -MaximumAccounts $MaxAccountsToInspect

    Write-Log "Visible unique accounts retrieved: $($accountInventory.TotalUniqueAccounts)." 'Green'
    Write-Log "Safes represented in account inventory: $($accountInventory.SafeCounts.Count)." 'Green'

    if ($accountInventory.MissingSafeNameCount -gt 0) {
        Write-Log "$($accountInventory.MissingSafeNameCount) account object(s) did not contain SafeName and could not be mapped." 'DarkYellow'
    }

    Write-Log "Account retrieval mode: $($accountInventory.PagingMode)." 'DarkGray'

    if ($accountInventory.PagingMode -eq 'SingleCallUnknown') {
        Write-Log 'WARNING: Get-PASAccount did not expose -limit or -offset. Confirm the installed psPAS version returns the complete inventory in one call.' 'Yellow'
    }

    $results = New-Object System.Collections.ArrayList
    $filteredSafeCount = 0

    foreach ($safe in $allSafes) {
        $safeName = [string](Get-ObjectPropertyValue -InputObject $safe -PropertyNames @('SafeName', 'safeName', 'Name'))
        $safeName = $safeName.Trim()

        if ([string]::IsNullOrWhiteSpace($safeName)) {
            continue
        }

        if ($safeName -notlike $SafeNameLike) {
            continue
        }

        if (-not [string]::IsNullOrWhiteSpace($ExcludeSafeNameRegex) -and $safeName -match $ExcludeSafeNameRegex) {
            continue
        }

        $filteredSafeCount++

        if ($accountInventory.SafeCounts.ContainsKey($safeName)) {
            continue
        }

        $row = New-EmptySafeReportRow -Safe $safe
        [void]$results.Add($row)
        Write-Log "EMPTY SAFE: $safeName" 'Green'
    }

    Write-Log "Safes evaluated after name filters: $filteredSafeCount." 'Yellow'
    Write-Log "Safes with zero visible accounts: $($results.Count)." 'Yellow'

    $columnNames = @(
        'SafeName',
        'VisibleAccountCount',
        'Status',
        'Description',
        'ManagingCPM',
        'Location',
        'CreatedOn',
        'LastModifiedOn',
        'DaysSinceLastModified',
        'NumberOfDaysRetention',
        'NumberOfVersionsRetention',
        'AutoPurgeEnabled',
        'OLACEnabled',
        'ExpiredMembership'
    )

    if ($results.Count -gt 0) {
        $results |
            Sort-Object SafeName |
            Select-Object $columnNames |
            Export-Csv -LiteralPath $CsvFile -NoTypeInformation -Encoding UTF8

        Write-Log "Exported $($results.Count) empty Safe(s) to: $CsvFile" 'Green'
    }
    else {
        # Create a header-only CSV when no empty Safes are found.
        Set-Content -LiteralPath $CsvFile -Value ($columnNames -join ',') -Encoding UTF8
        Write-Log "No empty Safes were found. A header-only CSV was created at: $CsvFile" 'Green'
    }

    Write-Log 'Important: "empty" means no account was visible to this API identity for the Safe.' 'DarkYellow'
}
catch {
    Write-Log "FATAL: $($_.Exception.Message)" 'Red'
    throw
}
finally {
    try {
        if (Get-PASSession -ErrorAction SilentlyContinue) {
            Close-PASSession | Out-Null
            Write-Log 'Logged off from Privilege Cloud.' 'Green'
        }
    }
    catch {
        Write-Log "Logoff warning: $($_.Exception.Message)" 'DarkYellow'
    }

    Write-Log 'Dormant/empty CyberArk Safe report finished.' 'Cyan'
    Write-Log '============================================================' 'Cyan'
}
