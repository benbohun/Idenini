Prompt

#This plugin has been automatically generated by PGU. Version 1.0.0.0
[Conditions]
# General / connection
TRUE=(expression)true
UnableToConnect=FATAL ERROR:|Unable to open connection:|Could not open connection to the host
PlinkStoreKey=Store key in cache

# Login flow
Login=login as:|login:|Username:
Password=Password:
InvalidLogin=Login invalid|Authentication failed|Access denied|Login incorrect|You entered an invalid login name or passwd
NotAllowedLogin=Wrong time period .*|You are not allowed to login at this time.|Remote logins are not allowed for this account.
AccountDisabled=Account is disabled .*|account has been locked

# Prompts (Sonoma often shows '->' / standard shells show $, #, >)
StandardPrompt=.*\$ ?$|.*\# ?$|.*\> ?$|.*\% ?$|.*\] ?$|.*\$\u001b\[.*m ?$|.*\> ?\u001b\[.*m ?$|.*->\s*$

# Action gates
ActionIsVerify=(expression)[string equal -nocase "<action>" verifypass]
ActionIsLogon=(expression)[string equal -nocase "<action>" logon]
ActionIsChange=(expression)[string equal -nocase "<action>" changepass]
ActionIsRecOrPreRec=(expression)[string equal -nocase "<action>" "reconcilepass"]||[string equal -nocase "<action>" "prereconcilepass"]
ActionIsNotRecOrPreRec=(expression)!([string equal -nocase "<action>" "reconcilepass"]&&[string equal -nocase "<action>" "prereconcilepass"])

# Protocol/port branching (so Protocol isn't mandatory)
ProtocolIsSSH=(expression)[string equal -nocase "<protocol>" "ssh"]
ProtocolIsTelnet=(expression)[string equal -nocase "<protocol>" "telnet"]
ProtocolIsEmpty=(expression)[string equal -nocase "<protocol>" ""]
PortIsSet=(expression)![string equal -nocase "<port>" ""]
PortNotSet=(expression)[string equal -nocase "<port>" ""]

# passwd interaction (Linux on Sonoma)
PasswdCurrentPrompt=(?i)^.*current\s+password.*:$
PasswdNewPrompt=(?i)^.*new\s+password.*:$
PasswdRetypePrompt=(?i)^.*(retype|confirm)\s+new\s+password.*:$
PasswdSuccess=(?i)password\s+updated\s+successfully|authentication\s+tokens?\s+updated\s+successfully
PasswdMismatch=(?i)sorry,\s*passwords?\s*do\s*not\s*match
PasswdRejected=(?i)bad\s+password|too\s+short|not\s+enough\s+different\s+characters|based\s+on\s+dictionary\s+word
PasswdAuthError=(?i)authentication\s+token\s+manipulation\s+error|passwd:\s*failure
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


Process


#This plugin has been automatically generated by PGU. Version 1.0.0.0
[states]
# Initialize and use the target account directly (no Logon/Linked account)
Init=(script)set verifyLogon 1; set username "<username>"; set curr_pass "<pmpass>"

# Protocol selection with safe defaults (Protocol optional)
CheckProtocol=
StartSSH_WithPort=(spawn)plink.exe <address> -ssh -P <port>
StartSSH_NoPort=(spawn)plink.exe <address> -ssh
StartTelnet=(spawn)telnet <address> <port>
StoreKeyInCache=y

# Login
LoginUser=$username
SendPassword=$curr_pass

# Route by action
CheckAction=

# ----- Change password via Linux 'passwd' -----
ChangeStep1=passwd
# If non-root, passwd asks for current password first; handle both paths
ChangeStepCur=<pmpass>
ChangeStep2=<pmnewpass>
ChangeStep3=<pmnewpass>

FinalStep=
END=

# Fail states
FAILNotSupported=FAIL(Change action is not supported, 8001)
FAILNotSupported3=FAIL(Reconcile action is not supported, 8003)
FAILUnableToConnect=FAIL(First login - Unable to connect to machine. Check machine address and port, 8000)
FAILNotAllowedLogin1=FAIL(User is not allowed to log in, 8012)
FAILTARGETInvalidUsernameOrPassword=FAIL(Invalid username or bad password, 2114)
FAILAccountDisabled1=FAIL(First login - User account is disabled, 8010)
FAILInvalidNewPassword=FAIL(Invalid new password rejected by device policy, 8004)
FAILPassMismatch=FAIL(New password entries did not match, 8005)
FAILPasswdAuthError=FAIL(Device error while updating password (auth token error), 8007)

[transitions]
# Protocol branch
Init,TRUE,CheckProtocol
CheckProtocol,ProtocolIsSSH,StartSSH_WithPort
CheckProtocol,ProtocolIsTelnet,StartTelnet
CheckProtocol,ProtocolIsEmpty,StartSSH_WithPort
StartSSH_WithPort,PortNotSet,StartSSH_NoPort

# Session start + login
StartSSH_WithPort,UnableToConnect,FAILUnableToConnect
StartSSH_WithPort,PlinkStoreKey,StoreKeyInCache
StartSSH_WithPort,Login,LoginUser
StartSSH_NoPort,UnableToConnect,FAILUnableToConnect
StartSSH_NoPort,PlinkStoreKey,StoreKeyInCache
StartSSH_NoPort,Login,LoginUser
StartTelnet,UnableToConnect,FAILUnableToConnect
StartTelnet,Login,LoginUser
StoreKeyInCache,Login,LoginUser

LoginUser,Password,SendPassword
SendPassword,InvalidLogin,FAILTARGETInvalidUsernameOrPassword
SendPassword,AccountDisabled,FAILAccountDisabled1
SendPassword,NotAllowedLogin,FAILNotAllowedLogin1
SendPassword,StandardPrompt,CheckAction

# Action routing
CheckAction,ActionIsVerify,END
CheckAction,ActionIsLogon,END
CheckAction,ActionIsRecOrPreRec,FAILNotSupported3
CheckAction,ActionIsChange,ChangeStep1

# Password change (handles both non-root and root flows)
ChangeStep1,PasswdCurrentPrompt,ChangeStepCur
ChangeStep1,PasswdNewPrompt,ChangeStep2

ChangeStepCur,PasswdNewPrompt,ChangeStep2
ChangeStepCur,PasswdAuthError,FAILPasswdAuthError

ChangeStep2,PasswdRetypePrompt,ChangeStep3
ChangeStep2,PasswdRejected,FAILInvalidNewPassword

ChangeStep3,PasswdMismatch,FAILPassMismatch
ChangeStep3,PasswdAuthError,FAILPasswdAuthError
# Success message or silent return to shell prompt
ChangeStep3,PasswdSuccess,FinalStep
ChangeStep3,StandardPrompt,FinalStep

FinalStep,TRUE,END

[CPM Parameters Validation]
# Minimal base only (no Protocol/Port mandatory; provided by platform policy if set)
username, source=FILE, Mandatory=yes
address,  source=FILE, Mandatory=yes

[Parameters]
PromptTimeout=45
SendHuman=.1 .3 1 .05 2

[Debug Information]
DebugLogFullParsingInfo=no
DebugLogFullExecutionInfo=no
DebugLogDetailBuiltInActions=no
ExpectLog=yes
ConsoleOutput=no
