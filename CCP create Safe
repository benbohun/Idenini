<#
CNA_Safes_Missing_CA_PCloud_Admins.ps1

- CNA Login (CCP -> Get-IdentityHeader -psPASFormat -> Use-PASSession)
- Export ALL safes that do NOT have member: CA_PCloud_Admins@cna.com

Outputs:
  E:\Installation Media\Script\OnboardScript\data\CNA_Safes_Missing_CA_PCloud_Admins.csv
  E:\Installation Media\Script\OnboardScript\data\CNA_Safes_Missing_CA_PCloud_Admins.log

Reliability upgrades:
- CCP query params are URL-encoded (prevents 400)
- Safe paging & member calls include retry/backoff for transient 500/503/429
- Adds throttling delay between calls
- Logs which offset/page failed (helps you tune SafePageSize or resume)
#>

[CmdletBinding()]
param(
    # Paging for safes
    [ValidateRange(1,5000)]
    [int]$SafePageSize = 100,

    [ValidateRange(1,200000)]
    [int]$MaxSafesToInspect = 50000,

    # If you want to resume from a known offset after a failure:
    [ValidateRange(0,2000000)]
    [int]$StartOffset = 0,

    # Match strictness for member name
    [ValidateSet('All','Fast','Strict')]
    [string]$MatchMode = 'All',

    # Retry / throttling
    [ValidateRange(0,5000)]
    [int]$DelayMsBetweenCalls = 200,

    [ValidateRange(1,20)]
    [int]$MaxRetries = 6,

    [ValidateRange(1,60)]
    [int]$RetryBaseDelaySec = 3,

    # Output folder
    [string]$OutDir = "E:\Installation Media\Script\OnboardScript\data",

    # ===== CNA Identity / Privilege Cloud =====
    [string]$IdentityTenantURL  = "https://aat4012.id.cyberark.cloud",
    [string]$PCloudSubdomain    = "cna-prod",
    [string]$PrivilegeCloudURL  = "https://cna-prod.privilegecloud.cyberark.cloud",

    # ===== CCP settings (CNA) =====
    # Use the CCP host that worked for you:
    [string]$CCPAddress      = "https://vskau1p1231.cna.com",
    [string]$CCPLocation     = "AIMWebService",
    [string]$CCPAppID        = "PAMDiscovery",
    [string]$CCPSafe         = "CA_PCloud_Admins",

    # Your environment returned creds with this object value in the URL:
    [string]$CCPObject       = "cna-prod.cyberark.cloud-cnarestbot",

    [bool]  $CCPWindowsAuth  = $false,

    # ===== Target member to check =====
    [string]$RequiredMember  = "CA_PCloud_Admins@cna.com"
)

# =========================
# Baseline
# =========================
Import-Module psPAS -Force -ErrorAction Stop
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

# =========================
# Output paths
# =========================
if (-not (Test-Path $OutDir)) { New-Item -ItemType Directory -Path $OutDir -Force | Out-Null }

$LogFile = Join-Path $OutDir "CNA_Safes_Missing_CA_PCloud_Admins.log"
$CsvFile = Join-Path $OutDir "CNA_Safes_Missing_CA_PCloud_Admins.csv"
New-Item -ItemType File -Force -Path $LogFile | Out-Null

function Write-Log {
    param([string]$Message, [ConsoleColor]$Color = 'White')
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "$ts - $Message"
    Write-Host $line -ForegroundColor $Color
    Add-Content -Path $LogFile -Value $line
}

function Get-WebExceptionStatusCode {
    param([System.Exception]$Exception)
    try {
        $we = $Exception
        if ($we -isnot [System.Net.WebException]) { $we = $Exception.InnerException }
        if ($we -and $we.Response -and $we.Response.StatusCode) { return [int]$we.Response.StatusCode }
    } catch {}
    return $null
}

function Get-WebExceptionBody {
    param([System.Exception]$Exception)
    try {
        $we = $Exception
        if ($we -isnot [System.Net.WebException]) { $we = $Exception.InnerException }
        if (-not $we -or -not $we.Response) { return $null }
        $stream = $we.Response.GetResponseStream()
        if (-not $stream) { return $null }
        $reader = New-Object System.IO.StreamReader($stream)
        $text = $reader.ReadToEnd()
        $reader.Close()
        return $text
    } catch {
        return $null
    }
}

# =========================
# CCP fetch (URL-encoded)
# =========================
function Get-ServiceUserCredentialFromCCP {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$CCPAddress,
        [Parameter(Mandatory)][string]$Location,
        [Parameter(Mandatory)][string]$AppID,
        [Parameter(Mandatory)][string]$Safe,
        [Parameter(Mandatory)][string]$Object,
        [bool]$WindowsAuth = $false
    )

    $base = $CCPAddress.TrimEnd('/')
    $loc  = $Location.Trim('/')

    $encApp  = [uri]::EscapeDataString($AppID)
    $encSafe = [uri]::EscapeDataString($Safe)
    $encObj  = [uri]::EscapeDataString($Object)

    $url  = "{0}/{1}/api/Accounts?AppID={2}&Safe={3}&Object={4}" -f $base, $loc, $encApp, $encSafe, $encObj

    Write-Log "Retrieving CCP credential via Object..." 'Cyan'
    Write-Log ("CCP URL (encoded): {0}" -f $url) 'DarkGray'

    $headers = @{ 'Content-Type' = 'application/json' }

    try {
        $resp = Invoke-RestMethod -Uri $url -Method GET -Headers $headers -UseDefaultCredentials:$WindowsAuth -ErrorAction Stop
    } catch {
        $body = Get-WebExceptionBody -Exception $_.Exception
        if ($body) { Write-Log ("CCP Error Body: {0}" -f $body) 'Yellow' }
        throw
    }

    if (-not $resp -or -not $resp.Content) { throw "Empty CCP response or missing Content." }
    if (-not $resp.UserName -and -not $resp.Username) { throw "CCP response missing UserName/Username." }

    $uname = if ($resp.UserName) { $resp.UserName } else { $resp.Username }
    Write-Log ("CCP returned username: {0}" -f $uname) 'Green'

    $sec = ConvertTo-SecureString -String $resp.Content -AsPlainText -Force
    return [PSCredential]::new($uname, $sec)
}

# =========================
# CNA login: Identity header -> Use-PASSession
# =========================
function Start-PASSessionFromCCP {
    $upCred = Get-ServiceUserCredentialFromCCP `
        -CCPAddress  $CCPAddress `
        -Location    $CCPLocation `
        -AppID       $CCPAppID `
        -Safe        $CCPSafe `
        -Object      $CCPObject `
        -WindowsAuth $CCPWindowsAuth

    Write-Log ("Requesting Identity header for tenant '{0}' (subdomain '{1}')..." -f $IdentityTenantURL, $PCloudSubdomain) 'Cyan'

    $hdr = Get-IdentityHeader `
        -IdentityTenantURL $IdentityTenantURL `
        -psPASFormat `
        -PCloudSubdomain $PCloudSubdomain `
        -UPCreds $upCred

    Use-PASSession $hdr
    if (-not (Get-PASSession)) { throw "psPAS session not established." }

    Write-Log ("PAS session established via Identity header as {0}" -f $upCred.UserName) 'Green'
}

# =========================
# Session transport helpers
# =========================
function Get-PVWABase {
    $sess = Get-PASSession
    if (-not $sess) { throw "No PAS session found." }

    $base = $null
    foreach ($p in @('BaseURI','BaseUrl','PVWAURL','Url','URI')) {
        if ($sess.PSObject.Properties[$p]) {
            $base = [string]$sess.$p
            if (-not [string]::IsNullOrWhiteSpace($base)) { break }
        }
    }

    if ([string]::IsNullOrWhiteSpace($base)) {
        $base = ($PrivilegeCloudURL.TrimEnd('/') + "/PasswordVault")
    }

    if ($base -notmatch '(?i)/PasswordVault(/|$)') {
        $base = $base.TrimEnd('/') + "/PasswordVault"
    }

    return $base.TrimEnd('/')
}

function Get-SessionTransport {
    $sess = Get-PASSession
    if (-not $sess) { throw "No PAS session found." }

    $headers = @{ 'Content-Type' = 'application/json' }
    if ($sess.PSObject.Properties['Headers'] -and $sess.Headers) {
        foreach ($k in $sess.Headers.Keys) { $headers[$k] = $sess.Headers[$k] }
    }

    $token = $null
    foreach ($p in @('Token','token','Authorization','AuthToken')) {
        if ($sess.PSObject.Properties[$p]) {
            $token = [string]$sess.$p
            if (-not [string]::IsNullOrWhiteSpace($token)) { break }
        }
    }
    if ($token -and -not $headers.ContainsKey('Authorization')) { $headers['Authorization'] = $token }

    $webSession = $null
    foreach ($p in @('WebSession','webSession')) {
        if ($sess.PSObject.Properties[$p]) {
            $webSession = $sess.$p
            if ($webSession) { break }
        }
    }

    return [PSCustomObject]@{
        Headers    = $headers
        WebSession = $webSession
    }
}

function Invoke-PVWAGet {
    param([Parameter(Mandatory)][string]$FullUri)

    $t = Get-SessionTransport
    if ($t.WebSession) {
        return Invoke-RestMethod -Uri $FullUri -Method GET -Headers $t.Headers -WebSession $t.WebSession -ErrorAction Stop
    }
    return Invoke-RestMethod -Uri $FullUri -Method GET -Headers $t.Headers -ErrorAction Stop
}

function Invoke-PVWAGetWithRetry {
    param(
        [Parameter(Mandatory)][string]$FullUri,
        [Parameter(Mandatory)][string]$Purpose,
        [switch]$ReturnNullOnFailure
    )

    $lastErr = $null

    for ($attempt = 1; $attempt -le $MaxRetries; $attempt++) {
        try {
            $resp = Invoke-PVWAGet -FullUri $FullUri
            if ($DelayMsBetweenCalls -gt 0) { Start-Sleep -Milliseconds $DelayMsBetweenCalls }
            return $resp
        } catch {
            $lastErr = $_.Exception
            $code = Get-WebExceptionStatusCode -Exception $lastErr
            $body = Get-WebExceptionBody -Exception $lastErr

            $msg = if ($code) { "HTTP $code" } else { "HTTP <unknown>" }
            Write-Log ("{0} failed (attempt {1}/{2}) - {3} - {4}" -f $Purpose, $attempt, $MaxRetries, $msg, $lastErr.Message) 'Yellow'
            if ($body) {
                $trimBody = $body
                if ($trimBody.Length -gt 400) { $trimBody = $trimBody.Substring(0,400) + "..." }
                Write-Log ("{0} error body (trimmed): {1}" -f $Purpose, $trimBody) 'DarkYellow'
            }

            # Retry only on transient server/rate issues
            if ($code -in 429,500,502,503,504 -or -not $code) {
                $sleep = [Math]::Min(60, ($RetryBaseDelaySec * $attempt))
                Start-Sleep -Seconds $sleep
                continue
            }

            break
        }
    }

    if ($ReturnNullOnFailure) { return $null }
    throw ("{0} failed after {1} attempts. Last error: {2}" -f $Purpose, $MaxRetries, $lastErr.Message)
}

# =========================
# Safe listing (paged): /api/Safes?limit=&offset=
# =========================
function Get-AllSafesPaged {
    [CmdletBinding()]
    param(
        [int]$Limit = 100,
        [int]$Max   = 50000,
        [int]$Start = 0
    )

    $base = Get-PVWABase
    $offset = $Start
    $all = New-Object System.Collections.Generic.List[object]

    while ($true) {
        $uri = "{0}/api/Safes?limit={1}&offset={2}" -f $base, $Limit, $offset
        Write-Log ("Listing safes (limit={0}, offset={1})" -f $Limit, $offset) 'DarkGray'

        $resp = Invoke-PVWAGetWithRetry -FullUri $uri -Purpose ("ListSafes offset={0}" -f $offset)

        $items = @()
        if ($resp.value) { $items = @($resp.value) }
        elseif ($resp.safes) { $items = @($resp.safes) }
        elseif ($resp -is [array]) { $items = @($resp) }

        if ($items.Count -eq 0) { break }

        foreach ($s in $items) { $all.Add($s) | Out-Null }

        if ($all.Count -ge $Max) { break }
        if ($items.Count -lt $Limit) { break }

        $offset += $Limit
    }

    return @($all)
}

# =========================
# Members check: /api/Safes/{safeName}/Members
# =========================
function Safe-HasMember {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$SafeName,
        [Parameter(Mandatory)][string]$MemberToFind
    )

    $base = Get-PVWABase
    $safeEsc = [uri]::EscapeDataString($SafeName)
    $uri = "{0}/api/Safes/{1}/Members" -f $base, $safeEsc

    $resp = Invoke-PVWAGetWithRetry -FullUri $uri -Purpose ("Members safe={0}" -f $SafeName) -ReturnNullOnFailure
    if (-not $resp) { throw "Members call failed (after retries)." }

    $members = @()
    if ($resp.value) { $members = @($resp.value) }
    elseif ($resp.members) { $members = @($resp.members) }
    elseif ($resp -is [array]) { $members = @($resp) }

    if ($members.Count -eq 0) { return $false }

    $needle = $MemberToFind.Trim()

    foreach ($m in $members) {
        $cands = @()

        foreach ($p in @('memberName','MemberName','userName','UserName','name','Name')) {
            if ($m.PSObject.Properties[$p] -and $m.$p) { $cands += [string]$m.$p }
        }
        if ($m.PSObject.Properties['member'] -and $m.member) {
            foreach ($p in @('memberName','MemberName','userName','UserName','name','Name')) {
                if ($m.member.PSObject.Properties[$p] -and $m.member.$p) { $cands += [string]$m.member.$p }
            }
        }

        foreach ($c in $cands) {
            if ([string]::IsNullOrWhiteSpace($c)) { continue }
            $c1 = $c.Trim()

            if ($MatchMode -eq 'Strict') {
                if ($c1 -ieq $needle) { return $true }
            }
            elseif ($MatchMode -eq 'Fast') {
                if ($c1 -ieq $needle) { return $true }
                if ($c1.Split('@')[0] -ieq $needle.Split('@')[0]) { return $true }
            }
            else {
                if ($c1 -ieq $needle) { return $true }
                if ($c1 -like "*$needle*") { return $true }
                if ($c1.Split('@')[0] -ieq $needle.Split('@')[0]) { return $true }
            }
        }
    }

    return $false
}

# =========================
# MAIN
# =========================
$sessionCreated = $false

try {
    Start-PASSessionFromCCP
    $sessionCreated = $true

    Write-Log ("Scanning all safes for missing member: {0}" -f $RequiredMember) 'Yellow'
    Write-Log ("SafePageSize={0} StartOffset={1} MaxSafesToInspect={2} MatchMode={3}" -f $SafePageSize, $StartOffset, $MaxSafesToInspect, $MatchMode) 'DarkYellow'
    Write-Log ("Retries={0} RetryBaseDelaySec={1} DelayMsBetweenCalls={2}" -f $MaxRetries, $RetryBaseDelaySec, $DelayMsBetweenCalls) 'DarkYellow'

    $safes = @(Get-AllSafesPaged -Limit $SafePageSize -Max $MaxSafesToInspect -Start $StartOffset)
    Write-Log ("Total safes retrieved: {0}" -f $safes.Count) 'Green'

    $missing = New-Object System.Collections.Generic.List[object]
    $checked = 0
    $failedMemberCalls = 0

    foreach ($s in $safes) {
        $checked++
        if ($checked % 200 -eq 0) {
            Write-Log ("Progress: checked {0}/{1}. Missing={2} MemberFailures={3}" -f $checked, $safes.Count, $missing.Count, $failedMemberCalls) 'DarkGray'
        }

        $safeName = $null
        foreach ($p in @('safeName','SafeName','name','Name')) {
            if ($s.PSObject.Properties[$p] -and $s.$p) { $safeName = [string]$s.$p; break }
        }
        if ([string]::IsNullOrWhiteSpace($safeName)) { continue }

        try {
            $has = Safe-HasMember -SafeName $safeName -MemberToFind $RequiredMember
            if (-not $has) {
                $missing.Add([pscustomobject]@{ SafeName = $safeName }) | Out-Null
            }
        } catch {
            $failedMemberCalls++
            Write-Log ("Member check failed for Safe='{0}': {1}" -f $safeName, $_.Exception.Message) 'Yellow'
            continue
        }
    }

    if ($missing.Count -gt 0) {
        $missing | Sort-Object SafeName | Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8
        Write-Log ("✅ Exported {0} safe(s) missing '{1}' to: {2}" -f $missing.Count, $RequiredMember, $CsvFile) 'Green'
    } else {
        @([pscustomobject]@{ SafeName = "" }) | Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8
        Write-Log ("No safes missing '{0}' were found. Exported empty CSV: {1}" -f $RequiredMember, $CsvFile) 'Green'
    }

} catch {
    $body = Get-WebExceptionBody -Exception $_.Exception
    if ($body) {
        $trimBody = $body
        if ($trimBody.Length -gt 400) { $trimBody = $trimBody.Substring(0,400) + "..." }
        Write-Log ("HTTP Error Body (trimmed): {0}" -f $trimBody) 'Yellow'
    }
    Write-Log ("ERROR: {0}" -f $_.Exception.Message) 'Red'
} finally {
    if ($sessionCreated) {
        try { Close-PASSession | Out-Null } catch {}
        Write-Log "Logged off." 'Green'
    }
    Write-Log "Done." 'Green'
}
