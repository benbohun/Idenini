2) Create the systemd unit
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
Path: /etc/systemd/system/psm1858-monitor.service

sudo tee /etc/systemd/system/psm1858-monitor.service >/dev/null <<'EOF'
[Unit]
Description=PSM 1858 Connectivity Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/psm1858-monitor/psm1858-monitor.sh
Restart=always
RestartSec=5
User=root
# Optional hardening:
# NoNewPrivileges=true
# ProtectSystem=full
# ProtectHome=true

[Install]
WantedBy=multi-user.target
EOF

::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

3) Enable and start the service
sudo systemctl daemon-reload
sudo systemctl enable --now psm1858-monitor.service
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
4) Verify it’s running
systemctl status psm1858-monitor.service
journalctl -u psm1858-monitor.service -f
