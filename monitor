# Create folder and set execution policy if needed
New-Item -ItemType Directory -Path C:\Scripts -Force | Out-Null

# (Optional) Unblock the script if downloaded
Unblock-File C:\Scripts\PSM-1858-Monitor.ps1

# Run as SYSTEM at startup, hidden window
$action   = New-ScheduledTaskAction -Execute "powershell.exe" `
            -Argument '-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "C:\Scripts\PSM-1858-Monitor.ps1"'
$trigger  = New-ScheduledTaskTrigger -AtStartup
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -MultipleInstances IgnoreNew `
            -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1)
$principal = New-ScheduledTaskPrincipal -UserId "NT AUTHORITY\SYSTEM" -LogonType ServiceAccount -RunLevel Highest

Register-ScheduledTask -TaskName "PSM 1858 Connectivity Monitor" `
    -Action $action -Trigger $trigger -Settings $settings -Principal $principal

