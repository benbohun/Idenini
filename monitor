      base="$(basename "$LOGFILE" .log)"
      rotated="/tmp/${base}_${stamp}.log"
      cp -f "$LOGFILE" "$rotated"
      : > "$LOGFILE"  # truncate active log

      gzpath="${ARCHIVE_DIR}/${base}_${stamp}.log.gz"
      gzip -c "$rotated" > "$gzpath" || mv -f "$rotated" "$ARCHIVE_DIR/"
      rm -f "$rotated"
      echo "$(date '+%F %T') - Log reached 50MB. Archived to: $gzpath" | tee -a "$LOGFILE" >/dev/null
    fi
  else
    : > "$LOGFILE"
  fi
}

dns_resolve () {
  # returns IPs on stdout; exit nonzero on failure
  if command -v getent >/dev/null 2>&1; then
    getent ahosts "$TARGET" | awk '{print $1}' | sort -u
  elif command -v host >/dev/null 2>&1; then
    host "$TARGET" | awk '/has address/ {print $4}'
  elif command -v dig >/dev/null 2>&1; then
    dig +short A "$TARGET"
  else
    return 2
  fi
}

tcp_check () {
  # use nc if available; fallback to bash /dev/tcp
  if command -v nc >/dev/null 2>&1; then
    nc -z -w5 "$TARGET" "$PORT"
  else
    timeout 5 bash -c "exec 3<>/dev/tcp/$TARGET/$PORT" 2>/dev/null
  fi
