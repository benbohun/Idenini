# ==== CONFIG ====
$TaskFolder = "\CyberArkMonitor"
$TaskName   = "PSM 1858 Connectivity Monitor"
$ScriptPath = "C:\script\PSM-1858-Monitor.ps1"

# Script parameters (edit as needed)
$Target              = "vault-cna-prod.privilegecloud.cyberark.cloud"
$Port                = 1858
$IntervalSeconds     = 10
$LogName             = "PSMConnectivity"
$EventSource         = "PSMConnectivityMonitor"
$TextLog             = "C:\script\PSM_Port1858_Test.log"
$ArchiveRetentionDays= 4

# ==== PREP ====
# Ensure script exists and is unblocked
if (!(Test-Path $ScriptPath)) { throw "Script not found: $ScriptPath" }
Unblock-File $ScriptPath

# Create task folder if missing
try {
    $null = Get-ScheduledTask -TaskPath $TaskFolder -TaskName "*" -ErrorAction Stop
} catch {
    # Create a dummy task to force the folder's creation, then remove it
    $dummyAction = New-ScheduledTaskAction -Execute "cmd.exe" -Argument "/c exit 0"
    $dummyTrig   = New-ScheduledTaskTrigger -Once -At ((Get-Date).AddMinutes(5))
    $dummyPrin   = New-ScheduledTaskPrincipal -UserId "NT AUTHORITY\SYSTEM" -LogonType ServiceAccount
    Register-ScheduledTask -TaskName ".__create_folder__" -TaskPath $TaskFolder -Action $dummyAction -Trigger $dummyTrig -Principal $dummyPrin -ErrorAction SilentlyContinue | Out-Null
    Unregister-ScheduledTask -TaskName ".__create_folder__" -TaskPath $TaskFolder -Confirm:$false -ErrorAction SilentlyContinue
}

# Build the PowerShell action (hidden, bypass policy)
$argList = @(
    '-NoProfile',
    '-WindowStyle','Hidden',
    '-ExecutionPolicy','Bypass',
    '-File', ('"{0}"' -f $ScriptPath),
    '-Target', ('"{0}"' -f $Target),
    '-Port', $Port,
    '-IntervalSeconds', $IntervalSeconds,
    '-LogName', ('"{0}"' -f $LogName),
    '-EventSource', ('"{0}"' -f $EventSource),
    '-TextLog', ('"{0}"' -f $TextLog),
    '-ArchiveRetentionDays', $ArchiveRetentionDays
) -join ' '

$action    = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument $argList
$trigger   = New-ScheduledTaskTrigger -AtStartup
$principal = New-ScheduledTaskPrincipal -UserId 'NT AUTHORITY\SYSTEM' -LogonType ServiceAccount -RunLevel Highest
$settings  = New-ScheduledTaskSettingsSet `
    -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries `
    -MultipleInstances IgnoreNew `
    -Hidden `
    -RestartCount 5 `
    -RestartInterval (New-TimeSpan -Minutes 1) `
    -ExecutionTimeLimit (New-TimeSpan -Hours 0)   # no time limit

# Replace if exists
if (Get-ScheduledTask -TaskName $TaskName -TaskPath $TaskFolder -ErrorAction SilentlyContinue) {
    Unregister-ScheduledTask -TaskName $TaskName -TaskPath $TaskFolder -Confirm:$false
}

Register-ScheduledTask -TaskName $TaskName -TaskPath $TaskFolder -Action $action -Trigger $trigger -Principal $principal -Settings $settings
Write-Host "Scheduled Task '$TaskFolder$TaskName' created."

# Start it now (optional)
Start-ScheduledTask -TaskName $TaskName -TaskPath $TaskFolder
