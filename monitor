1) Create the monitor script
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
Path: /opt/psm1858-monitor/psm1858-monitor.sh

sudo mkdir -p /opt/psm1858-monitor
sudo tee /opt/psm1858-monitor/psm1858-monitor.sh >/dev/null <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

# === Config (edit as needed) ===
TARGET="vault-cna-prod.privilegecloud.cyberark.cloud"
PORT=1858
INTERVAL=10                          # seconds between checks
LOGFILE="/var/log/psm_port1858_test.log"
ARCHIVE_DIR="/var/log/psm_port1858_archive"
RETENTION_DAYS=4                     # purge archives older than N days
MAX_BYTES=$((50*1024*1024))          # 50 MB rotate threshold
LOGGER_TAG="PSMConnectivityMonitor"

mkdir -p "$(dirname "$LOGFILE")" "$ARCHIVE_DIR"

log_line () {
  local msg="$1"
  local ts
  ts="$(date '+%F %T')"
  echo "$ts - $msg" | tee -a "$LOGFILE" >/dev/null
}

rotate_if_needed () {
  # Purge old archives
  find "$ARCHIVE_DIR" -type f -mtime +"$RETENTION_DAYS" -print0 2>/dev/null | xargs -0r rm -f

  # Rotate at 50MB
  if [[ -f "$LOGFILE" ]]; then
    local size
    size=$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)
    if (( size >= MAX_BYTES )); then
      local stamp base rotated gzpath
      stamp="$(date '+%Y%m%d_%H%M%S')"
      base="$(basename "$LOGFILE" .log)"
      rotated="/tmp/${base}_${stamp}.log"
      cp -f "$LOGFILE" "$rotated"
      : > "$LOGFILE"  # truncate active log

      gzpath="${ARCHIVE_DIR}/${base}_${stamp}.log.gz"
      if gzip -c "$rotated" > "$gzpath" 2>/dev/null; then
        rm -f "$rotated"
      else
        mv -f "$rotated" "$ARCHIVE_DIR/"
      fi
      echo "$(date '+%F %T') - Log reached 50MB. Archived to: $gzpath" | tee -a "$LOGFILE" >/dev/null
    fi
  else
    : > "$LOGFILE"
  fi
}

dns_resolve () {
  # Print IPs to stdout; nonzero exit on failure
  if command -v getent >/dev/null 2>&1; then
    getent ahosts "$TARGET" | awk '{print $1}' | sort -u
  elif command -v host >/dev/null 2>&1; then
    host "$TARGET" | awk '/has address/ {print $4}'
  elif command -v dig >/dev/null 2>&1; then
    dig +short A "$TARGET"
  else
    return 2
  fi
}

tcp_check () {
  # Prefer nc; fallback to bash /dev/tcp
  if command -v nc >/dev/null 2>&1; then
    nc -z -w5 "$TARGET" "$PORT"
  else
    timeout 5 bash -c "exec 3<>/dev/tcp/$TARGET/$PORT" 2>/dev/null
  fi
}

last_state="Unknown"  # Up | Down(DNS) | Down(TCP) | Unknown

log_line "Monitor started for ${TARGET}:${PORT}"
logger -t "$LOGGER_TAG" -p user.info "Monitor started for ${TARGET}:${PORT}"

while true; do
  rotate_if_needed

  # DNS
  IPs="$(dns_resolve || true)"
  if [[ -z "${IPs:-}" ]]; then
    msg="DNS failure: Could not resolve host '${TARGET}' (Port ${PORT})."
    log_line "TcpTestSucceeded: False | $msg"
    if [[ "$last_state" != "Down(DNS)" ]]; then
      logger -t "$LOGGER_TAG" -p user.err "$msg"
      last_state="Down(DNS)"
    fi
    sleep "$INTERVAL"
    continue
  fi

  # TCP
  if tcp_check; then
    log_line "TcpTestSucceeded: True | Resolved: ${IPs//$'\n'/, }"
    if [[ "$last_state" == "Unknown" || $last_state == Down* ]]; then
      logger -t "$LOGGER_TAG" -p user.info "Connectivity recovered to ${TARGET}:${PORT}. Resolved IP(s): ${IPs//$'\n'/, }"
    fi
    last_state="Up"
  else
    msg="TCP failure: ${TARGET}:${PORT} not reachable (DNS OK: ${IPs//$'\n'/, })."
    log_line "TcpTestSucceeded: False | $msg"
    if [[ "$last_state" != "Down(TCP)" ]]; then
      logger -t "$LOGGER_TAG" -p user.err "$msg"
      last_state="Down(TCP)"
    fi
  fi

  sleep "$INTERVAL"
done
EOF
sudo chmod +x /opt/psm1858-monitor/psm1858-monitor.sh
