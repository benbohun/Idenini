# Shared settings used by both dev and prod.
# TENANT_ID may be the tenant id only or the full Identity URL.
TENANT_ID="Placehold"
SUB_DOMAIN="Placehold"

# Proxy can be supplied as PROXY in dev.env/prod.env, or built from the two values below.
PROXY_ADDRESS="Placehold"
PROXY_PORT="Placehold"

# Backward-compatible support for the original typo. Prefer PROXY_ADDRESS above.
ROXY_ADDRESS="Placehold"
